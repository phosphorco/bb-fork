#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output="${1:-$repo_root/build/bb}"
upstream_sha="$(tr -d '[:space:]' < "$repo_root/upstream.lock")"
expected_tree="$(tr -d '[:space:]' < "$repo_root/result-tree.lock")"

if [[ -e "$output" ]]; then
  echo "Refusing to overwrite existing materialization: $output" >&2
  exit 1
fi

actual_submodule_sha="$(git -C "$repo_root/upstream" rev-parse HEAD)"
if [[ "$actual_submodule_sha" != "$upstream_sha" ]]; then
  echo "upstream submodule is $actual_submodule_sha; expected $upstream_sha" >&2
  exit 1
fi

(cd "$repo_root/patches" && sha256sum --check sha256)
mkdir -p "$(dirname "$output")"
git -C "$repo_root/upstream" worktree add --detach "$output" "$upstream_sha"

while IFS= read -r patch_name; do
  [[ -z "$patch_name" || "$patch_name" == \#* ]] && continue
  GIT_COMMITTER_NAME="bb-fork materializer" \
    GIT_COMMITTER_EMAIL="bb-fork@invalid.local" \
    git -C "$output" am --3way --committer-date-is-author-date \
      "$repo_root/patches/$patch_name"
done < "$repo_root/patches/series"

actual_tree="$(git -C "$output" rev-parse 'HEAD^{tree}')"
if [[ "$actual_tree" != "$expected_tree" ]]; then
  echo "Materialized tree is $actual_tree; expected $expected_tree" >&2
  exit 1
fi

echo "$output"
