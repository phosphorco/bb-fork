#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output="${1:-$repo_root/build/bb}"
upstream_sha="$(tr -d '[:space:]' < "$repo_root/upstream.lock")"
source_tip="$(tr -d '[:space:]' < "$repo_root/source-tip.lock")"
expected_tree="$(tr -d '[:space:]' < "$repo_root/result-tree.lock")"

if [[ -e "$output" ]]; then
  echo "Refusing to overwrite existing materialization: $output" >&2
  exit 1
fi

actual_submodule_sha="$(git -C "$repo_root/upstream" rev-parse HEAD)"
if [[ "$actual_submodule_sha" != "$upstream_sha" ]]; then
  echo "upstream submodule is $actual_submodule_sha; expected $upstream_sha" >&2
  exit 1
fi

if ! git -C "$repo_root/upstream" remote get-url downstream >/dev/null; then
  git -C "$repo_root/upstream" remote add downstream \
    "$(git -C "$repo_root" remote get-url origin)"
fi
git -C "$repo_root/upstream" fetch --quiet downstream "$source_tip"
actual_source_tree="$(git -C "$repo_root/upstream" rev-parse "${source_tip}^{tree}")"
if [[ "$actual_source_tree" != "$expected_tree" ]]; then
  echo "source tip tree is $actual_source_tree; expected $expected_tree" >&2
  exit 1
fi

mkdir -p "$(dirname "$output")"
git -C "$repo_root/upstream" worktree add --detach "$output" "$source_tip"

actual_tree="$(git -C "$output" rev-parse 'HEAD^{tree}')"
if [[ "$actual_tree" != "$expected_tree" ]]; then
  echo "Materialized tree is $actual_tree; expected $expected_tree" >&2
  exit 1
fi

echo "$output"
