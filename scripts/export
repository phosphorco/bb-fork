#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_root="${1:?usage: scripts/export <full-tree-source-commit>}"
upstream_sha="$(tr -d '[:space:]' < "$repo_root/upstream.lock")"
source_remote="$(git -C "$repo_root/upstream" remote get-url downstream)"
git -C "$repo_root/upstream" fetch --quiet downstream "$source_root"
# `git fetch <remote> <ref>` records the fetched object in FETCH_HEAD but does
# not move a same-named local branch.  Resolve that exact fetched object so an
# old local receipt branch can never be exported by mistake.
source_tree="$(git -C "$repo_root/upstream" rev-parse 'FETCH_HEAD^{tree}')"
source_commit="$(git -C "$repo_root/upstream" rev-parse 'FETCH_HEAD^{commit}')"
scratch="$(mktemp -d)"
backup=""

cleanup() {
  rm -rf "$scratch"
  if [[ -n "$backup" && -d "$backup" ]]; then
    rm -rf "$backup"
  fi
}
trap cleanup EXIT

if [[ "$(git -C "$repo_root/upstream" merge-base "$upstream_sha" "$source_commit")" != "$upstream_sha" ]]; then
  echo "source tip is not descended from upstream.lock" >&2
  exit 1
fi

if ! git ls-remote "$source_remote" | awk '{print $1}' | grep -Fqx "$source_commit"; then
  echo "source tip $source_commit is not advertised by downstream" >&2
  exit 1
fi

patches="$scratch/patches"
mkdir "$patches"
git -C "$repo_root/upstream" format-patch \
  --full-index --binary --no-signature --output-directory "$patches" \
  "$upstream_sha..$source_commit" >/dev/null

find "$patches" -maxdepth 1 -type f -name '*.patch' -printf '%f\n' | sort > "$patches/series"
(
  cd "$patches"
  sha256sum $(grep -v '^#\|^$' series) > sha256
)
printf '%s\n' "$source_commit" > "$scratch/source-tip.lock"
printf '%s\n' "$source_tree" > "$scratch/result-tree.lock"

# First validate the complete staged artifact set; publication below is only
# replacement of already-validated files.
"$repo_root/scripts/verify" --staged "$scratch"

backup="$repo_root/patches.previous.$$"
mv "$repo_root/patches" "$backup"
mv "$patches" "$repo_root/patches"
mv "$scratch/source-tip.lock" "$repo_root/source-tip.lock"
mv "$scratch/result-tree.lock" "$repo_root/result-tree.lock"
rm -rf "$backup"
backup=""

echo "exported source receipt $source_commit at tree $source_tree"
