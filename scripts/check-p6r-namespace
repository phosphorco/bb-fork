#!/usr/bin/env node

import { execFileSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const checkout = resolve(process.argv[2] ?? "build/bb");
const base = process.argv[3];
if (!base) {
  console.error("usage: check-p6r-namespace <materialized-bb> <upstream-sha>");
  process.exit(2);
}

function git(args) {
  return execFileSync("git", ["-C", checkout, ...args], {
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
  });
}

const diff = git([
  "diff",
  "--unified=0",
  `${base}..HEAD`,
  "--",
