#!/usr/bin/env node

import { execFileSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const checkout = resolve(process.argv[2] ?? "build/bb");
const base = process.argv[3];
if (!base) {
  console.error("usage: check-p6r-namespace <materialized-bb> <upstream-sha>");
  process.exit(2);
}

function git(args) {
  return execFileSync("git", ["-C", checkout, ...args], {
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
  });
}

const diff = git([
  "diff",
  "--unified=0",
  `${base}..HEAD`,
  "--",
  ":(glob)**/*.ts",
  ":(glob)**/*.tsx",
]);
const failures = [];
let file = null;

const forbiddenAddedPatterns = [
  /\bshowAuthor\b/u,
  /\bshowMessageAuthors\b/u,
  /\bactorHandle\b/u,
  /\bcreatedByHandle\b/u,
  /\bresolvedByHandle\b/u,
  /\bclaimedIdentity(?:Header)?\b/u,
  /\bmarkTunnelOrigin\b/u,
  /["']x-bb-claimed-identity["']/u,
  /["']x-bb-via-tunnel["']/u,
  /["']\/api\/v1\/(?:members|presence)["']/u,
  /\bp6rP6r|\bP6rP6r|\bP6R_P6R_/u,
];
const forbiddenOperationalDbPatterns = [
  /\bactor_handle\b/u,
  /\bcreated_by_handle\b/u,
  /\bresolved_by_handle\b/u,
];

for (const line of diff.split("\n")) {
  if (line.startsWith("+++ b/")) {
    file = line.slice(6);
    continue;
  }
  if (!file || !line.startsWith("+") || line.startsWith("+++")) continue;

  const added = line.slice(1);
  for (const pattern of forbiddenAddedPatterns) {
    if (pattern.test(added)) {
      failures.push(`${file}: forbidden downstream identifier: ${added.trim()}`);
    }
  }

  if (!file.includes("/test/") && file !== "packages/db/src/migrate.ts") {
    for (const pattern of forbiddenOperationalDbPatterns) {
      if (pattern.test(added)) {
        failures.push(
          `${file}: unprefixed downstream database identifier: ${added.trim()}`,
        );
      }
    }
  }

  if (!file.includes("/p6r/") && !/p6r[^/]*\.(?:ts|tsx)$/iu.test(file)) {
    continue;
  }
  const declaration = added.match(
    /^\s*export\s+(?:declare\s+)?(?:const|function|class|interface|type|enum)\s+([A-Za-z_$][\w$]*)/u,
  );
  if (declaration && !/p6r/iu.test(declaration[1])) {
    failures.push(
      `${file}: downstream identity export '${declaration[1]}' does not contain the p6r namespace`,
    );
  }
}

const requiredContracts = [
  {
    path: "packages/plugin-sdk/src/backend-contract.ts",
    tokens: ["experimental_p6rIdentity?: ExperimentalP6rIdentityProtocol"],
  },
  {
    path: "packages/plugin-sdk/src/experimental-p6r-identity.ts",
    tokens: [
      "interface ExperimentalP6rIdentityProtocol",
      "ExperimentalP6rInvocationContext",
    ],
  },
  {
    path: "apps/server/src/services/p6r/identity-protocol.ts",
    tokens: ["interface P6rActorSnapshot", "createP6rIdentityService"],
  },
];

for (const contract of requiredContracts) {
  const source = readFileSync(resolve(checkout, contract.path), "utf8");
  for (const token of contract.tokens) {
    if (!source.includes(token)) {
      failures.push(`${contract.path}: missing '${token}'`);
    }
  }
}

if (failures.length > 0) {
  console.error(failures.join("\n"));
  process.exit(1);
}

console.log("p6r downstream namespace verified");
