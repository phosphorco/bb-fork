function upstreamSource(path) {
  if (upstreamFiles.has(path)) return upstreamFiles.get(path);
  let source = "";
  try {
    source = execFileSync("git", ["-C", checkout, "show", `${base}:${path}`], {
      encoding: "utf8",
      maxBuffer: 64 * 1024 * 1024,
      stdio: ["ignore", "pipe", "ignore"],
    });
  } catch {
    // A downstream-only file has no upstream source.
  }
  upstreamFiles.set(path, source);
  return source;
}

function approvedGenericThreadFacetExport(path, name) {
  return approvedGenericThreadFacetExports.has(`${path}#${name}`);
}

const forbiddenAddedPatterns = [
  /\bshowAuthor\b/u,
  /\bshowMessageAuthors\b/u,
  /\bactorHandle\b/u,
  /\bcreatedByHandle\b/u,
  /\bresolvedByHandle\b/u,
  /\bclaimedIdentity(?:Header)?\b/u,
  /\bmarkTunnelOrigin\b/u,
  /["']x-bb-claimed-identity["']/u,
  /["']x-bb-via-tunnel["']/u,
  /["']\/api\/v1\/(?:members|presence)["']/u,
  /["'](?:typing|thread-presence|presence-summary)["']/u,
  /["']identity["']/u,
  /\bp6rUse[A-Z]/u,
  /\bp6rP6r|\bP6rP6r|\bP6R_P6R_/u,
];
const forbiddenOperationalDbPatterns = [
  /\bactor_handle\b/u,
  /\bcreated_by_handle\b/u,
  /\bresolved_by_handle\b/u,
];

for (const line of diff.split("\n")) {
  if (line.startsWith("+++ b/")) {
    file = line.slice(6);
    continue;
  }
  if (!file || !line.startsWith("+") || line.startsWith("+++")) continue;

  const added = line.slice(1);
  for (const pattern of forbiddenAddedPatterns) {
    if (pattern.test(added)) {
      failures.push(`${file}: forbidden downstream identifier: ${added.trim()}`);
    }
  }

  if (!file.includes("/test/") && file !== "packages/db/src/migrate.ts") {
    for (const pattern of forbiddenOperationalDbPatterns) {
      if (pattern.test(added)) {
        failures.push(
          `${file}: unprefixed downstream database identifier: ${added.trim()}`,
        );
      }
    }
  }

  const declaration = added.match(
    /^\s*export\s+(?:declare\s+)?(?:const|function|class|interface|type|enum)\s+([A-Za-z_$][\w$]*)/u,
  );
  if (!declaration) continue;
  const name = declaration[1];
  if (/^(?:p6r|P6r|P6R_|useP6r)/u.test(name)) continue;
  if (approvedGenericThreadFacetExport(file, name)) continue;

  const existedUpstream = new RegExp(
    `export\\s+(?:declare\\s+)?(?:const|function|class|interface|type|enum)\\s+${name}\\b`,
    "u",
  ).test(upstreamSource(file));
  if (!existedUpstream) {
    failures.push(`${file}: new exported symbol '${name}' is not p6r-prefixed`);
  }
}

// The portable declarations are now generated build output and deliberately
// absent from a clean checkout. Inspect the committed canonical inputs that
// the declaration generator flattens instead of depending on stale output.
const canonicalSdkContracts = [
  {
    path: "packages/sdk/src/core.ts",
    tokens: ["p6rMembers: P6rMembersArea", "p6rPresence: P6rPresenceArea"],
  },
  {
    path: "packages/plugin-sdk/src/app-contract.ts",
    tokens: [
      "p6rParticipants?: readonly P6rParticipantProfile[]",
      "interface P6rParticipantProfile",
    ],
  },
  {
    path: "packages/plugin-sdk/src/backend-contract.ts",
    tokens: [
      "p6rIdentity: P6rIdentityApi",
      "p6rRequestPrincipal: P6rActorSnapshot | null",
      "p6rTurnAuthor: P6rActorSnapshot | null",
      "experimental_p6rRoutes: P6rExperimentalPluginRoutes",
      "p6rThreadPath(args: { projectId: string; threadId: string }): string",
    ],
  },
  {
    path: "packages/server-contract/src/thread-timeline.ts",
    tokens: ["p6rActorHandle"],
  },
];
const canonicalSdkSource = [];
for (const contract of canonicalSdkContracts) {
  const contractPath = resolve(checkout, contract.path);
  const source = readFileSync(contractPath, "utf8");
  canonicalSdkSource.push(source);
  for (const token of contract.tokens) {
    if (!source.includes(token)) {
      failures.push(`${contractPath}: missing '${token}'`);
    }
  }
}
const sdk = canonicalSdkSource.join("\n");
const sdkPath = canonicalSdkContracts
  .map(({ path }) => resolve(checkout, path))
  .join(", ");

const conversationMessage = readFileSync(
  resolve(
    checkout,
    "apps/app/src/components/thread/timeline/ConversationMessageContent.tsx",
  ),
  "utf8",
);
if (!conversationMessage.includes("p6rShowAuthor")) {
  failures.push("ConversationMessageContent is missing 'p6rShowAuthor'");
}
for (const pattern of [
  /\bmembers:\s*MembersArea\b/u,
  /\bpresence:\s*PresenceArea\b/u,
  /\bactorHandle\b/u,
  /\bshowAuthor\b/u,
  /\bshowMessageAuthors\b/u,
]) {
  if (pattern.test(sdk)) failures.push(`${sdkPath}: leaked ${pattern}`);
}
for (const token of ["experimental_routes", "threadPath(args:"]) {
  if (sdk.includes(token)) {
    failures.push(`${sdkPath}: leaked unquarantined downstream member '${token}'`);
  }
}

if (failures.length > 0) {
  console.error(failures.join("\n"));
  process.exit(1);
}

console.log("p6r downstream namespace verified");
