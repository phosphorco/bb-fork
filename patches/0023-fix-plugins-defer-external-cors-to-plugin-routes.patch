From: bb-machine <ubuntu@bb-machine>
Date: Fri, 18 Sep 2026 19:25:00 +0200
Subject: [PATCH 22/22] fix(plugins): defer external CORS to plugin routes

---
 apps/server/src/server.ts                          | 27 ++++----
 .../test/services/plugins/plugin-wire.test.ts      | 81 ++++++++++++++++++++-
 packages/plugin-sdk/src/backend-contract.ts        |  5 ++
 3 files changed, 100 insertions(+), 13 deletions(-)

diff --git a/apps/server/src/server.ts b/apps/server/src/server.ts
index 7180e3b39..33ab6dbd3 100644
--- a/apps/server/src/server.ts
+++ b/apps/server/src/server.ts
@@ -466,18 +466,21 @@ export function createApp(
     }
     return runEventLoopWork(`${context.req.method} ${path}`, next);
   });
-  app.use(
-    "*",
-    cors({
-      origin: (origin, context) => {
-        const allowedCorsOrigins = allowedAppOrigins(deps);
-        const requestOrigin = new URL(context.req.url).origin;
-        if (origin === requestOrigin || allowedCorsOrigins.has(origin)) {
-          return origin;
-        }
-        return null;
-      },
-    }),
+  const browserCors = cors({
+    origin: (origin, context) => {
+      const allowedCorsOrigins = allowedAppOrigins(deps);
+      const requestOrigin = new URL(context.req.url).origin;
+      if (origin === requestOrigin || allowedCorsOrigins.has(origin)) {
+        return origin;
+      }
+      return null;
+    },
+  });
+  app.use("*", (context, next) =>
+    context.req.method === "OPTIONS" &&
+      PLUGIN_WIRE_HTTP_PATH.test(context.req.path)
+      ? next()
+      : browserCors(context, next),
   );
   const compressResponse = compress();
   const compressApiJson = apiJsonCompression();
diff --git a/apps/server/test/services/plugins/plugin-wire.test.ts b/apps/server/test/services/plugins/plugin-wire.test.ts
index 249aab2bb..c179df800 100644
--- a/apps/server/test/services/plugins/plugin-wire.test.ts
+++ b/apps/server/test/services/plugins/plugin-wire.test.ts
@@ -45,6 +45,18 @@ const WIRE_SOURCE = `
     bb.http.route("GET", "/open", (c: any) => c.json({ open: true }), {
       auth: "none",
     });
+    bb.http.route("OPTIONS", "/cors", () => new Response(null, {
+      status: 204,
+      headers: {
+        "access-control-allow-headers": "content-type",
+        "access-control-allow-methods": "POST, OPTIONS",
+        "access-control-allow-origin": "*",
+      },
+    }), { auth: "none" });
+    bb.http.route("POST", "/cors", () => Response.json(
+      { cors: true },
+      { headers: { "access-control-allow-origin": "*" } },
+    ), { auth: "none" });
     bb.http.route("GET", "/boom", () => {
       throw new Error("route boom");
     });
@@ -408,15 +420,81 @@ describe("plugin wire surfaces (http/rpc dispatcher + realtime)", () => {
     expect(unknownPlugin.status).toBe(404);
   });
 
-  it('auth "none" passes foreign origins through', async () => {
+  it('auth "none" passes foreign origins through without granting browser access', async () => {
     const response = await harness.app.request(
       `${BASE}/api/v1/plugins/wire/http/open`,
       { headers: { origin: EVIL_ORIGIN } },
     );
     expect(response.status).toBe(200);
+    expect(response.headers.get("access-control-allow-origin")).toBeNull();
     expect(await response.json()).toEqual({ open: true });
   });
 
+  it("delegates foreign-origin plugin preflight and response CORS to the plugin", async () => {
+    const response = await harness.app.request(
+      `${BASE}/api/v1/plugins/wire/http/cors`,
+      {
+        method: "OPTIONS",
+        headers: {
+          origin: "https://rosetta.banjo-tint.ts.net:54113",
+          "access-control-request-headers": "content-type",
+          "access-control-request-method": "POST",
+        },
+      },
+    );
+    expect(response.status).toBe(204);
+    expect(response.headers.get("access-control-allow-origin")).toBe("*");
+    expect(response.headers.get("access-control-allow-methods")).toBe(
+      "POST, OPTIONS",
+    );
+    expect(response.headers.get("access-control-allow-headers")).toBe(
+      "content-type",
+    );
+
+    const post = await harness.app.request(
+      `${BASE}/api/v1/plugins/wire/http/cors`,
+      {
+        method: "POST",
+        headers: { "content-type": "application/json", origin: EVIL_ORIGIN },
+      },
+    );
+    expect(post.status).toBe(200);
+    expect(post.headers.get("access-control-allow-origin")).toBe("*");
+    expect(await post.json()).toEqual({ cors: true });
+  });
+
+  it("keeps global CORS ownership for normal and near-miss API paths", async () => {
+    for (const path of [
+      "/api/v1/threads",
+      "/api/v1/plugins/wire/http-other/cors",
+    ]) {
+      const response = await harness.app.request(`${BASE}${path}`, {
+        method: "OPTIONS",
+        headers: {
+          origin: EVIL_ORIGIN,
+          "access-control-request-method": "POST",
+        },
+      });
+      expect(response.headers.get("access-control-allow-origin")).toBeNull();
+    }
+  });
+
+  it("keeps plugin authentication independent from CORS delegation", async () => {
+    const local = await harness.app.request(
+      `${BASE}/api/v1/plugins/wire/http/hello`,
+      { headers: { origin: EVIL_ORIGIN } },
+    );
+    expect(local.status).toBe(403);
+    expect(local.headers.get("access-control-allow-origin")).toBeNull();
+
+    const token = await harness.app.request(
+      `${BASE}/api/v1/plugins/wire/http/guarded`,
+      { headers: { origin: EVIL_ORIGIN } },
+    );
+    expect(token.status).toBe(401);
+    expect(token.headers.get("access-control-allow-origin")).toBeNull();
+  });
+
   it("maps unknown route → 404, unknown plugin → 404, disabled plugin → 503", async () => {
     const unknownRoute = await harness.app.request(
       `${BASE}/api/v1/plugins/wire/http/nope`,
@@ -640,6 +718,7 @@ describe("plugin wire surfaces (http/rpc dispatcher + realtime)", () => {
       { origin: EVIL_ORIGIN },
     );
     expect(foreign.status).toBe(403);
+    expect(foreign.headers.get("access-control-allow-origin")).toBeNull();
 
     const notJson = await rpc(harness, "echo", { x: 1 }, { contentType: null });
     expect(notJson.status).toBe(415);
diff --git a/packages/plugin-sdk/src/backend-contract.ts b/packages/plugin-sdk/src/backend-contract.ts
index 50cb59809..5d1d1fd8a 100644
--- a/packages/plugin-sdk/src/backend-contract.ts
+++ b/packages/plugin-sdk/src/backend-contract.ts
@@ -807,6 +807,11 @@ export interface PluginHttp {
    * - "token": requires the per-plugin token (`bb plugin token <id>`) via
    *   the x-bb-plugin-token header or ?token=.
    * - "none": no checks — only for signature-verified webhooks.
+   *
+   * Plugin HTTP OPTIONS requests bypass the host CORS responder. A route that
+   * supports browser callers must register its own OPTIONS handler and return
+   * the exact CORS headers its GET/POST handlers require. Route authentication
+   * remains enforced independently for every non-OPTIONS request.
    */
   route(
     method: string,
