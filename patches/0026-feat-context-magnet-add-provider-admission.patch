+export function persistThreadStartAdmissionObservations(
+  args: SettleThreadStartCommandResultArgs,
+): void {
+  if (!args.report.ok) return;
+  const attempts = new Set(
+    (args.command.contextMagnetAdmissionAttempts ?? []).map(
+      (attempt) => attempt.admissionAttemptId,
+    ),
+  );
+  for (const admissionId of attempts) {
+    const observations = args.report.result.observations.filter(
+      (observation) => observation.admissionAttemptId === admissionId,
+    );
+    if (observations.length === 0) continue;
+    appendContextMagnetProviderAdmissionObservations(args.deps.db, {
+      admissionId,
+      now: Date.now(),
+      observations: observations.map((observation) =>
+        observation.kind === "failed-settlement"
+          ? { kind: observation.kind, settlement: observation.settlement }
+          : { kind: observation.kind },
+      ),
+      threadId: args.command.threadId,
+    });
+  }
+}
+
 export function settleThreadStartCommandResult(
   args: SettleThreadStartCommandResultArgs,
 ): CommandResultSideEffectsResult {
@@ -904,6 +933,22 @@ export function settleThreadStartCommandResult(
     });
   }
 
