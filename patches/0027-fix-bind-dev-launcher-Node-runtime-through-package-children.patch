diff --git a/scripts/assert-selected-node.mjs b/scripts/assert-selected-node.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a2feeb5bf343762201ec4836692103f57cab66e7
--- /dev/null
+++ b/scripts/assert-selected-node.mjs
@@ -0,0 +1,58 @@
+import { realpathSync } from "node:fs";
+import * as nodeModule from "node:module";
+
+export function assertSelectedNodeBinding({
+  actualExecPath,
+  expectedExecPath,
+  actualVersion,
+  expectedVersion,
+  registerHooksAvailable,
+}) {
+  if (actualExecPath !== expectedExecPath) {
+    throw new Error(
+      `expected executable ${expectedExecPath}, got ${actualExecPath}`,
+    );
+  }
+  if (actualVersion !== expectedVersion) {
+    throw new Error(
+      `expected Node ${expectedVersion}, got Node ${actualVersion}`,
+    );
+  }
+  if (!registerHooksAvailable) {
+    throw new Error(
+      `Node ${actualVersion} does not provide node:module.registerHooks`,
+    );
+  }
+}
+
+function realpath(path) {
+  try {
+    return realpathSync.native(path);
+  } catch {
+    return path;
+  }
+}
+
+function assertFromEnvironment() {
+  const expectedExecPath = process.env.BB_DEV_NODE_EXEC_PATH;
+  if (expectedExecPath === undefined || expectedExecPath === "") {
+    return;
+  }
+
+  try {
+    assertSelectedNodeBinding({
+      actualExecPath: realpath(process.execPath),
+      expectedExecPath: realpath(expectedExecPath),
+      actualVersion: process.versions.node,
+      expectedVersion: process.env.BB_DEV_NODE_VERSION,
+      registerHooksAvailable: typeof nodeModule.registerHooks === "function",
+    });
+  } catch (error) {
+    process.stderr.write(
+      `[bb-dev-node] runtime binding refused: ${error instanceof Error ? error.message : String(error)}\n`,
+    );
+    process.exit(1);
+  }
+}
+
+assertFromEnvironment();
diff --git a/scripts/assert-selected-node.test.mjs b/scripts/assert-selected-node.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9eb111a812ad321e567ae5d2c19a19a43c3af62d
--- /dev/null
+++ b/scripts/assert-selected-node.test.mjs
@@ -0,0 +1,44 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { assertSelectedNodeBinding } from "./assert-selected-node.mjs";
+
+test("accepts one exact executable with registerHooks", () => {
+  assert.doesNotThrow(() =>
+    assertSelectedNodeBinding({
+      actualExecPath: "/selected/bin/node",
+      expectedExecPath: "/selected/bin/node",
+      actualVersion: "22.21.1",
+      expectedVersion: "22.21.1",
+      registerHooksAvailable: true,
+    }),
+  );
+});
+
+test("refuses a replaced executable", () => {
+  assert.throws(
+    () =>
+      assertSelectedNodeBinding({
+        actualExecPath: "/incompatible/bin/node",
+        expectedExecPath: "/selected/bin/node",
+        actualVersion: "22.21.1",
+        expectedVersion: "22.21.1",
+        registerHooksAvailable: true,
+      }),
+    /expected executable \/selected\/bin\/node, got \/incompatible\/bin\/node/,
+  );
+});
+
+test("refuses a runtime without registerHooks", () => {
+  assert.throws(
+    () =>
+      assertSelectedNodeBinding({
+        actualExecPath: "/selected/bin/node",
+        expectedExecPath: "/selected/bin/node",
+        actualVersion: "22.12.0",
+        expectedVersion: "22.12.0",
+        registerHooksAvailable: false,
+      }),
+    /does not provide node:module\.registerHooks/,
+  );
+});
