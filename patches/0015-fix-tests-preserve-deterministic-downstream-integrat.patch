Subject: [PATCH] fix(tests): preserve deterministic downstream integration
 witnesses

---
 apps/server/scripts/generate-bb-official-marketplace.ts      | 5 +++--
 .../test/public/public-thread-context-clear-dispatch.test.ts | 4 ++--
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/apps/server/scripts/generate-bb-official-marketplace.ts b/apps/server/scripts/generate-bb-official-marketplace.ts
index ba139c001..7042d9e1e 100644
--- a/apps/server/scripts/generate-bb-official-marketplace.ts
+++ b/apps/server/scripts/generate-bb-official-marketplace.ts
@@ -146,14 +146,15 @@ export async function readPluginGitDates(args: {
       .map((line) => line.trim())
       .filter((line) => line.length > 0);
     if (date === undefined) continue;
+    const normalizedDate = new Date(date).toISOString().replace(".000Z", "Z");
     for (const plugin of args.plugins) {
       if (!files.some((file) => file.startsWith(`plugins/${plugin.name}/`))) {
         continue;
       }
       const current = dates.get(plugin.name);
       dates.set(plugin.name, {
-        publishedAt: date,
-        updatedAt: current?.updatedAt ?? date,
+        publishedAt: normalizedDate,
+        updatedAt: current?.updatedAt ?? normalizedDate,
       });
     }
   }
diff --git a/apps/server/test/public/public-thread-context-clear-dispatch.test.ts b/apps/server/test/public/public-thread-context-clear-dispatch.test.ts
index c265d85ba..6d1fb0872 100644
--- a/apps/server/test/public/public-thread-context-clear-dispatch.test.ts
+++ b/apps/server/test/public/public-thread-context-clear-dispatch.test.ts
@@ -92,11 +92,11 @@ describe("context clear dispatch races", () => {
           });
           vi.spyOn(
             mentions,
-            "resolvePluginMentionContextInputs",
+            "resolvePluginMentionInputs",
           ).mockImplementationOnce(async () => {
             entered.resolve();
             await release.promise;
-            return [];
+            return { contextInputs: [], targets: [] };
           });
         } else {
           const buildExecutionOptions = commands.buildExecutionOptions;
