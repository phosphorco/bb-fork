+import { sql } from "drizzle-orm";
+import { describe, expect, it } from "vitest";
+import { initDb } from "../../../src/db.js";
+
+describe("P6r sidecar startup migration", () => {
+  it("migrates sidecars through the production initDb path used by runServer", () => {
+    const db = initDb(":memory:");
+
+    expect(
+      db.get<{ name: string }>(
+        sql`SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'p6r_metadata'`,
+      ),
+    ).toEqual({ name: "p6r_metadata" });
+    expect(
+      db.get<{ name: string }>(
+        sql`SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'p6r_operation_receipts'`,
+      ),
+    ).toEqual({ name: "p6r_operation_receipts" });
+  });
+});
