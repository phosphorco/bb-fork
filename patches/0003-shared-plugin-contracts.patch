diff --git a/packages/domain/test/environment-credential-projection.test.ts b/packages/domain/test/environment-credential-projection.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c31306da1041bfa8eead9097494fbbf72902defb
--- /dev/null
+++ b/packages/domain/test/environment-credential-projection.test.ts
@@ -0,0 +1,110 @@
+import { describe, expect, it } from "vitest";
+import {
+  parseStoredThreadEvent,
+  parseThreadEventRow,
+} from "../src/stored-thread-event.js";
+import { threadScope } from "../src/thread-event-scope.js";
+
+const secret = "synthetic-retained-authentication-secret";
+const provenance = {
+  reason:
+    "https://home.test:8443/path · 100.100.1.2 · account-id · full diagnostic context",
+};
+
+describe("source-attested credential-slot diagnostic projection", () => {
+  it.each([
+    ["account-pool", "ANTHROPIC_AUTH_TOKEN"],
+    ["account-pool", "CODEX_POOL_AUTH_TOKEN"],
+    ["account-pool", "BB_ACCOUNT_POOL_PARENT_TOKEN"],
+    ["subscription-router", "ANTHROPIC_AUTH_TOKEN"],
+    ["subscription-router", "CODEX_POOL_AUTH_TOKEN"],
+  ])(
+    "masks only the value of %s/%s without changing the original event",
+    (plugin, name) => {
+      const data = {
+        providerThreadId: "provider",
+        entries: [{ name, source: { plugin }, value: secret, ...provenance }],
+      };
+      const original = JSON.stringify(data);
+      const row = parseThreadEventRow({
+        id: "event",
+        type: "provider.env-resolved",
+        threadId: "thread",
+        providerThreadId: "provider",
+        scope: threadScope(),
+        seq: 1,
+        createdAt: 1,
+        data,
+      });
+      expect(row.data).toEqual({
+        providerThreadId: "provider",
+        entries: [
+          { name, source: { plugin }, value: { masked: true }, ...provenance },
+        ],
+      });
+      expect(JSON.stringify(data)).toBe(original);
+      expect(JSON.stringify(row)).not.toContain(secret);
+    },
+  );
+
+  it("preserves ordinary values, public sentinels, unknown names and different provenance", () => {
+    const entries = [
+      {
+        name: "ANTHROPIC_BASE_URL",
+        source: { plugin: "account-pool" },
+        value: "https://home.test",
+        ...provenance,
+      },
+      {
+        name: "ENABLE_TOOL_SEARCH",
+        source: { plugin: "account-pool" },
+        value: "true",
+        ...provenance,
+      },
+      {
+        name: "CODEX_POOL_AUTH_TOKEN",
+        source: { plugin: "subscription-router" },
+        value: "csr.unresolved",
+        ...provenance,
+      },
+      {
+        name: "ANTHROPIC_AUTH_TOKEN",
+        source: { plugin: "account-pool" },
+        value: "",
+        ...provenance,
+      },
+      {
+        name: "ANTHROPIC_AUTH_TOKEN",
+        source: { plugin: "different-plugin" },
+        value: "ordinary-value",
+        ...provenance,
