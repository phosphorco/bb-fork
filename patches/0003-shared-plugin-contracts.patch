new file mode 100644
index 0000000000000000000000000000000000000000..23ede341635cc2b2bbb9350181d2614de468da1e
--- /dev/null
+++ b/packages/sdk/test/realtime-adapter-close.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vitest";
+import { wrapStandardWebsocket } from "../src/realtime-client.js";
+
+describe("wrapStandardWebsocket()", () => {
+  it("closes the underlying socket once when close synchronously emits an error", () => {
+    let closeCalls = 0;
+    const socket = {
+      close() {
+        closeCalls += 1;
+        socket.onerror?.(new Event("error"));
+      },
+      onclose: null,
+      onerror: null,
+      onmessage: null,
+      onopen: null,
+      readyState: WebSocket.OPEN,
+      send() {},
+    } as unknown as WebSocket;
+    const adapter = wrapStandardWebsocket(socket);
+    adapter.onerror = () => adapter.close();
+
+    adapter.close();
+
+    expect(closeCalls).toBe(1);
+  });
+});
