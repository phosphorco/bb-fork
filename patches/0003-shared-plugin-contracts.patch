index 0000000000000000000000000000000000000000..13fd7ebb24699ec9bdef7b8cded5d5851ed9addd
--- /dev/null
+++ b/packages/domain/src/p6r-message-author.ts
@@ -0,0 +1,44 @@
+import { z } from "zod";
+
+const personAuthorSchema = z.object({
+  evidence: z.enum(["provider-verified", "integration-asserted"]),
+  identity: z.object({
+    kind: z.literal("person"),
+    key: z.string().min(1),
+    issuer: z.string().min(1),
+    subject: z.string().min(1),
+  }),
+  presentation: z.object({
+    displayName: z.string(),
+    handle: z.string().nullable(),
+    avatarUrl: z.string().nullable(),
+  }),
+});
+const machineAuthorSchema = z.object({
+  evidence: z.literal("machine"),
+  identity: z.object({
+    kind: z.literal("machine"),
+    key: z.string().min(1),
+    instanceId: z.string().min(1),
+    hostId: z.string().min(1).nullable(),
+  }),
+  presentation: z.object({
+    displayName: z.string(),
+    handle: z.string().nullable(),
+    avatarUrl: z.string().nullable(),
+  }),
+});
+export const p6rMessageAuthorSchema = z.union([personAuthorSchema, machineAuthorSchema]);
+export type P6rMessageAuthor = z.infer<typeof p6rMessageAuthorSchema>;
+
+export const p6rMessageAttributionSchema = z.object({
+  authors: z.array(p6rMessageAuthorSchema.nullable()).max(256).optional(),
+  editors: z.array(p6rMessageAuthorSchema.nullable()).max(256).optional(),
+}).strict();
+export const p6rStoredMessageAttributionSchema = z.union([
+  z.array(p6rMessageAuthorSchema.nullable()).max(256),
+  p6rMessageAttributionSchema,
+]);
+export type P6rMessageAttribution = z.infer<
+  typeof p6rMessageAttributionSchema
+>;
