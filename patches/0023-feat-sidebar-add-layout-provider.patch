+const MAX_EXTERNAL_LAYOUT_ITEMS = 100;
+const MAX_EXTERNAL_LAYOUT_KEY_LENGTH = 256;
+
+function normalizeExternalLayout(
+  layout: ExperimentalSidebarLayout | null,
+): ExperimentalSidebarLayout | null {
+  if (layout === null || !Array.isArray(layout.order) || !Array.isArray(layout.visible)) {
+    return null;
+  }
+  const copy = (keys: readonly unknown[]): string[] | null => {
+    if (keys.length > MAX_EXTERNAL_LAYOUT_ITEMS) return null;
+    const result: string[] = [];
+    for (const key of keys) {
+      if (typeof key !== "string" || key.length === 0 || key.length > MAX_EXTERNAL_LAYOUT_KEY_LENGTH) return null;
+      if (!result.includes(key)) result.push(key);
+    }
+    return result;
+  };
+  const order = copy(layout.order);
+  const visible = copy(layout.visible);
+  return order === null || visible === null ? null : { order, visible };
+}
 
