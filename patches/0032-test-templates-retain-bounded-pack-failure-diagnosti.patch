@@ -246,15 +247,76 @@ async function linkExternalDependencies(targetDir: string): Promise<void> {
   }
 }
 
+function sanitizePackDiagnostic(text: string): string {
+  return text
+    .replace(/(https?:\/\/)[^\s/@:]+(?::[^\s/@]*)?@/giu, "$1[REDACTED]@")
+    .replace(
+      /((?:^|[\s?&;,/:"'[{])(?:_?auth(?:entication|orization)?(?:[_-]?token)?|token|password|passwd|secret|api[_-]?key|credential)\s*[=:]\s*(?:["'])?)[^\s,;"'}\]]+/giu,
+      "$1[REDACTED]",
+    )
+    .replace(/\bBearer\s+[^\s,;]+/giu, "Bearer [REDACTED]");
+}
+
+function boundedPackDiagnostic(value: unknown): string {
+  const text = sanitizePackDiagnostic(
+    Buffer.isBuffer(value) ? value.toString("utf8") : String(value ?? ""),
+  );
+  return text.length <= PACK_DIAGNOSTIC_OUTPUT_LIMIT
+    ? text
+    : `${text.slice(0, PACK_DIAGNOSTIC_OUTPUT_LIMIT)}\n[truncated]`;
+}
+
+function packFailureDiagnostic(args: {
+  cwd: string;
+  error: unknown;
+  packDir: string;
+}): Error {
+  const failed = args.error as NodeJS.ErrnoException & {
+    killed?: boolean;
+    signal?: string | null;
+    stderr?: string | Buffer;
+    stdout?: string | Buffer;
+  };
+  const fields = [
+    [
+      "command",
+      `npm pack --silent --ignore-scripts --pack-destination ${args.packDir}`,
+    ],
+    ["cwd", args.cwd],
+    ["code", failed.code],
+    ["errno", failed.errno],
+    ["syscall", failed.syscall],
+    ["signal", failed.signal],
+    ["killed", failed.killed],
+  ].map(([name, value]) => `${name}: ${boundedPackDiagnostic(value)}`);
+  return new Error(
+    [
+      "npm pack failed",
+      ...fields,
+      `stdout:\n${boundedPackDiagnostic(failed.stdout)}`,
+      `stderr:\n${boundedPackDiagnostic(failed.stderr)}`,
+    ].join("\n"),
+    { cause: args.error },
+  );
+}
+
 async function packPluginSdk(packDir: string): Promise<string> {
   await mkdir(packDir, { recursive: true });
-  await execFileAsync(
