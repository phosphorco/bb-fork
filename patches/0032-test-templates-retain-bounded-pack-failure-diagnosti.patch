From: bb-machine <ubuntu@bb-machine>
Date: Tue, 22 Sep 2026 23:51:00 +0200
Subject: [PATCH] test(templates): retain bounded pack failure diagnostics

---
 .../test/plugin-scaffold-external.test.ts     | 88 ++++++++++++++++---
 1 file changed, 75 insertions(+), 13 deletions(-)

diff --git a/packages/templates/test/plugin-scaffold-external.test.ts b/packages/templates/test/plugin-scaffold-external.test.ts
index 6ab305e861ded48245f485c544129ed881a1149a..f80ddce7dcbf1bdca343b804fb7b95a03e3012dc 100644
--- a/packages/templates/test/plugin-scaffold-external.test.ts
+++ b/packages/templates/test/plugin-scaffold-external.test.ts
@@ -44,6 +44,7 @@ const npmCommand =
     : { file: "npm", args: [] };
 const pluginSdkRoot = resolve(process.cwd(), "../plugin-sdk");
 const dependencyRequire = createRequire(join(pluginSdkRoot, "package.json"));
+const PACK_DIAGNOSTIC_OUTPUT_LIMIT = 4_096;
 
 const EXTERNAL_DEPENDENCIES = [
   "@hugeicons/core-free-icons",
@@ -262,22 +263,83 @@ async function linkExternalDependencies(targetDir: string): Promise<void> {
   }
 }
 
-async function packPluginSdk(packDir: string): Promise<string> {
-  await mkdir(packDir, { recursive: true });
-  await execFileAsync(
-    npmCommand.file,
+function sanitizePackDiagnostic(text: string): string {
+  return text
+    .replace(/(https?:\/\/)[^\s/@:]+(?::[^\s/@]*)?@/giu, "$1[REDACTED]@")
+    .replace(
+      /((?:^|[\s?&;,/:"'[{])(?:_?auth(?:entication|orization)?(?:[_-]?token)?|token|password|passwd|secret|api[_-]?key|credential)\s*[=:]\s*(?:["'])?)[^\s,;"'}\]]+/giu,
+      "$1[REDACTED]",
+    )
+    .replace(/\bBearer\s+[^\s,;]+/giu, "Bearer [REDACTED]");
+}
+
+function boundedPackDiagnostic(value: unknown): string {
+  const text = sanitizePackDiagnostic(
+    Buffer.isBuffer(value) ? value.toString("utf8") : String(value ?? ""),
+  );
+  return text.length <= PACK_DIAGNOSTIC_OUTPUT_LIMIT
+    ? text
+    : `${text.slice(0, PACK_DIAGNOSTIC_OUTPUT_LIMIT)}\n[truncated]`;
+}
+
+function packFailureDiagnostic(args: {
+  cwd: string;
+  error: unknown;
+  packDir: string;
+}): Error {
+  const failed = args.error as NodeJS.ErrnoException & {
+    killed?: boolean;
+    signal?: string | null;
+    stderr?: string | Buffer;
+    stdout?: string | Buffer;
+  };
+  const fields = [
     [
-      ...npmCommand.args,
-      "pack",
-      "--silent",
-      "--ignore-scripts",
-      "--pack-destination",
-      packDir,
+      "command",
+      `npm pack --silent --ignore-scripts --pack-destination ${args.packDir}`,
     ],
-    {
-      cwd: pluginSdkRoot,
-    },
+    ["cwd", args.cwd],
+    ["code", failed.code],
+    ["errno", failed.errno],
+    ["syscall", failed.syscall],
+    ["signal", failed.signal],
+    ["killed", failed.killed],
+  ].map(([name, value]) => `${name}: ${boundedPackDiagnostic(value)}`);
+  return new Error(
+    [
+      "npm pack failed",
+      ...fields,
+      `stdout:\n${boundedPackDiagnostic(failed.stdout)}`,
+      `stderr:\n${boundedPackDiagnostic(failed.stderr)}`,
+    ].join("\n"),
+    { cause: args.error },
   );
+}
+
+async function packPluginSdk(packDir: string): Promise<string> {
+  await mkdir(packDir, { recursive: true });
+  try {
+    await execFileAsync(
+      npmCommand.file,
+      [
+        ...npmCommand.args,
+        "pack",
+        "--silent",
+        "--ignore-scripts",
+        "--pack-destination",
+        packDir,
+      ],
+      {
+        cwd: pluginSdkRoot,
+      },
+    );
+  } catch (error) {
+    throw packFailureDiagnostic({
+      cwd: pluginSdkRoot,
+      error,
+      packDir,
+    });
+  }
   const tarballs = (await readdir(packDir)).filter((name) =>
     name.endsWith(".tgz"),
   );
