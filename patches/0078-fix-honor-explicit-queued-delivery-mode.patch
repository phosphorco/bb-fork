@@ -2624,6 +2624,83 @@ describe("native edit admission before effects", () => {
       }
     });
   });
+  it("refuses public explicit Steer for an accepted persisted historical target without changing acceptance", async () => {
+    await withTestHarness(async (harness) => {
+      const { environment, thread } = seedEditableThread(harness, {
+        threadStatus: "active",
+      });
+      let calls = 0;
+      const f = await nativeEditPolicy(harness, thread, (input) => {
+        calls++;
+        return reduceObservations({
+          assessmentId: input.assessmentId,
+          complete: true,
+          observations: [
+            {
+              groupId: "delivery",
+              ruleId: "retain-target",
+              revision: "1",
+              status: "pass",
+              causes: [],
+              advice: [],
+              routing: "defer",
+              membership: "separate",
+            },
+          ],
+        });
+      });
+      const runtime = configureNativeMessageAdmissionRuntime(harness.deps);
+      try {
