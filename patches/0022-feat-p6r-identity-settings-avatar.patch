From ab5430b143873e28648673f43017f9fd956196c3 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Tue, 8 Sep 2026 23:59:03 -0400
Subject: [PATCH] feat(p6r): show provider avatar in identity settings

---
 .../settings/P6rIdentitySettingsSection.tsx   | 32 ++++++++++++++-----
 1 file changed, 24 insertions(+), 8 deletions(-)

diff --git a/apps/app/src/components/settings/P6rIdentitySettingsSection.tsx b/apps/app/src/components/settings/P6rIdentitySettingsSection.tsx
index 15151dc547e87de06e64a0fc96b4acfacf1a9241..9a61ad8c4e62a93557f03c7b083a37b8842bc83c 100644
--- a/apps/app/src/components/settings/P6rIdentitySettingsSection.tsx
+++ b/apps/app/src/components/settings/P6rIdentitySettingsSection.tsx
@@ -1,6 +1,7 @@
 import { useQuery } from "@tanstack/react-query";
 import { Link } from "react-router-dom";
 import { Button } from "@bb/shared-ui/button";
+import { Avatar, AvatarImage, AvatarFallback } from "@bb/shared-ui/avatar";
 import { SettingsSection } from "@/components/ui/settings-section";
 import { useSystemConfig } from "@/hooks/queries/system-queries";
 import { sdk } from "@/lib/sdk";
@@ -26,14 +27,29 @@ export function P6rIdentitySettingsSection() {
             <p className="text-muted-foreground">Checking identity…</p>
           ) : result?.status === "ready" ? (
             <div className="space-y-1">
-              <p className="font-medium">
-                {result.actor.presentation.displayName}
-              </p>
-              {result.actor.presentation.handle && (
-                <p className="text-muted-foreground">
-                  @{result.actor.presentation.handle}
-                </p>
-              )}
+              <div className="flex items-center gap-3">
+                <Avatar key={result.actor.identity.key} aria-hidden="true">
+                  <AvatarImage
+                    src={result.actor.presentation.avatarUrl ?? undefined}
+                    alt=""
+                    referrerPolicy="no-referrer"
+                    className="object-cover"
+                  />
+                  <AvatarFallback>
+                    {result.actor.presentation.displayName.slice(0, 1)}
+                  </AvatarFallback>
+                </Avatar>
+                <div className="min-w-0 space-y-1 break-words">
+                  <p className="font-medium">
+                    {result.actor.presentation.displayName}
+                  </p>
+                  {result.actor.presentation.handle && (
+                    <p className="text-muted-foreground">
+                      @{result.actor.presentation.handle}
+                    </p>
+                  )}
+                </div>
+              </div>
               <p className="text-sm text-muted-foreground">
                 Verified by {result.providerId}
               </p>
