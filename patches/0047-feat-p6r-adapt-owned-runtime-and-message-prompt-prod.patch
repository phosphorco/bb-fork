+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { PromptInput } from "@bb/domain";
+import * as contributions from "../../../src/services/plugins/plugin-agent-contributions.js";
+import { resolvePluginMentionContextInputs } from "../../../src/services/plugins/plugin-mentions.js";
+import { setPromptProvider } from "../../../src/services/prompts/render-prompt.js";
+
+afterEach(() => {
+  setPromptProvider(undefined);
+  vi.restoreAllMocks();
+});
+
+describe("prompt producer adapters", () => {
+  it("changes the mention header while preserving resolved text, images and agent-only visibility", async () => {
+    const payload = "Untrusted payload {{description}} stays verbatim.";
+    vi.spyOn(contributions, "resolvePluginMention").mockResolvedValue({
+      ok: true,
+      context: payload,
+      images: [
+        {
+          type: "image",
+          url: "https://example.test/image.png",
+          context: "Image context",
+        },
+      ],
+    });
+    const input: PromptInput[] = [
+      {
+        type: "text",
+        text: "@report",
+        mentions: [
+          {
+            start: 0,
+            end: 7,
+            resource: {
+              kind: "plugin",
+              pluginId: "notes",
+              itemId: "report",
+              label: "report",
+            },
+          },
+        ],
+      },
+    ];
+    const original = await resolvePluginMentionContextInputs(input);
+    const contextIds: string[] = [];
+    setPromptProvider({
+      middleware: () => [
+        {
+          pluginId: "wording",
+          name: "header",
+          middleware: (request, next) => {
+            if (request.id !== "bb.mention.context-header") return next();
+            contextIds.push(request.context?.sourcePluginId ?? "missing");
+            return "Referenced material:\n\n";
+          },
+        },
+      ],
+      observers: () => [],
+      warn: () => {},
+    });
+    const customized = await resolvePluginMentionContextInputs(input);
+    expect(customized[0]).toEqual({
+      type: "text",
+      text: `Referenced material:\n\n${payload}`,
+      mentions: [],
+      visibility: "agent-only",
+    });
+    expect(customized.slice(1)).toEqual(original.slice(1));
+    expect(contextIds).toEqual(["notes"]);
+    expect(input[0]).toEqual({
+      type: "text",
+      text: "@report",
+      mentions: [
+        {
+          start: 0,
+          end: 7,
+          resource: {
+            kind: "plugin",
+            pluginId: "notes",
+            itemId: "report",
+            label: "report",
+          },
+        },
+      ],
+    });
+  });
+});
diff --git a/apps/server/test/threads/prompt-message-rendering.test.ts b/apps/server/test/threads/prompt-message-rendering.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..457e23322740a8a8df39a716e6bfe2b91d846ee0
--- /dev/null
+++ b/apps/server/test/threads/prompt-message-rendering.test.ts
@@ -0,0 +1,397 @@
+import { randomUUID } from "node:crypto";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type {
+  P6rPromptMiddleware,
+  P6rPromptObservation,
+} from "@get-bb/plugin-sdk";
+import { renderTemplate } from "@bb/templates";
+import { setPromptProvider } from "../../src/services/prompts/render-prompt.js";
+import { buildCommitMessagePrompt } from "../../src/services/ai/commit-message.js";
+import { buildThreadTitlePrompt } from "../../src/services/threads/title-generation.js";
+import { formatAgentThreadInput } from "../../src/services/threads/thread-send.js";
+import {
+  buildParentSystemInputFromSegments,
+  buildParentSystemThreadMention,
+} from "../../src/services/threads/parent-system-messages.js";
+import {
+  buildChildThreadNeedsAttentionInput,
+  buildChildThreadTurnStatusBatchInput,
+} from "../../src/services/threads/child-thread-notifications.js";
+
+vi.mock("node:crypto", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("node:crypto")>();
+  return { ...actual, randomUUID: vi.fn(actual.randomUUID) };
+});
+
+const child = { id: "child", title: "Unicode 🦉", projectId: "project" };
+const mention = buildParentSystemThreadMention({ thread: child });
+const commitArgs = {
+  diffDescription: "changes",
+  shortstat: "1 file",
+  files: "file.ts",
+  patch: "+flag",
+};
+
+function customize(middleware: P6rPromptMiddleware) {
+  const samples: P6rPromptObservation[] = [];
+  const warnings: string[] = [];
+  setPromptProvider({
+    middleware: () => [{ pluginId: "test", name: "rewrite", middleware }],
+    observers: () => [
+      {
+        pluginId: "test",
+        name: "capture",
+        observer: (sample) => samples.push(sample),
+      },
+    ],
+    warn: (message) => warnings.push(message),
+  });
+  return { samples, warnings };
+}
+
+afterEach(() => {
+  setPromptProvider(undefined);
+  vi.mocked(randomUUID).mockClear();
+});
+
+describe("message prompt adapters", () => {
+  it("preserves stock helper prompts and agent text, rebasing existing UTF-16 mentions without mutating inputs", () => {
+    expect(buildCommitMessagePrompt(commitArgs)).toBe(
+      renderTemplate("generateCommitMessage", commitArgs),
+    );
+    expect(
+      buildThreadTitlePrompt([
+        { type: "text", text: "Build a feature", mentions: [] },
+      ]),
+    ).toBe(
+      renderTemplate("generateThreadMetadata", {
+        cleanedPrompt: "Build a feature",
+      }),
+    );
+    const original = {
+      type: "text" as const,
+      text: "🦉 @thread:child\n\n",
+      mentions: [{ start: 3, end: 16, resource: mention.resource }],
+    };
+    const copy = structuredClone(original);
+    const [output] = formatAgentThreadInput({
+      input: [original],
+      senderThreadId: "sender",
+    });
+    expect(output?.type).toBe("text");
+    if (output?.type !== "text") throw new Error("Expected text");
+    expect(output.text).toBe(
+      renderTemplate("agentThreadMessage", {
+        senderThreadId: "sender",
+        messageText: original.text,
+      }),
+    );
+    expect(
+      output.text.slice(output.mentions[0]!.start, output.mentions[0]!.end),
+    ).toBe("@thread:child");
+    const prefixLength = "[bb message from thread:sender]\n\n".length;
+    expect(output.mentions[0]).toEqual({
+      start: prefixLength + 3,
+      end: prefixLength + 16,
+      resource: mention.resource,
+    });
+    expect(original).toEqual(copy);
+  });
+
+  it.each(["\n", "\r\n\t ", "\u00a0"])(
+    "preserves visible stock text and clips a final mention containing trailing %j",
+    (whitespace) => {
+      const original = {
+        type: "text" as const,
+        text: `🦉 @thread:child${whitespace}`,
+        mentions: [
+          { start: 3, end: 16 + whitespace.length, resource: mention.resource },
+        ],
+      };
+      const saved = structuredClone(original);
+      const [output] = formatAgentThreadInput({
+        input: [original],
+        senderThreadId: "sender",
+      });
+      if (output?.type !== "text") throw new Error("Expected text");
+      const stock = renderTemplate("agentThreadMessage", {
+        messageText: original.text,
+        senderThreadId: "sender",
+      });
+      expect(output.text).toBe(stock);
+      expect(output.mentions).toEqual([
+        { start: 36, end: 49, resource: mention.resource },
+      ]);
+      expect(
+        output.text.slice(output.mentions[0]!.start, output.mentions[0]!.end),
+      ).toBe("@thread:child");
+      const { samples } = customize((_request, next) => next());
+      expect(
+        formatAgentThreadInput({ input: [original], senderThreadId: "sender" }),
+      ).toEqual([output]);
+      expect(samples[0]?.defaultText).toBe(stock);
+      expect(samples[0]?.request.slots?.[0]?.text).toBe("@thread:child");
+      expect(original).toEqual(saved);
+    },
+  );
+
+  it("rejects a structured mention entirely removed by stock trailing whitespace trimming", () => {
+    const input = {
+      type: "text" as const,
+      text: "body\n\t ",
+      mentions: [{ start: 4, end: 7, resource: mention.resource }],
+    };
+    expect(() =>
+      formatAgentThreadInput({ input: [input], senderThreadId: "sender" }),
+    ).toThrow(
+      "Structured prompt mention was removed by trailing whitespace trimming",
+    );
+  });
+
+  it.each([
+    [
+      { start: 0, end: 5 },
+      { start: 4, end: 8 },
+    ],
+    [{ start: -1, end: 5 }],
+    [{ start: 0, end: 20 }],
+    [{ start: 0.5, end: 5 }],
+  ])(
+    "rejects invalid original mention ranges before clipping %j",
+    (...ranges) => {
+      const input = {
+        type: "text" as const,
+        text: "@thread:child\n",
+        mentions: ranges.map((range) => ({
+          ...range,
+          resource: mention.resource,
+        })),
+      };
+      expect(() =>
+        formatAgentThreadInput({ input: [input], senderThreadId: "sender" }),
+      ).toThrow("Invalid structured prompt mention range");
+    },
+  );
+
+  it("rewrites helper prompts and invokes each final ID once", () => {
+    const { samples } = customize((request, next) =>
+      request.id === "generateCommitMessage" ||
+      request.id === "generateThreadMetadata"
+        ? `Custom ${request.id}`
