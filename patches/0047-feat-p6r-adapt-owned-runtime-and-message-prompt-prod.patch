+  const renderedText = renderPrompt({
+    id: args.id,
+    kind: "message",
+    text: args.buildText ? args.buildText(maskedText) : maskedText,
+    ...(args.context ? { context: args.context } : {}),
+    slots: protectedMentions.map(({ token, mention }) => ({
+      token,
+      text: mention.serializedText,
+    })),
+  });
+  const ordered = protectedMentions
+    .map((entry) => ({
+      ...entry,
+      start: renderedText.indexOf(entry.token),
+    }))
+    .sort((a, b) => a.start - b.start);
+  let text = "";
+  let cursor = 0;
+  const mentions: PromptTextMention[] = [];
+  for (const entry of ordered) {
+    text += renderedText.slice(cursor, entry.start);
     const start = text.length;
-    text += segment.mention.serializedText;
+    text += entry.mention.serializedText;
     mentions.push({
       start,
       end: text.length,
-      resource: segment.mention.resource,
+      resource: entry.mention.resource,
     });
+    cursor = entry.start + entry.token.length;
   }
-
+  text += renderedText.slice(cursor);
   return [{ type: "text", text, mentions }];
 }
 
