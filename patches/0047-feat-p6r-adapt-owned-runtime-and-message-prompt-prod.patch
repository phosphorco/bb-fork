diff --git a/apps/server/test/prompts/render-tool-prompts.test.ts b/apps/server/test/prompts/render-tool-prompts.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..43fd9c18d6b8980263d8003efd491ab8f5eb9711
--- /dev/null
+++ b/apps/server/test/prompts/render-tool-prompts.test.ts
@@ -0,0 +1,236 @@
+import { afterEach, describe, expect, it } from "vitest";
+import type { DynamicTool } from "@bb/domain";
+import type { P6rPromptRequest } from "@get-bb/plugin-sdk";
+import { setPromptProvider } from "../../src/services/prompts/render-prompt.js";
+import { renderToolPrompts } from "../../src/services/prompts/render-tool-prompts.js";
+
+const context = {
+  threadId: "thread",
+  projectId: "project",
+  providerId: "provider",
+  sourcePluginId: "demo",
+};
+
+function freeze(value: unknown): void {
+  if (value === null || typeof value !== "object") return;
+  Object.values(value).forEach(freeze);
+  Object.freeze(value);
+}
+
+function rewriteDescriptions(requests: P6rPromptRequest[]): void {
+  setPromptProvider({
+    middleware: () => [
+      {
+        pluginId: "test",
+        name: "descriptions",
+        middleware: (request, next) => {
+          requests.push(request);
+          return next(`rendered:${request.text}`);
+        },
+      },
+    ],
+    observers: () => [],
+    warn: () => {
+      throw new Error("Unexpected fallback");
+    },
+  });
+}
+
+afterEach(() => setPromptProvider(undefined));
+
+describe("runtime tool prompt schema traversal", () => {
+  const schemaCases: Array<[string, unknown, string]> = [
+    [
+      "properties",
+      { "a~/b": { description: "leaf" } },
+      "/properties/a~0~1b/description",
+    ],
+    [
+      "patternProperties",
+      { "^x": { description: "leaf" } },
+      "/patternProperties/^x/description",
+    ],
+    ["$defs", { node: { description: "leaf" } }, "/$defs/node/description"],
+    [
+      "definitions",
+      { node: { description: "leaf" } },
+      "/definitions/node/description",
+    ],
+    [
+      "dependentSchemas",
+      { node: { description: "leaf" } },
+      "/dependentSchemas/node/description",
+    ],
+    [
+      "dependencies",
+      { node: { description: "leaf" }, required: ["description"] },
+      "/dependencies/node/description",
+    ],
+    ["items", { description: "leaf" }, "/items/description"],
+    ["items", [{ description: "leaf" }, false], "/items/0/description"],
+    ...["allOf", "anyOf", "oneOf", "prefixItems"].map(
+      (key): [string, unknown, string] => [
+        key,
+        [{ description: "leaf" }, true],
+        `/${key}/0/description`,
+      ],
+    ),
+    ...[
+      "additionalProperties",
+      "unevaluatedProperties",
+      "propertyNames",
+      "contains",
+      "additionalItems",
+      "unevaluatedItems",
+      "not",
+      "if",
+      "then",
+      "else",
+      "contentSchema",
+    ].map((key): [string, unknown, string] => [
+      key,
+      { description: "leaf" },
+      `/${key}/description`,
+    ]),
+  ];
+  it.each(schemaCases)(
+    "renders schema nodes under %s",
+    (key, value, pointer) => {
+      const requests: P6rPromptRequest[] = [];
+      rewriteDescriptions(requests);
+      const tool = {
+        name: "lookup",
+        description: "tool",
+        inputSchema: { [key]: value },
+      };
+      const original = structuredClone(tool);
+      freeze(tool);
+      const rendered = renderToolPrompts(tool, context);
+      expect(rendered.description).toBe("rendered:tool");
+      expect(requests).toEqual([
+        {
+          id: "bb.tool.lookup.description",
+          kind: "tool-description",
+          text: "tool",
+          context,
+        },
+        {
+          id: `bb.tool.lookup.schema${pointer}`,
+          kind: "schema-description",
+          text: "leaf",
+          context,
+        },
+      ]);
+      expect(JSON.stringify(rendered.inputSchema)).toBe(
+        JSON.stringify(original.inputSchema).replace(
+          '"description":"leaf"',
+          '"description":"rendered:leaf"',
+        ),
+      );
+      expect(tool).toEqual(original);
+    },
+  );
+
+  it("recurses through nested schema annotations while preserving arbitrary fields and literal description data", () => {
+    const requests: P6rPromptRequest[] = [];
+    rewriteDescriptions(requests);
+    const schema = {
+      $id: "https://example.test/schema",
+      $ref: "#/$defs/value",
+      description: "root",
+      properties: {
+        description: {
+          description: "property named description",
+          items: {
+            anyOf: [
+              {
+                description: "nested",
+                additionalProperties: { description: "extra" },
+              },
+            ],
+          },
+          enum: [
+            {
+              description: "enum",
+              properties: { description: "enum properties" },
+            },
+          ],
+          const: { description: "constant" },
+          default: { description: "default" },
+          examples: [{ description: "example" }],
+          "x-extension": { description: "extension" },
+          title: "title",
+          format: "opaque",
+          required: ["description"],
+        },
+      },
+      $defs: { value: { type: "string", description: "reference body" } },
+      enum: [{ description: "root enum" }],
+      "x-arbitrary": { properties: { field: { description: "unknown data" } } },
+    };
+    const original = structuredClone(schema);
+    const tool: DynamicTool = {
+      name: "lookup",
+      description: "tool",
+      inputSchema: schema,
+      presentation: {
+        label: { pending: "pending", completed: "done" },
+        icon: { glyph: "Search" },
+      },
+    };
+    freeze(tool);
+    const rendered = renderToolPrompts(tool, context);
+    expect(rendered.inputSchema).toEqual({
+      ...original,
+      description: "rendered:root",
+      properties: {
+        description: {
+          ...original.properties.description,
+          description: "rendered:property named description",
+          items: {
+            anyOf: [
+              {
+                description: "rendered:nested",
+                additionalProperties: { description: "rendered:extra" },
+              },
+            ],
+          },
+        },
+      },
+      $defs: {
+        value: { type: "string", description: "rendered:reference body" },
+      },
+    });
+    expect(requests.map((request) => request.id)).toEqual([
+      "bb.tool.lookup.description",
+      "bb.tool.lookup.schema/description",
+      "bb.tool.lookup.schema/properties/description/description",
+      "bb.tool.lookup.schema/properties/description/items/anyOf/0/description",
+      "bb.tool.lookup.schema/properties/description/items/anyOf/0/additionalProperties/description",
+      "bb.tool.lookup.schema/$defs/value/description",
+    ]);
+    expect(schema).toEqual(original);
+    expect(rendered.name).toBe(tool.name);
+    expect(rendered.presentation).toEqual(tool.presentation);
+  });
+
+  it.each([
+    true,
+    false,
+    {
+      type: "object",
+      properties: { a: true, b: false },
+      additionalProperties: false,
+      description: 123,
+      default: { description: "data" },
+    },
+  ])("preserves defaults without customization", (inputSchema) => {
+    setPromptProvider(undefined);
+    const tool = {
+      name: "lookup",
+      description: "  Tool description\n",
+      inputSchema,
+    };
+    expect(renderToolPrompts(tool, context)).toEqual(tool);
+  });
+});
