+export function parentSystemSegmentsFromText(
+  input: Extract<PromptInput, { type: "text" }>,
+  options?: { trimEnd: boolean },
+): ParentSystemInputSegment[] {
+  const text = options?.trimEnd ? input.text.trimEnd() : input.text;
+  const segments: ParentSystemInputSegment[] = [];
+  let end = 0;
+  let previousMentionEnd = 0;
+  for (const mention of [...input.mentions].sort((a, b) => a.start - b.start)) {
+    if (
+      !Number.isInteger(mention.start) ||
+      !Number.isInteger(mention.end) ||
+      mention.start < previousMentionEnd ||
+      mention.end <= mention.start ||
+      mention.end > input.text.length
+    ) {
+      throw new Error("Invalid structured prompt mention range");
+    }
+    previousMentionEnd = mention.end;
+    const visibleEnd = Math.min(mention.end, text.length);
+    if (mention.start >= visibleEnd) {
+      throw new Error(
+        "Structured prompt mention was removed by trailing whitespace trimming",
+      );
+    }
+    segments.push({ kind: "text", text: text.slice(end, mention.start) });
+    segments.push({
+      kind: "mention",
+      mention: {
+        resource: mention.resource,
+        serializedText: text.slice(mention.start, visibleEnd),
+      },
+    });
+    end = visibleEnd;
+  }
+  segments.push({ kind: "text", text: text.slice(end) });
+  return segments;
+}
 
+export function buildParentSystemInputFromSegments(
+  args: BuildParentSystemInputFromSegmentsArgs,
+): Extract<PromptInput, { type: "text" }>[] {
+  const inputTexts = args.segments
+    .map((segment) =>
+      segment.kind === "text" ? segment.text : segment.mention.serializedText,
+    )
+    .concat(args.collisionTexts ?? []);
+  inputTexts.push(inputTexts.join(""));
+  const nonce = randomUUID();
+  let attempt = 0;
+  let prefix: string;
+  do {
+    prefix = `__BB_PROMPT_MENTION_${nonce}_${attempt++}_`;
+  } while (inputTexts.some((text) => text.includes(prefix)));
+  const protectedMentions: {
+    token: string;
+    mention: ParentSystemRenderedMention;
+  }[] = [];
+  let maskedText = "";
   for (const segment of args.segments) {
     if (segment.kind === "text") {
-      text += segment.text;
-      continue;
-    }
-
-    if (segment.mention.serializedText.length === 0) {
-      throw new Error("Parent system mention text must not be empty");
+      maskedText += segment.text;
+    } else {
+      if (segment.mention.serializedText.length === 0) {
+        throw new Error("Parent system mention text must not be empty");
+      }
+      const token = `${prefix}${protectedMentions.length}__`;
+      protectedMentions.push({ token, mention: segment.mention });
+      maskedText += token;
     }
