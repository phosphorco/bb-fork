diff --git a/apps/server/src/services/prompts/render-tool-prompts.ts b/apps/server/src/services/prompts/render-tool-prompts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..796bdce8bf51eb98cf0e1c33ea831e47aaa78e93
--- /dev/null
+++ b/apps/server/src/services/prompts/render-tool-prompts.ts
@@ -0,0 +1,98 @@
+import type { DynamicTool } from "@bb/domain";
+import type { P6rPromptContext } from "@get-bb/plugin-sdk";
+import { renderPrompt } from "./render-prompt.js";
+
+const schemaMaps = new Set([
+  "properties",
+  "patternProperties",
+  "$defs",
+  "definitions",
+  "dependentSchemas",
+]);
+const schemaSingles = new Set([
+  "additionalProperties",
+  "unevaluatedProperties",
+  "propertyNames",
+  "contains",
+  "additionalItems",
+  "unevaluatedItems",
+  "not",
+  "if",
+  "then",
+  "else",
+  "contentSchema",
+]);
+const schemaArrays = new Set(["allOf", "anyOf", "oneOf", "prefixItems"]);
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function pointerSegment(value: string): string {
+  return value.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+function renderSchema(
+  schema: unknown,
+  toolName: string,
+  pointer: string,
+  context: P6rPromptContext,
+): void {
+  if (!isObject(schema)) return;
+  for (const [key, value] of Object.entries(schema)) {
+    const childPointer = `${pointer}/${pointerSegment(key)}`;
+    if (key === "description" && typeof value === "string") {
+      schema[key] = renderPrompt({
+        id: `bb.tool.${toolName}.schema${pointer}/description`,
+        kind: "schema-description",
+        text: value,
+        context,
+      });
+    } else if (schemaMaps.has(key) && isObject(value)) {
+      for (const [name, child] of Object.entries(value)) {
+        renderSchema(
+          child,
+          toolName,
+          `${childPointer}/${pointerSegment(name)}`,
+          context,
+        );
+      }
+    } else if (schemaSingles.has(key)) {
+      renderSchema(value, toolName, childPointer, context);
+    } else if (schemaArrays.has(key) || key === "items") {
+      if (Array.isArray(value)) {
+        value.forEach((child, index) => {
+          renderSchema(child, toolName, `${childPointer}/${index}`, context);
+        });
+      } else if (key === "items") {
+        renderSchema(value, toolName, childPointer, context);
+      }
+    } else if (key === "dependencies" && isObject(value)) {
+      for (const [name, child] of Object.entries(value)) {
+        if (isObject(child)) {
+          renderSchema(
+            child,
+            toolName,
+            `${childPointer}/${pointerSegment(name)}`,
+            context,
+          );
+        }
+      }
+    }
+  }
+}
+
+export function renderToolPrompts(
+  tool: DynamicTool,
+  context: P6rPromptContext,
+): DynamicTool {
+  const inputSchema = structuredClone(tool.inputSchema);
+  const description = renderPrompt({
+    id: `bb.tool.${tool.name}.description`,
+    kind: "tool-description",
+    text: tool.description,
+    context,
+  });
+  renderSchema(inputSchema, tool.name, "", context);
+  return { ...tool, description, inputSchema };
+}
