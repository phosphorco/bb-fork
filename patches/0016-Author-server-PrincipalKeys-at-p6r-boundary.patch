+++ b/apps/server/src/services/identity.ts
@@ -7,6 +7,9 @@ import {
 import type { Context } from "hono";
 import {
   p6rActorSnapshotSchema,
+  p6rCreateLocalPrincipalKey,
+  p6rCreateProviderPrincipalKey,
+  type P6rPrincipalKey,
   type P6rActorSnapshot,
   type P6rClaimedIdentity,
 } from "@bb/domain";
@@ -25,6 +28,17 @@ export const P6R_REQUEST_PRINCIPAL_CONTEXT_KEY = "p6rRequestPrincipal";
 export const P6R_IDENTITY_PROVIDER_TIMEOUT_MS = 50;
 export const P6R_LOCAL_OPERATOR_PROVIDER_ID = "p6r-local-operator";
 
+export function p6rPrincipalKeyForActor(
+  actor: P6rActorSnapshot,
+): P6rPrincipalKey {
+  return actor.p6rProviderId === P6R_LOCAL_OPERATOR_PROVIDER_ID
+    ? p6rCreateLocalPrincipalKey(actor.p6rSubject)
+    : p6rCreateProviderPrincipalKey(
+        "p6r",
+        `${actor.p6rProviderId}/${actor.p6rSubject}`,
+      );
+}
+
 export interface P6rRequestResolution {
   kind: "authenticated";
   p6rActor: P6rActorSnapshot;
