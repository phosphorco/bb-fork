diff --git a/packages/agent-runtime/src/runtime.codex-topology.test.ts b/packages/agent-runtime/src/runtime.codex-topology.test.ts
index 22caf70fb4b902c5b85680853dd839bac97b2e80..bd72652e0c861aa9050145038892af47cd8bc026 100644
--- a/packages/agent-runtime/src/runtime.codex-topology.test.ts
+++ b/packages/agent-runtime/src/runtime.codex-topology.test.ts
@@ -378,6 +378,25 @@ describe("codex process topology", () => {
     expect(topology.bridgeExits).toEqual([{ expected: true }]);
   }, 30_000);
 
+  it("uses the thread construction deadline when restoring a Codex session", async () => {
+    const { runtime } = createCodexTopologyRuntime({
+      fakeScript: { stallThreadResume: true },
+      threadCreationTimeoutMs: 200,
+    });
+    const providerThreadId = await startCodexThread(runtime, "source");
+    await runtime.stopThread({ threadId: "source" });
+
+    await expect(runtime.resumeThread({
+      environmentId: "env-1",
+      projectId: "p1",
+      providerId: "codex",
+      providerThreadId,
+      threadId: "resumed",
+      options: fullRuntimeOptions,
+    })).rejects.toThrow(/timed out: thread\/resume/i);
+    expect(runtime.hasThread("resumed")).toBe(false);
+  }, 10_000);
+
   it("refuses to resume a provider thread that another hosted thread already owns", async () => {
     const topology = createCodexTopologyRuntime();
     const { runtime } = topology;
