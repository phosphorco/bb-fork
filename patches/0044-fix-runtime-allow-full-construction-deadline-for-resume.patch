From e2dbc27566a39fb033d86a4ed1298785bed115d1 Mon Sep 17 00:00:00 2001
From: bb-machine <ubuntu@bb-machine>
Date: Mon, 28 Sep 2026 19:26:18 +0200
Subject: [PATCH] fix(runtime): allow full construction deadline for resume

---
 .../src/runtime.codex-topology.test.ts        | 19 +++++++++++++++++++
 .../src/bridge/fake-codex-app-server.mjs      |  2 ++
 2 files changed, 21 insertions(+)

diff --git a/packages/agent-runtime/src/runtime.codex-topology.test.ts b/packages/agent-runtime/src/runtime.codex-topology.test.ts
index 6ad41a8ac1b1ff44f4610eeac60ca7a71307b706..fd60ace78e08797eeec8fd3b995dac5070f993c7 100644
--- a/packages/agent-runtime/src/runtime.codex-topology.test.ts
+++ b/packages/agent-runtime/src/runtime.codex-topology.test.ts
@@ -384,6 +384,25 @@ describe("codex process topology", () => {
     expect(topology.bridgeExits).toEqual([{ expected: true }]);
   }, 30_000);
 
+  it("uses the thread construction deadline when restoring a Codex session", async () => {
+    const { runtime } = createCodexTopologyRuntime({
+      fakeScript: { stallThreadResume: true },
+      threadCreationTimeoutMs: 200,
+    });
+    const providerThreadId = await startCodexThread(runtime, "source");
+    await runtime.stopThread({ threadId: "source" });
+
+    await expect(runtime.resumeThread({
+      environmentId: "env-1",
+      projectId: "p1",
+      providerId: "codex",
+      providerThreadId,
+      threadId: "resumed",
+      options: fullRuntimeOptions,
+    })).rejects.toThrow(/timed out: thread\/resume/i);
+    expect(runtime.hasThread("resumed")).toBe(false);
+  }, 10_000);
+
   it("refuses to resume a provider thread that another hosted thread already owns", async () => {
     const topology = createCodexTopologyRuntime();
     const { runtime } = topology;
diff --git a/plugins/provider-codex/src/bridge/fake-codex-app-server.mjs b/plugins/provider-codex/src/bridge/fake-codex-app-server.mjs
index 8b47f799bae5d2a0803eb8fb27c44f12d6bcb134..7c19bdf0e2bcfcb2ebc927c69bf42cbc3f42ec32 100644
--- a/plugins/provider-codex/src/bridge/fake-codex-app-server.mjs
+++ b/plugins/provider-codex/src/bridge/fake-codex-app-server.mjs
@@ -219,6 +219,7 @@ const archivedThreadIds = new Set();
 
 const processLogPath = script?.processLogPath ?? null;
 const stallThreadStart = script?.stallThreadStart ?? false;
+const stallThreadResume = script?.stallThreadResume ?? false;
 const writerLockPath = script?.writerLockPath ?? null;
 const rejectThreadStart = script?.rejectThreadStart ?? false;
 const malformedThreadStart = script?.malformedThreadStart ?? false;
@@ -500,6 +501,7 @@ async function handleRequest(message) {
     }
     case "thread/resume": {
       servesThread = true;
+      if (stallThreadResume) return;
       if (!acquireWriterLock()) {
         logProcessStep("writer-conflict");
         respondError(
-- 
