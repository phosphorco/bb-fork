+async function startStalledConfigReloadTestServer(): Promise<ConfigReloadTestServer> {
+  const reloadRequests: ConfigReloadRequest[] = [];
+  const server = createServer(
+    (request: IncomingMessage, _response: ServerResponse) => {
+      if (
+        request.method === "POST" &&
+        request.url === "/api/v1/system/config/reload"
+      ) {
+        reloadRequests.push({
+          host: request.headers.host,
+          method: request.method,
+          url: request.url,
+        });
+      }
+    },
+  );
+
+  await new Promise<void>((resolvePromise, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", () => {
+      resolvePromise();
+    });
+  });
+
+  const address = server.address();
+  if (typeof address === "string" || address === null) {
+    throw new Error("Expected stalled test server to listen on a TCP port");
+  }
+  const addressInfo: AddressInfo = address;
+
+  return {
+    async close(): Promise<void> {
+      server.closeAllConnections();
+      await new Promise<void>((resolvePromise, reject) => {
+        server.close((error) => {
+          if (error) {
+            reject(error);
+            return;
+          }
+          resolvePromise();
+        });
+      });
+    },
+    port: addressInfo.port,
+    reloadCount(): number {
+      return reloadRequests.length;
+    },
+    reloadRequests(): ConfigReloadRequest[] {
+      return [...reloadRequests];
+    },
+    url: `http://127.0.0.1:${addressInfo.port}`,
+  };
