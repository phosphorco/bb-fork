+type HttpListener = ReturnType<typeof startHttpListener>;
+
+export function resolveTailnetIngressPort(args: {
+  portText: string | undefined;
+  serverConfig: Pick<ServerConfig, "BB_SERVER_BIND_HOST" | "BB_SERVER_PORT" | "BB_HOST_DAEMON_PORT">;
+}): number | null {
+  if (args.portText === undefined) return null;
+  const port = Number(args.portText);
+  if (
+    !Number.isInteger(port) ||
+    port < 1 ||
+    port > 65535 ||
+    port === args.serverConfig.BB_SERVER_PORT ||
+    port === args.serverConfig.BB_HOST_DAEMON_PORT ||
+    !isLoopbackHostname(args.serverConfig.BB_SERVER_BIND_HOST)
+  ) {
+    throw new Error("BB_TAILNET_INGRESS_PORT must be a distinct loopback TCP port");
+  }
+  return port;
+}
+
+async function waitForHttpListener(server: HttpListener): Promise<void> {
+  if (!server.listening) await once(server, "listening");
+}
+
+async function closeHttpListener(server: HttpListener): Promise<void> {
+  if (!server.listening) return;
+  await new Promise<void>((resolveClose, rejectClose) => {
+    server.close((error) => {
+      if (error) rejectClose(error);
+      else resolveClose();
+    });
+  });
+}
+
+export async function closeConfiguredHttpListeners(args: {
+  server: HttpListener;
+  tailnetServer: HttpListener | null;
+}): Promise<void> {
+  await Promise.all([
+    closeHttpListener(args.server),
+    ...(args.tailnetServer === null ? [] : [closeHttpListener(args.tailnetServer)]),
+  ]);
+}
+
+export async function startConfiguredHttpListeners(args: {
+  fetch: StartHttpListenerArgs["fetch"];
+  serverConfig: Pick<ServerConfig, "BB_SERVER_BIND_HOST" | "BB_SERVER_PORT" | "BB_HOST_DAEMON_PORT">;
+  tailnetPortText: string | undefined;
+}): Promise<{ server: HttpListener; tailnetServer: HttpListener | null }> {
+  const tailnetPort = resolveTailnetIngressPort({
+    portText: args.tailnetPortText,
+    serverConfig: args.serverConfig,
+  });
+  const server = startHttpListener({ fetch: args.fetch, serverConfig: args.serverConfig });
+  try {
+    await waitForHttpListener(server);
+    const tailnetServer =
+      tailnetPort === null
+        ? null
+        : startHttpListener({
+            fetch: args.fetch,
+            serverConfig: {
+              BB_SERVER_BIND_HOST: "127.0.0.1",
+              BB_SERVER_PORT: tailnetPort,
+            },
+          });
+    if (tailnetServer !== null) await waitForHttpListener(tailnetServer);
+    return { server, tailnetServer };
+  } catch (error) {
+    await closeHttpListener(server);
+    throw error;
+  }
+}
+
+export function startStartupRecoveryAfterListeners(args: {
+  listeners: { server: HttpListener; tailnetServer: HttpListener | null };
+  run: () => Promise<void>;
+  onError: (error: unknown) => void;
+}): void {
+  if (
+    !args.listeners.server.listening ||
+    (args.listeners.tailnetServer !== null && !args.listeners.tailnetServer.listening)
+  ) {
+    throw new Error("Startup recovery requires listening ingress sockets");
+  }
+  void args.run().catch(args.onError);
+}
