diff --git a/apps/server/src/services/providers/required-external-model-catalog.ts b/apps/server/src/services/providers/required-external-model-catalog.ts
new file mode 100644
index 0000000000000000000000000000000000000000..04660a04ae01da8de9b5815bfa97744009add65c
--- /dev/null
+++ b/apps/server/src/services/providers/required-external-model-catalog.ts
@@ -0,0 +1,71 @@
+import { availableModelSchema, type AvailableModel } from "@bb/domain";
+import { z } from "zod";
+
+const catalogueSchema = z.object({
+  data: z.array(z.object({ id: z.string().min(1).max(200) })).max(4096),
+});
+
+// Catalogue discovery uses the same server-held route/key as inference. Workers
+// receive model facts over their authenticated BB command transport, never keys.
+export async function readRequiredExternalModelCatalog(
+  providerId: string,
+  env: NodeJS.ProcessEnv = process.env,
+  request: typeof fetch = fetch,
+): Promise<{ models: AvailableModel[]; selectedOnlyModels: AvailableModel[] }> {
+  try {
+    const origin = new URL(env.BB_ACCOUNT_POOL_EXTERNAL_URL ?? "");
+    const token = env.BB_ACCOUNT_POOL_EXTERNAL_TOKEN ?? "";
+    if (
+      env.BB_ACCOUNT_POOL_EXTERNAL_REQUIRED !== "1" ||
+      origin.protocol !== "https:" ||
+      !origin.hostname.endsWith(".ts.net") ||
+      origin.username ||
+      origin.password ||
+      origin.port ||
+      origin.pathname !== "/" ||
+      origin.search ||
+      origin.hash ||
+      !token ||
+      /\s/.test(token)
+    )
+      throw new Error();
+    const response = await request(`${origin.origin}/v1/models`, {
+      headers: { authorization: `Bearer ${token}` },
+      redirect: "error",
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) throw new Error();
+    const bytes = await response.text();
+    if (Buffer.byteLength(bytes) > 1024 * 1024) throw new Error();
+    const catalogue = catalogueSchema.parse(JSON.parse(bytes));
+    const seen = new Set<string>();
+    const models: AvailableModel[] = [];
+    for (const { id } of catalogue.data) {
+      const admitted =
+        providerId === "claude-code"
+          ? /^claude-(?:opus|sonnet|haiku)-/u.test(id)
+          : providerId === "codex" &&
+            /^gpt-\d[\w.-]*$/u.test(id) &&
+            !/(?:image|audio|realtime|transcri|embedding)/u.test(id);
+      if (!admitted || seen.has(id)) continue;
+      seen.add(id);
+      models.push(
+        availableModelSchema.parse({
+          id,
+          model: id,
+          displayName: id,
+          description:
+            "Available through the required shared BB inference pool.",
+          supportedReasoningEfforts: [],
+          defaultReasoningEffort: "low",
+          isDefault: false,
+        }),
+      );
+    }
+    if (models.length === 0) throw new Error();
+    return { models, selectedOnlyModels: [] };
+  } catch {
+    // Never include a route key or upstream diagnostic in UI/log errors.
+    throw new Error("Required BB external model catalogue is unavailable.");
+  }
+}
