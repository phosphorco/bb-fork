+it("freezes two queued senders through drain and preserves the original author on retry", async () => {
+  const f = await fixture();
+  try {
+    const thread = f.newThread();
+    const before = getLatestThreadSequence(f.harness.db, {
+      threadId: thread.id,
+    });
+    for (const person of ["alice", "bob"]) {
+      f.setPerson(person);
+      const response = await f.post(`/threads/${thread.id}/queued-messages`, {
+        input,
+        ...execution,
+      });
+      expect(response.status, await response.clone().text()).toBe(201);
+    }
+    f.setPerson("outage");
+    const rows = listQueuedThreadMessages(f.harness.db, thread.id);
+    expect(rows).toHaveLength(2);
+    setQueuedThreadMessageGroupBoundary({
+      db: f.harness.db,
+      notifier: f.harness.hub,
+      threadId: thread.id,
+      expectedGroupedPrefixQueuedMessageIds: rows.map((row) => row.id),
+      groupBoundaryQueuedMessageId: rows[1]!.id,
+    });
+    await sendQueuedMessage(f.harness.deps, {
+      claimPolicy: { kind: "automatic", isGroupEligible: () => true },
+      threadId: thread.id,
+      queuedMessageId: rows[0]!.id,
+      mode: "auto",
+    });
+    const request = f.requestAfter(thread.id, before);
+    expect(
+      request.p6rAuthors?.map((author) => author?.identity.subject),
+    ).toEqual(["alice", "bob"]);
+    expect(request.inputGroups).toEqual([input, input]);
+    applyLoggedThreadLifecycleEvent(f.harness.deps, {
+      threadId: thread.id,
+      event: { type: "run.succeeded" },
+    });
+    const retryBefore = getLatestThreadSequence(f.harness.db, {
+      threadId: thread.id,
+    });
+    await sendThreadMessage(f.harness.deps, {
+      environment: f.environment,
+      thread,
+      payload: {
+        input: request.input,
+        inputGroups: request.inputGroups,
+        mode: "start",
+        ...execution,
+      },
+      trigger: "user",
+      retryOf: { requestId: request.requestId, attempt: 2 },
+    });
+    expect(f.requestAfter(thread.id, retryBefore).p6rAuthors).toEqual(
+      request.p6rAuthors,
+    );
+  } finally {
+    await f.harness.cleanup();
+  }
+});
