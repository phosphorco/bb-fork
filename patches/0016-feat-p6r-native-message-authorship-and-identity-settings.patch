diff --git a/apps/app/src/components/settings/P6rIdentitySettingsSection.test.tsx b/apps/app/src/components/settings/P6rIdentitySettingsSection.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..be25e5defe46f5eaa47d348b68df46ade5f2e890
--- /dev/null
+++ b/apps/app/src/components/settings/P6rIdentitySettingsSection.test.tsx
@@ -0,0 +1,103 @@
+// @vitest-environment jsdom
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, expect, it, vi } from "vitest";
+import { P6rIdentitySettingsSection } from "./P6rIdentitySettingsSection";
+import { P6rMessageAuthorLabel } from "../thread/timeline/P6rMessageAuthorLabel";
+import type { P6rIdentityResponse } from "@bb/server-contract";
+
+const mocks = vi.hoisted(() => ({
+  identity: vi.fn<() => Promise<P6rIdentityResponse>>(),
+}));
+vi.mock("@/lib/sdk", () => ({ sdk: { system: { p6rIdentity: mocks.identity } } }));
+vi.mock("@/hooks/queries/system-queries", () => ({
+  useSystemConfig: () => ({ data: { appearance: { themeId: "system" } } }),
+}));
+afterEach(() => {
+  cleanup();
+  mocks.identity.mockReset();
+});
+const actor = {
+  evidence: "provider-verified" as const,
+  identity: {
+    kind: "person" as const,
+    key: "opaque-person",
+    issuer: "test:people",
+    subject: "person-1",
+  },
+  presentation: {
+    displayName: "Test Person",
+    handle: "test-person",
+    avatarUrl: null,
+  },
+};
+function mount() {
+  return render(
+    <QueryClientProvider
+      client={
+        new QueryClient({ defaultOptions: { queries: { retry: false } } })
+      }
+    >
+      <MemoryRouter>
+        <P6rIdentitySettingsSection />
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+it("shows the resolved person and shared appearance without editable identity or personal override controls", async () => {
+  mocks.identity.mockResolvedValue({
+    status: "ready",
+    actor,
+    providerId: "people",
+  });
+  mount();
+  expect(await screen.findByText("@test-person")).toBeTruthy();
+  expect(screen.getByText("Verified by people")).toBeTruthy();
+  expect(screen.getByText("test:people")).toBeTruthy();
+  expect(
+    screen.getByRole("link", { name: /Appearance/ }).getAttribute("href"),
+  ).toBe("/settings/appearance");
+  expect(screen.queryAllByRole("textbox")).toHaveLength(0);
+  expect(
+    screen.getByText(/Personal theme overrides are not available/),
+  ).toBeTruthy();
+});
+it("removes the previously verified identity while rechecking and after provider failure", async () => {
+  mocks.identity.mockResolvedValueOnce({
+    status: "ready",
+    actor,
+    providerId: "people",
+  });
+  mount();
+  await screen.findByText("@test-person");
+  let resolve: (value: P6rIdentityResponse) => void = () => {};
+  mocks.identity.mockImplementationOnce(
+    () =>
+      new Promise((done) => {
+        resolve = done;
+      }),
+  );
+  fireEvent.click(screen.getByRole("button", { name: "Check again" }));
+  await screen.findByText("Checking identity…");
+  expect(screen.queryByText("@test-person")).toBeNull();
+  resolve({ status: "unavailable", message: "Provider is unavailable" });
+  await screen.findByText("Provider is unavailable");
+  expect(screen.queryByText("@test-person")).toBeNull();
+});
+it("shows baseline status without claiming a person and renders only supplied historical authors", async () => {
+  mocks.identity.mockResolvedValue({ status: "unconfigured" });
+  mount();
+  await waitFor(() =>
+    expect(screen.getByText(/No identity provider is configured/)).toBeTruthy(),
+  );
+  expect(screen.queryByText("@test-person")).toBeNull();
+  render(<P6rMessageAuthorLabel author={actor} />);
+  expect(screen.getByText("@test-person")).toBeTruthy();
+});
diff --git a/apps/app/src/components/settings/P6rIdentitySettingsSection.tsx b/apps/app/src/components/settings/P6rIdentitySettingsSection.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..15151dc547e87de06e64a0fc96b4acfacf1a9241
--- /dev/null
+++ b/apps/app/src/components/settings/P6rIdentitySettingsSection.tsx
@@ -0,0 +1,88 @@
+import { useQuery } from "@tanstack/react-query";
+import { Link } from "react-router-dom";
+import { Button } from "@bb/shared-ui/button";
+import { SettingsSection } from "@/components/ui/settings-section";
+import { useSystemConfig } from "@/hooks/queries/system-queries";
+import { sdk } from "@/lib/sdk";
+
+export function P6rIdentitySettingsSection() {
+  const identity = useQuery({
+    queryKey: ["system", "p6r-identity"],
+    queryFn: ({ signal }) => sdk.system.p6rIdentity({ signal }),
+    staleTime: 0,
+    gcTime: 0,
+    retry: false,
+  });
+  const config = useSystemConfig();
+  const result = identity.isError ? undefined : identity.data;
+  return (
+    <SettingsSection
+      title="Identity"
+      description="The identity BB resolves for your current connection."
+    >
+      <div className="space-y-5">
+        <div className="min-h-20" aria-live="polite">
+          {identity.isFetching ? (
+            <p className="text-muted-foreground">Checking identity…</p>
+          ) : result?.status === "ready" ? (
+            <div className="space-y-1">
+              <p className="font-medium">
+                {result.actor.presentation.displayName}
+              </p>
+              {result.actor.presentation.handle && (
+                <p className="text-muted-foreground">
+                  @{result.actor.presentation.handle}
+                </p>
+              )}
+              <p className="text-sm text-muted-foreground">
+                Verified by {result.providerId}
+              </p>
+              <details className="pt-2 text-sm">
+                <summary>Identity details</summary>
+                <dl className="mt-2 space-y-2 break-all">
+                  <div>
+                    <dt className="text-muted-foreground">Issuer</dt>
+                    <dd>{result.actor.identity.issuer}</dd>
+                  </div>
+                  <div>
+                    <dt className="text-muted-foreground">Subject</dt>
+                    <dd>{result.actor.identity.subject}</dd>
+                  </div>
+                </dl>
+              </details>
+            </div>
+          ) : result?.status === "unconfigured" ? (
+            <p>
+              No identity provider is configured. This instance uses its
+              ordinary local-user behavior.
+            </p>
+          ) : (
+            <p role="alert">
+              {result?.message ??
+                "Could not check your identity. Check your connection and try again."}
+            </p>
+          )}
+        </div>
+        <Button
+          variant="outline"
+          disabled={identity.isFetching}
+          onClick={() => void identity.refetch()}
+        >
+          Check again
+        </Button>
+        <div className="space-y-1">
+          <p className="font-medium">Appearance</p>
+          <p className="text-sm text-muted-foreground">
+            {config.data
+              ? `Shared theme: ${config.data.appearance.themeId}. `
+              : ""}
+            Personal theme overrides are not available in this version.
+          </p>
+          <Link className="text-sm underline" to="/settings/appearance">
+            Open Appearance settings
+          </Link>
+        </div>
+      </div>
+    </SettingsSection>
+  );
+}
