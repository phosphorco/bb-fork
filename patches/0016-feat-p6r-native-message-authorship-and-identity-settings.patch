+    expect(identity.headers.get("cache-control")).toBe("no-store");
+    const self = await identity.json();
+    expect(self).toMatchObject({
+      status: "ready",
+      providerId: "people",
+      actor: { evidence: "provider-verified", identity: { subject: "alice" } },
+    });
+    const created = await f.post("/threads", {
+      environment: { type: "reuse", environmentId: f.environment.id },
+      projectId: f.project.id,
