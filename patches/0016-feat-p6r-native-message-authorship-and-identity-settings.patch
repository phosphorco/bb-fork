new file mode 100644
index 0000000000000000000000000000000000000000..ea7e0bec03402fe076375be3001e82f96e5d7446
--- /dev/null
+++ b/apps/server/test/helpers/p6r-authorship.ts
@@ -0,0 +1,36 @@
+import { hostname } from "node:os";
+import { expect } from "vitest";
+
+export function p6rMachineWrappedInput(input: readonly unknown[]): unknown[] {
+  return [
+    {
+      type: "text",
+      visibility: "agent-only",
+      mentions: [],
+      text: `[from=machine:${hostname()}]\n`,
+    },
+    ...input,
+    {
+      type: "text",
+      visibility: "agent-only",
+      mentions: [],
+      text: `\n[/from=machine:${hostname()}]`,
+    },
+  ];
+}
+
+export function expectP6rMachineAuthor(author: unknown): void {
+  expect(author).toMatchObject({
+    evidence: "machine",
+    identity: {
+      kind: "machine",
+      key: expect.stringMatching(/^p6r-machine:v1:/),
+      instanceId: expect.any(String),
+    },
+    presentation: {
+      displayName: hostname(),
+      handle: null,
+      avatarUrl: null,
+    },
+  });
+}
