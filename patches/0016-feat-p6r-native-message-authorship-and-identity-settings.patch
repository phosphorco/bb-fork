@@ -0,0 +1,34 @@
+import { Avatar, AvatarImage, AvatarFallback } from "@bb/shared-ui/avatar";
+import type { P6rMessageAuthor } from "@bb/domain";
+
+export function P6rMessageAuthorLabel({
+  author,
+}: {
+  author: P6rMessageAuthor;
+}) {
+  const { presentation } = author;
+  return (
+    <div
+      className="mb-1 flex min-w-0 items-center justify-end gap-2 text-sm text-muted-foreground"
+      title={`Verified sender: ${presentation.displayName}`}
+    >
+      {presentation.avatarUrl && (
+        <Avatar className="size-5">
+          <AvatarImage
+            src={presentation.avatarUrl}
+            alt=""
+            referrerPolicy="no-referrer"
+          />
+          <AvatarFallback>
+            {presentation.displayName.slice(0, 1)}
+          </AvatarFallback>
+        </Avatar>
+      )}
+      <span className="truncate">
+        {presentation.handle
+          ? `@${presentation.handle}`
+          : presentation.displayName}
+      </span>
+    </div>
+  );
+}
