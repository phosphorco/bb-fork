+    const rows = listEvents(harness.db, { threadId }).filter(
+      (row) => row.type === "client/turn/requested" && row.sequence > sequence,
+    );
+    expect(rows).toHaveLength(1);
+    return turnRequestEventDataSchema.parse(JSON.parse(rows[0]!.data));
+  };
+  return {
+    harness,
+    app,
+    post,
+    newThread,
+    project,
+    environment,
+    requestAfter,
+    setPerson: (value: string) => {
+      person = value;
+    },
+    unconfigure: () => {
+      configured = false;
+    },
+    configure: () => {
+      configured = true;
+    },
+    untrust: () => {
+      trusted = false;
+    },
+    retireAfterAdmission: () => {
+      retireAfterAdmission = true;
+    },
+  };
+}
