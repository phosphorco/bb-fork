From e6d78d24bb55ea6f0fb922b6a1c3b571fa82b829 Mon Sep 17 00:00:00 2001
From: Rosetta <its-rosetta@users.noreply.github.com>
Date: Tue, 25 Aug 2026 13:44:00 -0400
Subject: [PATCH] fix(app): reject colliding thread query caches

---
 .../thread-list-cache-data.test.ts            | 45 +++++++++++++++++++
 .../cache-owners/thread-list-cache-data.ts    | 11 +++--
 2 files changed, 52 insertions(+), 4 deletions(-)
 create mode 100644 apps/app/src/hooks/cache-owners/thread-list-cache-data.test.ts

diff --git a/apps/app/src/hooks/cache-owners/thread-list-cache-data.test.ts b/apps/app/src/hooks/cache-owners/thread-list-cache-data.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ce51c9fdd7ce6576ad311fe9326dec3b1ae29f1f
--- /dev/null
+++ b/apps/app/src/hooks/cache-owners/thread-list-cache-data.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import { createQueryClientTestHarness } from "@/test/queryClientTestHarness";
+import { makeThreadListEntry } from "@/test/fixtures/thread-list-entries";
+import {
+  archivedThreadsListQueryKey,
+  myProgressFacetQueryKey,
+  threadFacetParticipantsQueryKey,
+  threadsQueryKey,
+} from "../queries/query-keys";
+import {
+  getCachedThreadLists,
+  iterateThreadListCacheEntries,
+} from "./thread-list-cache-data";
+
+describe("thread list cache data", () => {
+  it("ignores colliding infinite-query caches whose pages are not thread arrays", () => {
+    const { queryClient } = createQueryClientTestHarness();
+    const thread = makeThreadListEntry({ id: "thr_cached" });
+
+    queryClient.setQueryData(archivedThreadsListQueryKey({}), {
+      pageParams: [0],
+      pages: [[thread]],
+    });
+    queryClient.setQueryData(myProgressFacetQueryKey(), {
+      pageParams: [null],
+      pages: [{ items: [], nextCursor: null }],
+    });
+    queryClient.setQueryData(
+      threadFacetParticipantsQueryKey("thr_cached", "cursor_initial"),
+      {
+        pageParams: [],
+        pages: [],
+      },
+    );
+
+    const cached = getCachedThreadLists(queryClient, {
+      queryKey: threadsQueryKey(),
+    });
+
+    expect(cached).toHaveLength(1);
+    expect(Array.from(iterateThreadListCacheEntries(cached[0]!.data))).toEqual([
+      thread,
+    ]);
+  });
+});
diff --git a/apps/app/src/hooks/cache-owners/thread-list-cache-data.ts b/apps/app/src/hooks/cache-owners/thread-list-cache-data.ts
index 8bca01ffd326ff8ef0b46e713405e9390487abdb..12a6d9d4be08ce131d047f23abb553d5f415ec39 100644
--- a/apps/app/src/hooks/cache-owners/thread-list-cache-data.ts
+++ b/apps/app/src/hooks/cache-owners/thread-list-cache-data.ts
@@ -20,11 +20,14 @@ function isThreadListEntryArray(value: unknown): value is ThreadListEntry[] {
 function isInfiniteThreadListData(
   value: unknown,
 ): value is InfiniteData<ThreadListEntry[]> {
+  const pages =
+    typeof value === "object" && value !== null && "pages" in value
+      ? (value as { pages: unknown }).pages
+      : undefined;
   return (
-    typeof value === "object" &&
-    value !== null &&
-    "pages" in value &&
-    Array.isArray((value as { pages: unknown }).pages)
+    Array.isArray(pages) &&
+    pages.length > 0 &&
+    pages.every(isThreadListEntryArray)
   );
 }
 
