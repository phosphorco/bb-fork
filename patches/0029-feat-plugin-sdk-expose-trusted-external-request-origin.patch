new file mode 100644
index 0000000000000000000000000000000000000000..d89704f0b3a43193a63a1bf15f971b14127dc51c
--- /dev/null
+++ b/apps/server/src/external-origin.ts
@@ -0,0 +1,13 @@
+/**
+ * The configured public origin, or a normalized direct request-origin
+ * candidate when BB has no public URL configured. The fallback observes the
+ * inbound Host and is not an identity, authorization, or trusted-proxy signal.
+ */
+export function p6rResolveExternalOrigin(
+  requestUrl: string,
+  appUrl: string | undefined,
+): string {
+  if (appUrl?.trim()) return new URL(appUrl).origin;
+
+  return new URL(requestUrl).origin;
+}
