+/** A configured browser-facing app URL, or absent for local-only operation. */
+export function p6rValidateOptionalHttpAppUrl(
+  name: string,
+  value: string,
+): string | undefined {
+  const trimmedValue = value.trim();
+  if (trimmedValue.length === 0) return undefined;
+  let url: URL;
+  try {
+    url = new URL(trimmedValue);
+  } catch {
+    throw new Error(`${name} must be a valid URL, received "${value}"`);
+  }
+  if (url.protocol !== "http:" && url.protocol !== "https:") {
+    throw new Error(`${name} must use http or https, received "${value}"`);
+  }
+  return url.pathname === "/" && url.search.length === 0 && url.hash.length === 0
+    ? url.origin
+    : url.href;
+}
