diff --git a/apps/server/src/services/plugins/p6r-app-artifact-freshness.ts b/apps/server/src/services/plugins/p6r-app-artifact-freshness.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eb5737971b8e95343b4167a6ca004d750edaa43a
--- /dev/null
+++ b/apps/server/src/services/plugins/p6r-app-artifact-freshness.ts
@@ -0,0 +1,50 @@
+import { lstat, readdir, stat } from "node:fs/promises";
+import { join } from "node:path";
+import { isIgnoredPluginDevPath } from "@bb/plugin-build";
+import { loadPluginAppBundle, readPluginAppBundleMeta } from "./app-bundle.js";
+
+export async function isP6rMutableAppBundleStale(
+  rootDir: string,
+  legacy: () => Promise<boolean>,
+): Promise<boolean> {
+  if (process.env.BB_P6R_PLUGIN_ARTIFACT_FRESHNESS !== "1") return legacy();
+  const meta = await readPluginAppBundleMeta(rootDir);
+  if (meta?.artifactFormatVersion !== 2 || !meta.appArtifact) return legacy();
+  const snapshot = await loadPluginAppBundle(
+    meta.pluginId ?? "p6r-freshness",
+    rootDir,
+  );
+  if (!snapshot.assets) return true;
+  let artifactMtimeMs = Infinity;
+  try {
+    for (const file of meta.appArtifact.files) {
+      const info = await lstat(
+        join(
+          rootDir,
+          "dist",
+          ".bb-artifacts",
+          meta.appArtifact.generation,
+          file.path,
+        ),
+      );
+      if (!info.isFile() || info.isSymbolicLink()) return true;
+      artifactMtimeMs = Math.min(artifactMtimeMs, info.mtimeMs);
+    }
+    const directories = [""];
+    while (directories.length) {
+      const relative = directories.pop()!;
+      const directory = join(rootDir, relative);
+      if ((await stat(directory)).mtimeMs > artifactMtimeMs) return true;
+      for (const entry of await readdir(directory, { withFileTypes: true })) {
+        const path = join(relative, entry.name);
+        if (isIgnoredPluginDevPath(path)) continue;
+        if ((await stat(join(rootDir, path))).mtimeMs > artifactMtimeMs)
+          return true;
+        if (entry.isDirectory()) directories.push(path);
+      }
+    }
+    return false;
+  } catch {
+    return true;
+  }
+}
