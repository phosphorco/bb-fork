diff --git a/apps/server/test/services/plugins/p6r-app-artifact-freshness.p6r.test.ts b/apps/server/test/services/plugins/p6r-app-artifact-freshness.p6r.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c2d211459ecd9d7601a61a26ca1e7d18a5a434b0
--- /dev/null
+++ b/apps/server/test/services/plugins/p6r-app-artifact-freshness.p6r.test.ts
@@ -0,0 +1,134 @@
+import { createHash } from "node:crypto";
+import {
+  mkdtemp,
+  mkdir,
+  writeFile,
+  rm,
+  utimes,
+  readFile,
+} from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { PLUGIN_SDK_MAJOR, PLUGIN_SDK_VERSION } from "@bb/domain";
+import { isP6rMutableAppBundleStale } from "../../../src/services/plugins/p6r-app-artifact-freshness.js";
+import { loadPluginAppBundle } from "../../../src/services/plugins/app-bundle.js";
+
+const roots: string[] = [];
+const generation = "0123456789abcdef0123456789abcdef";
+const old = new Date(Date.now() - 100000);
+const built = new Date(Date.now() - 50000);
+afterEach(async () => {
+  vi.unstubAllEnvs();
+  for (const root of roots.splice(0))
+    await rm(root, { recursive: true, force: true });
+});
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "p6r-artifact-"));
+  roots.push(root);
+  const dist = join(root, "dist", ".bb-artifacts", generation);
+  await mkdir(dist, { recursive: true });
+  await mkdir(join(root, "src"));
+  await writeFile(join(root, "src", "app.ts"), "export default 1;");
+  await writeFile(
+    join(root, "package.json"),
+    JSON.stringify({ name: "bb-plugin-fixture", version: "1.0.0" }),
+  );
+  const files = [];
+  for (const path of ["app.js", "chunk.js"]) {
+    const content = "export default 1;";
+    await writeFile(join(dist, path), content);
+    await utimes(join(dist, path), built, built);
+    files.push({
+      path,
+      bytes: Buffer.byteLength(content),
+      sha256: createHash("sha256").update(content).digest("hex"),
+      contentType: "text/javascript; charset=utf-8",
+    });
+  }
+  await writeFile(
+    join(root, "dist", "app.meta.json"),
+    JSON.stringify({
+      sdkMajor: PLUGIN_SDK_MAJOR,
+      sdkVersion: PLUGIN_SDK_VERSION,
+      artifactFormatVersion: 2,
+      pluginId: "fixture",
+      pluginVersion: "1.0.0",
+      builtWith: { bbVersion: "0.46.1", pluginSdkVersion: PLUGIN_SDK_VERSION },
+      appArtifact: { generation, files },
+    }),
+  );
+  for (const path of ["src/app.ts", "src", "package.json", ""])
+    await utimes(join(root, path), old, old);
+  return { root, dist };
+}
+
+describe("additive v2 artifact freshness", () => {
+  it("reuses a complete generation with no legacy app.js and retains its URLs across reloads", async () => {
+    vi.stubEnv("BB_P6R_PLUGIN_ARTIFACT_FRESHNESS", "1");
+    const { root } = await fixture();
+    const legacy = vi.fn(async () => true);
+    const before = await loadPluginAppBundle("fixture", root);
+    for (let i = 0; i < 3; i++)
+      expect(await isP6rMutableAppBundleStale(root, legacy)).toBe(false);
+    const after = await loadPluginAppBundle("fixture", root);
+    expect(after.state.bundle?.jsUrl).toBe(before.state.bundle?.jsUrl);
+    expect(after.state.bundle?.hash).toBe(before.state.bundle?.hash);
+    expect(before.assets?.generation).toBe(generation);
+    expect(legacy).not.toHaveBeenCalled();
+  });
+
+  it("uses the unchanged legacy implementation when switched off or reading v1", async () => {
+    const { root } = await fixture();
+    const legacy = vi.fn(async () => true);
+    vi.stubEnv("BB_P6R_PLUGIN_ARTIFACT_FRESHNESS", "0");
+    expect(await isP6rMutableAppBundleStale(root, legacy)).toBe(true);
+    vi.stubEnv("BB_P6R_PLUGIN_ARTIFACT_FRESHNESS", "1");
+    await writeFile(
+      join(root, "dist", "app.meta.json"),
+      JSON.stringify({
+        sdkMajor: PLUGIN_SDK_MAJOR,
+        sdkVersion: PLUGIN_SDK_VERSION,
+      }),
+    );
+    expect(await isP6rMutableAppBundleStale(root, legacy)).toBe(true);
+    expect(legacy).toHaveBeenCalledTimes(2);
+  });
+
+  it("rebuilds when source is newer or a source file was deleted", async () => {
+    vi.stubEnv("BB_P6R_PLUGIN_ARTIFACT_FRESHNESS", "1");
+    const { root } = await fixture();
+    await utimes(join(root, "src", "app.ts"), new Date(), new Date());
+    expect(await isP6rMutableAppBundleStale(root, async () => false)).toBe(
+      true,
+    );
+    await utimes(join(root, "src", "app.ts"), old, old);
+    await rm(join(root, "src", "app.ts"));
+    expect(await isP6rMutableAppBundleStale(root, async () => false)).toBe(
+      true,
+    );
+  });
+
+  it("refuses missing, corrupt or changed-generation artifacts", async () => {
+    vi.stubEnv("BB_P6R_PLUGIN_ARTIFACT_FRESHNESS", "1");
+    const { root, dist } = await fixture();
+    const meta = await readFile(join(root, "dist", "app.meta.json"), "utf8");
+    await writeFile(
+      join(root, "dist", "app.meta.json"),
+      meta.replace(generation, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"),
+    );
+    expect(await isP6rMutableAppBundleStale(root, async () => false)).toBe(
+      true,
+    );
+    await writeFile(join(root, "dist", "app.meta.json"), meta);
+    await writeFile(join(dist, "chunk.js"), "export default 2;");
+    expect(await isP6rMutableAppBundleStale(root, async () => false)).toBe(
+      true,
+    );
+    await rm(join(dist, "chunk.js"));
+    expect(await isP6rMutableAppBundleStale(root, async () => false)).toBe(
+      true,
+    );
+  });
+});
