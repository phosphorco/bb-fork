+  it("reserves active external queue work atomically and promotes its frozen receipt on drain", async () => {
+    await withTestHarness(async (harness) => {
+      const { host } = seedHostSession(harness.deps, { id: "p6r-active-queue-host" });
+      const { project } = seedProjectWithSource(harness.deps, {
+        hostId: host.id,
+        path: "/tmp/p6r-active-queue",
+      });
+      const environment = seedEnvironment(harness.deps, {
+        hostId: host.id,
+        path: "/tmp/p6r-active-queue",
+        projectId: project.id,
+        status: "ready",
+      });
+      const thread = seedThread(harness.deps, {
+        environmentId: environment.id,
+        projectId: project.id,
+        status: "active",
+      });
+      seedThreadRuntimeState(harness.deps, {
+        environmentId: environment.id,
+        providerThreadId: "active-queue-provider-thread",
+        threadId: thread.id,
+      });
+      setThreadExecutionOverride(harness.db, {
+        modelOverride: "gpt-5",
+        threadId: thread.id,
+      });
+      const operation = {
+        ...acceptance(),
+        input: {
+          ...acceptance().input,
+          mode: "queue-if-active" as const,
+          operationId: "active-queue-operation",
+          threadId: thread.id,
+        },
+        operationNamespace: "active-queue:plugin-1",
+        payloadHash: "active-queue-hash",
+      };
+      const accept = createP6rNativeAcceptance({
+        deps: harness.deps,
+        now: () => 100,
+        retentionMs: 1_000,
+      });
+
+      await expect(accept(operation)).resolves.toMatchObject({
+        operationId: "active-queue-operation",
+        status: "indeterminate",
+      });
+      const [queued] = listQueuedThreadMessages(harness.db, thread.id);
+      if (!queued) throw new Error("Expected active P6r queue reservation");
+      expect(p6rQueuedOperationReservation(harness.db, queued.id)).toMatchObject({
+        acceptedAuthorship: operation.authorEvidence,
+        input: operation.input.input,
+        receipt: { operationId: "active-queue-operation", status: "pending" },
+      });
+      await expect(accept(operation)).resolves.toMatchObject({
+        operationId: "active-queue-operation",
+        status: "indeterminate",
+      });
+      expect(listQueuedThreadMessages(harness.db, thread.id)).toHaveLength(1);
+
+      applyLoggedThreadLifecycleEvent(harness.deps, {
+        event: { type: "run.succeeded" },
+        threadId: thread.id,
+      });
+      clearQueuedMessageWait(harness.deps, {
+        queuedMessageId: queued.id,
+        threadId: thread.id,
+      });
+      const requestsBeforeDrain = listEvents(harness.db, { threadId: thread.id }).filter(
+        (event) => event.type === "client/turn/requested",
+      ).length;
+      await expect(sendNextQueuedMessageIfPresent(harness.deps, {
+        threadId: thread.id,
+      })).resolves.toBe(true);
+      expect(lookupP6rOperationReceipt(
+        harness.db,
+        "active-queue:plugin-1",
+        "active-queue-operation",
+      )).toMatchObject({ status: "accepted" });
+      expect(listQueuedThreadMessages(harness.db, thread.id)).toEqual([]);
+      expect(
+        listEvents(harness.db, { threadId: thread.id }).filter(
+          (event) => event.type === "client/turn/requested",
+        ),
+      ).toHaveLength(requestsBeforeDrain + 1);
+      await expect(accept(operation)).resolves.toMatchObject({
+        receipt: { operationId: "active-queue-operation" },
+        status: "submitted",
+      });
+      expect(
+        listEvents(harness.db, { threadId: thread.id }).filter(
+          (event) => event.type === "client/turn/requested",
+        ),
+      ).toHaveLength(requestsBeforeDrain + 1);
+    });
+  });
+
+  it("commits one receipt when a stale active snapshot queues and then drains", async () => {
