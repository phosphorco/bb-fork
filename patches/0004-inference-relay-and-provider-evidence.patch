+it("captures immutable managed values and provenance together across replacement and removal", () => {
+  const target = { BB_SERVER_URL: "https://server.example", AUTH: "original" };
+  const environment = new MachineEnvironment(target, {
+    AUTH: "original-shell",
+  });
+  const source: { core: "machine-environment" | "project-environment" } = {
+    core: "machine-environment",
+  };
+  const entries = [
+    {
+      name: "AUTH",
+      value: { serverPath: "/credential" },
+      secret: true,
+      source,
+      reason: "Managed authentication",
+    },
+  ];
+  environment.replace(entries);
+  const captured = environment.shellEnvironmentSnapshot({ PATH: "/tools" });
+  entries[0]!.value.serverPath = "/mutated";
+  entries[0]!.secret = false;
+  source.core = "project-environment";
+  expect(captured.shellEnv).toEqual({
+    PATH: "/tools",
+    AUTH: "https://server.example/credential",
+  });
+  expect(captured.shellEnvContributions).toEqual([
+    {
+      name: "AUTH",
+      value: "https://server.example/credential",
+      secret: true,
+      source: { core: "machine-environment" },
+      reason: "Managed authentication",
+    },
+  ]);
+  expect(Object.isFrozen(captured)).toBe(true);
+  expect(Object.isFrozen(captured.shellEnv)).toBe(true);
+  expect(Object.isFrozen(captured.shellEnvContributions)).toBe(true);
+  expect(Object.isFrozen(captured.shellEnvContributions[0]?.source)).toBe(true);
+  environment.replace([
+    {
+      name: "AUTH",
+      value: "ordinary-replacement",
+      secret: false,
+      source: { core: "machine-environment" },
+      reason: "Replacement",
+    },
+  ]);
+  expect(
+    environment.shellEnvironmentSnapshot({}).shellEnvContributions[0],
+  ).toMatchObject({ value: "ordinary-replacement", secret: false });
+  expect(captured.shellEnvContributions[0]).toMatchObject({
+    value: "https://server.example/credential",
+    secret: true,
+  });
+  environment.replace([]);
+  expect(environment.shellEnvironmentSnapshot({})).toEqual({
+    shellEnv: { AUTH: "original-shell" },
+    shellEnvContributions: [],
+  });
+  expect(captured.shellEnv.AUTH).toBe("https://server.example/credential");
+});
