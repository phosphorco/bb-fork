diff --git a/packages/agent-runtime/src/thread-shell-environment.test.ts b/packages/agent-runtime/src/thread-shell-environment.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fdc27953bc5756b861eb76a7ef1fd09f2fe8c961
--- /dev/null
+++ b/packages/agent-runtime/src/thread-shell-environment.test.ts
@@ -0,0 +1,238 @@
+import { describe, expect, it } from "vitest";
+import { resolveThreadEnvironment } from "./thread-shell-environment.js";
+
+const scope = { environmentId: "environment", threadId: "thread" };
+
+describe("explicit environment credential classification", () => {
+  it("preserves a newly synced base credential absent from an older command and permits exact command overrides", () => {
+    const baseShellEnv = {
+      TOKEN: "new-managed-secret",
+      BB_THREAD_ID: "managed-thread-id",
+      PATH: "/tools",
+    };
+    const baseContributedEnv = [
+      {
+        name: "TOKEN",
+        value: "new-managed-secret",
+        secret: true,
+        source: { core: "machine-environment" as const },
+        reason: "New global credential",
+      },
+      {
+        name: "BB_THREAD_ID",
+        value: "managed-thread-id",
+        secret: true,
+        source: { core: "machine-environment" as const },
+        reason: "Global row",
+      },
+    ];
+    const oldCommand = resolveThreadEnvironment({
+      ...scope,
+      baseShellEnv,
+      baseContributedEnv,
+      contributedEnv: [],
+    });
+    expect(oldCommand.envVars).toEqual({
+      TOKEN: "new-managed-secret",
+      BB_THREAD_ID: "thread",
+      BB_ENVIRONMENT_ID: "environment",
+      PATH: "/tools",
+    });
+    expect(
+      oldCommand.entries.find((entry) => entry.name === "TOKEN"),
+    ).toMatchObject({
+      source: { core: "machine-environment" },
+      value: { masked: true },
+    });
+    expect(
+      oldCommand.entries.find((entry) => entry.name === "BB_THREAD_ID"),
+    ).toEqual({ name: "BB_THREAD_ID", source: "shell", value: "thread" });
+    const overridden = resolveThreadEnvironment({
+      ...scope,
+      baseShellEnv,
+      baseContributedEnv,
+      contributedEnv: [
+        {
+          name: "TOKEN",
+          value: "ordinary-replacement",
+          secret: false,
+          source: { core: "project-environment" },
+          reason: "Explicit command winner",
+        },
+      ],
+    });
+    expect(overridden.envVars.TOKEN).toBe("ordinary-replacement");
+    expect(
+      overridden.entries.filter((entry) => entry.name === "TOKEN"),
+    ).toEqual([
+      {
+        name: "TOKEN",
+        value: "ordinary-replacement",
+        source: { core: "project-environment" },
+        reason: "Explicit command winner",
+      },
+    ]);
+  });
+
+  it("refuses a managed classification borrowed from a different captured value", () => {
+    expect(() =>
+      resolveThreadEnvironment({
+        ...scope,
+        baseShellEnv: { TOKEN: "actual" },
+        baseContributedEnv: [
+          {
+            name: "TOKEN",
+            value: "different",
+            secret: true,
+            source: { core: "machine-environment" },
+            reason: "Mismatched snapshot",
+          },
+        ],
+        contributedEnv: [],
+      }),
+    ).toThrow(/does not match its captured value/);
+  });
+  it("preserves provider bytes while showing ordinary core and plugin diagnostics", () => {
+    const baseShellEnv = { PATH: "/tools", BB_SERVER_URL: "https://bb.test" };
+    const result = resolveThreadEnvironment({
+      ...scope,
+      baseContributedEnv: [],
+      baseShellEnv,
+      contributedEnv: [
+        {
+          name: "TOKEN",
+          value: "synthetic-authentication-secret",
+          secret: true,
+          source: { plugin: "custom" },
+          reason: "Credential producer",
+        },
+        {
+          name: "URL",
+          value: "https://home.test:8443/path",
+          secret: false,
+          source: { core: "machine-environment" },
+          reason: "Ordinary endpoint",
+        },
+        {
+          name: "FLAG",
+          value: "1",
+          secret: false,
+          source: { plugin: "custom" },
+          reason: "Ordinary flag",
+        },
+      ],
+    });
+    expect(result.envVars).toEqual({
+      ...baseShellEnv,
+      BB_THREAD_ID: "thread",
+      BB_ENVIRONMENT_ID: "environment",
+      TOKEN: "synthetic-authentication-secret",
+      URL: "https://home.test:8443/path",
+      FLAG: "1",
+    });
+    expect(result.entries.find((entry) => entry.name === "TOKEN")).toEqual({
+      name: "TOKEN",
+      value: { masked: true },
+      source: { plugin: "custom" },
+      reason: "Credential producer",
+    });
+    expect(result.entries.find((entry) => entry.name === "URL")?.value).toBe(
+      "https://home.test:8443/path",
+    );
+    expect(result.entries.find((entry) => entry.name === "FLAG")?.value).toBe(
+      "1",
+    );
+    expect(baseShellEnv).toEqual({
+      PATH: "/tools",
+      BB_SERVER_URL: "https://bb.test",
+    });
+  });
+
+  it.each([true, false])(
+    "keeps the final winning value and classification together: secret=%s",
+    (secret) => {
+      const result = resolveThreadEnvironment({
+        ...scope,
+        baseContributedEnv: [],
+        baseShellEnv: { SHARED: "shell" },
+        contributedEnv: [
+          {
+            name: "SHARED",
+            value: "superseded",
+            secret: !secret,
+            source: { core: "machine-environment" },
+            reason: "Superseded",
+          },
+          {
+            name: "SHARED",
+            value: "winner",
+            secret,
+            source: { plugin: "winner" },
+            reason: "Selected owner",
+          },
+        ],
+      });
+      expect(result.envVars.SHARED).toBe("winner");
+      expect(result.entries.filter((entry) => entry.name === "SHARED")).toEqual(
+        [
+          {
+            name: "SHARED",
+            value: secret ? { masked: true } : "winner",
+            source: { plugin: "winner" },
+            reason: "Selected owner",
+          },
+        ],
+      );
+    },
+  );
+
+  it("does not guess credentials from variable names or blanket-mask a source", () => {
+    const result = resolveThreadEnvironment({
+      ...scope,
+      baseContributedEnv: [],
+      baseShellEnv: {},
+      contributedEnv: [
+        {
+          name: "API_KEY",
+          value: "ordinary-fixture-name",
+          secret: false,
+          source: { core: "project-environment" },
+          reason: "Declared ordinary",
+        },
+        {
+          name: "INNOCENT_NAME",
+          value: "synthetic-secret",
+          secret: true,
+          source: { plugin: "custom" },
+          reason: "Declared credential",
+        },
+      ],
+    });
+    expect(
+      result.entries.find((entry) => entry.name === "API_KEY")?.value,
+    ).toBe("ordinary-fixture-name");
+    expect(
+      result.entries.find((entry) => entry.name === "INNOCENT_NAME")?.value,
+    ).toEqual({ masked: true });
+  });
+
+  it("refuses unclassified embedded-runtime contributions without changing the base environment", () => {
+    const baseShellEnv = { PATH: "/tools" };
+    expect(() =>
+      resolveThreadEnvironment({
+        ...scope,
+        baseContributedEnv: [],
+        baseShellEnv,
+        contributedEnv: [
+          {
+            name: "UNCLASSIFIED",
+            value: "synthetic-value",
+            source: { plugin: "custom" },
+            reason: "Missing classification",
+          } as never,
+        ],
+      }),
+    ).toThrow(/UNCLASSIFIED.*explicit secret classification/);
+    expect(baseShellEnv).toEqual({ PATH: "/tools" });
+  });
+});
