+    environmentId: f.environment.id,
+    status: "active",
+  });
+  seedThreadRuntimeState(f.harness.deps, {
+    environmentId: f.environment.id,
+    providerThreadId: "provider-" + thread.id,
+    threadId: thread.id,
+  });
+  seedTurnStarted(f.harness.deps, {
+    environmentId: f.environment.id,
+    providerThreadId: "provider-" + thread.id,
+    threadId: thread.id,
+    turnId: "turn-" + thread.id,
+  });
+  return thread;
+}
