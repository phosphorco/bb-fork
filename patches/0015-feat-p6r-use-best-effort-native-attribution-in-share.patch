new file mode 100644
index 0000000000000000000000000000000000000000..934e9842657c96d692958b05643f5f7b8e3eeb57
--- /dev/null
+++ b/apps/app/src/components/settings/P6rIdentitySettingsSection.test.tsx
@@ -0,0 +1,157 @@
+// @vitest-environment jsdom
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, expect, it, vi } from "vitest";
+import { P6rIdentitySettingsSection } from "./P6rIdentitySettingsSection";
+import { P6rMessageAuthorLabel } from "../thread/timeline/P6rMessageAuthorLabel";
+import type { P6rIdentityResponse } from "@bb/server-contract";
+
+const mocks = vi.hoisted(() => ({
+  identity: vi.fn<() => Promise<P6rIdentityResponse>>(),
+}));
+vi.mock("@/lib/sdk", () => ({
+  sdk: { system: { p6rIdentity: mocks.identity } },
+}));
+vi.mock("@/hooks/queries/system-queries", () => ({
+  useSystemConfig: () => ({ data: { appearance: { themeId: "system" } } }),
+}));
+afterEach(() => {
+  cleanup();
+  mocks.identity.mockReset();
+});
+const actor = {
+  evidence: "provider-verified" as const,
+  identity: {
+    kind: "person" as const,
+    key: "opaque-person",
+    issuer: "test:people",
+    subject: "person-1",
+  },
+  presentation: {
+    displayName: "Test Person",
+    handle: "test-person",
+    avatarUrl: null,
+  },
+};
+const machineActor = {
+  evidence: "machine" as const,
+  identity: {
+    kind: "machine" as const,
+    key: "machine:rosetta",
+    instanceId: "instance-1",
+    hostId: "host-1",
+  },
+  presentation: {
+    displayName: "machine:rosetta",
+    handle: null,
+    avatarUrl: null,
+  },
+};
+
+function mount() {
+  return render(
+    <QueryClientProvider
+      client={
+        new QueryClient({ defaultOptions: { queries: { retry: false } } })
+      }
+    >
+      <MemoryRouter>
+        <P6rIdentitySettingsSection />
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+it("shows the resolved person and shared appearance without editable identity or personal override controls", async () => {
+  mocks.identity.mockResolvedValue({
+    status: "ready",
+    actor,
+    providerId: "people",
+  });
+  mount();
+  expect(await screen.findByText("@test-person")).toBeTruthy();
+  expect(screen.getByText("Verified by people")).toBeTruthy();
+  expect(screen.getByText("test:people")).toBeTruthy();
+  expect(
+    screen.getByRole("link", { name: /Appearance/ }).getAttribute("href"),
+  ).toBe("/settings/appearance");
+  expect(screen.queryAllByRole("textbox")).toHaveLength(0);
+  expect(
+    screen.getByText(/Personal theme overrides are not available/),
+  ).toBeTruthy();
+});
+it("shows machine attribution without presenting it as a verified person", async () => {
+  mocks.identity.mockResolvedValue({
+    status: "ready",
+    actor: machineActor,
+    providerId: "unused-for-machine",
+  });
+  mount();
+  expect(await screen.findByText("machine:rosetta")).toBeTruthy();
+  expect(screen.getByText("Machine attribution")).toBeTruthy();
+  expect(screen.queryByText(/Verified by/)).toBeNull();
+  fireEvent.click(screen.getByText("Machine details"));
+  expect(screen.getByText("instance-1")).toBeTruthy();
+  expect(screen.getByText("host-1")).toBeTruthy();
+});
+it("removes the previously verified identity while rechecking and after provider failure", async () => {
+  mocks.identity.mockResolvedValueOnce({
+    status: "ready",
+    actor,
+    providerId: "people",
+  });
+  mount();
+  await screen.findByText("@test-person");
+  let resolve: (value: P6rIdentityResponse) => void = () => {};
+  mocks.identity.mockImplementationOnce(
+    () =>
+      new Promise((done) => {
+        resolve = done;
+      }),
+  );
+  fireEvent.click(screen.getByRole("button", { name: "Check again" }));
+  await screen.findByText("Checking identity…");
+  expect(screen.queryByText("@test-person")).toBeNull();
+  resolve({ status: "unavailable", message: "Provider is unavailable" });
+  await screen.findByText("Provider is unavailable");
+  expect(screen.queryByText("@test-person")).toBeNull();
+});
+it("shows baseline status without claiming a person and renders only supplied historical authors", async () => {
+  mocks.identity.mockResolvedValue({ status: "unconfigured" });
+  mount();
+  await waitFor(() =>
+    expect(screen.getByText(/No identity provider is configured/)).toBeTruthy(),
+  );
+  expect(screen.queryByText("@test-person")).toBeNull();
+  render(<P6rMessageAuthorLabel author={actor} />);
+  expect(screen.getByText("@test-person")).toBeTruthy();
+});
+
+it("labels an editor without presenting that person as the unknown author", () => {
+  render(<P6rMessageAuthorLabel editor={actor} />);
+  expect(screen.getByText("Edited by @test-person")).toBeTruthy();
+  expect(screen.queryByText("@test-person", { exact: true })).toBeNull();
+});
+
+it("keeps the original sender and latest editor visibly distinct", () => {
+  const editor = {
+    ...actor,
+    presentation: { ...actor.presentation, handle: "editor-person" },
+  };
+  render(<P6rMessageAuthorLabel author={actor} editor={editor} />);
+  expect(screen.getByText("@test-person", { exact: true })).toBeTruthy();
+  expect(screen.getByText("Edited by @editor-person")).toBeTruthy();
+});
+
+it("labels a machine sender without verification wording", () => {
+  render(<P6rMessageAuthorLabel author={machineActor} />);
+  expect(screen.getByText("machine:rosetta")).toBeTruthy();
+  expect(screen.getByTitle("Machine sender: machine:rosetta")).toBeTruthy();
+  expect(screen.queryByTitle(/Verified/)).toBeNull();
+});
