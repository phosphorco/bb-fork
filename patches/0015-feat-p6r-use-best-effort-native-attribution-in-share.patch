+  });
+  await runQueuedMessageDispatch(f.harness.deps, {
+    kind: "thread-ready",
+    threadId,
+  });
+  await runQueuedMessageDispatch(f.harness.deps, {
+    kind: "idle-recovery",
+    now: Date.now(),
+  });
+}
