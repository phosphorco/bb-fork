+    },
+    unconfigure: () => {
+      configured = false;
+    },
+    configure: () => {
+      configured = true;
+    },
+    untrust: () => {
+      trusted = false;
+    },
+    retireAfterAdmission: () => {
+      retireAfterAdmission = true;
+    },
+  };
+}
