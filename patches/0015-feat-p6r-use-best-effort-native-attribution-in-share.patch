diff --git a/packages/domain/test/p6r-message-author.test.ts b/packages/domain/test/p6r-message-author.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..64d40f1d97d69153cb0b530c8339516e36d43d43
--- /dev/null
+++ b/packages/domain/test/p6r-message-author.test.ts
@@ -0,0 +1,32 @@
+import { describe, expect, it } from "vitest";
+import { p6rMessageAuthorSchema, p6rStoredMessageAttributionSchema } from "../src/p6r-message-author.js";
+
+const machine = {
+  evidence: "machine",
+  identity: { kind: "machine", key: "p6r-machine:v1:instance:server", instanceId: "instance", hostId: null },
+  presentation: { displayName: "bb-machine", handle: null, avatarUrl: null },
+};
+const person = {
+  evidence: "provider-verified",
+  identity: { kind: "person", key: "person:cole", issuer: "tailnet", subject: "cole" },
+  presentation: { displayName: "Cole", handle: "cole@example.test", avatarUrl: null },
+};
+
+describe("durable machine attribution", () => {
+  it("round trips mixed authors and editors without changing historical unknowns", () => {
+    const stored = { authors: [person, machine, null], editors: [machine, null, person] };
+    expect(p6rStoredMessageAttributionSchema.parse(JSON.parse(JSON.stringify(stored)))).toEqual(stored);
+    expect(p6rStoredMessageAttributionSchema.parse([person, null])).toEqual([person, null]);
+  });
+
+  it("does not permit machine fallback to claim provider verification", () => {
+    expect(p6rMessageAuthorSchema.safeParse({ ...machine, evidence: "provider-verified" }).success).toBe(false);
+    expect(p6rMessageAuthorSchema.safeParse({ ...person, evidence: "machine" }).success).toBe(false);
+    expect(p6rMessageAuthorSchema.safeParse({ ...machine, identity: { ...machine.identity, instanceId: "" } }).success).toBe(false);
+  });
+
+  it("keeps identity stable when machine presentation changes", () => {
+    const renamed = p6rMessageAuthorSchema.parse({ ...machine, presentation: { ...machine.presentation, displayName: "renamed" } });
+    expect(renamed.identity).toEqual(machine.identity);
+  });
+});
