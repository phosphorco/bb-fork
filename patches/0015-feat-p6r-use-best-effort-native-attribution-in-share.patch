@@ -0,0 +1,54 @@
+import { Avatar, AvatarImage, AvatarFallback } from "@bb/shared-ui/avatar";
+import type { P6rMessageAuthor } from "@bb/domain";
+
+function actorLabel(actor: P6rMessageAuthor): string {
+  if (actor.identity.kind === "person" && actor.presentation.handle) {
+    return `@${actor.presentation.handle}`;
+  }
+  return actor.presentation.displayName;
+}
+
+function actorTitle(
+  actor: P6rMessageAuthor,
+  role: "sender" | "latest editor",
+): string {
+  const label = actor.presentation.displayName;
+  if (actor.identity.kind === "machine") {
+    return `Machine ${role}: ${label}`;
+  }
+  return `Verified ${role}: ${label}`;
+}
+
+export function P6rMessageAuthorLabel({
+  author,
+  editor,
+}: {
+  author?: P6rMessageAuthor;
+  editor?: P6rMessageAuthor;
+}) {
+  const principal = author ?? editor;
+  if (!principal) return null;
+  return (
+    <div
+      className="mb-1 flex min-w-0 items-center justify-end gap-2 text-sm text-muted-foreground"
+      title={actorTitle(principal, author ? "sender" : "latest editor")}
+    >
+      <Avatar className="size-5" aria-hidden="true">
+        <AvatarImage
+          src={principal.presentation.avatarUrl ?? undefined}
+          alt=""
+          referrerPolicy="no-referrer"
+        />
+        <AvatarFallback>
+          {principal.presentation.displayName.slice(0, 1)}
+        </AvatarFallback>
+      </Avatar>
+      <span className="truncate">
+        {author ? actorLabel(principal) : `Edited by ${actorLabel(principal)}`}
+      </span>
+      {author && editor && (
+        <span className="truncate">Edited by {actorLabel(editor)}</span>
+      )}
+    </div>
