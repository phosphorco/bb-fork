index 0000000000000000000000000000000000000000..277476c5b399e60d47bf68f5ab41408822168e1a
--- /dev/null
+++ b/apps/server/src/services/p6r/native-authorship.ts
@@ -0,0 +1,94 @@
+import {
+  listStoredClientTurnRequestRowsByKeys,
+  type DbQueryConnection,
+} from "@bb/db";
+import {
+  clientTurnRequestIdSchema,
+  isStandaloneBuiltinCompactCommand,
+  isStandaloneBuiltinClearCommand,
+  turnRequestEventDataSchema,
+  type P6rMessageAuthor,
+  type PromptInput,
+} from "@bb/domain";
+import type { P6rNativeAuthorship } from "./native-request.js";
+
+export type P6rMessageAuthors = (P6rMessageAuthor | null)[];
+export type P6rMessageEditors = (P6rMessageAuthor | null)[];
+
+export function captureP6rNativeAuthors(
+  authorship: P6rNativeAuthorship | undefined,
+  groups: number,
+): P6rMessageAuthors | undefined {
+  return authorship === undefined
+    ? undefined
+    : Array.from({ length: groups }, () => authorship.author);
+}
+
+export function readP6rNativeAttribution(
+  db: DbQueryConnection,
+  threadId: string,
+  requestId: string,
+):
+  | {
+      authors: P6rMessageAuthors | undefined;
+      editors: P6rMessageEditors | undefined;
+    }
+  | undefined {
+  const row = listStoredClientTurnRequestRowsByKeys(db, {
+    keys: [{ threadId, requestId: clientTurnRequestIdSchema.parse(requestId) }],
+  })[0];
+  if (row === undefined) return undefined;
+  const request = turnRequestEventDataSchema.parse(JSON.parse(row.data));
+  return { authors: request.p6rAuthors, editors: request.p6rEditors };
+}
+
+function senderLabel(sender: P6rMessageAuthor): string {
+  const label =
+    sender.identity.kind === "machine"
+      ? sender.presentation.displayName.startsWith("machine:")
+        ? sender.presentation.displayName
+        : `machine:${sender.presentation.displayName}`
+      : (sender.presentation.handle ?? sender.presentation.displayName);
+  return label.replace(/[\[\]<>\r\n%]/g, (character) =>
+    encodeURIComponent(character),
+  );
+}
+
+export function withP6rNativeAuthorContext(
+  input: PromptInput[],
+  authors: P6rMessageAuthors | undefined,
+  editors?: P6rMessageEditors,
+  groups?: PromptInput[][],
+): { input: PromptInput[]; inputGroups?: PromptInput[][] } {
+  if (
+    input.length === 0 ||
+    (!authors?.some(Boolean) && !editors?.some(Boolean)) ||
+    isStandaloneBuiltinCompactCommand(input) ||
+    isStandaloneBuiltinClearCommand(input)
+  )
+    return { input, ...(groups === undefined ? {} : { inputGroups: groups }) };
+  const enriched = (groups ?? [input]).map((group, index) => {
+    const sender = authors?.[index] ?? editors?.[index];
+    if (!sender) return group;
+    const from = senderLabel(sender);
+    const marker = (text: string): PromptInput => ({
+      type: "text",
+      visibility: "agent-only",
+      mentions: [],
+      text,
+    });
+    return [
+      marker(`[sender=${from}]\n`),
+      ...group,
+      marker(`\n[/sender=${from}]`),
+    ];
+  });
+  return {
+    input: enriched.flatMap((group, index) =>
+      index === 0
+        ? group
+        : [{ type: "text" as const, text: "\n\n", mentions: [] }, ...group],
+    ),
+    ...(groups === undefined ? {} : { inputGroups: enriched }),
+  };
+}
diff --git a/apps/server/src/services/p6r/native-request.ts b/apps/server/src/services/p6r/native-request.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e49ad91253e3677f15be9e6c442c1db1021c4447
--- /dev/null
+++ b/apps/server/src/services/p6r/native-request.ts
@@ -0,0 +1,91 @@
+import { type P6rMessageAuthor } from "@bb/domain";
+import type { Context, Hono, Next } from "hono";
+import { ApiError } from "../../errors.js";
+import type { P6rProviderAdmission } from "./provider-admission.js";
+import {
+  publicApiRoutes,
+  typedRoutes,
+  type PublicApiSchema,
+  type P6rIdentityResponse,
+} from "@bb/server-contract";
+
+export interface P6rNativeAuthorship {
+  readonly author: P6rMessageAuthor;
+}
+
+const PRODUCER_MESSAGE_RENDERING_HEADER = "x-bb-p6r-message-rendering";
+const PRODUCER_MESSAGE_RENDERING_VALUE = "producer";
+
+interface NativeContextState {
+  readonly resolve: () => Promise<P6rMessageAuthor>;
+  readonly producerMessageRendering: boolean;
+  authorship?: P6rNativeAuthorship;
+  resolving?: Promise<P6rNativeAuthorship>;
+}
+
+const nativeContexts = new WeakMap<object, NativeContextState>();
+
+export async function getP6rNativeAuthorship(
+  context: object,
+): Promise<P6rNativeAuthorship | undefined> {
+  const state = nativeContexts.get(context);
+  if (state === undefined || state.producerMessageRendering) return undefined;
+  if (state.authorship !== undefined) return state.authorship;
+  if (state.resolving !== undefined) return state.resolving;
+  state.resolving = state.resolve().then((author) => {
+    const authorship = { author };
+    state.authorship = authorship;
+    return authorship;
+  });
+  return state.resolving;
+}
+
+function isProducerMessageRequest(context: Context): boolean {
+  if (context.req.method !== "POST") return false;
+  if (
+    context.req.header(PRODUCER_MESSAGE_RENDERING_HEADER) !==
+    PRODUCER_MESSAGE_RENDERING_VALUE
+  ) {
+    return false;
+  }
+  const pathname = context.req.path.replace(/\/+$/u, "");
+  return /\/threads\/[^/]+\/(?:send|queued-messages)$/u.test(pathname);
+}
+
+function installNativeContextResolver(admission: P6rProviderAdmission) {
+  return async (context: Context, next: Next): Promise<void> => {
+    nativeContexts.set(context, {
+      producerMessageRendering: isProducerMessageRequest(context),
+      resolve: () => admission.resolveNativeAuthor(context),
+    });
+    try {
+      await next();
+    } finally {
+      nativeContexts.delete(context);
+    }
+  };
+}
+
+export function installP6rNativeRequestRoutes(
+  app: Hono,
+  admission: P6rProviderAdmission,
+  providerId: string | null,
+): void {
+  const attach = installNativeContextResolver(admission);
+  app.use("/threads", attach);
+  app.use("/threads/*", attach);
+
+  const { get } = typedRoutes<PublicApiSchema>(app, {
+    onValidationError: (message) =>
+      new ApiError(400, "invalid_request", message),
+  });
+  get(publicApiRoutes.system.p6rIdentity, async (context) => {
+    context.header("Cache-Control", "no-store");
+    const result: P6rIdentityResponse = {
+      status: "ready",
+      actor: await admission.resolveNativeAuthor(context),
+      providerId: providerId ?? "",
+    };
+    return context.json(result);
+  });
+}
