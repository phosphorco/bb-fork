+  expect(registry.publish(prepared.value).ok).toBe(true);
+  const requestFacts = new WeakMap<object, P6rAdmissionRequestFacts>();
+  const admission = createP6rProviderAdmission({
+    now: Date.now,
+    instanceId: "native-proof",
