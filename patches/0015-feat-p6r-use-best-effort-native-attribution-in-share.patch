@@ -0,0 +1,36 @@
+import { hostname } from "node:os";
+import { expect } from "vitest";
+
+export function p6rMachineWrappedInput(input: readonly unknown[]): unknown[] {
+  return [
+    {
+      type: "text",
+      visibility: "agent-only",
+      mentions: [],
+      text: `[sender=machine:${hostname()}]\n`,
+    },
+    ...input,
+    {
+      type: "text",
+      visibility: "agent-only",
+      mentions: [],
+      text: `\n[/sender=machine:${hostname()}]`,
+    },
+  ];
+}
+
+export function expectP6rMachineAuthor(author: unknown): void {
+  expect(author).toMatchObject({
+    evidence: "machine",
+    identity: {
+      kind: "machine",
+      key: expect.stringMatching(/^p6r-machine:v1:/),
+      instanceId: expect.any(String),
+    },
+    presentation: {
+      displayName: hostname(),
+      handle: null,
+      avatarUrl: null,
+    },
+  });
+}
