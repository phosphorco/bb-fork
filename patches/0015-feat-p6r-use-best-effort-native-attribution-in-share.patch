+  const harness = await createTestAppHarness();
+  let person = "alice";
+  let configured = true;
+  let trusted = true;
+  let retireAfterAdmission = false;
+  const registry = createP6rProviderRegistry({ now: Date.now });
+  const configuration = {
+    version: 1 as const,
+    boundaryId: "native-proof",
+    pluginId: "people",
+    ingressIds: ["browser"],
+    credentials: [],
+    resolver: { timeoutMs: 100 },
