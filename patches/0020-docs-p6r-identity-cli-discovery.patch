From bc1f68d794284f381cf8e9a1b9b7bf4c7fbedcf5 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Tue, 8 Sep 2026 21:55:54 -0400
Subject: [PATCH] docs(p6r): expose the identity check in CLI skill discovery

---
 .../skills/builtin-skills/bb-cli/references/command-index.md  | 1 +
 .../skills/builtin-skills/bb-cli/references/configuration.md  | 4 ++++
 2 files changed, 5 insertions(+)

diff --git a/apps/server/src/services/skills/builtin-skills/bb-cli/references/command-index.md b/apps/server/src/services/skills/builtin-skills/bb-cli/references/command-index.md
index daba14e398ebdaa987e67995d014075c1b968254..4edc219c0608bf8c3249ecccca5c7bd9f2aa3535 100644
--- a/apps/server/src/services/skills/builtin-skills/bb-cli/references/command-index.md
+++ b/apps/server/src/services/skills/builtin-skills/bb-cli/references/command-index.md
@@ -20,6 +20,7 @@ This index lists every command path that the core CLI registers. Read the task-s
 - `bb settings keyboard reset`
 - `bb settings usage`
 - `bb settings version`
+- `bb settings p6r-identity`
 - `bb settings reload`
 
 ## project
diff --git a/apps/server/src/services/skills/builtin-skills/bb-cli/references/configuration.md b/apps/server/src/services/skills/builtin-skills/bb-cli/references/configuration.md
index 407fdf4b636ae30eb52497750eb807496cbd09e3..9551c8dca71f1c535d38dfe81c158b03bee85d3f 100644
--- a/apps/server/src/services/skills/builtin-skills/bb-cli/references/configuration.md
+++ b/apps/server/src/services/skills/builtin-skills/bb-cli/references/configuration.md
@@ -20,6 +20,10 @@
 - Use `bb settings keyboard list`, `set`, and `reset` for shortcut overrides.
 - Use `bb settings usage [--machine <id-or-name>]` for provider limits.
   `--host` is an alias for `--machine`.
+- Use `bb settings p6r-identity --json` to inspect the provider-resolved identity
+  of this CLI request. A CLI connection may represent a different identity from
+  your browser; Settings → Identity checks the browser connection. This is
+  read-only and does not select or claim a person.
 - Use `bb settings version [--force]` for release information.
 - Use `bb settings reload` to reload BB-managed configuration.
 - These commands support `--json`.
-- 
