+  it("preserves phase and causal identity through thread event list and wait", async () => {
+    const providerThreadId = "provider-phase-1";
+    const scope = { kind: "turn", turnId: "turn-phase-1" };
+    const rows: JsonValue[] = [
+      {
+        id: "evt-legacy",
+        seq: 1,
+        threadId: "thr_test",
+        createdAt: 1,
+        scope,
+        type: "item/completed",
+        data: {
+          providerThreadId,
+          item: { id: "msg-legacy", text: "legacy", type: "agentMessage" },
+        },
+      },
+      {
+        id: "evt-null",
+        seq: 2,
+        threadId: "thr_test",
+        createdAt: 2,
+        scope,
+        type: "item/completed",
+        data: {
+          providerThreadId,
+          item: {
+            id: "msg-null",
+            phase: null,
+            text: "unknown",
+            type: "agentMessage",
+          },
+        },
+      },
+      {
+        id: "evt-final",
+        seq: 3,
+        threadId: "thr_test",
+        createdAt: 3,
+        scope,
+        type: "item/completed",
+        data: {
+          providerThreadId,
+          item: {
+            id: "msg-final",
+            phase: "final_answer",
+            text: "final",
+            type: "agentMessage",
+          },
+        },
+      },
+    ];
+    const queue = createFetchQueue([{ body: rows }, { body: rows[2] }]);
+    const sdk = createBbSdk({
+      transport: createHttpTransport({
+        baseUrl: "http://bb.test",
+        fetch: queue.fetch,
+        runtime: "node",
+      }),
+    });
+
+    const listed = await sdk.threads.events.list({
+      threadId: "thr_test",
+      types: ["item/completed"],
+    });
+    expect(listed).toMatchObject(rows);
+    expect(listed[0]?.data).not.toHaveProperty("item.phase");
+
+    const waited = await sdk.threads.events.wait({
+      afterSeq: "2",
+      threadId: "thr_test",
+      type: "item/completed",
+      waitMs: "1000",
+    });
+    expect(waited).toMatchObject({
+      id: "evt-final",
+      seq: 3,
+      threadId: "thr_test",
+      scope,
+      type: "item/completed",
+      data: {
+        providerThreadId,
+        item: {
+          id: "msg-final",
+          phase: "final_answer",
+          text: "final",
+          type: "agentMessage",
+        },
+      },
+    });
+    expect(queue.requests).toEqual([
+      {
+        bodyText: undefined,
+        method: "GET",
+        url: "http://bb.test/api/v1/threads/thr_test/events?types=item%2Fcompleted",
+      },
+      {
+        bodyText: undefined,
+        method: "GET",
+        url: "http://bb.test/api/v1/threads/thr_test/events/wait?afterSeq=2&type=item%2Fcompleted&waitMs=1000",
+      },
+    ]);
+  });
+
