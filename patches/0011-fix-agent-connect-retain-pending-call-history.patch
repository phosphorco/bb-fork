+  it("keeps only intact accepted attempts pending until their exact native turn is linked", async () => {
+    const db = createConnection(":memory:");
+    migrate(db);
+    migrateP6rSidecars(db);
+    const threadId = historyThread(db);
+    const extension = historyExtension(db);
+    const namespace = "14:instance-proof6:plugin";
+    const author: JsonValue = {
+      evidence: "integration-asserted",
+      identity: {
+        key: "history-external",
+        kind: "external",
+        pluginId: "plugin",
+        subject: "history-external",
+      },
+      presentation: { avatarUrl: null, displayName: "History external", handle: null },
+    };
+    const accept = (input: {
+      readonly attemptContributionId?: string;
+      readonly includeAttempt?: boolean;
+      readonly nativeRequestId?: string;
+      readonly operationId: string;
+      readonly sourceKind?: "contribution" | "generated" | "interaction";
+    }) => {
+      const contributionId = `contribution-${input.operationId}`;
+      db.transaction((tx) => acceptP6rOperationInTransaction(tx, {
+        assertLive: () => ({ ok: true }),
+        ...(input.includeAttempt === false ? {} : {
+          attempt: {
+            createdAt: 100,
+            id: `attempt-${input.operationId}`,
+            inputs: [{
+              contributionId: input.attemptContributionId ?? contributionId,
+              groupIndex: 0,
+              snapshot: { text: input.operationId },
+              sourceIndex: 0,
+              sourceKind: input.sourceKind ?? "contribution",
+            }],
+            ...(input.nativeRequestId === undefined ? {} : { nativeRequestId: input.nativeRequestId }),
+            threadId,
+          },
+        }),
+        contribution: {
+          acceptedAt: 100,
+          acceptedAuthorship: author,
+          currentProjection: { text: input.operationId },
+          id: contributionId,
+          initialInput: { text: input.operationId },
+          latestEditor: author,
+          ...(input.nativeRequestId === undefined ? {} : { nativeRequestId: input.nativeRequestId }),
+          threadId,
+        },
+        operationId: input.operationId,
+        operationNamespace: namespace,
+        payloadHash: `hash-${input.operationId}`,
+        receipt: {
+          acceptedAt: 100,
+          ...(input.nativeRequestId === undefined ? {} : { nativeRequestId: input.nativeRequestId }),
+          retentionDeadline: 1_000,
+          threadId,
+        },
+      }));
+    };
+    const read = (operationId: string) => extension.protocol.historyAttempts({
+      kind: "operation" as const,
+      limit: 10,
+      operationId,
+    });
+
+    accept({ nativeRequestId: "request-awaiting", operationId: "awaiting" });
+    await expect(read("awaiting")).resolves.toMatchObject({
+      ok: true,
+      value: { status: "pending" },
+    });
+    db.transaction((tx) => appendDaemonEventsInTransaction(tx, [
+      {
+        data: "{}",
+        environmentId: null,
+        itemId: null,
+        itemKind: null,
+        parentToolCallId: null,
+        providerThreadId: "history-provider",
+        scope: turnScope("history-turn"),
+        threadId,
+        type: "turn/started",
+      },
+      {
+        data: JSON.stringify({ clientRequestId: "request-awaiting" }),
+        environmentId: null,
+        itemId: null,
+        itemKind: null,
+        parentToolCallId: null,
+        providerThreadId: "history-provider",
+        scope: turnScope("history-turn"),
+        threadId,
+        type: "turn/input/accepted",
+      },
+    ]));
+    expect(linkP6rNativeTurnForRequest(db, {
+      nativeRequestId: "request-awaiting",
+      threadId,
+      turnId: "history-turn",
+    })).toBe(true);
+    await expect(read("awaiting")).resolves.toMatchObject({
+      ok: true,
+      value: {
+        items: [{ correlation: { threadId, turnId: "history-turn" }, status: "known" }],
+        status: "known",
+      },
+    });
+
+    db.transaction((tx) => reserveP6rQueuedOperationInTransaction(tx, {
+      acceptedAt: 100,
+      acceptedAuthorship: author,
+      assertLive: () => ({ ok: true }),
+      contributionId: "contribution-pending",
+      input: [{ text: "pending", type: "text" }],
+      operationId: "pending",
+      operationNamespace: namespace,
+      payloadHash: "hash-pending",
+      queuedMessageId: "queued-pending",
+      retentionDeadline: 1_000,
+      threadId,
+    }));
+    await expect(read("pending")).resolves.toMatchObject({
+      ok: true,
+      value: { status: "pending" },
+    });
+    db.transaction((tx) => expect(rejectP6rQueuedOperationInTransaction(
+      tx,
+      "queued-pending",
+    )).toBe(true));
+    await expect(read("pending")).resolves.toMatchObject({
+      ok: true,
+      value: { items: [], status: "known" },
+    });
+
+    accept({ includeAttempt: false, operationId: "empty" });
+    accept({ operationId: "missing-request" });
+    accept({
+      attemptContributionId: "missing-contribution",
+      nativeRequestId: "request-missing-contribution",
+      operationId: "missing-contribution",
+    });
+    accept({
+      nativeRequestId: "request-generated",
+      operationId: "generated",
+      sourceKind: "generated",
+    });
+    accept({ nativeRequestId: "request-ambiguous", operationId: "ambiguous" });
+    db.transaction((tx) => appendDaemonEventsInTransaction(tx, [
+      {
+        data: "{}",
+        environmentId: null,
+        itemId: null,
+        itemKind: null,
+        parentToolCallId: null,
+        providerThreadId: "history-provider",
+        scope: turnScope("ambiguous-one"),
+        threadId,
+        type: "turn/started",
+      },
+      {
+        data: JSON.stringify({ clientRequestId: "request-ambiguous" }),
+        environmentId: null,
+        itemId: null,
+        itemKind: null,
+        parentToolCallId: null,
+        providerThreadId: "history-provider",
+        scope: turnScope("ambiguous-one"),
+        threadId,
+        type: "turn/input/accepted",
+      },
+      {
+        data: "{}",
+        environmentId: null,
+        itemId: null,
+        itemKind: null,
+        parentToolCallId: null,
+        providerThreadId: "history-provider",
+        scope: turnScope("ambiguous-two"),
+        threadId,
+        type: "turn/started",
+      },
+      {
+        data: JSON.stringify({ clientRequestId: "request-ambiguous" }),
+        environmentId: null,
+        itemId: null,
+        itemKind: null,
+        parentToolCallId: null,
+        providerThreadId: "history-provider",
+        scope: turnScope("ambiguous-two"),
+        threadId,
+        type: "turn/input/accepted",
+      },
+    ]));
+    for (const operationId of [
+      "empty",
+      "missing-request",
+      "missing-contribution",
+      "generated",
+      "ambiguous",
+    ]) {
+      const result = await read(operationId);
+      expect(result).toMatchObject({ ok: true });
+      if (!result.ok) throw new Error("expected history result");
+      expect(result.value.status).not.toBe("pending");
+    }
+  });
