new file mode 100644
index 0000000000000000000000000000000000000000..ef9d08515f4e3f975b0be2f7a0d81e1be0cd6d4b
--- /dev/null
+++ b/plugins/provider-claude-code/src/response-identity.test.ts
@@ -0,0 +1,298 @@
+import { describe, expect, it } from "vitest";
+import type { ThreadDelta } from "@get-bb/plugin-sdk/provider-bridge";
+import { experimental_createDeltaAssembler } from "@get-bb/plugin-sdk/provider-bridge/testing";
+import { createFakePluginHost } from "@get-bb/plugin-sdk/testing";
+import claudeCodePlugin from "../server.js";
+import {
+  CLAUDE_RESPONSE_IDENTITY_KIND,
+  CLAUDE_RESPONSE_IDENTITY_LIMIT,
+  ClaudeResponseIdentityTracker,
+  claudeResponseIdentityItemSchema,
+  claudeResponseIdentityStateSchema,
+} from "./response-identity.js";
+import { createClaudeDeltaHarness } from "./delta-test-harness.js";
+
+function start(id = "msg-1", session = "session-1") {
+  return {
+    type: "stream_event",
+    session_id: session,
+    parent_tool_use_id: null,
+    event: { type: "message_start", message: { id, model: "claude-probe" } },
+  };
+}
+function assistant(id = "msg-1", requestId: string | undefined = "request-1") {
+  return {
+    type: "assistant",
+    session_id: "session-1",
+    parent_tool_use_id: null,
+    uuid: "sdk-wrapper-uuid",
+    ...(requestId === undefined ? {} : { request_id: requestId }),
+    message: {
+      id,
+      model: "claude-probe",
+      content: [{ type: "text", text: "unchanged text" }],
+    },
+  };
+}
+function payload(deltas: ThreadDelta[]) {
+  const delta = deltas[0];
+  if (delta?.kind === "item.close" && delta.item.type === "extension")
+    return delta.item.payload;
+  if (delta?.kind === "extension.state") return delta.payload;
+  throw new Error("Expected response identity metadata");
+}
+describe("Claude response identity preservation", () => {
+  it("registers the exact item and unbound state schemas on the actual provider", () => {
+    const host = createFakePluginHost({ pluginId: "provider-claude-code" });
+    claudeCodePlugin(host.bb);
+    const declaration = host.harness.registrations.providerRegistrations.find(
+      (entry) => entry.id === "claude-code",
+    );
+    expect(declaration?.extensionKinds?.["response-identity"]).toEqual({
+      item: claudeResponseIdentityItemSchema,
+      state: claudeResponseIdentityStateSchema,
+    });
+  });
+  it("does not spend identity enrichment on a phase-only assistant block", () => {
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    tracker.observe(start());
+    const withoutRequest = assistant();
+    delete withoutRequest.request_id;
+    expect(tracker.observe(withoutRequest)).toEqual([]);
+    expect(payload(tracker.observe(assistant()))).toMatchObject({
+      binding: "turn_scope",
+      providerRequestId: "request-1",
+      phase: "assistant",
+    });
+    expect(tracker.observe(assistant())).toEqual([]);
+  });
+  it("preserves early message ID and one request-ID enrichment, deduplicating block UUIDs", () => {
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    const first = tracker.observe(start());
+    expect(
+      claudeResponseIdentityItemSchema.parse(payload(first)),
+    ).toMatchObject({
+      binding: "turn_scope",
+      messageId: "msg-1",
+      providerRequestId: null,
+      phase: "message_start",
+      aborted: null,
+    });
+    const enriched = tracker.observe(assistant());
+    expect(
+      claudeResponseIdentityItemSchema.parse(payload(enriched)),
+    ).toMatchObject({ providerRequestId: "request-1", phase: "assistant" });
+    expect(
+      tracker.observe({ ...assistant(), uuid: "another-content-block" }),
+    ).toEqual([]);
+    expect(tracker.observe(start())).toEqual([]);
+  });
+  it("uses exact existing canonical turn scope without changing text or creating a turn", () => {
+    const harness = createClaudeDeltaHarness();
+    const accepted = harness.acceptInput("canonical", "thread-1");
+    const observed = harness.translate(start(), { threadId: "thread-1" });
+    const response = observed.find(
+      (event) =>
+        event.type === "item/completed" && event.item.type === "extension",
+    );
+    const input = accepted.find(
+      (event) => event.type === "turn/input/accepted",
+    );
+    expect(response?.scope).toEqual(input?.scope);
+    expect(
+      response?.type === "item/completed" &&
+        response.item.type === "extension" &&
+        response.item.presentation?.suppress,
+    ).toBe(true);
+    const text = harness.translate(assistant(), { threadId: "thread-1" });
+    expect(text).toContainEqual(
+      expect.objectContaining({
+        type: "item/completed",
+        item: expect.objectContaining({
+          type: "agentMessage",
+          text: "unchanged text",
+        }),
+      }),
+    );
+    expect(observed.some((event) => event.type === "turn/started")).toBe(false);
+  });
+  it("keeps several tool-loop response IDs in one turn and steering adds no new owner", () => {
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    expect(payload(tracker.observe(start("msg-1")))).toMatchObject({
+      binding: "turn_scope",
+    });
+    tracker.acceptInput(1);
+    expect(payload(tracker.observe(start("msg-2")))).toMatchObject({
+      binding: "turn_scope",
+      messageId: "msg-2",
+    });
+  });
+  it("never assigns a delayed prior response to a newly accepted turn", () => {
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    tracker.observe(start());
+    tracker.settle();
+    tracker.acceptInput(2);
+    const late = tracker.observe(assistant());
+    expect(late[0]?.kind).toBe("extension.state");
+    expect(
+      claudeResponseIdentityStateSchema.parse(payload(late)),
+    ).toMatchObject({
+      binding: "unbound",
+      reason: "prior_turn_response",
+      messageId: "msg-1",
+    });
+    expect(payload(tracker.observe(start("msg-new")))).toMatchObject({
+      binding: "turn_scope",
+      messageId: "msg-new",
+    });
+  });
+  it("settled/no-input/subagent/session-conflict observations remain unbound", () => {
+    const empty = new ClaudeResponseIdentityTracker();
+    expect(payload(empty.observe(start()))).toMatchObject({
+      reason: "canonical_input_not_accepted",
+    });
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    tracker.observe(start());
+    expect(
+      payload(tracker.observe(start("nested"), "tool-parent")),
+    ).toMatchObject({
+      reason: "subagent_response",
+      parentToolUseId: "tool-parent",
+    });
+    expect(
+      payload(tracker.observe(start("other-session", "session-2"))),
+    ).toMatchObject({ reason: "native_session_conflict" });
+    tracker.settle();
+    expect(payload(tracker.observe(assistant()))).toMatchObject({
+      reason: "turn_settled",
+    });
+  });
+  it("retains aborted/superseded flags as observation, never inference completion", () => {
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    tracker.observe(start());
+    expect(
+      payload(
+        tracker.observe({
+          ...assistant(),
+          aborted: true,
+          supersedes: ["prior-sdk-uuid"],
+        }),
+      ),
+    ).toMatchObject({
+      binding: "turn_scope",
+      aborted: true,
+      supersedesSdkUuids: ["prior-sdk-uuid"],
+    });
+    expect(
+      payload(tracker.observe(assistant("msg-1", "contradictory-request"))),
+    ).toMatchObject({ binding: "unbound", reason: "identity_conflict" });
+    expect(tracker.observe(assistant())).toEqual([]);
+  });
+  it("does not evict old ownership at the resident bound or publish repeated overflow", () => {
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    for (let index = 0; index < CLAUDE_RESPONSE_IDENTITY_LIMIT; index++)
+      expect(tracker.observe(start(`msg-${index}`))).toHaveLength(1);
+    expect(payload(tracker.observe(start("overflow")))).toMatchObject({
+      binding: "unbound",
+      reason: "identity_capacity_exceeded",
+    });
+    expect(tracker.observe(start("overflow-again"))).toEqual([]);
+    tracker.settle();
+    tracker.acceptInput(2);
+    expect(payload(tracker.observe(assistant("msg-0")))).toMatchObject({
+      reason: "prior_turn_response",
+    });
+  });
+  it("bounds payloads and invalid Unicode without changing valid non-BMP identifiers", () => {
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    expect(payload(tracker.observe(start("msg-🧪")))).toMatchObject({
+      messageId: "msg-🧪",
+      binding: "turn_scope",
+    });
+    expect(payload(tracker.observe(start("msg-\ud800")))).toMatchObject({
+      messageId: null,
+      binding: "unbound",
+      reason: "invalid_identity",
+    });
+    const large = new ClaudeResponseIdentityTracker();
+    large.acceptInput(1);
+    const deltas = large.observe({
+      ...assistant(),
+      supersedes: Array.from({ length: 16 }, () => "🧪".repeat(128)),
+    });
+    expect(payload(deltas)).toMatchObject({
+      binding: "unbound",
+      reason: "payload_limit",
+      messageId: null,
+    });
+    expect(Buffer.byteLength(JSON.stringify(deltas))).toBeLessThan(4096);
+  });
+  it("validates declared extension schemas and uses public assembler persistence", () => {
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    const assembler = experimental_createDeltaAssembler({
+      providerId: "claude-code",
+      entropyPrefix: "identity-proof",
+    });
+    const events = assembler.assemble({
+      threadId: "thread",
+      deltas: [
+        { kind: "turn.open" },
+        { kind: "input.accepted", clientRequestId: "canonical" },
+        ...tracker.observe(start()),
+      ],
+    });
+    const extension = events.find(
+      (event) =>
+        event.type === "item/completed" && event.item.type === "extension",
+    );
+    expect(extension).toMatchObject({
+      scope: { kind: "turn", turnId: "identity-proof-t1" },
+      item: {
+        kind: CLAUDE_RESPONSE_IDENTITY_KIND,
+        presentation: { suppress: true },
+      },
+    });
+    const valid = claudeResponseIdentityItemSchema.parse(
+      payload(tracker.observe(start("second"))),
+    );
+    expect(
+      claudeResponseIdentityItemSchema.safeParse({ ...valid, surprise: true })
+        .success,
+    ).toBe(false);
+    expect(
+      claudeResponseIdentityStateSchema.safeParse(
+        payload(tracker.observe(start("third"))),
+      ).success,
+    ).toBe(false);
+  });
+  it("does not mutate native SDK bytes or infer identity from pre-response failures", () => {
+    const tracker = new ClaudeResponseIdentityTracker();
+    tracker.acceptInput(1);
+    const raw = {
+      ...assistant(),
+      diagnosticContext: {
+        headers: { "request-id": "actual-provider-context" },
+        instructions: "unchanged",
+      },
+    };
+    const before = JSON.stringify(raw);
+    tracker.observe(raw);
+    expect(JSON.stringify(raw)).toBe(before);
+    expect(
+      tracker.observe({
+        type: "result",
+        subtype: "error_during_execution",
+        is_error: true,
+      }),
+    ).toEqual([]);
+  });
+});
diff --git a/plugins/provider-claude-code/src/response-identity.ts b/plugins/provider-claude-code/src/response-identity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1d3a18c0960bb238ac540530152c5128b2ebf6f6
--- /dev/null
+++ b/plugins/provider-claude-code/src/response-identity.ts
@@ -0,0 +1,285 @@
+import { z } from "zod";
+import type { ThreadDelta } from "@get-bb/plugin-sdk/provider-bridge";
+
+export const CLAUDE_RESPONSE_IDENTITY_KIND =
+  "provider-claude-code/response-identity";
+export const CLAUDE_RESPONSE_IDENTITY_LIMIT = 256;
+export const CLAUDE_RESPONSE_IDENTITY_BYTES = 4096;
+
+function wellFormedId(value: string): boolean {
+  if (
+    !value.length ||
+    value.length > 256 ||
+    /[\u0000-\u001f\u007f]/u.test(value)
+  )
+    return false;
+  for (let index = 0; index < value.length; index++) {
+    const unit = value.charCodeAt(index);
+    if (unit >= 0xd800 && unit <= 0xdbff) {
+      const next = value.charCodeAt(++index);
+      if (!(next >= 0xdc00 && next <= 0xdfff)) return false;
+    } else if (unit >= 0xdc00 && unit <= 0xdfff) return false;
+  }
+  return true;
+}
+const identity = z.string().refine(wellFormedId);
+const reasonSchema = z.enum([
+  "canonical_input_not_accepted",
+  "turn_settled",
+  "prior_turn_response",
+  "native_session_conflict",
+  "subagent_response",
+  "identity_conflict",
+  "identity_capacity_exceeded",
+  "identity_enrichment_limit",
+  "invalid_identity",
+  "synthetic_response",
+  "payload_limit",
+]);
+const payloadSchema = z
+  .object({
+    version: z.literal(1),
+    binding: z.enum(["turn_scope", "unbound"]),
+    reason: reasonSchema.nullable(),
+    phase: z.enum(["message_start", "assistant"]),
+    nativeSessionId: identity.nullable(),
+    messageId: identity.nullable(),
+    providerRequestId: identity.nullable(),
+    parentToolUseId: identity.nullable(),
+    aborted: z.literal(true).nullable(),
+    supersedesSdkUuids: z.array(identity).max(16),
+  })
+  .strict()
+  .refine(
+    (value) =>
+      Buffer.byteLength(JSON.stringify(value)) <=
+      CLAUDE_RESPONSE_IDENTITY_BYTES,
+  );
+export const claudeResponseIdentityItemSchema = payloadSchema.refine(
+  (value) =>
+    value.binding === "turn_scope" &&
+    value.reason === null &&
+    value.messageId !== null &&
+    value.nativeSessionId !== null &&
+    value.parentToolUseId === null,
+);
+export const claudeResponseIdentityStateSchema = payloadSchema.refine(
+  (value) => value.binding === "unbound" && value.reason !== null,
+);
+type Payload = z.infer<typeof payloadSchema>;
+type Reason = z.infer<typeof reasonSchema>;
+interface Observed {
+  payload: Payload;
+  issue: Reason | null;
+}
+interface Held {
+  owner: number | null;
+  payload: Payload;
+  emitted: number;
+  lastWire: string;
+  conflicted: boolean;
+}
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+function extract(
+  raw: unknown,
+  parentToolUseId: string | undefined,
+): Observed | null {
+  const sdk = record(raw);
+  const streamed = sdk?.type === "stream_event" ? record(sdk.event) : undefined;
+  const message =
+    streamed?.type === "message_start"
+      ? record(streamed.message)
+      : sdk?.type === "assistant"
+        ? record(sdk.message)
+        : undefined;
+  if (message?.id === undefined || !sdk) return null;
+  let issue: Reason | null = null;
+  const read = (value: unknown, nullable: boolean): string | null => {
+    if (value === undefined || value === null) {
+      if (!nullable) issue = "invalid_identity";
+      return null;
+    }
+    const parsed = identity.safeParse(value);
+    if (!parsed.success) {
+      issue = "invalid_identity";
+      return null;
+    }
+    return parsed.data;
+  };
+  const nativeSessionId = read(sdk.session_id, false),
+    messageId = read(message.id, false);
+  const providerRequestId = read(sdk.request_id, true);
+  const parent = read(parentToolUseId ?? sdk.parent_tool_use_id, true);
+  let supersedesSdkUuids: string[] = [];
+  if (sdk.supersedes !== undefined) {
+    const supersedes = z.array(identity).max(16).safeParse(sdk.supersedes);
+    if (supersedes.success) supersedesSdkUuids = supersedes.data;
+    else issue = "invalid_identity";
+  }
+  if (message.model === "<synthetic>") issue = "synthetic_response";
+  return {
+    payload: {
+      version: 1,
+      binding: "unbound",
+      reason: null,
+      phase: streamed?.type === "message_start" ? "message_start" : "assistant",
+      nativeSessionId,
+      messageId,
+      providerRequestId,
+      parentToolUseId: parent,
+      aborted: sdk.aborted === true ? true : null,
+      supersedesSdkUuids,
+    },
+    issue,
+  };
+}
+
+export class ClaudeResponseIdentityTracker {
+  private current: { generation: number; nativeSession: string | null } | null =
+    null;
+  private everAccepted = false;
+  private readonly held = new Map<string, Held>();
+  private readonly coverageReasons = new Set<Reason>();
+
+  acceptInput(generation: number): void {
+    this.everAccepted = true;
+    if (this.current?.generation !== generation)
+      this.current = { generation, nativeSession: null };
+  }
+  settle(): void {
+    this.current = null;
+  }
+
+  private coverage(payload: Payload, reason: Reason): ThreadDelta[] {
+    const value: Payload = { ...payload, binding: "unbound", reason };
+    if (!payloadSchema.safeParse(value).success)
+      return this.coverage(
+        {
+          version: 1,
+          binding: "unbound",
+          reason: null,
+          phase: payload.phase,
+          nativeSessionId: null,
+          messageId: null,
+          providerRequestId: null,
+          parentToolUseId: null,
+          aborted: null,
+          supersedesSdkUuids: [],
+        },
+        "payload_limit",
+      );
+    if (this.coverageReasons.has(reason)) return [];
+    this.coverageReasons.add(reason);
+    return [
+      {
+        kind: "extension.state",
+        extensionKind: CLAUDE_RESPONSE_IDENTITY_KIND,
+        payload: value,
+      },
+    ];
+  }
+
+  observe(raw: unknown, parentToolUseId?: string): ThreadDelta[] {
+    const observation = extract(raw, parentToolUseId);
+    if (!observation) return [];
+    const payload = observation.payload;
+    if (observation.issue !== null)
+      return this.coverage(payload, observation.issue);
+    if (!payloadSchema.safeParse(payload).success)
+      return this.coverage(payload, "payload_limit");
+    const key = JSON.stringify([payload.nativeSessionId, payload.messageId]);
+    let held = this.held.get(key);
+    if (!held) {
+      if (this.held.size >= CLAUDE_RESPONSE_IDENTITY_LIMIT)
+        return this.coverage(payload, "identity_capacity_exceeded");
+      held = {
+        owner: this.current?.generation ?? null,
+        payload,
+        emitted: 0,
+        lastWire: "",
+        conflicted: false,
+      };
+      this.held.set(key, held);
+    }
+    if (held.conflicted) return this.coverage(payload, "identity_conflict");
+    let reason: Reason | null =
+      this.current === null
+        ? this.everAccepted
+          ? "turn_settled"
+          : "canonical_input_not_accepted"
+        : held.owner !== this.current.generation
+          ? "prior_turn_response"
+          : null;
+    if (payload.parentToolUseId !== null) reason = "subagent_response";
+    if (reason === null && this.current !== null) {
+      if (
+        this.current.nativeSession !== null &&
+        this.current.nativeSession !== payload.nativeSessionId
+      )
+        reason = "native_session_conflict";
+      else this.current.nativeSession = payload.nativeSessionId;
+    }
+    if (
+      held.payload.providerRequestId !== null &&
+      payload.providerRequestId !== null &&
+      held.payload.providerRequestId !== payload.providerRequestId
+    )
+      reason = "identity_conflict";
+    if (held.payload.parentToolUseId !== payload.parentToolUseId)
+      reason = "identity_conflict";
+    if (reason === "identity_conflict") held.conflicted = true;
+    if (reason !== null) return this.coverage(payload, reason);
+    const next: Payload = {
+      ...payload,
+      binding: "turn_scope",
+      reason: null,
+      providerRequestId:
+        payload.providerRequestId ?? held.payload.providerRequestId,
+      aborted: payload.aborted ?? held.payload.aborted,
+      supersedesSdkUuids: payload.supersedesSdkUuids.length
+        ? payload.supersedesSdkUuids
+        : held.payload.supersedesSdkUuids,
+    };
+    const wire = JSON.stringify(next);
+    const addedIdentity =
+      next.providerRequestId !== held.payload.providerRequestId ||
+      next.aborted !== held.payload.aborted ||
+      JSON.stringify(next.supersedesSdkUuids) !==
+        JSON.stringify(held.payload.supersedesSdkUuids);
+    if (held.emitted > 0 && !addedIdentity) return [];
+    if (
+      wire === held.lastWire ||
+      (payload.phase === "message_start" && held.emitted > 0)
+    )
+      return [];
+    if (held.emitted >= 2)
+      return this.coverage(payload, "identity_enrichment_limit");
+    held.payload = next;
+    held.lastWire = wire;
+    held.emitted++;
+    return [
+      {
+        kind: "item.close",
+        key: { providerItemId: `response-identity:${key}` },
+        status: "completed",
+        item: {
+          type: "extension",
+          kind: CLAUDE_RESPONSE_IDENTITY_KIND,
+          payload: next,
+        },
+        presentation: {
+          label: {
+            pending: "Provider response identity",
+            completed: "Provider response identity",
+          },
+          icon: { glyph: "activity" },
+          suppress: true,
+        },
+      },
+    ];
+  }
+}
