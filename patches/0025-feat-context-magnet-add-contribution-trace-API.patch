+      operation: { kind: "unmatched" },
+      trigger: { renderState: "unrendered" },
+    });
+  });
+
+  it("rejects a declaration with an implicit attachment shape", () => {
+    expect(() =>
+      contextMagnetContributionTraceDeclarationSchema.parse({
+        ...declaration,
+        operation: { eventSeq: 42, operationId: "evt_42" },
+      }),
+    ).toThrow();
+  });
+});
