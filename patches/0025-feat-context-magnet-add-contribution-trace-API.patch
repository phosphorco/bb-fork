--- /dev/null
+++ b/packages/domain/src/context-magnet-contribution-trace.ts
@@ -0,0 +1,232 @@
+import { z } from "zod";
+
+const safeIdSchema = z.string().min(1).max(256);
+const safeTextSchema = z.string().max(1024);
+const safeDetailSchema = z.string().max(256);
+const safeEvidenceValueSchema: z.ZodType<unknown> = z.lazy(() =>
+  z.union([
+    z.null(),
+    z.boolean(),
+    z.number().finite(),
+    safeTextSchema,
+    z.array(safeEvidenceValueSchema).max(64),
+    z
+      .record(z.string().max(128), safeEvidenceValueSchema)
+      .refine((value) => Object.keys(value).length <= 32),
+  ]),
+);
+
+export const contextMagnetContributionKeySchema = z
+  .object({ id: safeIdSchema, threadId: safeIdSchema })
+  .strict();
+export const contextMagnetOperationKeySchema = z
+  .object({
+    eventSeq: z.number().int().nonnegative(),
+    operationId: safeIdSchema,
+    threadId: safeIdSchema,
+    turnId: safeIdSchema.optional(),
+  })
+  .strict();
+export const contextMagnetOperationAttachmentSchema = z.discriminatedUnion(
+  "kind",
+  [
+    z
+      .object({
+        kind: z.literal("exact"),
+        renderedAnchor: contextMagnetOperationKeySchema,
+        target: contextMagnetOperationKeySchema,
+      })
+      .strict()
+      .refine(
+        (value) =>
+          value.target.threadId === value.renderedAnchor.threadId &&
+          value.target.operationId === value.renderedAnchor.operationId &&
+          value.target.eventSeq === value.renderedAnchor.eventSeq,
+        "exact attachments must use their target as the rendered anchor",
+      ),
+    z
+      .object({
+        direction: z.enum(["before", "after", "containing-turn"]),
+        kind: z.literal("nearest-rendered"),
+        renderedAnchor: contextMagnetOperationKeySchema,
+        target: contextMagnetOperationKeySchema,
+      })
+      .strict(),
+    z
+      .object({
+        kind: z.literal("unmatched"),
+        reason: z.enum([
+          "target-not-retained",
+          "target-not-renderable",
+          "unknown",
+        ]),
+        target: contextMagnetOperationKeySchema.nullable(),
+      })
+      .strict(),
+  ],
+);
+export const contextMagnetTriggerProvenanceSchema = z
+  .object({
+    factKey: contextMagnetContributionKeySchema.nullable(),
+    locator: z.enum(["host-fact", "host-policy", "unknown"]),
+    renderedAnchor: contextMagnetOperationKeySchema.optional(),
+    renderState: z.enum(["rendered", "unrendered", "withheld", "unknown"]),
+  })
+  .strict();
+export const contextMagnetInclusionReasonSchema = z
+  .object({
+    category: z.enum([
+      "relevant-tool-result",
+      "relevant-thread-fact",
+      "policy-required",
+      "explicit-user-context",
+      "deduplication",
+      "other-safe",
+    ]),
+    detail: safeDetailSchema.optional(),
+  })
+  .strict();
+export const contextMagnetContributionOutcomeSchema = z.discriminatedUnion(
+  "kind",
+  [
+    z
+      .object({
+        kind: z.literal("rejected"),
+        rejection: z.enum(["policy", "validation", "capacity", "other-safe"]),
+      })
+      .strict(),
+    z.object({ kind: z.literal("delivered") }).strict(),
+    z
+      .object({
+        against: contextMagnetContributionKeySchema.nullable(),
+        kind: z.literal("deduplicated"),
+      })
+      .strict(),
+    z
+      .object({
+        failure: z.enum(["host", "contributor", "other-safe"]),
+        kind: z.literal("failed"),
+      })
+      .strict(),
+    z
+      .object({
+        kind: z.literal("unavailable"),
+        unavailable: z.enum([
+          "not-retained",
+          "not-authorized",
+          "carrier",
+          "unknown",
+        ]),
+      })
+      .strict(),
+  ],
+);
+export const contextMagnetConsumptionEvidenceSchema = z.discriminatedUnion(
+  "state",
+  [
+    z
+      .object({
+        kind: z.enum(["model-owned-receipt", "host-observed"]),
+        observedAt: z.string().datetime().optional(),
+        state: z.literal("consumed"),
+      })
+      .strict(),
+    z.object({ state: z.literal("not-observed") }).strict(),
+    z.object({ state: z.literal("unknown") }).strict(),
+    z
+      .object({
+        reason: z.enum(["not-retained", "not-authorized", "carrier"]),
+        state: z.literal("unavailable"),
+      })
+      .strict(),
+  ],
+);
+export const contextMagnetPreservedEvidenceSchema = z
+  .object({
+    original: safeEvidenceValueSchema,
+    redactions: z
+      .array(
+        z
+          .object({
+            path: safeTextSchema,
+            reason: z.enum(["authorization", "privacy", "retention", "unsafe-body"]),
+          })
+          .strict(),
+      )
+      .max(64),
+    source: z.literal("context-magnet-host"),
+    sourceSchemaVersion: safeIdSchema,
+    unknownFields: z.record(z.string().max(128), safeEvidenceValueSchema),
+  })
+  .strict();
+export const contextMagnetContributionTraceSchema = z
+  .object({
+    consumption: contextMagnetConsumptionEvidenceSchema,
+    contributionKey: contextMagnetContributionKeySchema,
+    evidence: contextMagnetPreservedEvidenceSchema,
+    inclusionReason: contextMagnetInclusionReasonSchema,
+    operation: contextMagnetOperationAttachmentSchema,
+    outcome: contextMagnetContributionOutcomeSchema,
+    trigger: contextMagnetTriggerProvenanceSchema,
+  })
+  .strict();
+export const contextMagnetRetainedFromSchema = z
+  .object({
+    contributionEventSeq: z.number().int().nonnegative().nullable(),
+    operationEventSeq: z.number().int().nonnegative().nullable(),
+    state: z.enum(["known", "unknown", "unavailable"]),
+  })
+  .strict();
+export const contextMagnetTraceGapSchema = z
+  .object({
+    afterEventSeq: z.number().int().nonnegative().optional(),
+    beforeEventSeq: z.number().int().nonnegative().optional(),
+    kind: z.enum(["retention", "authorization", "carrier", "redaction", "unknown"]),
+    reason: safeDetailSchema,
+    scope: z.enum([
+      "contributions",
+      "operations",
+      "trigger-provenance",
+      "consumption",
+    ]),
+  })
+  .strict();
+export const contextMagnetContributionTracePageSchema = z
+  .object({
+    completeness: z.enum(["complete", "partial", "unavailable"]),
+    contributions: z.array(contextMagnetContributionTraceSchema),
+    cursor: safeIdSchema.nullable(),
+    gaps: z.array(contextMagnetTraceGapSchema),
+    nextCursor: safeIdSchema.nullable(),
+    retainedFrom: contextMagnetRetainedFromSchema,
+    snapshot: z
+      .object({
+        capturedAt: z.string().datetime(),
+        id: safeIdSchema,
+        operationSeqHighWatermark: z.number().int().nonnegative(),
+      })
+      .strict(),
+    threadId: safeIdSchema,
+    version: z.literal("context-magnet.trace-carrier/v1"),
+  })
+  .strict();
+export const contextMagnetContributionTraceDeclarationSchema = z
+  .object({
+    evidence: contextMagnetPreservedEvidenceSchema,
+    inclusionReason: contextMagnetInclusionReasonSchema,
+    operation: contextMagnetOperationAttachmentSchema,
+    outcome: contextMagnetContributionOutcomeSchema,
+    receiptTool: safeIdSchema,
+    trigger: contextMagnetTriggerProvenanceSchema,
+  })
+  .strict();
+
+export type ContextMagnetContributionTrace = z.infer<
+  typeof contextMagnetContributionTraceSchema
+>;
+export type ContextMagnetContributionTraceDeclaration = z.infer<
+  typeof contextMagnetContributionTraceDeclarationSchema
+>;
+export type ContextMagnetContributionTracePage = z.infer<
+  typeof contextMagnetContributionTracePageSchema
+>;
