+import { describe, expect, it } from "vitest";
+import { contextMagnetContributionTraceDeclarationSchema } from "../src/context-magnet-contribution-trace.js";
+
+const declaration = {
+  evidence: {
+    original: { source: "explicit" },
+    redactions: [],
+    source: "context-magnet-host",
+    sourceSchemaVersion: "v1",
+    unknownFields: {},
+  },
+  inclusionReason: { category: "relevant-thread-fact" },
+  operation: {
+    kind: "unmatched",
+    reason: "target-not-retained",
+    target: null,
+  },
+  outcome: { kind: "delivered" },
+  receiptTool: "context_magnet_receipt",
+  trigger: {
+    factKey: null,
+    locator: "host-fact",
+    renderState: "unrendered",
+  },
+};
+
+describe("Context Magnet contribution trace contract", () => {
+  it("preserves an explicit unmatched attachment and unrendered trigger", () => {
+    expect(contextMagnetContributionTraceDeclarationSchema.parse(declaration)).toMatchObject({
+      operation: { kind: "unmatched" },
+      trigger: { renderState: "unrendered" },
+    });
+  });
+
+  it("rejects a declaration with an implicit attachment shape", () => {
+    expect(() =>
+      contextMagnetContributionTraceDeclarationSchema.parse({
+        ...declaration,
+        operation: { eventSeq: 42, operationId: "evt_42" },
+      }),
+    ).toThrow();
+  });
+});
