+  it("freezes receipt-derived operation placement at snapshot creation", () => {
+    const { db, thread } = setup();
+    appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id), now: 1, pluginId: "context-magnet", threadId: thread.id,
+    });
+    appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id), now: 2, pluginId: "context-magnet", threadId: thread.id,
+    });
+    appendReceiptOperation(db, { callId: "call_1", sequence: 7, threadId: thread.id, turnId: "turn_1" });
+    const beforeReceipt = listContextMagnetContributionTracePage(db, { limit: 1, now: 3, threadId: thread.id });
+    expect(recordContextMagnetContributionReceipt(db, {
+      callId: "call_1", now: 4, pluginId: "context-magnet", receiptTool: "context_magnet_receipt", threadId: thread.id, turnId: "turn_1",
