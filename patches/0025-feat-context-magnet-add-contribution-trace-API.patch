@@ -0,0 +1,71 @@
+import { describe, expect, it } from "vitest";
+import { normalizePluginAgentConfiguration } from "../internal/host-policy.js";
+
+function trace(value: object = {}) {
+  return {
+    evidence: {
+      original: { source: "explicit", ...value },
+      redactions: [],
+      source: "context-magnet-host",
+      sourceSchemaVersion: "v1",
+      unknownFields: {},
+    },
+    inclusionReason: { category: "other-safe" },
+    operation: { kind: "unmatched", reason: "unknown", target: null },
+    outcome: { kind: "delivered" },
+    receiptTool: "receipt",
+    trigger: { factKey: null, locator: "unknown", renderState: "unknown" },
+  };
+}
+
+function normalize(value: unknown) {
+  return normalizePluginAgentConfiguration({
+    knownSkillIds: new Set(),
+    knownToolIds: new Set(["receipt", "other"]),
+    pluginId: "context-magnet",
+    value,
+  });
+}
+
+describe("Context Magnet host policy", () => {
+  it("does not synthesize a trace from generic configuration", () => {
+    expect(normalize({ skills: [], tools: ["other"] }).contextMagnetTrace).toBeNull();
+  });
+
+  it("rejects body-bearing evidence", () => {
+    expect(() =>
+      normalize({
+        experimental_contextMagnetTrace: trace({ providerRequestBody: "secret" }),
+        skills: [],
+        tools: ["receipt"],
+      }),
+    ).toThrow(/cannot retain provider or request bodies/);
+  });
+
+  it("requires the receipt tool to be explicitly selected", () => {
+    expect(() =>
+      normalize({
+        experimental_contextMagnetTrace: trace(),
+        skills: [],
+        tools: ["other"],
+      }),
+    ).toThrow(/receiptTool must be an explicitly selected plugin tool/);
+  });
+
+  it("accepts only an unmatched null-target configure witness", () => {
+    expect(() =>
+      normalize({
+        experimental_contextMagnetTrace: {
+          ...trace(),
+          operation: {
+            kind: "exact",
+            renderedAnchor: { eventSeq: 1, operationId: "call_1", threadId: "thread_1" },
+            target: { eventSeq: 1, operationId: "call_1", threadId: "thread_1" },
+          },
+        },
+        skills: [],
+        tools: ["receipt"],
+      }),
+    ).toThrow(/must be an unmatched null-target witness/);
+  });
+});
