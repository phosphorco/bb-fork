+import { describe, expect, it } from "vitest";
+import { contextMagnetContributionTraceDeclarationSchema } from "../src/context-magnet-contribution-trace.js";
+
+const declaration = {
+  evidence: {
+    original: { source: "explicit" },
+    redactions: [],
+    source: "context-magnet-host",
+    sourceSchemaVersion: "v1",
+    unknownFields: {},
+  },
+  inclusionReason: { category: "relevant-thread-fact" },
+  operation: {
+    kind: "unmatched",
+    reason: "target-not-retained",
+    target: null,
+  },
+  outcome: { kind: "delivered" },
+  receiptTool: "context_magnet_receipt",
+  trigger: {
+    factKey: null,
+    locator: "host-fact",
+    renderState: "unrendered",
+  },
+};
