+import {
+  p6rContributions,
+  p6rParticipantWatermarks,
+} from "./sidecar-schema.js";
+
+export const P6R_PARTICIPANT_PROJECTOR_VERSION = 1;
+
+export interface P6rParticipantWatermark {
+  contributionAcceptedAt: number | null;
+  contributionCount: number;
+  projectorVersion: number;
+  requestEventId: string | null;
+  requestSequence: number | null;
+}
+
+export function readP6rParticipantInputWatermarks(
+  db: DbQueryConnection,
+  threadIds: readonly string[],
+): Map<string, P6rParticipantWatermark> {
+  const ids = [...new Set(threadIds)];
+  if (ids.length === 0) return new Map();
+  const rows = db.all<{
+    contribution_accepted_at: number | null;
+    contribution_count: number;
+    request_event_id: string | null;
+    request_sequence: number | null;
+    thread_id: string;
+  }>(sql`
+    SELECT ids.value AS thread_id,
+      (SELECT e.sequence FROM events e WHERE e.thread_id = ids.value AND e.type = 'client/turn/requested' ORDER BY e.sequence DESC LIMIT 1) AS request_sequence,
+      (SELECT e.id FROM events e WHERE e.thread_id = ids.value AND e.type = 'client/turn/requested' ORDER BY e.sequence DESC LIMIT 1) AS request_event_id,
+      (SELECT count(*) FROM p6r_contributions c WHERE c.thread_id = ids.value) AS contribution_count,
+      (SELECT max(c.accepted_at) FROM p6r_contributions c WHERE c.thread_id = ids.value) AS contribution_accepted_at
+    FROM json_each(${JSON.stringify(ids)}) AS ids
+  `);
+  return new Map(
+    rows.map((row) => [
+      row.thread_id,
+      {
+        contributionAcceptedAt: row.contribution_accepted_at,
+        contributionCount: row.contribution_count,
+        projectorVersion: P6R_PARTICIPANT_PROJECTOR_VERSION,
+        requestEventId: row.request_event_id,
+        requestSequence: row.request_sequence,
+      },
+    ]),
+  );
+}
+
+export function readStoredP6rParticipantWatermarks(
+  db: DbQueryConnection,
+  threadIds: readonly string[],
+): Map<string, P6rParticipantWatermark> {
+  const ids = [...new Set(threadIds)];
+  if (ids.length === 0) return new Map();
+  return new Map(
+    db
+      .select()
+      .from(p6rParticipantWatermarks)
+      .where(inArray(p6rParticipantWatermarks.threadId, ids))
+      .all()
+      .map((row) => [
+        row.threadId,
+        {
+          contributionAcceptedAt: row.contributionAcceptedAt,
+          contributionCount: row.contributionCount,
+          projectorVersion: row.projectorVersion,
+          requestEventId: row.requestEventId,
+          requestSequence: row.requestSequence,
+        },
+      ]),
+  );
+}
+
+export function p6rParticipantWatermarksEqual(
+  left: P6rParticipantWatermark,
+  right: P6rParticipantWatermark,
+): boolean {
+  return (
+    left.contributionAcceptedAt === right.contributionAcceptedAt &&
+    left.contributionCount === right.contributionCount &&
+    left.projectorVersion === right.projectorVersion &&
+    left.requestEventId === right.requestEventId &&
+    left.requestSequence === right.requestSequence
+  );
+}
+
+export function writeP6rParticipantWatermarkInTransaction(
+  db: DbQueryConnection,
+  threadId: string,
+  watermark: P6rParticipantWatermark,
+): void {
+  const values = { ...watermark, updatedAt: Date.now() };
+  db.insert(p6rParticipantWatermarks)
+    .values({ threadId, ...values })
+    .onConflictDoUpdate({ target: p6rParticipantWatermarks.threadId, set: values })
+    .run();
+}
 
