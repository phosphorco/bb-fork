+  private p6rViewersForSocket(
+    threadId: string,
+    socket: HubSocket,
+  ): readonly P6rPresenceViewer[] {
+    const actor = p6rGetSocketActor(socket);
+    return this.p6rPresence.p6rSnapshot(
+      actor?.p6rPrincipalKey === undefined
+        ? undefined
+        : { suppressPrincipalKey: actor.p6rPrincipalKey },
+    ).p6rThreads[threadId] ?? [];
+  }
