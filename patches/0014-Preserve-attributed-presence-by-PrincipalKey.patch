+function p6rPresenceGroupKey(actor: P6rClaimedIdentity): string {
+  return actor.p6rPrincipalKey === undefined
+    ? `legacy-client:${actor.p6rClientId}`
+    : `principal:${actor.p6rPrincipalKey}`;
+}
