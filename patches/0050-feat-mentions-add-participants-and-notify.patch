diff --git a/packages/db/test/data/thread-facets.test.ts b/packages/db/test/data/thread-facets.test.ts
index be0a7caebbc0999199f067486ad9303bea10a7fb..746a41a564fea92a0d8bcebe7c7a40e7ba985527 100644
--- a/packages/db/test/data/thread-facets.test.ts
+++ b/packages/db/test/data/thread-facets.test.ts
@@ -1194,4 +1194,60 @@ describe("core participants facet", () => {
       db.$client.close();
     }
   });
+
+  it("projects server-resolved mention actors from requested-event data", () => {
+    const { db, createVisibleThread } = setup();
+    try {
+      const thread = createVisibleThread();
+      const author: P6rActorSnapshot = {
+        p6rProviderId: "test-provider",
+        p6rSubject: "author",
+        p6rHandle: "author",
+        p6rDisplayName: "Author",
+        p6rImageUrl: null,
+      };
+      const mentioned: P6rActorSnapshot = {
+        p6rProviderId: "identity-boundaries/tailnet",
+        p6rSubject: "73",
+        p6rHandle: "florien@phosphor.co",
+        p6rDisplayName: "Florien Lazaro",
+        p6rImageUrl: "https://example.com/florien.jpg",
+      };
+      insertEvents(db, noopNotifier, [
+        {
+          threadId: thread.id,
+          scope: threadScope(),
+          sequence: 1,
+          type: "client/turn/requested",
+          itemId: null,
+          itemKind: null,
+          parentToolCallId: null,
+          p6rActorProviderId: author.p6rProviderId,
+          p6rActorSubject: author.p6rSubject,
+          p6rActorHandle: author.p6rHandle,
+          p6rActorDisplayName: author.p6rDisplayName,
+          p6rActorImageUrl: author.p6rImageUrl,
+          data: JSON.stringify({ p6rMentionedActors: [mentioned] }),
+        },
+      ]);
+
+      ensureCoreParticipantsProjection(db, [thread.id]);
+      expect(
+        listCoreParticipantProfilesByThreadIds(db, [thread.id]).get(thread.id),
+      ).toEqual([
+        {
+          p6rPrincipalKey: p6rPrincipalKeyForActorSnapshot(author),
+          p6rDisplayName: "Author",
+          p6rImageUrl: null,
+        },
+        {
+          p6rPrincipalKey: p6rPrincipalKeyForActorSnapshot(mentioned),
+          p6rDisplayName: "Florien Lazaro",
+          p6rImageUrl: "https://example.com/florien.jpg",
+        },
+      ]);
+    } finally {
+      db.$client.close();
+    }
+  });
 });
