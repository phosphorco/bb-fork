+  const unexpectedTables = hasTargetIdentityContextCompletionMarker
+    ? []
+    : laterRequirements.flatMap((requirement) =>
+        requirement.tables.filter((tableName) => tableExists(db, tableName)),
+      );
+  const unexpectedColumns = hasTargetIdentityContextCompletionMarker
+    ? []
