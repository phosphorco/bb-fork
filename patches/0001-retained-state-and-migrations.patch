+function readIdentityContextCanonicalTableContracts(): CanonicalTableContract[] {
+  if (identityContextCanonicalTableContracts !== undefined) {
+    return identityContextCanonicalTableContracts;
+  }
+  const migration = requireExpectedAppliedMigration(
+    readExpectedAppliedMigrations(resolveMigrationsFolder()),
+    "0145_identity_context_bridge",
+  );
+  const contracts = migration.sql
+    .map(parseCanonicalTableContract)
+    .filter((contract): contract is CanonicalTableContract => contract !== null);
+  if (contracts.length !== identityContextRequiredTables.length) {
+    throw new Error("Canonical 0145 identity/context table contract is incomplete.");
+  }
+  identityContextCanonicalTableContracts = contracts;
+  return contracts;
