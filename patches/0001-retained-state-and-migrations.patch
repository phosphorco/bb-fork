+function parseCanonicalTableContract(statement: string): CanonicalTableContract | null {
+  const match = /^CREATE TABLE IF NOT EXISTS `([^`]+)` \(([\s\S]+)\);?$/.exec(statement.trim());
+  if (!match) return null;
+  const [, tableName, body] = match;
+  if (!identityContextRequiredTables.includes(tableName as never)) return null;
+  const columns: Array<ExpectedColumn & { defaultValue: string | null }> = [];
+  let primaryKeyColumns: string[] = [];
+  for (const rawLine of body.split("\n")) {
+    const line = rawLine.trim().replace(/,$/, "");
+    const columnMatch = /^`([^`]+)`\s+(\w+)(.*)$/.exec(line);
+    if (columnMatch) {
+      const [, name, type, rest] = columnMatch;
+      columns.push({
+        defaultValue: /\bDEFAULT\s+((?:'[^']*')|\S+)/.exec(rest)?.[1] ?? null,
+        name,
+        type: type.toLowerCase(),
+        notNull: /\bNOT NULL\b/.test(rest),
+        primaryKey: /\bPRIMARY KEY\b/.test(rest),
+      });
+      if (/\bPRIMARY KEY\b/.test(rest)) primaryKeyColumns = [name];
+      continue;
+    }
+    const primaryKeyMatch = /^PRIMARY KEY\((.+)\)$/.exec(line);
+    if (primaryKeyMatch) {
+      primaryKeyColumns = [...primaryKeyMatch[1].matchAll(/`([^`]+)`/g)].map(
+        (entry) => entry[1],
+      );
+    }
+  }
+  return { columns, primaryKeyColumns, tableName };
+}
