+import { execFile } from "node:child_process";
+import { access, readdir, readFile, rename, rm } from "node:fs/promises";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { promisify } from "node:util";
+import type { DbConnection } from "@bb/db";
+import { sql } from "drizzle-orm";
+import { expect, it } from "vitest";
+
+const execFileAsync = promisify(execFile);
+const serverRoot = resolve(dirname(fileURLToPath(import.meta.url)), "../../..");
+
+it(
+  "ships P6R sidecar migrations and cold-starts built initDb without listeners",
+  async () => {
+    await execFileAsync("pnpm", ["run", "build"], { cwd: serverRoot });
+
+    const dist = join(serverRoot, "dist");
+    const sidecarDrizzle = join(dist, "services/p6r/drizzle");
+    await access(join(dist, "services/p6r/sidecar-migrate.js"));
+    await access(join(sidecarDrizzle, "meta/_journal.json"));
+    expect(
+      (await readdir(sidecarDrizzle)).filter((entry) => entry.endsWith(".sql")).sort(),
+    ).toEqual([
+      "0000_lying_energizer.sql",
+      "0001_aromatic_leopardon.sql",
+      "0002_pending_queued_dispatch.sql",
+      "0003_participant_watermarks.sql",
+    ]);
+    expect(
+      JSON.parse(
+        await readFile(join(sidecarDrizzle, "meta/_journal.json"), "utf8"),
+      ).entries.map((entry: { tag: string }) => entry.tag),
+    ).toEqual([
+      "0000_lying_energizer",
+      "0001_aromatic_leopardon",
+      "0002_pending_queued_dispatch",
+      "0003_participant_watermarks",
+    ]);
+    expect(await readFile(join(dist, "start-server.js"), "utf8")).toContain(
+      'from "./services/p6r/sidecar-migrate.js"',
+    );
+
+    const probePath = join(dist, "db-probe.js");
+    try {
+      await execFileAsync(
+        process.execPath,
+        [
+          "../../scripts/build-node-entry.mjs",
+          "src/db.ts",
+          "dist/db-probe.js",
+          "--external",
+          "./services/p6r/sidecar-migrate.js",
+        ],
+        { cwd: serverRoot },
+      );
+      const builtDb = (await import(
+        `${pathToFileURL(probePath).href}?built-sidecar-witness=1`,
+      )) as { initDb: (databasePath: string) => DbConnection };
+      const db = builtDb.initDb(":memory:");
+      try {
+        expect(
+          db.get<{ name: string }>(
+            sql`SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'p6r_metadata'`,
+          ),
+        ).toEqual({ name: "p6r_metadata" });
+      } finally {
+        db.$client.close();
+      }
+
+      const migrationPath = join(
+        sidecarDrizzle,
+        "0002_pending_queued_dispatch.sql",
+      );
+      const hiddenMigrationPath = `${migrationPath}.held`;
+      await rename(migrationPath, hiddenMigrationPath);
+      try {
+        const missingMigrationDb = (await import(
+          `${pathToFileURL(probePath).href}?missing-sidecar-migration=1`,
+        )) as { initDb: (databasePath: string) => DbConnection };
+        expect(() => missingMigrationDb.initDb(":memory:")).toThrow();
+      } finally {
+        await rename(hiddenMigrationPath, migrationPath);
+      }
+    } finally {
+      await Promise.all([
+        rm(probePath, { force: true }),
+        rm(`${probePath}.map`, { force: true }),
+      ]);
+    }
+  },
+  60_000,
+);
