+
+function assertIdentityAndContextMagnetSchema(db: DbConnection): void {
+  const canonicalTableContracts = readIdentityContextCanonicalTableContracts();
+  const missingTables = identityContextRequiredTables.filter(
+    (tableName) => !tableExists(db, tableName),
+  );
+  const missingColumns = identityContextBridgeColumns.filter(
+    ([tableName, columnName]) => !columnExists(db, tableName, columnName),
+  ).map(([tableName, columnName]) => `${tableName}.${columnName}`);
+  const bridgeColumnErrors = identityContextBridgeColumnContracts.flatMap(
+    ([tableName, columnName, type, notNull, defaultValue]) => {
+      const actual = getTableInfo(db, tableName).find(
+        (column) => column.name === columnName,
+      );
+      if (actual === undefined) return [];
+      return actual.type === type && actual.notNull === notNull && actual.defaultValue === defaultValue
+        ? []
+        : [`${tableName}.${columnName}: definition mismatch`];
+    },
+  );
+  const tableShapeErrors = canonicalTableContracts.flatMap((contract) => {
+    const actualColumns = getTableInfo(db, contract.tableName);
+    const actualNames = actualColumns.map((column) => column.name);
+    const expectedNames = contract.columns.map((column) => column.name);
+    const permittedLegacyOrder = permittedLegacyIdentityContextColumnOrders.get(
+      contract.tableName,
+    );
+    const matchesExpectedOrder = actualNames.every(
+      (name, index) => name === expectedNames[index],
+    );
+    const matchesPermittedLegacyOrder =
+      permittedLegacyOrder !== undefined &&
+      actualNames.every((name, index) => name === permittedLegacyOrder[index]);
+    if (
+      actualNames.length !== expectedNames.length ||
+      (!matchesExpectedOrder && !matchesPermittedLegacyOrder)
+    ) {
+      return [`${contract.tableName}: column set/order mismatch`];
+    }
+    const mismatchedColumn = contract.columns.find((expected) => {
+      const actual = actualColumns.find((column) => column.name === expected.name);
+      return actual === undefined || actual.type !== expected.type || actual.notNull !== expected.notNull || actual.defaultValue !== expected.defaultValue;
+    });
+    if (mismatchedColumn !== undefined) {
+      return [`${contract.tableName}.${mismatchedColumn.name}: column definition mismatch`];
+    }
+    const actualPrimaryKey = actualColumns
+      .filter((column) => column.primaryKey)
+      .sort((left, right) => left.primaryKeyOrder - right.primaryKeyOrder)
+      .map((column) => column.name);
+    return actualPrimaryKey.length === contract.primaryKeyColumns.length &&
+      actualPrimaryKey.every(
+        (column, index) => column === contract.primaryKeyColumns[index],
+      )
+      ? []
+      : [`${contract.tableName}: primary key mismatch`];
+  });
+  const indexErrors = identityContextRequiredIndexes.flatMap((expectedIndex) => {
+    const actualIndex = getIndexes(db, expectedIndex.tableName).find(
+      (index) => index.name === expectedIndex.name,
+    );
+    if (actualIndex === undefined) return [`${expectedIndex.name}: missing`];
+    const columns = getIndexColumnNames(db, expectedIndex.name);
+    return actualIndex.unique === expectedIndex.unique &&
+      columns.length === expectedIndex.columns.length &&
+      columns.every((column, index) => column === expectedIndex.columns[index])
+      ? []
+      : [`${expectedIndex.name}: definition mismatch`];
+  });
+  const primaryKeyErrors = identityContextPrimaryKeys.flatMap((expected) => {
+    const actual = getTableInfo(db, expected.tableName)
+      .filter((column) => column.primaryKey)
+      .sort((left, right) => left.primaryKeyOrder - right.primaryKeyOrder)
+      .map((column) => column.name);
+    return actual.length === expected.columns.length &&
+      actual.every((column, index) => column === expected.columns[index])
+      ? []
+      : [`${expected.tableName}: primary key mismatch`];
+  });
+  const foreignKeyErrors = identityContextRequiredForeignKeys.filter(
+    (expectedForeignKey) =>
+      !getForeignKeys(db, expectedForeignKey.childTable).some(
+        (foreignKey) =>
+          foreignKey.table === expectedForeignKey.table &&
+          foreignKey.from === expectedForeignKey.from &&
+          foreignKey.to === expectedForeignKey.to &&
+          foreignKey.onUpdate === expectedForeignKey.onUpdate &&
+          foreignKey.onDelete === expectedForeignKey.onDelete,
+      ),
+  ).map((foreignKey) => foreignKey.name);
+  if (
+    missingTables.length > 0 ||
+    missingColumns.length > 0 ||
+    bridgeColumnErrors.length > 0 ||
+    tableShapeErrors.length > 0 ||
+    primaryKeyErrors.length > 0 ||
+    indexErrors.length > 0 ||
+    foreignKeyErrors.length > 0
+  ) {
+    throw new Error(
+      [
+        "Identity/context schema bridge is incomplete or drifted.",
+        missingTables.length > 0 ? `Missing tables: ${missingTables.join(", ")}.` : null,
+        missingColumns.length > 0 ? `Missing columns: ${missingColumns.join(", ")}.` : null,
+        bridgeColumnErrors.length > 0 ? `Bridge columns: ${bridgeColumnErrors.join("; ")}.` : null,
+        tableShapeErrors.length > 0 ? `Table shapes: ${tableShapeErrors.join("; ")}.` : null,
+        primaryKeyErrors.length > 0 ? `Primary keys: ${primaryKeyErrors.join("; ")}.` : null,
+        indexErrors.length > 0 ? `Indexes: ${indexErrors.join("; ")}.` : null,
+        foreignKeyErrors.length > 0 ? `Foreign keys: ${foreignKeyErrors.join(", ")}.` : null,
+      ].filter((message): message is string => message !== null).join(" "),
+    );
+  }
+}
+
+function assertForeignKeyIntegrity(db: DbConnection): void {
+  const violations = db.$client.pragma("foreign_key_check");
+  if (!Array.isArray(violations)) {
+    throw new Error("Unexpected PRAGMA foreign_key_check result");
+  }
+  if (violations.length > 0) {
+    throw new Error(
+      `Foreign key integrity check failed after migration (${violations.length} violation(s)): ${violations
+        .slice(0, 10)
+        .map((violation) => JSON.stringify(violation))
+        .join(", ")}.`,
+    );
+  }
+}
+
+function completeIdentityAndContextMagnetSchemaBridge(
+  db: DbConnection,
+  options: MigrateOptions,
+): void {
+  const complete = db.$client.transaction(() => {
+    db.$client.exec(
+      `CREATE TABLE IF NOT EXISTS ${identityContextBridgeCompletionTable} (name text PRIMARY KEY NOT NULL, completed_at integer NOT NULL)`,
+    );
+    for (const [tableName, columnName, definition] of identityContextBridgeColumns) {
+      const hadColumn = tableExists(db, tableName) && columnExists(db, tableName, columnName);
+      addColumnWhenMissing(db, tableName, columnName, definition);
+      if (!hadColumn) options.identityContextBridgeTestHooks?.afterColumnAdded?.(`${tableName}.${columnName}`);
+    }
+    assertIdentityAndContextMagnetSchema(db);
+    assertForeignKeyIntegrity(db);
+    options.identityContextBridgeTestHooks?.beforeCompletionRecorded?.();
+    db.$client
+      .prepare<[string, number]>(
+        `INSERT OR REPLACE INTO ${identityContextBridgeCompletionTable} (name, completed_at) VALUES (?, ?)`,
+      )
+      .run(identityContextBridgeCompletionName, Date.now());
+  });
+  complete();
+  const completion = db.$client
+    .prepare<[string], { name: string }>(
+      `SELECT name FROM ${identityContextBridgeCompletionTable} WHERE name = ?`,
+    )
+    .get(identityContextBridgeCompletionName);
+  if (completion === undefined) {
+    throw new Error("Identity/context schema bridge completion was not recorded.");
+  }
+  assertIdentityAndContextMagnetSchema(db);
+}
