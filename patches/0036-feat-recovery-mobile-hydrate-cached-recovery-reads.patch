diff --git a/apps/recovery-mobile/src/persistence/use-recovery-namespace.ts b/apps/recovery-mobile/src/persistence/use-recovery-namespace.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f43bd0802a0be7a872d0fc746d1f2156ec97baeb
--- /dev/null
+++ b/apps/recovery-mobile/src/persistence/use-recovery-namespace.ts
@@ -0,0 +1,83 @@
+import { useEffect, useMemo, useState } from "react";
+import { useProfiles } from "@/app-shell";
+import { useSystemConfig } from "@/data/system";
+import type { ProfileIdentityContext } from "./contracts";
+import { getNativeRecoveryRepository } from "./native-repository";
+
+function buildNamespaceId(profileId: string, principalKey: string | null): string {
+  return JSON.stringify([profileId, principalKey ?? "read-only"]);
+}
+
+/**
+ * Last server-authored principal for the active profile. Cached context may be
+ * used offline; a live system response replaces it before any new persistence.
+ */
+export function useRecoveryNamespace(): ProfileIdentityContext | null {
+  const { activeProfile } = useProfiles();
+  const system = useSystemConfig({ enabled: Boolean(activeProfile) });
+  const [cached, setCached] = useState<ProfileIdentityContext | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    if (!activeProfile) return;
+    void getNativeRecoveryRepository()
+      .then((repository) =>
+        repository.getProfileIdentityContext(activeProfile.id),
+      )
+      .then((context) => {
+        if (cancelled) return;
+        setCached(
+          context?.serverUrl === activeProfile.serverUrl ? context : null,
+        );
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [activeProfile]);
+
+  const live = useMemo<ProfileIdentityContext | null>(() => {
+    if (!activeProfile || !system.data) return null;
+    const principal = system.data.p6rCurrentPrincipalProfile ?? null;
+    return {
+      profileId: activeProfile.id,
+      serverUrl: activeProfile.serverUrl,
+      namespaceId: buildNamespaceId(
+        activeProfile.id,
+        principal?.p6rPrincipalKey ?? null,
+      ),
+      principalKey: principal?.p6rPrincipalKey ?? null,
+      providerId: principal?.p6rProviderId ?? null,
+      subject: principal?.p6rSubject ?? null,
+      ownerState: principal ? "resolved" : "read-only",
+      updatedAt: system.dataUpdatedAt,
+    };
+  }, [activeProfile, system.data, system.dataUpdatedAt]);
+
+  useEffect(() => {
+    if (!live) return;
+    let cancelled = false;
+    void getNativeRecoveryRepository().then(async (repository) => {
+      if (cancelled) return;
+      await repository.ensureNamespace({
+        namespaceId: live.namespaceId,
+        serverProfileKey: live.profileId,
+        ownerKey: live.principalKey ?? "read-only",
+        ownerState: live.ownerState,
+      });
+      await repository.putProfileIdentityContext(live);
+      if (!cancelled) setCached(live);
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [live]);
+
+  const eligibleCached =
+    cached &&
+    activeProfile &&
+    cached.profileId === activeProfile.id &&
+    cached.serverUrl === activeProfile.serverUrl
+      ? cached
+      : null;
+  return live ?? eligibleCached;
+}
diff --git a/apps/recovery-mobile/src/persistence/use-recovery-query-persistence.ts b/apps/recovery-mobile/src/persistence/use-recovery-query-persistence.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c01946efd77a0a7d7765b8ad1d51ce4d58a4b7c4
--- /dev/null
+++ b/apps/recovery-mobile/src/persistence/use-recovery-query-persistence.ts
@@ -0,0 +1,75 @@
+import { useQueryClient, type QueryKey } from "@tanstack/react-query";
+import { useEffect } from "react";
+import type { ProfileIdentityContext } from "./contracts";
+import { getNativeRecoveryRepository } from "./native-repository";
+
+const lastScheduledPayloadByRecord = new Map<string, unknown>();
+
+export interface RecoveryQueryPersistenceArgs<T> {
+  namespace: ProfileIdentityContext | null;
+  recordKey: string;
+  queryKey: QueryKey;
+  data: T | undefined;
+}
+
+/** Hydrate one Query entry from SQLite, then mirror successful network data. */
+export function useRecoveryQueryPersistence<T>({
+  namespace,
+  recordKey,
+  queryKey,
+  data,
+}: RecoveryQueryPersistenceArgs<T>): void {
+  const queryClient = useQueryClient();
+  const queryKeyFingerprint = JSON.stringify(queryKey);
+
+  useEffect(() => {
+    if (!namespace) return;
+    const stableQueryKey = JSON.parse(queryKeyFingerprint) as QueryKey;
+    let cancelled = false;
+    void getNativeRecoveryRepository()
+      .then((repository) =>
+        repository.getObservedRecord<T>(namespace.namespaceId, recordKey),
+      )
+      .then((cached) => {
+        if (
+          cancelled ||
+          !cached ||
+          queryClient.getQueryData(stableQueryKey) !== undefined
+        ) {
+          return;
+        }
+        queryClient.setQueryData(stableQueryKey, cached.payload);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [namespace, queryClient, queryKeyFingerprint, recordKey]);
+
+  useEffect(() => {
+    if (!namespace || data === undefined) return;
+    const scheduledKey = JSON.stringify([namespace.namespaceId, recordKey]);
+    if (lastScheduledPayloadByRecord.get(scheduledKey) === data) return;
+    lastScheduledPayloadByRecord.set(scheduledKey, data);
+    void getNativeRecoveryRepository()
+      .then(async (repository) => {
+        await repository.ensureNamespace({
+          namespaceId: namespace.namespaceId,
+          serverProfileKey: namespace.profileId,
+          ownerKey: namespace.principalKey ?? "read-only",
+          ownerState: namespace.ownerState,
+        });
+        await repository.putObservedRecord({
+          namespaceId: namespace.namespaceId,
+          recordKey,
+          payload: data,
+          revision: 0,
+          updatedAt: Date.now(),
+        });
+      })
+      .catch(() => {
+        if (lastScheduledPayloadByRecord.get(scheduledKey) === data) {
+          lastScheduledPayloadByRecord.delete(scheduledKey);
+        }
+      });
+  }, [data, namespace, recordKey]);
+}
