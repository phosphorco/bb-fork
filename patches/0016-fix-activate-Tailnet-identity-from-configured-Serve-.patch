diff --git a/packages/config/src/tailnet-default.ts b/packages/config/src/tailnet-default.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a936199426984c963c32f5f4ce0d3580e1974c63
--- /dev/null
+++ b/packages/config/src/tailnet-default.ts
@@ -0,0 +1,27 @@
+import type { P6rIdentityBoundaryConfig } from "./server.js";
+
+export function defaultTailnetIdentityBoundary(
+  ownedHost: string | undefined,
+): P6rIdentityBoundaryConfig | null {
+  if (!ownedHost?.trim()) return null;
+  return {
+    configuration: {
+      version: 1,
+      boundaryId: "tailnet",
+      pluginId: "identity-boundaries",
+      ingressIds: ["tailscale-serve"],
+      credentials: [
+        { name: "tailnet-login", source: "header", field: "tailscale-user-login" },
+        { name: "tailnet-name", source: "header", field: "tailscale-user-name" },
+        { name: "tailnet-avatar", source: "header", field: "tailscale-user-profile-pic" },
+      ],
+      resolver: { timeoutMs: 5000 },
+    },
+    trustedIngresses: [{
+      id: "tailscale-serve",
+      kind: "owned-proxy",
+      remoteAddresses: ["127.0.0.1", "::1", "::ffff:127.0.0.1"],
+      authenticatedPeer: null,
+    }],
+  };
+}
diff --git a/packages/config/test/tailnet-default.test.ts b/packages/config/test/tailnet-default.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f826993fe84bc010a2dfa837b601c500b41fdfc0
--- /dev/null
+++ b/packages/config/test/tailnet-default.test.ts
@@ -0,0 +1,57 @@
+import { describe, expect, it } from "vitest";
+import { loadServerConfig } from "../src/server.js";
+
+function config(env: NodeJS.ProcessEnv = {}) {
+  return loadServerConfig({
+    env: { NODE_ENV: "production", BB_DATA_DIR: "/tmp/tailnet-config-test", ...env },
+  }).BB_P6R_IDENTITY_BOUNDARY;
+}
+
+describe("Tailnet deployment identity defaults", () => {
+  it("activates the provider from the existing owned Serve host without a second opt-in", () => {
+    expect(config({ BB_TAILNET_IDENTITY_OWNED_HOST: "bb.example.ts.net" }))
+      .toMatchObject({
+        configuration: {
+          pluginId: "identity-boundaries",
+          ingressIds: ["tailscale-serve"],
+          credentials: expect.arrayContaining([
+            { name: "tailnet-login", source: "header", field: "tailscale-user-login" },
+          ]),
+        },
+        trustedIngresses: [{
+          id: "tailscale-serve", kind: "owned-proxy", authenticatedPeer: null,
+          remoteAddresses: ["127.0.0.1", "::1", "::ffff:127.0.0.1"],
+        }],
+      });
+  });
+
+  it("does not invent a provider on deployments without an owned host", () => {
+    expect(config()).toBeNull();
+    expect(config({ BB_TAILNET_IDENTITY_OWNED_HOST: "  " })).toBeNull();
+  });
+
+  it("preserves explicit custom provider selection", () => {
+    const custom = {
+      configuration: {
+        version: 1, boundaryId: "custom", pluginId: "custom-idp",
+        ingressIds: ["gateway"], credentials: [],
+        resolver: { timeoutMs: 1000 },
+      },
+      trustedIngresses: [{
+        id: "gateway", kind: "owned-proxy", remoteAddresses: ["192.0.2.1"],
+        authenticatedPeer: null,
+      }],
+    };
+    expect(config({
+      BB_TAILNET_IDENTITY_OWNED_HOST: "bb.example.ts.net",
+      BB_P6R_IDENTITY_BOUNDARY: JSON.stringify(custom),
+    })).toEqual(custom);
+  });
+
+  it("reports invalid explicit configuration instead of silently replacing it", () => {
+    expect(() => config({
+      BB_TAILNET_IDENTITY_OWNED_HOST: "bb.example.ts.net",
+      BB_P6R_IDENTITY_BOUNDARY: "broken-json",
+    })).toThrow("must be valid JSON");
+  });
+});
