+          (payload) => payload.operationId !== winner.operationId,
+        )!;
+        expect(
+          await editThreadMessage(harness.deps, {
+            environment,
+            thread,
+            payload: winnerPayload,
+          }),
+        ).toEqual(winner);
+        await expect(
+          editThreadMessage(harness.deps, {
+            environment,
+            thread,
+            payload: loserPayload,
+          }),
+        ).rejects.toMatchObject({
+          body: { code: "message_admission_unresolved" },
+        });
+        expect(observed).toHaveLength(2);
+        expect(
+          getThread(harness.db, thread.id)?.messageAcceptanceSequence,
+        ).toBe(1);
+        expect(
+          f.service.lookupOperation({
+            namespace: winner.admission.operation.namespace,
+            operationId: loserPayload.operationId,
+          }),
+        ).toMatchObject({ status: "unresolved", acceptedOriginal: null });
+        expect(listEvents(harness.db, { threadId: thread.id })).toEqual(before);
+        expect(listQueuedThreadMessages(harness.db, thread.id)).toHaveLength(1);
+        expect(
+          listQueuedThreadCommands(harness, "thread.rewind.prepare", thread.id),
+        ).toEqual([]);
+        expect(
+          listQueuedThreadCommands(harness, "thread.stop", thread.id),
+        ).toEqual([]);
+      } finally {
+        release();
+        runtime.dispose();
+        f.plugin.retire();
+      }
+    });
+  });
