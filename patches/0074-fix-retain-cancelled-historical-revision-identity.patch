+  it("refuses a competing accepted revision without reallocating or replaying assessment", async () => {
+    await withTestHarness(async (harness) => {
+      const { environment, thread } = seedEditableThread(harness, {
+        includeSecondTurn: false,
+        threadStatus: "active",
+      });
+      let release!: () => void;
+      const gate = new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      let entered!: () => void;
+      const bothEntered = new Promise<void>((resolve) => {
+        entered = resolve;
+      });
+      const observed: SubmissionV1[] = [];
+      const f = await nativeEditPolicy(harness, thread, async (input) => {
+        observed.push(input.submission);
+        if (observed.length === 2) entered();
+        await gate;
+        return reduceObservations({
+          assessmentId: input.assessmentId,
+          complete: true,
+          observations: [
+            {
+              groupId: "race",
+              ruleId: "queue",
+              revision: "1",
+              status: "pass",
+              causes: [],
+              advice: [],
+              routing: "defer",
+              membership: "preserve",
+            },
+          ],
+        });
+      });
+      const runtime = configureNativeMessageAdmissionRuntime(harness.deps);
+      try {
+        const before = listEvents(harness.db, { threadId: thread.id });
+        const payloads = ["competing-B", "competing-C"].map((operationId) => ({
+          operationId,
+          expectedRequestSequence: 2,
+          input: text(operationId),
+        }));
+        const work = Promise.allSettled(
+          payloads.map((payload) =>
+            editThreadMessage(harness.deps, { environment, thread, payload }),
+          ),
+        );
+        await bothEntered;
+        expect(observed[0]!.original).toEqual(observed[1]!.original);
+        release();
+        const results = await work;
+        const winners = results.filter(
+          (result) => result.status === "fulfilled",
+        );
+        const losers = results.filter((result) => result.status === "rejected");
+        expect(winners).toHaveLength(1);
+        expect(losers).toHaveLength(1);
+        expect(losers[0]!.reason).toMatchObject({
+          code: "original-revision-conflict",
+        });
+        const winner = winners[0]!.value;
+        if (!("delivery" in winner))
+          throw new Error("Expected accepted winner");
+        const winnerPayload = payloads.find(
+          (payload) => payload.operationId === winner.operationId,
+        )!;
