+  | "unarchive-already-done"
+  | "empty-rollout-rename"
+  | "interrupt-not-started"
+  | "subscription-no-capacity"
+  | "subscription-ceilings-reached"
+  | "subscription-not-connected"
+  | "subscription-router-child-exited"
+  | "generic";
+
+export interface CodexAppServerErrorResponse {
+  readonly code?: number;
+  readonly message?: string;
+}
+
+interface RejectionRule {
+  readonly kind: Exclude<CodexAppServerRemoteErrorKind, "generic">;
+  readonly methods?: readonly string[];
+  readonly codes?: readonly number[];
+  readonly message?: RegExp;
+}
+
+const SESSION_START_METHODS = ["thread/start", "thread/resume", "thread/fork"];
+
+const ROUTER_REQUEST_CODES = [-32080, -32081];
+const ROUTER_CHILD_EXIT_CODE = -32084;
+const ROUTER_CODES: readonly number[] = [
+  ...ROUTER_REQUEST_CODES,
+  ROUTER_CHILD_EXIT_CODE,
+];
+
+const LIFECYCLE_RULES: readonly RejectionRule[] = [
+  {
+    kind: "archived-session",
+    methods: SESSION_START_METHODS,
+    message: /\b(?:session|thread)\s+\S+\s+is archived\b/i,
+  },
+  {
+    kind: "active-writer",
+    methods: ["thread/resume"],
+    message: /\bthread\s+\S+\s+already has an active writer\b/i,
+  },
+  {
+    kind: "archive-already-done",
+    methods: ["thread/archive"],
+    message: /\bno rollout found for thread id\b/i,
+  },
+  {
+    kind: "unarchive-already-done",
+    methods: ["thread/unarchive"],
+    message: /\bno archived rollout found for thread id\b/i,
+  },
+  {
+    kind: "empty-rollout-rename",
+    methods: ["thread/name/set"],
+    message: /\brollout at .+ is empty\b/i,
+  },
+  {
+    kind: "interrupt-not-started",
+    methods: ["turn/interrupt"],
+    codes: [-32600],
+    message: /^no active turn to interrupt$/,
+  },
+];
+
+const ROUTER_RULES: readonly RejectionRule[] = [
+  {
+    kind: "subscription-no-capacity",
+    codes: ROUTER_REQUEST_CODES,
+    message:
+      /^(?:\[subscription-router:no-capacity\] )?no enabled ChatGPT subscription has capacity\b/,
+  },
+  {
+    kind: "subscription-ceilings-reached",
+    codes: ROUTER_REQUEST_CODES,
+    message:
+      /^(?:\[subscription-router:bb-ceilings\] )?All subscriptions reached their configured ceilings\b/,
+  },
+  {
+    kind: "subscription-not-connected",
+    codes: ROUTER_REQUEST_CODES,
+    message: /^no enabled ChatGPT subscription is connected\b/,
+  },
+  {
+    kind: "subscription-router-child-exited",
+    codes: [ROUTER_CHILD_EXIT_CODE],
+  },
+];
+
+const REJECTION_PREFIX = "codex app-server rejected the request";
+
+const REJECTION_SUMMARIES: Record<CodexAppServerRemoteErrorKind, string | null> =
+  {
+    "active-writer": "another process is already writing this thread",
+    "archived-session": "the session is archived",
+    "archive-already-done": "the thread has no active rollout to archive",
+    "unarchive-already-done": "the thread has no archived rollout to restore",
+    "empty-rollout-rename": "the thread rollout is empty and cannot be renamed",
+    "interrupt-not-started": "there is no active turn to interrupt",
+    "subscription-no-capacity": "no enabled ChatGPT subscription has capacity",
+    "subscription-ceilings-reached":
+      "every ChatGPT subscription reached its configured usage ceiling",
+    "subscription-not-connected": "no enabled ChatGPT subscription is connected",
+    "subscription-router-child-exited":
+      "the Codex subscription router lost its app-server process",
+    generic: null,
+  };
+
+function ruleMatches(
+  rule: RejectionRule,
+  method: string,
+  response: CodexAppServerErrorResponse,
+): boolean {
+  if (rule.methods !== undefined && !rule.methods.includes(method)) {
+    return false;
+  }
+  if (
+    rule.codes !== undefined &&
+    (response.code === undefined || !rule.codes.includes(response.code))
+  ) {
+    return false;
+  }
+  return rule.message === undefined || rule.message.test(response.message ?? "");
+}
+
+export function classifyRemoteError(
+  method: string,
+  response: CodexAppServerErrorResponse,
+): CodexAppServerRemoteErrorKind {
+  const routerOwned =
+    response.code !== undefined && ROUTER_CODES.includes(response.code);
+  const rules = routerOwned ? ROUTER_RULES : LIFECYCLE_RULES;
+  return (
+    rules.find((rule) => ruleMatches(rule, method, response))?.kind ?? "generic"
+  );
+}
+
+export class CodexAppServerRemoteError extends Error {
+  readonly kind: CodexAppServerRemoteErrorKind;
+  readonly method: string;
+  readonly code: number | undefined;
+
+  constructor(method: string, response: CodexAppServerErrorResponse) {
+    const kind = classifyRemoteError(method, response);
+    const code = Number.isInteger(response.code) ? response.code : undefined;
+    const summary = REJECTION_SUMMARIES[kind];
+    const context = code === undefined ? method : `${method}, code ${code}`;
+    super(
+      `${REJECTION_PREFIX}${summary === null ? "" : `: ${summary}`} (${context})`,
+    );
+    this.name = "CodexAppServerRemoteError";
+    this.kind = kind;
+    this.method = method;
+    this.code = code;
+  }
+}
