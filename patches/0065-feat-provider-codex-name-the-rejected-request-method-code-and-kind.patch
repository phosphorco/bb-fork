+import { describe, expect, it } from "vitest";
+import {
+  CodexAppServerRemoteError,
+  classifyRemoteError,
+  type CodexAppServerRemoteErrorKind,
+} from "./remote-error.js";
+
+describe("classifyRemoteError", () => {
+  const cases: ReadonlyArray<
+    readonly [
+      method: string,
+      code: number,
+      message: string,
+      kind: CodexAppServerRemoteErrorKind,
+    ]
+  > = [
+    ["thread/start", -32603, "session archived-provider is archived; unarchive it and retry", "archived-session"],
+    ["thread/resume", -32603, "session archived-provider is archived; unarchive it and retry", "archived-session"],
+    ["thread/archive", -32603, "session archived-provider is archived; unarchive it and retry", "generic"],
+    ["thread/resume", -32603, "thread provider already has an active writer", "active-writer"],
+    ["thread/archive", -32603, "no rollout found for thread id provider", "archive-already-done"],
+    ["thread/unarchive", -32603, "no archived rollout found for thread id provider", "unarchive-already-done"],
+    ["thread/name/set", -32603, "rollout at /private/provider.jsonl is empty", "empty-rollout-rename"],
+    ["turn/interrupt", -32600, "no active turn to interrupt", "interrupt-not-started"],
+    ["turn/interrupt", -32603, "no active turn to interrupt", "generic"],
+    ["turn/start", -32080, "no enabled ChatGPT subscription has capacity", "subscription-no-capacity"],
+    ["turn/start", -32080, "[subscription-router:no-capacity] no enabled ChatGPT subscription has capacity. primary: weekly 78% >= 75%", "subscription-no-capacity"],
+    ["turn/start", -32081, "no enabled ChatGPT subscription has capacity", "subscription-no-capacity"],
+    ["thread/start", -32080, "[subscription-router:bb-ceilings] All subscriptions reached their configured ceilings. primary 78%", "subscription-ceilings-reached"],
+    ["thread/start", -32080, "no enabled ChatGPT subscription is connected", "subscription-not-connected"],
+    ["turn/start", -32084, "Codex app-server for primary exited unexpectedly", "subscription-router-child-exited"],
+    ["turn/start", -32080, "All subscriptions reached their configured ceilings", "subscription-ceilings-reached"],
+    ["turn/start", -32081, "All subscriptions reached their configured ceilings", "subscription-ceilings-reached"],
+    ["turn/start", -32603, "All subscriptions reached their configured ceilings", "generic"],
+    ["thread/archive", -32084, "Codex app-server for no rollout found for thread id provider exited unexpectedly", "subscription-router-child-exited"],
+    ["thread/resume", -32084, "thread provider already has an active writer", "subscription-router-child-exited"],
+    ["thread/archive", -32080, "no rollout found for thread id provider", "generic"],
+    ["thread/resume", -32081, "session provider is archived", "generic"],
+    ["thread/archive", -32603, "no rollout found for thread id provider", "archive-already-done"],
+    ["thread/unarchive", -32603, "no rollout found for thread id provider", "generic"],
+    ["thread/start", -32603, "thread provider already has an active writer", "generic"],
+    ["turn/start", -32080, "prefix: no enabled ChatGPT subscription has capacity", "generic"],
+    ["turn/start", -32603, "no enabled ChatGPT subscription has capacity", "generic"],
+    ["turn/start", -32603, "anything else the provider says", "generic"],
+  ];
+
+  it.each(cases)("%s %i %j -> %s", (method, code, message, kind) => {
+    expect(classifyRemoteError(method, { code, message })).toBe(kind);
+  });
+
+  it("classifies a response with no code or message as generic", () => {
+    expect(classifyRemoteError("turn/start", {})).toBe("generic");
+  });
+});
+
+describe("CodexAppServerRemoteError", () => {
+  it("names the method and JSON-RPC code of an unclassified rejection", () => {
+    const error = new CodexAppServerRemoteError("thread/start", {
+      code: -32603,
+      message: "private provider rejection secret=keep-out",
+    });
+    expect(error).toMatchObject({
+      kind: "generic",
+      method: "thread/start",
+      code: -32603,
+      message: "codex app-server rejected the request (thread/start, code -32603)",
+    });
+  });
+
+  it("explains a recognized rejection with its authored summary", () => {
+    const error = new CodexAppServerRemoteError("turn/start", {
+      code: -32080,
+      message:
+        "[subscription-router:no-capacity] no enabled ChatGPT subscription has capacity. primary: weekly 78% >= 75%",
+    });
+    expect(error.kind).toBe("subscription-no-capacity");
+    expect(error.message).toBe(
+      "codex app-server rejected the request: no enabled ChatGPT subscription has capacity (turn/start, code -32080)",
+    );
+  });
+
+  it("omits the code when the response has no integer code", () => {
+    const error = new CodexAppServerRemoteError("turn/start", {
+      code: Number.NaN,
+      message: "x",
+    });
+    expect(error.code).toBeUndefined();
+    expect(error.message).toBe(
+      "codex app-server rejected the request (turn/start)",
+    );
+  });
+
+  it.each([
+    ["turn/start", -32080, "[subscription-router:no-capacity] no enabled ChatGPT subscription has capacity. account alice@example.com secret=keep-out"],
+    ["turn/start", -32080, "All subscriptions reached their configured ceilings. alice@example.com secret=keep-out"],
+    ["turn/start", -32084, "Codex app-server for alice@example.com exited secret=keep-out"],
+    ["thread/archive", -32603, "no rollout found for thread id alice@example.com secret=keep-out"],
+    ["turn/start", -32603, "alice@example.com secret=keep-out"],
+  ])("never retains the provider's response body (%s %i)", (method, code, message) => {
+    const error = new CodexAppServerRemoteError(method, {
+      code,
+      message,
+      data: { detail: "alice@example.com secret=keep-out" },
+    } as { code: number; message: string });
+    const retained = JSON.stringify({
+      message: error.message,
+      stack: error.stack?.split("\n")[0],
+      own: Object.getOwnPropertyNames(error).map((name) =>
+        name === "stack" ? null : Reflect.get(error, name),
+      ),
+    });
+    expect(retained).not.toContain("alice@example.com");
+    expect(retained).not.toContain("keep-out");
+    expect(error.cause).toBeUndefined();
+  });
+});
