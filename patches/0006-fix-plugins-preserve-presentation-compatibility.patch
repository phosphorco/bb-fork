+++ b/apps/server/test/services/plugins/plugin-presentation-context.test.ts
@@ -0,0 +1,101 @@
+import { mkdir, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import {
+  createTestAppHarness,
+  type TestAppHarness,
+} from "../../helpers/test-app.js";
+
+const BASE = "http://127.0.0.1:3334";
+
+const PLUGIN_SOURCE = `
+  import type { BbPluginApi } from "@get-bb/plugin-sdk";
+
+  export default function plugin(bb: BbPluginApi) {
+    const routes = bb.experimental_p6rRoutes;
+    if (routes === undefined) throw new Error("selected host route paths missing");
+    bb.http.route("GET", "/presentation", (context, requestContext) => {
+      const origin = requestContext?.experimental_p6rExternalOrigin;
+      if (origin === undefined) {
+        throw new Error("selected host presentation context missing");
+      }
+      return context.json({
+        origin,
+        projectPath: routes.p6rThreadPath({
+          projectId: "project-1",
+          threadId: "thread-1",
+        }),
+        personalPath: routes.p6rThreadPath({
+          projectId: "proj_personal",
+          threadId: "thread-personal",
+        }),
+      });
+    });
+  }
+`;
+
+async function writePlugin(dir: string): Promise<string> {
+  const rootDir = join(dir, "bb-plugin-presentation-context");
+  await mkdir(rootDir, { recursive: true });
+  await writeFile(
+    join(rootDir, "package.json"),
+    JSON.stringify({
+      name: "bb-plugin-presentation-context",
+      version: "0.1.0",
+      bb: {
+        name: "Presentation context fixture",
+        description: "Exercises server-authored presentation facts.",
+        branding: { icon: "Link" },
+        server: "./server.ts",
+      },
+    }),
+  );
+  await writeFile(join(rootDir, "server.ts"), PLUGIN_SOURCE);
+  return rootDir;
+}
+
+describe("plugin HTTP presentation context", () => {
+  let harness: TestAppHarness;
+
+  beforeEach(async () => {
+    harness = await createTestAppHarness({ devAppPort: 5173 });
+    const entry = await harness.pluginService.installPath(
+      await writePlugin(join(harness.config.dataDir, "fixtures")),
+    );
+    expect(entry.status).toBe("running");
+  });
+
+  afterEach(async () => {
+    await harness.pluginService.stop();
+    await harness.cleanup();
+  });
+
+  it("uses configured BB_APP_URL origin and server-owned project-aware paths", async () => {
+    harness.config.appUrl = "https://public.example.test:8443/nested/path";
+
+    const response = await harness.app.request(
+      `${BASE}/api/v1/plugins/presentation-context/http/presentation`,
+    );
+
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({
+      origin: "https://public.example.test:8443",
+      projectPath: "/projects/project-1/threads/thread-1",
+      personalPath: "/threads/thread-personal",
+    });
+  });
+
+  it("falls back only to the direct request origin when BB_APP_URL is absent", async () => {
+    harness.config.appUrl = undefined;
+
+    const response = await harness.app.request(
+      "https://direct.example.test:9443/api/v1/plugins/presentation-context/http/presentation",
+      { headers: { "x-forwarded-host": "forged.example.test" } },
+    );
+
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({
+      origin: "https://direct.example.test:9443",
+    });
+  });
+});
