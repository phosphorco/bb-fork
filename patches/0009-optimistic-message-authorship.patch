@@ -0,0 +1,55 @@
+import type { P6rMessageAuthor } from "@bb/domain";
+import type { P6rIdentityResponse } from "@bb/server-contract";
+import type { QueryClient } from "@tanstack/react-query";
+import { sdk } from "@/lib/sdk";
+
+export const currentMessageAuthorQueryKey = [
+  "system",
+  "optimistic-message-author",
+] as const;
+
+export function getCurrentMessageAuthor(
+  queryClient: QueryClient,
+): P6rMessageAuthor | null {
+  return (
+    queryClient.getQueryData<P6rMessageAuthor | null>(
+      currentMessageAuthorQueryKey,
+    ) ?? null
+  );
+}
+
+export function createCurrentMessageAuthorOwner(
+  queryClient: QueryClient,
+  read: (signal: AbortSignal) => Promise<P6rIdentityResponse> = (signal) =>
+    sdk.system.p6rIdentity({ signal }),
+) {
+  return {
+    load: () =>
+      queryClient
+        .fetchQuery({
+          queryKey: currentMessageAuthorQueryKey,
+          gcTime: Infinity,
+          staleTime: Infinity,
+          retry: false,
+          queryFn: async ({ signal }) => {
+            const result = await read(signal);
+            if (signal.aborted || result.status !== "ready") return null;
+            if (
+              result.actor.presentation.avatarUrl &&
+              typeof Image !== "undefined"
+            ) {
+              const avatar = new Image();
+              avatar.referrerPolicy = "no-referrer";
+              avatar.src = result.actor.presentation.avatarUrl;
+            }
+            return result.actor;
+          },
+        })
+        .catch(() => undefined),
+    reset: () =>
+      queryClient.removeQueries({
+        queryKey: currentMessageAuthorQueryKey,
+        exact: true,
+      }),
+  };
+}
