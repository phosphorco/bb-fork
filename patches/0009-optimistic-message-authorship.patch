+import { QueryClient } from "@tanstack/react-query";
+import type { P6rIdentityResponse } from "@bb/server-contract";
+import { createDeferredPromise } from "@bb/test-helpers";
+import { afterEach, expect, it, vi } from "vitest";
+import {
+  createCurrentMessageAuthorOwner,
+  getCurrentMessageAuthor,
+} from "./current-message-author-owner";
+
+const clients: QueryClient[] = [];
+function client() {
+  const result = new QueryClient();
+  clients.push(result);
+  return result;
+}
+function identity(name: string): P6rIdentityResponse {
+  return {
+    status: "ready",
+    providerId: "test",
+    actor: {
+      evidence: "provider-verified",
+      identity: { kind: "person", key: name, issuer: "test", subject: name },
+      presentation: { displayName: name, handle: name, avatarUrl: null },
+    },
+  };
+}
+afterEach(() => clients.splice(0).forEach((value) => value.clear()));
+
+it("shares one read for a connection and does not fetch for each message", async () => {
+  const queryClient = client();
+  const response = createDeferredPromise<P6rIdentityResponse>();
+  const read = vi.fn(() => response.promise);
+  const owner = createCurrentMessageAuthorOwner(queryClient, read);
+  const first = owner.load(),
+    second = owner.load();
+  expect(getCurrentMessageAuthor(queryClient)).toBeNull();
+  response.resolve(identity("gus"));
+  await Promise.all([first, second]);
+  await owner.load();
+  expect(read).toHaveBeenCalledTimes(1);
+  expect(getCurrentMessageAuthor(queryClient)?.presentation.displayName).toBe(
+    "gus",
+  );
+});
+
+it("clears on disconnect and ignores an old response after another actor connects", async () => {
+  const queryClient = client();
+  const old = createDeferredPromise<P6rIdentityResponse>();
+  let oldSignal: AbortSignal | undefined;
+  const read = vi.fn(async (signal: AbortSignal) => {
+    if (!oldSignal) {
+      oldSignal = signal;
+      return old.promise;
+    }
+    return identity("cole");
+  });
+  const owner = createCurrentMessageAuthorOwner(queryClient, read);
+  const first = owner.load();
+  owner.reset();
+  expect(oldSignal?.aborted).toBe(true);
+  expect(getCurrentMessageAuthor(queryClient)).toBeNull();
+  await owner.load();
+  old.resolve(identity("gus"));
+  await first;
+  expect(getCurrentMessageAuthor(queryClient)?.presentation.displayName).toBe(
+    "cole",
+  );
+  expect(read).toHaveBeenCalledTimes(2);
+});
+
+it.each(["unconfigured", "unauthenticated", "unavailable"] as const)(
+  "does not keep a previous person when the next connection is %s",
+  async (status) => {
+    const queryClient = client();
+    const read = vi.fn(async (): Promise<P6rIdentityResponse> =>
+      identity("gus"),
+    );
+    const owner = createCurrentMessageAuthorOwner(queryClient, read);
+    await owner.load();
+    owner.reset();
+    read.mockResolvedValue(
+      status === "unconfigured" ? { status } : { status, message: "unknown" },
+    );
+    await owner.load();
+    expect(getCurrentMessageAuthor(queryClient)).toBeNull();
+  },
+);
+
+it("keeps identity failures optional and never publishes after teardown", async () => {
+  const queryClient = client();
+  const response = createDeferredPromise<P6rIdentityResponse>();
+  const owner = createCurrentMessageAuthorOwner(
+    queryClient,
+    () => response.promise,
+  );
+  const pending = owner.load();
+  owner.reset();
+  response.resolve(identity("gus"));
+  await pending;
+  expect(getCurrentMessageAuthor(queryClient)).toBeNull();
+  const failed = createCurrentMessageAuthorOwner(queryClient, async () => {
+    throw Error("offline");
+  });
+  await expect(failed.load()).resolves.toBeUndefined();
+  expect(getCurrentMessageAuthor(queryClient)).toBeNull();
+});
+
+it("does not share actors between application clients", async () => {
+  const left = client(),
+    right = client();
+  await createCurrentMessageAuthorOwner(left, async () =>
+    identity("gus"),
+  ).load();
+  await createCurrentMessageAuthorOwner(right, async () =>
+    identity("cole"),
+  ).load();
+  expect(getCurrentMessageAuthor(left)?.presentation.displayName).toBe("gus");
+  expect(getCurrentMessageAuthor(right)?.presentation.displayName).toBe("cole");
+});
