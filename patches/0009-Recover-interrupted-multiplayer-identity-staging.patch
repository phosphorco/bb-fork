     p6rMultiplayerAttributionColumns.some(
       (spec) =>
         tableExists(db, spec.table) &&
@@ -1464,6 +1559,8 @@ function p6rStageExistingMultiplayerSchema(
     return null;
   }
 
+  p6rRecoverInterruptedMultiplayerStaging(db);
