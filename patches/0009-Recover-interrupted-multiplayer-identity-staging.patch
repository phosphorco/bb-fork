       value TEXT NOT NULL
     ) WITHOUT ROWID;
@@ -1453,6 +1546,8 @@ function p6rStageExistingMultiplayerSchema(
     tableExists(db, "p6r_actors") ||
     tableExists(db, "p6r_collaborators") ||
     tableExists(db, "collaborators") ||
+    tableExists(db, P6R_STAGED_MULTIPLAYER_ACTORS) ||
