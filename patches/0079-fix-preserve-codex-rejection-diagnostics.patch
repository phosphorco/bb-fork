+      .mockImplementation(() => true);
+    const connection = createCodexAppServerConnection({
+      command: process.execPath,
+      args: [
+        "-e",
+        `process.stdin.once("data",()=>process.stdout.write(${JSON.stringify(JSON.stringify(response) + "\n")}));setInterval(()=>{},1000);`,
+      ],
+      cwd: process.cwd(),
+      env: { ...process.env, CODEX_POOL_AUTH_TOKEN: token },
+      recordThreadId: "thr_diagnostic",
+      onNotification() {},
+      onRequest() {},
+      onExit: exited.resolve,
+    });
