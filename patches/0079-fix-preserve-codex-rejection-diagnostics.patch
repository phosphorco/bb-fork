+        method: "thread/start",
+        resultSchema: z.unknown(),
+      });
+      await expect(request).rejects.toMatchObject({
+        remote: {
+          method: "thread/start",
+          code: -32602,
+          message: "invalid tool schema at /arguments; token=[REDACTED]",
+          data: {
+            argumentPath: "dynamicTools[2].inputSchema",
+            host: "bb-machine",
+            credential: "[REDACTED]",
+            unknownDiagnostic: "keep-this",
+          },
+        },
+      });
+      const output = stderr.mock.calls.map((call) => String(call[0])).join("");
+      expect(output).not.toContain(token);
+      expect(output).toContain('"threadId":"thr_diagnostic"');
+      expect(output).toContain('"requestId":1');
+      expect(output).toContain('"event":"codex.app-server.request-rejected"');
+    } finally {
+      await stopConnection(connection, exited.promise);
+      stderr.mockRestore();
+    }
