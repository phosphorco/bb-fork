+          const secretValues = [
+            "OPENAI_API_KEY",
+            "CODEX_API_KEY",
+            "CODEX_POOL_AUTH_TOKEN",
+            "BB_ACCOUNT_POOL_EXTERNAL_TOKEN",
+          ]
+            .map((name) => options.env[name])
+            .filter((value): value is string => Boolean(value));
+          let diagnostic = JSON.stringify(message.error);
+          for (const secret of secretValues) {
+            diagnostic = diagnostic
+              .split(JSON.stringify(secret).slice(1, -1))
+              .join("[REDACTED]");
+          }
+          const parsedError = z
+            .object({
+              code: z.number().optional(),
+              message: z.string().optional(),
+              data: z.unknown().optional(),
+            })
+            .passthrough()
+            .safeParse(JSON.parse(diagnostic));
+          if (!parsedError.success) {
+            request.reject(new CodexAppServerMalformedResponseError());
+            return;
+          }
+          const remote = { ...parsedError.data, method: request.method };
+          const error = new CodexAppServerRemoteError(
+            classifyRemoteError(request.method, message.error),
+            remote,
+          );
+          process.stderr.write(
+            JSON.stringify({
+              event: "codex.app-server.request-rejected",
+              threadId: options.recordThreadId,
+              requestId: numericId,
+              kind: error.kind,
+              ...remote,
+            }) + "\n",
           );
+          request.reject(error);
         } else {
           request.resolve(message.result);
         }
