+const STAGED_MULTIPLAYER_COLLABORATORS =
+  "_bb_multiplayer_collaborators_pending";
+
+const multiplayerAttributionColumns = [
+  { table: "events", column: "actor_handle" },
+  { table: "pending_interactions", column: "resolved_by_handle" },
+  { table: "queued_thread_messages", column: "actor_handle" },
+  { table: "threads", column: "created_by_handle" },
+] as const;
+
+interface StagedMultiplayerSchema {
+  collaborators: boolean;
+  columns: Array<(typeof multiplayerAttributionColumns)[number]>;
+}
+
+/**
+ * The original multiplayer branch shipped these additive fields as its own
+ * 0079 migration. Current upstream later claimed that migration number, so the
+ * rebased queue creates them at 0093. Preserve data from installs that already
+ * ran the branch-local 0079 (and from migration rewind tests) while Drizzle
+ * applies the canonical 0079–0093 sequence.
+ */
+function stageExistingMultiplayerSchema(
+  db: DbConnection,
+  migrationsFolder: string,
+): StagedMultiplayerSchema | null {
+  if (!tableExists(db, "__drizzle_migrations")) {
+    return null;
+  }
+
+  const migration = requireExpectedAppliedMigration(
+    readExpectedAppliedMigrations(migrationsFolder),
+    "0093_funny_zeigeist",
+  );
+  if (readAppliedMigrationCreatedAts(db).has(migration.createdAt)) {
+    return null;
+  }
+
+  const staged: StagedMultiplayerSchema = {
+    collaborators: false,
+    columns: [],
+  };
+  if (tableExists(db, "collaborators")) {
+    db.$client.exec(
+      `ALTER TABLE collaborators RENAME TO ${STAGED_MULTIPLAYER_COLLABORATORS}`,
+    );
+    staged.collaborators = true;
+  }
+
+  for (const spec of multiplayerAttributionColumns) {
+    if (
+      !tableExists(db, spec.table) ||
+      !columnExists(db, spec.table, spec.column)
+    ) {
+      continue;
+    }
+    const stagingTable = `_bb_multiplayer_${spec.table}_${spec.column}`;
+    db.$client.exec(`
+      CREATE TEMP TABLE ${stagingTable} AS
+        SELECT id, ${spec.column} AS value FROM ${spec.table};
+      ALTER TABLE ${spec.table} DROP COLUMN ${spec.column};
+    `);
+    staged.columns.push(spec);
+  }
+
+  return staged.collaborators || staged.columns.length > 0 ? staged : null;
+}
+
+function restoreStagedMultiplayerSchema(
+  db: DbConnection,
+  staged: StagedMultiplayerSchema,
+): void {
+  if (staged.collaborators) {
+    if (tableExists(db, "collaborators")) {
+      db.$client.exec(`
+        INSERT OR REPLACE INTO collaborators
+          SELECT * FROM ${STAGED_MULTIPLAYER_COLLABORATORS};
+        DROP TABLE ${STAGED_MULTIPLAYER_COLLABORATORS};
+      `);
+    } else {
+      db.$client.exec(
+        `ALTER TABLE ${STAGED_MULTIPLAYER_COLLABORATORS} RENAME TO collaborators`,
+      );
+    }
+  }
+
+  for (const spec of staged.columns) {
+    const stagingTable = `_bb_multiplayer_${spec.table}_${spec.column}`;
+    if (!columnExists(db, spec.table, spec.column)) {
+      db.$client.exec(
+        `ALTER TABLE ${spec.table} ADD COLUMN ${spec.column} text`,
+      );
+    }
+    db.$client.exec(`
+      UPDATE ${spec.table}
+      SET ${spec.column} = (
+        SELECT value FROM ${stagingTable}
+        WHERE ${stagingTable}.id = ${spec.table}.id
+      );
+      DROP TABLE ${stagingTable};
+    `);
+  }
+}
