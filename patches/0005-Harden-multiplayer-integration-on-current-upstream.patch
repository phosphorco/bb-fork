+      `ALTER TABLE collaborators RENAME TO ${STAGED_MULTIPLAYER_COLLABORATORS}`,
+    );
+    staged.collaborators = true;
+  }
+
+  for (const spec of multiplayerAttributionColumns) {
+    if (
+      !tableExists(db, spec.table) ||
+      !columnExists(db, spec.table, spec.column)
+    ) {
+      continue;
+    }
+    const stagingTable = `_bb_multiplayer_${spec.table}_${spec.column}`;
+    db.$client.exec(`
+      CREATE TEMP TABLE ${stagingTable} AS
+        SELECT id, ${spec.column} AS value FROM ${spec.table};
+      ALTER TABLE ${spec.table} DROP COLUMN ${spec.column};
