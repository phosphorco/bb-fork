+              onPress={saveName}
+              testID="project-name-save"
+            >
+              Save
+            </Button>
+          ) : null}
+        </View>
+        {project.gitRemoteUrl ? (
+          <Text variant="caption" numberOfLines={1}>
+            {project.gitRemoteUrl}
+          </Text>
+        ) : null}
+      </View>
+
+      {isPersonal ? (
+        <EmptyStatePanel>
