+import { formatPendingInteractionUserQuestionOptionLabel } from "@bb/core-ui";
+import {
+  isBackgroundAgentTaskType,
+  isBackgroundCommandTaskType,
+  isSettledWorkflowAgentState,
+  type BackgroundTaskStatus,
