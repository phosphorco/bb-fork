+    socket = null;
+    if (!current) return;
+    current.onopen = null;
+    current.onmessage = null;
+    current.onclose = null;
+    current.onerror = null;
+    try {
+      current.close(1000, "client closing");
+    } catch {
+      // Closing an already-closed socket is not an error we care about.
+    }
+  }
