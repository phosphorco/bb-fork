+  path,
+  name: path.split("/").at(-1) ?? path,
+  score,
+  positions: [0],
+});
+
+describe("buildFileSearchSections", () => {
+  it("keeps files only, ranks by score, caps per source and omits empty sources", () => {
+    const sections = buildFileSearchSections({
+      workspace: {
+        paths: [
+          entry("src", 9, "directory"),
+          entry("b.ts", 2),
