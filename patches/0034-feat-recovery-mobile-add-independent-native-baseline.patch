+- tapOn:
+    id: "BackButton"
+- extendedWaitUntil:
+    visible:
+      id: "settings-experiments"
+    timeout: 10000
+- tapOn:
+    id: "settings-experiments"
+- extendedWaitUntil:
+    visible:
+      id: "experiment-newOnboarding"
+      checked: true
+    timeout: 15000
+- runScript:
+    file: ../scripts/phase7-settings-assert.js
