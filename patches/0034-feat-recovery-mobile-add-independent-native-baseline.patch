+    expect(items.map((item) => [item.key, item.kind, item.depth])).toEqual([
+      ["u1", "conversation:user", 0],
+      ["c1", "work:command", 0],
+      ["a1", "conversation:assistant", 0],
+      ["s1", "system", 0],
