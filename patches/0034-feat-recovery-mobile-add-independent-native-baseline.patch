+  }
+  const isPersonal = project.kind === "personal";
+  const sourceHostIds = new Set(project.sources.map((source) => source.hostId));
+  const addableHosts = hosts.filter((host) => !sourceHostIds.has(host.id));
+
+  const saveName = () => {
