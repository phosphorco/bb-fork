+            const toastId = `thread-archived-${thread.id}`;
+            toast.success(
+              count > 1
+                ? `Archived ${getThreadDisplayTitle(thread)} and ${count - 1} child ${count - 1 === 1 ? "thread" : "threads"}`
+                : `Archived ${getThreadDisplayTitle(thread)}`,
+              {
