+      returnedPaths: new Set(["a"]),
+    });
+    expect(settled.loading.size).toBe(0);
+    expect(settled.errors.get("b")).toBe(MISSING_PATCH_MESSAGE);
+    expect(settled.errors.has("a")).toBe(false);
