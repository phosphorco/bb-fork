index 0000000000000000000000000000000000000000..4bd0281d4c57c163a970d67d8de71f268bce5412
--- /dev/null
+++ b/apps/recovery-mobile/src/lib/use-debounced-value.ts
@@ -0,0 +1,11 @@
+import { useEffect, useState } from "react";
+
+/** The latest `value` once it has held still for `delayMs`. */
+export function useDebouncedValue<T>(value: T, delayMs: number): T {
+  const [debounced, setDebounced] = useState(value);
+  useEffect(() => {
+    const timer = setTimeout(() => setDebounced(value), delayMs);
+    return () => clearTimeout(timer);
+  }, [value, delayMs]);
+  return debounced;
+}
