+    // A frame that just arrived is proof enough; do not add traffic to a
+    // socket that is visibly alive (a streaming turn delivers many per second).
+    if (Date.now() - lastServerActivityAt < REALTIME_PONG_TIMEOUT_MS) return;
+    send({ type: "ping" });
