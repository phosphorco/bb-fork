+- takeScreenshot: phase4b-actions-message-sheet
+- tapOn:
+    id: "action-sheet-copy"
+- extendedWaitUntil:
+    visible: "Copied"
+    timeout: 10000
+# Long-press again → Add to chat quotes the message into the composer.
