+  function clearReconnectTimer(): void {
+    if (reconnectTimer !== null) {
+      clearTimeout(reconnectTimer);
+      reconnectTimer = null;
+    }
+  }
+
+  function clearConnectionTimer(): void {
+    if (connectionTimer !== null) {
+      clearTimeout(connectionTimer);
+      connectionTimer = null;
+    }
+  }
