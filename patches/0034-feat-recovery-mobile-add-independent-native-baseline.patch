+          trailing="chevron"
+          disabled={!connected}
+          onPress={() => router.push(pluginsHref())}
+          testID="settings-plugins"
+        />
+        <ListRow
+          title="Skills"
+          subtitle="Library and registry"
+          leading="Toolbox"
+          trailing="chevron"
