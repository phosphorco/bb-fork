+  ProfilesProvider,
+  ServerPaletteSync,
+  ShareIntentHandler,
+  ThreadOpenSignalHandler,
+  useAppBoot,
+} from "@/app-shell";
+import { RootNavigator, RouteErrorBoundary } from "@/screens";
+import { ThemeProvider } from "@/theme";
+import { useAppFonts } from "@/theme/useAppFonts";
+import { SheetProvider, Toaster } from "@/ui";
