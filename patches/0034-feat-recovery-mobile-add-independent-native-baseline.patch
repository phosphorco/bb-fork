+`;
+
+const PROMPT_TEXT =
+  "Please look at @src/app.ts and @thread:abc123, then run /deploy on @backend project.";
+
+const PROMPT_MENTIONS: PromptTextMention[] = [
+  {
+    start: 15,
+    end: 26,
+    resource: {
+      kind: "path",
+      source: "workspace",
+      entryKind: "file",
+      path: "src/app.ts",
