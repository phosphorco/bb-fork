+    candidate.type === "client/turn/requested" && candidate.sequence > afterSequence,
+  );
+  expect(requests).toHaveLength(1);
+  const event = requests[0];
+  if (!event) throw new Error("expected client turn request event");
+  const rawRequest = JSON.parse(event.data);
+  expect(rawRequest.p6rMentionedTargets).toEqual([target]);
+  const request = turnRequestEventDataSchema.parse(rawRequest);
+  expect(request.p6rMentionedTargets).toEqual([target]);
