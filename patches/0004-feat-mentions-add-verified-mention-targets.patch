+  expect(harness.db.select().from(p6rContributions).where(eq(p6rContributions.threadId, threadId)).all()).toHaveLength(0);
+}
+
+it("persists a normalized mention target through create, live send, and queued dispatch without authorship", async () => {
+  const harness = await createTestAppHarness();
+  const { service, target, resolveMention } = await installVerifiedMentionResolver(harness);
+  try {
