+    const liveFixture = seedFixture(harness, 2);
+    const beforeLiveSend = Math.max(0, ...listEvents(harness.db, { threadId: liveFixture.thread.id }).map((event) => event.sequence));
+    await sendThreadMessage(harness.deps, { environment: liveFixture.environment, payload: { input, mode: "start", model: "gpt-5", permissionMode: "full", reasoningLevel: "medium", serviceTier: "default" }, thread: liveFixture.thread, trigger: "user" });
+    await waitForQueuedCommand(harness, (candidate) => candidate.command.type === "thread.start" && candidate.command.threadId === liveFixture.thread.id);
+    expectPersistedMentionTarget(harness, liveFixture.thread.id, beforeLiveSend, target);
