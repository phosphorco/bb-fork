+
+async function installVerifiedMentionResolver(harness: Awaited<ReturnType<typeof createTestAppHarness>>) {
+  const registry = createP6rProviderRegistry({ now: Date.now });
+  const prepared = await registry.prepare({
+    configuration: { version: 1, boundaryId: "mention-service-paths", pluginId: "verified-mentions", ingressIds: ["fixture"], credentials: [], resolver: { timeoutMs: 100, maxSessionAgeMs: 1_000 } },
+    generation: "mention-service-paths-generation", deadlineAt: Date.now() + 1_000,
+    provider: { issuers: ["fixture:people"], resolve: async () => ({ status: "not-applicable" }), lookup: async (subjects) => ({ ok: true, value: { revision: "directory-revision", records: subjects.map(({ issuer, subject }) => ({ issuer, subject, record: { issuer, subject, status: "current", presentation: { displayName: "Directory verified target", handle: "verified-target", avatarUrl: null } } })) } }) },
+  });
+  if (!prepared.ok) throw new Error("could not prepare mention target provider");
+  expect(registry.publish(prepared.value).ok).toBe(true);
+  const pluginRoot = join(harness.config.dataDir, "verified-mentions");
+  await mkdir(pluginRoot);
+  await writeFile(join(pluginRoot, "package.json"), JSON.stringify({ name: "bb-plugin-verified-mentions", version: "0.1.0", bb: { name: "Verified mentions", description: "Fixture", branding: { icon: "User" }, server: "./server.ts" } }));
+  await writeFile(join(pluginRoot, "server.ts"), `export default function (bb) { bb.ui.registerMentionProvider({ id: "person", label: "Person", search: () => [], resolve: () => ({ context: "verified mention context", experimental_target: { kind: "p6r-person", issuer: "fixture:people", subject: "42" } }) }); }`);
+  const service = createPluginService({ db: harness.db, dataDir: join(harness.config.dataDir, "verified-mention-service"), appVersion: "0.40.0", hub: harness.deps.hub, logger: testLogger, aiServices: createAiServiceRegistry(), telemetry: createNoopTelemetryService(), p6rProviderRegistry: registry });
+  const installed = await service.installPath(pluginRoot);
+  expect(installed.status, installed.statusDetail ?? "").toBe("running");
+  const resolveMention = vi.spyOn(service, "resolveMention");
+  setPluginAgentContributions(service);
+  const resolved = await service.resolveMention({ pluginId: "verified-mentions", itemId: "person:42" });
+  if (!resolved.ok || !resolved.target) throw new Error("expected a normalized mention target");
+  resolveMention.mockClear();
+  return { service, target: resolved.target, resolveMention };
+}
+
+function seedFixture(harness: Awaited<ReturnType<typeof createTestAppHarness>>, value: number, warm = false) {
+  const { host } = seedHostSession(harness.deps, { id: `host-mention-path-${value}` });
+  const { project } = seedProjectWithSource(harness.deps, { hostId: host.id, path: `/tmp/mention-path-${value}` });
+  const environment = seedEnvironment(harness.deps, { hostId: host.id, projectId: project.id, path: `/tmp/mention-path-${value}`, status: "ready" });
+  const thread = seedThread(harness.deps, { projectId: project.id, environmentId: environment.id, status: "idle" });
+  if (warm) seedThreadRuntimeState(harness.deps, { environmentId: environment.id, providerThreadId: `provider-mention-path-${value}`, threadId: thread.id });
+  return { environment, project, thread };
+}
+
+function expectPersistedMentionTarget(harness: Awaited<ReturnType<typeof createTestAppHarness>>, threadId: string, afterSequence: number, target: { identity: { key: string }; presentation: { displayName: string } }) {
