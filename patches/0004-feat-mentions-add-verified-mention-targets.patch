+    expect(resolveMention).toHaveBeenCalledWith({
+      pluginId: "verified-mentions",
+      itemId: "person:42",
+    });
+    await expect(resolveMention.mock.results[0]?.value).resolves.toMatchObject({
+      ok: true,
+      target,
+    });
