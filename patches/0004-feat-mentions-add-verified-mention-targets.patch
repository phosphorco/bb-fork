+    });
+    if (!prepared.ok) throw new Error("provider setup failed");
+    expect(registry.publish(prepared.value).ok).toBe(true);
+    return { registry, prepared: prepared.value };
+  }
+  it("uses only a current matching provider record and freezes its presentation", async () => {
+    const record = row();
+    const lookup = vi.fn(async () => ({
+      ok: true as const,
+      value: { records: [record], revision: "one" },
+    }));
+    const { registry } = await setup(lookup);
+    expect(
+      await registry.personForPlugin({ ...target, pluginId: "foreign" }),
+    ).toMatchObject({ ok: false });
+    expect(
+      await registry.personForPlugin({ ...target, issuer: "foreign" }),
+    ).toMatchObject({ ok: false });
+    expect(lookup).not.toHaveBeenCalled();
+    const result = await registry.personForPlugin(target);
+    expect(result).toMatchObject({
+      ok: true,
+      value: {
+        person: { issuer: target.issuer, subject: target.subject },
+        presentation: record.record.presentation,
+      },
+    });
+    if (!result.ok) throw new Error("expected target");
+    record.record.presentation.displayName = "changed later";
+    expect(result.value.presentation.displayName).toBe("Verified");
+    expect(Object.isFrozen(result.value.presentation)).toBe(true);
+  });
+  it("rejects mismatched inner identity, historical records, and duplicate rows", async () => {
+    for (const records of [
+      [{ ...row(), record: { ...row().record, subject: "other" } }],
+      [
+        {
+          ...row(),
+          record: { ...row().record, status: "historical" as const },
+        },
+      ],
+      [row(), row()],
+    ]) {
+      const { registry } = await setup(async () => ({
+        ok: true,
+        value: { records, revision: "one" },
+      }));
+      expect(await registry.personForPlugin(target)).toMatchObject({
+        ok: false,
+      });
+    }
+  });
+  it("settles a held lookup on retirement without accepting its late result", async () => {
+    let release!: (value: {
+      ok: true;
+      value: { records: ReturnType<typeof row>[]; revision: string };
+    }) => void;
+    const held = new Promise<{
+      ok: true;
+      value: { records: ReturnType<typeof row>[]; revision: string };
+    }>((resolve) => {
+      release = resolve;
+    });
+    const { registry, prepared } = await setup(async () => held);
+    const pending = registry.personForPlugin(target);
+    registry.retire(prepared);
+    expect(await pending).toMatchObject({ ok: false });
+    release({ ok: true, value: { records: [row()], revision: "late" } });
+  });
+  it("bounds a provider that ignores cancellation", async () => {
+    vi.useFakeTimers();
+    try {
+      const { registry } = await setup(async () => new Promise(() => {}));
+      const pending = registry.personForPlugin(target);
+      await vi.advanceTimersByTimeAsync(25);
+      expect(await pending).toMatchObject({
+        ok: false,
+        error: { code: "unavailable" },
+      });
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+});
