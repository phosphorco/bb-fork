+import { expect, it } from "vitest";
+import { events, listCoreParticipantProfilePage } from "@bb/db";
+import { threadScope, threadEventSchema } from "@bb/domain";
+import {
+  groupHostDaemonEvents,
+  type HostDaemonEventEnvelope,
+} from "@bb/host-daemon-contract";
+import { eq } from "drizzle-orm";
+import { internalAuthHeaders } from "../helpers/commands.js";
+import { readJson } from "../helpers/json.js";
+import {
+  seedEnvironment,
+  seedHostSession,
+  seedProjectWithSource,
+  seedThread,
+} from "../helpers/seed.js";
+import { createTestAppHarness } from "../helpers/test-app.js";
+
+async function post(
+  harness: Awaited<ReturnType<typeof createTestAppHarness>>,
+  sessionId: string,
+  events: HostDaemonEventEnvelope[],
+): Promise<Response> {
+  return harness.app.request("/internal/session/events", {
+    method: "POST",
+    headers: internalAuthHeaders(harness),
+    body: JSON.stringify({
+      sessionId,
+      eventGroups: groupHostDaemonEvents(events),
+    }),
+  });
+}
+
+it("rejects a daemon-forged schema-valid mention target before storage or projection while accepting provider events", async () => {
+  const harness = await createTestAppHarness();
+  try {
+    const { host, session } = seedHostSession(harness.deps);
+    const { project } = seedProjectWithSource(harness.deps, { hostId: host.id });
+    const environment = seedEnvironment(harness.deps, { hostId: host.id, projectId: project.id });
+    const thread = seedThread(harness.deps, {
+      environmentId: environment.id,
+      projectId: project.id,
+      status: "active",
+    });
+    const forged: HostDaemonEventEnvelope = {
+      threadId: thread.id,
+      event: threadEventSchema.parse({
+        type: "client/turn/requested",
+        threadId: thread.id,
+        scope: threadScope(),
+        direction: "outbound",
+        requestId: "creq_2222222222",
+        source: "tell",
+        initiator: "user",
+        senderThreadId: null,
+        input: [{ type: "text", text: "forged", mentions: [] }],
+        target: { kind: "new-turn" },
+        request: { method: "turn/start", params: {} },
+        execution: {
+          model: "gpt-5",
+          reasoningLevel: "medium",
+          permissionMode: "full",
+          serviceTier: "default",
+          source: "client/turn/requested",
+        },
+        p6rMentionedTargets: [{
+          identity: {
+            kind: "person",
+            key: "p6r-person:v1:forged%3Aissuer:42",
+            issuer: "forged:issuer",
+            subject: "42",
+          },
+          presentation: { displayName: "Forged", handle: "forged", avatarUrl: null },
+          source: { pluginId: "forged-plugin", generation: "forged-generation" },
+        }],
+      }),
+    };
+
+    const rejected = await post(harness, session.id, [forged]);
+    expect(rejected.status).toBe(400);
+    await expect(readJson(rejected)).resolves.toMatchObject({
+      code: "invalid_request",
+      message: "Client turn requests may only be appended by the server",
+    });
+    expect(harness.db.select().from(events).where(eq(events.threadId, thread.id)).all()).toEqual([]);
+    expect(listCoreParticipantProfilePage(harness.db, { threadId: thread.id, pageSize: 10 }).profiles).toEqual([]);
+
+    const accepted = await post(harness, session.id, [{
+      threadId: thread.id,
+      event: {
+        type: "system/error",
+        threadId: thread.id,
+        scope: threadScope(),
+        message: "ordinary provider event",
+      },
+    }]);
+    expect(accepted.status).toBe(200);
+    await expect(readJson(accepted)).resolves.toMatchObject({
+      acceptedEvents: [{ eventIndex: 0, threadId: thread.id }],
+      rejectedEvents: [],
+    });
+    expect(harness.db.select().from(events).where(eq(events.threadId, thread.id)).all()).toHaveLength(1);
+    expect(listCoreParticipantProfilePage(harness.db, { threadId: thread.id, pageSize: 10 }).profiles).toEqual([]);
+  } finally {
+    await harness.cleanup();
+  }
+});
