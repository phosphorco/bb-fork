+    const queued = seedQueuedMessage(harness.deps, { threadId: queuedFixture.thread.id, content: input });
+    const beforeQueuedDispatch = Math.max(0, ...listEvents(harness.db, { threadId: queuedFixture.thread.id }).map((event) => event.sequence));
+    await sendQueuedMessage(harness.deps, { claimPolicy: { kind: "automatic", isGroupEligible: () => true }, threadId: queuedFixture.thread.id, queuedMessageId: queued.id, mode: "auto" });
+    await waitForQueuedCommand(harness, (candidate) => candidate.command.type === "turn.submit" && candidate.command.threadId === queuedFixture.thread.id);
+    expectPersistedMentionTarget(harness, queuedFixture.thread.id, beforeQueuedDispatch, target);
+  } finally {
+    setPluginAgentContributions(undefined);
+    await service.stop();
+    await harness.cleanup();
+  }
+});
