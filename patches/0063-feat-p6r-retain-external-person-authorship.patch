@@ -0,0 +1,84 @@
+import { z } from "zod";
+import {
+  p6rMessageAuthorSchema,
+  promptInputSchema,
+  type P6rMessageAuthor,
+} from "@bb/domain";
+import type { P6rJson } from "./identity-protocol.js";
+
+const presentation = z
+  .object({
+    displayName: z.string().min(1).max(512),
+    handle: z.string().min(1).max(512).nullable(),
+    avatarUrl: z.string().min(1).max(2048).nullable(),
+  })
+  .strict();
+const person = z
+  .object({
+    identity: z
+      .object({
+        kind: z.literal("person"),
+        key: z.string().min(1).max(512),
+        issuer: z.string().min(1).max(512),
+        subject: z.string().min(1).max(512),
+      })
+      .strict(),
+    presentation,
+    evidence: z.literal("integration-asserted"),
+  })
+  .strict();
+export const p6rExternalContributionV1Schema = z
+  .object({
+    version: z.literal(1),
+    author: z
+      .object({ subject: z.string().min(1).max(256), presentation })
+      .strict(),
+    personAttribution: person.optional(),
+  })
+  .strict();
+export const p6rExternalContributionRequestV1Schema = z
+  .object({
+    contribution: p6rExternalContributionV1Schema,
+    input: z
+      .object({
+        operationId: z.string().min(1).max(256),
+        threadId: z.string().min(1).max(256),
+        mode: z.enum(["auto", "start", "steer-if-active", "queue-if-active"]),
+        input: z.array(promptInputSchema).min(1),
+      })
+      .strict(),
+  })
+  .strict();
+export type P6rExternalContributionV1 = z.infer<
+  typeof p6rExternalContributionV1Schema
+>;
+export type P6rExternalPersonSnapshotV1 = z.infer<typeof person>;
+
+export function readP6rExternalContribution(
+  value: unknown,
+): P6rExternalContributionV1 | null {
+  if (value === null || typeof value !== "object" || Array.isArray(value))
+    return null;
+  const parsed = p6rExternalContributionV1Schema.safeParse(
+    (value as Record<string, unknown>).externalContribution,
+  );
+  return parsed.success ? parsed.data : null;
+}
+
+export function p6rExternalContributionEvidence(
+  author: P6rJson,
+  contribution: P6rExternalContributionV1,
+): P6rJson {
+  if (author === null || typeof author !== "object" || Array.isArray(author))
+    throw new Error("External origin is required");
+  return { ...author, externalContribution: contribution };
+}
+
+export function p6rExternalContributionAuthor(
+  value: unknown,
+): P6rMessageAuthor | undefined {
+  const attribution = readP6rExternalContribution(value)?.personAttribution;
+  return attribution === undefined
+    ? undefined
+    : p6rMessageAuthorSchema.parse(attribution);
+}
