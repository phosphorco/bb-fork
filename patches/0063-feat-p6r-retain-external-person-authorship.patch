+    providerRegistry: createP6rProviderRegistry({ now: () => 100 }),
+    providerConfiguration: () => null,
+    native: { accept },
+    now: () => 100,
+    bindInvocation: () => ({
+      handler: () => {
+        throw new Error("Unused fixture binding");
+      },
+      registration: { generation: "g", status: "active", dispose() {} },
+    }),
+    activateBindings() {},
+    retireBindings() {},
+    trustedInvocation: async () => null,
+  });
+  const extension = root.forPluginGeneration(
+    "plugin",
+    "generation",
+    new AbortController().signal,
+  );
+  extension.activate();
+  return { root, extension, protocol: extension.protocol };
