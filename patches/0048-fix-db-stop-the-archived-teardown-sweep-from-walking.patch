From d045b6760ff2ae96ee7bc5827ae047d2eb29d9e6 Mon Sep 17 00:00:00 2001
From: bb-machine <ubuntu@bb-machine>
Date: Wed, 7 Oct 2026 19:26:46 +0200
Subject: [PATCH] fix(db): stop the archived-teardown sweep from walking the
 archive

listArchivedThreadsPendingTeardown ORs a status arm with a correlated
EXISTS over terminal_sessions. SQLite cannot use one index per arm across
that OR, so it range-scans every archived thread through
threads_archived_status_idx and runs the subquery per row. The periodic
sweep calls it on every 10 s tick. On a database with ~134k archived
threads that is ~150 ms per call for 22 result rows, about one second of
event-loop blocking per minute. An OR with an IN subquery instead of
EXISTS still walks the archive (~99 ms).

Run the two arms as separate queries with the same archived/deleted
guards: the status arm uses threads_active_maintenance_idx, and the
terminal arm resolves the non-terminal session thread ids first and then
looks them up by primary key. Merge the results with id dedupe. The row
shape and the selected set are unchanged; the query had no ORDER BY.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 packages/db/src/data/threads.ts               | 71 ++++++++++--------
 .../data/archived-thread-teardown.test.ts     | 73 +++++++++++++++++++
 2 files changed, 112 insertions(+), 32 deletions(-)

diff --git a/packages/db/src/data/threads.ts b/packages/db/src/data/threads.ts
index 16cb48ee1fe6403366854dae6dd2f0b7954785f7..c408d5720d9598799c256ac9716ffd042d45b4d5 100644
--- a/packages/db/src/data/threads.ts
+++ b/packages/db/src/data/threads.ts
@@ -5,7 +5,6 @@ import {
   count,
   desc,
   eq,
-  exists,
   getTableColumns,
   inArray,
   isNotNull,
@@ -1361,38 +1360,46 @@ export interface ArchivedTeardownThreadRow {
 export function listArchivedThreadsPendingTeardown(
   db: DbQueryConnection,
 ): ArchivedTeardownThreadRow[] {
-  return db
-    .select({
-      archivedAt: threads.archivedAt,
-      environmentId: threads.environmentId,
-      id: threads.id,
-      status: threads.status,
-    })
-    .from(threads)
-    .where(
-      and(
-        isNotNull(threads.archivedAt),
-        isNull(threads.deletedAt),
-        or(
-          inArray(threads.status, [...ARCHIVED_TEARDOWN_THREAD_STATUSES]),
-          exists(
-            db
-              .select({ id: terminalSessions.id })
-              .from(terminalSessions)
-              .where(
-                and(
-                  eq(terminalSessions.threadId, threads.id),
-                  inArray(
-                    terminalSessions.status,
-                    NON_TERMINAL_SESSION_STATUSES,
-                  ),
-                ),
-              ),
-          ),
+  const selectArchivedTeardownRows = (liveCondition: SQL) =>
+    db
+      .select({
+        archivedAt: threads.archivedAt,
+        environmentId: threads.environmentId,
+        id: threads.id,
+        status: threads.status,
+      })
+      .from(threads)
+      .where(
+        and(
+          isNotNull(threads.archivedAt),
+          isNull(threads.deletedAt),
+          liveCondition,
         ),
-      ),
-    )
-    .all();
+      )
+      .all();
+
+  const rows = selectArchivedTeardownRows(
+    inArray(threads.status, [...ARCHIVED_TEARDOWN_THREAD_STATUSES]),
+  );
+  const seen = new Set(rows.map((row) => row.id));
+  const withOpenTerminals = selectArchivedTeardownRows(
+    inArray(
+      threads.id,
+      db
+        .select({ threadId: terminalSessions.threadId })
+        .from(terminalSessions)
+        .where(
+          inArray(terminalSessions.status, NON_TERMINAL_SESSION_STATUSES),
+        ),
+    ),
+  );
+  for (const row of withOpenTerminals) {
+    if (!seen.has(row.id)) {
+      seen.add(row.id);
+      rows.push(row);
+    }
+  }
+  return rows;
 }
 
 export function listThreadsWithPendingInteractionState(
