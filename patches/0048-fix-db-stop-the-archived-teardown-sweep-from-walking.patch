+  it("returns a thread matching both the status and terminal arms once", () => {
+    const { db, environment, host, thread } = setup("active");
+    seedTerminal(db, {
+      environmentId: environment.id,
+      hostId: host.id,
+      status: "running",
+      threadId: thread.id,
+    });
+    seedTerminal(db, {
+      environmentId: environment.id,
+      hostId: host.id,
+      status: "disconnected",
+      threadId: thread.id,
+    });
+    archiveThread(db, noopNotifier, thread.id);
+
+    expect(listArchivedThreadsPendingTeardown(db)).toEqual([
+      expect.objectContaining({ id: thread.id, status: "active" }),
+    ]);
+  });
+
+  it("returns threads from each arm together", () => {
+    const { db, environment, host, thread: busy } = setup("stopping");
+    const terminalOnly = createThread(db, noopNotifier, {
+      projectId: environment.projectId,
+      providerId: "codex",
+      environmentId: environment.id,
+      status: "idle",
+    });
+    seedTerminal(db, {
+      environmentId: environment.id,
+      hostId: host.id,
+      status: "starting",
+      threadId: terminalOnly.id,
+    });
+    archiveThread(db, noopNotifier, busy.id);
+    archiveThread(db, noopNotifier, terminalOnly.id);
+
+    const rows = listArchivedThreadsPendingTeardown(db);
+    expect(rows.map((row) => row.id).sort()).toEqual(
+      [busy.id, terminalOnly.id].sort(),
+    );
+    expect(rows).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({ id: busy.id, status: "stopping" }),
+        expect.objectContaining({ id: terminalOnly.id, status: "idle" }),
+      ]),
+    );
+  });
+
+  it("applies the archived and deleted guards to the terminal arm", () => {
+    const { db, environment, host, thread } = setup("idle");
+    seedTerminal(db, {
+      environmentId: environment.id,
+      hostId: host.id,
+      status: "running",
+      threadId: thread.id,
+    });
+
+    expect(listArchivedThreadsPendingTeardown(db)).toEqual([]);
+
+    archiveThread(db, noopNotifier, thread.id);
+    expect(listArchivedThreadsPendingTeardown(db)).toMatchObject([
+      { id: thread.id },
+    ]);
+
+    db.update(threads)
+      .set({ deletedAt: Date.now() })
+      .where(eq(threads.id, thread.id))
+      .run();
+    expect(listArchivedThreadsPendingTeardown(db)).toEqual([]);
+  });
+
