+        ).toHaveLength(1);
+      } finally {
+        vi.unstubAllEnvs();
+        await releaseAllFaultBarriers(harness.config.dataDir, token);
+      }
+    });
+  }, 20_000);
+
+  it("holds persisted child output before the parent notice is queued", async () => {
+    await withTestHarness(async (harness) => {
