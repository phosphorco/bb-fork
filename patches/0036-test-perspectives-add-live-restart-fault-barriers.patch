+        expect(listQueuedThreadMessages(harness.db, parent.id)).toHaveLength(0);
+        expect(requestEvents(harness.db, parent.id)).toHaveLength(
+          parentRequestsBefore,
+        );
+        expect(observation.context).toMatchObject({
+          childThreadIds: [child.id],
+          parentThreadId: parent.id,
+          turnStatuses: ["completed"],
+        });
+
+        await releaseFaultBarrier(harness.config.dataDir, token, observation);
+        const deadline = Date.now() + 5_000;
+        while (
+          Date.now() < deadline &&
+          requestEvents(harness.db, parent.id).length === parentRequestsBefore
+        ) {
+          await new Promise((resolveDelay) => setTimeout(resolveDelay, 10));
