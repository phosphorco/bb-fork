diff --git a/apps/server/src/testing/test-fault-barriers.ts b/apps/server/src/testing/test-fault-barriers.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d806145e2458411b36421d24d8f29961a561c699
--- /dev/null
+++ b/apps/server/src/testing/test-fault-barriers.ts
@@ -0,0 +1,142 @@
+import { randomUUID } from "node:crypto";
+import { existsSync, realpathSync, statSync } from "node:fs";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { isAbsolute, join, relative, sep } from "node:path";
+
+export const TEST_FAULT_BARRIER_TOKEN_ENV = "BB_TEST_FAULT_BARRIER_TOKEN";
+export const TEST_FAULT_BARRIER_POINT_ENV = "BB_TEST_FAULT_BARRIER_POINT";
+export const TEST_FAULT_BARRIER_DATA_DIR_TOKEN_MARKER_FILE =
+  ".bb-test-fault-barrier-token";
+export const TEST_FAULT_BARRIER_CONTROL_DIRECTORY = ".bb-test-fault-barriers";
+
+export const testFaultBarrierPoints = {
+  childOutputBeforeParentNotice: "child-output-before-parent-notice",
+  queueClaimBeforeRequest: "queue-claim-before-request",
+  queueRequestCommitBeforeCommand: "queue-request-commit-before-command",
+} as const;
+
+export type TestFaultBarrierPoint =
+  (typeof testFaultBarrierPoints)[keyof typeof testFaultBarrierPoints];
+
+export type TestFaultBarrierContext = Readonly<
+  Record<string, string | number | readonly string[]>
+>;
+
+interface SelectedTestFaultBarrierWaitArgs {
+  context: TestFaultBarrierContext;
+  dataDir: string;
+  point: TestFaultBarrierPoint;
+}
+
+interface TestFaultBarrierObservation {
+  context: TestFaultBarrierContext;
+  invocationId: string;
+  observedAt: string;
+  pid: number;
+  point: TestFaultBarrierPoint;
+}
+
+export function waitAtSelectedTestFaultBarrier(
+  args: SelectedTestFaultBarrierWaitArgs,
+): Promise<void> | undefined {
+  const token = process.env[TEST_FAULT_BARRIER_TOKEN_ENV];
+  const selectedPoint = process.env[TEST_FAULT_BARRIER_POINT_ENV];
+  if (token === undefined && selectedPoint === undefined) return undefined;
+  if (token === undefined || selectedPoint === undefined) {
+    throw new Error(
+      `${TEST_FAULT_BARRIER_TOKEN_ENV} and ${TEST_FAULT_BARRIER_POINT_ENV} must be set together`,
+    );
+  }
+  if (!/^[a-f0-9]{64}$/.test(token)) {
+    throw new Error(
+      `${TEST_FAULT_BARRIER_TOKEN_ENV} must be 64 lowercase hex characters`,
+    );
+  }
+  if (
+    !Object.values(testFaultBarrierPoints).includes(
+      selectedPoint as TestFaultBarrierPoint,
+    )
+  ) {
+    throw new Error(
+      `${TEST_FAULT_BARRIER_POINT_ENV} is not a supported test barrier point`,
+    );
+  }
+  if (selectedPoint !== args.point) return undefined;
+  return waitForTestFaultBarrierRelease({ ...args, token });
+}
+
+export function testFaultBarrierControlDirectory(
+  dataDir: string,
+  token: string,
+  point: TestFaultBarrierPoint,
+): string {
+  return join(dataDir, TEST_FAULT_BARRIER_CONTROL_DIRECTORY, token, point);
+}
+
+export function testFaultBarrierWaitingFilePath(
+  directory: string,
+  invocationId: string,
+): string {
+  return join(directory, `waiting.${invocationId}.json`);
+}
+
+export function testFaultBarrierReleaseFilePath(
+  directory: string,
+  invocationId: string,
+): string {
+  return join(directory, `release.${invocationId}`);
+}
+
+async function waitForTestFaultBarrierRelease(
+  args: SelectedTestFaultBarrierWaitArgs & { token: string },
+): Promise<void> {
+  const dataDir = realpathSync(args.dataDir);
+  const dataDirRelativeToTmp = relative("/tmp", dataDir);
+  if (
+    dataDirRelativeToTmp === "" ||
+    dataDirRelativeToTmp === ".." ||
+    dataDirRelativeToTmp.startsWith(`..${sep}`) ||
+    isAbsolute(dataDirRelativeToTmp)
+  ) {
+    throw new Error("Test fault barriers require a data directory below /tmp");
+  }
+  if ((statSync(dataDir).mode & 0o077) !== 0) {
+    throw new Error(
+      "Test fault barrier data directory must be private to its owner",
+    );
+  }
+  const marker = await readFile(
+    join(dataDir, TEST_FAULT_BARRIER_DATA_DIR_TOKEN_MARKER_FILE),
+    "utf8",
+  );
+  if (marker.trim() !== args.token) {
+    throw new Error(
+      "Test fault barrier token does not match the data directory marker",
+    );
+  }
+
+  const directory = testFaultBarrierControlDirectory(
+    dataDir,
+    args.token,
+    args.point,
+  );
+  const invocationId = randomUUID();
+  const observation: TestFaultBarrierObservation = {
+    context: args.context,
+    invocationId,
+    observedAt: new Date().toISOString(),
+    pid: process.pid,
+    point: args.point,
+  };
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  await writeFile(
+    testFaultBarrierWaitingFilePath(directory, invocationId),
+    `${JSON.stringify(observation)}\n`,
+    { flag: "wx", mode: 0o600 },
+  );
+
+  const releasePath = testFaultBarrierReleaseFilePath(directory, invocationId);
+  while (!existsSync(releasePath)) {
+    await new Promise((resolveDelay) => setTimeout(resolveDelay, 20));
+  }
+}
diff --git a/apps/server/test/services/threads/test-fault-barriers.test.ts b/apps/server/test/services/threads/test-fault-barriers.test.ts
