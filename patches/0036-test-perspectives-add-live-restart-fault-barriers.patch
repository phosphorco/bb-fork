+import { randomBytes } from "node:crypto";
+import { mkdtemp, readFile, readdir, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  getQueuedThreadMessage,
+  listEvents,
+  listQueuedThreadMessages,
+  type DbConnection,
+} from "@bb/db";
+import { turnScope } from "@bb/domain";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { getLastThreadOutput } from "../../../src/services/threads/thread-data.js";
+import { queueChildThreadTurnNotificationBestEffort } from "../../../src/services/threads/child-thread-notifications.js";
+import { sendQueuedMessage } from "../../../src/services/threads/queued-messages.js";
+import {
+  waitAtSelectedTestFaultBarrier,
+  TEST_FAULT_BARRIER_POINT_ENV,
+  TEST_FAULT_BARRIER_TOKEN_ENV,
+  TEST_FAULT_BARRIER_DATA_DIR_TOKEN_MARKER_FILE,
+  testFaultBarrierControlDirectory,
+  testFaultBarrierWaitingFilePath,
+  testFaultBarrierPoints,
+  testFaultBarrierReleaseFilePath,
+  type TestFaultBarrierPoint,
+} from "../../../src/testing/test-fault-barriers.js";
+import {
+  seedEnvironment,
+  seedHostSession,
+  seedProjectWithSource,
+  seedQueuedMessage,
+  seedStoredEvent,
+  seedThread,
+  seedThreadRuntimeState,
+} from "../../helpers/seed.js";
+import { listQueuedThreadCommands } from "../../helpers/commands.js";
+import { withTestHarness } from "../../helpers/test-app.js";
+import { textInput } from "../../helpers/prompt-input.js";
+
+interface FaultBarrierObservation {
+  context: Record<string, unknown>;
+  invocationId: string;
+  observedAt: string;
+  pid: number;
+  point: TestFaultBarrierPoint;
+}
+
+async function armFaultBarrier(
+  dataDir: string,
+  point: TestFaultBarrierPoint,
+): Promise<string> {
+  const token = randomBytes(32).toString("hex");
+  await writeFile(
+    join(dataDir, TEST_FAULT_BARRIER_DATA_DIR_TOKEN_MARKER_FILE),
+    `${token}\n`,
+    { mode: 0o600 },
+  );
+  vi.stubEnv(TEST_FAULT_BARRIER_TOKEN_ENV, token);
+  vi.stubEnv(TEST_FAULT_BARRIER_POINT_ENV, point);
+  return token;
+}
+
+async function waitForFaultBarrier(
+  dataDir: string,
+  token: string,
+  point: TestFaultBarrierPoint,
+  timeoutMs = 5_000,
+): Promise<FaultBarrierObservation> {
+  const directory = testFaultBarrierControlDirectory(dataDir, token, point);
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    try {
+      const names = await readdir(directory);
+      const waitingFile = names.find(
+        (name) => name.startsWith("waiting.") && name.endsWith(".json"),
+      );
+      if (waitingFile) {
+        return JSON.parse(
+          await readFile(
+            testFaultBarrierWaitingFilePath(
+              directory,
+              waitingFile.slice("waiting.".length, -".json".length),
+            ),
+            "utf8",
+          ),
+        ) as FaultBarrierObservation;
+      }
+    } catch (error) {
+      if (
+        !(error instanceof Error && "code" in error && error.code === "ENOENT")
+      ) {
+        throw error;
+      }
+    }
+    await new Promise((resolveDelay) => setTimeout(resolveDelay, 10));
+  }
+  throw new Error(`Timed out waiting for test fault barrier ${point}`);
+}
+
+async function releaseFaultBarrier(
+  dataDir: string,
+  token: string,
+  observation: FaultBarrierObservation,
+): Promise<void> {
+  const directory = testFaultBarrierControlDirectory(
+    dataDir,
+    token,
+    observation.point,
+  );
+  await writeFile(
+    testFaultBarrierReleaseFilePath(directory, observation.invocationId),
+    "released\n",
+    { flag: "a", mode: 0o600 },
+  );
+}
+
+async function releaseAllFaultBarriers(
+  dataDir: string,
+  token: string,
+): Promise<void> {
+  for (const point of Object.values(testFaultBarrierPoints)) {
+    const directory = testFaultBarrierControlDirectory(dataDir, token, point);
+    try {
+      const names = await readdir(directory);
+      for (const name of names) {
+        if (!name.startsWith("waiting.") || !name.endsWith(".json")) continue;
+        const invocationId = name.slice("waiting.".length, -".json".length);
+        await writeFile(
+          testFaultBarrierReleaseFilePath(directory, invocationId),
+          "released\n",
+          { flag: "a", mode: 0o600 },
+        );
+      }
+    } catch (error) {
+      if (
+        !(error instanceof Error && "code" in error && error.code === "ENOENT")
+      ) {
+        throw error;
+      }
+    }
+  }
+}
+
+function requestEvents(db: DbConnection, threadId: string) {
+  return listEvents(db, { threadId }).filter(
+    (event) => event.type === "client/turn/requested",
+  );
+}
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+});
+
+describe("test-only BB fault barriers", () => {
+  it("is a synchronous no-op when the opt-in variables are absent", () => {
+    expect(
+      waitAtSelectedTestFaultBarrier({
+        context: {},
+        dataDir: "/not-a-real-data-directory",
+        point: testFaultBarrierPoints.queueClaimBeforeRequest,
+      }),
+    ).toBeUndefined();
+  });
+
+  it("observes an armed point and resumes only after its token-bound release", async () => {
+    const dataDir = await mkdtemp(join(tmpdir(), "bb-test-fault-barrier-"));
+    let token: string | undefined;
+    try {
+      token = await armFaultBarrier(
+        dataDir,
+        testFaultBarrierPoints.queueClaimBeforeRequest,
+      );
+      const pending = waitAtSelectedTestFaultBarrier({
+        context: { threadId: "thr_test", queuedMessageIds: ["qmsg_test"] },
+        dataDir,
+        point: testFaultBarrierPoints.queueClaimBeforeRequest,
+      });
+      expect(pending).toBeDefined();
+      const observation = await waitForFaultBarrier(
+        dataDir,
+        token,
+        testFaultBarrierPoints.queueClaimBeforeRequest,
+      );
+      expect(observation.context).toEqual({
+        threadId: "thr_test",
+        queuedMessageIds: ["qmsg_test"],
+      });
+      let resumed = false;
+      const completion = pending!.then(() => {
+        resumed = true;
+      });
+      await new Promise((resolveDelay) => setTimeout(resolveDelay, 25));
+      expect(resumed).toBe(false);
+      await releaseFaultBarrier(dataDir, token, observation);
+      await completion;
+      expect(resumed).toBe(true);
+    } finally {
+      if (token) {
+        vi.unstubAllEnvs();
+        await releaseAllFaultBarriers(dataDir, token);
+      }
+      await rm(dataDir, { recursive: true, force: true });
+    }
+  });
+
+  it("holds queue claim and committed request-event cuts before dispatch", async () => {
+    await withTestHarness(async (harness) => {
+      const token = await armFaultBarrier(
+        harness.config.dataDir,
+        testFaultBarrierPoints.queueClaimBeforeRequest,
+      );
+      const { host } = seedHostSession(harness.deps, {
+        id: "host-test-fault-barrier-queue",
+      });
+      const { project } = seedProjectWithSource(harness.deps, {
+        hostId: host.id,
+        path: "/tmp/test-fault-barrier-queue",
+      });
+      const environment = seedEnvironment(harness.deps, {
+        hostId: host.id,
+        projectId: project.id,
+        path: "/tmp/test-fault-barrier-queue",
+      });
+      const thread = seedThread(harness.deps, {
+        environmentId: environment.id,
+        projectId: project.id,
+        status: "idle",
+      });
+      seedThreadRuntimeState(harness.deps, {
+        environmentId: environment.id,
+        providerThreadId: "provider-test-fault-barrier-queue",
+        threadId: thread.id,
+      });
+      const requestCountBefore = requestEvents(harness.db, thread.id).length;
+      const queued = seedQueuedMessage(harness.deps, {
+        content: textInput("fault barrier queue probe"),
+        threadId: thread.id,
+      });
+
+      try {
+        const dispatch = sendQueuedMessage(harness.deps, {
+          claimPolicy: { kind: "explicit-send" },
+          mode: "auto",
+          queuedMessageId: queued.id,
+          threadId: thread.id,
+        });
+        const claimObservation = await waitForFaultBarrier(
+          harness.config.dataDir,
+          token,
+          testFaultBarrierPoints.queueClaimBeforeRequest,
+        );
+        const claimedRow = getQueuedThreadMessage(harness.db, queued.id);
+        expect(claimedRow?.claimedAt).toEqual(expect.any(Number));
+        expect(requestEvents(harness.db, thread.id)).toHaveLength(
+          requestCountBefore,
+        );
+
+        vi.stubEnv(
+          TEST_FAULT_BARRIER_POINT_ENV,
+          testFaultBarrierPoints.queueRequestCommitBeforeCommand,
+        );
+        await releaseFaultBarrier(
+          harness.config.dataDir,
+          token,
+          claimObservation,
+        );
+        const commitObservation = await waitForFaultBarrier(
+          harness.config.dataDir,
+          token,
+          testFaultBarrierPoints.queueRequestCommitBeforeCommand,
+        );
+        const requests = requestEvents(harness.db, thread.id);
