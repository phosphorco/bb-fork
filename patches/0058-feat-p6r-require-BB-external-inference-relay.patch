+import { describe, expect, it, vi } from "vitest";
+import {
+  externalPoolSelected,
+  requiredExternalRoute,
+  externalRelay,
+} from "./required-external-pool.js";
+const env = {
+  BB_ACCOUNT_POOL_EXTERNAL_REQUIRED: "1",
+  BB_ACCOUNT_POOL_EXTERNAL_URL: "https://inference.example.ts.net",
+  BB_ACCOUNT_POOL_EXTERNAL_TOKEN: "synthetic-key",
+};
+describe("required external inference", () => {
+  it("keeps partial and invalid selection required", () => {
+    expect(externalPoolSelected({})).toBe(false);
+    for (const value of ["", "0", "1"]) {
+      const partial = { BB_ACCOUNT_POOL_EXTERNAL_REQUIRED: value };
+      expect(externalPoolSelected(partial)).toBe(true);
+      expect(() => requiredExternalRoute(partial)).toThrow(/unavailable/);
+    }
+  });
+  it.each([
+    "http://inference.example.ts.net",
+    "https://provider.example",
+    "https://inference.example.ts.net/v1",
+    "https://user:pass@inference.example.ts.net",
