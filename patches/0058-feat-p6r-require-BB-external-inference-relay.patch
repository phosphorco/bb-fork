+import { describe, expect, it, vi } from "vitest";
+import {
+  externalPoolSelected,
+  requiredExternalRoute,
+  externalRelay,
+} from "./required-external-pool.js";
+const env = {
+  BB_ACCOUNT_POOL_EXTERNAL_REQUIRED: "1",
+  BB_ACCOUNT_POOL_EXTERNAL_URL: "https://inference.example.ts.net",
+  BB_ACCOUNT_POOL_EXTERNAL_TOKEN: "synthetic-key",
+};
+describe("required external inference", () => {
+  it("keeps partial and invalid selection required", () => {
+    expect(externalPoolSelected({})).toBe(false);
+    for (const value of ["", "0", "1"]) {
+      const partial = { BB_ACCOUNT_POOL_EXTERNAL_REQUIRED: value };
+      expect(externalPoolSelected(partial)).toBe(true);
+      expect(() => requiredExternalRoute(partial)).toThrow(/unavailable/);
+    }
+  });
+  it.each([
+    "http://inference.example.ts.net",
+    "https://provider.example",
+    "https://inference.example.ts.net/v1",
+    "https://user:pass@inference.example.ts.net",
+  ])("rejects forbidden destination %s", (url) => {
+    expect(() =>
+      requiredExternalRoute({ ...env, BB_ACCOUNT_POOL_EXTERNAL_URL: url }),
+    ).toThrow();
+  });
+  it("fails missing route without any upstream request", async () => {
+    const upstream = vi.fn();
+    expect(
+      (
+        await externalRelay(
+          new Request("https://bb.test/v1/responses", { method: "POST" }),
+          "/v1/responses",
+          {},
+          upstream,
+        )
+      ).status,
+    ).toBe(503);
+    expect(upstream).not.toHaveBeenCalled();
+  });
+  it("replaces credentials, preserves session identity and streams without replay", async () => {
+    const upstream = vi.fn(async (_url, init) => {
+      const headers = new Headers(init?.headers);
+      expect(headers.get("authorization")).toBe("Bearer synthetic-key");
+      expect(headers.get("x-api-key")).toBeNull();
+      expect(headers.get("x-bb-account-pool-token")).toBeNull();
+      expect(headers.get("x-forwarded-host")).toBeNull();
+      expect(headers.get("session-id")).toBe("native-session");
+      expect(init?.redirect).toBe("error");
+      return new Response("data: test\n\n", {
+        headers: { "content-type": "text/event-stream" },
+      });
+    });
+    const request = new Request("https://bb.test/v1/responses", {
+      method: "POST",
+      headers: {
+        authorization: "Bearer personal",
+        "x-api-key": "personal",
+        "x-bb-account-pool-token": "hub",
+        "x-forwarded-host": "evil",
+        "session-id": "native-session",
+      },
+      body: "{}",
+    });
+    expect(
+      await (
+        await externalRelay(request, "/v1/responses", env, upstream)
+      ).text(),
+    ).toContain("data: test");
+    expect(upstream).toHaveBeenCalledTimes(1);
+  });
+  it("returns unavailable on Mac loss without another attempt", async () => {
+    const upstream = vi.fn(async () => {
+      throw new Error("offline");
+    });
+    expect(
+      (
+        await externalRelay(
+          new Request("https://bb.test/v1/messages", { method: "POST" }),
+          "/v1/messages",
+          env,
+          upstream,
+        )
+      ).status,
+    ).toBe(503);
+    expect(upstream).toHaveBeenCalledTimes(1);
+  });
+});
+
+it("registers both required BB routes without local management or provider calls", async () => {
+  const { createFakePluginHost } = await import("@get-bb/plugin-sdk/testing");
+  const { createAccountPoolPlugin } = await import("./server.js");
+  const { mkdtemp, rm } = await import("node:fs/promises");
+  const { tmpdir } = await import("node:os");
+  const dataDir = await mkdtemp(`${tmpdir()}/bb-required-relay-`);
+  const host = createFakePluginHost({ pluginId: "account-pool", dataDir });
+  const upstream = vi.fn(async () => {
+    throw new Error("must not contact provider during registration");
+  });
+  try {
+    await createAccountPoolPlugin({ env, fetch: upstream })(host.bb);
+    for (const provider of ["claude-code", "codex"]) {
+      const entries = await host.harness.behavior.resolveProviderEnv(provider, {
+        threadId: "test",
+        projectId: "test",
+        hostId: "host",
+      });
+      expect(entries.filter((entry) => entry.name === "BB_ACCOUNT_POOL_EXTERNAL_REQUIRED")).toEqual([
+        expect.objectContaining({ name: "BB_ACCOUNT_POOL_EXTERNAL_REQUIRED", value: "1" }),
+      ]);
+      expect(
+        entries.some(
+          (entry) =>
+            entry.name ===
+            (provider === "codex"
+              ? "CODEX_OPENAI_BASE_URL"
+              : "ANTHROPIC_BASE_URL"),
+        ),
+      ).toBe(true);
+    }
+    expect(upstream).not.toHaveBeenCalled();
+    await expect(
+      host.harness.behavior.callRpc("login.start", {}),
+    ).rejects.toThrow();
+  } finally {
+    await host.harness.lifecycle.dispose();
+    await rm(dataDir, { recursive: true, force: true });
+  }
+});
diff --git a/plugins/account-pool/src/required-external-pool.ts b/plugins/account-pool/src/required-external-pool.ts
