index 0000000000000000000000000000000000000000..9d9963103b04e0b4754e8505e523dc324ceeb624
--- /dev/null
+++ b/plugins/account-pool/src/required-external-pool.ts
@@ -0,0 +1,185 @@
+import path from "node:path";
+import type { BbPluginApi } from "@get-bb/plugin-sdk";
+import { HubTokenStore } from "./store.js";
+
+export const REQUIRED_EXTERNAL_POOL_CONTRACT_VERSION = 1;
+
+const ROOT = "/api/v1/plugins/account-pool/http";
+export function externalPoolSelected(env: NodeJS.ProcessEnv): boolean {
+  return env.BB_ACCOUNT_POOL_EXTERNAL_REQUIRED !== undefined;
+}
+
+export function requiredExternalRoute(env: NodeJS.ProcessEnv): {
+  origin: string;
+  token: string;
+} {
+  try {
+    const url = new URL(env.BB_ACCOUNT_POOL_EXTERNAL_URL ?? "");
+    const token = env.BB_ACCOUNT_POOL_EXTERNAL_TOKEN ?? "";
+    if (
+      env.BB_ACCOUNT_POOL_EXTERNAL_REQUIRED !== "1" ||
+      url.protocol !== "https:" ||
+      !url.hostname.endsWith(".ts.net") ||
+      url.username ||
+      url.password ||
+      url.port ||
+      url.pathname !== "/" ||
+      url.search ||
+      url.hash ||
+      !token ||
+      /\s/.test(token)
+    )
+      throw new Error();
+    return { origin: url.origin, token };
+  } catch {
+    throw new Error("Required BB inference route is unavailable or invalid.");
+  }
+}
+
+export async function externalRelay(
+  request: Request,
+  routePath: string,
+  env: NodeJS.ProcessEnv,
+  upstream: typeof fetch,
+): Promise<Response> {
+  let route: ReturnType<typeof requiredExternalRoute>;
+  try {
+    route = requiredExternalRoute(env);
+  } catch {
+    return new Response("Required BB inference route unavailable.", {
+      status: 503,
+    });
+  }
+  const headers = new Headers(request.headers);
+  for (const name of [...headers.keys()]) {
+    if (
+      [
+        "authorization",
+        "x-api-key",
+        "x-bb-account-pool-token",
+        "host",
+        "content-length",
+        "connection",
+        "cookie",
+      ].includes(name) ||
+      name.startsWith("x-forwarded-") ||
+      name === "forwarded"
+    )
+      headers.delete(name);
+  }
+  headers.set("authorization", `Bearer ${route.token}`);
+  try {
+    const response = await upstream(
+      `${route.origin}${routePath}${new URL(request.url).search}`,
+      {
+        method: request.method,
+        headers,
+        redirect: "error",
+        signal: request.signal,
+        ...(request.method === "GET"
+          ? {}
+          : { body: await request.arrayBuffer() }),
+      },
+    );
+    return new Response(response.body, {
+      status: response.status,
+      headers: response.headers,
+    });
+  } catch {
+    return new Response("Required BB inference route unavailable.", {
+      status: request.signal.aborted ? 499 : 503,
+    });
+  }
+}
+
+export async function registerRequiredExternalPool(
+  bb: BbPluginApi,
+  env: NodeJS.ProcessEnv,
+  upstream: typeof fetch,
+  now: () => number,
+): Promise<void> {
+  // This branch never constructs local account stores, login handlers, or usage workers.
+  const tokens = new HubTokenStore(
+    path.join(
+      bb.server.experimental_dataDir,
+      "plugins",
+      bb.pluginId,
+      "secrets",
+      "accounts",
+    ),
+    now,
+  );
+  await tokens.initialize();
+  const contribute =
+    (provider: "claude" | "codex") => async (context: { hostId: string }) => {
+      requiredExternalRoute(env); // Missing configuration must fail before starting the official client.
+      const token = await tokens.forHost(context.hostId);
+      const entries =
+        provider === "claude"
+          ? [
+              { name: "ANTHROPIC_BASE_URL", value: { serverPath: ROOT } },
+              { name: "ANTHROPIC_AUTH_TOKEN", value: token },
+              { name: "ANTHROPIC_API_KEY", value: "" },
+              { name: "CLAUDE_CODE_USE_BEDROCK", value: "" },
+              { name: "CLAUDE_CODE_USE_VERTEX", value: "" },
+              { name: "CLAUDE_CODE_USE_FOUNDRY", value: "" },
+            ]
+          : [
+              {
+                name: "CODEX_OPENAI_BASE_URL",
+                value: { serverPath: `${ROOT}/v1` },
+              },
+              { name: "CODEX_POOL_AUTH_TOKEN", value: token },
+            ];
+      entries.push(
+        { name: "BB_ACCOUNT_POOL_EXTERNAL_REQUIRED", value: "1" },
+        { name: "BB_ACCOUNT_POOL_EXTERNAL_TOKEN", value: "" },
+        { name: "BB_ACCOUNT_POOL_EXTERNAL_URL", value: "" },
+      );
+      return entries.map((entry) => ({
+        ...entry,
+        reason: "Required BB external inference route",
+      }));
+    };
+  bb.providers.experimental_contributeEnv("claude-code", contribute("claude"));
+  bb.providers.experimental_contributeEnv("codex", contribute("codex"));
+  for (const provider of ["claude-code", "codex"]) {
+    bb.providers.experimental_contributeEnvHealth(provider, () => {
+      try {
+        requiredExternalRoute(env);
+      } catch {
+        return null;
+      }
+      return {
+        label: "External pool",
+        statusMessage:
+          "BB inference uses its required external route; local credentials are disabled.",
+      };
+    });
+  }
+  for (const [method, route] of [
+    ["POST", "/v1/messages"],
+    ["POST", "/v1/messages/count_tokens"],
+    ["POST", "/v1/responses"],
+    ["POST", "/v1/responses/compact"],
+    ["GET", "/v1/models"],
+  ] as const) {
+    bb.http.route(
+      method,
+      route,
+      async (context) => {
+        const request = context.req.raw;
+        const presented =
+          request.headers.get("x-bb-account-pool-token") ??
+          /^Bearer\s+(.+)$/i.exec(
+            request.headers.get("authorization") ?? "",
+          )?.[1] ??
+          null;
+        if ((await tokens.authenticate(presented)) === null)
+          return new Response(null, { status: 401 });
+        return externalRelay(request, route, env, upstream);
+      },
+      { auth: "none" },
+    );
+  }
+}
