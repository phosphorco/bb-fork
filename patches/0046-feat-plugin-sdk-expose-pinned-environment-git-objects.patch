@@ -0,0 +1,183 @@
+import {
+  getEnvironment,
+  getProjectSourceForProject,
+  type DbConnection,
+} from "@bb/db";
+import type {
+  ExperimentalEnvironmentGitObjectInspectionRequest,
+  ExperimentalEnvironmentGitObjectInspectionResult,
+} from "@get-bb/plugin-sdk";
+import { z } from "zod";
+import { callHostOnlineRpc } from "../hosts/online-rpc.js";
+import { ApiError } from "../../errors.js";
+import type { WorkSessionDeps } from "../../types.js";
+
+const GIT_OBJECT_OID = /^(?:[a-f0-9]{40}|[a-f0-9]{64})$/u;
+const DEFAULT_MAX_OUTPUT_BYTES = 256 * 1024;
+const MAX_OUTPUT_BYTES = 512 * 1024;
+
+const selectionSchema = z.discriminatedUnion("kind", [
+  z
+    .object({
+      id: z.string().min(1).max(128),
+      kind: z.literal("tree"),
+      path: z.string().max(4096),
+      recursive: z.boolean(),
+      expectedTreeOid: z.string().regex(GIT_OBJECT_OID).optional(),
+    })
+    .strict(),
+  z
+    .object({
+      id: z.string().min(1).max(128),
+      kind: z.literal("blob"),
+      path: z.string().min(1).max(4096),
+      expectedBlobOid: z.string().regex(GIT_OBJECT_OID).optional(),
+    })
+    .strict(),
+  z
+    .object({
+      id: z.string().min(1).max(128),
+      kind: z.literal("diff"),
+      baseCommitOid: z.string().regex(GIT_OBJECT_OID),
+      paths: z.array(z.string().min(1).max(4096)).min(1).max(32),
+    })
+    .strict(),
+]);
+
+const requestSchema = z
+  .object({
+    projectId: z.string().min(1),
+    sourceId: z.string().min(1),
+    environmentId: z.string().min(1),
+    commitOid: z.string().regex(GIT_OBJECT_OID),
+    expectedCommitTreeOid: z.string().regex(GIT_OBJECT_OID).optional(),
+    selections: z.array(selectionSchema).min(1).max(32),
+    maxOutputBytes: z.number().int().min(1).max(MAX_OUTPUT_BYTES).optional(),
+  })
+  .strict()
+  .superRefine((value, context) => {
+    const ids = new Set<string>();
+    for (const [index, selection] of value.selections.entries()) {
+      if (ids.has(selection.id)) {
+        context.addIssue({
+          code: "custom",
+          path: ["selections", index, "id"],
+          message: "Selection ids must be unique",
+        });
+      }
+      ids.add(selection.id);
+    }
+  });
+
+type ValidRequest = z.infer<typeof requestSchema>;
+type UnavailableReason = Extract<
+  ExperimentalEnvironmentGitObjectInspectionResult,
+  { outcome: "unavailable" }
+>["reason"];
+
+export type PluginEnvironmentGitObjectInspector = (args: {
+  pluginId: string;
+  request: ExperimentalEnvironmentGitObjectInspectionRequest;
+}) => Promise<ExperimentalEnvironmentGitObjectInspectionResult>;
+
+function unavailable(
+  reason: UnavailableReason,
+): ExperimentalEnvironmentGitObjectInspectionResult {
+  return { outcome: "unavailable", reason };
+}
+
+function validateRequest(
+  request: ExperimentalEnvironmentGitObjectInspectionRequest,
+): ValidRequest | null {
+  const parsed = requestSchema.safeParse(request);
+  return parsed.success ? parsed.data : null;
+}
+
+function resolveSource(
+  db: DbConnection,
+  request: ValidRequest,
+):
+  | { outcome: "ok"; hostId: string; rootPath: string }
+  | { outcome: "unavailable"; reason: UnavailableReason } {
+  const environment = getEnvironment(db, request.environmentId);
+  if (environment === null) {
+    return { outcome: "unavailable", reason: "environment_not_found" };
+  }
+  if (environment.status !== "ready" || environment.path === null) {
+    return { outcome: "unavailable", reason: "environment_not_ready" };
+  }
+  if (environment.projectId !== request.projectId) {
+    return { outcome: "unavailable", reason: "identity_mismatch" };
+  }
+  const source = getProjectSourceForProject(db, {
+    projectId: request.projectId,
+    sourceId: request.sourceId,
+  });
+  if (source === null || source.type !== "local_path") {
+    return { outcome: "unavailable", reason: "source_unavailable" };
+  }
+  if (source.hostId !== environment.hostId) {
+    return { outcome: "unavailable", reason: "identity_mismatch" };
+  }
+  return { outcome: "ok", hostId: source.hostId, rootPath: source.path };
+}
+
+function unavailableFromError(
+  error: unknown,
+): ExperimentalEnvironmentGitObjectInspectionResult {
+  if (error instanceof ApiError) {
+    if (error.body.code === "protocol_version_mismatch") {
+      return unavailable("protocol_unsupported");
+    }
+    if (error.body.code === "host_unavailable") {
+      return unavailable("host_unavailable");
+    }
+  }
+  return unavailable("internal_error");
+}
+
+export function createPluginEnvironmentGitObjectInspector(
+  deps: WorkSessionDeps,
+): PluginEnvironmentGitObjectInspector {
+  return async ({ pluginId, request }) => {
+    const valid = validateRequest(request);
+    if (valid === null) return unavailable("invalid_request");
+    const source = resolveSource(deps.db, valid);
+    if (source.outcome === "unavailable") return source;
+    try {
+      const result = await callHostOnlineRpc(deps, {
+        hostId: source.hostId,
+        timeoutMs: 5_000,
+        command: {
+          type: "host.inspect_environment_git_objects",
+          rootPath: source.rootPath,
+          commitOid: valid.commitOid,
+          ...(valid.expectedCommitTreeOid === undefined
+            ? {}
+            : { expectedCommitTreeOid: valid.expectedCommitTreeOid }),
+          selections: valid.selections,
+          maxOutputBytes: valid.maxOutputBytes ?? DEFAULT_MAX_OUTPUT_BYTES,
+        },
+      });
+      if (result.outcome === "unavailable") return result;
+      return {
+        outcome: "ok",
+        provenance: {
+          pluginId,
+          projectId: valid.projectId,
+          sourceId: valid.sourceId,
+          environmentId: valid.environmentId,
+          hostId: source.hostId,
+          sourceRootPath: source.rootPath,
+          originRemote: result.originRemote,
+          commitOid: result.commitOid,
+          treeOid: result.treeOid,
+        },
+        outputBytes: result.outputBytes,
+        values: result.values,
+      };
+    } catch (error) {
+      return unavailableFromError(error);
+    }
+  };
+}
