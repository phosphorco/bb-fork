+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+import path from "node:path";
+import type { HostDaemonOnlineRpcResult } from "@bb/host-daemon-contract";
+import type { CommandOf } from "../command-dispatch-support.js";
+import { resolveNonSymlinkDirectoryPath } from "./root-path.js";
+
+const execFileAsync = promisify(execFile);
+const GIT_OBJECT_TIMEOUT_MS = 5_000;
+const GIT_OBJECT_TREE_ENTRY_LIMIT = 2_048;
+
+type InspectionCommand = CommandOf<"host.inspect_environment_git_objects">;
+type InspectionResult =
+  HostDaemonOnlineRpcResult<"host.inspect_environment_git_objects">;
+
+type InspectionReason = Extract<
+  InspectionResult,
+  { outcome: "unavailable" }
+>["reason"];
+
+type OriginRemote = Extract<
+  InspectionResult,
+  { outcome: "ok" }
+>["originRemote"];
+
+class InspectionFailure extends Error {
+  constructor(readonly reason: InspectionReason) {
+    super(reason);
+  }
+}
+
+function unavailable(reason: InspectionReason): InspectionResult {
+  return { outcome: "unavailable", reason };
+}
+
+function assertRelativePath(value: string, allowEmpty: boolean): void {
+  if (value.length === 0) {
+    if (allowEmpty) return;
+    throw new InspectionFailure("object_unreachable");
+  }
+  if (value.startsWith("/") || value.includes("\\") || value.includes("\0")) {
+    throw new InspectionFailure("object_unreachable");
+  }
+  const segments = value.split("/");
+  if (
+    segments.some(
+      (segment) => segment.length === 0 || segment === "." || segment === "..",
+    )
+  ) {
+    throw new InspectionFailure("object_unreachable");
+  }
+}
+
+function gitEnvironment(): NodeJS.ProcessEnv {
+  return {
+    HOME: process.env.HOME ?? "/nonexistent",
+    PATH: process.env.PATH ?? "/usr/bin:/bin",
+    GIT_ALLOW_PROTOCOL: "none",
+    GIT_CONFIG_GLOBAL: "/dev/null",
+    GIT_CONFIG_NOSYSTEM: "1",
+    GIT_NO_REPLACE_OBJECTS: "1",
+    GIT_OPTIONAL_LOCKS: "0",
+    GIT_TERMINAL_PROMPT: "0",
+    LC_ALL: "C",
+  };
+}
+
+async function runGit(
+  rootPath: string,
+  args: readonly string[],
+  maxBuffer: number,
+  failure: InspectionReason,
+): Promise<Buffer> {
+  try {
+    const result = await execFileAsync(
+      "git",
+      [
+        "-c",
+        "core.hooksPath=/dev/null",
+        "-c",
+        "protocol.file.allow=never",
+        ...args,
+      ],
+      {
+        cwd: rootPath,
+        encoding: "buffer",
+        env: gitEnvironment(),
+        maxBuffer,
+        timeout: GIT_OBJECT_TIMEOUT_MS,
+      },
+    );
+    return Buffer.from(result.stdout);
+  } catch (error) {
+    if (
+      typeof error === "object" &&
+      error !== null &&
+      ("killed" in error || "code" in error) &&
+      (("killed" in error && error.killed === true) ||
+        ("code" in error && error.code === "ETIMEDOUT"))
+    ) {
+      throw new InspectionFailure("timeout");
+    }
+    throw new InspectionFailure(failure);
+  }
+}
+
+async function resolveCommit(
+  rootPath: string,
+  commitOid: string,
+  expectedTreeOid: string | undefined,
+): Promise<{ commitOid: string; treeOid: string }> {
+  const resolvedCommit = (
+    await runGit(
+      rootPath,
+      ["rev-parse", "--verify", `${commitOid}^{commit}`],
+      1_024,
+      "object_not_found",
+    )
+  )
+    .toString("utf8")
+    .trim();
+  if (resolvedCommit !== commitOid) {
+    throw new InspectionFailure("object_unreachable");
+  }
+  const treeOid = (
+    await runGit(
+      rootPath,
+      ["rev-parse", "--verify", `${commitOid}^{tree}`],
+      1_024,
+      "object_not_found",
+    )
+  )
+    .toString("utf8")
+    .trim();
+  if (expectedTreeOid !== undefined && treeOid !== expectedTreeOid) {
+    throw new InspectionFailure("object_unreachable");
+  }
+  return { commitOid: resolvedCommit, treeOid };
+}
+
+function normalizeRepositoryPath(value: string): string | null {
+  if (
+    value.length === 0 ||
+    value.startsWith("/") ||
+    value.endsWith("/") ||
+    value.includes("%")
+  ) {
+    return null;
+  }
+  const segments = value.split("/");
+  if (
+    segments.some(
+      (segment) =>
+        segment.length === 0 ||
+        segment === "." ||
+        segment === ".." ||
+        !/^[A-Za-z0-9._-]+$/u.test(segment),
+    )
+  ) {
+    return null;
+  }
+  const lastIndex = segments.length - 1;
+  if (segments[lastIndex]?.endsWith(".git")) {
+    segments[lastIndex] = segments[lastIndex].slice(0, -4);
+  }
+  if (segments[lastIndex]?.length === 0) return null;
+  return segments.join("/");
+}
+
+function normalizeOriginRemote(value: string): OriginRemote | null {
+  if (value.length === 0 || value.includes("\0") || /\s/u.test(value)) {
+    return null;
+  }
+  const scpStyle = /^git@([A-Za-z0-9.-]+):([A-Za-z0-9._/-]+)$/u.exec(value);
+  if (scpStyle !== null) {
+    const repositoryPath = normalizeRepositoryPath(scpStyle[2]);
+    if (repositoryPath === null) return null;
+    return {
+      host: scpStyle[1].toLowerCase(),
+      repositoryPath,
+      transport: "ssh",
+    };
+  }
+  try {
+    const parsed = new URL(value);
+    if (
+      (parsed.protocol !== "https:" && parsed.protocol !== "ssh:") ||
+      parsed.hostname.length === 0 ||
+      parsed.port.length > 0 ||
+      parsed.password.length > 0 ||
+      parsed.search.length > 0 ||
+      parsed.hash.length > 0 ||
+      (parsed.protocol === "https:" && parsed.username.length > 0) ||
+      (parsed.protocol === "ssh:" && parsed.username !== "git")
+    ) {
+      return null;
+    }
+    const repositoryPath = normalizeRepositoryPath(
+      parsed.pathname.replace(/^\//u, ""),
+    );
+    if (repositoryPath === null) return null;
+    return {
+      host: parsed.hostname.toLowerCase(),
+      repositoryPath,
+      transport: parsed.protocol === "https:" ? "https" : "ssh",
+    };
+  } catch {
+    return null;
+  }
+}
+
+async function resolveOriginRemote(rootPath: string): Promise<OriginRemote> {
+  let output: Buffer;
+  try {
+    output = await runGit(
+      rootPath,
+      ["config", "--no-includes", "--null", "--get-all", "remote.origin.url"],
+      8_192,
+      "origin_remote_missing",
+    );
+  } catch (error) {
+    if (error instanceof InspectionFailure && error.reason === "timeout") {
+      throw error;
+    }
+    throw new InspectionFailure("origin_remote_missing");
+  }
+  const values = output
+    .toString("utf8")
+    .split("\0")
+    .filter((value) => value.length > 0);
+  if (values.length === 0) {
+    throw new InspectionFailure("origin_remote_missing");
+  }
+  if (values.length !== 1) {
+    throw new InspectionFailure("origin_remote_ambiguous");
+  }
+  const originRemote = normalizeOriginRemote(values[0]);
+  if (originRemote === null) {
+    throw new InspectionFailure("origin_remote_invalid");
+  }
+  return originRemote;
+}
+
+async function objectAtPath(
+  rootPath: string,
+  commitOid: string,
+  treeOid: string,
+  relativePath: string,
+): Promise<{ oid: string; type: "blob" | "tree" | "commit" }> {
+  if (relativePath.length === 0) {
+    return { oid: treeOid, type: "tree" };
+  }
+  const oid = (
+    await runGit(
+      rootPath,
+      ["rev-parse", "--verify", `${commitOid}:${relativePath}`],
+      1_024,
+      "object_not_found",
+    )
+  )
+    .toString("utf8")
+    .trim();
+  const type = (
+    await runGit(rootPath, ["cat-file", "-t", oid], 1_024, "object_not_found")
+  )
+    .toString("utf8")
+    .trim();
+  if (type !== "blob" && type !== "tree" && type !== "commit") {
+    throw new InspectionFailure("object_type_mismatch");
+  }
+  return { oid, type };
+}
+
+function parseTreeEntries(output: Buffer): Array<{
+  path: string;
+  mode: string;
+  objectType: "blob" | "tree" | "submodule";
+  objectOid: string;
+}> {
+  const entries = output
+    .toString("utf8")
+    .split("\0")
+    .filter((entry) => entry.length > 0)
+    .map((entry) => {
+      const match =
+        /^([0-7]+) (blob|tree|commit) ((?:[a-f0-9]{40}|[a-f0-9]{64}))\t([\s\S]+)$/u.exec(
+          entry,
+        );
+      if (match === null) throw new InspectionFailure("internal_error");
+      const objectType: "blob" | "tree" | "submodule" =
+        match[2] === "commit"
+          ? "submodule"
+          : match[2] === "blob"
+            ? "blob"
+            : "tree";
+      return {
+        mode: match[1],
+        objectType,
+        objectOid: match[3],
+        path: match[4],
+      };
+    });
+  if (entries.length > GIT_OBJECT_TREE_ENTRY_LIMIT) {
+    throw new InspectionFailure("tree_incomplete");
+  }
+  return entries;
+}
+
+async function verifyRecursiveTreeEntries(
+  rootPath: string,
+  entries: ReadonlyArray<{
+    objectType: "blob" | "tree" | "submodule";
+    objectOid: string;
+  }>,
+): Promise<void> {
+  for (const entry of entries) {
+    if (entry.objectType === "submodule") {
+      throw new InspectionFailure("tree_incomplete");
+    }
+    await runGit(
+      rootPath,
+      ["cat-file", "-e", `${entry.objectOid}^{${entry.objectType}}`],
+      1_024,
+      "tree_incomplete",
+    );
+  }
+}
+
+function parseLfsPointer(
+  contents: Buffer,
+): { kind: "git-lfs-pointer"; oid: string; sizeBytes: number } | null {
+  const pointer =
+    /^version https:\/\/git-lfs.github.com\/spec\/v1\noid (sha256:[a-f0-9]{64})\nsize ([0-9]+)\n?$/u.exec(
+      contents.toString("utf8"),
+    );
+  if (pointer === null) return null;
+  const sizeBytes = Number(pointer[2]);
+  if (!Number.isSafeInteger(sizeBytes) || sizeBytes < 0) return null;
+  return { kind: "git-lfs-pointer", oid: pointer[1], sizeBytes };
+}
+
+function appendValue<T>(args: {
+  value: T;
+  outputBytes: number;
+  maxOutputBytes: number;
+}): { value: T; outputBytes: number } {
+  const bytes = Buffer.byteLength(JSON.stringify(args.value));
+  if (args.outputBytes + bytes > args.maxOutputBytes) {
+    throw new InspectionFailure("output_limit");
+  }
+  return { value: args.value, outputBytes: args.outputBytes + bytes };
+}
+
+export async function inspectEnvironmentGitObjects(
+  command: InspectionCommand,
+): Promise<InspectionResult> {
+  try {
+    if (!path.isAbsolute(command.rootPath))
+      return unavailable("internal_error");
+    const rootPath = await resolveNonSymlinkDirectoryPath({
+      description: "Git source root",
+      path: command.rootPath,
+    });
+    const originRemote = await resolveOriginRemote(rootPath);
+    const commit = await resolveCommit(
+      rootPath,
+      command.commitOid,
+      command.expectedCommitTreeOid,
+    );
+    const values: Array<
+      Extract<InspectionResult, { outcome: "ok" }>["values"][number]
+    > = [];
+    let outputBytes = 0;
+
+    for (const selection of command.selections) {
+      if (selection.kind === "tree") {
+        assertRelativePath(selection.path, true);
+        const target = await objectAtPath(
+          rootPath,
+          commit.commitOid,
+          commit.treeOid,
+          selection.path,
+        );
+        if (target.type === "commit") {
+          throw new InspectionFailure("submodule_excluded");
+        }
+        if (target.type !== "tree") {
+          throw new InspectionFailure("object_type_mismatch");
+        }
+        if (
+          selection.expectedTreeOid !== undefined &&
+          target.oid !== selection.expectedTreeOid
+        ) {
+          throw new InspectionFailure("object_unreachable");
+        }
+        const entries = parseTreeEntries(
+          await runGit(
+            rootPath,
+            [
+              "ls-tree",
+              "-z",
+              "-t",
+              ...(selection.recursive ? ["-r"] : []),
+              commit.commitOid,
+              "--",
+              ...(selection.path.length === 0 ? [] : [selection.path]),
+            ],
+            command.maxOutputBytes,
+            "internal_error",
+          ),
+        );
+        if (selection.recursive) {
+          await verifyRecursiveTreeEntries(rootPath, entries);
+        }
+        const appended = appendValue({
+          maxOutputBytes: command.maxOutputBytes,
+          outputBytes,
+          value: {
+            id: selection.id,
+            kind: "tree" as const,
+            path: selection.path,
+            treeOid: target.oid,
+            recursive: selection.recursive,
+            entries,
+          },
+        });
+        values.push(appended.value);
+        outputBytes = appended.outputBytes;
+        continue;
+      }
+
+      if (selection.kind === "blob") {
+        assertRelativePath(selection.path, false);
+        const target = await objectAtPath(
+          rootPath,
+          commit.commitOid,
+          commit.treeOid,
+          selection.path,
+        );
+        if (target.type === "commit") {
+          throw new InspectionFailure("submodule_excluded");
+        }
+        if (target.type !== "blob") {
+          throw new InspectionFailure("object_type_mismatch");
+        }
+        if (
+          selection.expectedBlobOid !== undefined &&
+          target.oid !== selection.expectedBlobOid
+        ) {
+          throw new InspectionFailure("object_unreachable");
+        }
+        const sizeBytes = Number(
+          (
+            await runGit(
+              rootPath,
+              ["cat-file", "-s", target.oid],
+              1_024,
+              "object_not_found",
+            )
+          )
+            .toString("utf8")
+            .trim(),
+        );
+        if (!Number.isSafeInteger(sizeBytes) || sizeBytes < 0) {
+          throw new InspectionFailure("internal_error");
+        }
+        if (sizeBytes > command.maxOutputBytes) {
+          throw new InspectionFailure("output_limit");
+        }
+        const contents = await runGit(
+          rootPath,
+          ["cat-file", "blob", target.oid],
+          command.maxOutputBytes,
+          "object_not_found",
+        );
+        if (contents.byteLength !== sizeBytes) {
+          throw new InspectionFailure("internal_error");
+        }
+        const appended = appendValue({
+          maxOutputBytes: command.maxOutputBytes,
+          outputBytes,
+          value: {
+            id: selection.id,
+            kind: "blob" as const,
+            path: selection.path,
+            blobOid: target.oid,
+            sizeBytes,
+            content: contents.toString("base64"),
+            contentEncoding: "base64" as const,
+            externalContent: parseLfsPointer(contents),
+          },
+        });
+        values.push(appended.value);
+        outputBytes = appended.outputBytes;
+        continue;
+      }
+
+      for (const relativePath of selection.paths) {
+        assertRelativePath(relativePath, false);
+      }
+      const base = await resolveCommit(
+        rootPath,
+        selection.baseCommitOid,
+        undefined,
+      );
+      const patch = await runGit(
+        rootPath,
+        [
+          "diff-tree",
+          "--no-ext-diff",
+          "--no-textconv",
+          "--no-renames",
+          "--format=",
+          "--patch",
+          base.commitOid,
+          commit.commitOid,
+          "--",
+          ...selection.paths,
+        ],
+        command.maxOutputBytes,
+        "internal_error",
+      );
+      const decoded = new TextDecoder("utf-8", { fatal: true });
+      let patchText: string;
+      let patchEncoding: "utf8" | "base64";
+      try {
+        patchText = decoded.decode(patch);
+        patchEncoding = "utf8";
+      } catch {
+        patchText = patch.toString("base64");
+        patchEncoding = "base64";
+      }
+      const appended = appendValue({
+        maxOutputBytes: command.maxOutputBytes,
+        outputBytes,
+        value: {
+          id: selection.id,
+          kind: "diff" as const,
+          baseCommitOid: base.commitOid,
+          commitOid: commit.commitOid,
+          paths: selection.paths,
+          patch: patchText,
+          patchEncoding,
+        },
+      });
+      values.push(appended.value);
+      outputBytes = appended.outputBytes;
+    }
+
+    return {
+      outcome: "ok",
+      originRemote,
+      commitOid: commit.commitOid,
+      treeOid: commit.treeOid,
+      outputBytes,
+      values,
+    };
+  } catch (error) {
+    if (error instanceof InspectionFailure) return unavailable(error.reason);
+    return unavailable("internal_error");
+  }
+}
