+// ---------------------------------------------------------------------------
+// Environment Git object inspection.
+// ---------------------------------------------------------------------------
+
+export type ExperimentalEnvironmentGitObjectSelection =
+  | {
+      readonly id: string;
+      readonly kind: "tree";
+      readonly path: string;
+      readonly recursive: boolean;
+      readonly expectedTreeOid?: string;
+    }
+  | {
+      readonly id: string;
+      readonly kind: "blob";
+      readonly path: string;
+      readonly expectedBlobOid?: string;
+    }
+  | {
+      readonly id: string;
+      readonly kind: "diff";
+      readonly baseCommitOid: string;
+      readonly paths: readonly string[];
+    };
+
+export interface ExperimentalEnvironmentGitObjectInspectionRequest {
+  readonly projectId: string;
+  readonly sourceId: string;
+  readonly environmentId: string;
+  readonly commitOid: string;
+  readonly expectedCommitTreeOid?: string;
+  readonly selections: readonly ExperimentalEnvironmentGitObjectSelection[];
+  readonly maxOutputBytes?: number;
+}
+
+export interface ExperimentalEnvironmentGitObjectProvenance {
+  readonly pluginId: string;
+  readonly projectId: string;
+  readonly sourceId: string;
+  readonly environmentId: string;
+  readonly hostId: string;
+  readonly sourceRootPath: string;
+  readonly originRemote: ExperimentalEnvironmentGitOriginRemote;
+  readonly commitOid: string;
+  readonly treeOid: string;
+}
+
+export interface ExperimentalEnvironmentGitOriginRemote {
+  readonly host: string;
+  readonly repositoryPath: string;
+  readonly transport: "https" | "ssh";
+}
+
+export interface ExperimentalEnvironmentGitTreeEntry {
+  readonly path: string;
+  readonly mode: string;
+  readonly objectType: "blob" | "tree" | "submodule";
+  readonly objectOid: string;
+}
+
+export type ExperimentalEnvironmentGitObjectInspectionValue =
+  | {
+      readonly id: string;
+      readonly kind: "tree";
+      readonly path: string;
+      readonly treeOid: string;
+      readonly recursive: boolean;
+      readonly entries: readonly ExperimentalEnvironmentGitTreeEntry[];
+    }
+  | {
+      readonly id: string;
+      readonly kind: "blob";
+      readonly path: string;
+      readonly blobOid: string;
+      readonly sizeBytes: number;
+      readonly content: string;
+      readonly contentEncoding: "base64";
+      readonly externalContent: null | {
+        readonly kind: "git-lfs-pointer";
+        readonly oid: string;
+        readonly sizeBytes: number;
+      };
+    }
+  | {
+      readonly id: string;
+      readonly kind: "diff";
+      readonly baseCommitOid: string;
+      readonly commitOid: string;
+      readonly paths: readonly string[];
+      readonly patch: string;
+      readonly patchEncoding: "utf8" | "base64";
+    };
+
+export type ExperimentalEnvironmentGitObjectInspectionResult =
+  | {
+      readonly outcome: "ok";
+      readonly provenance: ExperimentalEnvironmentGitObjectProvenance;
+      readonly outputBytes: number;
+      readonly values: readonly ExperimentalEnvironmentGitObjectInspectionValue[];
+    }
+  | {
+      readonly outcome: "unavailable";
+      readonly reason:
+        | "invalid_request"
+        | "environment_not_found"
+        | "environment_not_ready"
+        | "identity_mismatch"
+        | "source_unavailable"
+        | "host_unavailable"
+        | "object_not_found"
+        | "object_type_mismatch"
+        | "object_unreachable"
+        | "origin_remote_missing"
+        | "origin_remote_invalid"
+        | "origin_remote_ambiguous"
+        | "tree_incomplete"
+        | "submodule_excluded"
+        | "output_limit"
+        | "timeout"
+        | "protocol_unsupported"
+        | "internal_error";
+    };
+
+export interface PluginEnvironmentGitObjects {
+  inspect(
+    request: ExperimentalEnvironmentGitObjectInspectionRequest,
+  ): Promise<ExperimentalEnvironmentGitObjectInspectionResult>;
+}
