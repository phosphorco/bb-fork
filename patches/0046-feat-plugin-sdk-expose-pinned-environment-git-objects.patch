index 0000000000000000000000000000000000000000..b780b019a40fa2e6c3bb289b97829d6f3e0b6b50
--- /dev/null
+++ b/apps/server/test/services/plugins/environment-git-objects.test.ts
@@ -0,0 +1,180 @@
+import { describe, expect, it } from "vitest";
+import { setProjectGitRemoteUrlIfMissing } from "@bb/db";
+import { createPluginEnvironmentGitObjectInspector } from "../../../src/services/plugins/environment-git-objects.js";
+import { registerHostRpcResponder } from "../../helpers/host-rpc.js";
+import {
+  seedEnvironment,
+  seedHostSession,
+  seedProjectWithSource,
+} from "../../helpers/seed.js";
+import { withTestHarness } from "../../helpers/test-app.js";
+
+const COMMIT_OID = "a".repeat(40);
+const TREE_OID = "b".repeat(40);
+const BLOB_OID = "c".repeat(40);
+
+describe("plugin environment Git object inspection", () => {
+  it("binds the plugin, project, source, environment, and host before one fixed host call", async () => {
+    await withTestHarness(async (harness) => {
+      const { host, session } = seedHostSession(harness.deps);
+      const { project, source } = seedProjectWithSource(harness.deps, {
+        hostId: host.id,
+        path: "/project-source",
+      });
+      setProjectGitRemoteUrlIfMissing(
+        harness.deps.db,
+        harness.deps.hub,
+        project.id,
+        "https://github.com/example/stale-cache.git",
+      );
+      const environment = seedEnvironment(harness.deps, {
+        hostId: host.id,
+        projectId: project.id,
+        path: "/environment-worktree",
+      });
+      const responder = registerHostRpcResponder(harness, {
+        hostId: host.id,
+        sessionId: session.id,
+        handle: (request) => {
+          expect(request.command).toEqual({
+            type: "host.inspect_environment_git_objects",
+            rootPath: "/project-source",
+            commitOid: COMMIT_OID,
+            expectedCommitTreeOid: TREE_OID,
+            maxOutputBytes: 1024,
+            selections: [
+              {
+                id: "readme",
+                kind: "blob",
+                path: "README.md",
+                expectedBlobOid: BLOB_OID,
+              },
+            ],
+          });
+          return {
+            ok: true,
+            result: {
+              outcome: "ok",
+              originRemote: {
+                host: "github.com",
+                repositoryPath: "phosphorco/bb",
+                transport: "https",
+              },
+              commitOid: COMMIT_OID,
+              treeOid: TREE_OID,
+              outputBytes: 12,
+              values: [
+                {
+                  id: "readme",
+                  kind: "blob",
+                  path: "README.md",
+                  blobOid: BLOB_OID,
+                  sizeBytes: 3,
+                  content: "YWJj",
+                  contentEncoding: "base64",
+                  externalContent: null,
+                },
+              ],
+            },
+          } as const;
+        },
+      });
+      const inspect = createPluginEnvironmentGitObjectInspector(harness.deps);
+
+      const result = await inspect({
+        pluginId: "github-review",
+        request: {
+          projectId: project.id,
+          sourceId: source.id,
+          environmentId: environment.id,
+          commitOid: COMMIT_OID,
+          expectedCommitTreeOid: TREE_OID,
+          maxOutputBytes: 1024,
+          selections: [
+            {
+              id: "readme",
+              kind: "blob",
+              path: "README.md",
+              expectedBlobOid: BLOB_OID,
+            },
+          ],
+        },
+      });
+      expect(result).toMatchObject({
+        outcome: "ok",
+        provenance: {
+          pluginId: "github-review",
+          projectId: project.id,
+          sourceId: source.id,
+          environmentId: environment.id,
+          hostId: host.id,
+          sourceRootPath: "/project-source",
+          originRemote: {
+            host: "github.com",
+            repositoryPath: "phosphorco/bb",
+            transport: "https",
+          },
+          commitOid: COMMIT_OID,
+          treeOid: TREE_OID,
+        },
+      });
+      expect(responder.requests).toHaveLength(1);
+    });
+  });
+
+  it("refuses mismatched identity and malformed requests before a host or terminal transport is called", async () => {
+    await withTestHarness(async (harness) => {
+      const { host, session } = seedHostSession(harness.deps);
+      const { project, source } = seedProjectWithSource(harness.deps, {
+        hostId: host.id,
+      });
+      const otherProject = seedProjectWithSource(harness.deps, {
+        hostId: host.id,
+      }).project;
+      const environment = seedEnvironment(harness.deps, {
+        hostId: host.id,
+        projectId: project.id,
+      });
+      const responder = registerHostRpcResponder(harness, {
+        hostId: host.id,
+        sessionId: session.id,
+        handle: () => {
+          throw new Error("Host inspection must not be called");
+        },
+      });
+      const inspect = createPluginEnvironmentGitObjectInspector(harness.deps);
+      const request = {
+        projectId: project.id,
+        sourceId: source.id,
+        environmentId: environment.id,
+        commitOid: COMMIT_OID,
+        selections: [
+          { id: "tree", kind: "tree" as const, path: "", recursive: false },
+        ],
+      };
+
+      await expect(
+        inspect({
+          pluginId: "github-review",
+          request: { ...request, projectId: otherProject.id },
+        }),
+      ).resolves.toEqual({
+        outcome: "unavailable",
+        reason: "identity_mismatch",
+      });
+      await expect(
+        inspect({
+          pluginId: "github-review",
+          request: {
+            ...request,
+            selections: [
+              { id: "same", kind: "tree", path: "", recursive: false },
+              { id: "same", kind: "tree", path: "", recursive: false },
+            ],
+          },
+        }),
+      ).resolves.toEqual({ outcome: "unavailable", reason: "invalid_request" });
+      expect(responder.requests).toHaveLength(0);
+    });
+  });
+});
