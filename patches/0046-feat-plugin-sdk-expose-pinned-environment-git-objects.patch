@@ -0,0 +1,400 @@
+import { execFile } from "node:child_process";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { promisify } from "node:util";
+import { afterEach, describe, expect, it } from "vitest";
+import { inspectEnvironmentGitObjects } from "./environment-git-objects.js";
+
+const execFileAsync = promisify(execFile);
+const temporaryDirectories: string[] = [];
+
+async function runGit(
+  rootPath: string,
+  args: readonly string[],
+): Promise<string> {
+  const result = await execFileAsync("git", [...args], {
+    cwd: rootPath,
+    encoding: "utf8",
+  });
+  return result.stdout;
+}
+
+async function createRepository(): Promise<{
+  rootPath: string;
+  baseCommitOid: string;
+  commitOid: string;
+  treeOid: string;
+  readmeBlobOid: string;
+}> {
+  const rootPath = await mkdtemp(path.join(tmpdir(), "bb-environment-git-"));
+  temporaryDirectories.push(rootPath);
+  await runGit(rootPath, ["init", "-b", "main"]);
+  await runGit(rootPath, ["config", "user.name", "BB Tests"]);
+  await runGit(rootPath, ["config", "user.email", "bb@example.test"]);
+  await runGit(rootPath, [
+    "remote",
+    "add",
+    "origin",
+    "https://github.com/PhosphorCo/bb.git",
+  ]);
+  await writeFile(path.join(rootPath, "README.md"), "base\n", "utf8");
+  await runGit(rootPath, ["add", "README.md"]);
+  await runGit(rootPath, ["commit", "-m", "base"]);
+  const baseCommitOid = (await runGit(rootPath, ["rev-parse", "HEAD"])).trim();
+  await writeFile(path.join(rootPath, "README.md"), "head\n", "utf8");
+  await writeFile(
+    path.join(rootPath, "pointer.txt"),
+    "version https://git-lfs.github.com/spec/v1\noid sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\nsize 42\n",
+    "utf8",
+  );
+  await runGit(rootPath, ["add", "README.md", "pointer.txt"]);
+  await runGit(rootPath, ["commit", "-m", "head"]);
+  const commitOid = (await runGit(rootPath, ["rev-parse", "HEAD"])).trim();
+  const treeOid = (await runGit(rootPath, ["rev-parse", "HEAD^{tree}"])).trim();
+  const readmeBlobOid = (
+    await runGit(rootPath, ["rev-parse", "HEAD:README.md"])
+  ).trim();
+  return { rootPath, baseCommitOid, commitOid, treeOid, readmeBlobOid };
+}
+
+afterEach(async () => {
+  await Promise.all(
+    temporaryDirectories
+      .splice(0)
+      .map((directory) => rm(directory, { recursive: true, force: true })),
+  );
+});
+
+describe("inspectEnvironmentGitObjects", () => {
+  it("reads pinned tree, blob, and diff data without mutating Git state", async () => {
+    const repository = await createRepository();
+    const before = await Promise.all([
+      readFile(path.join(repository.rootPath, ".git", "config"), "utf8"),
+      readFile(path.join(repository.rootPath, ".git", "HEAD"), "utf8"),
+      readFile(path.join(repository.rootPath, ".git", "index")),
+      readFile(
+        path.join(repository.rootPath, ".git", "refs", "heads", "main"),
+        "utf8",
+      ),
+      readFile(path.join(repository.rootPath, "README.md"), "utf8"),
+    ]);
+
+    const result = await inspectEnvironmentGitObjects({
+      type: "host.inspect_environment_git_objects",
+      rootPath: repository.rootPath,
+      commitOid: repository.commitOid,
+      expectedCommitTreeOid: repository.treeOid,
+      maxOutputBytes: 64 * 1024,
+      selections: [
+        {
+          id: "tree",
+          kind: "tree",
+          path: "",
+          recursive: true,
+          expectedTreeOid: repository.treeOid,
+        },
+        {
+          id: "readme",
+          kind: "blob",
+          path: "README.md",
+          expectedBlobOid: repository.readmeBlobOid,
+        },
+        {
+          id: "diff",
+          kind: "diff",
+          baseCommitOid: repository.baseCommitOid,
+          paths: ["README.md"],
+        },
+      ],
+    });
+
+    expect(result).toMatchObject({
+      outcome: "ok",
+      originRemote: {
+        host: "github.com",
+        repositoryPath: "PhosphorCo/bb",
+        transport: "https",
+      },
+      commitOid: repository.commitOid,
+      treeOid: repository.treeOid,
+    });
+    if (result.outcome !== "ok") throw new Error("Expected Git inspection");
+    expect(result.values).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          id: "tree",
+          kind: "tree",
+          treeOid: repository.treeOid,
+          entries: expect.arrayContaining([
+            expect.objectContaining({
+              path: "README.md",
+              objectType: "blob",
+              objectOid: repository.readmeBlobOid,
+            }),
+          ]),
+        }),
+        expect.objectContaining({
+          id: "readme",
+          kind: "blob",
+          blobOid: repository.readmeBlobOid,
+          content: Buffer.from("head\n").toString("base64"),
+          externalContent: null,
+        }),
+        expect.objectContaining({
+          id: "diff",
+          kind: "diff",
+          baseCommitOid: repository.baseCommitOid,
+          commitOid: repository.commitOid,
+          patchEncoding: "utf8",
+          patch: expect.stringContaining("-base"),
+        }),
+      ]),
+    );
+
+    await expect(
+      Promise.all([
+        readFile(path.join(repository.rootPath, ".git", "config"), "utf8"),
+        readFile(path.join(repository.rootPath, ".git", "HEAD"), "utf8"),
+        readFile(path.join(repository.rootPath, ".git", "index")),
+        readFile(
+          path.join(repository.rootPath, ".git", "refs", "heads", "main"),
+          "utf8",
+        ),
+        readFile(path.join(repository.rootPath, "README.md"), "utf8"),
+      ]),
+    ).resolves.toEqual(before);
+  });
+
+  it("attests one canonical current origin remote and refuses invalid identity", async () => {
+    const repository = await createRepository();
+    const request = {
+      type: "host.inspect_environment_git_objects" as const,
+      rootPath: repository.rootPath,
+      commitOid: repository.commitOid,
+      maxOutputBytes: 64 * 1024,
+      selections: [
+        { id: "tree", kind: "tree" as const, path: "", recursive: false },
+      ],
+    };
+
+    await runGit(repository.rootPath, [
+      "remote",
+      "set-url",
+      "origin",
+      "git@GITHUB.COM:PhosphorCo/bb.git",
+    ]);
+    await expect(inspectEnvironmentGitObjects(request)).resolves.toMatchObject({
+      outcome: "ok",
+      originRemote: {
+        host: "github.com",
+        repositoryPath: "PhosphorCo/bb",
+        transport: "ssh",
+      },
+    });
+
+    await runGit(repository.rootPath, ["remote", "remove", "origin"]);
+    await expect(inspectEnvironmentGitObjects(request)).resolves.toEqual({
+      outcome: "unavailable",
+      reason: "origin_remote_missing",
+    });
+
+    await runGit(repository.rootPath, [
+      "remote",
+      "add",
+      "origin",
+      "file:///tmp/not-a-remote-identity",
+    ]);
+    await expect(inspectEnvironmentGitObjects(request)).resolves.toEqual({
+      outcome: "unavailable",
+      reason: "origin_remote_invalid",
+    });
+
+    await runGit(repository.rootPath, [
+      "config",
+      "--add",
+      "remote.origin.url",
+      "https://github.com/PhosphorCo/other.git",
+    ]);
+    await expect(inspectEnvironmentGitObjects(request)).resolves.toEqual({
+      outcome: "unavailable",
+      reason: "origin_remote_ambiguous",
+    });
+  });
+
+  it("ignores replacement refs for pinned commit, tree, blob, and diff reads", async () => {
+    const repository = await createRepository();
+    await writeFile(
+      path.join(repository.rootPath, "README.md"),
+      "replacement\n",
+      "utf8",
+    );
+    await runGit(repository.rootPath, ["add", "README.md"]);
+    await runGit(repository.rootPath, ["commit", "-m", "replacement"]);
+    const replacementCommitOid = (
+      await runGit(repository.rootPath, ["rev-parse", "HEAD"])
+    ).trim();
+    await runGit(repository.rootPath, [
+      "replace",
+      repository.commitOid,
+      replacementCommitOid,
+    ]);
+
+    const result = await inspectEnvironmentGitObjects({
+      type: "host.inspect_environment_git_objects",
+      rootPath: repository.rootPath,
+      commitOid: repository.commitOid,
+      maxOutputBytes: 64 * 1024,
+      selections: [
+        { id: "tree", kind: "tree", path: "", recursive: true },
+        { id: "blob", kind: "blob", path: "README.md" },
+        {
+          id: "diff",
+          kind: "diff",
+          baseCommitOid: repository.baseCommitOid,
+          paths: ["README.md"],
+        },
+      ],
+    });
+
+    expect(result).toMatchObject({
+      outcome: "ok",
+      commitOid: repository.commitOid,
+      treeOid: repository.treeOid,
+    });
+    if (result.outcome !== "ok") throw new Error("Expected Git inspection");
+    expect(result.values).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          id: "tree",
+          entries: expect.arrayContaining([
+            expect.objectContaining({
+              path: "README.md",
+              objectOid: repository.readmeBlobOid,
+            }),
+          ]),
+        }),
+        expect.objectContaining({
+          id: "blob",
+          blobOid: repository.readmeBlobOid,
+          content: Buffer.from("head\n").toString("base64"),
+        }),
+        expect.objectContaining({
+          id: "diff",
+          patch: expect.stringContaining("+head"),
+        }),
+      ]),
+    );
+  });
+
+  it("rejects path escape, symbolic expectations, and output truncation", async () => {
+    const repository = await createRepository();
+    await expect(
+      inspectEnvironmentGitObjects({
+        type: "host.inspect_environment_git_objects",
+        rootPath: repository.rootPath,
+        commitOid: repository.commitOid,
+        maxOutputBytes: 64 * 1024,
+        selections: [{ id: "escape", kind: "blob", path: "../README.md" }],
+      }),
+    ).resolves.toEqual({
+      outcome: "unavailable",
+      reason: "object_unreachable",
+    });
+    await expect(
+      inspectEnvironmentGitObjects({
+        type: "host.inspect_environment_git_objects",
+        rootPath: repository.rootPath,
+        commitOid: repository.commitOid,
+        expectedCommitTreeOid: "0".repeat(40),
+        maxOutputBytes: 64 * 1024,
+        selections: [{ id: "tree", kind: "tree", path: "", recursive: false }],
+      }),
+    ).resolves.toEqual({
+      outcome: "unavailable",
+      reason: "object_unreachable",
+    });
+    await expect(
+      inspectEnvironmentGitObjects({
+        type: "host.inspect_environment_git_objects",
+        rootPath: repository.rootPath,
+        commitOid: repository.commitOid,
+        maxOutputBytes: 8,
+        selections: [{ id: "blob", kind: "blob", path: "README.md" }],
+      }),
+    ).resolves.toEqual({ outcome: "unavailable", reason: "output_limit" });
+  });
+
+  it("labels an LFS pointer without fetching external content", async () => {
+    const repository = await createRepository();
+    const result = await inspectEnvironmentGitObjects({
+      type: "host.inspect_environment_git_objects",
+      rootPath: repository.rootPath,
+      commitOid: repository.commitOid,
+      maxOutputBytes: 64 * 1024,
+      selections: [{ id: "pointer", kind: "blob", path: "pointer.txt" }],
+    });
+    expect(result).toMatchObject({
+      outcome: "ok",
+      values: [
+        expect.objectContaining({
+          id: "pointer",
+          externalContent: {
+            kind: "git-lfs-pointer",
+            oid: "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+            sizeBytes: 42,
+          },
+        }),
+      ],
+    });
+  });
+
+  it("refuses recursive proof when a committed tree contains a submodule", async () => {
+    const repository = await createRepository();
+    await runGit(repository.rootPath, [
+      "update-index",
+      "--add",
+      "--cacheinfo",
+      `160000,${"d".repeat(40)},vendor/submodule`,
+    ]);
+    await runGit(repository.rootPath, ["commit", "-m", "submodule"]);
+    const submoduleCommitOid = (
+      await runGit(repository.rootPath, ["rev-parse", "HEAD"])
+    ).trim();
+
+    await expect(
+      inspectEnvironmentGitObjects({
+        type: "host.inspect_environment_git_objects",
+        rootPath: repository.rootPath,
+        commitOid: submoduleCommitOid,
+        maxOutputBytes: 64 * 1024,
+        selections: [{ id: "tree", kind: "tree", path: "", recursive: true }],
+      }),
+    ).resolves.toEqual({ outcome: "unavailable", reason: "tree_incomplete" });
+  });
+
+  it("refuses recursive proof when a listed blob object is unavailable", async () => {
+    const repository = await createRepository();
+    const objectPath = path.join(
+      repository.rootPath,
+      ".git",
+      "objects",
+      repository.readmeBlobOid.slice(0, 2),
+      repository.readmeBlobOid.slice(2),
+    );
+    await rm(objectPath);
+    await expect(
+      runGit(repository.rootPath, ["ls-tree", "-r", "HEAD", "--", "README.md"]),
+    ).resolves.toContain(repository.readmeBlobOid);
+
+    await expect(
+      inspectEnvironmentGitObjects({
+        type: "host.inspect_environment_git_objects",
+        rootPath: repository.rootPath,
+        commitOid: repository.commitOid,
+        maxOutputBytes: 64 * 1024,
+        selections: [{ id: "tree", kind: "tree", path: "", recursive: true }],
+      }),
+    ).resolves.toEqual({ outcome: "unavailable", reason: "tree_incomplete" });
+  });
+});
