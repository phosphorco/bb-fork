Subject: [PATCH] test(provider-pi): allow loaded local-file cases

---
 plugins/provider-pi/src/bridge/bridge.local-file.test.ts | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/plugins/provider-pi/src/bridge/bridge.local-file.test.ts b/plugins/provider-pi/src/bridge/bridge.local-file.test.ts
index c72a6508a..ef968a3dc 100644
--- a/plugins/provider-pi/src/bridge/bridge.local-file.test.ts
+++ b/plugins/provider-pi/src/bridge/bridge.local-file.test.ts
@@ -7,6 +7,7 @@ import {
 } from "./test-support.js";
 
 let harness: FakePiBridgeHarness;
+const LOCAL_FILE_TEST_TIMEOUT_MS = 15_000;
 
 beforeEach(async () => {
   harness = await startFakePiBridge({
@@ -56,7 +57,7 @@ it("includes local file paths in turn prompts", async () => {
         String(delta.text).includes(`Read this file.\n${marker}`),
     ),
   ).toBe(true);
-});
+}, LOCAL_FILE_TEST_TIMEOUT_MS);
 
 it("accepts a turn prompt that contains only a local file", async () => {
   const threadId = "thr_local_file_only";
@@ -73,7 +74,7 @@ it("accepts a turn prompt that contains only a local file", async () => {
 
   expect(response.error).toBeUndefined();
   expect(response.result).toEqual({ threadId });
-});
+}, LOCAL_FILE_TEST_TIMEOUT_MS);
 
 it("includes local file paths in steer prompts", async () => {
   const threadId = "thr_local_file_steer";
@@ -108,4 +109,4 @@ it("includes local file paths in steer prompts", async () => {
         String(delta.text).includes(marker),
     ),
   ).toBe(true);
-});
+}, LOCAL_FILE_TEST_TIMEOUT_MS);
