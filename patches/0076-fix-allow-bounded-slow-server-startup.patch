index 93d3880c0c5645d6a273ed4beef822a7df368949..696f8045449ac977a501f3be01bcc960f24d7791 100644
--- a/packages/bb-app/test/server-health-identity.test.ts
+++ b/packages/bb-app/test/server-health-identity.test.ts
@@ -6,7 +6,7 @@ import {
 } from "node:http";
 import { tmpdir } from "node:os";
 import { dirname, join } from "node:path";
-import { afterEach, describe, expect, it } from "vitest";
+import { afterEach, describe, expect, it, vi } from "vitest";
 import type {
   BbAppStartContext,
   ManagedFullStackProcesses,
@@ -94,6 +94,55 @@ function createStartContext(args: {
 }
 
 describe("waitForServerHealth", () => {
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.unstubAllGlobals();
+  });
+
+  it("allows a legitimate server startup beyond sixty seconds", async () => {
+    vi.useFakeTimers();
+    const started = Date.now();
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(
+        async () =>
+          new Response(
+            JSON.stringify({
+              ok: true,
+              launchId:
+                Date.now() - started >= 120_000 ? "slow-launch" : "not-ready",
+            }),
+            { status: 200, headers: { "content-type": "application/json" } },
+          ),
+      ),
+    );
+    const ready = waitForServerHealth({
+      childProcess: null,
+      expectedLaunchId: "slow-launch",
+      url: "http://127.0.0.1:1/health",
+    });
+    await vi.advanceTimersByTimeAsync(120_100);
+    await expect(ready).resolves.toBeUndefined();
+  });
+
+  it("keeps the longer server startup deadline finite", async () => {
+    vi.useFakeTimers();
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async () => new Response("{}", { status: 503 })),
+    );
+    const outcome = waitForServerHealth({
+      childProcess: null,
+      expectedLaunchId: "never",
+      url: "http://127.0.0.1:1/health",
+    }).then(
+      () => null,
+      (error) => error,
+    );
+    await vi.advanceTimersByTimeAsync(180_200);
+    await expect(outcome).resolves.toBeInstanceOf(Error);
+  });
+
   it("keeps polling past foreign answers until the child echoes its launch id", async () => {
