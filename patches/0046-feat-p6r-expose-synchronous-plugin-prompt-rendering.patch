diff --git a/apps/server/src/services/prompts/render-prompt.test.ts b/apps/server/src/services/prompts/render-prompt.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6eb81a22f9ef40bc20444c06b5c717b7b6c85e63
--- /dev/null
+++ b/apps/server/src/services/prompts/render-prompt.test.ts
@@ -0,0 +1,283 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { renderTemplate, getTemplateBody } from "@bb/templates";
+import type {
+  P6rPromptMiddleware,
+  P6rPromptObservation,
+  P6rPromptRequest,
+} from "@get-bb/plugin-sdk";
+import {
+  renderPrompt,
+  renderPromptTemplate,
+  setPromptProvider,
+} from "./render-prompt.js";
+
+const request: P6rPromptRequest = {
+  id: "selected",
+  kind: "instruction",
+  text: " default \n",
+};
+afterEach(() => setPromptProvider(undefined));
+function setup(
+  middleware: P6rPromptMiddleware[],
+  observers: ((sample: P6rPromptObservation) => void)[] = [],
+) {
+  const warn = vi.fn();
+  setPromptProvider({
+    middleware: () =>
+      middleware.map((middleware, index) => ({
+        pluginId: `p${index}`,
+        name: "rewrite",
+        middleware,
+      })),
+    observers: () =>
+      observers.map((observer, index) => ({
+        pluginId: `o${index}`,
+        name: "sample",
+        observer,
+      })),
+    warn,
+  });
+  return warn;
+}
+
+describe("prompt rendering", () => {
+  it("preserves bytes and original template provenance", () => {
+    expect(renderPrompt(request)).toBe(request.text);
+    const sample = vi.fn();
+    setup([], [sample]);
+    const inputs = { senderThreadId: "thr_sender", messageText: "<literal>" };
+    expect(
+      renderPromptTemplate("agentThreadMessage", inputs, {
+        threadId: "thr_target",
+      }),
+    ).toBe(renderTemplate("agentThreadMessage", inputs));
+    expect(sample.mock.calls[0]?.[0].request).toEqual({
+      id: "agentThreadMessage",
+      kind: "template",
+      text: renderTemplate("agentThreadMessage", inputs),
+      template: getTemplateBody("agentThreadMessage"),
+      inputs,
+      context: { threadId: "thr_target" },
+    });
+  });
+  it("composes text-only continuation with fixed immutable provenance", () => {
+    const sample = vi.fn();
+    setup(
+      [
+        (received, next) => {
+          expect(received.text).toBe(request.text);
+          return next("first");
+        },
+        (received, next) => {
+          expect(received.text).toBe("first");
+          expect(received.inputs).toEqual({ value: "source" });
+          expect(Object.isFrozen(received.inputs)).toBe(true);
+          expect(Object.isFrozen(received.context)).toBe(true);
+          expect(Object.isFrozen(received.slots)).toBe(true);
+          return next(`${received.text} second`);
+        },
+      ],
+      [sample],
+    );
+    const inputs = { value: "source" };
+    expect(
+      renderPrompt({
+        ...request,
+        inputs,
+        context: { threadId: "t" },
+        slots: [],
+      }),
+    ).toBe("first second");
+    expect(Object.isFrozen(inputs)).toBe(false);
+    expect(sample.mock.calls[0]?.[0].middleware).toEqual([
+      { pluginId: "p0", name: "rewrite" },
+      { pluginId: "p1", name: "rewrite" },
+    ]);
+  });
+  it("supports selected rewrite, passthrough and short-circuiting", () => {
+    const skipped = vi.fn();
+    setup([
+      (received, next) => (received.id === "selected" ? "replacement" : next()),
+      skipped,
+    ]);
+    expect(renderPrompt(request)).toBe("replacement");
+    expect(skipped).not.toHaveBeenCalled();
+    setup([
+      (received, next) => (received.id === "selected" ? "replacement" : next()),
+    ]);
+    expect(renderPrompt({ ...request, id: "other" })).toBe(request.text);
+  });
+  it.each([
+    [
+      "throw",
+      () => {
+        throw new Error("failed");
+      },
+    ],
+    ["non-string", () => 4],
+    ["promise", () => Promise.reject(new Error("async"))],
+    [
+      "double next",
+      (_: unknown, next: () => string) => {
+        next();
+        try {
+          next();
+        } catch {}
+        return "ignored";
+      },
+    ],
+    [
+      "invalid continuation",
+      (_: unknown, next: (text?: unknown) => string) => next(3),
+    ],
+  ])(
+    "falls back and observes rejected %s middleware",
+    async (_, middleware) => {
+      const sample = vi.fn();
+      const warn = setup([middleware as P6rPromptMiddleware], [sample]);
+      expect(renderPrompt(request)).toBe(request.text);
+      expect(sample.mock.calls[0]?.[0].fallback).toMatchObject({
+        pluginId: "p0",
+        name: "rewrite",
+      });
+      expect(warn).toHaveBeenCalledWith(
+        expect.stringContaining(
+          'Prompt "selected" middleware p0/rewrite failed; using default',
+        ),
+      );
+      await Promise.resolve();
+    },
+  );
+  it("falls back across enclosing middleware even when it rewrites the downstream fallback", () => {
+    setup([
+      (_, next) => next() + "outer",
+      () => {
+        throw new Error("inner");
+      },
+    ]);
+    expect(renderPrompt(request)).toBe(request.text);
+  });
+  it("expands protected slots in observations and isolates observers", () => {
+    const samples: P6rPromptObservation[] = [];
+    const warn = setup(
+      [(_, next) => next("after TOKEN before")],
+      [
+        (sample) => {
+          expect(Object.isFrozen(sample.request.slots?.[0])).toBe(true);
+          throw new Error("observer");
+        },
+        (sample) => samples.push(sample),
+      ],
+    );
+    const original = {
+      ...request,
+      text: "before TOKEN after",
+      slots: [{ token: "TOKEN", text: "@thread" }],
+    };
+    expect(renderPrompt(original)).toBe("after TOKEN before");
+    expect(samples[0]).toMatchObject({
+      defaultText: "before @thread after",
+      finalText: "after @thread before",
+    });
+    expect(warn).toHaveBeenCalledWith(
+      expect.stringContaining("observer o0/sample failed"),
+    );
+    expect(original.slots[0]?.text).toBe("@thread");
+  });
+  it.each(["missing", "TOKEN TOKEN"])(
+    "falls back on protected output %s",
+    (output) => {
+      const sample = vi.fn();
+      setup([() => output], [sample]);
+      expect(
+        renderPrompt({
+          ...request,
+          text: "TOKEN",
+          slots: [{ token: "TOKEN", text: "@thread" }],
+        }),
+      ).toBe("TOKEN");
+      expect(sample.mock.calls[0]?.[0]).toMatchObject({
+        defaultText: "@thread",
+        finalText: "@thread",
+        fallback: { pluginId: "p0" },
+      });
+    },
+  );
+  it("rejects malformed caller slots even without plugins", () => {
+    expect(() =>
+      renderPrompt({
+        ...request,
+        slots: [{ token: "absent", text: "visible" }],
+      }),
+    ).toThrow("Protected slot");
+  });
+  it("rejects late continuation without running more middleware", () => {
+    let continuation: (() => string) | undefined;
+    const later = vi.fn((_: unknown, next: () => string) => next());
+    setup([
+      (_, next) => {
+        continuation = next;
+        return "complete";
+      },
+      later,
+    ]);
+    expect(renderPrompt(request)).toBe("complete");
+    expect(() => continuation?.()).toThrow("no longer active");
+    expect(later).not.toHaveBeenCalled();
+  });
+
+  it("treats replacement syntax in visible slot text literally", () => {
+    const sample = vi.fn();
+    setup([], [sample]);
+    const text = "$& $` $' $$";
+    expect(
+      renderPrompt({
+        ...request,
+        text: "before TOKEN after",
+        slots: [{ token: "TOKEN", text }],
+      }),
+    ).toBe("before TOKEN after");
+    expect(sample.mock.calls[0]?.[0]).toMatchObject({
+      defaultText: `before ${text} after`,
+      finalText: `before ${text} after`,
+    });
+  });
+  it.each([
+    { id: 7 },
+    { id: "" },
+    { kind: "unknown" },
+    { inputs: { value: 7 } },
+    { inputs: [] },
+    { context: { threadId: 7 } },
+    { context: null },
+    { slots: [{ token: "TOKEN", text: 7 }] },
+    { slots: "invalid" },
+    { template: 7 },
+  ])("rejects malformed public request %j", (invalid) => {
+    expect(() =>
+      renderPrompt({ ...request, ...invalid } as P6rPromptRequest),
+    ).toThrow();
+  });
+  it("falls back and reports reentrant rendering by the same prompt ID", () => {
+    const sample = vi.fn();
+    setup([(received) => renderPrompt(received)], [sample]);
+    expect(renderPrompt(request)).toBe(request.text);
+    expect(sample.mock.calls[0]?.[0].fallback.reason).toContain(
+      "Recursive prompt rendering",
+    );
+    setup([(_, next) => next()]);
+    expect(renderPrompt(request)).toBe(request.text);
+  });
+
+  it("logs rejected asynchronous observers without changing output", async () => {
+    const warn = setup([], [() => Promise.reject(new Error("async observer"))]);
+    expect(renderPrompt(request)).toBe(request.text);
+    await Promise.resolve();
+    expect(warn).toHaveBeenCalledWith(
+      expect.stringContaining("observer o0/sample must be synchronous"),
+    );
+    expect(warn).toHaveBeenCalledWith(
+      expect.stringContaining("observer o0/sample rejected: async observer"),
+    );
+  });
+});
