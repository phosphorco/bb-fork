diff --git a/packages/plugin-sdk/src/internal/p6r-prompt-rendering.ts b/packages/plugin-sdk/src/internal/p6r-prompt-rendering.ts
new file mode 100644
index 0000000000000000000000000000000000000000..13e1580cae205392a5e69e28bcc14895ace0f3dd
--- /dev/null
+++ b/packages/plugin-sdk/src/internal/p6r-prompt-rendering.ts
@@ -0,0 +1,243 @@
+import type {
+  P6rPromptMiddleware,
+  P6rPromptObservation,
+  P6rPromptRequest,
+} from "../backend-contract.js";
+
+export interface P6rPromptProvider {
+  middleware(): readonly {
+    pluginId: string;
+    name: string;
+    middleware: P6rPromptMiddleware;
+  }[];
+  observers(): readonly {
+    pluginId: string;
+    name: string;
+    observer: (sample: P6rPromptObservation) => void;
+  }[];
+  warn(message: string): void;
+}
+function isPromptRecord(value: unknown): value is Record<string, unknown> {
+  return (
+    value !== null &&
+    typeof value === "object" &&
+    (Object.getPrototypeOf(value) === Object.prototype ||
+      Object.getPrototypeOf(value) === null)
+  );
+}
+
+export function validateP6rPromptRequest(
+  request: unknown,
+): asserts request is P6rPromptRequest {
+  if (
+    !isPromptRecord(request) ||
+    !("id" in request) ||
+    typeof request.id !== "string" ||
+    !request.id.trim() ||
+    !("kind" in request) ||
+    typeof request.kind !== "string" ||
+    ![
+      "template",
+      "instruction",
+      "tool-description",
+      "schema-description",
+      "message",
+      "skill",
+      "guide",
+      "tool-result",
+    ].includes(request.kind) ||
+    !("text" in request) ||
+    typeof request.text !== "string"
+  ) {
+    throw new Error("Invalid prompt id, kind or default text");
+  }
+  const keys = ["id", "kind", "text", "template", "inputs", "context", "slots"];
+  if (Object.keys(request).some((key) => !keys.includes(key)))
+    throw new Error("Invalid prompt request field");
+  if (
+    "template" in request &&
+    request.template !== undefined &&
+    typeof request.template !== "string"
+  )
+    throw new Error("Invalid prompt template");
+  if ("inputs" in request && request.inputs !== undefined) {
+    if (
+      !isPromptRecord(request.inputs) ||
+      Object.values(request.inputs).some((value) => typeof value !== "string")
+    )
+      throw new Error("Prompt inputs must be a string record");
+  }
+  if ("context" in request && request.context !== undefined) {
+    if (
+      !isPromptRecord(request.context) ||
+      Object.entries(request.context).some(
+        ([key, value]) =>
+          !["threadId", "projectId", "providerId", "sourcePluginId"].includes(
+            key,
+          ) ||
+          (value !== undefined && typeof value !== "string"),
+      )
+    )
+      throw new Error("Invalid prompt context");
+  }
+  if ("slots" in request && request.slots !== undefined) {
+    if (
+      !Array.isArray(request.slots) ||
+      request.slots.some(
+        (slot: unknown) =>
+          !isPromptRecord(slot) ||
+          typeof slot.token !== "string" ||
+          !slot.token ||
+          typeof slot.text !== "string" ||
+          Object.keys(slot).some((key) => key !== "token" && key !== "text"),
+      )
+    )
+      throw new Error("Invalid protected prompt slots");
+  }
+}
+
+function immutable<T>(value: T): T {
+  const copy = structuredClone(value);
+  function freeze(item: unknown): void {
+    if (item === null || typeof item !== "object") return;
+    for (const child of Object.values(item)) freeze(child);
+    Object.freeze(item);
+  }
+  freeze(copy);
+  return copy;
+}
+
+function validateSlots(request: P6rPromptRequest, text: string): void {
+  const seen = new Set<string>();
+  for (const slot of request.slots ?? []) {
+    if (!slot.token || seen.has(slot.token))
+      throw new Error("Invalid protected slot declaration");
+    seen.add(slot.token);
+    if (text.split(slot.token).length !== 2)
+      throw new Error("Protected slot must appear exactly once");
+  }
+}
+
+function visible(request: P6rPromptRequest, text: string): string {
+  for (const slot of request.slots ?? [])
+    text = text.replace(slot.token, () => slot.text);
+  return text;
+}
+
+export function createP6rPromptRenderer(
+  getProvider: () => P6rPromptProvider | undefined,
+): (request: P6rPromptRequest) => string {
+  const rendering = new Set<string>();
+  return function renderPrompt(request: P6rPromptRequest): string {
+    validateP6rPromptRequest(request);
+    const active = getProvider();
+    const registrations = active?.middleware() ?? [];
+    const observers = active?.observers() ?? [];
+    if (registrations.length === 0 && observers.length === 0) {
+      validateSlots(request, request.text);
+      return request.text;
+    }
+    if (rendering.has(request.id))
+      throw new Error(`Recursive prompt rendering "${request.id}"`);
+    rendering.add(request.id);
+    try {
+      const original = immutable(request);
+      validateSlots(original, original.text);
+      const attempted: { pluginId: string; name: string }[] = [];
+      let fallback: P6rPromptObservation["fallback"];
+      function dispatch(index: number, text: string): string {
+        const entry = registrations[index];
+        if (!entry) return text;
+        attempted.push({ pluginId: entry.pluginId, name: entry.name });
+        let called = false;
+        let running = true;
+        let violation: Error | undefined;
+        try {
+          const output: unknown = entry.middleware(
+            immutable({ ...original, text }),
+            (nextText = text) => {
+              if (!running)
+                throw new Error("Prompt continuation is no longer active");
+              if (called) {
+                violation = new Error("Prompt next() may only be called once");
+                throw violation;
+              }
+              called = true;
+              if (typeof nextText !== "string") {
+                violation = new Error("Prompt continuation must be a string");
+                throw violation;
+              }
+              return dispatch(index + 1, nextText);
+            },
+          );
+          if (violation) throw violation;
+          if (typeof output !== "string") {
+            if (
+              typeof output === "object" &&
+              output !== null &&
+              "then" in output &&
+              typeof output.then === "function"
+            ) {
+              void Promise.resolve(output).catch(() => {});
+            }
+            throw new Error(
+              "Prompt middleware must return a synchronous string",
+            );
+          }
+          validateSlots(original, output);
+          return output;
+        } catch (error) {
+          if (!fallback) {
+            fallback = {
+              pluginId: entry.pluginId,
+              name: entry.name,
+              reason: error instanceof Error ? error.message : String(error),
+            };
+            active?.warn(
+              `Prompt "${original.id}" middleware ${entry.pluginId}/${entry.name} failed; using default: ${fallback.reason}`,
+            );
+          }
+          return original.text;
+        } finally {
+          running = false;
+        }
+      }
+      const output = dispatch(0, original.text);
+      const finalText = fallback ? original.text : output;
+      const sample: P6rPromptObservation = {
+        request: original,
+        defaultText: visible(original, original.text),
+        finalText: visible(original, finalText),
+        middleware: attempted,
+        ...(fallback ? { fallback } : {}),
+      };
+      for (const entry of observers) {
+        try {
+          const result: unknown = entry.observer(immutable(sample));
+          if (
+            typeof result === "object" &&
+            result !== null &&
+            "then" in result &&
+            typeof result.then === "function"
+          ) {
+            void Promise.resolve(result).catch((error: unknown) =>
+              active?.warn(
+                `Prompt "${original.id}" observer ${entry.pluginId}/${entry.name} rejected: ${error instanceof Error ? error.message : String(error)}`,
+              ),
+            );
+            active?.warn(
+              `Prompt "${original.id}" observer ${entry.pluginId}/${entry.name} must be synchronous`,
+            );
+          }
+        } catch (error) {
+          active?.warn(
+            `Prompt "${original.id}" observer ${entry.pluginId}/${entry.name} failed: ${error instanceof Error ? error.message : String(error)}`,
+          );
+        }
+      }
+      return finalText;
+    } finally {
+      rendering.delete(request.id);
+    }
+  };
+}
