@@ -0,0 +1,36 @@
+import type { P6rPromptContext } from "@get-bb/plugin-sdk";
+import {
+  createP6rPromptRenderer,
+  type P6rPromptProvider,
+} from "@get-bb/plugin-sdk/internal/p6r-prompt-rendering";
+import {
+  getTemplateBody,
+  renderTemplate,
+  type TemplateId,
+  type TemplateVariables,
+} from "@bb/templates";
+export {
+  validateP6rPromptRequest,
+  type P6rPromptProvider,
+} from "@get-bb/plugin-sdk/internal/p6r-prompt-rendering";
+
+let provider: P6rPromptProvider | undefined;
+export function setPromptProvider(value: P6rPromptProvider | undefined): void {
+  provider = value;
+}
+export const renderPrompt = createP6rPromptRenderer(() => provider);
+
+export function renderPromptTemplate<T extends TemplateId>(
+  id: T,
+  variables: TemplateVariables[T],
+  context?: P6rPromptContext,
+): string {
+  return renderPrompt({
+    id,
+    kind: "template",
+    text: renderTemplate(id, variables),
+    template: getTemplateBody(id),
+    inputs: variables,
+    ...(context ? { context } : {}),
+  });
+}
