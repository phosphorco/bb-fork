+  function registerPrompt<T>(
+    entries: Map<string, T>,
+    name: string,
+    callback: T,
+  ): { dispose(): void } {
+    assertLive();
+    if (!name.trim() || typeof callback !== "function")
+      throw new Error("Prompt registration requires a name and function");
+    if (entries.has(name))
+      throw new Error(`Prompt registration "${name}" already exists`);
+    entries.set(name, callback);
+    let disposed = false;
+    const dispose = (): void => {
+      if (disposed) return;
+      disposed = true;
+      entries.delete(name);
+    };
+    disposeHooks.push(dispose);
+    return { dispose };
+  }
