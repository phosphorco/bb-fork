+        if (
+          presentation == null ||
+          typeof presentation.displayName !== "string" ||
+          presentation.displayName.length === 0 ||
+          presentation.displayName.length > 256 ||
+          !(
+            presentation.handle === null ||
+            (typeof presentation.handle === "string" &&
+              presentation.handle.length <= 256)
+          ) ||
+          !(
+            presentation.avatarUrl === null ||
+            (typeof presentation.avatarUrl === "string" &&
+              presentation.avatarUrl.length > 0 &&
+              presentation.avatarUrl.length <= 2048)
+          )
+        ) {
+          return failure(
+            "invalid-input",
+            "Provider target presentation is malformed",
+          );
+        }
+        return {
+          ok: true,
+          value: Object.freeze({
+            generation: state.generation,
+            person: Object.freeze(personValue.value),
+            presentation: Object.freeze({
+              displayName: presentation.displayName,
+              handle: presentation.handle,
+              avatarUrl: presentation.avatarUrl,
+            }),
+          }),
+        };
