+  it("holds queue claim and committed request-event cuts before dispatch", async () => {
+    await withTestHarness(async (harness) => {
+      const token = await armFaultBarrier(
+        harness.config.dataDir,
+        testFaultBarrierPoints.queueClaimBeforeRequest,
+      );
+      const { host } = seedHostSession(harness.deps, {
+        id: "host-test-fault-barrier-queue",
+      });
