+      .select()
+      .from(threadFacetPrincipalProfiles)
+      .where(eq(threadFacetPrincipalProfiles.threadId, threadId))
+      .orderBy(threadFacetPrincipalProfiles.memberPosition)
+      .all()
+      .map(omitUpdatedAt),
+    relations: harness.db
+      .select()
+      .from(threadFacetRelations)
+      .where(eq(threadFacetRelations.threadId, threadId))
+      .orderBy(threadFacetRelations.memberId)
+      .all()
+      .map(omitUpdatedAt),
+    snapshots: harness.db
+      .select()
+      .from(threadFacetSnapshots)
+      .where(and(eq(threadFacetSnapshots.threadId, threadId), eq(threadFacetSnapshots.localName, "participants")))
+      .all()
+      .map(omitUpdatedAt),
+  };
+}
+
+function snapshotUpdatedAt(harness: Harness, threadId: string) {
+  return harness.db
+    .select({ updatedAt: threadFacetSnapshots.updatedAt })
+    .from(threadFacetSnapshots)
+    .where(and(eq(threadFacetSnapshots.threadId, threadId), eq(threadFacetSnapshots.localName, "participants")))
+    .get()?.updatedAt;
+}
+
+function storedWatermark(harness: Harness, threadId: string) {
+  return harness.db
+    .select()
+    .from(p6rParticipantWatermarks)
+    .where(eq(p6rParticipantWatermarks.threadId, threadId))
+    .get();
+}
+
+function readPath(harness: Harness, threadId: string) {
+  return executeThreadFacetParticipantPage(harness.deps, { threadId, pageSize: 100 });
+}
+
+let clock = 1_800_000_000_000;
+function advanceClock() {
+  clock += 1_000;
+  vi.spyOn(Date, "now").mockReturnValue(clock);
+}
+
+function expectSkippedThenEqualToFullRebuild(harness: Harness, threadId: string) {
+  const before = snapshotUpdatedAt(harness, threadId);
+  advanceClock();
+  readPath(harness, threadId);
+  expect(snapshotUpdatedAt(harness, threadId), "an unchanged thread is not rebuilt").toBe(before);
+  const skipped = projection(harness, threadId);
+
+  harness.db.delete(p6rParticipantWatermarks).where(eq(p6rParticipantWatermarks.threadId, threadId)).run();
+  advanceClock();
+  readPath(harness, threadId);
+  expect(snapshotUpdatedAt(harness, threadId), "a missing watermark forces a full rebuild").toBe(clock);
+  expect(projection(harness, threadId)).toEqual(skipped);
+  return skipped;
+}
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+describe("participant projection watermarks", () => {
+  it("skips an unchanged events-only thread and matches a full rebuild", async () => {
+    await withTestHarness(async (harness) => {
+      advanceClock();
+      const thread = newThread(harness);
+      appendRequest(harness, thread.id, [person("ada", "Ada"), person("bo", "Bo")]);
+      appendRequest(harness, thread.id, [person("ada", "Ada Lovelace")]);
+      const result = expectSkippedThenEqualToFullRebuild(harness, thread.id);
+      expect(result.profiles.map((profile) => profile.displayName)).toEqual(["Ada Lovelace", "Bo"]);
+    });
+  });
+
+  it("skips an unchanged contributions-only thread and matches a full rebuild", async () => {
+    await withTestHarness(async (harness) => {
+      advanceClock();
+      const thread = newThread(harness);
+      acceptContribution(harness, thread.id, "contribution-1", 10, storedActor("cy", "Cy"), storedActor("cy", "Cy"));
+      acceptContribution(harness, thread.id, "contribution-2", 20, storedActor("di", "Di"), storedActor("cy", "Cy Editor"));
+      const result = expectSkippedThenEqualToFullRebuild(harness, thread.id);
+      expect(result.profiles.map((profile) => profile.principalKey)).toEqual(["person:fixture:cy", "person:fixture:di"]);
+    });
+  });
+
+  it("skips an unchanged mixed thread with overlapping keys and matches a full rebuild", async () => {
+    await withTestHarness(async (harness) => {
+      advanceClock();
+      const thread = newThread(harness);
+      acceptContribution(harness, thread.id, "contribution-1", 10, storedActor("ada", "Ada (contribution)"), storedActor("ada", "Ada (contribution)"));
+      appendRequest(harness, thread.id, [person("ada", "Ada (event)"), person("eve", "Eve")]);
+      acceptContribution(harness, thread.id, "contribution-2", 30, storedActor("fay", "Fay"), storedActor("fay", "Fay"));
+      expectSkippedThenEqualToFullRebuild(harness, thread.id);
+    });
+  });
+
+  it("detects a suffix delete, then skips after the reprojecting append", async () => {
+    await withTestHarness(async (harness) => {
+      advanceClock();
+      const thread = newThread(harness);
+      appendRequest(harness, thread.id, [person("ada", "Ada")]);
+      appendRequest(harness, thread.id, [person("bo", "Bo")]);
+      const bo = harness.db.select({ sequence: events.sequence }).from(events)
+        .where(and(eq(events.threadId, thread.id), eq(events.type, "client/turn/requested")))
+        .orderBy(events.sequence).all().at(-1)!;
+      const maxSequence = harness.db.select({ value: max(events.sequence) }).from(events).where(eq(events.threadId, thread.id)).get()!.value!;
+      harness.db.transaction(
+        (tx) => deleteThreadEventSuffixInTransaction(tx, { threadId: thread.id, cutoffSequence: bo.sequence, oldMaxSequence: maxSequence }),
+        { behavior: "immediate" },
+      );
+
+      advanceClock();
+      readPath(harness, thread.id);
+      expect(snapshotUpdatedAt(harness, thread.id), "a removed request event invalidates the watermark").toBe(clock);
+      expect(projection(harness, thread.id).profiles.map((profile) => profile.displayName)).toEqual(["Ada"]);
+
+      appendRequest(harness, thread.id, [person("cy", "Cy")]);
+      const result = expectSkippedThenEqualToFullRebuild(harness, thread.id);
+      expect(result.profiles.map((profile) => profile.displayName)).toEqual(["Ada", "Cy"]);
+    });
+  });
+
+  it("keeps a valid watermark across soft delete and undelete", async () => {
+    await withTestHarness(async (harness) => {
+      advanceClock();
+      const thread = newThread(harness);
+      appendRequest(harness, thread.id, [person("ada", "Ada")]);
+      harness.db.update(threads).set({ deletedAt: clock }).where(eq(threads.id, thread.id)).run();
+      harness.db.update(threads).set({ deletedAt: null }).where(eq(threads.id, thread.id)).run();
+      expectSkippedThenEqualToFullRebuild(harness, thread.id);
+    });
+  });
+
+  it("rebuilds when the stored projector version differs", async () => {
+    await withTestHarness(async (harness) => {
+      advanceClock();
+      const thread = newThread(harness);
+      appendRequest(harness, thread.id, [person("ada", "Ada")]);
+      harness.db.update(p6rParticipantWatermarks)
+        .set({ projectorVersion: P6R_PARTICIPANT_PROJECTOR_VERSION - 1 })
+        .where(eq(p6rParticipantWatermarks.threadId, thread.id)).run();
+      advanceClock();
+      readPath(harness, thread.id);
+      expect(snapshotUpdatedAt(harness, thread.id)).toBe(clock);
+      expect(storedWatermark(harness, thread.id)?.projectorVersion).toBe(P6R_PARTICIPANT_PROJECTOR_VERSION);
+    });
+  });
+
+  it("records the watermark in the same transaction as an event-append projection", async () => {
+    await withTestHarness(async (harness) => {
+      advanceClock();
+      const thread = newThread(harness);
+      expect(() =>
+        harness.db.transaction((tx) => {
+          appendClientTurnEventInTransaction(tx, {
+            threadId: thread.id, environmentId: null, type: "client/turn/requested",
+      originPluginId: null,
+            input: [{ type: "text", text: "Mention", mentions: [] }], p6rMentionedTargets: [person("ada", "Ada")],
+            execution: { model: "gpt-5", reasoningLevel: "medium", permissionMode: "full", serviceTier: "default", source: "client/turn/requested" },
+            initiator: "user", senderThreadId: null, requestMethod: "turn/start", source: "tell", target: { kind: "new-turn" },
+          });
+          throw new Error("rollback");
+        }, { behavior: "immediate" }),
+      ).toThrow("rollback");
+      expect(storedWatermark(harness, thread.id)).toBeUndefined();
+
+      appendRequest(harness, thread.id, [person("ada", "Ada")]);
+      const current = readP6rParticipantInputWatermarks(harness.db, [thread.id]).get(thread.id)!;
+      expect(storedWatermark(harness, thread.id)).toMatchObject(current);
+    });
+  });
+
+  it("rolls back a read-path rebuild when its watermark cannot be written", async () => {
+    await withTestHarness(async (harness) => {
+      advanceClock();
+      const thread = newThread(harness);
+      appendRequest(harness, thread.id, [person("ada", "Ada")]);
+      const before = projection(harness, thread.id);
+      harness.db.delete(p6rParticipantWatermarks).run();
+      harness.db.run(`CREATE TRIGGER fail_watermark BEFORE INSERT ON p6r_participant_watermarks BEGIN SELECT RAISE(ABORT, 'watermark write failed'); END;`);
+      harness.db.delete(threadFacetPrincipalProfiles).where(eq(threadFacetPrincipalProfiles.threadId, thread.id)).run();
+      expect(() => readPath(harness, thread.id)).toThrow("watermark write failed");
+      expect(projection(harness, thread.id).profiles).toEqual([]);
+      harness.db.run("DROP TRIGGER fail_watermark");
+      readPath(harness, thread.id);
+      expect(projection(harness, thread.id)).toEqual(before);
+    });
+  });
+});
