+import { mkdir, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { listCoreParticipantProfilePage, listEvents } from "@bb/db";
+import { turnRequestEventDataSchema, type PromptInput } from "@bb/domain";
+import { eq } from "drizzle-orm";
+import { createAiServiceRegistry } from "../../../src/services/ai/ai-service-registry.js";
+import { createP6rProviderRegistry } from "../../../src/services/p6r/provider-registry.js";
+import { p6rContributions } from "../../../src/services/p6r/sidecar-schema.js";
+import { setPluginAgentContributions } from "../../../src/services/plugins/plugin-agent-contributions.js";
+import { createPluginService } from "../../../src/services/plugins/plugin-service.js";
+import { sendQueuedMessage } from "../../../src/services/threads/queued-messages.js";
+import { createThreadFromRequest } from "../../../src/services/threads/thread-create.js";
+import { sendThreadMessage } from "../../../src/services/threads/thread-send.js";
+import { waitForQueuedCommand } from "../../helpers/commands.js";
+import {
+  seedEnvironment,
+  seedHostSession,
+  seedProjectWithSource,
+  seedQueuedMessage,
+  seedThread,
+  seedThreadRuntimeState,
+} from "../../helpers/seed.js";
+import { createTestAppHarness, testLogger } from "../../helpers/test-app.js";
+import { createNoopTelemetryService } from "../../../src/services/system/telemetry.js";
+
+afterEach(() => setPluginAgentContributions(undefined));
+const input: PromptInput[] = [
+  {
+    type: "text",
+    text: "@Verified target",
+    mentions: [
+      {
+        start: 0,
+        end: 16,
+        resource: {
+          kind: "plugin",
+          pluginId: "verified-mentions",
+          itemId: "person:42",
+          label: "Verified target",
+        },
+      },
+    ],
+  },
+];
+
+async function installVerifiedMentionResolver(
+  harness: Awaited<ReturnType<typeof createTestAppHarness>>,
+) {
+  const registry = createP6rProviderRegistry({ now: Date.now });
+  const prepared = await registry.prepare({
+    configuration: {
+      version: 1,
+      boundaryId: "mention-service-paths",
+      pluginId: "verified-mentions",
+      ingressIds: ["fixture"],
+      credentials: [],
+      resolver: { timeoutMs: 100 },
+    },
+    generation: "mention-service-paths-generation",
+    deadlineAt: Date.now() + 1_000,
+    provider: {
+      issuers: ["fixture:people"],
+      resolve: async () => ({ status: "not-applicable" }),
+      lookup: async (subjects) => ({
+        ok: true,
+        value: {
+          revision: "directory-revision",
+          records: subjects.map(({ issuer, subject }) => ({
+            issuer,
+            subject,
+            record: {
+              issuer,
+              subject,
+              status: "current",
+              presentation: {
+                displayName: "Directory verified target",
+                handle: "verified-target",
+                avatarUrl: null,
+              },
+            },
+          })),
+        },
+      }),
+    },
+  });
+  if (!prepared.ok)
+    throw new Error("could not prepare mention target provider");
+  expect(registry.publish(prepared.value).ok).toBe(true);
+  const pluginRoot = join(harness.config.dataDir, "verified-mentions");
+  await mkdir(pluginRoot);
+  await writeFile(
+    join(pluginRoot, "package.json"),
+    JSON.stringify({
+      name: "bb-plugin-verified-mentions",
+      version: "0.1.0",
+      bb: {
+        name: "Verified mentions",
+        description: "Fixture",
+        branding: { icon: "User" },
+        server: "./server.ts",
+      },
+    }),
+  );
+  await writeFile(
+    join(pluginRoot, "server.ts"),
+    `export default function (bb) { bb.ui.registerMentionProvider({ id: "person", label: "Person", search: () => [], resolve: () => ({ context: "verified mention context", experimental_target: { kind: "p6r-person", issuer: "fixture:people", subject: "42" } }) }); }`,
+  );
+  const service = createPluginService({
+    db: harness.db,
+    dataDir: join(harness.config.dataDir, "verified-mention-service"),
+    appVersion: "0.40.0",
+    hub: harness.deps.hub,
+    logger: testLogger,
+    aiServices: createAiServiceRegistry(),
+    telemetry: createNoopTelemetryService(),
+    p6rProviderRegistry: registry,
+  });
+  const installed = await service.installPath(pluginRoot);
+  expect(installed.status, installed.statusDetail ?? "").toBe("running");
+  const resolveMention = vi.spyOn(service, "resolveMention");
+  setPluginAgentContributions(service);
+  const resolved = await service.resolveMention({
+    pluginId: "verified-mentions",
+    itemId: "person:42",
+  });
+  if (!resolved.ok || !resolved.target)
+    throw new Error("expected a normalized mention target");
+  resolveMention.mockClear();
+  return { service, target: resolved.target, resolveMention };
+}
+
+function seedFixture(
+  harness: Awaited<ReturnType<typeof createTestAppHarness>>,
+  value: number,
+  warm = false,
+) {
+  const { host } = seedHostSession(harness.deps, {
+    id: `host-mention-path-${value}`,
+  });
+  const { project } = seedProjectWithSource(harness.deps, {
+    hostId: host.id,
+    path: `/tmp/mention-path-${value}`,
+  });
+  const environment = seedEnvironment(harness.deps, {
+    hostId: host.id,
+    projectId: project.id,
+    path: `/tmp/mention-path-${value}`,
+    status: "ready",
+  });
+  const thread = seedThread(harness.deps, {
+    projectId: project.id,
+    environmentId: environment.id,
+    status: "idle",
+  });
+  if (warm)
+    seedThreadRuntimeState(harness.deps, {
+      environmentId: environment.id,
+      providerThreadId: `provider-mention-path-${value}`,
+      threadId: thread.id,
+    });
+  return { environment, project, thread };
+}
+
+function expectPersistedMentionTarget(
+  harness: Awaited<ReturnType<typeof createTestAppHarness>>,
+  threadId: string,
+  afterSequence: number,
+  target: { identity: { key: string }; presentation: { displayName: string } },
+) {
+  const requests = listEvents(harness.db, { threadId }).filter(
+    (candidate) =>
+      candidate.type === "client/turn/requested" &&
+      candidate.sequence > afterSequence,
+  );
+  expect(requests).toHaveLength(1);
+  const event = requests[0];
+  if (!event) throw new Error("expected client turn request event");
+  const rawRequest = JSON.parse(event.data);
+  expect(rawRequest.p6rMentionedTargets).toEqual([target]);
+  const request = turnRequestEventDataSchema.parse(rawRequest);
+  expect(request.p6rMentionedTargets).toEqual([target]);
+  expect(
+    listCoreParticipantProfilePage(harness.db, { threadId, pageSize: 10 })
+      .profiles,
+  ).toMatchObject([
+    {
+      p6rPrincipalKey: target.identity.key,
+      p6rDisplayName: target.presentation.displayName,
+    },
+  ]);
+  expect(
+    harness.db
+      .select()
+      .from(p6rContributions)
+      .where(eq(p6rContributions.threadId, threadId))
+      .all(),
+  ).toHaveLength(0);
+}
+
+it("persists a normalized mention target through create, live send, and queued dispatch without authorship", async () => {
+  const harness = await createTestAppHarness();
+  const { service, target, resolveMention } =
+    await installVerifiedMentionResolver(harness);
+  try {
+    const createdFixture = seedFixture(harness, 1);
+    const created = await createThreadFromRequest(harness.deps, {
+      environment: {
+        type: "reuse",
+        environmentId: createdFixture.environment.id,
+      },
+      input,
+      origin: "app",
+      projectId: createdFixture.project.id,
+      providerId: "codex",
+      startedOnBehalfOf: null,
+    });
+    expect(resolveMention).toHaveBeenCalledWith({
+      pluginId: "verified-mentions",
+      itemId: "person:42",
+    });
+    await expect(resolveMention.mock.results[0]?.value).resolves.toMatchObject({
+      ok: true,
+      target,
+    });
+    expectPersistedMentionTarget(harness, created.id, 0, target);
+    const liveFixture = seedFixture(harness, 2);
+    const beforeLiveSend = Math.max(
+      0,
+      ...listEvents(harness.db, { threadId: liveFixture.thread.id }).map(
+        (event) => event.sequence,
+      ),
+    );
+    await sendThreadMessage(harness.deps, {
+      originPluginId: null,
+      environment: liveFixture.environment,
+      payload: {
+        input,
+        mode: "start",
+        model: "gpt-5",
+        permissionMode: "full",
+        reasoningLevel: "medium",
+        serviceTier: "default",
+      },
+      thread: liveFixture.thread,
+      trigger: "user",
+    });
+    await waitForQueuedCommand(
+      harness,
+      (candidate) =>
+        candidate.command.type === "thread.start" &&
+        candidate.command.threadId === liveFixture.thread.id,
+    );
+    expectPersistedMentionTarget(
+      harness,
+      liveFixture.thread.id,
+      beforeLiveSend,
+      target,
+    );
+    const queuedFixture = seedFixture(harness, 3, true);
+    const queued = seedQueuedMessage(harness.deps, {
+      threadId: queuedFixture.thread.id,
+      content: input,
+    });
+    const beforeQueuedDispatch = Math.max(
+      0,
+      ...listEvents(harness.db, { threadId: queuedFixture.thread.id }).map(
+        (event) => event.sequence,
+      ),
+    );
+    await sendQueuedMessage(harness.deps, {
+      claimPolicy: {
+        kind: "automatic",
+        isGroupEligible: () => true,
+        retryingFailure: false,
+      },
+      threadId: queuedFixture.thread.id,
+      queuedMessageId: queued.id,
+      mode: "auto",
+    });
+    await waitForQueuedCommand(
+      harness,
+      (candidate) =>
+        candidate.command.type === "turn.submit" &&
+        candidate.command.threadId === queuedFixture.thread.id,
+    );
+    expectPersistedMentionTarget(
+      harness,
+      queuedFixture.thread.id,
+      beforeQueuedDispatch,
+      target,
+    );
+  } finally {
+    setPluginAgentContributions(undefined);
+    await service.stop();
+    await harness.cleanup();
+  }
+});
