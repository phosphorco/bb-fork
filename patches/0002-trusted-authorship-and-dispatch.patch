+        const record = entry?.record;
+        if (
+          entry?.issuer !== input.issuer ||
+          entry.subject !== input.subject ||
+          record == null ||
+          record.issuer !== input.issuer ||
+          record.subject !== input.subject ||
+          record.status !== "current"
