@@ -0,0 +1,251 @@
+import { describe, expect, it } from "vitest";
+import {
+  createP6rProviderAdmission,
+  type P6rAdmissionIngressFacts,
+  type P6rAdmissionRequestFacts,
+} from "../../../src/services/p6r/provider-admission.js";
+import { createP6rProviderRegistry } from "../../../src/services/p6r/provider-registry.js";
+import type {
+  P6rForkIdentityProvider,
+  P6rProviderConfiguration,
+  P6rProviderEvidence,
+  P6rProviderResolution,
+} from "../../../src/services/p6r/provider-contract.js";
+
+const configuration: P6rProviderConfiguration = {
+  boundaryId: "signed-boundary",
+  credentials: [
+    { field: "x-proof-assertion", name: "assertion", source: "header" },
+  ],
+  ingressIds: ["proof-ingress"],
+  pluginId: "provider-plugin",
+  resolver: { timeoutMs: 25 },
+  version: 1,
+};
+
+function requestFacts(now: number, token: string): P6rAdmissionRequestFacts {
+  return {
+    authority: "proof.test",
+    cookie: () => null,
+    header: (name) => (name === "x-proof-assertion" ? token : null),
+    method: "POST",
+    pathname: "/api/plugins/feature/rpc",
+    receivedAt: now,
+    transport: "http",
+  };
+}
+
+function ingress(
+  kind: P6rAdmissionIngressFacts["kind"] = "owned-proxy",
+  hostId: string | null = null,
+  hostName: string | null = null,
+): P6rAdmissionIngressFacts {
+  return {
+    authenticatedPeer: "proof-peer",
+    hostId,
+    hostName,
+    id: "proof-ingress",
+    kind,
+  };
+}
+
+async function publishedAdmission(
+  provider: P6rForkIdentityProvider,
+  ingressFacts: () => P6rAdmissionIngressFacts,
+  requestFactsFor: () => P6rAdmissionRequestFacts,
+  selectedConfiguration: () => P6rProviderConfiguration | null = () =>
+    configuration,
+) {
+  const registry = createP6rProviderRegistry({ now: Date.now });
+  const prepared = await registry.prepare({
+    configuration,
+    deadlineAt: Date.now() + 1_000,
+    generation: "provider-generation",
+    provider,
+  });
+  if (!prepared.ok) throw new Error("expected provider preparation");
+  expect(registry.publish(prepared.value).ok).toBe(true);
+  registry.notifyPublished(prepared.value);
+  const admission = createP6rProviderAdmission({
+    ingressFacts: ({ request }) => {
+      if (request === null || typeof request !== "object")
+        throw new Error("expected request object");
+      return ingressFacts();
+    },
+    instanceId: "proof-instance",
+    machineName: "test-server",
+    now: Date.now,
+    providerRegistry: registry,
+    requestFacts: requestFactsFor,
+    selectedConfiguration,
+  });
+  return { admission, prepared, registry };
+}
+
+describe("P6r provider admission", () => {
+  it("returns a verified person from one bounded lookup and keeps the actor stamp stable", async () => {
+    let calls = 0;
+    const provider: P6rForkIdentityProvider = {
+      issuers: ["proof:issuer"],
+      async resolve(
+        _evidence: P6rProviderEvidence,
+      ): Promise<P6rProviderResolution> {
+        calls += 1;
+        return {
+          issuer: "proof:issuer",
+          presentation: {
+            avatarUrl: null,
+            displayName: "Alice",
+            handle: "alice",
+          },
+          status: "resolved",
+          subject: "alice",
+        };
+      },
+    };
+    const { admission, prepared, registry } = await publishedAdmission(
+      provider,
+      () => ingress(),
+      () => requestFacts(Date.now(), "signed"),
+    );
+    try {
+      const first = await admission.resolveNativeAuthor({});
+      const second = await admission.resolveNativeAuthor({});
+      expect(first).toMatchObject({
+        evidence: "provider-verified",
+        identity: { kind: "person", issuer: "proof:issuer", subject: "alice" },
+      });
+      expect(second).toEqual(first);
+      expect(calls).toBe(2);
+
+      const trusted = await admission.trustedInvocation({
+        generation: {
+          generation: "feature-generation",
+          lifetime: new AbortController().signal,
+          pluginId: "feature-plugin",
+        },
+        ingress: { requestId: "request-1", transport: "http" },
+        request: {},
+        routeClass: "anonymous",
+      });
+      if (trusted?.session.status !== "ready")
+        throw new Error("expected ready session");
+      if (trusted.session.actor.identity.kind !== "person")
+        throw new Error("expected person actor");
+      expect(trusted.session.actor.identity.subject).toBe("alice");
+      expect(trusted.session.stamp).toBe(
+        "p6r-session:v1:" +
+          encodeURIComponent(first.identity.key) +
+          ":provider-generation",
+      );
+    } finally {
+      admission.dispose();
+      registry.retire(prepared.value);
+    }
+  });
+
+  it("falls back to an explicit server machine when ingress is unverified or provider enrichment fails", async () => {
+    let calls = 0;
+    const provider: P6rForkIdentityProvider = {
+      issuers: ["proof:issuer"],
+      async resolve(): Promise<P6rProviderResolution> {
+        calls += 1;
+        return { reason: "fixture-outage", status: "unavailable" };
+      },
+    };
+    const { admission, prepared, registry } = await publishedAdmission(
+      provider,
+      () => ingress("unverified"),
+      () => requestFacts(Date.now(), "signed"),
+    );
+    try {
+      const author = await admission.resolveNativeAuthor({});
+      expect(author).toEqual({
+        evidence: "machine",
+        identity: {
+          kind: "machine",
+          key: "p6r-machine:v1:proof-instance:server",
+          instanceId: "proof-instance",
+          hostId: null,
+        },
+        presentation: {
+          avatarUrl: null,
+          displayName: "test-server",
+          handle: null,
+        },
+      });
+      expect(calls).toBe(0);
+    } finally {
+      admission.dispose();
+      registry.retire(prepared.value);
+    }
+
+    const fallback = await publishedAdmission(
+      provider,
+      () => ingress("local", "host/[one]", "remote-box"),
+      () => requestFacts(Date.now(), "signed"),
+    );
+    try {
+      const author = await fallback.admission.resolveNativeAuthor({});
+      expect(author.identity.kind).toBe("machine");
+      if (author.identity.kind !== "machine")
+        throw new Error("expected machine actor");
+      expect(author.identity.key).toBe(
+        "p6r-machine:v1:proof-instance:host:host%2F%5Bone%5D",
+      );
+      expect(author.identity.hostId).toBe("host/[one]");
+      expect(author.presentation.displayName).toBe("remote-box");
+    } finally {
+      fallback.admission.dispose();
+      fallback.registry.retire(fallback.prepared.value);
+    }
+  });
+
+  it("returns a machine author when the boundary is absent and preserves generation cancellation", async () => {
+    const registry = createP6rProviderRegistry({ now: Date.now });
+    const admission = createP6rProviderAdmission({
+      configured: () => false,
+      ingressFacts: () => ingress("owned-proxy"),
+      instanceId: "proof-instance",
+      machineName: "test-server",
+      now: Date.now,
+      providerRegistry: registry,
+      requestFacts: () => requestFacts(Date.now(), "unused"),
+      selectedConfiguration: () => configuration,
+    });
+    const author = await admission.resolveNativeAuthor({});
+    expect(author.evidence).toBe("machine");
+
+    const provider: P6rForkIdentityProvider = {
+      issuers: ["proof:issuer"],
+      resolve: (evidence) =>
+        new Promise<P6rProviderResolution>((resolve) => {
+          evidence.signal.addEventListener("abort", () =>
+            resolve({ reason: "cancelled", status: "unavailable" }),
+          );
+        }),
+    };
+    const published = await publishedAdmission(
+      provider,
+      () => ingress(),
+      () => requestFacts(Date.now(), "signed"),
+    );
+    const lifetime = new AbortController();
+    const pending = published.admission.trustedInvocation({
+      generation: {
+        generation: "feature-generation",
+        lifetime: lifetime.signal,
+        pluginId: "feature-plugin",
+      },
+      ingress: { requestId: "request-1", transport: "http" },
+      request: {},
+      routeClass: "anonymous",
+    });
+    await Promise.resolve();
+    lifetime.abort();
+    expect(await pending).toBeNull();
+    published.admission.dispose();
+    published.registry.retire(published.prepared.value);
+    admission.dispose();
+  });
+});
