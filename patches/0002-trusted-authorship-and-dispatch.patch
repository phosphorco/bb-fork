+        const result = await bounded(
+          () =>
+            lookup([{ issuer: input.issuer, subject: input.subject }], {
+              signal: controller.signal,
+            }),
+          options.now() + state.configuration.resolver.timeoutMs,
+          controller.signal,
+        );
+        if (
+          result === null ||
+          controller.signal.aborted ||
+          !current(state, epoch)
+        ) {
+          return failure(
+            "unavailable",
+            "Provider target lookup expired or was invalidated",
+          );
+        }
