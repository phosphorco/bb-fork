diff --git a/apps/server/test/services/threads/thread-queued-messages.test.ts b/apps/server/test/services/threads/thread-queued-messages.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d9e1a79e2458df396eb87fdc58473c510b95528e
--- /dev/null
+++ b/apps/server/test/services/threads/thread-queued-messages.test.ts
@@ -0,0 +1,174 @@
+import { describe, expect, it } from "vitest";
+import {
+  allowsEmptyInitialPendingForkSeed,
+  toThreadQueuedMessage,
+} from "../../../src/services/threads/thread-queued-messages.js";
+import { listQueuedThreadMessages } from "@bb/db";
+import {
+  seedHost,
+  seedProjectWithSource,
+  seedThread,
+} from "../../helpers/seed.js";
+import { withTestHarness } from "../../helpers/test-app.js";
+
+type StoredQueuedThreadMessageRow = Parameters<typeof toThreadQueuedMessage>[0];
+
+function queuedRow(
+  overrides: Partial<StoredQueuedThreadMessageRow> = {},
+): StoredQueuedThreadMessageRow {
+  return {
+    state: "queued",
+    content: "[]",
+    createdAt: 1,
+    failureReason: null,
+    groupWithNext: false,
+    id: "qmsg_initial_fork",
+    model: "gpt-5",
+    origin: "sdk",
+    originPluginId: "plugin",
+    p6rAuthors: null,
+    payloadKind: "inline",
+    permissionMode: "full",
+    reasoningLevel: "medium",
+    requestedByInitiator: null,
+    requestedByThreadId: null,
+    retryAttempt: null,
+    retryOfTurnRequestId: null,
+    retryReason: null,
+    sendAt: null,
+    senderThreadId: null,
+    serviceTier: "default",
+    systemNotice: null,
+    threadId: "thr_fork",
+    updatedAt: 1,
+    waitingOn: null,
+    ...overrides,
+  };
+}
+
+describe("thread queued message reader", () => {
+  it("admits only the lead seed of a validated pending fork", () => {
+    const row = queuedRow();
+    const initialPendingForkSeedContext = {
+      leadQueuedMessageId: row.id,
+      pendingFork: { sourceProviderThreadId: "provider-source" },
+      threadStatus: "pending",
+    };
+
+    expect(
+      allowsEmptyInitialPendingForkSeed(row, initialPendingForkSeedContext),
+    ).toBe(true);
+    expect(
+      toThreadQueuedMessage(row, initialPendingForkSeedContext),
+    ).toMatchObject({
+      content: [],
+      initialForkSeed: true,
+    });
+  });
+
+  it("rejects an ordinary later empty row on a forked thread", () => {
+    const row = queuedRow({ id: "qmsg_later" });
+    const initialPendingForkSeedContext = {
+      leadQueuedMessageId: "qmsg_initial_fork",
+      pendingFork: { sourceProviderThreadId: "provider-source" },
+      threadStatus: "pending",
+    };
+
+    expect(
+      allowsEmptyInitialPendingForkSeed(row, initialPendingForkSeedContext),
+    ).toBe(false);
+    expect(() =>
+      toThreadQueuedMessage(row, initialPendingForkSeedContext),
+    ).toThrow("is malformed");
+    expect(
+      allowsEmptyInitialPendingForkSeed(queuedRow({ payloadKind: "retry" }), {
+        ...initialPendingForkSeedContext,
+        leadQueuedMessageId: "qmsg_initial_fork",
+      }),
+    ).toBe(false);
+  });
+
+  it("does not label a nonempty fork message as an empty seed", () => {
+    const row = queuedRow({
+      content: JSON.stringify([
+        { type: "text", text: "Do the thing", mentions: [] },
+      ]),
+    });
+    const context = {
+      leadQueuedMessageId: row.id,
+      pendingFork: { sourceProviderThreadId: "provider-source" },
+      threadStatus: "pending",
+    };
+
+    expect(allowsEmptyInitialPendingForkSeed(row, context)).toBe(false);
+    expect(toThreadQueuedMessage(row, context)).toMatchObject({
+      initialForkSeed: false,
+      content: [{ type: "text", text: "Do the thing" }],
+    });
+  });
+
+  it("rejects malformed content and attribution even for an allowed fork seed", () => {
+    const context = {
+      leadQueuedMessageId: "qmsg_initial_fork",
+      pendingFork: { sourceProviderThreadId: "provider-source" },
+      threadStatus: "pending",
+    };
+    const malformedContent = queuedRow({ content: '[{"type":"text"}]' });
+    const malformedAttribution = queuedRow({
+      p6rAuthors: '{"authors":"not-an-array"}',
+    });
+
+    expect(() => toThreadQueuedMessage(malformedContent, context)).toThrow(
+      "is malformed",
+    );
+    expect(() =>
+      toThreadQueuedMessage(malformedAttribution, context),
+    ).toThrow();
+  });
+
+  it("does not let a request assert initialForkSeed for ordinary empty queues", async () => {
+    await withTestHarness(async (harness) => {
+      const host = seedHost(harness.deps);
+      const { project } = seedProjectWithSource(harness.deps, {
+        hostId: host.id,
+      });
+      const thread = seedThread(harness.deps, {
+        projectId: project.id,
+        status: "idle",
+      });
+      const response = await harness.app.request(
+        `/api/v1/threads/${thread.id}/queued-messages`,
+        {
+          body: JSON.stringify({ input: [], initialForkSeed: true }),
+          headers: { "content-type": "application/json" },
+          method: "POST",
+        },
+      );
+
+      expect(response.status).toBe(400);
+      expect(listQueuedThreadMessages(harness.db, thread.id)).toEqual([]);
+
+      const sourceThread = seedThread(harness.deps, {
+        projectId: project.id,
+        status: "idle",
+      });
+      const forkedThread = seedThread(harness.deps, {
+        originKind: "fork",
+        projectId: project.id,
+        sourceThreadId: sourceThread.id,
+        status: "idle",
+      });
+      const laterResponse = await harness.app.request(
+        `/api/v1/threads/${forkedThread.id}/queued-messages`,
+        {
+          body: JSON.stringify({ input: [], initialForkSeed: true }),
+          headers: { "content-type": "application/json" },
+          method: "POST",
+        },
+      );
+
+      expect(laterResponse.status).toBe(400);
+      expect(listQueuedThreadMessages(harness.db, forkedThread.id)).toEqual([]);
+    });
+  });
+});
