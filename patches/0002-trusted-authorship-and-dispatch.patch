+        operationNamespace: input.operationNamespace,
+        payloadHash: input.payloadHash,
+        receipt: { acceptedAt, acceptedRequestSequence: request.sequence, nativeRequestId: request.requestId, retentionDeadline: acceptedAt + options.retentionMs, threadId: thread.id },
+      });
+      projectP6rParticipantsInTransaction(tx, thread.id);
+    };
+    try {
+      const dispatchQueuedOperation =
+        thread.status === "pending" ||
+        (thread.status === "active" && input.input.mode === "queue-if-active");
+      if (dispatchQueuedOperation) {
+        if (options.deps === undefined) return rejected("unavailable", "Native P6r pending-thread acceptance dependencies are unavailable");
+        await attemptDispatch(options.deps, {
+          p6rAuthors,
+          thread,
+          payload,
+          source: { kind: "inline" },
+          queuePayload: { kind: "inline" },
+          pluginSubmission: null,
+          systemNotice: null,
+          origin: null,
+          originPluginId: null,
+          startedOnBehalfOf: null,
+          trigger: "user",
+          queueReservation: ({ queuedMessage, tx }) => {
+            beforeAppendInTransaction({ tx });
+            reserveP6rQueuedOperationInTransaction(tx, {
+              acceptedAt: options.now(),
+              acceptedAuthorship: asJson(input.authorEvidence),
+              assertLive: input.validate,
+              contributionId,
+              input: asJson(input.input.input),
+              operationId: input.input.operationId,
+              operationNamespace: input.operationNamespace,
+              payloadHash: input.payloadHash,
+              queuedMessageId: queuedMessage.id,
+              retentionDeadline: options.now() + options.retentionMs,
+              threadId: thread.id,
+            });
+          },
+          pendingStartCommit: ({ provision, tx }) => {
+            beforeAppendInTransaction({ tx });
+            const request = appendThreadProvisionRequestInTransaction(tx, provision);
+            afterAppendInTransaction({
+              inputGroups: [payload.input],
+              request: {
+                requestId: request.clientRequestId,
+                sequence: request.requestSequence,
+              },
+              tx,
+            });
+            return request;
+          },
+          queuedBeforeAppendInTransaction: beforeAppendInTransaction,
+          queuedAfterAppendInTransaction: afterAppendInTransaction,
+        });
+      } else if (options.dispatch !== undefined) await options.dispatch({ afterAppendInTransaction, beforeAppendInTransaction, payload, p6rAuthors, thread });
+      else {
+        if (options.deps === undefined) return rejected("unavailable", "Native P6r acceptance dependencies are unavailable");
+        const environment = await requireThreadCommandEnvironment(options.deps, { thread });
+        await sendThreadMessage(options.deps, { originPluginId: null, p6rAuthors, afterAppendInTransaction, beforeAppendInTransaction, environment, payload, thread, trigger: "user" });
+      }
+    } catch (error) {
+      if (error instanceof ExistingP6rOperation) return p6rOutcomeFromStoredReceipt(error.receipt);
+      const committed = receiptDb === undefined ? null : lookupP6rOperationReceipt(receiptDb, input.operationNamespace, input.input.operationId);
+      if (committed !== null && committed.payloadHash === input.payloadHash) return p6rOutcomeFromStoredReceipt(committed);
+      return rejected("unavailable", error instanceof Error ? error.message : "Native P6r acceptance failed");
+    }
+    const durable = receiptDb === undefined ? null : lookupP6rOperationReceipt(receiptDb, input.operationNamespace, input.input.operationId);
+    return durable === null || durable.payloadHash !== input.payloadHash
+      ? { status: "indeterminate", operationId: input.input.operationId, message: "Native dispatch completed without a durable P6r receipt" }
+      : p6rOutcomeFromStoredReceipt(durable);
+  };
+}
diff --git a/apps/server/src/services/p6r/native-authorship.ts b/apps/server/src/services/p6r/native-authorship.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9d9e3295afa629f02b4a2af9b177fa8263b3920f
--- /dev/null
+++ b/apps/server/src/services/p6r/native-authorship.ts
@@ -0,0 +1,94 @@
+import {
+  listStoredClientTurnRequestRowsByKeys,
+  type DbQueryConnection,
+} from "@bb/db";
+import {
+  clientTurnRequestIdSchema,
+  isStandaloneBuiltinCompactCommand,
+  isStandaloneBuiltinClearCommand,
+  turnRequestEventDataSchema,
+  type P6rMessageAuthor,
+  type PromptInput,
+} from "@bb/domain";
+import type { P6rNativeAuthorship } from "./native-request.js";
+
+export type P6rMessageAuthors = (P6rMessageAuthor | null)[];
+export type P6rMessageEditors = (P6rMessageAuthor | null)[];
+
+export function captureP6rNativeAuthors(
+  authorship: P6rNativeAuthorship | undefined,
+  groups: number,
+): P6rMessageAuthors | undefined {
+  return authorship === undefined
+    ? undefined
+    : Array.from({ length: groups }, () => authorship.author);
+}
+
+export function readP6rNativeAttribution(
+  db: DbQueryConnection,
+  threadId: string,
+  requestId: string,
+):
+  | {
+      authors: P6rMessageAuthors | undefined;
+      editors: P6rMessageEditors | undefined;
+    }
+  | undefined {
+  const row = listStoredClientTurnRequestRowsByKeys(db, {
+    keys: [{ threadId, requestId: clientTurnRequestIdSchema.parse(requestId) }],
+  })[0];
+  if (row === undefined) return undefined;
+  const request = turnRequestEventDataSchema.parse(JSON.parse(row.data));
+  return { authors: request.p6rAuthors, editors: request.p6rEditors };
+}
+
+function senderLabel(sender: P6rMessageAuthor): string {
+  const label =
+    sender.identity.kind === "machine"
+      ? sender.presentation.displayName.startsWith("machine:")
+        ? sender.presentation.displayName
+        : `machine:${sender.presentation.displayName}`
+      : (sender.presentation.handle ?? sender.presentation.displayName);
+  return label.replace(/[\[\]<>\r\n%]/g, (character) =>
+    encodeURIComponent(character),
+  );
+}
+
+export function withP6rNativeAuthorContext(
+  input: PromptInput[],
+  authors: P6rMessageAuthors | undefined,
+  editors?: P6rMessageEditors,
+  groups?: PromptInput[][],
+): { input: PromptInput[]; inputGroups?: PromptInput[][] } {
+  if (
+    input.length === 0 ||
+    (!authors?.some(Boolean) && !editors?.some(Boolean)) ||
+    isStandaloneBuiltinCompactCommand(input) ||
+    isStandaloneBuiltinClearCommand(input)
+  )
+    return { input, ...(groups === undefined ? {} : { inputGroups: groups }) };
+  const enriched = (groups ?? [input]).map((group, index) => {
+    const sender = authors?.[index] ?? editors?.[index];
+    if (!sender || sender.evidence === "integration-asserted") return group;
+    const from = senderLabel(sender);
+    const marker = (text: string): PromptInput => ({
+      type: "text",
+      visibility: "agent-only",
+      mentions: [],
+      text,
+    });
+    return [
+      marker(`[sender=${from}]\n`),
+      ...group,
+      marker(`\n[/sender=${from}]`),
+    ];
+  });
+  return {
+    input: enriched.flatMap((group, index) =>
+      index === 0
+        ? group
+        : [{ type: "text" as const, text: "\n\n", mentions: [] }, ...group],
+    ),
+    ...(groups === undefined ? {} : { inputGroups: enriched }),
+  };
+}
diff --git a/apps/server/src/services/p6r/native-request.ts b/apps/server/src/services/p6r/native-request.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5b61e1b1177119bbbe2082f66fc8af09b143d901
--- /dev/null
+++ b/apps/server/src/services/p6r/native-request.ts
@@ -0,0 +1,93 @@
+import { type P6rMessageAuthor } from "@bb/domain";
+import type { Context, Hono, Next } from "hono";
+import { ApiError } from "../../errors.js";
+import type { P6rProviderAdmission } from "./provider-admission.js";
+import {
+  publicApiRoutes,
+  typedRoutes,
+  type PublicApiSchema,
+  type P6rIdentityResponse,
+} from "@bb/server-contract";
+
+export interface P6rNativeAuthorship {
+  readonly author: P6rMessageAuthor;
+}
+
+const PRODUCER_MESSAGE_RENDERING_HEADER = "x-bb-p6r-message-rendering";
+const PRODUCER_MESSAGE_RENDERING_VALUE = "producer";
+
+interface NativeContextState {
+  readonly resolve: () => Promise<P6rMessageAuthor>;
+  readonly producerMessageRendering: boolean;
+  authorship?: P6rNativeAuthorship;
+  resolving?: Promise<P6rNativeAuthorship>;
+}
+
+const nativeContexts = new WeakMap<object, NativeContextState>();
+
+export async function getP6rNativeAuthorship(
+  context: object,
+): Promise<P6rNativeAuthorship | undefined> {
+  const state = nativeContexts.get(context);
+  if (state === undefined || state.producerMessageRendering) return undefined;
+  if (state.authorship !== undefined) return state.authorship;
+  if (state.resolving !== undefined) return state.resolving;
+  state.resolving = state.resolve().then((author) => {
+    const authorship = { author };
+    state.authorship = authorship;
+    return authorship;
+  });
+  return state.resolving;
+}
+
+function isProducerMessageRequest(context: Context): boolean {
+  if (context.req.method !== "POST") return false;
+  if (
+    context.req.header(PRODUCER_MESSAGE_RENDERING_HEADER) !==
+    PRODUCER_MESSAGE_RENDERING_VALUE
+  ) {
+    return false;
+  }
+  const pathname = context.req.path.replace(/\/+$/u, "");
+  return /\/threads\/[^/]+\/(?:send|queued-messages)$/u.test(pathname);
+}
+
+function installNativeContextResolver(admission: P6rProviderAdmission) {
+  return async (context: Context, next: Next): Promise<void> => {
+    const state: NativeContextState = {
+      producerMessageRendering: isProducerMessageRequest(context),
+      resolve: () => admission.resolveNativeAuthor(context),
+    };
+    nativeContexts.set(context, state);
+    try {
+      await next();
+    } finally {
+      nativeContexts.delete(context);
+    }
+  };
+}
+
+export function installP6rNativeRequestRoutes(
+  app: Hono,
+  admission: P6rProviderAdmission,
+  providerId: string | null,
+): void {
+  const attach = installNativeContextResolver(admission);
+  app.use("*", attach);
+
+  const { get } = typedRoutes<PublicApiSchema>(app, {
+    onValidationError: (message) =>
+      new ApiError(400, "invalid_request", message),
+  });
+  get(publicApiRoutes.system.p6rIdentity, async (context) => {
+    context.header("Cache-Control", "no-store");
+    const result: P6rIdentityResponse = {
+      status: "ready",
+      actor:
+        nativeContexts.get(context)?.authorship?.author ??
+        (await admission.resolveNativeAuthor(context)),
+      providerId: providerId ?? "",
+    };
+    return context.json(result);
+  });
+}
diff --git a/apps/server/src/services/p6r/participant-projection.ts b/apps/server/src/services/p6r/participant-projection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4f4349efcdf058185bded7d856fe2439214ef61b
--- /dev/null
+++ b/apps/server/src/services/p6r/participant-projection.ts
@@ -0,0 +1,286 @@
+import {
+  listStoredClientTurnRequestRowsByKeys,
+  events,
+  replaceCoreParticipantProfilesInTransaction,
+  type DbQueryConnection,
+} from "@bb/db";
+import {
+  clientTurnRequestIdSchema,
+  p6rMessageAuthorSchema,
+  p6rMentionTargetSchema,
+  type P6rMentionTarget,
+  type P6rMessageAuthor,
+} from "@bb/domain";
+import { and, eq, inArray, sql } from "drizzle-orm";
+import { z } from "zod";
+import {
+  p6rContributions,
+  p6rParticipantWatermarks,
+} from "./sidecar-schema.js";
+
+export const P6R_PARTICIPANT_PROJECTOR_VERSION = 1;
+
+export interface P6rParticipantWatermark {
+  contributionAcceptedAt: number | null;
+  contributionCount: number;
+  projectorVersion: number;
+  requestEventId: string | null;
+  requestSequence: number | null;
+}
+
+export function readP6rParticipantInputWatermarks(
+  db: DbQueryConnection,
+  threadIds: readonly string[],
+): Map<string, P6rParticipantWatermark> {
+  const ids = [...new Set(threadIds)];
+  if (ids.length === 0) return new Map();
+  const rows = db.all<{
+    contribution_accepted_at: number | null;
+    contribution_count: number;
+    request_event_id: string | null;
+    request_sequence: number | null;
+    thread_id: string;
+  }>(sql`
+    SELECT ids.value AS thread_id,
+      (SELECT e.sequence FROM events e WHERE e.thread_id = ids.value AND e.type = 'client/turn/requested' ORDER BY e.sequence DESC LIMIT 1) AS request_sequence,
+      (SELECT e.id FROM events e WHERE e.thread_id = ids.value AND e.type = 'client/turn/requested' ORDER BY e.sequence DESC LIMIT 1) AS request_event_id,
+      (SELECT count(*) FROM p6r_contributions c WHERE c.thread_id = ids.value) AS contribution_count,
+      (SELECT max(c.accepted_at) FROM p6r_contributions c WHERE c.thread_id = ids.value) AS contribution_accepted_at
+    FROM json_each(${JSON.stringify(ids)}) AS ids
+  `);
+  return new Map(
+    rows.map((row) => [
+      row.thread_id,
+      {
+        contributionAcceptedAt: row.contribution_accepted_at,
+        contributionCount: row.contribution_count,
+        projectorVersion: P6R_PARTICIPANT_PROJECTOR_VERSION,
+        requestEventId: row.request_event_id,
+        requestSequence: row.request_sequence,
+      },
+    ]),
+  );
+}
+
+export function readStoredP6rParticipantWatermarks(
+  db: DbQueryConnection,
+  threadIds: readonly string[],
+): Map<string, P6rParticipantWatermark> {
+  const ids = [...new Set(threadIds)];
+  if (ids.length === 0) return new Map();
+  return new Map(
+    db
+      .select()
+      .from(p6rParticipantWatermarks)
+      .where(inArray(p6rParticipantWatermarks.threadId, ids))
+      .all()
+      .map((row) => [
+        row.threadId,
+        {
+          contributionAcceptedAt: row.contributionAcceptedAt,
+          contributionCount: row.contributionCount,
+          projectorVersion: row.projectorVersion,
+          requestEventId: row.requestEventId,
+          requestSequence: row.requestSequence,
+        },
+      ]),
+  );
+}
+
+export function p6rParticipantWatermarksEqual(
+  left: P6rParticipantWatermark,
+  right: P6rParticipantWatermark,
+): boolean {
+  return (
+    left.contributionAcceptedAt === right.contributionAcceptedAt &&
+    left.contributionCount === right.contributionCount &&
+    left.projectorVersion === right.projectorVersion &&
+    left.requestEventId === right.requestEventId &&
+    left.requestSequence === right.requestSequence
+  );
+}
+
+export function writeP6rParticipantWatermarkInTransaction(
+  db: DbQueryConnection,
+  threadId: string,
+  watermark: P6rParticipantWatermark,
+): void {
+  const values = { ...watermark, updatedAt: Date.now() };
+  db.insert(p6rParticipantWatermarks)
+    .values({ threadId, ...values })
+    .onConflictDoUpdate({ target: p6rParticipantWatermarks.threadId, set: values })
+    .run();
+}
+
+const targetListSchema = z.array(p6rMentionTargetSchema).max(256);
+export function readP6rMentionTargetsForRequest(
+  db: DbQueryConnection,
+  threadId: string,
+  requestId: string,
+): P6rMentionTarget[] {
+  const row = listStoredClientTurnRequestRowsByKeys(db, {
+    keys: [{ threadId, requestId: clientTurnRequestIdSchema.parse(requestId) }],
+  })[0];
+  if (row === undefined) {
+    throw new Error("Original mention request is unavailable");
+  }
+  const value = JSON.parse(row.data).p6rMentionedTargets;
+  return value === undefined ? [] : targetListSchema.parse(value);
+}
+export function readP6rParticipantTargets(
+  db: DbQueryConnection,
+  threadIds: readonly string[],
+): Array<{
+  threadId: string;
+  createdAt: number;
+  targets: Array<
+    Pick<P6rMentionTarget | P6rMessageAuthor, "identity" | "presentation">
+  >;
+}> {
+  if (threadIds.length === 0) return [];
+  return db
+    .select({
+      threadId: events.threadId,
+      createdAt: events.createdAt,
+      data: events.data,
+    })
+    .from(events)
+    .where(
+      and(
+        inArray(events.threadId, [...new Set(threadIds)]),
+        eq(events.type, "client/turn/requested"),
+        sql`(json_type(${events.data}, '$.p6rMentionedTargets') = 'array' OR json_type(${events.data}, '$.p6rAuthors') = 'array' OR json_type(${events.data}, '$.p6rEditors') = 'array')`,
+      ),
+    )
+    .all()
+    .flatMap((row) => {
+      try {
+        const data = JSON.parse(row.data);
+        const mentions = targetListSchema.safeParse(
+          data.p6rMentionedTargets ?? [],
+        );
+        const authors = z
+          .array(p6rMessageAuthorSchema.nullable())
+          .max(256)
+          .safeParse(data.p6rAuthors ?? []);
+        const editors = z
+          .array(p6rMessageAuthorSchema.nullable())
+          .max(256)
+          .safeParse(data.p6rEditors ?? []);
+        return [
+          {
+            threadId: row.threadId,
+            createdAt: row.createdAt,
+            targets: [
+              ...(mentions.success ? mentions.data : []),
+              ...(authors.success
+                ? authors.data.filter((author) => author !== null)
+                : []),
+              ...(editors.success
+                ? editors.data.filter((editor) => editor !== null)
+                : []),
+            ],
+          },
+        ];
+      } catch {
+        return [];
+      }
+    });
+}
+
+const participantActorSchema = z
+  .object({
+    identity: z.discriminatedUnion("kind", [
+      z
+        .object({
+          key: z.string().min(1),
+          kind: z.literal("machine"),
+          instanceId: z.string().min(1),
+          hostId: z.string().nullable(),
+        })
+        .passthrough(),
+      z
+        .object({
+          key: z.string().min(1),
+          kind: z.literal("person"),
+          issuer: z.string().min(1),
+          subject: z.string().min(1),
+        })
+        .passthrough(),
+      z
+        .object({
+          key: z.string().min(1),
+          kind: z.literal("external"),
+          pluginId: z.string().min(1),
+          subject: z.string().min(1),
+        })
+        .passthrough(),
+    ]),
+    presentation: z
+      .object({
+        displayName: z.string().min(1),
+        avatarUrl: z.string().min(1).nullable(),
+      })
+      .passthrough(),
+  })
+  .passthrough();
+
+export function projectP6rParticipantsInTransaction(
+  db: DbQueryConnection,
+  threadId: string,
+): void {
+  const rows = db
+    .select({
+      acceptedAt: p6rContributions.acceptedAt,
+      acceptedAuthorship: p6rContributions.acceptedAuthorship,
+      latestEditor: p6rContributions.latestEditor,
+    })
+    .from(p6rContributions)
+    .where(eq(p6rContributions.threadId, threadId))
+    .all();
+  const profiles = new Map<
+    string,
+    {
+      p6rPrincipalKey: string;
+      identityKind: "external" | "person" | "machine";
+      p6rDisplayName: string;
+      imageUrl: string | null;
+    }
+  >();
+  let sourceVersion = 0;
+  for (const row of rows) {
+    sourceVersion = Math.max(sourceVersion, row.acceptedAt);
+    for (const encoded of [row.acceptedAuthorship, row.latestEditor]) {
+      try {
+        const actor = participantActorSchema.safeParse(JSON.parse(encoded));
+        if (!actor.success) continue;
+        profiles.set(actor.data.identity.key, {
+          p6rPrincipalKey: actor.data.identity.key,
+          identityKind: actor.data.identity.kind,
+          p6rDisplayName: actor.data.presentation.displayName,
+          imageUrl: actor.data.presentation.avatarUrl,
+        });
+      } catch {}
+    }
+  }
+  for (const row of readP6rParticipantTargets(db, [threadId])) {
+    sourceVersion = Math.max(sourceVersion, row.createdAt);
+    for (const target of row.targets)
+      profiles.set(target.identity.key, {
+        p6rPrincipalKey: target.identity.key,
+        identityKind: target.identity.kind,
+        p6rDisplayName: target.presentation.displayName,
+        imageUrl: target.presentation.avatarUrl,
+      });
+  }
+  replaceCoreParticipantProfilesInTransaction(db, {
+    threadId,
+    sourceVersion,
+    profiles: [...profiles.values()].sort((left, right) =>
+      left.p6rPrincipalKey.localeCompare(right.p6rPrincipalKey),
+    ),
+  });
+  const watermark = readP6rParticipantInputWatermarks(db, [threadId]).get(threadId);
+  if (watermark !== undefined)
+    writeP6rParticipantWatermarkInTransaction(db, threadId, watermark);
+}
diff --git a/apps/server/src/services/p6r/provider-admission.ts b/apps/server/src/services/p6r/provider-admission.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a555d50201debbc08dac843428ffb244a9817770
--- /dev/null
+++ b/apps/server/src/services/p6r/provider-admission.ts
@@ -0,0 +1,380 @@
+import type { ExperimentalP6rInvocationRouteClass } from "@get-bb/plugin-sdk";
+import { p6rMessageAuthorSchema, type P6rMessageAuthor } from "@bb/domain";
+import type {
+  P6rIdentityGeneration,
+  P6rReadySession,
+  P6rServerSession,
+} from "./identity-protocol.js";
+import type { P6rInvocationIngress } from "./invocation-registry.js";
+import type {
+  P6rPersonReference,
+  P6rProfilePresentation,
+  P6rProviderConfiguration,
+  P6rProviderRegistry,
+} from "./provider-contract.js";
+
+type Timer = ReturnType<typeof setTimeout>;
+type TrustedInvocation = {
+  readonly session: P6rServerSession;
+  readonly signal?: AbortSignal;
+} | null;
+type AdmissionInput = {
+  readonly generation: P6rIdentityGeneration;
+  readonly ingress: P6rInvocationIngress;
+  readonly request: object;
+  readonly routeClass: ExperimentalP6rInvocationRouteClass;
+};
+type AdmissionResolutionInput = {
+  readonly lifetime: AbortSignal;
+  readonly request: object;
+  readonly transport: P6rInvocationIngress["transport"];
+};
+type ResolvedAuthor = {
+  readonly author: P6rMessageAuthor;
+  readonly providerGeneration: string;
+};
+
+interface RequestSignalReader {
+  readonly req?: { readonly raw?: { readonly signal?: AbortSignal } };
+}
+
+function requestSignal(request: object): AbortSignal | null {
+  return (request as RequestSignalReader).req?.raw?.signal ?? null;
+}
+
+export interface P6rAdmissionRequestFacts {
+  readonly authority: string;
+  cookie(name: string): string | null;
+  header(name: string): string | null;
+  readonly method: string;
+  readonly pathname: string;
+  readonly receivedAt: number;
+  readonly transport: "http" | "websocket";
+}
+export interface P6rAdmissionIngressFacts {
+  readonly authenticatedPeer: string | null;
+  readonly hostId?: string | null;
+  readonly hostName?: string | null;
+  readonly id: string | null;
+  readonly kind: "owned-proxy" | "local" | "unverified";
+}
+export interface P6rProviderAdmissionOptions {
+  readonly clearTimeout?: (timer: Timer) => void;
+  readonly configured?: () => boolean;
+  readonly ingressFacts: (input: {
+    readonly request: object;
+    readonly transport: P6rInvocationIngress["transport"];
+  }) => P6rAdmissionIngressFacts | null;
+  readonly instanceId: string;
+  readonly machineName: string;
+  readonly now: () => number;
+  readonly providerRegistry: P6rProviderRegistry;
+  readonly requestFacts: (request: object) => P6rAdmissionRequestFacts | null;
+  readonly selectedConfiguration: () => P6rProviderConfiguration | null;
+  readonly setTimeout?: (callback: () => void, delay: number) => Timer;
+}
+export interface P6rProviderAdmission {
+  dispose(): void;
+  providerConfiguration(pluginId: string): P6rProviderConfiguration | null;
+  resolveNativeAuthor(request: object): Promise<P6rMessageAuthor>;
+  trustedInvocation(input: AdmissionInput): Promise<TrustedInvocation>;
+}
+
+function snapshotConfiguration(
+  value: P6rProviderConfiguration,
+): P6rProviderConfiguration {
+  return Object.freeze({
+    boundaryId: value.boundaryId,
+    credentials: Object.freeze(
+      value.credentials.map((credential) =>
+        Object.freeze({
+          field: credential.field,
+          name: credential.name,
+          source: credential.source,
+        }),
+      ),
+    ),
+    ingressIds: Object.freeze([...value.ingressIds]),
+    pluginId: value.pluginId,
+    resolver: Object.freeze({ ...value.resolver }),
+    version: 1,
+  });
+}
+
+function validConfiguration(value: P6rProviderConfiguration): boolean {
+  return (
+    value.version === 1 &&
+    value.boundaryId.length > 0 &&
+    value.pluginId.length > 0 &&
+    Number.isFinite(value.resolver.timeoutMs) &&
+    value.resolver.timeoutMs > 0 &&
+    value.credentials.every(
+      (credential) => credential.field.length > 0 && credential.name.length > 0,
+    ) &&
+    new Set(value.credentials.map((credential) => credential.name)).size ===
+      value.credentials.length &&
+    value.ingressIds.every((id) => id.length > 0) &&
+    new Set(value.ingressIds).size === value.ingressIds.length
+  );
+}
+
+function machineAuthor(
+  instanceId: string,
+  hostId: string | null,
+  machineName: string,
+): P6rMessageAuthor {
+  const encodedInstanceId = encodeURIComponent(instanceId);
+  const identity = {
+    kind: "machine" as const,
+    key:
+      hostId === null
+        ? `p6r-machine:v1:${encodedInstanceId}:server`
+        : `p6r-machine:v1:${encodedInstanceId}:host:${encodeURIComponent(hostId)}`,
+    instanceId,
+    hostId,
+  };
+  return p6rMessageAuthorSchema.parse({
+    evidence: "machine",
+    identity,
+    presentation: {
+      avatarUrl: null,
+      displayName: machineName,
+      handle: null,
+    },
+  });
+}
+
+function personAuthor(
+  person: P6rPersonReference,
+  presentation: P6rProfilePresentation,
+): P6rMessageAuthor {
+  return p6rMessageAuthorSchema.parse({
+    evidence: "provider-verified",
+    identity: {
+      issuer: person.issuer,
+      key: person.key,
+      kind: "person",
+      subject: person.subject,
+    },
+    presentation: {
+      avatarUrl: presentation.avatarUrl,
+      displayName: presentation.displayName,
+      handle: presentation.handle,
+    },
+  });
+}
+
+function sessionFor(
+  author: P6rMessageAuthor,
+  instanceId: string,
+  providerGeneration: string,
+  providerRegistry: P6rProviderRegistry,
+): P6rReadySession {
+  const source = providerRegistry.directorySources()[0];
+  return {
+    actor: author,
+    capabilities: {
+      acceptance: "transactional-check",
+      directory: {
+        lookup: source?.lookup !== undefined,
+        search: source?.directory !== undefined,
+      },
+      externalSend: "structured",
+      forwarding: "host-bound",
+      operationLookup: true,
+      participants: true,
+      requestIdentity: "host-resolved",
+      toolProvenance: "partial",
+    },
+    instanceId,
+    mode: "multi-user",
+    stamp: `p6r-session:v1:${encodeURIComponent(author.identity.key)}:${encodeURIComponent(providerGeneration)}`,
+    status: "ready",
+  };
+}
+
+export function createP6rProviderAdmission(
+  options: P6rProviderAdmissionOptions,
+): P6rProviderAdmission {
+  const timer = options.setTimeout ?? setTimeout;
+  const cancelTimer = options.clearTimeout ?? clearTimeout;
+  let configuration: P6rProviderConfiguration | null = null;
+  const admissionLifetime = new AbortController();
+  let disposed = false;
+
+  const selectedConfiguration = (): P6rProviderConfiguration | null => {
+    if (configuration !== null) return configuration;
+    const candidate = options.selectedConfiguration();
+    if (candidate === null || !validConfiguration(candidate)) return null;
+    configuration = snapshotConfiguration(candidate);
+    return configuration;
+  };
+
+  const configured = (): boolean =>
+    options.configured?.() ?? selectedConfiguration() !== null;
+
+  const machineFor = (request: object): ResolvedAuthor => {
+    const ingress = options.ingressFacts({ request, transport: "http" });
+    const hostId =
+      ingress?.kind === "owned-proxy" || ingress?.kind === "local"
+        ? (ingress.hostId ?? null)
+        : null;
+    const machineName = ingress?.hostName ?? options.machineName;
+    return {
+      author: machineAuthor(options.instanceId, hostId, machineName),
+      providerGeneration: "machine",
+    };
+  };
+
+  const resolveAuthor = async (
+    input: AdmissionResolutionInput,
+  ): Promise<ResolvedAuthor | null> => {
+    if (disposed || input.lifetime.aborted) return null;
+    const fallback = machineFor(input.request);
+    if (!configured()) return fallback;
+    const current = selectedConfiguration();
+    const request = options.requestFacts(input.request);
+    const ingress = options.ingressFacts({
+      request: input.request,
+      transport: input.transport,
+    });
+    if (
+      current === null ||
+      request === null ||
+      ingress === null ||
+      request.transport !== input.transport ||
+      ingress.id === null ||
+      ingress.kind === "unverified" ||
+      !current.ingressIds.includes(ingress.id)
+    )
+      return fallback;
+
+    const deadlineAt = Math.min(
+      request.receivedAt + current.resolver.timeoutMs,
+      options.now() + current.resolver.timeoutMs,
+    );
+    const sourceBefore = options.providerRegistry.directorySources()[0];
+    if (sourceBefore === undefined) return fallback;
+    const controller = new AbortController();
+    const onLifetimeAbort = (): void => controller.abort();
+    input.lifetime.addEventListener("abort", onLifetimeAbort, { once: true });
+    const timeout = timer(
+      () => controller.abort(),
+      Math.max(0, deadlineAt - options.now()),
+    );
+    const credentials = current.credentials.flatMap((credential) => {
+      const value =
+        credential.source === "header"
+          ? request.header(credential.field)
+          : request.cookie(credential.field);
+      return value === null ? [] : [{ name: credential.name, value }];
+    });
+    try {
+      const resolution = await options.providerRegistry.resolve({
+        configuration: current,
+        credentials: Object.freeze(credentials),
+        deadlineAt,
+        ingress: Object.freeze({
+          authenticatedPeer: ingress.authenticatedPeer,
+          id: ingress.id,
+          kind: ingress.kind,
+        }),
+        request: Object.freeze({
+          authority: request.authority,
+          method: request.method,
+          pathname: request.pathname,
+          receivedAt: request.receivedAt,
+          transport: request.transport,
+        }),
+        signal: controller.signal,
+        version: 1,
+      });
+      if (input.lifetime.aborted) return null;
+      if (controller.signal.aborted) return fallback;
+      if (resolution.status !== "resolved") return fallback;
+      const sourceAfter = options.providerRegistry.directorySources()[0];
+      if (
+        sourceAfter === undefined ||
+        sourceAfter.generation !== sourceBefore.generation
+      )
+        return fallback;
+      const person = sourceBefore.person(resolution.issuer, resolution.subject);
+      if (!person.ok) return fallback;
+      return {
+        author: personAuthor(person.value, resolution.presentation),
+        providerGeneration: sourceBefore.generation,
+      };
+    } catch {
+      return input.lifetime.aborted ? null : fallback;
+    } finally {
+      cancelTimer(timeout);
+      input.lifetime.removeEventListener("abort", onLifetimeAbort);
+    }
+  };
+
+  const resolve = async (
+    input: AdmissionResolutionInput,
+  ): Promise<TrustedInvocation> => {
+    const resolved = await resolveAuthor(input);
+    if (resolved === null) return null;
+    const session = sessionFor(
+      resolved.author,
+      options.instanceId,
+      resolved.providerGeneration,
+      options.providerRegistry,
+    );
+    return {
+      session,
+      signal: input.lifetime,
+    };
+  };
+
+  return {
+    dispose() {
+      if (disposed) return;
+      disposed = true;
+      admissionLifetime.abort();
+    },
+    providerConfiguration(pluginId) {
+      const current = selectedConfiguration();
+      return current === null || current.pluginId !== pluginId ? null : current;
+    },
+    async resolveNativeAuthor(request) {
+      if (disposed)
+        throw new DOMException(
+          "Native identity resolution was cancelled",
+          "AbortError",
+        );
+      const lifetime = new AbortController();
+      const signals = [admissionLifetime.signal, requestSignal(request)];
+      const abort = (): void => lifetime.abort();
+      for (const signal of signals) {
+        signal?.addEventListener("abort", abort, { once: true });
+        if (signal?.aborted) lifetime.abort();
+      }
+      try {
+        const resolved = await resolveAuthor({
+          lifetime: lifetime.signal,
+          request,
+          transport: "http",
+        });
+        if (disposed || lifetime.signal.aborted)
+          throw new DOMException(
+            "Native identity resolution was cancelled",
+            "AbortError",
+          );
+        return resolved?.author ?? machineFor(request).author;
+      } finally {
+        for (const signal of signals)
+          signal?.removeEventListener("abort", abort);
+      }
+    },
+    async trustedInvocation(input) {
+      return resolve({
+        lifetime: input.generation.lifetime,
+        request: input.request,
+        transport: input.ingress.transport,
+      });
+    },
+  };
+}
