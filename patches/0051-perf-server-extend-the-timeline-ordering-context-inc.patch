From 85fde8ba77ba86f26513b8850e37cafdb3d983a2 Mon Sep 17 00:00:00 2001
From: bb-machine <ubuntu@bb-machine>
Date: Wed, 7 Oct 2026 20:30:21 +0200
Subject: [PATCH] perf(server): extend the timeline ordering context
 incrementally

getTimelineGroupingContext already reuses the ordering context while
only parented rows change (#4716). When ordering rows arrive (a request,
acceptance, turn start or completion), it still recomputes from scratch:
computeTimelineOrderingContext re-reads listTimelineOrderingContext over
the whole history from the epoch start, five json_extract values per
row. On a long-lived server an 84k-event thread has 20,922 such rows,
~137 ms per read. That thread had 636 ordering events in 17 h, so the
first build after each one blocked for the full read (~37 times an hour).

The newest cache entry per key now keeps the ordering-context rows it
folded. When ordering rows changed and a retained entry with the same
rewrite generation and data version sits below the requested maxSeq,
only (cachedMaxSeq, maxSeq] is read. The rows are appended (both are
sequence ordered) and folded in memory. The fold result is identical:
every path that deletes or rewrites events bumps the rewrite generation,
and writes from another connection change data_version. Either one
still forces the full read. The parented-only reuse path keeps its rows,
since by construction it has no ordering rows in range.

Retained rows cost ~230 bytes each (4.8 MB for 20,922 rows). They are
capped at 120,000 rows (~28 MB) across the per-process cache; the oldest
keys lose their rows first. A context over the cap is not retained, so
a very long thread falls back to the full read.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .../threads/timeline-context-order.ts         |  65 +++++++-
 .../timeline-context-order-cache.test.ts      | 145 ++++++++++++++++++
 2 files changed, 202 insertions(+), 8 deletions(-)

diff --git a/apps/server/src/services/threads/timeline-context-order.ts b/apps/server/src/services/threads/timeline-context-order.ts
index 9fd061d6c0e9cadfc3685348659e74f4b738544a..330b397fead8d013caa1e71b8574a3778bc46844 100644
--- a/apps/server/src/services/threads/timeline-context-order.ts
+++ b/apps/server/src/services/threads/timeline-context-order.ts
@@ -30,17 +30,21 @@ interface TimelineOrderingContext {
   boundaryScanThroughSequence: number;
 }
 
+type TimelineOrderingContextRows = ReturnType<typeof listTimelineOrderingContext>;
+
 interface TimelineGroupingContextEntry {
   orderingContext: TimelineOrderingContext;
   context: TimelineGroupingContext;
   dataVersion: number;
   generation: number;
   maxSeq: number;
+  rows: TimelineOrderingContextRows | null;
 }
 
 const GROUPING_CONTEXT_KEY_LIMIT = 128;
 const GROUPING_CONTEXT_ENTRIES_PER_KEY = 4;
 const GROUPING_CONTEXT_REUSE_SEQUENCE_SPAN = 1024;
+const MAX_RETAINED_ORDERING_CONTEXT_ROWS = 120_000;
 
 const orderingContexts = new WeakMap<
   DbConnection,
@@ -121,8 +125,27 @@ export function getTimelineGroupingContext(
     ]);
     return reusable.entry.context;
   }
-  const orderingContext =
-    reusable?.entry.orderingContext ?? computeTimelineOrderingContext(db, args);
+  let orderingContext: TimelineOrderingContext;
+  let rows: TimelineOrderingContextRows | null;
+  if (reusable !== undefined) {
+    orderingContext = reusable.entry.orderingContext;
+    rows = reusable.entry.rows;
+  } else {
+    const base = entries
+      .filter((entry) => entry.rows !== null && entry.maxSeq < args.maxSeq)
+      .sort((left, right) => right.maxSeq - left.maxSeq)[0];
+    rows =
+      base?.rows == null
+        ? listTimelineOrderingContext(db, args)
+        : [
+            ...base.rows,
+            ...listTimelineOrderingContext(db, {
+              ...args,
+              sequenceStart: base.maxSeq + 1,
+            }),
+          ];
+    orderingContext = foldTimelineOrderingContext(rows);
+  }
   const parentedBoundary = getFirstParentedTimelineBoundarySequence(db, args);
   const context: TimelineGroupingContext = {
     acceptedTurnIds: orderingContext.acceptedTurnIds,
@@ -133,20 +156,46 @@ export function getTimelineGroupingContext(
         : (orderingContext.boundarySequence ?? parentedBoundary),
   };
   cache.set(key, [
-    { context, orderingContext, dataVersion, generation, maxSeq: args.maxSeq },
-    ...entries.slice(0, GROUPING_CONTEXT_ENTRIES_PER_KEY - 1),
+    {
+      context,
+      orderingContext,
+      dataVersion,
+      generation,
+      maxSeq: args.maxSeq,
+      rows:
+        rows !== null && rows.length <= MAX_RETAINED_ORDERING_CONTEXT_ROWS
+          ? rows
+          : null,
+    },
+    ...entries
+      .slice(0, GROUPING_CONTEXT_ENTRIES_PER_KEY - 1)
+      .map((entry) => ({ ...entry, rows: null })),
   ]);
   if (cache.size > GROUPING_CONTEXT_KEY_LIMIT) {
     cache.delete(cache.keys().next().value!);
   }
+  trimRetainedOrderingContextRows(cache);
   return context;
 }
 
-function computeTimelineOrderingContext(
-  db: DbConnection,
-  args: TimelineGroupingContextArgs,
+function trimRetainedOrderingContextRows(
+  cache: Map<string, TimelineGroupingContextEntry[]>,
+): void {
+  let retained = 0;
+  for (const entries of cache.values())
+    for (const entry of entries) retained += entry.rows?.length ?? 0;
+  for (const entries of cache.values()) {
+    if (retained <= MAX_RETAINED_ORDERING_CONTEXT_ROWS) return;
+    for (const entry of entries) {
+      retained -= entry.rows?.length ?? 0;
+      entry.rows = null;
+    }
+  }
+}
+
+function foldTimelineOrderingContext(
+  context: TimelineOrderingContextRows,
 ): TimelineOrderingContext {
-  const context = listTimelineOrderingContext(db, args);
   const spans = new Map<string, ExternalUserBoundaryTurnSpan>();
   const accepted = new Map<string, { sequence: number; turnId: string }>();
   for (const row of context) {
diff --git a/apps/server/test/services/threads/timeline-context-order-cache.test.ts b/apps/server/test/services/threads/timeline-context-order-cache.test.ts
index 5d8f1588ae4f72345073d6f6d0ee08bc7b234116..9eadb5e5899904855022e8f1d423f0589a06e3ed 100644
--- a/apps/server/test/services/threads/timeline-context-order-cache.test.ts
+++ b/apps/server/test/services/threads/timeline-context-order-cache.test.ts
@@ -527,6 +527,151 @@ describe("timeline grouping context cache", () => {
   }, 60_000);
 });
 
+function orderingContextReadStarts(
+  testThread: TestThread,
+  run: () => void,
+): number[] {
+  const starts: number[] = [];
+  const raw = testThread.db.$client;
+  const originalPrepare = raw.prepare.bind(raw);
+  Object.defineProperty(raw, "prepare", {
+    configurable: true,
+    writable: true,
+    value: (source: string) => {
+      const statement = originalPrepare(source);
+      if (!source.includes("'$.target.expectedTurnId'")) return statement;
+      const originalAll = statement.all.bind(statement);
+      statement.all = (...params: unknown[]) => {
+        const threadIndex = params.indexOf(testThread.thread.id);
+        starts.push(params[threadIndex + 1] as number);
+        return originalAll(...params);
+      };
+      return statement;
+    },
+  });
+  try {
+    run();
+  } finally {
+    Object.defineProperty(raw, "prepare", {
+      configurable: true,
+      writable: true,
+      value: originalPrepare,
+    });
+  }
+  return starts;
+}
+
+describe("incremental timeline ordering context", () => {
+  it("extends a cached context with only the rows after its maxSeq", () => {
+    withTestThread((testThread) => {
+      const warmMaxSeq = appendRows(testThread, [
+        turnStarted("turn-1"),
+        userRequest("request-1"),
+        accepted("request-1", "turn-1"),
+        turnCompleted("turn-1"),
+      ]);
+      expectCachedEqualsCold(testThread, warmMaxSeq);
+      const maxSeq = appendRows(testThread, [
+        userRequest("request-2"),
+        turnStarted("turn-2"),
+        accepted("request-2", "turn-2"),
+        delta("turn-2", "streamed"),
+      ]);
+      const starts = orderingContextReadStarts(testThread, () => {
+        expectCachedEqualsCold(testThread, maxSeq);
+      });
+      expect(starts).toEqual([warmMaxSeq + 1]);
+    });
+  });
+
+  it("recomputes from the start after an edit-message suffix delete and reprojecting append", () => {
+    withTestThread((testThread) => {
+      const threadId = testThread.thread.id;
+      appendRows(testThread, [turnStarted("turn-1"), userRequest("request-1")]);
+      const editedMaxSeq = appendRows(testThread, [
+        accepted("request-1", "turn-1"),
+        turnCompleted("turn-1"),
+        userRequest("request-2"),
+      ]);
+      expectCachedEqualsCold(testThread, editedMaxSeq);
+      testThread.db.transaction((tx) => {
+        deleteThreadEventSuffixInTransaction(tx, {
+          cutoffSequence: editedMaxSeq,
+          oldMaxSequence: editedMaxSeq,
+          threadId,
+        });
+      });
+      const maxSeq = appendRows(testThread, [
+        userRequest("request-2-edited"),
+        turnStarted("turn-2"),
+      ]);
+      const starts = orderingContextReadStarts(testThread, () => {
+        expectCachedEqualsCold(testThread, maxSeq);
+      });
+      expect(starts).toEqual([0]);
+    });
+  });
+
+  it("recomputes from the start after a pruning sweep removes rows", () => {
+    withTestThread((testThread) => {
+      const threadId = testThread.thread.id;
+      const warmMaxSeq = appendRows(testThread, [
+        turnStarted("turn-1"),
+        userRequest("request-1"),
+        { data: {}, turnId: "turn-1", type: "turn/diff/updated" },
+        { data: {}, turnId: "turn-1", type: "turn/diff/updated" },
+        { data: {}, turnId: "turn-1", type: "turn/diff/updated" },
+        turnCompleted("turn-1"),
+        turnStarted("turn-2"),
+        { data: {}, turnId: "turn-2", type: "turn/diff/updated" },
+      ]);
+      expectCachedEqualsCold(testThread, warmMaxSeq);
+      let removed = 0;
+      for (let pass = 0; pass < 10; pass += 1)
+        removed += advanceThreadPruning(testThread.db, { threadId }).removed;
+      expect(removed).toBeGreaterThan(0);
+      const maxSeq = appendRows(testThread, [userRequest("request-2")]);
+      const starts = orderingContextReadStarts(testThread, () => {
+        expectCachedEqualsCold(testThread, maxSeq);
+      });
+      expect(starts).toEqual([0]);
+    });
+  });
+
+  it("recomputes from the start when another connection changes the data version", () => {
+    withTestThread((testThread) => {
+      const warmMaxSeq = appendRows(testThread, [
+        turnStarted("turn-1"),
+        userRequest("request-1"),
+      ]);
+      expectCachedEqualsCold(testThread, warmMaxSeq);
+      const maxSeq = appendRows(
+        { db: testThread.coldDb, thread: testThread.thread },
+        [accepted("request-1", "turn-1"), turnCompleted("turn-1")],
+      );
+      const starts = orderingContextReadStarts(testThread, () => {
+        expectCachedEqualsCold(testThread, maxSeq);
+      });
+      expect(starts).toEqual([0]);
+    });
+  });
+
+  it("does not retain a context larger than the row cap", () => {
+    withTestThread((testThread) => {
+      const rows = Array.from({ length: 120_001 }, (_, index) =>
+        turnStarted(`turn-${index}`),
+      );
+      const warmMaxSeq = appendRows(testThread, rows);
+      expectCachedEqualsCold(testThread, warmMaxSeq);
+      const maxSeq = appendRows(testThread, [userRequest("request-1")]);
+      const starts = orderingContextReadStarts(testThread, () => {
+        expectCachedEqualsCold(testThread, maxSeq);
+      });
+      expect(starts).toEqual([0]);
+    });
+  }, 120_000);
+});
+
 const RANDOM_TURN_IDS = ["turn-a", "turn-b", "turn-c"] as const;
 const RANDOM_CALL_IDS = ["call-a", "call-b"] as const;
 const RANDOM_REQUEST_IDS = ["request-a", "request-b", "request-c"] as const;
