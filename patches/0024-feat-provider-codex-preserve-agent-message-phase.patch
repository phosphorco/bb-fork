+++ b/packages/domain/test/stored-thread-event.test.ts
@@ -155,6 +155,76 @@ describe("parseStoredThreadEvent", () => {
     expect(event).not.toHaveProperty("turnId");
   });
 
+  it("round-trips agent-message phase with its causal identity and preserves legacy absence", () => {
+    const data = {
+      providerThreadId: "provider-1",
+      item: {
+        type: "agentMessage",
+        id: "assistant-1",
+        text: "final",
+        phase: "final_answer",
+      },
+    } as const;
+    const event = parseStoredThreadEvent({
+      type: "item/completed",
+      threadId: "thread-1",
+      providerThreadId: "provider-1",
+      scope: turnScope("turn-1"),
+      data,
+    });
+    expect(event).toMatchObject({
+      type: "item/completed",
+      threadId: "thread-1",
+      providerThreadId: "provider-1",
+      scope: turnScope("turn-1"),
+      item: {
+        type: "agentMessage",
+        id: "assistant-1",
+        phase: "final_answer",
+      },
+    });
+    expect(
+      parseThreadEventRow({
+        id: "event-1",
+        type: "item/completed",
+        threadId: "thread-1",
+        seq: 1,
+        createdAt: 1,
+        scope: turnScope("turn-1"),
+        data,
+      }),
+    ).toMatchObject({
+      data: {
+        providerThreadId: "provider-1",
+        item: {
+          id: "assistant-1",
+          phase: "final_answer",
+        },
+      },
+    });
+
+    const legacy = parseStoredThreadEvent({
+      type: "item/completed",
+      threadId: "thread-1",
+      providerThreadId: "provider-1",
+      scope: turnScope("turn-1"),
+      data: {
+        item: {
+          type: "agentMessage",
+          id: "assistant-legacy",
+          text: "legacy",
+        },
+      },
+    });
+    expect(legacy).toMatchObject({ type: "item/completed" });
+    if (
+      legacy.type === "item/completed" &&
+      legacy.item.type === "agentMessage"
+    ) {
+      expect(legacy.item).not.toHaveProperty("phase");
+    }
+  });
+
   it("keeps host connection loss compatible with legacy interruption readers", () => {
     const data = {
       reason: "host-daemon-restarted",
diff --git a/packages/provider-bridge-protocol/src/assembler/delta-assembler.test.ts b/packages/provider-bridge-protocol/src/assembler/delta-assembler.test.ts
index 2e9d216771dab8de387329261d97efe66515a649..cbaa7e9bee4ab0f7216d58f6a43d7d30cbd4c53b 100644
