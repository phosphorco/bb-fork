@@ -456,12 +456,121 @@ describe("codex item translation", () => {
           type: "agentMessage",
           id: harness.itemId("item-1"),
           text: "Hello",
+          phase: null,
           presentation: AGENT_MESSAGE_PRESENTATION,
         },
       }),
     );
   });
 
+  it("preserves distinct interim and final agent-message phases in one provider turn", () => {
+    const harness = createHarness();
+    const interim = harness.translate(
+      codexEvent("item/completed", {
+        threadId: "provider-thread-1",
+        turnId: "turn-1",
+        completedAtMs: 0,
+        item: {
+          type: "agentMessage",
+          id: "interim-1",
+          text: "i".repeat(93),
+          phase: "commentary",
+          memoryCitation: null,
+          delivery: null,
+        },
+      }),
+    );
+    const final = harness.translate(
+      codexEvent("item/completed", {
+        threadId: "provider-thread-1",
+        turnId: "turn-1",
+        completedAtMs: 1,
+        item: {
+          type: "agentMessage",
+          id: "final-1",
+          text: "f".repeat(1182),
+          phase: "final_answer",
+          memoryCitation: null,
+          delivery: null,
+        },
+      }),
+    );
+    const turn = harness.translate(
+      codexEvent("turn/completed", {
+        threadId: "provider-thread-1",
+        turn: codexTurn({ id: "turn-1", status: "completed", error: null }),
+      }),
+    );
+
+    const completed = [...interim, ...final].filter(
+      (event): event is Extract<ThreadEvent, { type: "item/completed" }> =>
+        event.type === "item/completed" && event.item.type === "agentMessage",
+    );
+    expect(completed).toEqual([
+      expect.objectContaining({
+        scope: turnScope(harness.turnId("turn-1")),
+        item: expect.objectContaining({
+          id: harness.itemId("interim-1"),
+          text: "i".repeat(93),
+          phase: "commentary",
+        }),
+      }),
+      expect.objectContaining({
+        scope: turnScope(harness.turnId("turn-1")),
+        item: expect.objectContaining({
+          id: harness.itemId("final-1"),
+          text: "f".repeat(1182),
+          phase: "final_answer",
+        }),
+      }),
+    ]);
+    expect(turn).toContainEqual(
+      expect.objectContaining({
+        type: "turn/completed",
+        scope: turnScope(harness.turnId("turn-1")),
+        status: "completed",
+      }),
+    );
+  });
+
+  it("does not turn missing or unrecognized Codex phases into final answers", () => {
+    const harness = createHarness();
+    for (const item of [
+      {
+        type: "agentMessage",
+        id: "missing-phase",
+        text: "missing",
+        memoryCitation: null,
+        delivery: null,
+      },
+      {
+        type: "agentMessage",
+        id: "future-phase",
+        text: "future",
+        phase: "future_phase",
+        memoryCitation: null,
+        delivery: null,
+      },
+    ]) {
+      const events = harness.translate({
+        jsonrpc: "2.0",
+        method: "item/completed",
+        params: {
+          threadId: "t1",
+          turnId: "turn-1",
+          completedAtMs: 0,
+          item,
+        },
+      });
+      const completed = events.find(
+        (event): event is Extract<ThreadEvent, { type: "item/completed" }> =>
+          event.type === "item/completed" && event.item.type === "agentMessage",
+      );
+      expect(completed?.item).toMatchObject({ text: item.text });
+      expect(completed?.item).not.toHaveProperty("phase");
+    }
+  });
+
