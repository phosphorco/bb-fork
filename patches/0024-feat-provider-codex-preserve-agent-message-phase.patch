@@ -1187,6 +1187,76 @@ describe("delta assembler unified streaming dialect", () => {
       : undefined;
   }
 
+  it("preserves agent-message phase through open, close, and streamed settlement", () => {
+    const assembler = createAssembler();
+    assemble(assembler, { kind: "turn.open" });
+    const opened = itemOf(
+      assemble(assembler, {
+        kind: "item.open",
+        key: { providerItemId: "interim-1" },
+        item: {
+          type: "agentMessage",
+          text: "interim",
+          phase: "commentary",
+        },
+      })[0],
+    );
+    expect(opened).toMatchObject({
+      type: "agentMessage",
+      phase: "commentary",
+    });
+    const closed = itemOf(
+      assemble(assembler, {
+        kind: "item.close",
+        key: { providerItemId: "interim-1" },
+        status: "completed",
+        item: {
+          type: "agentMessage",
+          text: "interim",
+          phase: "commentary",
+        },
+      })[0],
+    );
+    expect(closed).toMatchObject({
+      type: "agentMessage",
+      id: opened?.id,
+      phase: "commentary",
+    });
+
+    const streamed = itemOf(
+      assemble(assembler, {
+        kind: "item.open",
+        key: { providerItemId: "final-1" },
+        item: {
+          type: "agentMessage",
+          text: "",
+          phase: "final_answer",
+        },
+      })[0],
+    );
+    assemble(assembler, {
+      kind: "item.textDelta",
+      key: { providerItemId: "final-1" },
+      channel: "agentMessage",
+      text: "final",
+    });
+    const settled = itemOf(
+      assemble(assembler, {
+        kind: "item.textClose",
+        key: { providerItemId: "final-1" },
+        channel: "agentMessage",
+      })[0],
+    );
+    expect(settled).toEqual(
+      expect.objectContaining({
+        type: "agentMessage",
+        id: streamed?.id,
+        text: "final",
+        phase: "final_answer",
+      }),
+    );
+  });
+
   it("synthesizes item/started for an anonymous stream and settles it from the accumulated text", () => {
     const assembler = createAssembler();
     assemble(assembler, { kind: "turn.open" });
