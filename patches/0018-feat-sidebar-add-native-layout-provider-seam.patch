+/**
+ * An experimental provider may supply a resolved layout and receive native
+ * customization changes. BB remains the sole sidebar renderer and interaction
+ * owner; a provider never receives navigation actions or DOM ownership. This
+ * is an exclusive slot: when more than one provider is active, the first one
+ * in BB's deterministic plugin-slot order wins.
+ */
+export interface ExperimentalSidebarLayoutProviderProps {
+  publish(layout: ExperimentalSidebarLayout | null): void;
+  subscribeChanges(
+    listener: (layout: ExperimentalSidebarLayout) => void,
+  ): () => void;
+}
