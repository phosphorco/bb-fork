+      if (providerKey === null) return;
+      const normalized = normalizeExternalLayout(layout);
+      if (normalized === null) return;
+      setPublishedLayout({ providerKey, layout: normalized });
+      if (listenerRef.current?.providerKey === providerKey)
+        listenerRef.current.listener(normalized);
+    },
+    [providerKey],
+  );
