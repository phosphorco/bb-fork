 const SidebarNavigationModelContext =
   createContext<SidebarNavigationModel | null>(null);
 
+const MAX_EXTERNAL_LAYOUT_ITEMS = 100;
+const MAX_EXTERNAL_LAYOUT_KEY_LENGTH = 256;
+
+function normalizeExternalLayout(
+  layout: ExperimentalSidebarLayout | null,
+): ExperimentalSidebarLayout | null {
+  if (layout === null) return null;
+  const copy = (keys: readonly unknown[]): string[] | null => {
+    if (!Array.isArray(keys) || keys.length > MAX_EXTERNAL_LAYOUT_ITEMS) return null;
+    const result: string[] = [];
+    for (const key of keys) {
+      if (
+        typeof key !== "string" ||
+        key.length === 0 ||
+        key.length > MAX_EXTERNAL_LAYOUT_KEY_LENGTH
+      ) return null;
+      if (!result.includes(key)) result.push(key);
+    }
+    return result;
+  };
+  const order = copy(layout.order);
+  const visible = copy(layout.visible);
+  return order === null || visible === null ? null : { order, visible };
+}
+
+function SidebarLayoutProviderMount({
+  slot,
+  publish,
+  subscribeChanges,
+}: {
+  slot: ExperimentalSidebarLayoutProviderSlot;
+  publish: (layout: ExperimentalSidebarLayout | null) => void;
+  subscribeChanges: (listener: (layout: ExperimentalSidebarLayout) => void) => () => void;
+}) {
+  const Component = slot.component;
+  return (
+    <PluginSlotMount
+      pluginId={slot.pluginId}
+      slotKind="sidebarLayoutProvider"
+      slotId={slot.id}
+      crashFallback={null}
+    >
+      <Component publish={publish} subscribeChanges={subscribeChanges} />
+    </PluginSlotMount>
+  );
+}
+
