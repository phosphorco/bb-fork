From c29631832adee21ad2ad6818cf4c9b5d7ad7d279 Mon Sep 17 00:00:00 2001
From: Phosphor <engineering@phosphor.co>
Date: Tue, 8 Sep 2026 17:46:17 +0200
Subject: [PATCH] test(identity): rewind downstream migrations in fixtures

---
 packages/db/test/migrate.test.ts | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/packages/db/test/migrate.test.ts b/packages/db/test/migrate.test.ts
index 51a451a9aad41cdbfda548ac7acd28ae7dc09abb..e6894c1b077cc7cfaf1f6b10f20bcd0d9fb92eed 100644
--- a/packages/db/test/migrate.test.ts
+++ b/packages/db/test/migrate.test.ts
@@ -701,6 +701,31 @@ function dropMarketplaceStatsColumn(db: DbConnection): void {
   }
 }
 
+/** Undo the downstream identity migrations that follow the queue rework. */
+function dropIdentityKernelSchema(db: DbConnection): void {
+  for (const table of [
+    "thread_facet_reconciliation_targets",
+    "thread_facet_principal_profiles",
+    "thread_facet_relations",
+    "thread_facet_snapshots",
+    "thread_facet_members",
+    "thread_facet_owners",
+    "thread_facet_declarations",
+    "thread_facet_cursor_keys",
+  ]) {
+    db.$client.prepare(`DROP TABLE IF EXISTS ${table}`).run();
+  }
+
+  const threadColumns = db.$client
+    .prepare<[], TableInfoRow>("PRAGMA table_info(threads)")
+    .all();
+  if (threadColumns.some((column) => column.name === "execution_revision")) {
+    db.$client
+      .prepare("ALTER TABLE threads DROP COLUMN execution_revision")
+      .run();
+  }
+}
+
 /**
  * Undo migration 0110, the dispatch-queue rework.
  *
@@ -779,6 +804,7 @@ function dropQueuedMessageAttemptColumns(db: DbConnection): void {
 function dropQueueReworkSchema(db: DbConnection): void {
   dropQueuedMessageAttemptColumns(db);
   rewindEnvironmentProvisioningMigration(db);
+  dropIdentityKernelSchema(db);
   // Indexes first: SQLite refuses to drop a column an existing index names.
   for (const index of [
     "queued_thread_messages_due_idx",
@@ -4624,6 +4650,7 @@ describe("environment providers migration", () => {
     db.$client.prepare("DROP TABLE IF EXISTS ui_preference_defaults").run();
     db.$client.prepare("DROP TABLE ui_preferences").run();
     db.$client.prepare("DROP TABLE retained_event_outputs").run();
+    dropIdentityKernelSchema(db);
     rewindEnvironmentRowFactsMigration(db);
     rewindEnvironmentProvidersMigration(db);
     dropQueuedMessageAttemptColumns(db);
@@ -5038,6 +5065,7 @@ describe("environment and thread startup ownership migration", () => {
     (phase) => {
       const db = createMigratedConnection();
       try {
+        dropIdentityKernelSchema(db);
         rewindMachineProvidersMigration(db);
         rewindEnvironmentProvisioningMigration(db);
         dropQueuedMessageAttemptColumns(db);
-- 
2.53.0

