 apps/app/src/lib/chunk-load-recovery.test.ts | 62 ++++++++++++++++++++
 apps/app/src/lib/chunk-load-recovery.ts      | 60 +++++++++++++++++++
 3 files changed, 124 insertions(+)
 create mode 100644 apps/app/src/lib/chunk-load-recovery.test.ts
 create mode 100644 apps/app/src/lib/chunk-load-recovery.ts

