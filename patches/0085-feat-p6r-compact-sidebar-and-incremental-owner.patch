+export const P6R_SIDEBAR_SWITCH = "bb.p6r.compact-sidebar";
+
+export function isP6rSidebarEnabled(): boolean {
+  try {
+    return (
+      typeof window !== "undefined" &&
+      window.localStorage.getItem(P6R_SIDEBAR_SWITCH) === "1"
+    );
+  } catch {
+    return false;
+  }
+}
