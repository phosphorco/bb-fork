+  environmentName: true,
+  environmentPath: true,
+  environmentProviderId: true,
+  environmentIsWorktree: true,
+  environmentWorkspaceDisplayKind: true,
+} as const;
+
+const environmentSchema = threadListEntrySchema.pick(environmentFields);
+const participantSchema =
+  threadListEntrySchema.shape.p6rParticipants.unwrap().element;
+const referenceSchema = z.number().int().nonnegative();
+
+const rowSchema = threadListEntrySchema
+  .omit({
+    ...environmentFields,
+    p6rParticipants: true,
+    projectId: true,
+  })
+  .partial()
+  .required({
+    id: true,
+    providerId: true,
+    latestAttentionAt: true,
+    createdAt: true,
+    updatedAt: true,
+  })
+  .extend({
+    projectId: z.string().optional(),
+    environmentRef: referenceSchema,
+    p6rParticipants: z.array(referenceSchema).optional(),
+  });
+
+const projectSchema = projectWithThreadsResponseSchema
+  .omit({ threads: true })
+  .extend({
+    threads: z.array(rowSchema),
+  });
+
+const dictionariesSchema = z.object({
+  wireVersion: z.literal(1),
+  participants: z.array(participantSchema),
+  environments: z.array(environmentSchema),
+});
+
+type Row = z.infer<typeof rowSchema>;
+type Dictionaries = z.infer<typeof dictionariesSchema>;
+
+function checkReferences(
+  rows: readonly Row[],
+  dictionaries: Dictionaries,
+  context: z.RefinementCtx,
+) {
+  for (const row of rows) {
+    if (
+      row.environmentRef >= dictionaries.environments.length ||
+      row.p6rParticipants?.some(
+        (ref) => ref >= dictionaries.participants.length,
+      )
+    ) {
+      context.addIssue({
+        code: "custom",
+        message: "Invalid sidebar dictionary reference",
+      });
+    }
+  }
+}
+
+export const p6rSidebarBootstrapSchema = dictionariesSchema
+  .extend({
+    sections: sidebarBootstrapResponseSchema.shape.sections,
+    projects: z.array(projectSchema),
+    personalProject: projectSchema,
+  })
+  .superRefine((value, context) => {
+    checkReferences(
+      [value.personalProject, ...value.projects].flatMap((p) => p.threads),
+      value,
+      context,
+    );
+  });
+export type P6rSidebarBootstrap = z.infer<typeof p6rSidebarBootstrapSchema>;
+
+export const p6rSidebarThreadsSchema = dictionariesSchema
+  .extend({
+    threads: z.array(rowSchema.extend({ projectId: z.string() })),
+    missingIds: z.array(z.string()),
+  })
+  .superRefine((value, context) =>
+    checkReferences(value.threads, value, context),
+  );
+export type P6rSidebarThreads = z.infer<typeof p6rSidebarThreadsSchema>;
+
+export const p6rSidebarThreadQuerySchema = z.object({
+  ids: z
+    .string()
+    .max(12000)
+    .regex(/^thr_[a-z0-9]+(?:,thr_[a-z0-9]+){0,199}$/),
+});
+
+const defaults = {
+  title: null,
+  titleFallback: null,
+  sectionId: null,
+  status: "idle",
+  parentThreadId: null,
+  lifecycleOwnerThreadId: null,
+  sourceThreadId: null,
+  originKind: null,
+  originPluginId: null,
+  visibility: "visible",
+  parentNotifications: "auto",
+  archivedAt: null,
+  pinnedAt: null,
+  deletedAt: null,
+  lastReadAt: null,
+  pinSortKey: null,
+  queuedWork: "none",
+  hasPendingInteraction: false,
+  activity: {
+    activeBackgroundAgentCount: 0,
+    activeBackgroundCommandCount: 0,
+    activeGoalCount: 0,
+    activePlanModeCount: 0,
+    activeWorkflowCount: 0,
+  },
+  runtime: { displayStatus: "idle" },
+} satisfies Partial<ThreadListEntry>;
+
+function omitDefaults<T extends object>(
+  value: T,
+  baseline: Partial<T>,
+): Partial<T> {
+  const result: Partial<T> = { ...value };
+  for (const key in baseline) {
+    const left = result[key];
+    const right = baseline[key];
+    const same = left === right || (
+      typeof left === "object" && left !== null &&
+      typeof right === "object" && right !== null &&
+      Object.keys(left).length === Object.keys(right).length &&
+      Object.keys(right).every(field => Reflect.get(left, field) === Reflect.get(right, field))
+    );
+    if (same) delete result[key];
+  }
+  return result;
+}
+
+function createEncoder() {
+  const dictionaries: Dictionaries = {
+    wireVersion: 1,
+    participants: [],
+    environments: [],
+  };
+  const participants = new Map<string | null, number[]>();
+  const environments = new Map<string | null, number[]>();
+  function intern<T extends object>(values: T[], index: Map<string | null, number[]>, key: string | null, value: T) {
+    const candidates = index.get(key) ?? [];
+    const fields = Object.keys(value);
+    for (const candidate of candidates) {
+      const existing = values[candidate]!;
+      if (fields.length === Object.keys(existing).length && fields.every(field => Reflect.get(value, field) === Reflect.get(existing, field))) return candidate;
+    }
+    const ref = values.length;
+    values.push(value);
+    candidates.push(ref);
+    index.set(key, candidates);
+    return ref;
+  }
+  function row(thread: ThreadListEntry, projectId?: string): Row {
+    const {
+      environmentId,
+      environmentBranchName,
+      environmentHostId,
+      environmentName,
+      environmentPath,
+      environmentProviderId,
+      environmentIsWorktree,
+      environmentWorkspaceDisplayKind,
+      p6rParticipants,
+      projectId: actualProjectId,
+      ...rest
+    } = thread;
+    return {
+      ...omitDefaults(rest, defaults),
+      id: thread.id,
+      providerId: thread.providerId,
+      latestAttentionAt: thread.latestAttentionAt,
+      createdAt: thread.createdAt,
+      updatedAt: thread.updatedAt,
+      ...(actualProjectId === projectId ? {} : { projectId: actualProjectId }),
+      environmentRef: intern(dictionaries.environments, environments, environmentId, {
+        environmentId,
+        environmentBranchName,
+        environmentHostId,
+        environmentName,
+        environmentPath,
+        environmentProviderId,
+        environmentIsWorktree,
+        environmentWorkspaceDisplayKind,
+      }),
+      ...(p6rParticipants === undefined
+        ? {}
+        : {
+            p6rParticipants: p6rParticipants.map((p) =>
+                intern(dictionaries.participants, participants, p.p6rPrincipalKey, p),
+            ),
+          }),
+    };
+  }
+  return { dictionaries, row };
+}
+
+function decodeRow(
+  row: Row,
+  dictionaries: Dictionaries,
+  projectId: string,
+): ThreadListEntry {
+  const { environmentRef, p6rParticipants, ...rest } = row;
+  return threadListEntrySchema.parse({
+    ...defaults,
+    ...rest,
+    projectId: row.projectId ?? projectId,
+    ...dictionaries.environments[environmentRef],
+    ...(p6rParticipants === undefined
+      ? {}
+      : {
+          p6rParticipants: p6rParticipants.map(
+            (ref) => dictionaries.participants[ref],
+          ),
+        }),
+  });
+}
+
+export function encodeP6rSidebarBootstrap(
+  value: SidebarBootstrapResponse,
+): P6rSidebarBootstrap {
+  const encoder = createEncoder();
+  const project = (p: SidebarBootstrapResponse["personalProject"]) => ({
+    ...p,
+    threads: p.threads.map((t) => encoder.row(t, p.id)),
+  });
+  const personalProject = project(value.personalProject);
+  const projects = value.projects.map(project);
+  return {
+    ...encoder.dictionaries,
+    sections: value.sections,
+    projects,
+    personalProject,
+  };
+}
+
+export function decodeP6rSidebarBootstrap(
+  input: unknown,
+): SidebarBootstrapResponse {
+  const value = p6rSidebarBootstrapSchema.parse(input);
+  const project = (p: P6rSidebarBootstrap["personalProject"]) => ({
+    ...p,
+    threads: p.threads.map((t) => decodeRow(t, value, p.id)),
+  });
+  return {
+    sections: value.sections,
+    projects: value.projects.map(project),
+    personalProject: project(value.personalProject),
+  };
+}
+
+export function encodeP6rSidebarThreads(
+  threads: ThreadListEntry[],
+  missingIds: string[],
+): P6rSidebarThreads {
+  const encoder = createEncoder();
+  const rows = threads.map((thread) => ({
+    ...encoder.row(thread),
+    projectId: thread.projectId,
+  }));
+  return { ...encoder.dictionaries, threads: rows, missingIds };
+}
+
+export function decodeP6rSidebarThreads(input: unknown): {
+  threads: ThreadListEntry[];
+  missingIds: string[];
+} {
+  const value = p6rSidebarThreadsSchema.parse(input);
+  return {
+    threads: value.threads.map((row) => decodeRow(row, value, row.projectId)),
+    missingIds: value.missingIds,
+  };
+}
