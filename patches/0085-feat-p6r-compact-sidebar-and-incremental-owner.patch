index 0000000000000000000000000000000000000000..415eec4b00b89473f9cce5c4b51c85ae26e3126f
--- /dev/null
+++ b/apps/app/src/hooks/cache-owners/p6r-sidebar-owner.ts
@@ -0,0 +1,329 @@
+import type { QueryClient } from "@tanstack/react-query";
+import type { ThreadListEntry } from "@bb/domain";
+import type {
+  ChangedMessage,
+  SidebarBootstrapResponse,
+} from "@bb/server-contract";
+import { sidebarNavigationQueryKey } from "../queries/query-keys";
+
+export interface P6rSidebarReads {
+  full(): Promise<SidebarBootstrapResponse>;
+  projects?(): Promise<SidebarBootstrapResponse>;
+  rows(
+    ids: string[],
+  ): Promise<{ threads: ThreadListEntry[]; missingIds: string[] }>;
+  persist(value: SidebarBootstrapResponse): void;
+}
+
+function entries(value: SidebarBootstrapResponse | undefined) {
+  return new Map(
+    [value?.personalProject, ...(value?.projects ?? [])]
+      .flatMap((project) => project?.threads ?? [])
+      .map((row) => [row.id, row]),
+  );
+}
+
+function compareRows(left: ThreadListEntry, right: ThreadListEntry) {
+  const leftPinned = left.pinnedAt !== null;
+  const rightPinned = right.pinnedAt !== null;
+  if (leftPinned !== rightPinned) return leftPinned ? -1 : 1;
+  const compare = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
+  if (leftPinned) {
+    if (left.pinSortKey !== right.pinSortKey) {
+      if (left.pinSortKey === null) return -1;
+      if (right.pinSortKey === null) return 1;
+      return compare(left.pinSortKey, right.pinSortKey);
+    }
+    return compare(left.id, right.id);
+  }
+  return right.createdAt - left.createdAt || compare(right.id, left.id);
+}
+
+export class P6rSidebarOwner {
+  private leases = 0;
+  private generation = 0;
+  private running = false;
+  private fullPending = false;
+  private projectsPending = false;
+  private ids = new Set<string>();
+  private timer: ReturnType<typeof setTimeout> | undefined;
+  private failures = 0;
+  private waiters: Array<{ resolve(): void; reject(error: Error): void }> = [];
+
+  constructor(
+    private client: QueryClient,
+    private reads: P6rSidebarReads,
+    private visible: () => boolean = () => true,
+  ) {}
+
+  acquire(): () => void {
+    if (this.leases++ === 0) {
+      this.generation++;
+      this.fullPending = true;
+      this.schedule();
+    }
+    let released = false;
+    return () => {
+      if (released) return;
+      released = true;
+      if (--this.leases !== 0) return;
+      this.generation++;
+      if (this.timer !== undefined) clearTimeout(this.timer);
+      this.timer = undefined;
+      this.ids.clear();
+      for (const waiter of this.waiters.splice(0))
+        waiter.reject(new Error("Sidebar reader retired"));
+    };
+  }
+
+  refresh(): Promise<void> {
+    this.fullPending = true;
+    this.schedule();
+    return new Promise((resolve, reject) =>
+      this.waiters.push({ resolve, reject }),
+    );
+  }
+
+  resume(): void {
+    this.fullPending = true;
+    this.schedule();
+  }
+
+  changed(message: ChangedMessage): void {
+    if (!this.leases) return;
+    if (message.entity === "thread") {
+      if (!message.id) {
+        this.resume();
+        return;
+      }
+      if (
+        message.changes.every((kind) => kind === "events-appended") &&
+        message.metadata?.backgroundActivityChanged !== true &&
+        !message.metadata?.eventTypes?.some(
+          (type) =>
+            type === "turn/completed" || type === "client/turn/requested",
+        )
+      )
+        return;
+      this.ids.add(message.id);
+      if (
+        message.changes.some(
+          (kind) =>
+            kind === "thread-deleted" ||
+            kind === "archived-changed" ||
+            kind === "parent-changed",
+        )
+      ) {
+        let count = -1;
+        const rows = entries(this.data());
+        while (count !== this.ids.size) {
+          count = this.ids.size;
+          for (const row of rows.values()) {
+            if (row.parentThreadId && this.ids.has(row.parentThreadId))
+              this.ids.add(row.id);
+          }
+        }
+      }
+    } else if (message.entity === "environment" || message.entity === "host") {
+      if (
+        message.entity === "environment" &&
+        !message.changes.some(
+          (kind) =>
+            kind === "metadata-changed" || kind === "environment-deleted",
+        )
+      )
+        return;
+      if (
+        message.entity === "host" &&
+        message.changes.every(
+          (kind) => kind === "provider-model-catalog-changed",
+        )
+      )
+        return;
+      if (!message.id) {
+        this.resume();
+        return;
+      }
+      for (const row of entries(this.data()).values()) {
+        if (
+          message.entity === "environment"
+            ? row.environmentId === message.id
+            : row.environmentHostId === message.id
+        )
+          this.ids.add(row.id);
+      }
+    } else if (message.entity === "project") {
+      if (this.reads.projects) this.projectsPending = true;
+      else this.fullPending = true;
+    } else {
+      return;
+    }
+    this.schedule();
+  }
+
+  private data() {
+    return this.client.getQueryData<SidebarBootstrapResponse>(
+      sidebarNavigationQueryKey(),
+    );
+  }
+
+  private query() {
+    return this.client
+      .getQueryCache()
+      .build<SidebarBootstrapResponse>(this.client, {
+        queryKey: sidebarNavigationQueryKey(),
+      });
+  }
+
+  private schedule(delay = 50) {
+    if (
+      !this.leases ||
+      this.running ||
+      this.timer !== undefined ||
+      !this.visible() ||
+      (!this.fullPending && !this.projectsPending && !this.ids.size)
+    )
+      return;
+    this.timer = setTimeout(() => {
+      this.timer = undefined;
+      void this.run();
+    }, delay);
+  }
+
+  private publish(value: SidebarBootstrapResponse) {
+    this.query().setData(value);
+    const patched = this.data();
+    if (patched) this.reads.persist(patched);
+  }
+
+  private async run() {
+    if (!this.leases || this.running || !this.visible()) return;
+    this.running = true;
+    const generation = this.generation;
+    const full = this.fullPending || this.data() === undefined;
+    const metadata =
+      !full && this.projectsPending && this.reads.projects !== undefined;
+    const ids = full
+      ? [...this.ids]
+      : metadata
+        ? []
+        : [...this.ids].slice(0, 200);
+    if (full) this.fullPending = false;
+    if (full || metadata) this.projectsPending = false;
+    for (const id of ids) this.ids.delete(id);
+    const waiters = full ? this.waiters.splice(0) : [];
+    const before = this.data();
+    const beforeRows = entries(before);
+    this.query().setState({ fetchStatus: "fetching" });
+    try {
+      const response = full
+        ? await this.reads.full()
+        : metadata
+          ? await this.reads.projects!()
+          : await this.reads.rows(ids);
+      if (!this.leases || generation !== this.generation) {
+        for (const waiter of waiters)
+          waiter.reject(new Error("Sidebar reader retired"));
+        return;
+      }
+      const current = this.data();
+      const currentRows = entries(current);
+      const changed = (id: string) =>
+        beforeRows.get(id) !== currentRows.get(id);
+      const merge = (
+        incoming: ThreadListEntry,
+      ): ThreadListEntry | undefined => {
+        if (!changed(incoming.id)) return incoming;
+        this.ids.add(incoming.id);
+        const previous = beforeRows.get(incoming.id);
+        const latest = currentRows.get(incoming.id);
+        if (!latest || !previous) return latest;
+        const patches: Partial<ThreadListEntry> = {};
+        for (const field of Object.keys(latest)) {
+          if (Reflect.get(previous, field) !== Reflect.get(latest, field))
+            Reflect.set(patches, field, Reflect.get(latest, field));
+        }
+        return { ...incoming, ...patches };
+      };
+      const publishRows = (
+        base: SidebarBootstrapResponse,
+        rows: Map<string, ThreadListEntry>,
+      ) => {
+        const project = (p: SidebarBootstrapResponse["personalProject"]) => ({
+          ...p,
+          threads: [...rows.values()]
+            .filter((row) => row.projectId === p.id)
+            .sort(compareRows),
+        });
+        this.publish({
+          ...base,
+          personalProject: project(base.personalProject),
+          projects: base.projects.map(project),
+        });
+      };
+      if ("personalProject" in response) {
+        if (metadata) publishRows(response, currentRows);
+        else {
+          const incoming = entries(response);
+          const rows = new Map<string, ThreadListEntry>();
+          for (const row of incoming.values()) {
+            const merged = merge(row);
+            if (merged) rows.set(row.id, merged);
+          }
+          for (const row of currentRows.values()) {
+            if (!incoming.has(row.id) && changed(row.id)) {
+              rows.set(row.id, row);
+              this.ids.add(row.id);
+            }
+          }
+          publishRows(response, rows);
+        }
+      } else if (current) {
+        const rows = new Map(currentRows);
+        const missing = new Set(response.missingIds);
+        for (const id of ids) {
+          if (!missing.has(id)) continue;
+          if (changed(id)) this.ids.add(id);
+          else rows.delete(id);
+        }
+        const knownProjects = new Set([
+          current.personalProject.id,
+          ...current.projects.map((p) => p.id),
+        ]);
+        for (const row of response.threads) {
+          const merged = merge(row);
+          if (merged) rows.set(row.id, merged);
+          else rows.delete(row.id);
+          if (merged && !knownProjects.has(merged.projectId))
+            this.fullPending = true;
+        }
+        publishRows(current, rows);
+      }
+      this.failures = 0;
+      for (const waiter of waiters) waiter.resolve();
+    } catch (failure) {
+      const error =
+        failure instanceof Error ? failure : new Error(String(failure));
+      if (this.leases && generation === this.generation) {
+        this.query().setState({
+          status: "error",
+          error,
+          errorUpdatedAt: Date.now(),
+        });
+        if (full) this.fullPending = true;
+        else if (metadata) this.projectsPending = true;
+        else for (const id of ids) this.ids.add(id);
+        this.failures++;
+      }
+      for (const waiter of waiters) waiter.reject(error);
+    } finally {
+      this.running = false;
+      this.query().setState({ fetchStatus: "idle" });
+      this.schedule(
+        this.failures
+          ? Math.min(30000, 1000 * 2 ** Math.min(this.failures - 1, 5))
+          : 50,
+      );
+    }
+  }
+}
