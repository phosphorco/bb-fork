index 0000000000000000000000000000000000000000..fc071c626bb779fd22bb0cb1fa422a80d9782376
--- /dev/null
+++ b/packages/server-contract/test/p6r-sidebar.p6r.test.ts
@@ -0,0 +1,142 @@
+import { describe, expect, it } from "vitest";
+import { threadListEntrySchema } from "@bb/domain";
+import { sidebarBootstrapResponseSchema } from "../src/api/projects.js";
+import {
+  decodeP6rSidebarBootstrap,
+  encodeP6rSidebarBootstrap,
+  p6rSidebarBootstrapSchema,
+} from "../src/p6r-sidebar.js";
+
+function fixture() {
+  const thread = threadListEntrySchema.parse({
+    id: "thr_one",
+    projectId: "personal",
+    environmentId: "env_one",
+    providerId: "codex",
+    title: null,
+    titleFallback: "Exact fallback",
+    sectionId: null,
+    status: "idle",
+    parentThreadId: null,
+    sourceThreadId: null,
+    lifecycleOwnerThreadId: null,
+    originKind: null,
+    originPluginId: null,
+    visibility: "visible",
+    parentNotifications: "auto",
+    archivedAt: null,
+    pinnedAt: null,
+    deletedAt: null,
+    lastReadAt: null,
+    latestAttentionAt: 2,
+    createdAt: 1,
+    updatedAt: 3,
+    activity: {
+      activeWorkflowCount: 0,
+      activeBackgroundAgentCount: 0,
+      activeBackgroundCommandCount: 0,
+      activePlanModeCount: 0,
+      activeGoalCount: 0,
+    },
+    runtime: { displayStatus: "idle" },
+    queuedWork: "none",
+    pinSortKey: null,
+    hasPendingInteraction: false,
+    environmentBranchName: "main",
+    environmentHostId: "host_one",
+    environmentName: null,
+    environmentPath: "/workspace/exact",
+    environmentProviderId: "local-path",
+    environmentIsWorktree: false,
+    environmentWorkspaceDisplayKind: "other",
+    p6rParticipants: [
+      {
+        p6rPrincipalKey: "person:one",
+        p6rDisplayName: "One",
+        p6rImageUrl: "https://example.test/avatar/" + "a".repeat(300),
+      },
+    ],
+  });
+  return sidebarBootstrapResponseSchema.parse({
+    sections: [],
+    projects: [],
+    personalProject: {
+      id: "personal",
+      kind: "personal",
+      name: "Personal",
+      gitRemoteUrl: null,
+      createdAt: 1,
+      updatedAt: 2,
+      sources: [],
+      defaultExecutionOptions: null,
+      threads: [
+        thread,
+        {
+          ...thread,
+          id: "thr_two",
+          title: "Two",
+          sectionId: "section",
+          parentThreadId: "thr_one",
+          pinnedAt: 10,
+          pinSortKey: "a",
+          status: "error",
+          lastReadAt: 1,
+          parentNotifications: "stuck",
+          hasPendingInteraction: true,
+          queuedWork: "failed",
+          activity: { ...thread.activity, activeGoalCount: 1 },
+        },
+      ],
+    },
+  });
+}
+
+describe("p6r sidebar wire", () => {
+  it("restores the complete row contract and non-default behavior", () => {
+    const input = fixture();
+    const wire = encodeP6rSidebarBootstrap(input);
+    expect(wire.environments).toHaveLength(1);
+    expect(wire.participants).toHaveLength(1);
+    expect(wire.personalProject.threads[0]).not.toHaveProperty("activity");
+    expect(decodeP6rSidebarBootstrap(JSON.parse(JSON.stringify(wire)))).toEqual(
+      input,
+    );
+    expect(JSON.stringify(wire).length).toBeLessThan(
+      JSON.stringify(input).length,
+    );
+  });
+
+  it("does not merge distinct snapshots sharing the same identity", () => {
+    const input = fixture();
+    input.personalProject.threads[1]!.environmentPath = "/another/exact/path";
+    input.personalProject.threads[1]!.p6rParticipants![0] = {
+      ...input.personalProject.threads[0]!.p6rParticipants![0]!,
+      p6rDisplayName: "Updated",
+    };
+    const wire = encodeP6rSidebarBootstrap(input);
+    expect(wire.environments).toHaveLength(2);
+    expect(wire.participants).toHaveLength(2);
+    expect(decodeP6rSidebarBootstrap(wire)).toEqual(input);
+  });
+
+  it("preserves optional participants, duplicates, order and an explicit project", () => {
+    const input = fixture();
+    delete input.personalProject.threads[0]!.p6rParticipants;
+    const second = input.personalProject.threads[1]!;
+    second.projectId = "another-project";
+    second.p6rParticipants = [
+      ...second.p6rParticipants!,
+      ...second.p6rParticipants!,
+    ];
+    expect(decodeP6rSidebarBootstrap(encodeP6rSidebarBootstrap(input))).toEqual(
+      input,
+    );
+  });
+
+  it("rejects dangling dictionary references instead of inventing defaults", () => {
+    const wire = encodeP6rSidebarBootstrap(fixture());
+    wire.personalProject.threads[0]!.environmentRef = 99;
+    expect(() => decodeP6rSidebarBootstrap(wire)).toThrow();
+    expect(p6rSidebarBootstrapSchema.safeParse(wire).success).toBe(false);
+  });
+});
