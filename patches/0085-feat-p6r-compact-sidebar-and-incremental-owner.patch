+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { QueryClient, QueryObserver } from "@tanstack/react-query";
+import { makeThreadListEntry } from "@bb/test-helpers/domain-fixtures";
+import {
+  makeSidebarBootstrapResponse,
+  makeProjectWithThreadsResponse,
+} from "@/test/fixtures/projects";
+import type {
+  ChangedMessage,
+  SidebarBootstrapResponse,
+} from "@bb/server-contract";
+import { sidebarNavigationQueryKey } from "../queries/query-keys";
+import { holdPendingThreadPatches } from "./pending-thread-patches";
+import { P6rSidebarOwner, type P6rSidebarReads } from "./p6r-sidebar-owner";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+}
+
+function fixture() {
+  return makeSidebarBootstrapResponse({
+    projects: [
+      makeProjectWithThreadsResponse({
+        threads: [
+          makeThreadListEntry({
+            id: "thr_one",
+            projectId: "proj_test",
+            title: "Before",
+          }),
+        ],
+      }),
+    ],
+  });
+}
+
+const change = (id = "thr_one"): ChangedMessage => ({
+  type: "changed",
+  entity: "thread",
+  id,
+  changes: ["title-changed"],
+});
+const key = sidebarNavigationQueryKey();
+
+describe("compact sidebar request ownership", () => {
+  const releases: Array<() => void> = [];
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => {
+    for (const release of releases.splice(0)) release();
+    vi.useRealTimers();
+  });
+
+  function setup(reads: P6rSidebarReads, visible?: () => boolean) {
+    const client = new QueryClient({
+      defaultOptions: { queries: { gcTime: Infinity, retry: false } },
+    });
+    const observer = new QueryObserver(client, {
+      queryKey: key,
+      enabled: false,
+      queryFn: async () => fixture(),
+    });
+    releases.push(observer.subscribe(() => {}));
+    const owner = new P6rSidebarOwner(client, reads, visible);
+    releases.push(owner.acquire());
+    return {
+      client,
+      owner,
+      data: () => client.getQueryData<SidebarBootstrapResponse>(key)!,
+    };
+  }
+
+  it("finishes one physical snapshot under cancellation and coalesces row changes", async () => {
+    const read = deferred<SidebarBootstrapResponse>();
+    const full = vi.fn(() => read.promise);
+    const rows = vi.fn(async () => ({
+      threads: [{ ...fixture().projects[0]!.threads[0]!, title: "After" }],
+      missingIds: [],
+    }));
+    const { owner, client, data } = setup({ full, rows, persist: vi.fn() });
+    await vi.advanceTimersByTimeAsync(50);
+    for (let i = 0; i < 100; i++) {
+      owner.changed(change());
+      await client.cancelQueries({ queryKey: key });
+      await client.invalidateQueries({ queryKey: key });
+    }
+    await vi.advanceTimersByTimeAsync(10000);
+    expect(full).toHaveBeenCalledTimes(1);
+    expect(rows).not.toHaveBeenCalled();
+    read.resolve(fixture());
+    await vi.advanceTimersByTimeAsync(50);
+    expect(full).toHaveBeenCalledTimes(1);
+    expect(rows).toHaveBeenCalledTimes(1);
+    expect(rows).toHaveBeenCalledWith(["thr_one"]);
+    expect(data().projects[0]!.threads[0]!.title).toBe("After");
+  });
+
+  it("coalesces broad invalidations into one follow-up and retains optimistic edits", async () => {
+    const first = deferred<SidebarBootstrapResponse>();
+    const full = vi
+      .fn()
+      .mockReturnValueOnce(first.promise)
+      .mockResolvedValue(fixture());
+    const { owner, client, data } = setup({
+      full,
+      rows: vi.fn(async () => ({ threads: [], missingIds: [] })),
+      persist: vi.fn(),
+    });
+    await vi.advanceTimersByTimeAsync(50);
+    for (let i = 0; i < 100; i++) owner.resume();
+    owner.changed(change());
+    releases.push(
+      holdPendingThreadPatches(
+        client,
+        new Map([["thr_one", { title: "Optimistic" }]]),
+      ),
+    );
+    first.resolve(fixture());
+    await vi.advanceTimersByTimeAsync(50);
+    expect(full).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(100);
+    expect(full).toHaveBeenCalledTimes(2);
+    expect(data().projects[0]!.threads[0]!.title).toBe("Optimistic");
+  });
+
+  it("applies moves, creations and explicit tombstones without a bootstrap", async () => {
+    const start = fixture();
+    const moved = {
+      ...start.projects[0]!.threads[0]!,
+      projectId: start.personalProject.id,
+      pinnedAt: 20,
+    };
+    const created = makeThreadListEntry({
+      id: "thr_new",
+      projectId: start.personalProject.id,
+    });
+    const rows = vi
+      .fn()
+      .mockResolvedValueOnce({ threads: [moved, created], missingIds: [] })
+      .mockResolvedValueOnce({ threads: [], missingIds: [moved.id] });
+    const full = vi.fn(async () => start);
+    const { owner, data } = setup({ full, rows, persist: vi.fn() });
+    await vi.advanceTimersByTimeAsync(50);
+    owner.changed(change());
+    owner.changed(change(created.id));
+    await vi.advanceTimersByTimeAsync(50);
+    expect(data().projects[0]!.threads).toEqual([]);
+    expect(data().personalProject.threads.map((row) => row.id)).toEqual([
+      moved.id,
+      created.id,
+    ]);
+    owner.changed(change());
+    await vi.advanceTimersByTimeAsync(50);
+    expect(data().personalProject.threads.map((row) => row.id)).toEqual([
+      created.id,
+    ]);
+    expect(full).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not overwrite a concurrent row patch and retries the affected row", async () => {
+    const delta = deferred<Awaited<ReturnType<P6rSidebarReads["rows"]>>>();
+    const rows = vi
+      .fn()
+      .mockReturnValueOnce(delta.promise)
+      .mockResolvedValue({ threads: [], missingIds: [] });
+    const { owner, client, data } = setup({
+      full: async () => fixture(),
+      rows,
+      persist: vi.fn(),
+    });
+    await vi.advanceTimersByTimeAsync(50);
+    owner.changed(change());
+    await vi.advanceTimersByTimeAsync(50);
+    const patched = fixture();
+    patched.projects[0]!.threads[0]!.title = "Concurrent";
+    client.setQueryData(key, patched);
+    delta.resolve({ threads: fixture().projects[0]!.threads, missingIds: [] });
+    await vi.advanceTimersByTimeAsync(0);
+    expect(data().projects[0]!.threads[0]!.title).toBe("Concurrent");
+    await vi.advanceTimersByTimeAsync(50);
+    expect(rows).toHaveBeenCalledTimes(2);
+  });
+
+  it("handles project notifications accompanying creation without rereading the thread catalogue", async () => {
+    const full = vi.fn(async () => fixture());
+    const projects = vi.fn(async () => ({
+      ...fixture(),
+      sections: [
+        { id: "section_one", name: "Section", createdAt: 1, updatedAt: 1 },
+      ],
+    }));
+    const rows = vi.fn(async () => ({
+      threads: [makeThreadListEntry({ id: "thr_new", projectId: "proj_test" })],
+      missingIds: [],
+    }));
+    const { owner, data } = setup({ full, projects, rows, persist: vi.fn() });
+    await vi.advanceTimersByTimeAsync(50);
+    owner.changed(change("thr_new"));
+    owner.changed({
+      type: "changed",
+      entity: "project",
+      id: "proj_test",
+      changes: ["threads-changed"],
+    });
+    await vi.advanceTimersByTimeAsync(100);
+    expect(full).toHaveBeenCalledTimes(1);
+    expect(projects).toHaveBeenCalledTimes(1);
+    expect(rows).toHaveBeenCalledWith(["thr_new"]);
+    expect(data().sections[0]?.name).toBe("Section");
+    expect(
+      data()
+        .projects[0]!.threads.map((row) => row.id)
+        .sort(),
+    ).toEqual(["thr_new", "thr_one"]);
+  });
+
+  it("bounds every row read to 200 IDs and keeps only one request in flight", async () => {
+    const read = deferred<Awaited<ReturnType<P6rSidebarReads["rows"]>>>();
+    const rows = vi
+      .fn()
+      .mockReturnValueOnce(read.promise)
+      .mockResolvedValue({ threads: [], missingIds: [] });
+    const full = vi.fn(async () => fixture());
+    const { owner } = setup({ full, rows, persist: vi.fn() });
+    await vi.advanceTimersByTimeAsync(50);
+    for (let i = 0; i < 251; i++) owner.changed(change(`thr_${i}`));
+    await vi.advanceTimersByTimeAsync(5000);
+    expect(rows).toHaveBeenCalledTimes(1);
+    expect(rows.mock.calls[0]![0]).toHaveLength(200);
+    read.resolve({ threads: [], missingIds: [] });
+    await vi.advanceTimersByTimeAsync(50);
+    expect(rows).toHaveBeenCalledTimes(2);
+    expect(rows.mock.calls[1]![0]).toHaveLength(51);
+    expect(full).toHaveBeenCalledTimes(1);
+  });
+
+  it("backs off failures, pauses while hidden and retires without publishing", async () => {
+    let visible = true;
+    const read = deferred<SidebarBootstrapResponse>();
+    const full = vi
+      .fn()
+      .mockRejectedValueOnce(new Error("offline"))
+      .mockReturnValueOnce(read.promise);
+    const { owner, client } = setup(
+      { full, rows: vi.fn(), persist: vi.fn() },
+      () => visible,
+    );
+    await vi.advanceTimersByTimeAsync(50);
+    expect(client.getQueryState(key)?.status).toBe("error");
+    visible = false;
+    await vi.advanceTimersByTimeAsync(1000);
+    expect(full).toHaveBeenCalledTimes(1);
+    visible = true;
+    owner.resume();
+    await vi.advanceTimersByTimeAsync(50);
+    expect(full).toHaveBeenCalledTimes(2);
+    for (const release of releases.splice(0)) release();
+    read.resolve(fixture());
+    await vi.advanceTimersByTimeAsync(50);
+    expect(client.getQueryData(key)).toBeUndefined();
+  });
+
+  it("publishes completed rows during a continuous change stream and merges independent cache edits", async () => {
+    const first = deferred<Awaited<ReturnType<P6rSidebarReads["rows"]>>>();
+    const second = deferred<Awaited<ReturnType<P6rSidebarReads["rows"]>>>();
+    const rows = vi
+      .fn()
+      .mockReturnValueOnce(first.promise)
+      .mockReturnValueOnce(second.promise);
+    const { owner, client, data } = setup({
+      full: async () => fixture(),
+      rows,
+      persist: vi.fn(),
+    });
+    await vi.advanceTimersByTimeAsync(50);
+    owner.changed(change());
+    await vi.advanceTimersByTimeAsync(50);
+    for (let i = 0; i < 100; i++) owner.changed(change());
+    const patched = fixture();
+    patched.projects[0]!.threads[0]!.pinnedAt = 123;
+    client.setQueryData(key, patched);
+    first.resolve({
+      threads: [{ ...fixture().projects[0]!.threads[0]!, title: "Progress" }],
+      missingIds: [],
+    });
+    await vi.advanceTimersByTimeAsync(50);
+    expect(rows).toHaveBeenCalledTimes(2);
+    expect(data().projects[0]!.threads[0]!.title).toBe("Progress");
+    expect(data().projects[0]!.threads[0]!.pinnedAt).toBe(123);
+    owner.changed(change());
+    second.resolve({
+      threads: [
+        {
+          ...fixture().projects[0]!.threads[0]!,
+          title: "Further progress",
+          pinnedAt: 123,
+        },
+      ],
+      missingIds: [],
+    });
+    await vi.advanceTimersByTimeAsync(0);
+    expect(data().projects[0]!.threads[0]!.title).toBe("Further progress");
+  });
+
+  it("keeps a concurrent project move visible while a stale baseline finishes", async () => {
+    const read = deferred<SidebarBootstrapResponse>();
+    const full = vi
+      .fn()
+      .mockResolvedValueOnce(fixture())
+      .mockReturnValueOnce(read.promise);
+    const { owner, client, data } = setup({
+      full,
+      rows: vi.fn(),
+      persist: vi.fn(),
+    });
+    await vi.advanceTimersByTimeAsync(50);
+    owner.resume();
+    await vi.advanceTimersByTimeAsync(50);
+    const patched = fixture();
+    patched.personalProject.threads = patched.projects[0]!.threads.map(
+      (row) => ({ ...row, projectId: patched.personalProject.id }),
+    );
+    patched.projects[0]!.threads = [];
+    client.setQueryData(key, patched);
+    read.resolve(fixture());
+    await vi.advanceTimersByTimeAsync(0);
+    expect(data().projects[0]!.threads).toEqual([]);
+    expect(data().personalProject.threads.map((row) => row.id)).toEqual([
+      "thr_one",
+    ]);
+  });
+});
