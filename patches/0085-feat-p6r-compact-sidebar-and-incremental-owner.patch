+import { QueryClient } from "@tanstack/react-query";
+import { describe, expect, it, vi } from "vitest";
+import { threadTabsQueryKey } from "@/hooks/queries/query-keys";
+import { readP6rThreadTabs } from "./p6r-thread-tabs";
+
+const get = vi.hoisted(() => vi.fn());
+vi.mock("./sdk", () => ({ sdk: { threads: { tabs: { get } } } }));
+
+describe("thread tabs shared read", () => {
+  it("joins an in-flight observer read and reuses its revision", async () => {
+    const client = new QueryClient({
+      defaultOptions: { queries: { gcTime: Infinity } },
+    });
+    let resolve!: (value: { tabs: []; revision: number }) => void;
+    const response = new Promise<{ tabs: []; revision: number }>((yes) => {
+      resolve = yes;
+    });
+    const firstGet = vi.fn(() => response);
+    const existing = client.fetchQuery({
+      queryKey: threadTabsQueryKey("thr_one"),
+      queryFn: firstGet,
+    });
+    const joined = readP6rThreadTabs(client, "thr_one");
+    resolve({ tabs: [], revision: 7 });
+    expect(await joined).toEqual(await existing);
+    expect(await readP6rThreadTabs(client, "thr_one")).toEqual({
+      tabs: [],
+      revision: 7,
+    });
+    expect(firstGet).toHaveBeenCalledTimes(1);
+    expect(get).not.toHaveBeenCalled();
+  });
+});
