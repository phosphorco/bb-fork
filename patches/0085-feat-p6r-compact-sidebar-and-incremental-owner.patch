+import { useEffect, useState } from "react";
+import {
+  QueryObserver,
+  useQuery,
+  useQueryClient,
+  type QueryClient,
+  type RefetchOptions,
+} from "@tanstack/react-query";
+import {
+  decodeP6rSidebarBootstrap,
+  decodeP6rSidebarThreads,
+  type RealtimeSubscriptionTarget,
+  type SidebarBootstrapResponse,
+} from "@bb/server-contract";
+import { apiClient } from "@/lib/api-server";
+import { request } from "@/lib/api";
+import { isP6rSidebarEnabled } from "@/lib/p6r-sidebar-switch";
+import { writeCachedSidebarBootstrap } from "@/lib/sidebar-bootstrap-cache";
+import {
+  isDocumentVisible,
+  subscribeToDocumentVisibility,
+} from "@/lib/document-visibility";
+import { wsManager } from "@/lib/ws";
+import { P6rSidebarOwner } from "../cache-owners/p6r-sidebar-owner";
+import { sidebarNavigationQueryKey } from "./query-keys";
+import type { QueryOptions } from "./query-helpers";
+import {
+  useSidebarNavigation as useLegacySidebarNavigation,
+  useProjectDisplayName as useLegacyProjectDisplayName,
+} from "./sidebar-navigation-query";
+
+export {
+  useSidebarNavigationThreadSelection,
+  sidebarNavigationThreadSelectionQueryOptions,
+  toSidebarNavigationThreadSelection,
+  type SidebarNavigationThreadSelection,
+} from "./sidebar-navigation-query";
+
+const owners = new WeakMap<
+  QueryClient,
+  { owner: P6rSidebarOwner; count: number; detach?: () => void }
+>();
+const targets: RealtimeSubscriptionTarget[] = [
+  { kind: "thread-list" },
+  { kind: "project-list" },
+  { kind: "environment-list" },
+  { kind: "host-list" },
+];
+
+function resource(client: QueryClient) {
+  let value = owners.get(client);
+  if (!value) {
+    value = {
+      count: 0,
+      owner: new P6rSidebarOwner(
+        client,
+        {
+          full: async () =>
+            decodeP6rSidebarBootstrap(
+              await request(apiClient.p6r["sidebar-bootstrap"].$get()),
+            ),
+          projects: async () =>
+            decodeP6rSidebarBootstrap(
+              await request(apiClient.p6r["sidebar-projects"].$get()),
+            ),
+          rows: async (ids) =>
+            decodeP6rSidebarThreads(
+              await request(
+                apiClient.p6r["sidebar-threads"].$get({
+                  query: { ids: ids.join(",") },
+                }),
+              ),
+            ),
+          persist: writeCachedSidebarBootstrap,
+        },
+        isDocumentVisible,
+      ),
+    };
+    owners.set(client, value);
+  }
+  return value;
+}
+
+function acquire(client: QueryClient) {
+  const value = resource(client);
+  if (value.count++ === 0) {
+    for (const target of targets) wsManager.subscribe(target);
+    const stops = [
+      wsManager.onChanged((message) => value.owner.changed(message)),
+      wsManager.onConnected((event) => {
+        if (event.reconnected) value.owner.resume();
+      }),
+      wsManager.onResumed(() => value.owner.resume()),
+      subscribeToDocumentVisibility(() => {
+        if (isDocumentVisible()) value.owner.resume();
+      }),
+    ];
+    value.detach = () => {
+      for (const stop of stops) stop();
+      for (const target of targets) wsManager.unsubscribe(target);
+    };
+  }
+  const release = value.owner.acquire();
+  return () => {
+    release();
+    if (--value.count === 0) value.detach?.();
+  };
+}
+
+export function useP6rSidebarNavigation(options?: QueryOptions) {
+  const [compact] = useState(isP6rSidebarEnabled);
+  const enabled = options?.enabled ?? true;
+  const client = useQueryClient();
+  const result = useLegacySidebarNavigation({
+    ...options,
+    enabled: !compact && enabled,
+  });
+  useEffect(
+    () => (compact && enabled ? acquire(client) : undefined),
+    [client, compact, enabled],
+  );
+  return compact
+    ? {
+        ...result,
+        refetch: async (options?: RefetchOptions) => {
+          const release =
+            resource(client).count === 0 ? acquire(client) : undefined;
+          try {
+            await resource(client).owner.refresh();
+          } catch (error) {
+            if (options?.throwOnError) throw error;
+          } finally {
+            release?.();
+          }
+          const observer = new QueryObserver<SidebarBootstrapResponse>(client, {
+            queryKey: sidebarNavigationQueryKey(),
+            enabled: false,
+          });
+          const current = observer.getCurrentResult();
+          observer.destroy();
+          return current;
+        },
+      }
+    : result;
+}
+
+export function useP6rProjectDisplayName(
+  projectId: string | undefined,
+): string | undefined {
+  const [compact] = useState(isP6rSidebarEnabled);
+  const legacy = useLegacyProjectDisplayName(compact ? undefined : projectId);
+  const { data } = useQuery<SidebarBootstrapResponse>({
+    queryKey: sidebarNavigationQueryKey(),
+    enabled: false,
+  });
+  if (!compact) return legacy;
+  if (!projectId || !data) return undefined;
+  return [data.personalProject, ...data.projects].find(
+    (p) => p.id === projectId,
+  )?.name;
+}
