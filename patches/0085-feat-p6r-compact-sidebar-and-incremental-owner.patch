+import { describe, expect, it } from "vitest";
+import { eq } from "drizzle-orm";
+import { threads as threadsTable } from "@bb/db";
+import {
+  decodeP6rSidebarBootstrap,
+  decodeP6rSidebarThreads,
+  sidebarBootstrapResponseSchema,
+} from "@bb/server-contract";
+import { withTestHarness } from "../helpers/test-app.js";
+import { seedThread, seedThreadFixture } from "../helpers/seed.js";
+
+describe("additive sidebar reads", () => {
+  it("returns exactly the legacy collection including children, with complete metadata", async () => {
+    await withTestHarness(async (harness) => {
+      const { project, environment, thread } = seedThreadFixture(harness);
+      seedThread(harness.deps, {
+        projectId: project.id,
+        environmentId: environment.id,
+        parentThreadId: thread.id,
+      });
+      seedThread(harness.deps, {
+        projectId: "proj_personal",
+        title: "Personal",
+      });
+      seedThread(harness.deps, { projectId: project.id, visibility: "hidden" });
+      const archived = seedThread(harness.deps, { projectId: project.id });
+      harness.db
+        .update(threadsTable)
+        .set({ archivedAt: 100 })
+        .where(eq(threadsTable.id, archived.id))
+        .run();
+      const legacy = sidebarBootstrapResponseSchema.parse(
+        await (await harness.app.request("/api/v1/sidebar-bootstrap")).json(),
+      );
+      const response = await harness.app.request(
+        "/api/v1/p6r/sidebar-bootstrap",
+      );
+      expect(response.status).toBe(200);
+      expect(decodeP6rSidebarBootstrap(await response.json())).toEqual(legacy);
+      const metadata = decodeP6rSidebarBootstrap(
+        await (
+          await harness.app.request("/api/v1/p6r/sidebar-projects")
+        ).json(),
+      );
+      expect(metadata.sections).toEqual(legacy.sections);
+      expect(metadata.projects).toEqual(
+        legacy.projects.map((project) => ({ ...project, threads: [] })),
+      );
+      expect(metadata.personalProject).toEqual({
+        ...legacy.personalProject,
+        threads: [],
+      });
+      const again = await harness.app.request("/api/v1/sidebar-bootstrap");
+      expect(await again.json()).toEqual(legacy);
+    });
+  });
+
+  it("reads only requested eligible rows and explicitly reports removals", async () => {
+    await withTestHarness(async (harness) => {
+      const { project, thread } = seedThreadFixture(harness);
+      const hidden = seedThread(harness.deps, {
+        projectId: project.id,
+        visibility: "hidden",
+      });
+      const archived = seedThread(harness.deps, { projectId: project.id });
+      harness.db
+        .update(threadsTable)
+        .set({ archivedAt: 100 })
+        .where(eq(threadsTable.id, archived.id))
+        .run();
+      for (let i = 0; i < 20; i++)
+        seedThread(harness.deps, { projectId: project.id });
+      const ids = [thread.id, hidden.id, archived.id, "thr_missing"];
+      const response = await harness.app.request(
+        `/api/v1/p6r/sidebar-threads?ids=${ids.join(",")}`,
+      );
+      expect(response.status).toBe(200);
+      const data = decodeP6rSidebarThreads(await response.json());
+      expect(data.threads.map((row) => row.id)).toEqual([thread.id]);
+      expect(data.missingIds).toEqual(ids.slice(1));
+      const full = decodeP6rSidebarBootstrap(
+        await (
+          await harness.app.request("/api/v1/p6r/sidebar-bootstrap")
+        ).json(),
+      );
+      expect(data.threads[0]).toEqual(
+        full.projects
+          .find((p) => p.id === project.id)!
+          .threads.find((t) => t.id === thread.id),
+      );
+      for (const query of [
+        "",
+        "ids=bad",
+        `ids=${Array(201).fill(thread.id).join(",")}`,
+      ]) {
+        expect(
+          (await harness.app.request(`/api/v1/p6r/sidebar-threads?${query}`))
+            .status,
+        ).toBe(400);
+      }
+    });
+  });
+});
