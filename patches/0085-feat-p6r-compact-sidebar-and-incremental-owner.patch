+// @vitest-environment jsdom
+
+import { act, cleanup, renderHook, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  encodeP6rSidebarBootstrap,
+  encodeP6rSidebarThreads,
+  type ChangedMessage,
+} from "@bb/server-contract";
+import { makeThreadListEntry } from "@bb/test-helpers/domain-fixtures";
+import { createQueryClientTestHarness } from "@/test/queryClientTestHarness";
+import {
+  makeSidebarBootstrapResponse,
+  makeProjectWithThreadsResponse,
+} from "@/test/fixtures/projects";
+import { sidebarNavigationQueryKey } from "./query-keys";
+import { resetSidebarBootstrapCacheForTest } from "@/lib/sidebar-bootstrap-cache";
+import {
+  useP6rSidebarNavigation as useSidebarNavigation,
+  useP6rProjectDisplayName as useProjectDisplayName,
+} from "./p6r-sidebar-navigation-query";
+
+const mocks = vi.hoisted(() => ({
+  legacy: vi.fn(),
+  compact: vi.fn(),
+  rows: vi.fn(),
+  projects: vi.fn(),
+  changed: undefined as ((message: ChangedMessage) => void) | undefined,
+}));
+
+vi.mock("@/lib/api-server", () => ({
+  apiClient: {
+    "sidebar-bootstrap": { $get: mocks.legacy },
+    p6r: {
+      "sidebar-bootstrap": { $get: mocks.compact },
+      "sidebar-threads": { $get: mocks.rows },
+      "sidebar-projects": { $get: mocks.projects },
+    },
+  },
+}));
+vi.mock("@/lib/ws", () => ({
+  wsManager: {
+    subscribe: vi.fn(),
+    unsubscribe: vi.fn(),
+    onChanged: (callback: (message: ChangedMessage) => void) => {
+      mocks.changed = callback;
+      return () => {
+        mocks.changed = undefined;
+      };
+    },
+    onConnected: () => () => {},
+    onResumed: () => () => {},
+  },
+}));
+
+const response = (value: unknown) =>
+  Promise.resolve(new Response(JSON.stringify(value)));
+const fixture = () =>
+  makeSidebarBootstrapResponse({
+    projects: [
+      makeProjectWithThreadsResponse({
+        threads: [
+          makeThreadListEntry({ id: "thr_one", projectId: "proj_test" }),
+        ],
+      }),
+    ],
+  });
+
+beforeEach(() => {
+  localStorage.clear();
+  vi.clearAllMocks();
+  resetSidebarBootstrapCacheForTest();
+  mocks.legacy.mockImplementation(() => response(fixture()));
+  mocks.compact.mockImplementation(() =>
+    response(encodeP6rSidebarBootstrap(fixture())),
+  );
+  mocks.rows.mockImplementation(() =>
+    response(
+      encodeP6rSidebarThreads(
+        [{ ...fixture().projects[0]!.threads[0]!, title: "Changed" }],
+        [],
+      ),
+    ),
+  );
+  mocks.projects.mockImplementation(() =>
+    response(encodeP6rSidebarBootstrap(fixture())),
+  );
+});
+afterEach(() => cleanup());
+
+describe("sidebar rollout and rollback", () => {
+  it("allows an explicit refresh from an otherwise disabled observer", async () => {
+    localStorage.setItem("bb.p6r.compact-sidebar", "1");
+    const { wrapper } = createQueryClientTestHarness();
+    const { result } = renderHook(
+      () => useSidebarNavigation({ enabled: false }),
+      { wrapper },
+    );
+    expect(mocks.compact).not.toHaveBeenCalled();
+    await act(() => result.current.refetch());
+    await waitFor(() => expect(result.current.data).toEqual(fixture()));
+    expect(mocks.compact).toHaveBeenCalledTimes(1);
+    expect(mocks.legacy).not.toHaveBeenCalled();
+  });
+  it("uses the unchanged legacy path when the switch is absent", async () => {
+    const { wrapper } = createQueryClientTestHarness();
+    const { result } = renderHook(() => useSidebarNavigation(), { wrapper });
+    await waitFor(() => expect(result.current.data).toEqual(fixture()));
+    expect(mocks.legacy).toHaveBeenCalledTimes(1);
+    expect(mocks.compact).not.toHaveBeenCalled();
+  });
+
+  it("shares one compact owner, ignores legacy invalidations and updates the complete SDK cache", async () => {
+    localStorage.setItem("bb.p6r.compact-sidebar", "1");
+    const { wrapper, queryClient } = createQueryClientTestHarness();
+    const { result } = renderHook(
+      () => ({
+        first: useSidebarNavigation(),
+        second: useSidebarNavigation(),
+        name: useProjectDisplayName("proj_test"),
+      }),
+      { wrapper },
+    );
+    await waitFor(() => expect(result.current.first.data).toEqual(fixture()));
+    expect(result.current.name).toBe("Test project");
+    expect(mocks.compact).toHaveBeenCalledTimes(1);
+    await act(() =>
+      queryClient.invalidateQueries({ queryKey: sidebarNavigationQueryKey() }),
+    );
+    act(() => {
+      mocks.changed?.({
+        type: "changed",
+        entity: "thread",
+        id: "thr_one",
+        changes: ["title-changed"],
+      });
+    });
+    await waitFor(() =>
+      expect(result.current.second.data?.projects[0]?.threads[0]?.title).toBe(
+        "Changed",
+      ),
+    );
+    expect(mocks.rows).toHaveBeenCalledTimes(1);
+    expect(mocks.compact).toHaveBeenCalledTimes(1);
+    expect(mocks.legacy).not.toHaveBeenCalled();
+    await act(() => result.current.first.refetch());
+    expect(mocks.compact).toHaveBeenCalledTimes(2);
+    expect(mocks.legacy).not.toHaveBeenCalled();
+  });
+
+  it("returns to the legacy path when a new page removes the switch", async () => {
+    localStorage.setItem("bb.p6r.compact-sidebar", "1");
+    const first = renderHook(() => useSidebarNavigation(), {
+      wrapper: createQueryClientTestHarness().wrapper,
+    });
+    await waitFor(() => expect(mocks.compact).toHaveBeenCalledTimes(1));
+    first.unmount();
+    localStorage.removeItem("bb.p6r.compact-sidebar");
+    const second = renderHook(() => useSidebarNavigation(), {
+      wrapper: createQueryClientTestHarness().wrapper,
+    });
+    await waitFor(() => expect(second.result.current.data).toBeDefined());
+    expect(mocks.legacy).toHaveBeenCalledTimes(1);
+    expect(mocks.compact).toHaveBeenCalledTimes(1);
+  });
+});
