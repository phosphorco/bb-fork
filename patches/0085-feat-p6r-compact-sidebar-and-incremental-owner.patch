index 0000000000000000000000000000000000000000..e2c1a9f8f72368f0f4a10610b8e0676d838ec9f4
--- /dev/null
+++ b/apps/server/src/routes/p6r-sidebar.ts
@@ -0,0 +1,119 @@
+import type { Hono } from "hono";
+import {
+  getPersonalProject,
+  listPublicProjects,
+  listProjectSourcesByProjectIds,
+  listProjectExecutionDefaultsByProjectIds,
+  listThreadSections,
+  listThreadsWithPendingInteractionStateForProjects,
+  listThreadsWithPendingInteractionState,
+} from "@bb/db";
+import {
+  encodeP6rSidebarBootstrap,
+  encodeP6rSidebarThreads,
+  publicApiRoutes,
+  typedRoutes,
+  p6rSidebarThreadQuerySchema,
+  type PublicApiSchema,
+  type SidebarBootstrapResponse,
+} from "@bb/server-contract";
+import type { AppDeps } from "../types.js";
+import { ApiError } from "../errors.js";
+import { toThreadListEntryResponses } from "../services/threads/thread-runtime-display.js";
+
+function projects(deps: AppDeps) {
+  const personal = getPersonalProject(deps.db);
+  if (!personal)
+    throw new ApiError(
+      500,
+      "internal_error",
+      "Personal project is not initialized",
+    );
+  return { personal, publicProjects: listPublicProjects(deps.db) };
+}
+
+export function readP6rSidebarBootstrap(
+  deps: AppDeps,
+  includeThreads = true,
+): SidebarBootstrapResponse {
+  const { personal, publicProjects } = projects(deps);
+  const allProjects = [personal, ...publicProjects];
+  const projectIds = allProjects.map((p) => p.id);
+  const sources = listProjectSourcesByProjectIds(deps.db, projectIds);
+  const defaults = listProjectExecutionDefaultsByProjectIds(deps.db, {
+    projectIds,
+  });
+  const rows = includeThreads
+    ? toThreadListEntryResponses(deps, {
+        threads: listThreadsWithPendingInteractionStateForProjects(deps.db, {
+          projectIds,
+          archived: false,
+        }),
+      })
+    : [];
+  const rowsByProject = new Map<string, typeof rows>();
+  for (const row of rows) {
+    const bucket = rowsByProject.get(row.projectId);
+    if (bucket) bucket.push(row);
+    else rowsByProject.set(row.projectId, [row]);
+  }
+  const build = (p: typeof personal) => ({
+    id: p.id,
+    kind: p.kind,
+    name: p.name,
+    gitRemoteUrl: p.gitRemoteUrl,
+    createdAt: p.createdAt,
+    updatedAt: p.updatedAt,
+    sources: sources.filter((source) => source.projectId === p.id),
+    defaultExecutionOptions: defaults.get(p.id) ?? null,
+    threads: rowsByProject.get(p.id) ?? [],
+  });
+  return {
+    sections: listThreadSections(deps.db),
+    projects: publicProjects.map(build),
+    personalProject: build(personal),
+  };
+}
+
+export function registerP6rSidebarRoutes(app: Hono, deps: AppDeps): void {
+  const { get } = typedRoutes<PublicApiSchema>(app, {
+    onValidationError: (message) =>
+      new ApiError(400, "invalid_request", message),
+  });
+  get(publicApiRoutes.p6rSidebar.bootstrap, (context) =>
+    context.json(encodeP6rSidebarBootstrap(readP6rSidebarBootstrap(deps))),
+  );
+  get(publicApiRoutes.p6rSidebar.projects, (context) =>
+    context.json(
+      encodeP6rSidebarBootstrap(readP6rSidebarBootstrap(deps, false)),
+    ),
+  );
+  get(publicApiRoutes.p6rSidebar.threads, (context, query) => {
+    const parsed = p6rSidebarThreadQuerySchema.safeParse(query);
+    if (!parsed.success)
+      throw new ApiError(
+        400,
+        "invalid_request",
+        "Expected 1 to 200 thread IDs",
+      );
+    const ids = [...new Set(parsed.data.ids.split(","))];
+    const { personal, publicProjects } = projects(deps);
+    const eligibleProjects = new Set([
+      personal.id,
+      ...publicProjects.map((p) => p.id),
+    ]);
+    const rows = listThreadsWithPendingInteractionState(deps.db, {
+      threadIds: ids,
+      archived: false,
+      limit: 200,
+    }).filter((row) => eligibleProjects.has(row.projectId));
+    const threads = toThreadListEntryResponses(deps, { threads: rows });
+    const found = new Set(threads.map((row) => row.id));
+    return context.json(
+      encodeP6rSidebarThreads(
+        threads,
+        ids.filter((id) => !found.has(id)),
+      ),
+    );
+  });
+}
