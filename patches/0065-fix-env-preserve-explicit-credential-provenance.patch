+import { expect, it } from "vitest";
+import { hostDaemonContributedEnvEntrySchema } from "../src/commands.js";
+
+const entry = {
+  name: "ARBITRARY",
+  value: "synthetic-value",
+  source: { plugin: "producer" },
+  reason: "Explicit producer classification",
+};
+
+it.each([true, false])(
+  "preserves the required environment classification secret=%s",
+  (secret) => {
+    expect(
+      hostDaemonContributedEnvEntrySchema.parse({ ...entry, secret }),
+    ).toEqual({ ...entry, secret });
+  },
+);
+
+it.each([undefined, null, "false", 0])(
+  "rejects missing or nonboolean environment classification %s",
+  (secret) => {
+    expect(
+      hostDaemonContributedEnvEntrySchema.safeParse({ ...entry, secret })
+        .success,
+    ).toBe(false);
+  },
+);
