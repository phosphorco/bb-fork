diff --git a/docs/environment-diagnostic-classification.md b/docs/environment-diagnostic-classification.md
new file mode 100644
index 0000000000000000000000000000000000000000..97adf628996ab4d561d06969f5b808bd7d453bee
--- /dev/null
+++ b/docs/environment-diagnostic-classification.md
@@ -0,0 +1,75 @@
+# Environment diagnostic classification
+
+Phosphor's deployment is trusted internal tooling. Ordinary environment values,
+URLs, IP addresses, paths, identifiers, settings and error context remain visible.
+Only API keys and equivalent authentication secret values are hidden. Names,
+sources and reasons remain available; diagnostic masking does not change the
+environment delivered to a provider.
+
+## One explicit contract
+
+Machine and project environment writes require `secret: boolean`. Saved ordinary
+values are visible; credential values retain the existing null representation.
+The UI requires a choice for new/imported rows; the CLI requires exactly one of
+`--plain` or `--secret`. Encryption remains unchanged for both classifications.
+
+Plugin entries require `experimental_secret: boolean`. Server normalization
+passes this as the same required `secret` field used by core contributions.
+Host-daemon protocol 240 carries it without a default or compatibility lane.
+Global, project and provider overrides select the entire winning entry, including
+its classification. Native Git credentials mark only the generated `GH_TOKEN`
+as secret; Git identity/configuration and provider routing URLs/flags stay visible.
+
+The daemon captures managed shell values and their provenance in one detached,
+immutable snapshot. Runtime diagnostics retain that provenance even when a
+previously prepared command has no entry for a newly synced global setting.
+Thread-generated context keeps its original precedence. Per-command overrides
+continue to select their own exact value and classification.
+
+Registered resolver errors, timeouts and invalid entries stop preparation.
+Intentional absence is a valid empty array. Unresolved server-relative paths stop
+before starting a provider, including when an inherited same-name value exists.
+Cancellation remains cancellation. Errors name the producer, provider and stage
+and preserve their original diagnostic detail/cause; no environment dump is added.
+
+## Retained events
+
+The existing event shape and masked marker are unchanged. One source-attested
+credential-slot projection applies to every event, independent of age or version:
+
+| Recorded source | Authentication fields |
+| --- | --- |
+| `account-pool` | `ANTHROPIC_AUTH_TOKEN`, `CODEX_POOL_AUTH_TOKEN`, `BB_ACCOUNT_POOL_PARENT_TOKEN` |
+| `subscription-router` | `ANTHROPIC_AUTH_TOKEN`, `CODEX_POOL_AUTH_TOKEN` |
+
+These pairs are attested by their credential-producing implementations. They are
+not a variable-name pattern or a general secret registry. Empty strings and the
+public `csr.unresolved` sentinel remain visible. Other sources and fields retain
+their diagnostic content. Existing masked values stay masked: the original value
+was not recorded and must not be reconstructed from current settings. Shared
+schema/read projection protects list, wait and timeline reads without rewriting
+the original stored event JSON.
+
+## Database cutover
+
+Migration 0146 adds a required boolean without a default. Before any migration
+staging, schema or ledger mutation, existing unclassified environment rows cause
+an actionable refusal. This includes the prior `app_settings_values` storage
+under `machineEnvironment:%`. The database and encryption key are preserved.
+
+Fresh and empty installations can advance directly. A populated installation
+needs an explicit operator-reviewed classification cutover before this update;
+there is no force flag, automatic classifier or guessed backfill. The Phosphor
+pilot's two count-only preflights must establish that neither storage contains
+unclassified rows before deployment. Existing data must not be deleted to bypass
+the gate.
+
+## Maintenance
+
+The downstream patch touches the native environment input/storage, SDK validation,
+daemon/runtime propagation and shared event reader. Replay therefore needs the
+native migration generator, SDK type generator and synthetic cross-layer tests.
+The generic explicit-classification/fail-preparation seam can be upstreamed;
+remove its downstream hunks only when upstream supplies the same required contract
+and preserves provider environment bytes. The finite source-attested historical
+policy remains an intentional product decision while those originals are retained.
diff --git a/packages/agent-runtime/src/thread-shell-environment.test.ts b/packages/agent-runtime/src/thread-shell-environment.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fdc27953bc5756b861eb76a7ef1fd09f2fe8c961
--- /dev/null
+++ b/packages/agent-runtime/src/thread-shell-environment.test.ts
@@ -0,0 +1,238 @@
+import { describe, expect, it } from "vitest";
+import { resolveThreadEnvironment } from "./thread-shell-environment.js";
+
+const scope = { environmentId: "environment", threadId: "thread" };
+
+describe("explicit environment credential classification", () => {
+  it("preserves a newly synced base credential absent from an older command and permits exact command overrides", () => {
+    const baseShellEnv = {
+      TOKEN: "new-managed-secret",
+      BB_THREAD_ID: "managed-thread-id",
+      PATH: "/tools",
+    };
+    const baseContributedEnv = [
+      {
+        name: "TOKEN",
+        value: "new-managed-secret",
+        secret: true,
+        source: { core: "machine-environment" as const },
+        reason: "New global credential",
+      },
+      {
+        name: "BB_THREAD_ID",
+        value: "managed-thread-id",
+        secret: true,
+        source: { core: "machine-environment" as const },
+        reason: "Global row",
+      },
+    ];
+    const oldCommand = resolveThreadEnvironment({
+      ...scope,
+      baseShellEnv,
+      baseContributedEnv,
+      contributedEnv: [],
+    });
+    expect(oldCommand.envVars).toEqual({
+      TOKEN: "new-managed-secret",
+      BB_THREAD_ID: "thread",
+      BB_ENVIRONMENT_ID: "environment",
+      PATH: "/tools",
+    });
+    expect(
+      oldCommand.entries.find((entry) => entry.name === "TOKEN"),
+    ).toMatchObject({
+      source: { core: "machine-environment" },
+      value: { masked: true },
+    });
+    expect(
+      oldCommand.entries.find((entry) => entry.name === "BB_THREAD_ID"),
+    ).toEqual({ name: "BB_THREAD_ID", source: "shell", value: "thread" });
+    const overridden = resolveThreadEnvironment({
+      ...scope,
+      baseShellEnv,
+      baseContributedEnv,
+      contributedEnv: [
+        {
+          name: "TOKEN",
+          value: "ordinary-replacement",
+          secret: false,
+          source: { core: "project-environment" },
+          reason: "Explicit command winner",
+        },
+      ],
+    });
+    expect(overridden.envVars.TOKEN).toBe("ordinary-replacement");
+    expect(
+      overridden.entries.filter((entry) => entry.name === "TOKEN"),
+    ).toEqual([
+      {
+        name: "TOKEN",
+        value: "ordinary-replacement",
+        source: { core: "project-environment" },
+        reason: "Explicit command winner",
+      },
+    ]);
+  });
+
+  it("refuses a managed classification borrowed from a different captured value", () => {
+    expect(() =>
+      resolveThreadEnvironment({
+        ...scope,
+        baseShellEnv: { TOKEN: "actual" },
+        baseContributedEnv: [
+          {
+            name: "TOKEN",
+            value: "different",
+            secret: true,
+            source: { core: "machine-environment" },
+            reason: "Mismatched snapshot",
+          },
+        ],
+        contributedEnv: [],
+      }),
+    ).toThrow(/does not match its captured value/);
+  });
+  it("preserves provider bytes while showing ordinary core and plugin diagnostics", () => {
+    const baseShellEnv = { PATH: "/tools", BB_SERVER_URL: "https://bb.test" };
+    const result = resolveThreadEnvironment({
+      ...scope,
+      baseContributedEnv: [],
+      baseShellEnv,
+      contributedEnv: [
+        {
+          name: "TOKEN",
+          value: "synthetic-authentication-secret",
+          secret: true,
+          source: { plugin: "custom" },
+          reason: "Credential producer",
+        },
+        {
+          name: "URL",
+          value: "https://home.test:8443/path",
+          secret: false,
+          source: { core: "machine-environment" },
+          reason: "Ordinary endpoint",
+        },
+        {
+          name: "FLAG",
+          value: "1",
+          secret: false,
+          source: { plugin: "custom" },
+          reason: "Ordinary flag",
+        },
+      ],
+    });
+    expect(result.envVars).toEqual({
+      ...baseShellEnv,
+      BB_THREAD_ID: "thread",
+      BB_ENVIRONMENT_ID: "environment",
+      TOKEN: "synthetic-authentication-secret",
+      URL: "https://home.test:8443/path",
+      FLAG: "1",
+    });
+    expect(result.entries.find((entry) => entry.name === "TOKEN")).toEqual({
+      name: "TOKEN",
+      value: { masked: true },
+      source: { plugin: "custom" },
+      reason: "Credential producer",
+    });
+    expect(result.entries.find((entry) => entry.name === "URL")?.value).toBe(
+      "https://home.test:8443/path",
+    );
+    expect(result.entries.find((entry) => entry.name === "FLAG")?.value).toBe(
+      "1",
+    );
+    expect(baseShellEnv).toEqual({
+      PATH: "/tools",
+      BB_SERVER_URL: "https://bb.test",
+    });
+  });
+
+  it.each([true, false])(
+    "keeps the final winning value and classification together: secret=%s",
+    (secret) => {
+      const result = resolveThreadEnvironment({
+        ...scope,
+        baseContributedEnv: [],
+        baseShellEnv: { SHARED: "shell" },
+        contributedEnv: [
+          {
+            name: "SHARED",
+            value: "superseded",
+            secret: !secret,
+            source: { core: "machine-environment" },
+            reason: "Superseded",
+          },
+          {
+            name: "SHARED",
+            value: "winner",
+            secret,
+            source: { plugin: "winner" },
+            reason: "Selected owner",
+          },
+        ],
+      });
+      expect(result.envVars.SHARED).toBe("winner");
+      expect(result.entries.filter((entry) => entry.name === "SHARED")).toEqual(
+        [
+          {
+            name: "SHARED",
+            value: secret ? { masked: true } : "winner",
+            source: { plugin: "winner" },
+            reason: "Selected owner",
+          },
+        ],
+      );
+    },
+  );
+
+  it("does not guess credentials from variable names or blanket-mask a source", () => {
+    const result = resolveThreadEnvironment({
+      ...scope,
+      baseContributedEnv: [],
+      baseShellEnv: {},
+      contributedEnv: [
+        {
+          name: "API_KEY",
+          value: "ordinary-fixture-name",
+          secret: false,
+          source: { core: "project-environment" },
+          reason: "Declared ordinary",
+        },
+        {
+          name: "INNOCENT_NAME",
+          value: "synthetic-secret",
+          secret: true,
+          source: { plugin: "custom" },
+          reason: "Declared credential",
+        },
+      ],
+    });
+    expect(
+      result.entries.find((entry) => entry.name === "API_KEY")?.value,
+    ).toBe("ordinary-fixture-name");
+    expect(
+      result.entries.find((entry) => entry.name === "INNOCENT_NAME")?.value,
+    ).toEqual({ masked: true });
+  });
+
+  it("refuses unclassified embedded-runtime contributions without changing the base environment", () => {
+    const baseShellEnv = { PATH: "/tools" };
+    expect(() =>
+      resolveThreadEnvironment({
+        ...scope,
+        baseContributedEnv: [],
+        baseShellEnv,
+        contributedEnv: [
+          {
+            name: "UNCLASSIFIED",
+            value: "synthetic-value",
+            source: { plugin: "custom" },
+            reason: "Missing classification",
+          } as never,
+        ],
+      }),
+    ).toThrow(/UNCLASSIFIED.*explicit secret classification/);
+    expect(baseShellEnv).toEqual({ PATH: "/tools" });
+  });
+});
