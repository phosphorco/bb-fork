diff --git a/packages/db/test/environment-classification-migration.test.ts b/packages/db/test/environment-classification-migration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a9474be8920ea81c1dd3489728ca840f35fef1a2
--- /dev/null
+++ b/packages/db/test/environment-classification-migration.test.ts
@@ -0,0 +1,176 @@
+import { createHash } from "node:crypto";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { describe, expect, it } from "vitest";
+import { createConnection, migrate, type DbConnection } from "../src/index.js";
+import { createMigratedConnection } from "../src/testing.js";
+
+function unclassifiedDatabase(): DbConnection {
+  const db = createMigratedConnection();
+  const column = db.$client
+    .prepare(
+      "SELECT name FROM pragma_table_info('environment_variables') WHERE name = 'secret'",
+    )
+    .get();
+  if (column !== undefined) {
+    db.$client.exec("ALTER TABLE environment_variables DROP COLUMN secret");
+    const migration = readFileSync(
+      new URL(
+        "../drizzle/0146_environment_secret_classification.sql",
+        import.meta.url,
+      ),
+    );
+    db.$client
+      .prepare("DELETE FROM __drizzle_migrations WHERE hash = ?")
+      .run(createHash("sha256").update(migration).digest("hex"));
+  }
+  return db;
+}
+
+describe("environment authentication classification migration", () => {
+  it.each([null, "project-one"])(
+    "refuses unclassified values before changing the original database, ledger or key (project %s)",
+    (projectId) => {
+      const directory = mkdtempSync(
+        join(tmpdir(), "bb-environment-classification-"),
+      );
+      const path = join(directory, "bb.db");
+      const keyPath = join(directory, "machine-environment-key");
+      const original = unclassifiedDatabase();
+      writeFileSync(path, original.$client.serialize());
+      original.$client.close();
+      writeFileSync(keyPath, "synthetic-key-preservation-witness", {
+        mode: 0o600,
+      });
+      const db = createConnection(path);
+      try {
+        if (projectId !== null)
+          db.$client
+            .prepare(
+              "INSERT INTO projects (id, name, created_at, updated_at) VALUES (?, 'Synthetic project', 1, 1)",
+            )
+            .run(projectId);
+        db.$client
+          .prepare(
+            "INSERT INTO environment_variables (project_id, name, ciphertext, encryption_version, note, updated_at) VALUES (?, 'EXAMPLE', 'synthetic-ciphertext', 2, 'Retain this diagnostic note', 1)",
+          )
+          .run(projectId);
+        db.$client.pragma("wal_checkpoint(TRUNCATE)");
+        const serialized = db.$client.serialize();
+        const file = readFileSync(path);
+        const key = readFileSync(keyPath);
+        const ledger = db.$client
+          .prepare("SELECT * FROM __drizzle_migrations ORDER BY id")
+          .all();
+        const schema = db.$client
+          .prepare("SELECT * FROM sqlite_master ORDER BY name")
+          .all();
+        const temporary = db.$client
+          .prepare("SELECT * FROM sqlite_temp_master ORDER BY name")
+          .all();
+        expect(() => migrate(db)).toThrow(
+          /Environment variables require explicit authentication-secret classification before this update/,
+        );
+        expect(db.$client.serialize()).toEqual(serialized);
+        expect(readFileSync(path)).toEqual(file);
+        expect(readFileSync(keyPath)).toEqual(key);
+        expect(
+          db.$client
+            .prepare("SELECT * FROM __drizzle_migrations ORDER BY id")
+            .all(),
+        ).toEqual(ledger);
+        expect(
+          db.$client.prepare("SELECT * FROM sqlite_master ORDER BY name").all(),
+        ).toEqual(schema);
+        expect(
+          db.$client
+            .prepare("SELECT * FROM sqlite_temp_master ORDER BY name")
+            .all(),
+        ).toEqual(temporary);
+      } finally {
+        db.$client.close();
+        rmSync(directory, { recursive: true, force: true });
+      }
+    },
+  );
+
+  it("upgrades an empty existing table to required classification without a default", () => {
+    const db = unclassifiedDatabase();
+    try {
+      migrate(db);
+      expect(
+        db.$client
+          .prepare(
+            "SELECT type, \"notnull\", dflt_value FROM pragma_table_info('environment_variables') WHERE name = 'secret'",
+          )
+          .get(),
+      ).toEqual({ type: "INTEGER", notnull: 1, dflt_value: null });
+      expect(() =>
+        db.$client.exec(
+          "INSERT INTO environment_variables (name, ciphertext, encryption_version, updated_at) VALUES ('MISSING', 'synthetic', 2, 1)",
+        ),
+      ).toThrow(/NOT NULL/);
+      expect(() => migrate(db)).not.toThrow();
+    } finally {
+      db.$client.close();
+    }
+  });
+
+  it("preserves explicitly classified ordinary and credential values through restart", () => {
+    const db = createMigratedConnection();
+    try {
+      db.$client.exec(
+        "INSERT INTO environment_variables (name, ciphertext, encryption_version, secret, note, updated_at) VALUES ('ORDINARY', 'synthetic-ordinary', 2, 0, 'Keep visible', 1), ('CREDENTIAL', 'synthetic-credential', 2, 1, 'Hide only its value', 2)",
+      );
+      const before = db.$client.serialize();
+      const reopened = createConnection(before);
+      try {
+        const rows = reopened.$client
+          .prepare("SELECT * FROM environment_variables ORDER BY name")
+          .all();
+        migrate(reopened);
+        expect(
+          reopened.$client
+            .prepare("SELECT * FROM environment_variables ORDER BY name")
+            .all(),
+        ).toEqual(rows);
+      } finally {
+        reopened.$client.close();
+      }
+    } finally {
+      db.$client.close();
+    }
+  });
+
+  it.each(["nullable", "defaulted", "invalid flag"])(
+    "rejects %s classification without mutating populated data",
+    (kind) => {
+      const db = createMigratedConnection();
+      try {
+        if (kind !== "invalid flag") {
+          db.$client.exec(
+            "ALTER TABLE environment_variables DROP COLUMN secret",
+          );
+          db.$client.exec(
+            kind === "nullable"
+              ? "ALTER TABLE environment_variables ADD COLUMN secret integer"
+              : "ALTER TABLE environment_variables ADD COLUMN secret integer NOT NULL DEFAULT 0",
+          );
+        }
+        db.$client
+          .prepare(
+            "INSERT INTO environment_variables (name, ciphertext, encryption_version, secret, updated_at) VALUES ('EXAMPLE', 'synthetic', 2, ?, 1)",
+          )
+          .run(kind === "invalid flag" ? 2 : kind === "nullable" ? null : 0);
+        const before = db.$client.serialize();
+        expect(() => migrate(db)).toThrow(
+          /Environment variables require explicit authentication-secret classification before this update/,
+        );
+        expect(db.$client.serialize()).toEqual(before);
+      } finally {
+        db.$client.close();
+      }
+    },
+  );
+});
diff --git a/packages/domain/test/environment-credential-projection.test.ts b/packages/domain/test/environment-credential-projection.test.ts
