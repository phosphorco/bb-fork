 const PRODUCER_MESSAGE_RENDERING_HEADER = "x-bb-p6r-message-rendering";
 const PRODUCER_MESSAGE_RENDERING_VALUE = "producer";
+export const P6R_OWNED_TAILNET_INGRESS_HEADER = "x-bb-owned-tailnet-ingress";
 
 interface NativeContextState {
   readonly resolve: () => Promise<P6rMessageAuthor>;
@@ -54,10 +55,11 @@ function isProducerMessageRequest(context: Context): boolean {
 
 function installNativeContextResolver(admission: P6rProviderAdmission) {
   return async (context: Context, next: Next): Promise<void> => {
-    nativeContexts.set(context, {
+    const state: NativeContextState = {
       producerMessageRendering: isProducerMessageRequest(context),
       resolve: () => admission.resolveNativeAuthor(context),
-    });
+    };
+    nativeContexts.set(context, state);
     try {
       await next();
     } finally {
@@ -66,14 +68,35 @@ function installNativeContextResolver(admission: P6rProviderAdmission) {
   };
 }
 
+function requireNativeIdentity(admission: P6rProviderAdmission) {
+  return async (context: Context, next: Next): Promise<void> => {
+    if (/^\/(?:api\/v1\/)?plugins\/[^/]+\/(?:http|rpc)(?:\/|$)/u.test(context.req.path)) {
+      await next();
+      return;
+    }
+    if (
+      admission.nativeIdentityRequired() &&
+      context.req.header(P6R_OWNED_TAILNET_INGRESS_HEADER) === "1"
+    ) {
+      const author = await admission.resolveNativeAuthor(context);
+      if (author.evidence !== "provider-verified") {
+        throw new ApiError(401, "unauthorized", "Identity admission is required");
+      }
+      const state = nativeContexts.get(context);
+      if (state !== undefined) state.authorship = { author };
+    }
+    await next();
+  };
+}
+
 export function installP6rNativeRequestRoutes(
   app: Hono,
   admission: P6rProviderAdmission,
   providerId: string | null,
 ): void {
   const attach = installNativeContextResolver(admission);
-  app.use("/threads", attach);
-  app.use("/threads/*", attach);
+  app.use("*", attach);
+  app.use("*", requireNativeIdentity(admission));
 
   const { get } = typedRoutes<PublicApiSchema>(app, {
     onValidationError: (message) =>
@@ -83,7 +106,9 @@ export function installP6rNativeRequestRoutes(
     context.header("Cache-Control", "no-store");
     const result: P6rIdentityResponse = {
       status: "ready",
-      actor: await admission.resolveNativeAuthor(context),
+      actor:
+        nativeContexts.get(context)?.authorship?.author ??
+        (await admission.resolveNativeAuthor(context)),
       providerId: providerId ?? "",
     };
     return context.json(result);
