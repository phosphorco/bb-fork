index 0000000000000000000000000000000000000000..ff3e9b3240333efe787c4b5009d40400ceb211eb
--- /dev/null
+++ b/apps/server/test/services/plugins/plugin-p6r-admission-boundary.test.ts
@@ -0,0 +1,288 @@
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Hono } from "hono";
+import { afterEach, describe, expect, it } from "vitest";
+import type { StandardSchemaV1 } from "@get-bb/plugin-sdk";
+import { createConnection, migrate } from "@bb/db";
+import { createAiServiceRegistry } from "../../../src/services/ai/ai-service-registry.js";
+import {
+  createP6rIdentityService,
+  type P6rServerSession,
+} from "../../../src/services/p6r/identity-protocol.js";
+import { createP6rInvocationRegistry } from "../../../src/services/p6r/invocation-registry.js";
+import { createP6rProviderRegistry } from "../../../src/services/p6r/provider-registry.js";
+import type {
+  PluginHttpRouteRecord,
+  PluginRpcHandler,
+} from "../../../src/services/plugins/plugin-api.js";
+import type { P6rPluginDispatch } from "../../../src/services/plugins/plugin-p6r-dispatch.js";
+import {
+  createPluginService,
+  type PluginService,
+} from "../../../src/services/plugins/plugin-service.js";
+import { createNoopTelemetryService } from "../../../src/services/system/telemetry.js";
+import { testLogger } from "../../helpers/test-app.js";
+
+const schema: StandardSchemaV1 = {
+  "~standard": {
+    validate: (value) => ({ value }),
+    vendor: "test",
+    version: 1,
+  },
+};
+
+function readySession(): P6rServerSession {
+  return {
+    actor: {
+      evidence: "provider-verified",
+      identity: {
+        issuer: "issuer",
+        key: "person-key",
+        kind: "person",
+        subject: "subject",
+      },
+      presentation: { avatarUrl: null, displayName: "Person", handle: "person" },
+    },
+    capabilities: {
+      acceptance: "transactional-check",
+      directory: { lookup: false, search: false },
+      externalSend: "structured",
+      forwarding: "host-bound",
+      operationLookup: true,
+      participants: false,
+      requestIdentity: "host-resolved",
+      toolProvenance: "unknown",
+    },
+    instanceId: "identity-boundary",
+    mode: "multi-user",
+    stamp: "session-stamp",
+    status: "ready",
+  };
+}
+
+function createTestDispatch(): P6rPluginDispatch {
+  return {
+    activateBindings() {},
+    bindInvocation() {
+      throw new Error("test dispatch does not bind handlers");
+    },
+    bindingFor() {
+      return undefined;
+    },
+    retireBindings() {},
+    runWithInvocation(_handler, _context, run) {
+      return run();
+    },
+  };
+}
+
+function deniedSession(
+  status: "unauthenticated" | "unavailable",
+): P6rServerSession {
+  return {
+    error: {
+      code: status,
+      message:
+        status === "unauthenticated"
+          ? "Identity admission is required"
+          : "Identity provider is unavailable",
+      retry: status === "unauthenticated" ? "never" : "after-reconnect",
+    },
+    instanceId: "identity-boundary",
+    status,
+  };
+}
+
+describe("plugin P6R admission boundary", () => {
+  let service: PluginService | null = null;
+  let workDir: string | null = null;
+
+  afterEach(async () => {
+    await service?.stop();
+    if (workDir !== null) await rm(workDir, { force: true, recursive: true });
+    service = null;
+    workDir = null;
+  });
+
+  async function setup(session: P6rServerSession) {
+    const db = createConnection(":memory:");
+    migrate(db);
+    const dispatch = createTestDispatch();
+    const identity = createP6rIdentityService({
+      activateBindings: (generation) => dispatch.activateBindings(generation),
+      bindInvocation: (input) => dispatch.bindInvocation(input),
+      db,
+      instanceId: "identity-boundary",
+      invocationRegistry: createP6rInvocationRegistry({ now: () => 100 }),
+      native: {},
+      now: () => 100,
+      providerConfiguration: () => null,
+      providerRegistry: createP6rProviderRegistry({ now: () => 100 }),
+      requiresInvocationAdmission: () => true,
+      retireBindings: (generation) => dispatch.retireBindings(generation),
+      trustedInvocation: async () => ({
+        deadlineAt: 200,
+        session,
+        sessionEpoch: "session-epoch",
+      }),
+    });
+    const extension = identity.forPluginGeneration(
+      "fixture",
+      "fixture-generation",
+      new AbortController().signal,
+    );
+    extension.activate();
+    workDir = await mkdtemp(join(tmpdir(), "bb-plugin-p6r-admission-"));
+    service = createPluginService({
+      aiServices: createAiServiceRegistry(),
+      appVersion: "0.0.0-test",
+      dataDir: join(workDir, "data"),
+      db,
+      hub: {
+        getDaemonSessionIdForHost: () => null,
+        notifyPluginSignal: () => 0,
+        notifySystem: () => {},
+      },
+      logger: testLogger,
+      p6rDispatch: dispatch,
+      p6rIdentity: identity,
+      telemetry: createNoopTelemetryService(),
+    });
+    return { dispatch, identity, service };
+  }
+
+  it("returns auth-specific HTTP/RPC failures without calling an unadmitted handler", async () => {
+    const { dispatch, service: boundaryService } = await setup(
+      deniedSession("unauthenticated"),
+    );
+    let calls = 0;
+    const httpRoute: PluginHttpRouteRecord = {
+      auth: "none",
+      handler: (context) => {
+        calls += 1;
+        return context.json({ ok: true });
+      },
+      method: "GET",
+      path: "/identity",
+    };
+    const rpcHandler: PluginRpcHandler = {
+      handler: () => {
+        calls += 1;
+        return { ok: true };
+      },
+      inputSchema: schema,
+      outputSchema: schema,
+    };
+    const binding = {
+      generation: "fixture-generation",
+      pluginId: "fixture",
+      routeClass: "interactive-session" as const,
+    };
+    const bindingFor = dispatch.bindingFor.bind(dispatch);
+    dispatch.bindingFor = (handler) =>
+      handler === httpRoute.handler || handler === rpcHandler.handler
+        ? binding
+        : bindingFor(handler);
+
+    const app = new Hono();
+    app.get("/identity", (context) =>
+      boundaryService.invokeHttpRoute("fixture", httpRoute, context),
+    );
+    const response = await app.request("http://example.test/identity");
+    expect(response.status).toBe(401);
+    expect(await response.json()).toEqual({
+      ok: false,
+      error: {
+        code: "unauthenticated",
+        message: "Identity admission is required",
+      },
+    });
+    await expect(
+      boundaryService.invokeRpcHandler("fixture", "identity", rpcHandler, {}, {
+        ingress: { requestId: "request", transport: "http" },
+        request: {},
+      }),
+    ).resolves.toEqual({
+      ok: false,
+      error: {
+        code: "unauthenticated",
+        message: "Identity admission is required",
+      },
+    });
+    expect(calls).toBe(0);
+  });
+
+  it("returns unavailable for a configured provider outage and dispatches an admitted session", async () => {
+    const unavailable = await setup(deniedSession("unavailable"));
+    let unavailableCalls = 0;
+    const unavailableRoute: PluginHttpRouteRecord = {
+      auth: "none",
+      handler: (context) => {
+        unavailableCalls += 1;
+        return context.json({ ok: true });
+      },
+      method: "GET",
+      path: "/identity",
+    };
+    const unavailableBindingFor = unavailable.dispatch.bindingFor.bind(
+      unavailable.dispatch,
+    );
+    unavailable.dispatch.bindingFor = (handler) =>
+      handler === unavailableRoute.handler
+        ? {
+            generation: "fixture-generation",
+            pluginId: "fixture",
+            routeClass: "interactive-session",
+          }
+        : unavailableBindingFor(handler);
+    const unavailableApp = new Hono();
+    unavailableApp.get("/identity", (context) =>
+      unavailable.service.invokeHttpRoute("fixture", unavailableRoute, context),
+    );
+    const unavailableResponse = await unavailableApp.request(
+      "http://example.test/identity",
+    );
+    expect(unavailableResponse.status).toBe(503);
+    expect(await unavailableResponse.json()).toMatchObject({
+      ok: false,
+      error: { code: "unavailable" },
+    });
+    expect(unavailableCalls).toBe(0);
+    await unavailable.service.stop();
+    await rm(workDir!, { force: true, recursive: true });
+    service = null;
+    workDir = null;
+
+    const admitted = await setup(readySession());
+    let admittedCalls = 0;
+    const admittedRoute: PluginHttpRouteRecord = {
