+const bobKey = "p6r:identity-boundaries%2Ftailnet/bob";
+
+function actor(args: {
+  displayName: string;
+  key: string;
+  kind: "external" | "person";
+}) {
+  return {
+    evidence: "provider-verified",
+    identity: args.kind === "person"
