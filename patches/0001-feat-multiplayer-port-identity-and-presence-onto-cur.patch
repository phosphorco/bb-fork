+export const p6rPresenceSnapshotResponseSchema = z
+  .object({
+    p6rThreads: z.record(
+      z.string(),
+      z.array(p6rPresenceViewerSchema).readonly(),
+    ),
+  })
+  .strict();
+
+export type P6rPresenceSnapshotResponse = z.infer<
+  typeof p6rPresenceSnapshotResponseSchema
+>;
