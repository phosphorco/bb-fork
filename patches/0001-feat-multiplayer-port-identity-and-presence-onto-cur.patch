diff --git a/apps/app/src/components/thread/presence/Presence.stories.tsx b/apps/app/src/components/thread/presence/Presence.stories.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5df4f745bb820e1b27de2d5d087096385fd8e223
