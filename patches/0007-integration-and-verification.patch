+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#listCoreParticipantProfilesByThreadIds",
+      run: (db, _f, s) =>
+        facets.listCoreParticipantProfilesByThreadIds(db, s.ids),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#listCoreParticipantSummariesByThreadIds",
