+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#getOrCreateThreadFacetCursorSigningKey",
+      run: (db) => facets.getOrCreateThreadFacetCursorSigningKey(db),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#activatePluginThreadFacetDeclarations",
+      run: (db, _f, s) =>
+        facets.activatePluginThreadFacetDeclarations(db, {
+          ownerPluginId: "cost-fixture",
+          declarations: [s.declaration],
+        }),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#replaceThreadFacetRelationsInGeneration",
+      run: (db, _f, s) =>
+        facets.replaceThreadFacetRelationsInGeneration(db, {
+          ...s.current,
+          threadId: s.ids[0]!,
+          members: ["selected"],
+        }),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#listPriorThreadFacetSnapshotTargets",
+      run: (db, _f, s) =>
+        facets.listPriorThreadFacetSnapshotTargets(db, {
+          ...s.current,
+          limit: 50,
+        }),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#recordThreadFacetCensusExhausted",
+      run: (db, _f, s) =>
+        facets.recordThreadFacetCensusExhausted(db, s.current),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#markThreadFacetOwnerGenerationReady",
+      run: (db, _f, s) =>
+        facets.markThreadFacetOwnerGenerationReady(db, s.ready),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#markThreadFacetOwnerGenerationUnavailable",
+      run: (db, _f, s) =>
+        facets.markThreadFacetOwnerGenerationUnavailable(db, s.ready),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#listThreadFacetOwnerProjections",
+      run: (db, _f, s) =>
+        facets.listThreadFacetOwnerProjections(db, [s.current.typeId]),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#replaceCoreParticipantProfilesInTransaction",
+      run: (db, _f, s) =>
+        db.transaction((tx) =>
+          facets.replaceCoreParticipantProfilesInTransaction(tx, {
+            threadId: s.ids[0]!,
