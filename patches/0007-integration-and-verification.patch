+            sourceVersion: 2,
+          }),
+        ),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#replaceCoreParticipantProfiles",
+      run: (db, _f, s) =>
+        facets.replaceCoreParticipantProfiles(db, {
+          threadId: s.ids[0]!,
+          profiles: s.profiles,
+          sourceVersion: 2,
+        }),
+    },
+    {
+      name: "packages/db/src/data/thread-facets.ts#replaceCoreParticipantProfilesBatch",
