@@ -0,0 +1,361 @@
+import { NotificationHub } from "../../../src/ws/hub.js";
+import { createMigratedConnection } from "@bb/db/testing";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Hono } from "hono";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { StandardSchemaV1 } from "@get-bb/plugin-sdk";
+import { createAiServiceRegistry } from "../../../src/services/ai/ai-service-registry.js";
+import {
+  createP6rIdentityService,
+  type P6rServerSession,
+} from "../../../src/services/p6r/identity-protocol.js";
+import { createP6rInvocationRegistry } from "../../../src/services/p6r/invocation-registry.js";
+import { createP6rProviderRegistry } from "../../../src/services/p6r/provider-registry.js";
+import type {
+  PluginHttpRouteRecord,
+  PluginRpcHandler,
+} from "../../../src/services/plugins/plugin-api.js";
+import type { P6rPluginDispatch } from "../../../src/services/plugins/plugin-p6r-dispatch.js";
+import {
+  createPluginService,
+  type PluginService,
+} from "../../../src/services/plugins/plugin-service.js";
+import { createNoopTelemetryService } from "../../../src/services/system/telemetry.js";
+import { testLogger } from "../../helpers/test-app.js";
+
+const schema: StandardSchemaV1 = {
+  "~standard": {
+    validate: (value) => ({ value }),
+    vendor: "test",
+    version: 1,
+  },
+};
+
+function readySession(): P6rServerSession {
+  return {
+    actor: {
+      evidence: "provider-verified",
+      identity: {
+        issuer: "issuer",
+        key: "person-key",
+        kind: "person",
+        subject: "subject",
+      },
+      presentation: {
+        avatarUrl: null,
+        displayName: "Person",
+        handle: "person",
+      },
+    },
+    capabilities: {
+      acceptance: "transactional-check",
+      directory: { lookup: false, search: false },
+      externalSend: "structured",
+      forwarding: "host-bound",
+      operationLookup: true,
+      participants: false,
+      requestIdentity: "host-resolved",
+      toolProvenance: "unknown",
+    },
+    instanceId: "identity-boundary",
+    mode: "multi-user",
+    stamp: "session-stamp",
+    status: "ready",
+  };
+}
+
+function createTestDispatch(): P6rPluginDispatch {
+  return {
+    activateBindings() {},
+    bindInvocation() {
+      throw new Error("test dispatch does not bind handlers");
+    },
+    bindingFor() {
+      return undefined;
+    },
+    retireBindings() {},
+    runWithInvocation(_handler, _context, run) {
+      return run();
+    },
+  };
+}
+
+function deniedSession(
+  status: "unauthenticated" | "unavailable",
+): P6rServerSession {
+  return {
+    error: {
+      code: status,
+      message:
+        status === "unauthenticated"
+          ? "Identity admission is required"
+          : "Identity provider is unavailable",
+      retry: status === "unauthenticated" ? "never" : "after-reconnect",
+    },
+    instanceId: "identity-boundary",
+    status,
+  };
+}
+
+describe("plugin P6R admission boundary", () => {
+  let service: PluginService | null = null;
+  let workDir: string | null = null;
+
+  afterEach(async () => {
+    vi.unstubAllGlobals();
+    await service?.stop();
+    if (workDir !== null) await rm(workDir, { force: true, recursive: true });
+    service = null;
+    workDir = null;
+  });
+
+  async function setup(session: P6rServerSession) {
+    const db = createMigratedConnection();
+
+    const dispatch = createTestDispatch();
+    const identity = createP6rIdentityService({
+      activateBindings: (generation) => dispatch.activateBindings(generation),
+      bindInvocation: (input) => dispatch.bindInvocation(input),
+      db,
+      instanceId: "identity-boundary",
+      invocationRegistry: createP6rInvocationRegistry(),
+      native: {},
+      now: () => 100,
+      providerConfiguration: () => null,
+      providerRegistry: createP6rProviderRegistry({ now: () => 100 }),
+      retireBindings: (generation) => dispatch.retireBindings(generation),
+      trustedInvocation: async () => ({
+        deadlineAt: 200,
+        session,
+        sessionEpoch: "session-epoch",
+      }),
+    });
+    const extension = identity.forPluginGeneration(
+      "fixture",
+      "fixture-generation",
+      new AbortController().signal,
+    );
+    extension.activate();
+    workDir = await mkdtemp(join(tmpdir(), "bb-plugin-p6r-admission-"));
+    service = createPluginService({
+      aiServices: createAiServiceRegistry(),
+      appVersion: "0.0.0-test",
+      dataDir: join(workDir, "data"),
+      db,
+      hub: new NotificationHub(),
+      logger: testLogger,
+      p6rDispatch: dispatch,
+      p6rIdentity: identity,
+      telemetry: createNoopTelemetryService(),
+    });
+    await writeFile(
+      join(workDir, "package.json"),
+      JSON.stringify({
+        name: "bb-plugin-fixture",
+        version: "0.1.0",
+        bb: {
+          name: "Fixture",
+          description: "Lifetime-bound identity fixture",
+          branding: { icon: "Zap" },
+          server: "./server.ts",
+        },
+      }),
+    );
+    await writeFile(
+      join(workDir, "server.ts"),
+      'export default bb => { bb.http.route("GET", "/owner", c => c.text("ok"), { auth: "none" }); };',
+    );
+    const installed = await service.installPath(workDir);
+    if (installed.status !== "running")
+      throw new Error(JSON.stringify(installed));
+    const selected = service.getHttpRoute("fixture", "GET", "/owner");
+    if (selected.outcome !== "found")
+      throw new Error("Fixture plugin did not load");
+    return { dispatch, identity, service, owner: selected.owner };
+  }
+
+  it("uses one caller-authenticated transport with producer rendering scoped to sends", async () => {
+    const { service: boundaryService } = await setup(readySession());
+    const requests: Request[] = [];
+    vi.stubGlobal(
+      "fetch",
+      async (input: RequestInfo | URL, init?: RequestInit) => {
+        requests.push(new Request(input, init));
+        return Response.json(
+          { error: "synthetic transport witness" },
+          { status: 503 },
+        );
+      },
+    );
+    boundaryService.bindSdk({ baseUrl: "http://plugin-sdk.test" });
+    const api = boundaryService.getApi("fixture");
+    if (!api) throw new Error("Fixture plugin did not load");
+    const producer =
+      api.experimental_p6rIdentity?.experimental_useProducerMessageRendering;
+    if (!producer) throw new Error("Fixture producer policy is unavailable");
+    producer();
+    await expect(
+      api.sdk.threads.send({
+        threadId: "thr_fixture",
+        mode: "start",
+        input: [{ type: "text", text: "producer-owned input", mentions: [] }],
+      }),
+    ).rejects.toThrow();
+    await expect(
+      api.sdk.threads.get({ threadId: "thr_fixture" }),
+    ).rejects.toThrow();
+    expect(requests).toHaveLength(2);
+    expect(
+      requests.map((request) =>
+        request.headers.get("x-bb-p6r-message-rendering"),
+      ),
+    ).toEqual(["producer", null]);
+    for (const request of requests) {
+      const token = request.headers.get("x-bb-plugin-caller");
+      expect(token).not.toBeNull();
+      expect(boundaryService.resolveRpcCaller(token ?? undefined)).toEqual({
+        ok: true,
+        caller: { kind: "plugin", pluginId: "fixture" },
+      });
+    }
+  });
+
+  it("dispatches HTTP/RPC handlers when person verification is missing", async () => {
+    const {
+      dispatch,
+      service: boundaryService,
+      owner,
