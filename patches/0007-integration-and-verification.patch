+// Grow unrelated threads and persisted facet/profile rows, keeping each request
+// bounded to the same 50 IDs. Full-history readers use the history fixture.
+export const PHOSPHOR_COST_GROUP = registerCostGroup({
+  name: "phosphor",
+  seed: (db, fixture, scale) => {
+    const template = db
+      .select()
+      .from(threads)
+      .where(eq(threads.id, fixture.threadId))
+      .get()!;
+    const ids: string[] = [];
+    const profiles = [
+      {
+        p6rPrincipalKey: "person:cost",
+        identityKind: "person" as const,
+        p6rDisplayName: "Cost fixture",
+        imageUrl: null,
+      },
+    ];
+    const declaration = {
+      assignmentScope: "shared-thread" as const,
+      cardinality: "many" as const,
+      localName: "cost",
+      memberKind: "enum" as const,
+      members: ["selected"],
+    };
+    const [activated] = facets.activatePluginThreadFacetDeclarations(db, {
+      ownerPluginId: "cost-fixture",
+      declarations: [declaration],
+    });
+    const generation = {
+      typeId: activated!.declaration.typeId,
+      generation: activated!.generation,
+    };
+    db.transaction(() => {
+      for (let i = 0; i < scaled(4000, scale); i++) {
+        const id = `phosphor-cost-${i}`;
+        db.insert(threads)
+          .values({ ...template, id })
+          .run();
+        facets.replaceCoreParticipantProfilesInTransaction(db, {
+          threadId: id,
+          profiles,
+          sourceVersion: 1,
+        });
+        facets.replaceThreadFacetRelationsInGeneration(db, {
+          ...generation,
+          threadId: id,
+          members: ["selected"],
+        });
+        if (ids.length < 50) ids.push(id);
+      }
+    });
+    // A second activation creates a realistic reconciliation target population.
+    const [next] = facets.activatePluginThreadFacetDeclarations(db, {
+      ownerPluginId: "cost-fixture",
+      declarations: [declaration],
+    });
+    const current = {
+      typeId: next!.declaration.typeId,
+      generation: next!.generation,
+    };
+    const [empty] = facets.activatePluginThreadFacetDeclarations(db, {
+      ownerPluginId: "cost-ready",
+      declarations: [declaration],
+    });
+    const ready = {
+      typeId: empty!.declaration.typeId,
+      generation: empty!.generation,
+    };
+    facets.recordThreadFacetCensusExhausted(db, ready);
+    return { ids, profiles, declaration, current, ready };
+  },
+  cases: [
