diff --git a/apps/server/test/providers/required-external-model-catalog.test.ts b/apps/server/test/providers/required-external-model-catalog.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e278fce6758b2f1005f835c6365b75cb08894266
--- /dev/null
+++ b/apps/server/test/providers/required-external-model-catalog.test.ts
@@ -0,0 +1,65 @@
+import { expect, it, vi } from "vitest";
+import { readRequiredExternalModelCatalog } from "../../src/services/providers/required-external-model-catalog.js";
+const env = {
+  BB_ACCOUNT_POOL_EXTERNAL_REQUIRED: "1",
+  BB_ACCOUNT_POOL_EXTERNAL_URL: "https://inference.example.ts.net",
+  BB_ACCOUNT_POOL_EXTERNAL_TOKEN: "synthetic-key",
+};
+it("uses the server-held route and returns only each provider's catalogue facts", async () => {
+  const request = vi.fn(async (url, init) => {
+    expect(url).toBe("https://inference.example.ts.net/v1/models");
+    expect(new Headers(init?.headers).get("authorization")).toBe(
+      "Bearer synthetic-key",
+    );
+    expect(init?.redirect).toBe("error");
+    return Response.json({
+      data: [
+        { id: "claude-sonnet-4-5" },
+        { id: "gpt-5.3-codex" },
+        { id: "gpt-4o-audio" },
+        { id: "gpt-5.3-codex" },
+      ],
+    });
+  });
+  expect(
+    (
+      await readRequiredExternalModelCatalog("claude-code", env, request)
+    ).models.map((model) => model.id),
+  ).toEqual(["claude-sonnet-4-5"]);
+  const codex = await readRequiredExternalModelCatalog("codex", env, request);
+  expect(codex.models.map((model) => model.id)).toEqual(["gpt-5.3-codex"]);
+  expect(JSON.stringify(codex)).not.toContain("synthetic-key");
+});
+it("never makes a request when the required route is missing or invalid", async () => {
+  const request = vi.fn();
+  for (const config of [
+    {},
+    { ...env, BB_ACCOUNT_POOL_EXTERNAL_URL: "https://provider.example" },
+    { ...env, BB_ACCOUNT_POOL_EXTERNAL_TOKEN: "" },
+  ]) {
+    await expect(
+      readRequiredExternalModelCatalog("codex", config, request),
+    ).rejects.toThrow(/unavailable/);
+  }
+  expect(request).not.toHaveBeenCalled();
+});
+it("returns unavailable on Mac/router failure and invalid model facts, without fallback", async () => {
+  for (const response of [
+    new Response(null, { status: 503 }),
+    Response.json({ data: [] }),
+    Response.json({ data: [{ model: "gpt-5.3-codex" }] }),
+  ]) {
+    const request = vi.fn(async () => response);
+    await expect(
+      readRequiredExternalModelCatalog("codex", env, request),
+    ).rejects.toThrow(/unavailable/);
+    expect(request).toHaveBeenCalledTimes(1);
+  }
+  const request = vi.fn(async () => {
+    throw new Error("offline synthetic-key");
+  });
+  await expect(
+    readRequiredExternalModelCatalog("codex", env, request),
+  ).rejects.toThrow("Required BB external model catalogue is unavailable.");
+  expect(request).toHaveBeenCalledTimes(1);
+});
