+set -eu
+client_id=$1
+tags=$2
+hostname=$3
+test -n "\${MODAL_IDENTITY_TOKEN:-}" || { echo "Modal did not provide an OIDC identity token" >&2; exit 1; }
+if ! tailscale --socket=${TAILSCALE_SOCKET} status >/dev/null 2>&1; then
+  if [ -f /tmp/bb-tailscaled.pid ]; then
+    old_pid=$(sed -n '1p' /tmp/bb-tailscaled.pid)
+    case "$old_pid" in *[!0-9]*|'') old_pid= ;; esac
+    if [ -n "$old_pid" ] && [ "$(cat /proc/$old_pid/comm 2>/dev/null || true)" = tailscaled ]; then kill "$old_pid"; fi
+  fi
+  rm -f ${TAILSCALE_SOCKET}
+  nohup tailscaled --state=mem: --socket=${TAILSCALE_SOCKET} --tun=userspace-networking --socks5-server=127.0.0.1:1055 --outbound-http-proxy-listen=127.0.0.1:1055 >/tmp/bb-tailscaled.log 2>&1 &
+  printf '%s\n' "$!" >/tmp/bb-tailscaled.pid
+  attempt=0
+  while [ ! -S ${TAILSCALE_SOCKET} ]; do
+    attempt=$((attempt + 1))
+    if [ "$attempt" -ge 100 ]; then
+      tail -n 20 /tmp/bb-tailscaled.log >&2 || true
+      exit 1
+    fi
+    sleep 0.1
+  done
+fi
+tailscale --socket=${TAILSCALE_SOCKET} up --client-id="$client_id?ephemeral=true&preauthorized=true" --id-token="$MODAL_IDENTITY_TOKEN" --advertise-tags="$tags" --hostname="$hostname" --accept-dns=true
+printf '%s\n' dynamic_chain proxy_dns 'remote_dns_subnet 224' 'tcp_read_time_out 15000' 'tcp_connect_time_out 8000' 'localnet 127.0.0.0/255.0.0.0' '[ProxyList]' 'socks5 127.0.0.1 1055' >${PROXYCHAINS_CONFIG}
+tailscale --socket=${TAILSCALE_SOCKET} ip -4
+`;
+
+function hostnameFor(key: string): string {
+  const suffix = key
+    .toLowerCase()
+    .replace(/[^a-z0-9-]/gu, "-")
+    .slice(-40);
+  return `bb-modal-${suffix}`.slice(0, 63);
+}
+
+export async function connectModalTailnet(request: {
+  sandbox: ModalSandboxHandle;
+  settings: TailnetSettings;
+  key: string;
+  signal: AbortSignal;
+  report: PluginMachineProviderProgress;
+}): Promise<void> {
+  request.report.step("Connecting the Modal sandbox to Tailscale…");
+  const result = await request.sandbox.exec(
+    [
+      "sh",
+      "-c",
+      connectScript,
+      "bb-modal-tailnet",
+      request.settings.clientId,
+      request.settings.tags,
+      hostnameFor(request.key),
+    ],
+    {
+      timeoutMs: TAILNET_CONNECT_TIMEOUT_MS,
+      signal: request.signal,
+      maxOutputBytes: 32_768,
+      onOutput: (chunk) => request.report.log(chunk),
+    },
+  );
+  if (result.exitCode !== 0) {
+    throw new Error(
+      result.stderr.trim() || "The Modal sandbox could not join Tailscale.",
+    );
+  }
+}
+
+export function wrapTailnetCommand(command: readonly string[]): string[] {
+  return [
+    "env",
+    `PROXYCHAINS_CONF_FILE=${PROXYCHAINS_CONFIG}`,
+    "ALL_PROXY=socks5h://127.0.0.1:1055",
+    "HTTP_PROXY=http://127.0.0.1:1055",
+    "HTTPS_PROXY=http://127.0.0.1:1055",
+    "NO_PROXY=127.0.0.1,localhost",
+    "all_proxy=socks5h://127.0.0.1:1055",
+    "http_proxy=http://127.0.0.1:1055",
+    "https_proxy=http://127.0.0.1:1055",
+    "no_proxy=127.0.0.1,localhost",
+    "proxychains4",
+    "-q",
+    ...command,
+  ];
+}
