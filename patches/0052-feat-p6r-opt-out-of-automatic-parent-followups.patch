diff --git a/apps/server/test/threads/p6r-parent-followups.test.ts b/apps/server/test/threads/p6r-parent-followups.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..add5c47a929e3e8a007f53cac662043b10efcda2
--- /dev/null
+++ b/apps/server/test/threads/p6r-parent-followups.test.ts
@@ -0,0 +1,269 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  createThread,
+  getThread,
+  getThreadPluginMetadata,
+  listEvents,
+  listQueuedThreadMessages,
+  P6R_PARENT_FOLLOWUP_POLICY_NAMESPACE,
+  threadPluginMetadata,
+  updateThread,
+} from "@bb/db";
+import { turnRequestEventDataSchema } from "@bb/domain";
+import { eq } from "drizzle-orm";
+import {
+  queueChildThreadNeedsAttentionNotificationBestEffort,
+  queueChildThreadTurnNotificationBestEffort,
+} from "../../src/services/threads/child-thread-notifications.js";
+import { suppressP6rAutomaticParentFollowup } from "../../src/services/threads/p6r-parent-followup-policy.js";
+import { queueParentSystemMessage } from "../../src/services/threads/parent-system-messages.js";
+import { handleThreadOwnershipChange } from "../../src/services/threads/thread-ownership.js";
+import { seedThreadFixture, seedThreadRuntimeState } from "../helpers/seed.js";
+import { withTestHarness, type TestAppHarness } from "../helpers/test-app.js";
+
+function fixture(harness: TestAppHarness, suppressed = true) {
+  const { thread: parent, project, environment } = seedThreadFixture(harness);
+  seedThreadRuntimeState(harness.deps, {
+    threadId: parent.id,
+    environmentId: environment.id,
+    providerThreadId: "parent-provider",
+  });
+  const child = createThread(harness.db, harness.deps.hub, {
+    projectId: project.id,
+    environmentId: environment.id,
+    providerId: "codex",
+    parentThreadId: parent.id,
+    noAutomaticParentFollowups: suppressed,
+    status: "idle",
+    visibility: "hidden",
+  });
+  return { parent, child, environment, project };
+}
+function notices(harness: TestAppHarness, id: string) {
+  return listEvents(harness.db, { threadId: id })
+    .filter((e) => e.type === "client/turn/requested")
+    .map((e) => turnRequestEventDataSchema.parse(JSON.parse(e.data)))
+    .filter((e) => e.initiator === "system");
+}
+afterEach(() => {
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+});
+
+describe("p6r automatic parent followup policy", () => {
+  it.each(["completed", "failed", "interrupted"] as const)(
+    "suppresses %s before batching and still permits explicit delivery",
+    async (turnStatus) => {
+      await withTestHarness(async (h) => {
+        const { parent, child } = fixture(h);
+        vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+        await queueChildThreadTurnNotificationBestEffort(h.deps, {
+          childThread: child,
+          parentThreadId: parent.id,
+          turnStatus,
+        });
+        await queueChildThreadNeedsAttentionNotificationBestEffort(h.deps, {
+          childThread: child,
+          parentThreadId: parent.id,
+          blockerSummary: "Approval needed",
+        });
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(notices(h, parent.id)).toEqual([]);
+        expect(listQueuedThreadMessages(h.db, parent.id)).toEqual([]);
+        expect(getThread(h.db, child.id)?.parentThreadId).toBe(parent.id);
+        await queueParentSystemMessage(h.deps, {
+          systemMessageKind: "tool-result-delivered",
+          systemMessageSubject: null,
+          parentThreadId: parent.id,
+          input: [
+            { type: "text", text: "Explicit tool delivery", mentions: [] },
+          ],
+        });
+        expect(notices(h, parent.id)).toHaveLength(1);
+      });
+    },
+  );
+
+  it("keeps an opted-out sibling out of a batch without delaying another child", async () => {
+    await withTestHarness(async (h) => {
+      const { parent, child, environment, project } = fixture(h);
+      const sibling = createThread(h.db, h.deps.hub, {
+        projectId: project.id,
+        environmentId: environment.id,
+        providerId: "codex",
+        parentThreadId: parent.id,
+        status: "idle",
+      });
+      vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+      await queueChildThreadTurnNotificationBestEffort(h.deps, {
+        childThread: sibling,
+        parentThreadId: parent.id,
+        turnStatus: "completed",
+      });
+      await vi.advanceTimersByTimeAsync(1000);
+      await queueChildThreadTurnNotificationBestEffort(h.deps, {
+        childThread: child,
+        parentThreadId: parent.id,
+        turnStatus: "failed",
+      });
+      await vi.advanceTimersByTimeAsync(1000);
+      const messages = notices(h, parent.id);
+      expect(messages).toHaveLength(1);
+      expect(JSON.stringify(messages[0]?.input)).toContain(sibling.id);
+      expect(JSON.stringify(messages[0]?.input)).not.toContain(child.id);
+    });
+  });
+
+  it.each([false, true])(
+    "retains ownership events while respecting the notice policy (%s)",
+    async (suppressed) => {
+      await withTestHarness(async (h) => {
+        const { child, parent, project, environment } = fixture(h, suppressed);
+        const next = createThread(h.db, h.deps.hub, {
+          projectId: project.id,
+          environmentId: environment.id,
+          providerId: "codex",
+          status: "idle",
+        });
+        seedThreadRuntimeState(h.deps, {
+          threadId: next.id,
+          environmentId: environment.id,
+          providerThreadId: "next-provider",
+        });
+        vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+        const moved = updateThread(h.db, h.deps.hub, child.id, {
+          parentThreadId: next.id,
+        })!;
+        const before = listEvents(h.db, { threadId: child.id }).length;
+        await handleThreadOwnershipChange(h.deps, {
+          previousThread: child,
+          updatedThread: moved,
+        });
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(getThread(h.db, child.id)?.parentThreadId).toBe(next.id);
+        expect(listEvents(h.db, { threadId: child.id }).length).toBeGreaterThan(
+          before,
+        );
+        expect(notices(h, parent.id)).toHaveLength(suppressed ? 0 : 1);
+        expect(notices(h, next.id)).toHaveLength(suppressed ? 0 : 1);
+        await queueChildThreadNeedsAttentionNotificationBestEffort(h.deps, {
+          childThread: moved,
+          parentThreadId: next.id,
+          blockerSummary: "Decision needed",
+        });
+        expect(
+          notices(h, next.id).length +
+            listQueuedThreadMessages(h.db, next.id).length,
+        ).toBe(suppressed ? 0 : 2);
+      });
+    },
+  );
+
+  it.each([
+    "{}",
+    '{"noAutomaticParentFollowups":false}',
+    '{"noAutomaticParentFollowups":"true"}',
+    '{"noAutomaticParentFollowups":1}',
+    "null",
+    "{broken",
+  ])(
+    "defaults to delivery for persisted policy %s without rewriting it",
+    async (metadataJson) => {
+      await withTestHarness(async (h) => {
+        const { parent, child } = fixture(h);
+        h.db
+          .update(threadPluginMetadata)
+          .set({ metadataJson })
+          .where(eq(threadPluginMetadata.threadId, child.id))
+          .run();
+        vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+        await queueChildThreadTurnNotificationBestEffort(h.deps, {
+          childThread: child,
+          parentThreadId: parent.id,
+          turnStatus: "failed",
+        });
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(notices(h, parent.id)).toHaveLength(1);
+        expect(
+          h.db
+            .select()
+            .from(threadPluginMetadata)
+            .where(eq(threadPluginMetadata.threadId, child.id))
+            .get()?.metadataJson,
+        ).toBe(metadataJson);
+      });
+    },
+  );
+
+  it("defaults to delivery and logs when the metadata query fails", async () => {
+    await withTestHarness(async (h) => {
+      const { child } = fixture(h);
+      const warn = vi.spyOn(h.deps.logger, "warn");
+      expect(() =>
+        h.db.transaction((tx) => {
+          tx.run("DROP TABLE thread_plugin_metadata");
+          expect(
+            suppressP6rAutomaticParentFollowup(h.deps, child.id, "outcome"),
+          ).toBe(false);
+          expect(warn).toHaveBeenCalled();
+          throw new Error("restore table");
+        }),
+      ).toThrow("restore table");
+      expect(
+        suppressP6rAutomaticParentFollowup(h.deps, child.id, "outcome"),
+      ).toBe(true);
+    });
+  });
+
+  it.each([undefined, false, true])(
+    "persists scheduled public creation policy (%s) without plugin attribution",
+    async (value) => {
+      await withTestHarness(async (h) => {
+        const { parent, environment, project } = fixture(h, false);
+        const response = await h.app.request("/api/v1/threads", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({
+            projectId: project.id,
+            providerId: "codex",
+            origin: "cli",
+            startedOnBehalfOf: null,
+            environment: { type: "reuse", environmentId: environment.id },
+            parentThreadId: parent.id,
+            input: [{ type: "text", text: "Scheduled child", mentions: [] }],
+            sendAt: Date.now() + 60000,
+            ...(value === undefined
+              ? {}
+              : { noAutomaticParentFollowups: value }),
+          }),
+        });
+        expect(response.status).toBe(201);
+        const body = await response.json();
+        const thread = getThread(h.db, body.id)!;
+        expect(thread.parentThreadId).toBe(parent.id);
+        expect(thread.originKind).toBeNull();
+        expect(thread.originPluginId).toBeNull();
+        expect(thread.status).toBe("pending");
+        expect(
+          getThreadPluginMetadata(
+            h.db,
+            thread.id,
+            P6R_PARENT_FOLLOWUP_POLICY_NAMESPACE,
+          ).metadata,
+        ).toEqual(value === true ? { noAutomaticParentFollowups: true } : {});
+        const patch = await h.app.request(
+          `/api/v1/threads/${thread.id}/plugin-metadata`,
+          {
+            method: "PATCH",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({
+              pluginId: P6R_PARENT_FOLLOWUP_POLICY_NAMESPACE,
+              set: { noAutomaticParentFollowups: false },
+            }),
+          },
+        );
+        expect(patch.status).toBe(400);
+      });
+    },
+  );
+});
