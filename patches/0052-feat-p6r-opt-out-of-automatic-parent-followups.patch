diff --git a/apps/server/src/services/threads/p6r-parent-followup-policy.ts b/apps/server/src/services/threads/p6r-parent-followup-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..04f2c2e0c80aaf5686763125c4e7a50288be8704
--- /dev/null
+++ b/apps/server/src/services/threads/p6r-parent-followup-policy.ts
@@ -0,0 +1,39 @@
+import {
+  getThreadPluginMetadata,
+  P6R_PARENT_FOLLOWUP_POLICY_NAMESPACE,
+} from "@bb/db";
+import type { LoggedPendingInteractionWorkSessionDeps } from "../../types.js";
+
+export function suppressP6rAutomaticParentFollowup(
+  deps: Pick<LoggedPendingInteractionWorkSessionDeps, "db" | "logger">,
+  childThreadId: string,
+  noticeKind: "outcome" | "needs-attention" | "ownership",
+): boolean {
+  try {
+    const { metadata, corrupt } = getThreadPluginMetadata(
+      deps.db,
+      childThreadId,
+      P6R_PARENT_FOLLOWUP_POLICY_NAMESPACE,
+    );
+    const value = metadata.noAutomaticParentFollowups;
+    if (corrupt || (value !== undefined && typeof value !== "boolean")) {
+      deps.logger.warn(
+        { childThreadId, noticeKind },
+        "Invalid parent followup policy; using default delivery",
+      );
+      return false;
+    }
+    if (value !== true) return false;
+    deps.logger.debug(
+      { childThreadId, noticeKind },
+      "Automatic parent followup suppressed",
+    );
+    return true;
+  } catch (err) {
+    deps.logger.warn(
+      { childThreadId, noticeKind, err },
+      "Could not read parent followup policy; using default delivery",
+    );
+    return false;
+  }
+}
