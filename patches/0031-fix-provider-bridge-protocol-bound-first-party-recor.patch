+function createRecordedCell(root: string, cell: string): void {
+  const dir = join(root, "test-provider", cell);
+  mkdirSync(dir, { recursive: true });
+  writeLane(dir, "runtime→bridge", []);
+  writeLane(dir, "bridge→runtime", []);
+}
+
+function writeReplayProbeBridge(dir: string): string {
+  const bridgePath = join(dir, "replay-probe-bridge.mjs");
+  writeFileSync(
+    bridgePath,
+    [
+      "import { appendFileSync } from 'node:fs';",
+      "const trace = process.env.TRACE_PATH;",
+      "const cell = process.env.CELL;",
+      "const delayMs = Number(process.env.DELAY_MS ?? '0');",
+      "const record = (event) => appendFileSync(trace, `${event}:${cell}\\n`);",
+      "record('start');",
+      "let pending = '';",
+      "process.stdin.setEncoding('utf8');",
+      "process.stdin.on('data', (chunk) => {",
+      "  pending += chunk;",
+      "  for (;;) {",
+      "    const newline = pending.indexOf('\\n');",
+      "    if (newline === -1) break;",
+      "    const line = pending.slice(0, newline);",
+      "    pending = pending.slice(newline + 1);",
+      "    const message = JSON.parse(line);",
+      "    if (message.method === 'initialize') {",
+      "      setTimeout(() => {",
+      "        process.stdout.write(JSON.stringify({ jsonrpc: '2.0', id: message.id, result: {} }) + '\\n');",
+      "      }, delayMs);",
+      "    }",
+      "  }",
+      "});",
+      "process.stdin.on('end', () => { record('finish'); process.exit(0); });",
+      "",
+    ].join("\n"),
+  );
+  return bridgePath;
+}
+
+function tracePeak(trace: readonly string[]): number {
+  const active = new Set<string>();
+  let peak = 0;
+  for (const entry of trace) {
+    const [event, cell] = entry.split(":");
+    if (event === "start") active.add(cell!);
+    if (event === "finish") active.delete(cell!);
+    peak = Math.max(peak, active.size);
+  }
+  return peak;
+}
+
+function emptyAssembler() {
+  return { assembleMessage: () => [] };
+}
+
+it("bounds recorded replays and preserves selected order", async () => {
+  const root = mkdtempSync(join(tmpdir(), "bb-parity-recorded-cells-"));
+  const tracePath = join(root, "trace");
+  const bridgePath = writeReplayProbeBridge(root);
+  for (const cell of ["alpha", "beta", "gamma"]) {
+    createRecordedCell(root, cell);
+  }
+  try {
+    const replays = await replayRecordedCells({
+      recordingsRoot: root,
+      servesProvider: (providerId) => providerId === "test-provider",
+      maxConcurrentReplays: 2,
+      createAssembler: emptyAssembler,
+      bridge: (cell) => ({
+        launch: {
+          command: process.execPath,
+          args: [bridgePath],
+          cwd: root,
+          env: {
+            TRACE_PATH: tracePath,
+            CELL: cell.cell,
+            DELAY_MS: cell.cell === "alpha" ? "80" : "0",
+          },
+        },
+      }),
+    });
+
+    const trace = readFileSync(tracePath, "utf8").trim().split("\n");
+    expect(tracePeak(trace)).toBeLessThanOrEqual(2);
+    expect(trace.filter((entry) => entry.startsWith("start:"))).toEqual([
+      "start:alpha",
+      "start:beta",
+      "start:gamma",
+    ]);
+    expect(trace.indexOf("finish:beta")).toBeLessThan(
+      trace.indexOf("finish:alpha"),
+    );
+    expect(replays.map((replay) => replay.cell)).toEqual([
+      "alpha",
+      "beta",
+      "gamma",
+    ]);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+it("preserves unbounded recorded replay when no limit is supplied", async () => {
+  const root = mkdtempSync(join(tmpdir(), "bb-parity-recorded-unbounded-"));
+  const tracePath = join(root, "trace");
+  const bridgePath = writeReplayProbeBridge(root);
+  for (const cell of ["alpha", "beta", "gamma"]) {
+    createRecordedCell(root, cell);
+  }
+  try {
+    const replays = await replayRecordedCells({
+      recordingsRoot: root,
+      servesProvider: (providerId) => providerId === "test-provider",
+      createAssembler: emptyAssembler,
+      bridge: (cell) => ({
+        launch: {
+          command: process.execPath,
+          args: [bridgePath],
+          cwd: root,
+          env: { TRACE_PATH: tracePath, CELL: cell.cell },
+        },
+      }),
+    });
+
+    const trace = readFileSync(tracePath, "utf8").trim().split("\n");
+    expect(tracePeak(trace)).toBe(3);
+    expect(replays.map((replay) => replay.cell)).toEqual([
+      "alpha",
+      "beta",
+      "gamma",
+    ]);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+it("rejects invalid recorded replay limits", async () => {
+  const root = mkdtempSync(join(tmpdir(), "bb-parity-recorded-limit-"));
+  try {
+    for (const maxConcurrentReplays of [0, -1, 1.5, Number.NaN, Infinity]) {
+      await expect(
+        replayRecordedCells({
+          recordingsRoot: root,
+          servesProvider: () => true,
+          maxConcurrentReplays,
+          createAssembler: emptyAssembler,
+          bridge: () => {
+            throw new Error("bridge must not be resolved");
+          },
+        }),
+      ).rejects.toThrow("maxConcurrentReplays must be a positive integer");
+    }
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+it("stops scheduling queued recorded replays after a failure", async () => {
+  const root = mkdtempSync(join(tmpdir(), "bb-parity-recorded-failure-"));
+  const tracePath = join(root, "trace");
+  const bridgePath = writeReplayProbeBridge(root);
+  for (const cell of ["alpha", "beta", "gamma"]) {
+    createRecordedCell(root, cell);
+  }
+  try {
+    await expect(
+      replayRecordedCells({
+        recordingsRoot: root,
+        servesProvider: (providerId) => providerId === "test-provider",
+        maxConcurrentReplays: 2,
+        createAssembler: emptyAssembler,
+        bridge: (cell) => {
+          if (cell.cell === "alpha")
+            throw new Error("synthetic replay failure");
+          return {
+            launch: {
+              command: process.execPath,
+              args: [bridgePath],
+              cwd: root,
+              env: { TRACE_PATH: tracePath, CELL: cell.cell },
+            },
+          };
+        },
+      }),
+    ).rejects.toThrow("synthetic replay failure");
+
+    const trace = readFileSync(tracePath, "utf8").trim().split("\n");
+    expect(trace).toContain("start:beta");
+    expect(trace).toContain("finish:beta");
+    expect(trace).not.toContain("start:gamma");
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
