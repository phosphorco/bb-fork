 export async function replayRecordedCells(
   options: ReplayRecordedCellsOptions,
 ): Promise<RecordedCellReplay[]> {
+  const maxConcurrentReplays = options.maxConcurrentReplays;
+  if (
+    maxConcurrentReplays !== undefined &&
+    (!Number.isSafeInteger(maxConcurrentReplays) || maxConcurrentReplays < 1)
+  ) {
+    throw new Error("maxConcurrentReplays must be a positive integer");
+  }
   const cells = listRecordedCells(options.recordingsRoot).filter(
     (cell: RecordedCell) =>
       options.servesProvider(cell.provider) &&
       (options.cells === undefined || options.cells.includes(cell.cell)) &&
       readBridgeRecording(cell.dir).manifest?.scope !== "process",
   );
-  return Promise.all(
-    cells.map(async (cell): Promise<RecordedCellReplay> => {
-      const recorded = assembleRecordedEvents(
-        withCurrentBridgeLane(readBridgeRecording(cell.dir)),
-        options.createAssembler,
-        cell.provider,
-      );
-      const bridge = options.bridge(cell);
-      const run = await replayRecording({
-        recordingDir: cell.dir,
-        providerId: cell.provider,
-        bridge: bridge.launch,
-        ...(bridge.profile === undefined ? {} : { profile: bridge.profile }),
-        createAssembler: options.createAssembler,
-        planFromCurrentLane: true,
-        ...(options.timeoutMs !== undefined
-          ? { timeoutMs: options.timeoutMs }
-          : {}),
-        ...(options.onStderr !== undefined
-          ? { onStderr: options.onStderr }
-          : {}),
-      });
-      return {
-        provider: cell.provider,
-        cell: cell.cell,
-        events: run.events,
-        recordedEvents: recorded.events,
-        stalls: run.stalls,
-      };
-    }),
+  const replayCell = async (
+    cell: RecordedCell,
+  ): Promise<RecordedCellReplay> => {
+    const recorded = assembleRecordedEvents(
+      withCurrentBridgeLane(readBridgeRecording(cell.dir)),
+      options.createAssembler,
+      cell.provider,
+    );
+    const bridge = options.bridge(cell);
+    const run = await replayRecording({
+      recordingDir: cell.dir,
+      providerId: cell.provider,
+      bridge: bridge.launch,
+      ...(bridge.profile === undefined ? {} : { profile: bridge.profile }),
+      createAssembler: options.createAssembler,
+      planFromCurrentLane: true,
+      ...(options.timeoutMs !== undefined
+        ? { timeoutMs: options.timeoutMs }
+        : {}),
+      ...(options.onStderr !== undefined ? { onStderr: options.onStderr } : {}),
+    });
+    return {
+      provider: cell.provider,
+      cell: cell.cell,
+      events: run.events,
+      recordedEvents: recorded.events,
+      stalls: run.stalls,
+    };
+  };
+  if (maxConcurrentReplays === undefined) {
+    return Promise.all(cells.map(replayCell));
+  }
+
+  const results: RecordedCellReplay[] = new Array(cells.length);
+  let nextIndex = 0;
+  const state: { cancelled: boolean; failure: unknown } = {
+    cancelled: false,
+    failure: undefined,
+  };
+  const worker = async (): Promise<void> => {
+    while (!state.cancelled) {
+      const index = nextIndex;
+      nextIndex += 1;
+      if (index >= cells.length) return;
+      try {
+        results[index] = await replayCell(cells[index]!);
+      } catch (error) {
+        state.cancelled = true;
+        state.failure = error;
+        return;
+      }
+    }
+  };
+  await Promise.all(
+    Array.from(
+      { length: Math.min(maxConcurrentReplays, cells.length) },
+      worker,
+    ),
   );
+  if (state.cancelled) throw state.failure;
+  return results;
 }
