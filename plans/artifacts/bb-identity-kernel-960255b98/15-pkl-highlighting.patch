@@ -0,0 +1,56 @@
+import type * as Monaco from "monaco-editor";
+import {
+  tokenizePklLine,
+  type PklHighlightState,
+} from "@bb/shared-ui/pkl-highlight";
+
+class PklState implements Monaco.languages.IState {
+  constructor(readonly frames: PklHighlightState = []) {}
+  clone(): PklState {
+    return new PklState(this.frames);
+  }
+  equals(other: Monaco.languages.IState): boolean {
+    return (
+      other instanceof PklState &&
+      JSON.stringify(this.frames) === JSON.stringify(other.frames)
+    );
+  }
+}
+
+export function registerPkl(monaco: typeof Monaco): void {
+  monaco.languages.register({
+    id: "pkl",
+    extensions: [".pkl"],
+    aliases: ["Pkl", "pkl"],
+  });
+  monaco.languages.setTokensProvider("pkl", {
+    getInitialState: () => new PklState(),
+    tokenize(line, state) {
+      const parsed = tokenizePklLine(
+        line,
+        state instanceof PklState ? state.frames : [],
+      );
+      return {
+        tokens: parsed.tokens.map(({ startIndex, kind }) => ({
+          startIndex,
+          scopes: kind,
+        })),
+        endState: new PklState(parsed.state),
+      };
+    },
+  });
+  monaco.languages.setLanguageConfiguration("pkl", {
+    comments: { lineComment: "//", blockComment: ["/*", "*/"] },
+    brackets: [
+      ["{", "}"],
+      ["[", "]"],
+      ["(", ")"],
+    ],
+    autoClosingPairs: [
+      { open: "{", close: "}" },
+      { open: "[", close: "]" },
+      { open: "(", close: ")" },
+      { open: '"', close: '"', notIn: ["string", "comment"] },
+    ],
+  });
+}
