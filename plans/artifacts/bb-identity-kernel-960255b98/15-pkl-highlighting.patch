+describe("Pkl highlighting", () => {
+  it.each(["pkl", "Pkl", ".pkl"])(
+    "recognizes %s fences and Pkl declarations",
+    (language) => {
+      const result = tokens(
+        highlightMarkdownCode({
+          language,
+          code: 'amends "base.pkl"\nlocal port: Int = 8080\nfraction = .23\nenabled = true',
+        }),
+      );
+      expect(result).toContainEqual(["keyword", "amends"]);
+      expect(result).toContainEqual(["keyword", "local"]);
+      expect(result).toContainEqual(["class", "Int"]);
+      expect(result).toContainEqual(["class", "8080"]);
+      expect(result).toContainEqual(["class", ".23"]);
+      expect(result).toContainEqual(["keyword", "true"]);
+    },
+  );
+
+  it("carries raw multiline strings and nested comments without leaking state between fences", () => {
+    const code =
+      'text = #"""\n// literal "quoted" text\n"""#\n/* outer /* nested */ still comment */\nlocal x = 1';
+    const result = tokens(highlightMarkdownCode({ language: "pkl", code }));
+    expect(result).toContainEqual([
+      "string",
+      "// literal &quot;quoted&quot; text",
+    ]);
+    expect(result).toContainEqual([
+      "comment",
+      "/* outer /* nested */ still comment */",
+    ]);
+    expect(result).toContainEqual(["keyword", "local"]);
+    highlightMarkdownCode({ language: "pkl", code: "/* unfinished" });
+    expect(
+      tokens(highlightMarkdownCode({ language: "pkl", code: "local y = 2" })),
+    ).toContainEqual(["keyword", "local"]);
+  });
+
+  it("resumes a raw string after nested interpolation and preserves every source character", () => {
+    const code = String.raw`value = ##"hello \##(if (true) "world" else "<script>")!"##`;
+    const parsed = tokenizePklLine(code);
+    expect(parsed.tokens.map((token) => token.value).join("")).toBe(code);
+    expect(parsed.tokens).toContainEqual(
+      expect.objectContaining({ kind: "keyword", value: "if" }),
+    );
+    expect(parsed.tokens).toContainEqual(
+      expect.objectContaining({ kind: "string", value: '!"##' }),
+    );
+    expect(parsed.state).toEqual([]);
+    const html = highlightMarkdownCode({ language: "pkl", code });
+    expect(html).not.toContain("<script>");
+    expect(html).toContain("&lt;script&gt;");
+  });
+
+  it("does not mutate incremental editor state, and recovers after incomplete single-line strings", () => {
+    const previous = tokenizePklLine('x = """').state;
+    const snapshot = JSON.stringify(previous);
+    expect(tokenizePklLine('end"""', previous).state).toEqual([]);
+    expect(JSON.stringify(previous)).toBe(snapshot);
+    expect(tokenizePklLine('"unfinished').state).toEqual([]);
+    let state: PklHighlightState = [];
+    for (const line of ["/* outer", "/* nested */", "end */ const x = 0xFF"]) {
+      const parsed = tokenizePklLine(line, state);
+      expect(parsed.tokens.map((token) => token.value).join("")).toBe(line);
+      state = parsed.state;
+    }
+    expect(state).toEqual([]);
+  });
+});
