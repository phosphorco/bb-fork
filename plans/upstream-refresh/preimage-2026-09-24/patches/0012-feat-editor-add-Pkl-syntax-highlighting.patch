diff --git a/plugins/monaco-editor/lib/pkl-language.ts b/plugins/monaco-editor/lib/pkl-language.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c69048152e90607fa81f72b8dce9ee48a309c72c
--- /dev/null
