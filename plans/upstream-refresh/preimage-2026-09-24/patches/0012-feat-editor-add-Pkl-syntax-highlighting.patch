 }: HighlightMarkdownCodeArgs): string {
+  if (language?.trim().toLowerCase().replace(/^\./, "") === "pkl")
+    return highlightPkl(code);
   const resolved =
     language === null
       ? undefined
@@ -73,3 +81,32 @@ export function highlightMarkdownCode(args: HighlightMarkdownCodeArgs): string {
   }
   return html;
 }
+
+const PKL_TOKEN_TYPES: Record<PklTokenKind, TokenType> = {
+  keyword: "keyword",
+  type: "class",
+  identifier: "identifier",
+  number: "class",
+  string: "string",
+  comment: "comment",
+  delimiter: "sign",
+  white: "space",
+};
+
+function highlightPkl(code: string): string {
+  let state: PklHighlightState = [];
+  const lines: ParsedLine[] = code.split("\n").map((value, index) => {
+    const parsed = tokenizePklLine(value, state);
+    state = parsed.state;
+    return {
+      index,
+      value,
+      annotations: [],
+      tokens: parsed.tokens.map(({ kind, value }) => ({
+        type: PKL_TOKEN_TYPES[kind],
+        value,
+      })),
+    };
+  });
+  return render({ value: code, lines });
+}
