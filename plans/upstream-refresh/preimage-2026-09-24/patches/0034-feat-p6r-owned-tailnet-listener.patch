From e19699a5e1f1f5e83a2079a51bdb48640ff777bc Mon Sep 17 00:00:00 2001
From: bb-fork <bb-fork@invalid.local>
Date: Wed, 23 Sep 2026 15:57:33 +0200
Subject: [PATCH] feat(p6r): serve owned Tailnet ingress with machine fallback

Route the host's Tailnet Serve ingress through its own loopback listener while
keeping identity resolution best-effort. Verified people retain their identity;
requests without usable person evidence continue with a stable machine actor.

---
diff --git a/apps/server/src/services/p6r/native-request.ts b/apps/server/src/services/p6r/native-request.ts
index e49ad91253e3677f15be9e6c442c1db1021c4447..5b61e1b1177119bbbe2082f66fc8af09b143d901 100644
--- a/apps/server/src/services/p6r/native-request.ts
+++ b/apps/server/src/services/p6r/native-request.ts
@@ -54,10 +54,11 @@ function isProducerMessageRequest(context: Context): boolean {
 
 function installNativeContextResolver(admission: P6rProviderAdmission) {
   return async (context: Context, next: Next): Promise<void> => {
-    nativeContexts.set(context, {
+    const state: NativeContextState = {
       producerMessageRendering: isProducerMessageRequest(context),
       resolve: () => admission.resolveNativeAuthor(context),
-    });
+    };
+    nativeContexts.set(context, state);
     try {
       await next();
     } finally {
@@ -72,8 +73,7 @@ export function installP6rNativeRequestRoutes(
   providerId: string | null,
 ): void {
   const attach = installNativeContextResolver(admission);
-  app.use("/threads", attach);
-  app.use("/threads/*", attach);
+  app.use("*", attach);
 
   const { get } = typedRoutes<PublicApiSchema>(app, {
     onValidationError: (message) =>
@@ -83,7 +83,9 @@ export function installP6rNativeRequestRoutes(
     context.header("Cache-Control", "no-store");
     const result: P6rIdentityResponse = {
       status: "ready",
-      actor: await admission.resolveNativeAuthor(context),
+      actor:
+        nativeContexts.get(context)?.authorship?.author ??
+        (await admission.resolveNativeAuthor(context)),
       providerId: providerId ?? "",
     };
     return context.json(result);
diff --git a/apps/server/src/start-server.ts b/apps/server/src/start-server.ts
index c70c52652327fa309f2cefe110114dbcca564d1d..ca3b5db19a30482332cbde362d0d860722cfd42f 100644
--- a/apps/server/src/start-server.ts
+++ b/apps/server/src/start-server.ts
@@ -325,6 +325,31 @@ export async function runServer(serverConfig: ServerConfig): Promise<void> {
   });
   injectWebSocket(server);
 
+  const tailnetPortText = process.env.BB_TAILNET_INGRESS_PORT;
+  const tailnetPort = tailnetPortText === undefined ? null : Number(tailnetPortText);
+  if (
+    tailnetPort !== null &&
+    (!Number.isInteger(tailnetPort) ||
+      tailnetPort < 1 ||
+      tailnetPort > 65535 ||
+      tailnetPort === serverConfig.BB_SERVER_PORT ||
+      tailnetPort === serverConfig.BB_HOST_DAEMON_PORT ||
+      !isLoopbackHostname(serverConfig.BB_SERVER_BIND_HOST))
+  ) {
+    throw new Error("BB_TAILNET_INGRESS_PORT must be a distinct loopback TCP port");
+  }
+  const tailnetServer =
+    tailnetPort === null
+      ? null
+      : startHttpListener({
+          fetch: app.fetch,
+          serverConfig: {
+            BB_SERVER_BIND_HOST: "127.0.0.1",
+            BB_SERVER_PORT: tailnetPort,
+          },
+        });
+  if (tailnetServer !== null) injectWebSocket(tailnetServer);
+
   logger.info(
     {
       bindHost: serverConfig.BB_SERVER_BIND_HOST,
@@ -397,8 +422,17 @@ export async function runServer(serverConfig: ServerConfig): Promise<void> {
           resolve();
         });
       });
+      const closeTailnetServer =
+        tailnetServer === null
+          ? Promise.resolve()
+          : new Promise<void>((resolve, reject) => {
+              tailnetServer.close((error) => {
+                if (error) reject(error);
+                else resolve();
+              });
+            });
       await closeWebSockets();
-      await closeServer;
+      await Promise.all([closeServer, closeTailnetServer]);
     })();
     return shutdownPromise;
   };
