diff --git a/apps/server/test/threads/thread-lifecycle-admission.test.ts b/apps/server/test/threads/thread-lifecycle-admission.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5b0974daff774375f879e1028ff6012b03d09f06
--- /dev/null
+++ b/apps/server/test/threads/thread-lifecycle-admission.test.ts
@@ -0,0 +1,62 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const append = vi.fn();
+vi.mock("@bb/db", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@bb/db")>()),
+  appendContextMagnetProviderAdmissionObservations: append,
+}));
+
+const { persistThreadStartAdmissionObservations } = await import("../../src/services/threads/thread-lifecycle.js");
+
+describe("thread start admission settlement", () => {
+  beforeEach(() => append.mockReset());
+
+  it("persists only exact command attempt IDs before failed lifecycle handling", () => {
+    persistThreadStartAdmissionObservations({
+      command: { contextMagnetAdmissionAttempts: [{ admissionAttemptId: "cmad_known", contributionKey: { id: "cmct_1", threadId: "thr_1" } }], threadId: "thr_1" },
+      deps: { db: {} },
+      report: { ok: true, result: { outcome: "failed", observations: [{ admissionAttemptId: "cmad_known", kind: "constructed" }, { admissionAttemptId: "cmad_known", kind: "failed-settlement", settlement: "transport-not-accepted" }, { admissionAttemptId: "cmad_unknown", kind: "accepted" }] } },
+    } as never);
+    expect(append).toHaveBeenCalledTimes(1);
+    expect(append).toHaveBeenCalledWith({}, expect.objectContaining({
+      admissionId: "cmad_known",
+      observations: [{ kind: "constructed" }, { kind: "failed-settlement", settlement: "transport-not-accepted" }],
+      threadId: "thr_1",
+    }));
+  });
+
+  it("persists constructed then accepted for a normal started result", () => {
+    persistThreadStartAdmissionObservations({
+      command: { contextMagnetAdmissionAttempts: [{ admissionAttemptId: "cmad_started", contributionKey: { id: "cmct_1", threadId: "thr_1" } }], threadId: "thr_1" },
+      deps: { db: {} },
+      report: { ok: true, result: { outcome: "started", providerThreadId: "provider-thread", observations: [{ admissionAttemptId: "cmad_started", kind: "constructed" }, { admissionAttemptId: "cmad_started", kind: "accepted" }, { admissionAttemptId: "cmad_unknown", kind: "accepted" }] } },
+    } as never);
+    expect(append).toHaveBeenCalledTimes(1);
+    expect(append).toHaveBeenCalledWith({}, expect.objectContaining({
+      admissionId: "cmad_started",
+      observations: [{ kind: "constructed" }, { kind: "accepted" }],
+    }));
+  });
+
+  it("persists the accepted checkpoint before an ordinary post-accept failure", () => {
+    persistThreadStartAdmissionObservations({
+      command: { contextMagnetAdmissionAttempts: [{ admissionAttemptId: "cmad_post_accept", contributionKey: { id: "cmct_1", threadId: "thr_1" } }], threadId: "thr_1" },
+      deps: { db: {} },
+      report: { ok: true, result: { outcome: "failed", observations: [{ admissionAttemptId: "cmad_post_accept", kind: "constructed" }, { admissionAttemptId: "cmad_post_accept", kind: "accepted" }] } },
+    } as never);
+    expect(append).toHaveBeenCalledTimes(1);
+    expect(append).toHaveBeenCalledWith({}, expect.objectContaining({
+      admissionId: "cmad_post_accept",
+      observations: [{ kind: "constructed" }, { kind: "accepted" }],
+    }));
+  });
+
+  it("does not invent observations for an ordinary pre-construction failure", () => {
+    persistThreadStartAdmissionObservations({
+      command: { contextMagnetAdmissionAttempts: [{ admissionAttemptId: "cmad_unavailable", contributionKey: { id: "cmct_1", threadId: "thr_1" } }], threadId: "thr_1" },
+      deps: { db: {} },
+      report: { errorCode: "bridge_unavailable", errorMessage: "redacted", ok: false, type: "thread.start" },
+    } as never);
+    expect(append).not.toHaveBeenCalled();
+  });
+});
