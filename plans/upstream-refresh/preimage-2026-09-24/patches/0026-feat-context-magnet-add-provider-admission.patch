+export type CodexAppServerRemoteErrorKind =
+  | "active-writer"
+  | "archived-session"
+  | "archive-already-done"
+  | "unarchive-already-done"
+  | "empty-rollout-rename"
+  | "interrupt-not-started"
+  | "generic";
+
+export function classifyRemoteError(
+  method: string,
+  error: { code?: number; message?: string },
+): CodexAppServerRemoteErrorKind {
+  const message = error.message ?? "";
+  if (
+    (method === "thread/start" ||
+      method === "thread/resume" ||
+      method === "thread/fork") &&
+    /\b(?:session|thread)\s+\S+\s+is archived\b/i.test(message)
+  ) {
+    return "archived-session";
+  }
+  if (
+    method === "thread/resume" &&
+    /\bthread\s+\S+\s+already has an active writer\b/i.test(message)
+  ) {
+    return "active-writer";
+  }
+  if (
+    method === "thread/archive" &&
+    /\bno rollout found for thread id\b/i.test(message)
+  ) {
+    return "archive-already-done";
+  }
+  if (
+    method === "thread/unarchive" &&
+    /\bno archived rollout found for thread id\b/i.test(message)
+  ) {
+    return "unarchive-already-done";
+  }
+  if (
+    method === "thread/name/set" &&
+    /\brollout at .+ is empty\b/i.test(message)
+  ) {
+    return "empty-rollout-rename";
+  }
+  if (
+    method === "turn/interrupt" &&
+    error.code === -32600 &&
+    message === "no active turn to interrupt"
+  ) {
+    return "interrupt-not-started";
+  }
+  return "generic";
+}
+
+/** A JSON-RPC error response from the provider; its body is never retained. */
+export class CodexAppServerRemoteError extends Error {
+  constructor(readonly kind: CodexAppServerRemoteErrorKind) {
+    super("codex app-server rejected the request");
+    this.name = "CodexAppServerRemoteError";
+  }
+}
+
+/** A syntactically valid response that does not satisfy the requested contract. */
+export class CodexAppServerMalformedResponseError extends Error {
+  constructor() {
+    super("codex app-server returned a malformed response");
+    this.name = "CodexAppServerMalformedResponseError";
+  }
+}
+
+/** The provider remained connected but did not settle a request in time. */
+export class CodexAppServerTimeoutError extends Error {
+  constructor() {
+    super("codex app-server request timed out");
+    this.name = "CodexAppServerTimeoutError";
+  }
+}
