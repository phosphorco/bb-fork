@@ -155,6 +155,76 @@ describe("parseStoredThreadEvent", () => {
     expect(event).not.toHaveProperty("turnId");
   });
 
+  it("round-trips agent-message phase with its causal identity and preserves legacy absence", () => {
+    const data = {
+      providerThreadId: "provider-1",
+      item: {
+        type: "agentMessage",
+        id: "assistant-1",
+        text: "final",
+        phase: "final_answer",
+      },
+    } as const;
+    const event = parseStoredThreadEvent({
+      type: "item/completed",
+      threadId: "thread-1",
+      providerThreadId: "provider-1",
+      scope: turnScope("turn-1"),
+      data,
+    });
+    expect(event).toMatchObject({
+      type: "item/completed",
+      threadId: "thread-1",
+      providerThreadId: "provider-1",
+      scope: turnScope("turn-1"),
+      item: {
+        type: "agentMessage",
+        id: "assistant-1",
+        phase: "final_answer",
+      },
+    });
+    expect(
+      parseThreadEventRow({
+        id: "event-1",
+        type: "item/completed",
+        threadId: "thread-1",
+        seq: 1,
+        createdAt: 1,
+        scope: turnScope("turn-1"),
+        data,
+      }),
+    ).toMatchObject({
+      data: {
+        providerThreadId: "provider-1",
+        item: {
+          id: "assistant-1",
+          phase: "final_answer",
+        },
+      },
+    });
+
+    const legacy = parseStoredThreadEvent({
+      type: "item/completed",
+      threadId: "thread-1",
+      providerThreadId: "provider-1",
+      scope: turnScope("turn-1"),
+      data: {
+        item: {
+          type: "agentMessage",
+          id: "assistant-legacy",
+          text: "legacy",
+        },
+      },
+    });
+    expect(legacy).toMatchObject({ type: "item/completed" });
+    if (
+      legacy.type === "item/completed" &&
+      legacy.item.type === "agentMessage"
+    ) {
+      expect(legacy.item).not.toHaveProperty("phase");
+    }
+  });
+
