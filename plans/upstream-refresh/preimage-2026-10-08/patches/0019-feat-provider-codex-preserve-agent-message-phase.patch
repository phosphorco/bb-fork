   threadQueuedMessageSchema,
   threadScope,
   threadSchema,
@@ -5339,6 +5340,147 @@ describe("public thread data routes", () => {
     });
   });
 
+  it("round-trips optional agent-message phase and causal identity through event list and wait", async () => {
+    await withTestHarness(async (harness) => {
+      const { environment, thread } = seedThreadFixture(harness);
+      const providerThreadId = "provider-phase-1";
+      const scope = turnScope("turn-phase-1");
+
+      seedEvent(harness.deps, {
+        threadId: thread.id,
+        environmentId: environment.id,
+        providerThreadId,
+        scope,
+        sequence: 1,
+        type: "item/completed",
+        data: {
+          item: { type: "agentMessage", id: "msg-legacy", text: "legacy" },
+        },
+      });
+      seedEvent(harness.deps, {
+        threadId: thread.id,
+        environmentId: environment.id,
+        providerThreadId,
+        scope,
+        sequence: 2,
+        type: "item/completed",
+        data: {
+          item: {
+            type: "agentMessage",
+            id: "msg-null",
+            text: "unknown",
+            phase: null,
+          },
+        },
+      });
+      seedEvent(harness.deps, {
+        threadId: thread.id,
+        environmentId: environment.id,
+        providerThreadId,
+        scope,
+        sequence: 3,
+        type: "item/completed",
+        data: {
+          item: {
+            type: "agentMessage",
+            id: "msg-final",
+            text: "final",
+            phase: "final_answer",
+          },
+        },
+      });
+      seedEvent(harness.deps, {
+        threadId: thread.id,
+        environmentId: environment.id,
+        providerThreadId,
+        scope,
+        sequence: 4,
+        type: "turn/completed",
+        data: { status: "completed" },
+      });
+
+      const listResponse = await harness.app.request(
+        `/api/v1/threads/${thread.id}/events?types=item%2Fcompleted%2Cturn%2Fcompleted&order=asc`,
+      );
+      expect(listResponse.status).toBe(200);
+      const listed = threadEventRowSchema
+        .array()
+        .parse(await readJson(listResponse));
+      expect(listed).toHaveLength(4);
+      expect(listed).toMatchObject([
+        {
+          seq: 1,
+          threadId: thread.id,
+          scope,
+          type: "item/completed",
+          data: {
+            providerThreadId,
+            item: { id: "msg-legacy", text: "legacy", type: "agentMessage" },
+          },
+        },
+        {
+          seq: 2,
+          threadId: thread.id,
+          scope,
+          type: "item/completed",
+          data: {
+            providerThreadId,
+            item: {
+              id: "msg-null",
+              phase: null,
+              text: "unknown",
+              type: "agentMessage",
+            },
+          },
+        },
+        {
+          seq: 3,
+          threadId: thread.id,
+          scope,
+          type: "item/completed",
+          data: {
+            providerThreadId,
+            item: {
+              id: "msg-final",
+              phase: "final_answer",
+              text: "final",
+              type: "agentMessage",
+            },
+          },
+        },
+        {
+          seq: 4,
+          threadId: thread.id,
+          scope,
+          type: "turn/completed",
+          data: { providerThreadId, status: "completed" },
+        },
+      ]);
+      expect(listed[0]?.data).not.toHaveProperty("item.phase");
+
+      const waitResponse = await harness.app.request(
+        `/api/v1/threads/${thread.id}/events/wait?type=item%2Fcompleted&afterSeq=2&waitMs=1000`,
+      );
+      expect(waitResponse.status).toBe(200);
+      const waited = threadEventRowSchema.parse(await readJson(waitResponse));
+      expect(waited).toMatchObject({
+        seq: 3,
+        threadId: thread.id,
+        scope,
+        type: "item/completed",
+        data: {
+          providerThreadId,
+          item: {
+            id: "msg-final",
+            phase: "final_answer",
+            text: "final",
+            type: "agentMessage",
+          },
+        },
+      });
+    });
+  });
+
