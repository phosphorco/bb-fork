+async function reservePort() {
+  const server = createServer();
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  const address = server.address();
+  if (address === null || typeof address === "string") {
+    throw new Error("Expected a TCP address");
+  }
+  return { server, port: address.port };
+}
+
+async function closeServer(server: ReturnType<typeof createServer>): Promise<void> {
+  await new Promise<void>((resolveClose, rejectClose) => {
+    server.close((error) => {
+      if (error) rejectClose(error);
+      else resolveClose();
+    });
+  });
+}
+
 describe("server startup diagnostics", () => {
+  it("rejects an invalid Tailnet port before opening the primary listener", async () => {
+    const primary = await reservePort();
+    const port = primary.port;
+    await closeServer(primary.server);
+
+    await expect(
+      startConfiguredHttpListeners({
+        fetch: () => new Response("ok"),
+        serverConfig: {
+          BB_SERVER_BIND_HOST: "127.0.0.1",
+          BB_SERVER_PORT: port,
+          BB_HOST_DAEMON_PORT: 1,
+        },
+        tailnetPortText: String(port),
+      }),
+    ).rejects.toThrow("BB_TAILNET_INGRESS_PORT must be a distinct loopback TCP port");
+
+    const probe = createServer();
+    probe.listen(port, "127.0.0.1");
+    try {
+      await once(probe, "listening");
+    } finally {
+      await closeServer(probe);
+    }
+  });
+
+  it("closes the primary listener when the Tailnet listener cannot bind", async () => {
+    const primary = await reservePort();
+    const primaryPort = primary.port;
+    await closeServer(primary.server);
+    const occupied = await reservePort();
+    try {
+      await expect(
+        startConfiguredHttpListeners({
+          fetch: () => new Response("ok"),
+          serverConfig: {
+            BB_SERVER_BIND_HOST: "127.0.0.1",
+            BB_SERVER_PORT: primaryPort,
+            BB_HOST_DAEMON_PORT: 1,
+          },
+          tailnetPortText: String(occupied.port),
+        }),
+      ).rejects.toMatchObject({ code: "EADDRINUSE" });
+
+      const probe = createServer();
+      probe.listen(primaryPort, "127.0.0.1");
+      try {
+        await once(probe, "listening");
+      } finally {
+        await closeServer(probe);
+      }
+    } finally {
+      await closeServer(occupied.server);
+    }
+  });
+
+  it("starts both listeners, detaches recovery only after readiness, and closes both", async () => {
+    const primary = await reservePort();
+    const primaryPort = primary.port;
+    await closeServer(primary.server);
+    const tailnet = await reservePort();
+    const tailnetPort = tailnet.port;
+    await closeServer(tailnet.server);
+    const listeners = await startConfiguredHttpListeners({
+      fetch: () => new Response("ok"),
+      serverConfig: {
+        BB_SERVER_BIND_HOST: "127.0.0.1",
+        BB_SERVER_PORT: primaryPort,
+        BB_HOST_DAEMON_PORT: 1,
+      },
+      tailnetPortText: String(tailnetPort),
+    });
+    try {
+      const events: string[] = [];
+      let finishRecovery: (() => void) | undefined;
+      const recovery = new Promise<void>((resolveRecovery) => {
+        finishRecovery = resolveRecovery;
+      });
+      const returnValue = startStartupRecoveryAfterListeners({
+        listeners,
+        run: () => {
+          expect(listeners.server.listening).toBe(true);
+          expect(listeners.tailnetServer?.listening).toBe(true);
+          events.push("recovery-started");
+          return recovery.then(() => {
+            events.push("recovery-finished");
+          });
+        },
+        onError: (error) => {
+          throw error;
+        },
+      });
+      expect(returnValue).toBeUndefined();
+      expect(events).toEqual(["recovery-started"]);
+      expect((await fetch(`http://127.0.0.1:${primaryPort}`)).status).toBe(200);
+      expect((await fetch(`http://127.0.0.1:${tailnetPort}`)).status).toBe(200);
+      expect(events).toEqual(["recovery-started"]);
+      finishRecovery?.();
+      await recovery;
+      await Promise.resolve();
+      expect(events).toEqual(["recovery-started", "recovery-finished"]);
+      await closeConfiguredHttpListeners(listeners);
+      expect(() =>
+        startStartupRecoveryAfterListeners({
+          listeners,
+          run: async () => {
+            throw new Error("Recovery must not start on closed listeners");
+          },
+          onError: () => {},
+        }),
+      ).toThrow("Startup recovery requires listening ingress sockets");
+      for (const port of [primaryPort, tailnetPort]) {
+        const probe = createServer();
+        probe.listen(port, "127.0.0.1");
+        try {
+          await once(probe, "listening");
+        } finally {
+          await closeServer(probe);
+        }
+      }
+    } finally {
+      await closeConfiguredHttpListeners(listeners);
+    }
+  });
