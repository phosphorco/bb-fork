+    .all();
+  const knownCreatedAts = new Set([
+    ...expectedMigrations.map((migration) => migration.createdAt),
+    ...legacyIdentityAndContextMagnetMigrationCreatedAts,
+  ]);
+  const appliedCreatedAts = new Set(
+    appliedMigrations
+      .map((migration) => migration.createdAt)
+      .filter((createdAt): createdAt is number => createdAt !== null),
+  );
+  const legacyPrefixLength = legacyIdentityAndContextMagnetMigrations.reduce(
+    (length, legacyMigration, index) =>
+      appliedCreatedAts.has(legacyMigration.createdAt) ? index + 1 : length,
+    0,
+  );
+  const legacyCreatedAts =
+    legacyIdentityAndContextMagnetMigrationCreatedAts.filter((createdAt) =>
+      appliedCreatedAts.has(createdAt),
+    );
+  if (legacyCreatedAts.length === 0) {
+    return;
+  }
+
+  const unknownEarlyMigrations = appliedMigrations.filter(
+    (migration) =>
+      migration.createdAt !== null &&
+      migration.createdAt <= Math.max(...legacyCreatedAts) &&
+      !knownCreatedAts.has(migration.createdAt),
+  );
+  if (unknownEarlyMigrations.length > 0) {
+    throw new Error(
+      "Unsupported legacy identity/context migration history: an unknown ledger row appears at or before the legacy prefix.",
