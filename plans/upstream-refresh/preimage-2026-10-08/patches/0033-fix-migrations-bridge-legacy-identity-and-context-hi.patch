+function assertAppliedMigrationTimestampsAreUnique(db: DbConnection): void {
+  if (!tableExists(db, "__drizzle_migrations")) {
+    return;
+  }
+  const duplicates = db.$client
+    .prepare<[], DuplicateMigrationTimestampRow>(
+      `
+        SELECT created_at AS createdAt, COUNT(*) AS count
+        FROM __drizzle_migrations
+        WHERE created_at IS NOT NULL
+        GROUP BY created_at
+        HAVING COUNT(*) > 1
+        ORDER BY created_at
+        LIMIT 10
+      `,
+    )
+    .all();
+  if (duplicates.length > 0) {
+    throw new Error(
+      `Unsupported migration history: duplicate created_at ledger rows (${duplicates.map((row) => `${row.createdAt} x${row.count}`).join(", ")}).`,
+    );
+  }
+}
