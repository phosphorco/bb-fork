@@ -0,0 +1,306 @@
+import { describe, expect, it } from "vitest";
+import {
+  appendContextMagnetContributionTrace,
+  listContextMagnetContributionTracePage,
+  pruneContextMagnetContributionTraces,
+  recordContextMagnetContributionReceipt,
+} from "../../src/data/context-magnet-contribution-traces.js";
+import { createProject } from "../../src/data/projects.js";
+import { createThread } from "../../src/data/threads.js";
+import { upsertHost } from "../../src/data/hosts.js";
+import { noopNotifier } from "../../src/notifier.js";
+import { events } from "../../src/schema.js";
+import { createMigratedConnection } from "../helpers/migrated-connection.js";
+
+function setup() {
+  const db = createMigratedConnection();
+  const host = upsertHost(db, noopNotifier, { name: "trace-host" });
+  const { project } = createProject(db, noopNotifier, {
+    name: "trace-project",
+    source: { hostId: host.id, path: "/tmp/trace", type: "local_path" },
+  });
+  return { db, thread: createThread(db, noopNotifier, { projectId: project.id, providerId: "codex" }) };
+}
+
+function declaration(threadId: string, eventSeq?: number) {
+  return {
+    evidence: { original: {}, redactions: [], source: "context-magnet-host" as const, sourceSchemaVersion: "v1", unknownFields: {} },
+    inclusionReason: { category: "other-safe" as const },
+    operation:
+      eventSeq === undefined
+        ? { kind: "unmatched" as const, reason: "unknown" as const, target: null }
+        : {
+            kind: "exact" as const,
+            renderedAnchor: {
+              eventSeq,
+              operationId: `evt_${eventSeq}`,
+              threadId,
+            },
+            target: {
+              eventSeq,
+              operationId: `evt_${eventSeq}`,
+              threadId,
+            },
+          },
+    outcome: { kind: "delivered" as const },
+    receiptTool: "context_magnet_receipt",
+    trigger: { factKey: null, locator: "unknown" as const, renderState: "unknown" as const },
+  };
+}
+
+function appendReceiptOperation(
+  db: ReturnType<typeof createMigratedConnection>,
+  args: { callId: string; sequence: number; threadId: string; turnId: string },
+) {
+  db.insert(events).values({
+    createdAt: args.sequence,
+    data: "{}",
+    environmentId: null,
+    id: `evt_${args.sequence}_${args.callId}`,
+    itemId: args.callId,
+    itemKind: "toolCall",
+    parentToolCallId: null,
+    providerThreadId: null,
+    scopeKind: "turn",
+    sequence: args.sequence,
+    threadId: args.threadId,
+    turnId: args.turnId,
+    type: "item/started",
+  }).run();
+}
+
+describe("Context Magnet contribution traces", () => {
+  it("stores immutable declarations and host-owned receipt evidence separately", () => {
+    const { db, thread } = setup();
+    const trace = appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id),
+      now: 1_700_000_000_000,
+      pluginId: "context-magnet",
+      threadId: thread.id,
+    });
+    appendReceiptOperation(db, {
+      callId: "call_1",
+      sequence: 7,
+      threadId: thread.id,
+      turnId: "turn_1",
+    });
+    recordContextMagnetContributionReceipt(db, {
+      callId: "call_1",
+      now: 1_700_000_000_100,
+      pluginId: "context-magnet",
+      receiptTool: "context_magnet_receipt",
+      threadId: thread.id,
+      turnId: "turn_1",
+    });
+    const page = listContextMagnetContributionTracePage(db, {
+      now: 1_700_000_000_200,
+      threadId: thread.id,
+    });
+    expect(page.contributions).toHaveLength(1);
+    expect(page.contributions[0]?.contributionKey.id).toBe(trace.contributionKey.id);
+    expect(page.contributions[0]?.consumption).toMatchObject({ state: "consumed" });
+    expect(page.contributions[0]?.operation).toEqual({
+      kind: "exact",
+      renderedAnchor: { eventSeq: 7, operationId: "call_1", threadId: thread.id },
+      target: { eventSeq: 7, operationId: "call_1", threadId: thread.id },
+    });
+    expect(page.retainedFrom.state).toBe("known");
+    expect(page.snapshot.operationSeqHighWatermark).toBe(7);
+  });
+
+  it("binds a receipt to exactly the newest matching armed declaration", () => {
+    const { db, thread } = setup();
+    const older = appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id),
+      now: 1,
+      pluginId: "context-magnet",
+      threadId: thread.id,
+    });
+    const current = appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id),
+      now: 2,
+      pluginId: "context-magnet",
+      threadId: thread.id,
+    });
+    appendReceiptOperation(db, {
+      callId: "call_1",
+      sequence: 7,
+      threadId: thread.id,
+      turnId: "turn_1",
+    });
+    expect(
+      recordContextMagnetContributionReceipt(db, {
+        callId: "call_1",
+        now: 3,
+        pluginId: "context-magnet",
+        receiptTool: "context_magnet_receipt",
+        threadId: thread.id,
+        turnId: "turn_1",
+      }),
+    ).toBe(1);
+    const page = listContextMagnetContributionTracePage(db, {
+      now: 4,
+      threadId: thread.id,
+    });
