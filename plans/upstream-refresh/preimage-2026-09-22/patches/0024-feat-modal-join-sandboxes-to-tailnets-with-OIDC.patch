+        settings({
+          tailscaleClientId: "client?ephemeral=true",
+          tailscaleTags: "tag:bb-modal-agent",
+        }),
+      ),
+    ).toMatchObject({ ok: false });
+    expect(
+      resolveSettings(
+        settings({ tailscaleClientId: "client", tailscaleTags: "agent" }),
