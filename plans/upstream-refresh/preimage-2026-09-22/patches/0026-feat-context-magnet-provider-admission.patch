diff --git a/plugins/provider-codex/src/bridge/bridge.admission.test.ts b/plugins/provider-codex/src/bridge/bridge.admission.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6bc3a6bf480ae0918a3e774bba45bbc10e0ae8c5
--- /dev/null
+++ b/plugins/provider-codex/src/bridge/bridge.admission.test.ts
@@ -0,0 +1,140 @@
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { experimental_createBridgeJsonRpcTestHarness as createBridgeJsonRpcTestHarness } from "@get-bb/plugin-sdk/provider-bridge/testing";
+import { handleLine } from "./bridge.js";
+import { FULL_ACCESS_SESSION_OPTIONS, stubFakeCodexAppServer } from "./fake-codex-app-server-harness.js";
+
+let harness: ReturnType<typeof createBridgeJsonRpcTestHarness>;
+let workspaceDir: string;
+
+function startParams() {
+  return {
+    contextMagnetAdmissionAttempts: [{ admissionAttemptId: "cmad_1", contributionKey: { id: "cmct_1", threadId: "thr_admission_1" } }],
+    cwd: workspaceDir,
+    instructionMode: "append",
+    options: { ...FULL_ACCESS_SESSION_OPTIONS },
+    threadId: "thr_admission_1",
+  };
+}
+
+beforeEach(() => {
+  workspaceDir = mkdtempSync(join(tmpdir(), "bb-codex-admission-ws-"));
+  harness = createBridgeJsonRpcTestHarness(handleLine);
+});
+
+afterEach(() => {
+  harness.restore();
+  vi.unstubAllEnvs();
+  rmSync(workspaceDir, { recursive: true, force: true });
+});
+
+it("returns constructed then accepted only after a successful provider start", async () => {
+  stubFakeCodexAppServer();
+  harness.sendRequest(1, "thread/start", startParams());
+  const response = await harness.waitForResponse(1);
+  expect(response.error).toBeUndefined();
+  expect(response.result).toMatchObject({ outcome: "started", observations: [{ admissionAttemptId: "cmad_1", kind: "constructed" }, { admissionAttemptId: "cmad_1", kind: "accepted" }] });
+  expect(response.result).not.toHaveProperty("observations.0.providerThreadId");
+});
+
+it("returns a bounded failed settlement rather than a raw post-construction error", async () => {
+  const scriptPath = join(workspaceDir, "script.json");
+  writeFileSync(scriptPath, JSON.stringify({ rejectThreadStart: true }));
+  stubFakeCodexAppServer(scriptPath);
+  harness.sendRequest(2, "thread/start", startParams());
+  const response = await harness.waitForResponse(2);
+  expect(response.error).toBeUndefined();
+  expect(response.result).toEqual({ outcome: "failed", observations: [{ admissionAttemptId: "cmad_1", kind: "constructed" }, { admissionAttemptId: "cmad_1", kind: "failed-settlement", settlement: "transport-not-accepted" }] });
+});
+
+it("classifies a malformed provider response without retaining its body", async () => {
+  const scriptPath = join(workspaceDir, "script.json");
+  writeFileSync(scriptPath, JSON.stringify({ malformedThreadStart: true }));
+  stubFakeCodexAppServer(scriptPath);
+  harness.sendRequest(3, "thread/start", startParams());
+  await expect(harness.waitForResponse(3)).resolves.toEqual({
+    jsonrpc: "2.0",
+    id: 3,
+    result: {
+      outcome: "failed",
+      observations: [
+        { admissionAttemptId: "cmad_1", kind: "constructed" },
+        { admissionAttemptId: "cmad_1", kind: "failed-settlement", settlement: "malformed-response" },
+      ],
+    },
+  });
+});
+
+it("classifies an empty provider response as malformed", async () => {
+  const scriptPath = join(workspaceDir, "script.json");
+  writeFileSync(scriptPath, JSON.stringify({ emptyThreadStart: true }));
+  stubFakeCodexAppServer(scriptPath);
+  harness.sendRequest(7, "thread/start", startParams());
+  await expect(harness.waitForResponse(7)).resolves.toMatchObject({
+    result: {
+      outcome: "failed",
+      observations: [
+        { admissionAttemptId: "cmad_1", kind: "constructed" },
+        { admissionAttemptId: "cmad_1", kind: "failed-settlement", settlement: "malformed-response" },
+      ],
+    },
+  });
+});
+
+it("classifies a provider process failure as bridge-unavailable", async () => {
+  const scriptPath = join(workspaceDir, "script.json");
+  writeFileSync(scriptPath, JSON.stringify({ exitThreadStart: true }));
+  stubFakeCodexAppServer(scriptPath);
+  harness.sendRequest(4, "thread/start", startParams());
+  const response = await harness.waitForResponse(4);
+  expect(response.result).toEqual({
+    outcome: "failed",
+    observations: [
+      { admissionAttemptId: "cmad_1", kind: "constructed" },
+      { admissionAttemptId: "cmad_1", kind: "failed-settlement", settlement: "bridge-unavailable" },
+    ],
+  });
+  expect(JSON.stringify(response)).not.toContain("scripted");
+});
+
+it("preserves acceptance when local identity publication fails after it", async () => {
+  const scriptPath = join(workspaceDir, "script.json");
+  writeFileSync(scriptPath, JSON.stringify({ suppressThreadStartedNotification: true }));
+  stubFakeCodexAppServer(scriptPath);
+  const captureWrite = process.stdout.write;
+  let failedIdentityPublication = false;
+  const writeSpy = vi.spyOn(process.stdout, "write").mockImplementation((chunk, ...args) => {
+    const text = typeof chunk === "string" ? chunk : Buffer.from(chunk).toString("utf8");
+    if (!failedIdentityPublication && text.includes('"method":"thread/identity"')) {
+      failedIdentityPublication = true;
+      throw new Error("scripted local bookkeeping failure");
+    }
+    return captureWrite.call(process.stdout, chunk, ...args);
+  });
+  try {
+    harness.sendRequest(5, "thread/start", startParams());
+    await expect(harness.waitForResponse(5)).resolves.toEqual({
+      jsonrpc: "2.0",
+      id: 5,
+      result: {
+        outcome: "failed",
+        observations: [
+          { admissionAttemptId: "cmad_1", kind: "constructed" },
+          { admissionAttemptId: "cmad_1", kind: "accepted" },
+        ],
+      },
+    });
+  } finally {
+    writeSpy.mockRestore();
+  }
+});
+
+it("does not invent observations when construction fails before the request", async () => {
+  stubFakeCodexAppServer();
+  harness.sendRequest(6, "thread/start", { ...startParams(), options: {} });
+  const response = await harness.waitForResponse(6);
+  expect(response.result).toBeUndefined();
+  expect(response.error).toBeDefined();
+});
