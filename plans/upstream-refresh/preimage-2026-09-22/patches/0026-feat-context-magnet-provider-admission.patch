+): void {
+  if (args.observations.length === 0 || args.observations.length > 2) throw new Error("Provider admission observation batch is invalid");
+  (db as DbConnection).transaction((tx) => {
+    const attempt = tx.select().from(contextMagnetProviderAdmissionAttempts).where(and(eq(contextMagnetProviderAdmissionAttempts.admissionId, args.admissionId), eq(contextMagnetProviderAdmissionAttempts.threadId, args.threadId))).get();
+    if (attempt === undefined) throw new Error("Provider admission attempt is unavailable");
