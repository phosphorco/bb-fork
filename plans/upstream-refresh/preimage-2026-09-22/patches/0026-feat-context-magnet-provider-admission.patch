+    } else {
+      throw new Error("Provider admission observations are append-only and terminal");
+    }
+    const sequenceState = tx.select().from(contextMagnetProviderAdmissionSequences).where(eq(contextMagnetProviderAdmissionSequences.threadId, args.threadId)).get();
+    const prior = sequenceState?.lastObservationSequence ?? 0;
+    tx.insert(contextMagnetProviderAdmissionSequences).values({ threadId: args.threadId, lastObservationSequence: prior + args.observations.length }).onConflictDoUpdate({ target: contextMagnetProviderAdmissionSequences.threadId, set: { lastObservationSequence: prior + args.observations.length } }).run();
+    for (const [index, observation] of args.observations.entries()) {
+      tx.insert(contextMagnetProviderAdmissionObservations).values({ admissionId: args.admissionId, admissionObservationSequence: prior + index + 1, kind: observation.kind, observedAt: args.now, settlement: observation.kind === "failed-settlement" ? observation.settlement : null, threadId: args.threadId }).run();
+    }
+  }, { behavior: "immediate" });
