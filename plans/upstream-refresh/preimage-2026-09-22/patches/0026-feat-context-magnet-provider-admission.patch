+    }
+    const sequenceState = tx.select().from(contextMagnetProviderAdmissionSequences).where(eq(contextMagnetProviderAdmissionSequences.threadId, args.threadId)).get();
+    const admissionAttemptSequence = (sequenceState?.lastAttemptSequence ?? 0) + 1;
+    tx.insert(contextMagnetProviderAdmissionSequences).values({ threadId: args.threadId, lastAttemptSequence: admissionAttemptSequence }).onConflictDoUpdate({ target: contextMagnetProviderAdmissionSequences.threadId, set: { lastAttemptSequence: admissionAttemptSequence } }).run();
