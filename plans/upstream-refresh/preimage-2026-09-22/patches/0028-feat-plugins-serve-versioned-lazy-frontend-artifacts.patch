+  if (meta.artifactFormatVersion === 2) {
+    const artifact = meta.appArtifact!;
+    const artifactsRoot = join(distDir, ".bb-artifacts");
+    const generationDir = join(distDir, ".bb-artifacts", artifact.generation);
+    const rootInfo = await lstat(artifactsRoot).catch(() => null);
+    if (rootInfo === null || !rootInfo.isDirectory() || rootInfo.isSymbolicLink()) return { state: { hasApp: true, bundle: null }, assets: null };
+    const realArtifactsRoot = await realpath(artifactsRoot).catch(() => null);
+    const generationInfo = await lstat(generationDir).catch(() => null);
+    if (realArtifactsRoot === null || generationInfo === null || !generationInfo.isDirectory() || generationInfo.isSymbolicLink()) return { state: { hasApp: true, bundle: null }, assets: null };
+    const realGenerationDir = await realpath(generationDir).catch(() => null);
+    if (realGenerationDir === null || !realGenerationDir.startsWith(`${realArtifactsRoot}${sep}`)) return { state: { hasApp: true, bundle: null }, assets: null };
+    const files = new Map<string, { bytes: Buffer; hash: string; contentType: string }>();
+    const hasher = createHash("sha256").update(metaRaw);
+    let totalBytes = 0;
+    for (const file of artifact.files) {
+      const path = resolve(generationDir, file.path);
+      if (!path.startsWith(`${generationDir}${sep}`)) return { state: { hasApp: true, bundle: null }, assets: null };
+      const info = await lstat(path).catch(() => null);
+      if (info === null || !info.isFile() || info.isSymbolicLink() || (await realpath(path)).startsWith(`${realGenerationDir}${sep}`) === false) {
+        return { state: { hasApp: true, bundle: null }, assets: null };
+      }
+      if (info.size !== file.bytes || totalBytes + info.size > MAX_APP_ARTIFACT_TOTAL_BYTES) return { state: { hasApp: true, bundle: null }, assets: null };
+      const bytes = await readBoundedRegularFile(path, MAX_APP_ARTIFACT_FILE_BYTES).catch(() => null);
+      if (bytes === null) return { state: { hasApp: true, bundle: null }, assets: null };
+      const hash = createHash("sha256").update(bytes).digest("hex");
+      if (bytes.byteLength !== file.bytes || hash !== file.sha256) return { state: { hasApp: true, bundle: null }, assets: null };
+      totalBytes += bytes.byteLength;
+      hasher.update(file.path).update(bytes);
+      files.set(file.path, { bytes, hash, contentType: file.contentType });
