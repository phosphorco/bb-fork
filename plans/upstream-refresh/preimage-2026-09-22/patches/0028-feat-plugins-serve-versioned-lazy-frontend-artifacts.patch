+      assets: { hash, generation: artifact.generation, files },
+    };
+  }
+  const jsPath = join(distDir, "app.js");
+  const cssPath = join(distDir, "app.css");
+  let js: Buffer;
+  try { js = await readFile(jsPath); } catch { return { state: { hasApp: true, bundle: null }, assets: null }; }
   let css: Buffer | null;
