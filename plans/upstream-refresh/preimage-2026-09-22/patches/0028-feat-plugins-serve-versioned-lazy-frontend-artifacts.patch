+type AppArtifactFile = Readonly<{
+  path: string;
+  bytes: number;
+  sha256: string;
+  contentType: "text/javascript; charset=utf-8" | "text/css; charset=utf-8";
+}>;
+
+const MAX_RETAINED_APP_ARTIFACT_GENERATIONS = 3;
+
+async function pruneAppArtifactGenerations(root: string, current: string): Promise<void> {
+  const generations = (await Promise.all((await readdir(root)).map(async (name) => {
+    if (!/^[a-f0-9]{32}$/.test(name)) return null;
+    const path = join(root, name);
+    const info = await lstat(path).catch(() => null);
+    if (info === null || !info.isDirectory() || info.isSymbolicLink()) return null;
+    return { name, path, modifiedAt: info.mtimeMs };
+  }))).filter((generation): generation is { name: string; path: string; modifiedAt: number } => generation !== null)
+    .sort((left, right) => right.modifiedAt - left.modifiedAt || right.name.localeCompare(left.name));
+  const retained = new Set(generations.slice(0, MAX_RETAINED_APP_ARTIFACT_GENERATIONS).map((generation) => generation.name));
+  retained.add(current);
+  await Promise.all(generations.filter((generation) => !retained.has(generation.name)).map((generation) => rm(generation.path, { recursive: true, force: true })));
+}
+
+async function appArtifactFiles(root: string, relative = ""): Promise<AppArtifactFile[]> {
+  const files: AppArtifactFile[] = [];
+  for (const entry of await readdir(join(root, relative), { withFileTypes: true })) {
+    const path = relative === "" ? entry.name : `${relative}/${entry.name}`;
+    if (entry.isDirectory()) {
+      files.push(...await appArtifactFiles(root, path));
+      continue;
+    }
+    if (!entry.isFile()) continue;
+    const contentType = path.endsWith(".js")
+      ? "text/javascript; charset=utf-8"
+      : path.endsWith(".css")
+        ? "text/css; charset=utf-8"
+        : null;
+    if (contentType === null) continue;
+    const bytes = await readFile(join(root, path));
+    files.push({
+      path,
+      bytes: bytes.byteLength,
+      sha256: createHash("sha256").update(bytes).digest("hex"),
+      contentType,
+    });
+  }
+  return files.sort((left, right) => left.path.localeCompare(right.path));
+}
