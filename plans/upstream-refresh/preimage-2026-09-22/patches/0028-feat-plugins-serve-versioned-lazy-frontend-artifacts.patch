+      paths.add(candidate.path);
+      if (typeof candidate.bytes !== "number" || !Number.isSafeInteger(candidate.bytes) || candidate.bytes < 0 || candidate.bytes > MAX_APP_ARTIFACT_FILE_BYTES) return false;
+      declaredBytes += candidate.bytes;
+      return declaredBytes <= MAX_APP_ARTIFACT_TOTAL_BYTES
+        && typeof candidate.sha256 === "string" && /^[a-f0-9]{64}$/.test(candidate.sha256)
