@@ -0,0 +1,435 @@
+import { and, asc, desc, eq, gt, isNotNull, isNull, lte, max, min, or, sql } from "drizzle-orm";
+import {
+  contextMagnetContributionTracePageSchema,
+  contextMagnetContributionTraceSchema,
+  type ContextMagnetContributionTrace,
+  type ContextMagnetContributionTraceDeclaration,
+} from "@bb/domain";
+import type { DbConnection } from "../connection.js";
+import { createContextMagnetContributionTraceId } from "../ids.js";
+import {
+  contextMagnetContributionTraceReceipts,
+  contextMagnetContributionTraceSnapshots,
+  contextMagnetContributionTraces,
+  events,
+} from "../schema.js";
+
+const PAGE_SIZE_MAX = 100;
+const SNAPSHOT_MAX_AGE_MS = 15 * 60_000;
+
+function snapshotId(): string {
+  return `cmcts_${crypto.randomUUID().replaceAll("-", "")}`;
+}
+
+type TraceCursor = {
+  contributionId: string;
+  operationEventSequence: number | null;
+  snapshotId: string;
+};
+
+function parseCursor(value: string): TraceCursor {
+  const [id, operation, contributionId, extra] = value.split(".");
+  const operationEventSequence =
+    operation === "n"
+      ? null
+      : operation?.startsWith("o") && /^\d+$/.test(operation.slice(1))
+        ? Number(operation.slice(1))
+        : undefined;
+  if (
+    id === undefined ||
+    contributionId === undefined ||
+    extra !== undefined ||
+    value.length > 256 ||
+    !/^cmcts_[a-f0-9]+$/.test(id) ||
+    !/^cmct_[a-z0-9]+$/.test(contributionId) ||
+    operationEventSequence === undefined ||
+    (operationEventSequence !== null &&
+      !Number.isSafeInteger(operationEventSequence))
+  ) {
+    throw new Error("Invalid Context Magnet trace cursor");
+  }
+  return { contributionId, operationEventSequence, snapshotId: id };
+}
+
+function makeCursor(snapshotId: string, row: {
+  contributionId: string;
+  operationEventSequence: number | null;
+}): string {
+  return `${snapshotId}.${row.operationEventSequence === null ? "n" : `o${row.operationEventSequence}`}.${row.contributionId}`;
+}
+
+function assertTraceThread(
+  declaration: ContextMagnetContributionTraceDeclaration,
+  threadId: string,
+): void {
+  const keys = [
+    declaration.operation.kind === "unmatched"
+      ? declaration.operation.target
+      : declaration.operation.target,
+    declaration.operation.kind === "unmatched"
+      ? undefined
+      : declaration.operation.renderedAnchor,
+    declaration.trigger.renderedAnchor,
+  ];
+  if (
+    keys.some((key) => key !== undefined && key !== null && key.threadId !== threadId) ||
+    (declaration.trigger.factKey !== null &&
+      declaration.trigger.factKey.threadId !== threadId)
+  ) {
+    throw new Error("Context Magnet trace declarations cannot cross thread boundaries");
+  }
+}
+
+export function appendContextMagnetContributionTrace(
+  db: DbConnection,
+  args: {
+    declaration: ContextMagnetContributionTraceDeclaration;
+    now: number;
+    pluginId: string;
+    threadId: string;
+  },
+): ContextMagnetContributionTrace {
+  const declaration = args.declaration;
+  assertTraceThread(declaration, args.threadId);
+  const trace = contextMagnetContributionTraceSchema.parse({
+    contributionKey: {
+      id: createContextMagnetContributionTraceId(),
+      threadId: args.threadId,
+    },
+    consumption: { state: "not-observed" },
+    evidence: declaration.evidence,
+    inclusionReason: declaration.inclusionReason,
+    operation: declaration.operation,
+    outcome: declaration.outcome,
+    trigger: declaration.trigger,
+  });
+  const prior = db
+    .select({ value: max(contextMagnetContributionTraces.traceSequence) })
+    .from(contextMagnetContributionTraces)
+    .where(eq(contextMagnetContributionTraces.threadId, args.threadId))
+    .get();
+  const traceSequence = (prior?.value ?? 0) + 1;
+  const target =
+    trace.operation.kind === "unmatched"
+      ? null
+      : trace.operation.target.eventSeq;
+  db.insert(contextMagnetContributionTraces)
+    .values({
+      contributionId: trace.contributionKey.id,
+      createdAt: args.now,
+      operationEventSequence: target,
+      pluginId: args.pluginId,
+      receiptTool: declaration.receiptTool,
+      threadId: args.threadId,
+      traceJson: JSON.stringify(trace),
+      traceSequence,
+    })
+    .run();
+  return trace;
+}
+
+export function recordContextMagnetContributionReceipt(
+  db: DbConnection,
+  args: {
+    callId: string;
+    now: number;
+    pluginId: string;
+    receiptTool: string;
+    threadId: string;
+    turnId: string;
+  },
+): number {
+  const operations = db
+    .select({
+      operationEventSequence: events.sequence,
+      operationId: events.itemId,
+    })
+    .from(events)
+    .where(
+      and(
+        eq(events.threadId, args.threadId),
+        eq(events.turnId, args.turnId),
+        eq(events.itemId, args.callId),
+        eq(events.itemKind, "toolCall"),
+        eq(events.type, "item/started"),
+      ),
+    )
+    .all()
+    .filter((operation) => operation.operationId !== null);
+  if (operations.length !== 1) return 0;
+  const operation = operations[0];
+  if (operation === undefined || operation.operationId === null) return 0;
+  const rows = db
+    .select({
+      receipt: contextMagnetContributionTraceReceipts,
+      trace: contextMagnetContributionTraces,
+    })
+    .from(contextMagnetContributionTraces)
+    .leftJoin(
+      contextMagnetContributionTraceReceipts,
+      eq(
+        contextMagnetContributionTraceReceipts.contributionId,
+        contextMagnetContributionTraces.contributionId,
+      ),
+    )
+    .where(
+      and(
+        eq(contextMagnetContributionTraces.threadId, args.threadId),
+        eq(contextMagnetContributionTraces.pluginId, args.pluginId),
+        eq(contextMagnetContributionTraces.receiptTool, args.receiptTool),
+      ),
+    )
+    .orderBy(desc(contextMagnetContributionTraces.traceSequence))
+    .limit(1)
+    .all();
+  const eligible = rows.find((row) => row.receipt === null);
+  if (eligible === undefined) return 0;
+  const prior = db
+    .select({ value: max(contextMagnetContributionTraceReceipts.receiptSequence) })
+    .from(contextMagnetContributionTraceReceipts)
+    .innerJoin(
+      contextMagnetContributionTraces,
+      eq(
+        contextMagnetContributionTraceReceipts.contributionId,
+        contextMagnetContributionTraces.contributionId,
+      ),
+    )
+    .where(eq(contextMagnetContributionTraces.threadId, args.threadId))
+    .get();
+  db.insert(contextMagnetContributionTraceReceipts)
+    .values({
+      callId: args.callId,
+      contributionId: eligible.trace.contributionId,
+      observedAt: args.now,
+      operationEventSequence: operation.operationEventSequence,
+      operationId: operation.operationId,
+      receiptSequence: (prior?.value ?? 0) + 1,
+      turnId: args.turnId,
+    })
+    .onConflictDoNothing()
+    .run();
+  return 1;
+}
+
+export function listContextMagnetContributionTracePage(
+  db: DbConnection,
+  args: {
+    cursor?: string;
+    limit?: number;
+    now: number;
+    threadId: string;
+  },
+) {
+  const limit = Math.min(Math.max(args.limit ?? PAGE_SIZE_MAX, 1), PAGE_SIZE_MAX);
+  const cursor = args.cursor === undefined ? null : parseCursor(args.cursor);
+  const snapshot = cursor
+    ? db
+        .select()
+        .from(contextMagnetContributionTraceSnapshots)
+        .where(
+          and(
+            eq(contextMagnetContributionTraceSnapshots.id, cursor.snapshotId),
+            eq(contextMagnetContributionTraceSnapshots.threadId, args.threadId),
+          ),
+        )
+        .get()
+    : (() => {
+        const created = {
+          capturedAt: args.now,
+          highWaterSequence:
+            db
+              .select({ value: max(contextMagnetContributionTraces.traceSequence) })
+              .from(contextMagnetContributionTraces)
+              .where(eq(contextMagnetContributionTraces.threadId, args.threadId))
+              .get()?.value ?? 0,
+          operationSeqHighWatermark:
+            db
+              .select({ value: max(events.sequence) })
+        .from(events)
+        .where(eq(events.threadId, args.threadId))
+        .get()?.value ?? 0,
+          receiptHighWaterSequence:
+            db
+              .select({ value: max(contextMagnetContributionTraceReceipts.receiptSequence) })
+              .from(contextMagnetContributionTraceReceipts)
+              .innerJoin(
+                contextMagnetContributionTraces,
+                eq(
+                  contextMagnetContributionTraceReceipts.contributionId,
+                  contextMagnetContributionTraces.contributionId,
+                ),
+              )
+              .where(eq(contextMagnetContributionTraces.threadId, args.threadId))
+              .get()?.value ?? 0,
+          id: snapshotId(),
+          threadId: args.threadId,
+        };
+        db.insert(contextMagnetContributionTraceSnapshots).values(created).run();
+        return created;
+      })();
+  if (snapshot === undefined) {
+    throw new Error("Context Magnet trace cursor requires a restart");
+  }
+  if (snapshot.capturedAt + SNAPSHOT_MAX_AGE_MS < args.now) {
+    throw new Error("Context Magnet trace cursor expired and requires a restart");
+  }
+  const highWater = snapshot.highWaterSequence;
+  const effectiveOperationEventSequence = sql<number | null>`coalesce(${contextMagnetContributionTraceReceipts.operationEventSequence}, ${contextMagnetContributionTraces.operationEventSequence})`;
+  const cursorFilter = cursor === null
+    ? undefined
+    : cursor.operationEventSequence === null
+      ? and(
+          isNull(effectiveOperationEventSequence),
+          gt(contextMagnetContributionTraces.contributionId, cursor.contributionId),
+        )
+      : or(
+          and(
+            isNotNull(effectiveOperationEventSequence),
+            or(
+              gt(
+                effectiveOperationEventSequence,
+                cursor.operationEventSequence,
+              ),
+              and(
+                eq(
+                  effectiveOperationEventSequence,
+                  cursor.operationEventSequence,
+                ),
+                gt(contextMagnetContributionTraces.contributionId, cursor.contributionId),
+              ),
+            ),
+          ),
+          isNull(effectiveOperationEventSequence),
+        );
+  const rows = db
+    .select({
+      effectiveOperationEventSequence,
+      receipt: contextMagnetContributionTraceReceipts,
+      trace: contextMagnetContributionTraces,
+    })
+    .from(contextMagnetContributionTraces)
+    .leftJoin(
+      contextMagnetContributionTraceReceipts,
+      and(
+        eq(
+          contextMagnetContributionTraceReceipts.contributionId,
+          contextMagnetContributionTraces.contributionId,
+        ),
+        lte(
+          contextMagnetContributionTraceReceipts.receiptSequence,
+          snapshot.receiptHighWaterSequence,
+        ),
+      ),
+    )
+    .where(and(
+      eq(contextMagnetContributionTraces.threadId, args.threadId),
+      lte(contextMagnetContributionTraces.traceSequence, highWater),
+      cursorFilter,
+    ))
+    .orderBy(
+      asc(sql`CASE WHEN ${effectiveOperationEventSequence} IS NULL THEN 1 ELSE 0 END`),
+      asc(effectiveOperationEventSequence),
+      asc(contextMagnetContributionTraces.contributionId),
+    )
+    .limit(limit + 1)
+    .all();
+  const pageRows = rows.slice(0, limit);
+  const boundary = db
+    .select({ value: min(contextMagnetContributionTraces.traceSequence) })
+    .from(contextMagnetContributionTraces)
+    .where(eq(contextMagnetContributionTraces.threadId, args.threadId))
+    .get()?.value ?? null;
+  const contributions = pageRows.map((row) => {
+    const trace = contextMagnetContributionTraceSchema.parse(
+      JSON.parse(row.trace.traceJson),
+    );
+    const receipt = row.receipt;
+    return receipt === null || receipt.operationId === null || receipt.operationEventSequence === null
+      ? trace
+      : {
+          ...trace,
+          operation: {
+            kind: "exact" as const,
+            renderedAnchor: {
+              eventSeq: receipt.operationEventSequence,
+              operationId: receipt.operationId,
+              threadId: args.threadId,
+            },
+            target: {
+              eventSeq: receipt.operationEventSequence,
+              operationId: receipt.operationId,
+              threadId: args.threadId,
+            },
+          },
+          consumption: {
+            kind: "model-owned-receipt" as const,
+            observedAt: new Date(receipt.observedAt).toISOString(),
+            state: "consumed" as const,
+          },
+        };
+  });
+  const terminal = pageRows.at(-1);
+  return contextMagnetContributionTracePageSchema.parse({
+    completeness:
+      boundary === null
+        ? "unavailable"
+        : boundary > 1
+          ? "partial"
+          : "complete",
+    contributions,
+    cursor: args.cursor ?? null,
+    gaps:
+      boundary === null
+        ? [{
+            kind: "carrier",
+            reason: "No retained contribution boundary is available.",
+            scope: "contributions",
+          }]
+        : boundary > 1
+        ? [{
+            afterEventSeq: 0,
+            beforeEventSeq: boundary,
+            kind: "retention",
+            reason: "Earlier retained contribution records are unavailable.",
+            scope: "contributions",
+          }]
+        : [],
+    nextCursor: rows.length > limit && terminal !== undefined
+      ? makeCursor(snapshot.id, {
+          contributionId: terminal.trace.contributionId,
+          operationEventSequence: terminal.effectiveOperationEventSequence,
+        })
+      : null,
+    retainedFrom: {
+      contributionEventSeq: boundary,
+      operationEventSeq: null,
+      state: boundary === null ? "unavailable" : "known",
+    },
+    snapshot: {
+      capturedAt: new Date(snapshot.capturedAt).toISOString(),
+      id: snapshot.id,
+      operationSeqHighWatermark: snapshot.operationSeqHighWatermark,
+    },
+    threadId: args.threadId,
+    version: "context-magnet.trace-carrier/v1",
+  });
+}
+
+export function pruneContextMagnetContributionTraces(
+  db: DbConnection,
+  args: { keep: number; threadId: string },
+): number {
+  const rows = db
+    .select({ id: contextMagnetContributionTraces.contributionId })
+    .from(contextMagnetContributionTraces)
+    .where(eq(contextMagnetContributionTraces.threadId, args.threadId))
+    .orderBy(asc(contextMagnetContributionTraces.traceSequence))
+    .all();
+  const removable = rows.slice(0, Math.max(0, rows.length - args.keep));
+  for (const row of removable) {
+    db.delete(contextMagnetContributionTraces)
+      .where(eq(contextMagnetContributionTraces.contributionId, row.id))
+      .run();
+  }
+  return removable.length;
+}
