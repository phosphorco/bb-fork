--- /dev/null
+++ b/packages/db/test/data/context-magnet-contribution-traces.test.ts
@@ -0,0 +1,306 @@
+import { describe, expect, it } from "vitest";
+import {
+  appendContextMagnetContributionTrace,
+  listContextMagnetContributionTracePage,
+  pruneContextMagnetContributionTraces,
+  recordContextMagnetContributionReceipt,
+} from "../../src/data/context-magnet-contribution-traces.js";
+import { createProject } from "../../src/data/projects.js";
+import { createThread } from "../../src/data/threads.js";
+import { upsertHost } from "../../src/data/hosts.js";
+import { noopNotifier } from "../../src/notifier.js";
+import { events } from "../../src/schema.js";
+import { createMigratedConnection } from "../helpers/migrated-connection.js";
+
+function setup() {
+  const db = createMigratedConnection();
+  const host = upsertHost(db, noopNotifier, { name: "trace-host" });
+  const { project } = createProject(db, noopNotifier, {
+    name: "trace-project",
+    source: { hostId: host.id, path: "/tmp/trace", type: "local_path" },
+  });
+  return { db, thread: createThread(db, noopNotifier, { projectId: project.id, providerId: "codex" }) };
+}
+
+function declaration(threadId: string, eventSeq?: number) {
+  return {
+    evidence: { original: {}, redactions: [], source: "context-magnet-host" as const, sourceSchemaVersion: "v1", unknownFields: {} },
+    inclusionReason: { category: "other-safe" as const },
+    operation:
+      eventSeq === undefined
+        ? { kind: "unmatched" as const, reason: "unknown" as const, target: null }
+        : {
+            kind: "exact" as const,
+            renderedAnchor: {
+              eventSeq,
+              operationId: `evt_${eventSeq}`,
+              threadId,
+            },
+            target: {
+              eventSeq,
+              operationId: `evt_${eventSeq}`,
+              threadId,
+            },
+          },
+    outcome: { kind: "delivered" as const },
+    receiptTool: "context_magnet_receipt",
+    trigger: { factKey: null, locator: "unknown" as const, renderState: "unknown" as const },
+  };
+}
+
+function appendReceiptOperation(
+  db: ReturnType<typeof createMigratedConnection>,
+  args: { callId: string; sequence: number; threadId: string; turnId: string },
+) {
+  db.insert(events).values({
+    createdAt: args.sequence,
+    data: "{}",
+    environmentId: null,
+    id: `evt_${args.sequence}_${args.callId}`,
+    itemId: args.callId,
+    itemKind: "toolCall",
+    parentToolCallId: null,
+    providerThreadId: null,
+    scopeKind: "turn",
+    sequence: args.sequence,
+    threadId: args.threadId,
+    turnId: args.turnId,
+    type: "item/started",
+  }).run();
+}
+
+describe("Context Magnet contribution traces", () => {
+  it("stores immutable declarations and host-owned receipt evidence separately", () => {
+    const { db, thread } = setup();
+    const trace = appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id),
+      now: 1_700_000_000_000,
+      pluginId: "context-magnet",
+      threadId: thread.id,
+    });
+    appendReceiptOperation(db, {
+      callId: "call_1",
+      sequence: 7,
+      threadId: thread.id,
+      turnId: "turn_1",
+    });
+    recordContextMagnetContributionReceipt(db, {
+      callId: "call_1",
+      now: 1_700_000_000_100,
+      pluginId: "context-magnet",
+      receiptTool: "context_magnet_receipt",
+      threadId: thread.id,
+      turnId: "turn_1",
+    });
+    const page = listContextMagnetContributionTracePage(db, {
+      now: 1_700_000_000_200,
+      threadId: thread.id,
+    });
+    expect(page.contributions).toHaveLength(1);
+    expect(page.contributions[0]?.contributionKey.id).toBe(trace.contributionKey.id);
+    expect(page.contributions[0]?.consumption).toMatchObject({ state: "consumed" });
+    expect(page.contributions[0]?.operation).toEqual({
+      kind: "exact",
+      renderedAnchor: { eventSeq: 7, operationId: "call_1", threadId: thread.id },
+      target: { eventSeq: 7, operationId: "call_1", threadId: thread.id },
+    });
+    expect(page.retainedFrom.state).toBe("known");
+    expect(page.snapshot.operationSeqHighWatermark).toBe(7);
+  });
+
+  it("binds a receipt to exactly the newest matching armed declaration", () => {
+    const { db, thread } = setup();
+    const older = appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id),
+      now: 1,
+      pluginId: "context-magnet",
+      threadId: thread.id,
+    });
+    const current = appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id),
+      now: 2,
+      pluginId: "context-magnet",
+      threadId: thread.id,
+    });
+    appendReceiptOperation(db, {
+      callId: "call_1",
+      sequence: 7,
+      threadId: thread.id,
+      turnId: "turn_1",
+    });
+    expect(
+      recordContextMagnetContributionReceipt(db, {
+        callId: "call_1",
+        now: 3,
+        pluginId: "context-magnet",
+        receiptTool: "context_magnet_receipt",
+        threadId: thread.id,
+        turnId: "turn_1",
+      }),
+    ).toBe(1);
+    const page = listContextMagnetContributionTracePage(db, {
+      now: 4,
+      threadId: thread.id,
+    });
+    expect(
+      page.contributions.find((trace) => trace.contributionKey.id === older.contributionKey.id)?.consumption,
+    ).toEqual({ state: "not-observed" });
+    expect(
+      page.contributions.find((trace) => trace.contributionKey.id === current.contributionKey.id)?.consumption,
+    ).toMatchObject({ state: "consumed" });
+    expect(
+      recordContextMagnetContributionReceipt(db, {
+        callId: "call_2",
+        now: 5,
+        pluginId: "context-magnet",
+        receiptTool: "context_magnet_receipt",
+        threadId: thread.id,
+        turnId: "turn_2",
+      }),
+    ).toBe(0);
+    const afterSecondReceipt = listContextMagnetContributionTracePage(db, {
+      now: 6,
+      threadId: thread.id,
+    });
+    expect(
+      afterSecondReceipt.contributions.find((trace) => trace.contributionKey.id === older.contributionKey.id)?.consumption,
+    ).toEqual({ state: "not-observed" });
+  });
+
+  it("walks reversed operation sequences without duplicates", () => {
+    const { db, thread } = setup();
+    for (const eventSeq of [30, 10, 20]) {
+      appendContextMagnetContributionTrace(db, {
+        declaration: declaration(thread.id, eventSeq),
+        now: eventSeq,
+        pluginId: "context-magnet",
+        threadId: thread.id,
+      });
+    }
+    const first = listContextMagnetContributionTracePage(db, {
+      limit: 1,
+      now: 40,
+      threadId: thread.id,
+    });
+    const second = listContextMagnetContributionTracePage(db, {
+      cursor: first.nextCursor ?? undefined,
+      limit: 1,
+      now: 41,
+      threadId: thread.id,
+    });
+    const third = listContextMagnetContributionTracePage(db, {
+      cursor: second.nextCursor ?? undefined,
+      limit: 1,
+      now: 42,
+      threadId: thread.id,
+    });
+    const all = [...first.contributions, ...second.contributions, ...third.contributions];
+    expect(all.map((trace) => trace.operation.kind === "unmatched" ? null : trace.operation.target.eventSeq)).toEqual([10, 20, 30]);
+    expect(new Set(all.map((trace) => trace.contributionKey.id)).size).toBe(3);
+    expect(third.nextCursor).toBeNull();
+  });
+
+  it("keeps a keyset walk exhaustive when retention prunes the first page", () => {
+    const { db, thread } = setup();
+    for (const eventSeq of [10, 20, 30]) {
+      appendContextMagnetContributionTrace(db, {
+        declaration: declaration(thread.id, eventSeq),
+        now: eventSeq,
+        pluginId: "context-magnet",
+        threadId: thread.id,
+      });
+    }
+    const first = listContextMagnetContributionTracePage(db, {
+      limit: 1,
+      now: 40,
+      threadId: thread.id,
+    });
+    expect(first.contributions.map((trace) => trace.operation.kind === "unmatched" ? null : trace.operation.target.eventSeq)).toEqual([10]);
+    expect(pruneContextMagnetContributionTraces(db, { keep: 2, threadId: thread.id })).toBe(1);
+    const second = listContextMagnetContributionTracePage(db, {
+      cursor: first.nextCursor ?? undefined,
+      limit: 1,
+      now: 41,
+      threadId: thread.id,
+    });
+    const third = listContextMagnetContributionTracePage(db, {
+      cursor: second.nextCursor ?? undefined,
+      limit: 1,
+      now: 42,
+      threadId: thread.id,
+    });
+    const all = [...first.contributions, ...second.contributions, ...third.contributions];
+    expect(all.map((trace) => trace.operation.kind === "unmatched" ? null : trace.operation.target.eventSeq)).toEqual([10, 20, 30]);
+    expect(new Set(all.map((trace) => trace.contributionKey.id)).size).toBe(3);
+    expect(second.completeness).toBe("partial");
+    expect(second.gaps).toMatchObject([{ kind: "retention", scope: "contributions" }]);
+    expect(third.nextCursor).toBeNull();
+  });
+
+  it("does not call an empty trace complete history", () => {
+    const { db, thread } = setup();
+    const page = listContextMagnetContributionTracePage(db, {
+      now: 1,
+      threadId: thread.id,
+    });
+    expect(page.completeness).toBe("unavailable");
+    expect(page.gaps).toMatchObject([{ kind: "carrier", scope: "contributions" }]);
+    expect(page.retainedFrom.state).toBe("unavailable");
+  });
+
+  it("requires one durable tool-start operation from the receipt thread and turn", () => {
+    const { db, thread } = setup();
+    appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id),
+      now: 1,
+      pluginId: "context-magnet",
+      threadId: thread.id,
+    });
+    appendReceiptOperation(db, {
+      callId: "call_1",
+      sequence: 7,
+      threadId: thread.id,
+      turnId: "other-turn",
+    });
+    expect(recordContextMagnetContributionReceipt(db, {
+      callId: "call_1", now: 2, pluginId: "context-magnet", receiptTool: "context_magnet_receipt", threadId: thread.id, turnId: "turn_1",
+    })).toBe(0);
+    appendReceiptOperation(db, {
+      callId: "call_1",
+      sequence: 8,
+      threadId: thread.id,
+      turnId: "turn_1",
+    });
+    expect(recordContextMagnetContributionReceipt(db, {
+      callId: "call_1", now: 3, pluginId: "context-magnet", receiptTool: "context_magnet_receipt", threadId: thread.id, turnId: "turn_1",
+    })).toBe(1);
+    const page = listContextMagnetContributionTracePage(db, { now: 4, threadId: thread.id });
+    expect(page.contributions[0]).toMatchObject({
+      consumption: { state: "consumed" },
+      operation: { kind: "exact", target: { eventSeq: 8, operationId: "call_1", threadId: thread.id } },
+    });
+  });
+
+  it("freezes receipt-derived operation placement at snapshot creation", () => {
+    const { db, thread } = setup();
+    appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id), now: 1, pluginId: "context-magnet", threadId: thread.id,
+    });
+    appendContextMagnetContributionTrace(db, {
+      declaration: declaration(thread.id), now: 2, pluginId: "context-magnet", threadId: thread.id,
+    });
+    appendReceiptOperation(db, { callId: "call_1", sequence: 7, threadId: thread.id, turnId: "turn_1" });
+    const beforeReceipt = listContextMagnetContributionTracePage(db, { limit: 1, now: 3, threadId: thread.id });
+    expect(recordContextMagnetContributionReceipt(db, {
+      callId: "call_1", now: 4, pluginId: "context-magnet", receiptTool: "context_magnet_receipt", threadId: thread.id, turnId: "turn_1",
+    })).toBe(1);
+    const continued = listContextMagnetContributionTracePage(db, {
+      cursor: beforeReceipt.nextCursor ?? undefined, limit: 1, now: 5, threadId: thread.id,
+    });
+    expect([...beforeReceipt.contributions, ...continued.contributions].every((trace) => trace.consumption.state === "not-observed")).toBe(true);
+    const afterReceipt = listContextMagnetContributionTracePage(db, { now: 6, threadId: thread.id });
+    expect(afterReceipt.contributions.find((trace) => trace.consumption.state === "consumed")?.operation).toMatchObject({
+      kind: "exact", target: { eventSeq: 7, operationId: "call_1", threadId: thread.id },
+    });
+  });
+});
