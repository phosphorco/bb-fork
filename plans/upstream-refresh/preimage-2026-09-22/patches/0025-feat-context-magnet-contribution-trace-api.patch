+    sourceSchemaVersion: "v1",
+    unknownFields: {},
+  },
+  inclusionReason: { category: "relevant-thread-fact" },
+  operation: {
+    kind: "unmatched",
+    reason: "target-not-retained",
+    target: null,
+  },
+  outcome: { kind: "delivered" },
+  receiptTool: "context_magnet_receipt",
+  trigger: {
+    factKey: null,
+    locator: "host-fact",
+    renderState: "unrendered",
+  },
+};
+
+describe("Context Magnet contribution trace contract", () => {
+  it("preserves an explicit unmatched attachment and unrendered trigger", () => {
+    expect(contextMagnetContributionTraceDeclarationSchema.parse(declaration)).toMatchObject({
+      operation: { kind: "unmatched" },
+      trigger: { renderState: "unrendered" },
