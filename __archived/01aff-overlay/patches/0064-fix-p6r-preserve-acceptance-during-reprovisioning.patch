Subject: [PATCH] fix(p6r): preserve acceptance during thread reprovisioning

---
 .../services/threads/thread-provisioning.ts   |  5 ++
 .../src/services/threads/thread-send.ts       |  1 +
 .../services/threads/thread-turn-dispatch.ts  |  5 ++
 .../p6r/external-contribution.test.ts         | 74 +++++++++++++++++++
 .../test/threads/thread-turn-dispatch.test.ts | 34 +++++++++
 5 files changed, 119 insertions(+)

diff --git a/apps/server/src/services/threads/thread-provisioning.ts b/apps/server/src/services/threads/thread-provisioning.ts
index fd53601de82888092183fdeb0908cd5f00764a97..936911de8e659b2294e36e1ac6763617c7ecd689 100644
--- a/apps/server/src/services/threads/thread-provisioning.ts
+++ b/apps/server/src/services/threads/thread-provisioning.ts
@@ -1,3 +1,4 @@
+import type { SendThreadMessageTransactionCommit } from "./thread-send.js";
 import {
   getLatestThreadSequence,
   getNonDestroyedHostByLaunchKey,
@@ -88,6 +89,7 @@ interface RequestThreadTargetReprovisionArgs {
   p6rAuthors?: P6rMessageAuthors;
   p6rEditors?: P6rMessageEditors;
   p6rMentionedTargets?: P6rMentionTarget[];
+  afterRequestAppendInTransaction?: SendThreadMessageTransactionCommit;
   beforeRequestAppendInTransaction?: (args: { tx: DbTransaction }) => void;
   environment: EnvironmentRow;
   execution: ResolvedThreadExecutionOptions;
@@ -562,6 +564,9 @@ function appendReprovisionTurnRequest(
           requestSequence: request.sequence,
         },
       );
+      args.afterRequestAppendInTransaction?.({
+        inputGroups: args.inputGroups ?? [args.input], request, tx,
+      });
       return request;
     },
     { behavior: "immediate" },
diff --git a/apps/server/src/services/threads/thread-send.ts b/apps/server/src/services/threads/thread-send.ts
index c2c51c90cf060d4822b9714da6f06239922dbdd9..5097979d171d9849d9348f7de2eb1d09a8b30453 100644
--- a/apps/server/src/services/threads/thread-send.ts
+++ b/apps/server/src/services/threads/thread-send.ts
@@ -656,6 +656,7 @@ async function sendThreadMessageWithoutContextClear(
       p6rEditors,
       p6rMentionedTargets,
       beforeRequestAppendInTransaction: beforeAppendInTransaction,
+      afterRequestAppendInTransaction: afterAppendInTransaction,
       deps,
