diff --git a/apps/server/src/services/threads/thread-turn-dispatch.ts b/apps/server/src/services/threads/thread-turn-dispatch.ts
index 469f69290eeaf7b75b72d1fdd3e696da0ed4b191..c4390186e71519d387fa7290dee1fe2ad2ac5126 100644
--- a/apps/server/src/services/threads/thread-turn-dispatch.ts
+++ b/apps/server/src/services/threads/thread-turn-dispatch.ts
@@ -1,3 +1,4 @@
+import type { SendThreadMessageTransactionCommit } from "./thread-send.js";
 import type { P6rMentionTarget } from "@bb/domain";
 import type {
   P6rMessageAuthors,
@@ -34,6 +35,7 @@ interface DispatchTurnDuringReprovisionArgs {
   p6rAuthors?: P6rMessageAuthors;
   p6rEditors?: P6rMessageEditors;
   p6rMentionedTargets?: P6rMentionTarget[];
+  afterRequestAppendInTransaction?: SendThreadMessageTransactionCommit;
   beforeRequestAppendInTransaction?: (args: { tx: DbTransaction }) => void;
   deps: LoggedPendingInteractionWorkSessionDeps;
   environment: EnvironmentRow;
@@ -88,6 +90,9 @@ export async function dispatchTurnDuringReprovision(
           throwEnvironmentNotReady(args.environment);
         }
       },
+      p6rAuthors: args.p6rAuthors,
+      p6rEditors: args.p6rEditors,
+      afterRequestAppendInTransaction: args.afterRequestAppendInTransaction,
       p6rMentionedTargets: args.p6rMentionedTargets,
