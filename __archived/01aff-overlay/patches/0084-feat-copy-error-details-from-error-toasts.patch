@@ -12,10 +13,26 @@ const NETWORK_TRANSPORT_ERROR_MESSAGE =
 const GENERIC_REQUEST_FAILED_MESSAGE = "Request failed";
 const TRAILING_PERIOD_PATTERN = /\.$/u;
 
+export type MutationErrorDetailValue = string | number | boolean | null;
+export type MutationErrorDetails = Readonly<
+  Record<string, MutationErrorDetailValue>
+>;
+
 interface MutationErrorMessageOptions {
   error: unknown;
   fallbackMessage: string;
   lifecycleOperation?: LifecycleErrorOperation | undefined;
+  details?: MutationErrorDetails | undefined;
+}
+
+interface FormatMutationErrorDetailsArgs {
+  capturedAt: number;
+  description: string | null;
+  details?: MutationErrorDetails | undefined;
+  error: unknown;
+  lifecycleOperation?: LifecycleErrorOperation | undefined;
+  pageUrl: string | null;
+  title: string;
 }
 
 interface MutationErrorMeta {
@@ -144,10 +161,71 @@ export function shouldShowMutationErrorToast(error: unknown): boolean {
   return !isAbortLikeError(error);
 }
 
+export function formatMutationErrorDetails({
+  capturedAt,
+  description,
+  details,
+  error,
+  lifecycleOperation,
+  pageUrl,
+  title,
+}: FormatMutationErrorDetailsArgs): string {
+  const httpError = asHttpError(error);
+  const record = toRecord(error);
+  return JSON.stringify(
+    {
+      kind: "bb-error-details",
+      version: 1,
+      capturedAt: new Date(capturedAt).toISOString(),
+      title,
+      description,
+      operation: lifecycleOperation ?? null,
+      context: details ?? {},
+      error:
+        httpError === null
+          ? {
+              type: typeof record?.name === "string" ? record.name : null,
+              message: extractErrorMessage(error),
+            }
+          : {
+              type: httpError.name,
+              httpStatus: httpError.status,
+              code: httpError.code ?? toRecord(httpError.body)?.code ?? null,
+              message: httpError.message,
+              body: httpError.body ?? null,
+            },
+      pageUrl,
+    },
+    null,
+    2,
+  );
+}
+
+function errorDetailsToastOptions(
+  args: Omit<FormatMutationErrorDetailsArgs, "capturedAt" | "pageUrl">,
+): AppToastOptions {
+  const capturedAt = Date.now();
+  const pageUrl = typeof window === "undefined" ? null : window.location.href;
+  return {
+    ...(args.description === null ? {} : { description: args.description }),
+    action: {
+      label: "Copy details",
+      onClick: (event) => {
+        event.preventDefault();
+        void copyToClipboardWithToast(
+          formatMutationErrorDetails({ ...args, capturedAt, pageUrl }),
+          { successMessage: "Error details copied" },
+        );
+      },
+    },
+  };
+}
+
 export function showMutationErrorToast({
   error,
   fallbackMessage,
   lifecycleOperation,
+  details,
 }: MutationErrorMessageOptions): void {
   if (!shouldShowMutationErrorToast(error)) {
     return;
