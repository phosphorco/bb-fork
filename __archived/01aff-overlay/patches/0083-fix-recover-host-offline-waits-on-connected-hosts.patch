+async function runHostOfflineWaitDispatch(
+  deps: QueueDispatchDeps,
+  args: { hostId: string; respectRequeuePacing: boolean },
+): Promise<void> {
+  for (const threadId of listThreadIdsWithHostOfflineQueueWaits(
+    deps.db,
+    args.hostId,
+  )) {
+    for (const row of listQueuedThreadMessagesWaitingOnKind(deps.db, {
+      kind: "host-offline",
+      threadId,
+    })) {
+      await attemptAutomaticQueuedMessage(deps, row, {
+        now: Date.now(),
+        respectRequeuePacing: args.respectRequeuePacing,
+        retryingFailure: false,
+      });
+    }
+  }
+}
+
+async function runConnectedHostOfflineWaitRecovery(
+  deps: QueueDispatchDeps,
+): Promise<void> {
+  for (const hostId of deps.hub.listConnectedHostIds()) {
+    if (isMachineWaitingForExecution(deps, hostId)) continue;
+    await runHostOfflineWaitDispatch(deps, {
+      hostId,
+      respectRequeuePacing: true,
+    });
+  }
+}
+
+function queuedMessageAttemptLogFields(
+  deps: QueueDispatchDeps,
+  row: QueuedMessageDispatchRef,
+  thread: { environmentId: string | null },
+): Record<string, boolean | number | string | null> {
+  const current = getQueuedThreadMessage(deps.db, row.id);
+  const { host } = dispatchEnvironmentAndHost(deps, thread.environmentId);
+  return {
+    hostConnected: host === null ? null : deps.hub.hasDaemonForHost(host.id),
+    hostId: host?.id ?? null,
+    rowFailureCount: current?.failureCount ?? null,
+    rowNextAttemptAt: current?.nextAttemptAt ?? null,
+    rowState: current?.state ?? "removed",
+    rowWaitingOn: current?.waitingOn ?? null,
+  };
+}
