+        runtime.dispose();
+      }
+    });
+  });
+  it("refuses an inactive recovery owner's continuation transaction and leaves preparation pending", async () => {
+    await withTestHarness(async (harness) => {
+      const { thread, args } = setup(harness),
+        service = getMessageAdmissionService(harness.db),
