index 0000000000000000000000000000000000000000..594be83d83810689ca91f7d08a261383eea4930c
--- /dev/null
+++ b/apps/server/src/services/threads/message-originals.ts
@@ -0,0 +1,313 @@
+import {
+  canonicalJson,
+  JsonSchema,
+} from "@phosphorco/bb-message-admission/protocol";
+import type { MessageOriginalManifest, ThreadTurnInitiator } from "@bb/domain";
+import {
+  flattenPromptInputGroups,
+  clientTurnRequestIdSchema,
+  turnRequestEventDataSchema,
+  type TurnRequestEventData,
+  messageOriginalManifestSchema,
+} from "@bb/domain";
+import {
+  listStoredClientTurnRequestRowsByKeys,
+  AdmissionConflict,
+  listStoredTurnInputAcceptedRowsByClientRequestIds,
+  getStoredProviderSession,
+  getThread,
+  getEnvironment,
+  type DbConnection,
+  type DbQueryConnection,
+  type QueuedThreadMessageRow,
+} from "@bb/db";
+import { type ClientTurnRequestId, type PromptInput } from "@bb/domain";
+import { z } from "zod";
+import type { P6rPromptContext } from "@get-bb/plugin-sdk";
+import { withP6rNativeAuthorContext } from "../p6r/native-authorship.js";
+import { formatAgentThreadInput } from "./thread-send.js";
+
+export const nativeAcceptedContinuationSchema = z.object({
+  kind: z.literal("accepted-continuation"),
+  sourceRequestId: clientTurnRequestIdSchema,
+  acceptedRequestId: clientTurnRequestIdSchema,
+  providerThreadId: z.string().min(1),
+});
+export type NativeAcceptedContinuation = z.infer<
+  typeof nativeAcceptedContinuationSchema
+>;
+export function nativeAcceptedContinuationInput(): PromptInput[] {
+  return [
+    {
+      type: "text",
+      text: "Please continue.",
+      mentions: [],
+      visibility: "agent-only",
+    },
+  ];
+}
+export function assertNativeAcceptedContinuationInput(
+  input: PromptInput[],
+  groups?: PromptInput[][],
+): void {
+  const expected = canonicalJson(
+    JsonSchema.parse(nativeAcceptedContinuationInput()),
+    16384,
+  );
+  if (
+    canonicalJson(JsonSchema.parse(input), 16384) !== expected ||
+    (groups !== undefined &&
+      (groups.length !== 1 ||
+        canonicalJson(JsonSchema.parse(groups[0]), 16384) !== expected))
+  )
+    throw new AdmissionConflict(
+      "continuation-input-conflict",
+      "Accepted continuation authority permits only its exact native control input, never new authored content",
+    );
+}
+export function nativeAcceptedContinuationFromParams(
+  params: unknown,
+): NativeAcceptedContinuation | undefined {
+  const fields = z.record(z.string(), z.unknown()).parse(params);
+  return Object.prototype.hasOwnProperty.call(
+    fields,
+    "nativeAcceptedContinuation",
+  )
+    ? nativeAcceptedContinuationSchema.parse(fields.nativeAcceptedContinuation)
+    : undefined;
+}
+export function readNativeTurnRequest(
+  db: DbQueryConnection,
+  threadId: string,
+  requestId: ClientTurnRequestId,
+): { request: TurnRequestEventData; requestSequence: number } | null {
+  const row = listStoredClientTurnRequestRowsByKeys(db, {
+    keys: [{ threadId, requestId }],
+  })[0];
+  return row
+    ? {
+        request: turnRequestEventDataSchema.parse(JSON.parse(row.data)),
+        requestSequence: row.sequence,
+      }
+    : null;
+}
+export function readNativeAcceptedContinuationForRequest(
+  db: DbQueryConnection,
+  threadId: string,
+  requestId: ClientTurnRequestId,
+): NativeAcceptedContinuation | undefined {
+  const row = readNativeTurnRequest(db, threadId, requestId);
+  return row
+    ? nativeAcceptedContinuationFromParams(row.request.request.params)
+    : undefined;
+}
+export function acceptedContinuationOriginalManifest(
+  db: DbConnection,
+  args: {
+    threadId: string;
+    continuation: NativeAcceptedContinuation;
+    retryOf?: { requestId: ClientTurnRequestId; attempt: number };
+  },
+): MessageOriginalManifest {
+  const marker = nativeAcceptedContinuationSchema.parse(args.continuation);
+  const accepted = readNativeTurnRequest(
+      db,
+      args.threadId,
+      marker.acceptedRequestId,
+    ),
+    source = readNativeTurnRequest(db, args.threadId, marker.sourceRequestId);
+  if (!accepted || !source)
+    throw new AdmissionConflict(
+      "continuation-source-missing",
+      "Accepted continuation lost its exact immutable source request; preserve the retry and reconcile history",
+    );
+  const sourceMarker = nativeAcceptedContinuationFromParams(
+    source.request.request.params,
+  );
+  const acceptedMarker = nativeAcceptedContinuationFromParams(
+    accepted.request.request.params,
+  );
+  const base = (request: TurnRequestEventData) =>
+    request.retryOfRequestId ?? request.requestId;
+  if (
+    acceptedMarker ||
+    (sourceMarker
+      ? sourceMarker.acceptedRequestId !== marker.acceptedRequestId ||
+        sourceMarker.providerThreadId !== marker.providerThreadId
+      : source.request.requestId !== marker.acceptedRequestId) ||
+    base(source.request) !== base(accepted.request) ||
+    (args.retryOf &&
+      (args.retryOf.requestId !== base(source.request) ||
+        args.retryOf.attempt !== (source.request.retryAttempt ?? 1) + 1))
+  )
+    throw new AdmissionConflict(
+      "continuation-source-conflict",
+      "Continuation does not match its exact accepted content request and retry chain",
+    );
+  const acceptedRows = listStoredTurnInputAcceptedRowsByClientRequestIds(db, {
+    threadId: args.threadId,
+    afterSequence: accepted.requestSequence,
+    clientRequestIds: [marker.acceptedRequestId],
+  });
+  if (acceptedRows.length === 0)
+    throw new AdmissionConflict(
+      "continuation-not-provider-accepted",
+      "Continuation requires native provider-input acceptance evidence for its exact content request",
+    );
+  const session = getStoredProviderSession(db, args.threadId),
+    thread = getThread(db, args.threadId),
+    environment = thread?.environmentId
+      ? getEnvironment(db, thread.environmentId)
+      : null;
+  if (
+    session.kind !== "owned" ||
+    session.providerThreadId !== marker.providerThreadId ||
+    !acceptedRows.some(
+      (row) => row.providerThreadId === marker.providerThreadId,
+    ) ||
+    acceptedRows.some(
+      (row) =>
+        row.providerThreadId !== null &&
+        row.providerThreadId !== marker.providerThreadId,
+    )
+  )
+    throw new AdmissionConflict(
+      "continuation-provider-session",
+      "The accepted conversation is no longer the same native provider session; do not send a continuation into a replacement conversation",
+    );
+  if (!environment || environment.status !== "ready")
+    throw new AdmissionConflict(
+      "continuation-environment",
+      "Restore the existing accepted provider conversation before retrying its continuation; a new empty provider conversation is not equivalent",
+    );
+  const manifest = accepted.request.originalManifest;
+  if (
+    !manifest ||
+    manifest.some((original) => original.admissionRef === undefined)
+  )
+    throw new AdmissionConflict(
+      "continuation-originals-missing",
+      "Continuation requires complete canonical original references; legacy input cannot acquire new approval",
+    );
+  return messageOriginalManifestSchema.parse(manifest);
+}
+
+export function queuedMessageOriginalManifest(
+  rows: readonly Pick<QueuedThreadMessageRow, "originalManifest">[],
+): MessageOriginalManifest | undefined {
+  if (rows.length === 0 || rows.some((row) => row.originalManifest === null))
+    return undefined;
+  return messageOriginalManifestSchema.parse(
+    rows.flatMap((row) =>
+      row.originalManifest === null
+        ? []
+        : messageOriginalManifestSchema.parse(JSON.parse(row.originalManifest)),
+    ),
+  );
+}
+
+export function messageOriginalSourceSummary(
+  manifest: MessageOriginalManifest,
+): {
+  source: "spawn" | "tell";
+  initiator: ThreadTurnInitiator;
+  senderThreadId: string | null;
+  senderThreadIds: string[];
+  hasHumanInput: boolean;
+  permissionEscalation: "ask" | "deny";
+} {
+  const originals = messageOriginalManifestSchema.parse(manifest);
+  const senderThreadIds = [
+    ...new Set(
+      originals.flatMap((original) =>
+        original.source.senderThreadId === null
+          ? []
+          : [original.source.senderThreadId],
+      ),
+    ),
+  ];
+  const hasHumanInput = originals.some(
+    (original) => original.source.initiator === "user",
+  );
+  const allHuman = originals.every(
+    (original) => original.source.initiator === "user",
+  );
+  const allSystem = originals.every(
+    (original) => original.source.initiator === "system",
+  );
+  return {
+    source: originals.every((original) => original.source.source === "spawn")
+      ? "spawn"
+      : "tell",
+    initiator: allHuman ? "user" : allSystem ? "system" : "agent",
+    senderThreadId: originals.every(
+      (original) =>
+        original.source.senderThreadId === originals[0]!.source.senderThreadId,
+    )
+      ? originals[0]!.source.senderThreadId
+      : null,
+    senderThreadIds,
+    hasHumanInput,
+    permissionEscalation:
+      allHuman && originals.every((original) => original.canAsk !== false)
+        ? "ask"
+        : "deny",
+  };
+}
+
+export function readMessageOriginalManifestForRequest(
+  db: DbQueryConnection,
+  threadId: string,
+  requestId: ClientTurnRequestId,
+): MessageOriginalManifest | undefined {
+  const row = listStoredClientTurnRequestRowsByKeys(db, {
+    keys: [{ threadId, requestId }],
+  })[0];
+  return row === undefined
+    ? undefined
+    : z
+        .object({ originalManifest: messageOriginalManifestSchema.optional() })
+        .parse(JSON.parse(row.data)).originalManifest;
+}
+
+export function normalizeMessageOriginals(
+  manifest: MessageOriginalManifest,
+  options: {
+    inputGroups?: PromptInput[][];
+    context?: P6rPromptContext;
+  } = {},
+) {
+  const originalManifest = messageOriginalManifestSchema.parse(manifest);
+  if (
+    options.inputGroups !== undefined &&
+    options.inputGroups.length !== originalManifest.length
+  )
+    throw new Error(
+      "Prepared input group count does not match original manifest",
+    );
+  const inputGroups = originalManifest.map((original, index) => {
+    const sourceInput = options.inputGroups?.[index] ?? original.rawInput;
+    if (original.source.rendering === "producer") return sourceInput;
+    const input =
+      original.source.senderThreadId === null
+        ? sourceInput
+        : formatAgentThreadInput({
+            input: sourceInput,
+            senderThreadId: original.source.senderThreadId,
+            context: options.context,
+          });
+    return withP6rNativeAuthorContext(
+      input,
+      [original.author],
+      [original.editor],
+    ).input;
+  });
+  return {
+    originalManifest,
+    inputGroups,
+    input: flattenPromptInputGroups(inputGroups),
+    p6rAuthors: originalManifest.map((original) => original.author),
+    p6rEditors: originalManifest.map((original) => original.editor),
+    ...messageOriginalSourceSummary(originalManifest),
+  };
+}
