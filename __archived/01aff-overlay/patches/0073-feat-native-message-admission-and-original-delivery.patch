+import {
+  getAdmissionThreadCreate,
+  reserveAdmissionThreadCreate,
+  transitionAdmissionThreadCreate,
+} from "../../src/data/message-admission.js";
+
+const databases: DbConnection[] = [];
+afterEach(() => {
+  for (const db of databases.splice(0)) db.$client.close();
+});
+function fixture() {
+  const db = createMigratedConnection();
+  databases.push(db);
+  const host = upsertHost(db, noopNotifier, { name: "create-reservation" });
+  const { project } = createProject(db, noopNotifier, {
+    name: "create-reservation",
+    source: {
+      type: "local_path",
+      hostId: host.id,
+      path: "/tmp/create-reservation",
+    },
+  });
+  const input = {
+    namespace: "native-thread-create",
+    operationId: "create-1",
+    fingerprint: "immutable-authored-input",
+    input: JSON.stringify({ text: "initial", source: "native" }),
+    threadId: "thr_reserved1",
+    nativeOperation: {
+      namespace: "native:thr_reserved1",
+      operationId: "create-1",
+    },
+    ownerToken: "owner-1",
+  };
+  return { db, project, input };
+}
+
+describe("durable first-thread create reservation", () => {
+  it("concurrent same keys retain one frozen request/thread/native operation and conflict on changed authored input", async () => {
+    const { db, input } = fixture();
+    const [first, second] = await Promise.all([
+      Promise.resolve().then(() => reserveAdmissionThreadCreate(db, input)),
+      Promise.resolve().then(() =>
+        reserveAdmissionThreadCreate(db, {
+          ...input,
+          input: "changed-mutable-defaults",
+          threadId: "thr_losing",
+          nativeOperation: {
+            namespace: "native:thr_losing",
+            operationId: "losing",
+          },
+          ownerToken: "owner-2",
+        }),
+      ),
+    ]);
+    expect([first.created, second.created]).toEqual([true, false]);
+    expect(second.operation).toEqual(first.operation);
+    expect(second.operation).toMatchObject({
+      threadId: input.threadId,
+      input: input.input,
+      nativeNamespace: input.nativeOperation.namespace,
+      nativeOperationId: input.nativeOperation.operationId,
+      ownerToken: input.ownerToken,
+    });
+    expect(() =>
+      reserveAdmissionThreadCreate(db, { ...input, fingerprint: "edited" }),
+    ).toThrow("different immutable authored input");
+    expect(db.select().from(threads).all()).toHaveLength(0);
+  });
+
+  it("reservation rollback leaves no row and explicit reserved thread creation plus acknowledgement are atomic and immutable", () => {
+    const { db, input, project } = fixture();
+    expect(() =>
+      db.transaction(() => {
+        reserveAdmissionThreadCreate(db, input);
+        throw new Error("reservation rollback");
+      }),
+    ).toThrow("reservation rollback");
+    expect(
+      getAdmissionThreadCreate(db, input.namespace, input.operationId),
+    ).toBeNull();
+    reserveAdmissionThreadCreate(db, input);
+    const identity = {
+      namespace: input.namespace,
+      operationId: input.operationId,
+      ownerToken: input.ownerToken,
+    };
+    db.transaction((tx) =>
+      transitionAdmissionThreadCreate(tx, {
+        ...identity,
+        expectedState: "reserved",
+        nextState: "running",
+      }),
+    );
+    const response = JSON.stringify({
+      thread: { id: input.threadId, title: "Initial title" },
+    });
+    expect(() =>
+      db.transaction((tx) => {
+        createThread(db, noopNotifier, {
+          id: input.threadId,
+          projectId: project.id,
+          providerId: "codex",
+          title: "Initial title",
+        });
+        transitionAdmissionThreadCreate(tx, {
+          ...identity,
+          expectedState: "running",
+          nextState: "acknowledged",
+          response,
+        });
+        throw new Error("whole acceptance rollback");
+      }),
+    ).toThrow("whole acceptance rollback");
+    expect(db.select().from(threads).all()).toHaveLength(0);
+    expect(
+      getAdmissionThreadCreate(db, input.namespace, input.operationId),
+    ).toMatchObject({ state: "running", response: null });
+    db.transaction((tx) => {
+      const created = createThread(db, noopNotifier, {
+        id: input.threadId,
+        projectId: project.id,
+        providerId: "codex",
+        title: "Initial title",
+      });
+      expect(created.id).toBe(input.threadId);
+      transitionAdmissionThreadCreate(tx, {
+        ...identity,
+        expectedState: "running",
+        nextState: "acknowledged",
+        response,
+      });
+    });
+    db.update(threads)
+      .set({ title: "Later title" })
+      .where(eq(threads.id, input.threadId))
+      .run();
+    const reopened = createConnection(db.$client.serialize());
+    databases.push(reopened);
+    expect(
+      getAdmissionThreadCreate(reopened, input.namespace, input.operationId)
+        ?.response,
+    ).toBe(response);
+    expect(() =>
+      reopened.transaction((tx) =>
+        transitionAdmissionThreadCreate(tx, {
+          ...identity,
+          expectedState: "acknowledged",
+          nextState: "acknowledged",
+          response: JSON.stringify({ title: "Later title" }),
+        }),
+      ),
+    ).toThrow("acknowledgement is immutable");
+    expect(() =>
+      reopened.transaction((tx) =>
+        transitionAdmissionThreadCreate(tx, {
+          ...identity,
+          expectedState: "acknowledged",
+          nextState: "acknowledged",
+          error: JSON.stringify({ invented: "later error" }),
+        }),
+      ),
+    ).toThrow("failure is immutable");
+    expect(reopened.select().from(threads).all()).toHaveLength(1);
+  });
+
+  it("wrong owner/state cannot claim or restart running or unknown work after reopen", () => {
+    const { db, input } = fixture();
+    reserveAdmissionThreadCreate(db, input);
+    const identity = {
+      namespace: input.namespace,
+      operationId: input.operationId,
+      ownerToken: input.ownerToken,
+    };
+    expect(() =>
+      db.transaction((tx) =>
+        transitionAdmissionThreadCreate(tx, {
+          ...identity,
+          ownerToken: "loser",
+          expectedState: "reserved",
+          nextState: "running",
+        }),
+      ),
+    ).toThrow("ownership or state changed");
+    db.transaction((tx) =>
+      transitionAdmissionThreadCreate(tx, {
+        ...identity,
+        expectedState: "reserved",
+        nextState: "running",
+      }),
+    );
+    expect(() =>
+      db.transaction((tx) =>
+        transitionAdmissionThreadCreate(tx, {
+          ...identity,
+          expectedState: "reserved",
+          nextState: "running",
+        }),
+      ),
+    ).toThrow("ownership or state changed");
+    const reopened = createConnection(db.$client.serialize());
+    databases.push(reopened);
+    expect(
+      reserveAdmissionThreadCreate(reopened, {
+        ...input,
+        ownerToken: "new-process",
+        threadId: "thr_duplicate",
+      }),
+    ).toMatchObject({
+      created: false,
+      operation: {
+        state: "running",
+        threadId: input.threadId,
+        ownerToken: input.ownerToken,
+      },
+    });
+    reopened.transaction((tx) =>
+      transitionAdmissionThreadCreate(tx, {
+        ...identity,
+        expectedState: "running",
+        nextState: "unresolved",
+        error: JSON.stringify({ reason: "Effect may have happened" }),
+      }),
+    );
+    expect(() =>
+      reopened.transaction((tx) =>
+        transitionAdmissionThreadCreate(tx, {
+          ...identity,
+          expectedState: "unresolved",
+          nextState: "running",
+        }),
+      ),
+    ).toThrow("cannot replay");
+    expect(
+      getAdmissionThreadCreate(reopened, input.namespace, input.operationId)
+        ?.state,
+    ).toBe("unresolved");
+    expect(reopened.select().from(threads).all()).toHaveLength(0);
+  });
+});
