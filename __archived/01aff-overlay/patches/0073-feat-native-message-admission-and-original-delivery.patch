@@ -0,0 +1,121 @@
+import { describe, expect, it, vi } from "vitest";
+import type { ComposerSubmitOptions } from "../app-contract.js";
+import {
+  createComposerHandleBinding,
+  type ComposerEditorState,
+  type ComposerHandleTarget,
+} from "./composer-handle.js";
+
+function fixture() {
+  let state: ComposerEditorState = {
+    layout: "expanded",
+    isRunning: false,
+    isSubmitting: false,
+    isSubmittingBlocked: true,
+    submittingBlockedReason: "Uploading",
+    isAttaching: true,
+    attachmentError: null,
+  };
+  const listeners = new Set<() => void>();
+  const submit = vi.fn<NonNullable<ComposerHandleTarget["submit"]>>(
+    async () => {},
+  );
+  const target: ComposerHandleTarget = {
+    key: "correlated-composer",
+    scope: { kind: "thread", threadId: "thr_known" },
+    getDraft: () => ({ text: "Authored input", mentions: [], attachments: [] }),
+    getAttachmentCount: () => 1,
+    getSelection: () => null,
+    setDraft: () => {},
+    addQuote: () => {},
+    getEditorState: () => state,
+    subscribeEditorState: (listener) => {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+    insertAtCursor: () => true,
+    isAvailable: () => true,
+    focus: () => {},
+    submit,
+  };
+  const binding = createComposerHandleBinding("plugin:composer", {
+    pluginId: "actual-owner",
+    target,
+    mentionText: (mention) => mention.label,
+    setTextEffect: () => {},
+    setInputLock: () => {},
+    onSubmitted: () => () => {},
+  });
+  const finishUploads = () => {
+    state = {
+      ...state,
+      isAttaching: false,
+      isSubmittingBlocked: false,
+      submittingBlockedReason: null,
+    };
+    for (const listener of [...listeners]) listener();
+  };
+  return { handle: binding.handle, submit, finishUploads, listeners };
+}
+
+describe("native operation correlation through shared composer handle", () => {
+  it.each(["plugin-data", "scheduled"] as const)(
+    "retains chosen ID and native plugin ownership across uploads on the %s arm",
+    async (arm) => {
+      const f = fixture();
+      const originalData = {
+        attemptId: "attempt-1",
+        pluginId: "opaque-payload-owner",
+      };
+      const options: ComposerSubmitOptions =
+        arm === "plugin-data"
+          ? {
+              experimental_data: originalData,
+              operationId: "feature:attempt-1",
+            }
+          : { sendAt: Date.now() + 60000, operationId: "feature:attempt-1" };
+      const before = { ...options };
+      const pending = f.handle.submit(options);
+      expect(f.submit).not.toHaveBeenCalled();
+      options.operationId = "changed-while-uploading";
+      if (arm === "plugin-data")
+        options.experimental_data = { attemptId: "different-attempt" };
+      f.finishUploads();
+      await pending;
+      expect(f.submit).toHaveBeenCalledExactlyOnceWith(
+        before,
+        arm === "plugin-data"
+          ? { pluginId: "actual-owner", data: originalData }
+          : undefined,
+      );
+      expect(f.listeners.size).toBe(0);
+    },
+  );
+
+  it.each(["", "   ", "x".repeat(201)])(
+    "refuses invalid operation ID before waiting for uploads",
+    async (operationId) => {
+      const f = fixture();
+      await expect(
+        f.handle.submit({ operationId, experimental_data: {} }),
+      ).rejects.toThrow(
+        "Operation ID must be nonblank and at most 200 characters",
+      );
+      expect(f.listeners.size).toBe(0);
+      expect(f.submit).not.toHaveBeenCalled();
+    },
+  );
+
+  it("preserves an exact 200-character ID and leaves omission to the native host", async () => {
+    const f = fixture();
+    f.finishUploads();
+    const operationId = "x".repeat(200);
+    await f.handle.submit({ operationId, experimental_data: {} });
+    await f.handle.submit({ experimental_data: {} });
+    expect(f.submit.mock.calls.map(([options]) => options.operationId)).toEqual(
+      [operationId, undefined],
+    );
+  });
+});
