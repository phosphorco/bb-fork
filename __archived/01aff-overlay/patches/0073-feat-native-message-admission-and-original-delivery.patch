+          PublishInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        const snapshot: unknown = JSON.parse(input.snapshotBytes);
+        if (
+          canonicalJson(snapshot, MESSAGE_ADMISSION_LIMITS.snapshotBytes) !==
+          input.snapshotBytes
+        )
+          throw new AdmissionConflict(
+            "publication-not-canonical",
+            "Snapshot bytes must contain canonical JSON",
+          );
+        const {
+          operation: _operation,
+          expectedActivePublication: _expected,
+          ...body
+        } = input;
+        const hash = await publicationFingerprint(
+          body,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        assertLive();
+        try {
+          if (
+            input.expectedActivePublication !== null &&
+            input.expectedActivePublication.providerId !== input.providerId
+          )
+            throw new AdmissionConflict(
+              "publication-pointer-conflict",
+              "Expected publication belongs to another provider",
+            );
+          const publication = publishAdmissionPolicy(this.db, {
+            pluginId,
+            providerId: input.providerId,
+            operationNamespace: input.operation.namespace,
+            operationId: input.operation.operationId,
+            fingerprint: admissionDigest(
+              canonicalJson(input, MESSAGE_ADMISSION_LIMITS.requestBytes),
+            ),
+            publicationFingerprint: hash,
+            snapshot: input.snapshotBytes,
+            evaluatorVersion: input.evaluatorVersion,
+            configurationVersion: input.configurationVersion,
+            enrollment: canonicalJson(
+              input.enrollment,
+              MESSAGE_ADMISSION_LIMITS.requestBytes,
+            ),
+            projectIds:
+              input.enrollment.mode === "enforce"
+                ? input.enrollment.projectIds
+                : [],
+            expectedPublicationId:
+              input.expectedActivePublication?.publicationId ?? null,
+            expectedPublicationFingerprint:
+              input.expectedActivePublication?.fingerprint ?? null,
+          });
+          const currentRegistration = this.registrations.get(pluginId);
+          if (
+            currentRegistration &&
+            currentRegistration === staged &&
+            currentRegistration.registration.evaluatorVersion ===
+              publication.evaluatorVersion
+          )
+            if (
+              getActiveAdmissionPublication(this.db, publication.providerId)
+                ?.id === publication.id
+            )
+              currentRegistration.boundPublications.set(
+                publication.providerId,
+                publication.id,
+              );
+          return {
+            version: 1,
+            status: "published",
+            operation: input.operation,
+            publication: publicationDto(publication),
+            activePublication: publicationDto(
+              getActiveAdmissionPublication(this.db, input.providerId)!,
+            ).publication,
+            reasons: [],
+          };
+        } catch (error) {
+          if (!(error instanceof AdmissionConflict)) throw error;
+          const current = getActiveAdmissionPublication(
+            this.db,
+            input.providerId,
+          );
+          return {
+            version: 1,
+            status: "conflict",
+            operation: input.operation,
+            publication: null,
+            activePublication:
+              current === null ? null : publicationDto(current).publication,
+            reasons: [{ code: error.code, message: error.message }],
+          };
+        }
+      },
+      readActivePublication: (raw) => {
+        assertLive();
+        const input = decodeBounded(
+          ReadActivePublicationInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        const row = getActiveAdmissionPublication(this.db, input.providerId);
+        return row === null ? null : publicationDto(row);
+      },
+      lookupOperation: (raw) => {
+        assertLive();
+        const input = decodeBounded(
+          LookupOperationInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        const operation = getAdmissionOperation(
+          this.db,
+          input.operation.namespace,
+          input.operation.operationId,
+        );
+        if (operation)
+          return {
+            version: 1,
+            status: "found",
+            record: this.operationRecord(operation),
+          };
+        const publication = findAdmissionPublicationOperation(
+          this.db,
+          pluginId,
+          input.operation.namespace,
+          input.operation.operationId,
+        );
+        return publication === null
+          ? { version: 1, status: "missing", record: null }
+          : {
+              version: 1,
+              status: "found",
+              record: {
+                version: 1,
+                operation: input.operation,
+                requestFingerprint: `sha256:${publication.fingerprint}`,
+                kind: "publication",
+                status: "accepted",
+                original: null,
+                assessments: [],
+                acceptedOriginal: null,
+                publication: publicationDto(publication),
+                feedback: null,
+                delivery: {
+                  state: "none",
+                  queueId: null,
+                  requestId: null,
+                  groupIndex: null,
+                  details: null,
+                },
+                reasons: [],
+              },
+            };
+      },
+      recheckOperation: async (raw) => {
+        assertLive();
+        const input = decodeBounded(
+          RecheckOperationInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        const operation = getAdmissionOperation(
+          this.db,
+          input.operation.namespace,
+          input.operation.operationId,
+        );
+        if (!operation) return { version: 1, status: "missing", record: null };
+        const record = this.operationRecord(operation);
+        if (record.requestFingerprint !== input.expectedRequestFingerprint)
+          return {
+            version: 1,
+            status: "found",
+            record: {
+              ...record,
+              status: "conflict",
+              acceptedOriginal: null,
+              delivery: {
+                state: "none",
+                queueId: null,
+                requestId: null,
+                groupIndex: null,
+                details: null,
+              },
+              reasons: [
+                {
+                  code: "operation-fingerprint-conflict",
+                  message:
+                    "Expected fingerprint differs from immutable original",
+                },
+              ],
+            },
+          };
+        const started = beginAdmissionRecheck(this.db, {
+          ...input.operation,
+          recheckId: input.recheckId,
+          fingerprint: canonicalJson(
+            input,
+            MESSAGE_ADMISSION_LIMITS.requestBytes,
+          ),
+        });
+        if (!started || !started.started)
+          return {
+            version: 1,
+            status: "found",
+            record: this.operationRecord(started?.operation ?? operation),
+          };
+        const prepared = await this.evaluate(
+          started.operation,
+          storedInput(started.operation),
+        );
+        return {
+          version: 1,
+          status: "found",
+          record:
+            prepared.kind === "known"
+              ? prepared.operation
+              : this.operationRecord(
+                  getAdmissionOperationById(this.db, operation.id)!,
+                ),
+        };
+      },
+      previewPlacement: (raw) => {
+        assertLive();
+        return previewNativeMessagePlacement(
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+      },
+      readOriginalManifest: (raw) => {
+        assertLive();
+        const input = decodeBounded(
+          ReadOriginalManifestInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        return this.readOriginalManifest(input.threadId, input.requestId);
+      },
+      submitFeedback: async (raw) => {
+        assertLive();
+        const input = decodeBounded(
+          SubmitFeedbackInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        const provider = getActiveAdmissionPublication(
+          this.db,
+          input.providerId,
+        );
+        if (!provider || provider.pluginId !== pluginId)
+          throw new AdmissionConflict(
+            "feedback-provider-conflict",
+            "Plugin does not own this feedback provider",
+          );
+        const row = findAdmissionFeedback(this.db, {
+          pluginId,
+          assessmentId: input.rejectionAssessmentId,
+          originalId: input.original.originalId,
+          revision: input.original.revision,
+        });
+        if (!row)
+          throw new AdmissionConflict(
+            "feedback-missing",
+            "No genuine native final disposition created this obligation",
+          );
+        const record = this.feedbackRecord(row.id)!;
+        if (record.feedback.providerId !== input.providerId)
+          throw new AdmissionConflict(
+            "feedback-provider-conflict",
+            "Obligation belongs to another provider",
+          );
+        if (!this.recovery)
+          throw new AdmissionConflict(
+            "feedback-unsupported",
+            "Native feedback submission is not configured",
+          );
+        await this.recovery.recoverFeedback(row.id);
+        return this.feedbackRecord(row.id)!.feedback;
+      },
+      readThreadActivity: (raw) => {
+        assertLive();
+        const input = decodeBounded(
+          ReadThreadActivityInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        const row = readAdmissionActivity(this.db, input.threadId);
+        if (!row)
+          throw new AdmissionConflict(
+            "thread-missing",
+            "Activity thread does not exist",
+          );
+        return {
+          version: 1,
+          threadId: input.threadId,
+          messageAcceptanceSequence: row.acceptanceSequence,
+          lastVisibleHumanAcceptedAt:
+            row.lastVisibleHumanAcceptedAt === null
+              ? null
+              : new Date(row.lastVisibleHumanAcceptedAt).toISOString(),
+          lastVisibleHumanOriginal:
+            row.lastVisibleHumanOriginalId === null ||
+            row.lastVisibleHumanRevision === null
+              ? null
+              : {
+                  originalId: row.lastVisibleHumanOriginalId,
+                  revision: row.lastVisibleHumanRevision,
+                },
+        };
+      },
+      listAcceptedActivity: (raw) => {
+        assertLive();
+        const input = decodeBounded(
+          ListAcceptedActivityInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        const summary = readAdmissionActivity(this.db, input.threadId);
+        if (!summary)
+          throw new AdmissionConflict(
+            "thread-missing",
+            "Activity thread does not exist",
+          );
+        if (input.afterSequence > summary.acceptanceSequence)
+          throw new AdmissionConflict(
+            "activity-cursor-ahead",
+            "Activity cursor exceeds current native acceptance sequence",
+          );
+        const rows = listAdmissionActivity(
+          this.db,
+          input.threadId,
+          input.afterSequence,
+          input.limit,
+        );
+        const throughSequence =
+          rows.at(-1)?.acceptanceSequence ?? input.afterSequence;
+        return {
+          version: 1,
+          threadId: input.threadId,
+          afterSequence: input.afterSequence,
+          throughSequence,
+          latestSequence: summary.acceptanceSequence,
+          complete: throughSequence === summary.acceptanceSequence,
+          items: rows.map((row) => {
+            const accepted = this.operationRecord(row).acceptedOriginal!;
+            return {
+              acceptanceSequence: accepted.acceptanceSequence,
+              acceptedAt: accepted.acceptedAt,
+              original: accepted.original,
+              source: accepted.source,
+            };
+          }),
+        };
+      },
+    };
+    return {
+      protocol,
+      activate: () => {
+        assertLive();
+        active = true;
+        if (staged) {
+          const old = this.registrations.get(pluginId);
+          if (old) retireRegistration(old);
+          this.registrations.set(pluginId, staged);
+        }
+      },
+      retire: () => {
+        if (retired) return;
+        retired = true;
+        if (staged) retireRegistration(staged);
+      },
+    };
+  }
+}
+
+function nativeEvidenceText(type: string, bytes: string): string {
+  const value: unknown = JSON.parse(bytes);
+  if (typeof value !== "object" || value === null || Array.isArray(value))
+    return "";
+  if (
+    type === "client/turn/requested" &&
+    "input" in value &&
+    Array.isArray(value.input)
+  )
+    return value.input
+      .flatMap((part: unknown) =>
+        typeof part === "object" &&
+        part !== null &&
+        "type" in part &&
+        part.type === "text" &&
+        "text" in part &&
+        typeof part.text === "string"
+          ? [part.text]
+          : [],
+      )
+      .join("\n");
+  if (
+    type === "item/completed" &&
+    "item" in value &&
+    typeof value.item === "object" &&
+    value.item !== null &&
+    "type" in value.item &&
+    value.item.type === "agentMessage" &&
+    "text" in value.item &&
+    typeof value.item.text === "string"
+  )
+    return value.item.text;
+  if (
+    type === "system/manager/user_message" &&
+    "text" in value &&
+    typeof value.text === "string"
+  )
+    return value.text;
+  return "";
+}
+
+const services = new WeakMap<DbConnection, MessageAdmissionService>();
+export function getMessageAdmissionService(
+  db: DbConnection,
+): MessageAdmissionService {
+  let service = services.get(db);
+  if (!service) {
+    service = new MessageAdmissionService(db);
+    services.set(db, service);
+  }
+  return service;
+}
