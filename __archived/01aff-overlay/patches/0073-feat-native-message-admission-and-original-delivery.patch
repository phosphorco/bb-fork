+export interface QueuedThreadMessagePlacementWitness {
+  threadId: string;
+  candidate: QueuePlacementCandidate;
+  orderedRows: string;
+  selection: QueuePlacementSelection;
+}
+
+function normalizeQueuePlacementCandidate(
+  candidate: QueuePlacementCandidate,
+): QueuePlacementCandidate {
+  return {
+    model: candidate.model,
+    reasoningLevel: candidate.reasoningLevel,
+    permissionMode: candidate.permissionMode,
+    serviceTier: candidate.serviceTier,
+    payloadKind: candidate.payloadKind,
+    systemNotice: candidate.systemNotice,
+    scheduledFor: candidate.scheduledFor,
+  };
+}
+
+export function captureQueuedThreadMessagePlacement(
+  db: DbQueryConnection,
+  threadId: string,
+  candidate: QueuePlacementCandidate,
+): QueuedThreadMessagePlacementWitness {
+  const rows = listThreadQueueIncludingClaims(db, threadId);
+  const normalizedCandidate = normalizeQueuePlacementCandidate(candidate);
+  return {
+    threadId,
+    candidate: normalizedCandidate,
+    orderedRows: JSON.stringify(rows),
+    selection: selectQueueBatchPlacement(rows, normalizedCandidate),
+  };
+}
+
+export type CreateQueuedThreadMessageWithPlacementResult =
+  | {
+      kind: "inserted";
+      queuedMessage: QueuedThreadMessageRow;
+      placement: Exclude<QueuePlacementSelection, { kind: "conflict" }>;
+    }
+  | {
+      kind: "conflict";
+      reason:
+        | "stale-witness"
+        | "target-changed"
+        | "divider"
+        | "incompatible"
+        | "corrupt-group"
+        | "capacity";
+    };
+
+export function createQueuedThreadMessageWithPlacementInTransaction(
+  tx: DbTransaction,
+  input: CreateQueuedThreadMessageInput,
+  args: {
+    witness: QueuedThreadMessagePlacementWitness;
+    expectedTargetIds?: readonly string[];
+  },
+): CreateQueuedThreadMessageWithPlacementResult {
+  const candidate: QueuePlacementCandidate = {
+    model: input.model,
+    reasoningLevel: input.reasoningLevel,
+    permissionMode: input.permissionMode,
+    serviceTier: input.serviceTier,
+    payloadKind: input.payload.kind,
+    systemNotice:
+      input.systemNotice === null ? null : JSON.stringify(input.systemNotice),
+    scheduledFor:
+      input.scheduledFor === undefined ? input.sendAt : input.scheduledFor,
+  };
+  const current = captureQueuedThreadMessagePlacement(
+    tx,
+    input.threadId,
+    candidate,
+  );
+  if (
+    args.witness.threadId !== input.threadId ||
+    JSON.stringify(normalizeQueuePlacementCandidate(args.witness.candidate)) !==
+      JSON.stringify(candidate) ||
+    args.witness.orderedRows !== current.orderedRows ||
+    JSON.stringify(args.witness.selection) !== JSON.stringify(current.selection)
+  ) {
+    return { kind: "conflict", reason: "stale-witness" };
+  }
+  const placement = current.selection;
+  if (
+    args.expectedTargetIds !== undefined &&
+    (placement.kind !== "join" ||
+      !stringArraysEqual(args.expectedTargetIds, placement.targetIds))
+  )
+    return { kind: "conflict", reason: "target-changed" };
+  if (placement.kind === "conflict") return placement;
+  const rows = listThreadQueueIncludingClaims(tx, input.threadId);
+  if (placement.kind === "join") {
+    const manifests = rows
+      .filter((row) => placement.targetIds.includes(row.id))
+      .flatMap((row) =>
+        row.originalManifest === null
+          ? []
+          : messageOriginalManifestSchema.parse(
+              JSON.parse(row.originalManifest),
+            ),
+      );
+    if (manifests.length + (input.originalManifest?.length ?? 1) > 256)
+      return { kind: "conflict", reason: "capacity" };
+    if (
+      input.originalManifest &&
+      new Set(
+        [...manifests, ...input.originalManifest].map(
+          (original) => original.originalId,
+        ),
+      ).size !==
+        manifests.length + input.originalManifest.length
+    ) {
+      return { kind: "conflict", reason: "corrupt-group" };
+    }
+  }
+  const created = createQueuedThreadMessageInTransaction(tx, input);
+  if (placement.kind !== "join")
+    return { kind: "inserted", queuedMessage: created, placement };
+  const tail = rows.find((row) => row.id === placement.targetIds.at(-1));
+  if (!tail) throw new Error("Placement target missing in transaction");
+  const next = rows[rows.indexOf(tail) + 1];
+  const sortKey = createOrderKeyBetween({
+    previousKey: tail.sortKey,
+    nextKey: next?.sortKey ?? null,
+  });
+  tx.update(queuedThreadMessages)
+    .set({
+      groupWithNext: true,
+      updatedAt: Math.max(Date.now(), tail.updatedAt + 1),
+    })
+    .where(eq(queuedThreadMessages.id, tail.id))
+    .run();
+  const queuedMessage = tx
+    .update(queuedThreadMessages)
+    .set({ sortKey })
+    .where(eq(queuedThreadMessages.id, created.id))
+    .returning()
+    .get();
+  if (!queuedMessage) throw new Error("Inserted queue original missing");
+  return { kind: "inserted", queuedMessage, placement };
+}
+
+export function createQueuedThreadMessageWithPlacement(
+  db: DbConnection,
+  notifier: DbNotifier,
+  input: CreateQueuedThreadMessageInput,
+  args: {
+    witness: QueuedThreadMessagePlacementWitness;
+    expectedTargetIds?: readonly string[];
+  },
+): CreateQueuedThreadMessageWithPlacementResult {
+  const result = db.transaction(
+    (tx) =>
+      createQueuedThreadMessageWithPlacementInTransaction(tx, input, args),
+    { behavior: "immediate" },
+  );
+  if (result.kind === "inserted")
+    notifier.notifyThread(input.threadId, ["queue-changed"]);
+  return result;
+}
+
+function getExactClaimedGroup(
+  db: DbQueryConnection,
+  claims: readonly ClaimedQueuedThreadMessageMutationArgs[],
+  threadId?: string,
+): ClaimedQueuedThreadMessageRow[] | null {
+  const lead = claims[0];
+  if (
+    !lead ||
+    new Set(claims.map((claim) => claim.id)).size !== claims.length ||
+    claims.some((claim) => claim.claimToken !== lead.claimToken)
+  )
+    return null;
+  const first = getQueuedThreadMessage(db, lead.id);
+  if (!first || (threadId !== undefined && first.threadId !== threadId))
+    return null;
+  const all = listThreadQueueIncludingClaims(db, first.threadId);
+  const group = partitionQueuedMessageGroups(all).find((rows) =>
+    rows.some((row) => row.id === lead.id),
+  );
+  if (
+    !group ||
+    !isValidQueuePlacementGroup(group) ||
+    !stringArraysEqual(
+      group.map((row) => row.id),
+      claims.map((claim) => claim.id),
+    )
+  )
+    return null;
+  const tokenRows = all.filter((row) => row.claimToken === lead.claimToken);
+  if (
+    !stringArraysEqual(
+      tokenRows.map((row) => row.id),
+      claims.map((claim) => claim.id),
+    )
+  )
+    return null;
+  const claimed = group.map(requireClaimedQueuedThreadMessage);
+  if (claimed.some((row) => row === null || row.claimToken !== lead.claimToken))
+    return null;
+  return claimed.filter((row) => row !== null);
+}
