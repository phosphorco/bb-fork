diff --git a/apps/cli/src/__tests__/command-output/thread-correction.test.ts b/apps/cli/src/__tests__/command-output/thread-correction.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eb9014ed561dd2b377957a4f9572e6bc655ecfb5
--- /dev/null
+++ b/apps/cli/src/__tests__/command-output/thread-correction.test.ts
@@ -0,0 +1,166 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  runCommand,
+  setupCommandOutputTestEnvironment,
+  stubServerApi,
+  type CommandRegistrar,
+} from "../helpers/command-output-harness.js";
+import { registerThreadCommands } from "../../commands/thread/index.js";
+
+describe("explicit separate correction command to SDK capture", () => {
+  setupCommandOutputTestEnvironment();
+  const register: CommandRegistrar = (program) =>
+    registerThreadCommands(program, () => "http://server");
+  const operation = {
+    namespace: "native:destination",
+    operationId: "historical-edit",
+  };
+  const original = { originalId: "retained-original", revision: 2 };
+  async function successfulCommand(args: string[]) {
+    try {
+      await runCommand(args, register);
+    } catch (error) {
+      throw new Error(JSON.stringify(vi.mocked(console.error).mock.calls), {
+        cause: error,
+      });
+    }
+  }
+  function retained(preparationState = "failed", threadId = "destination") {
+    return {
+      journalId: "journal-edit",
+      preparationState,
+      record: {
+        status: "accepted",
+        operation,
+        acceptedOriginal: { threadId, original },
+      },
+    };
+  }
+
+  it.each([undefined, "new-correction"])(
+    "reads the exact journal and sends new current content with operation ID %s",
+    async (chosen) => {
+      vi.stubEnv("BB_THREAD_ID", "current-sender");
+      const get = vi.fn(async () => retained());
+      const post = vi.fn(async (_request: { json: unknown }) => ({
+        ok: true,
+        delivery: "sent",
+      }));
+      stubServerApi({
+        "v1.threads.:id.admission-operations.:admissionId.$get": get,
+        "v1.threads.:id.send.$post": post,
+      });
+      await successfulCommand([
+        "thread",
+        "tell",
+        "destination",
+        "new independent correction",
+        "--correction-of",
+        "journal-edit",
+        "--mode",
+        "queue",
+        "--model",
+        "gpt-5.5",
+        "--reasoning-level",
+        "high",
+        "--permission-mode",
+        "accept-edits",
+        "--service-tier",
+        "fast",
+        "--file",
+        "retained-report.pdf",
+        "--json",
+        ...(chosen ? ["--operation-id", chosen] : []),
+      ]);
+      expect(get).toHaveBeenCalledWith({
+        param: { id: "destination", admissionId: "journal-edit" },
+      });
+      expect(post).toHaveBeenCalledWith({
+        param: { id: "destination" },
+        json: {
+          operationId: chosen ?? expect.stringMatching(/^[0-9a-f-]{36}$/),
+          correctionOf: { operation, original },
+          input: [
+            { type: "text", text: "new independent correction", mentions: [] },
+            { type: "localFile", path: "retained-report.pdf" },
+          ],
+          senderThreadId: "current-sender",
+          mode: "queue-if-active",
+          model: "gpt-5.5",
+          reasoningLevel: "high",
+          permissionMode: "accept-edits",
+          serviceTier: "fast",
+        },
+      });
+      expect(
+        JSON.parse(String(vi.mocked(console.log).mock.calls[0]?.[0])),
+      ).toMatchObject({
+        threadId: "destination",
+        delivery: "sent",
+        mode: "queue",
+      });
+    },
+  );
+
+  it("omits a self sender while retaining the correlation", async () => {
+    vi.stubEnv("BB_THREAD_ID", "destination");
+    const post = vi.fn(async (_request: { json: unknown }) => ({
+      ok: true,
+      delivery: "sent",
+    }));
+    stubServerApi({
+      "v1.threads.:id.admission-operations.:admissionId.$get": vi.fn(async () =>
+        retained("cancelled"),
+      ),
+      "v1.threads.:id.send.$post": post,
+    });
+    await successfulCommand([
+      "thread",
+      "tell",
+      "destination",
+      "self correction",
+      "--correction-of",
+      "journal-edit",
+    ]);
+    expect(
+      JSON.parse(JSON.stringify(post.mock.calls[0]?.[0].json)),
+    ).not.toHaveProperty("senderThreadId");
+    expect(post.mock.calls[0]?.[0].json).toMatchObject({
+      correctionOf: { operation, original },
+    });
+  });
+
+  it.each(["reuse", "wrong-thread", "uncertain"])(
+    "refuses %s before sending or uploading",
+    async (refusal) => {
+      const post = vi.fn(async () => ({ ok: true, delivery: "sent" }));
+      stubServerApi({
+        "v1.threads.:id.admission-operations.:admissionId.$get": vi.fn(
+          async () =>
+            retained(
+              refusal === "uncertain" ? "uncertain" : "failed",
+              refusal === "wrong-thread" ? "other-thread" : "destination",
+            ),
+        ),
+        "v1.threads.:id.send.$post": post,
+      });
+      await expect(
+        runCommand(
+          [
+            "thread",
+            "tell",
+            "destination",
+            "new correction",
+            "--correction-of",
+            "journal-edit",
+            ...(refusal === "reuse"
+              ? ["--operation-id", "historical-edit"]
+              : []),
+          ],
+          register,
+        ),
+      ).rejects.toThrow("process.exit:1");
+      expect(post).not.toHaveBeenCalled();
+    },
+  );
+});
