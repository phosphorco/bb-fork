+// @vitest-environment jsdom
+
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import {
+  sendMessageResponseSchema,
+  type ThreadAdmissionOperationResponse,
+} from "@bb/server-contract";
+import { ThreadAdmissionPreparations } from "./ThreadAdmissionPreparations";
+import { separateCorrectionRequest } from "./thread-admission-correction";
+
+const ports = vi.hoisted(() => ({
+  list: vi.fn(),
+  cancel: vi.fn(),
+  send: vi.fn(),
+}));
+vi.mock("@/lib/sdk", () => ({
+  sdk: {
+    threads: {
+      experimental_listAdmissionPreparations: ports.list,
+      experimental_cancelAdmissionPreparation: ports.cancel,
+    },
+  },
+}));
+
+function fixture(): ThreadAdmissionOperationResponse {
+  const operation = { namespace: "native:receiver", operationId: "old-edit" };
+  const original = { originalId: "original", revision: 2 };
+  const execution = {
+    provider: "codex",
+    model: "gpt-5",
+    reasoning: "medium",
+    serviceTier: "default",
+    permissionMode: "full",
+    canAsk: false,
+    configuration: {
+      model: "gpt-5",
+      reasoningLevel: "medium",
+      serviceTier: "default",
+      permissionMode: "full",
+      source: "client/turn/requested",
+    },
+  };
+  const intent = {
+    mode: "queue",
+    membership: "preserve",
+    schedule: { kind: "ordinary" },
+    execution,
+  };
+  const accepted = {
+    version: 1,
+    operation,
+    original,
+    requestFingerprint: `sha256:${"a".repeat(64)}`,
+    threadId: "receiver",
+    rawInput: [{ type: "text", text: "Retained correction B", mentions: [] }],
+    source: {
+      senderThreadId: null,
+      initiator: "user",
+      author: null,
+      editor: null,
+      origin: null,
+      externalOperation: null,
+      visibleHumanActivity: true,
+    },
+    requestedIntent: intent,
+    effectiveIntent: { ...intent, changes: [] },
+    acceptedAt: "2026-11-12T00:00:00.000Z",
+    acceptanceSequence: 1,
+    admission: { kind: "evaluated", publications: [], assessments: [] },
+  };
+  const response = sendMessageResponseSchema.parse({
+    ok: true,
+    delivery: "preparing",
+    admission: {
+      version: 1,
+      operation,
+      original,
+      requestFingerprint: accepted.requestFingerprint,
+      kind: "submission",
+      status: "accepted",
+      assessments: [],
+      acceptedOriginal: accepted,
+      publication: null,
+      feedback: null,
+      acceptanceReceipt: { kind: "message-edit", delivery: "preparing" },
+      delivery: {
+        state: "preparation-failed",
+        queueId: null,
+        requestId: null,
+        groupIndex: null,
+        details: {
+          conflict: {
+            code: "historical-edit-target-changed",
+            message: "Newer A must stay intact",
+          },
+          correction: { requiresNewOperation: true, operation, original },
+        },
+      },
+      reasons: [],
+    },
+  });
+  if (response.delivery !== "preparing")
+    throw new Error("Invalid preparation fixture");
+  return {
+    journalId: "journal",
+    preparationState: "failed",
+    correctionOf: { operation, original },
+    record: response.admission,
+  };
+}
+
+const clients: QueryClient[] = [];
+function mount() {
+  const client = new QueryClient({
+    defaultOptions: { queries: { retry: false }, mutations: { retry: false } },
+  });
+  clients.push(client);
+  return render(
+    <QueryClientProvider client={client}>
+      <ThreadAdmissionPreparations
+        threadId="receiver"
+        sendMessage={{ mutateAsync: ports.send, isPending: false }}
+      />
+    </QueryClientProvider>,
+  );
+}
+
+async function expand() {
+  fireEvent.click(await screen.findByText(/^Accepted work/));
+}
+beforeEach(() => {
+  vi.clearAllMocks();
+  localStorage.clear();
+});
+afterEach(() => {
+  cleanup();
+  clients.splice(0).forEach((client) => client.clear());
+});
+
+it("requires the server's exact current correction action instead of inferring it from historical details", () => {
+  const item = fixture();
+  expect(separateCorrectionRequest(item)?.correctionOf).toEqual(
+    item.correctionOf,
+  );
+  const action = item.correctionOf;
+  delete item.correctionOf;
+  expect(separateCorrectionRequest(item)).toBeNull();
+  item.correctionOf = action;
+  item.preparationState = "cancelled";
+  item.record.delivery.state = "cancelled";
+  expect(separateCorrectionRequest(item)).not.toBeNull();
+  item.correctionOf = {
+    operation: { namespace: "wrong", operationId: "other" },
+    original: item.record.original!,
+  };
+  expect(separateCorrectionRequest(item)).toBeNull();
+});
+
+it("shows settled native state instead of replaying the initial preparing acknowledgement", async () => {
+  const item = fixture();
+  item.preparationState = "completed";
+  item.record.delivery.state = "request-committed";
+  ports.list.mockResolvedValue({ items: [item], nextBeforeSequence: null });
+  mount();
+  await expand();
+  expect(
+    await screen.findByText(
+      /Preparation completed.*Delivery request committed/,
+    ),
+  ).toBeTruthy();
+  expect(screen.queryByText("Cancel future content")).toBeNull();
+  expect(screen.queryByText("Send as separate correction")).toBeNull();
+  expect(ports.list.mock.calls[0][0].includeSettled).toBe(true);
+  expect(item.record.acceptanceReceipt).toEqual({
+    kind: "message-edit",
+    delivery: "preparing",
+  });
+});
+
+it("requires confirmation and retains one new correction operation across an unknown response and remount", async () => {
+  const item = fixture();
+  ports.list.mockResolvedValue({ items: [item], nextBeforeSequence: null });
+  ports.send
+    .mockRejectedValueOnce(new Error("Transport outcome unknown"))
+    .mockResolvedValue({ ok: true, delivery: "sent" });
+  localStorage.setItem("existing-composer-draft", "Keep unrelated draft");
+  const first = mount();
+  await expand();
+  fireEvent.click(await screen.findByText("Send as separate correction"));
+  expect(ports.send).not.toHaveBeenCalled();
+  expect(screen.getByText("gpt-5")).toBeTruthy();
+  expect(screen.getByText("medium")).toBeTruthy();
+  expect(screen.getByText("full")).toBeTruthy();
+  expect(screen.getByText("default")).toBeTruthy();
+  fireEvent.click(screen.getByText("Confirm new correction"));
+  await screen.findByRole("alert");
+  const initial = ports.send.mock.calls[0][0];
+  expect(initial.operationId).not.toBe("old-edit");
+  expect(initial.correctionOf).toEqual({
+    operation: item.record.operation,
+    original: item.record.original,
+  });
+  expect(initial.input).toEqual(item.record.acceptedOriginal!.rawInput);
+  first.unmount();
+  const second = mount();
+  await expand();
+  fireEvent.click(await screen.findByText("Send as separate correction"));
+  fireEvent.click(screen.getByText("Confirm new correction"));
+  await waitFor(() => expect(ports.send).toHaveBeenCalledTimes(2));
+  expect(ports.send.mock.calls[1][0]).toEqual(initial);
+  await waitFor(() =>
+    expect(screen.queryByText("Confirm new correction")).toBeNull(),
+  );
+  expect(localStorage.getItem("existing-composer-draft")).toBe(
+    "Keep unrelated draft",
+  );
+  second.unmount();
+  mount();
+  await expand();
+  fireEvent.click(await screen.findByText("Send as separate correction"));
+  fireEvent.click(screen.getByText("Confirm new correction"));
+  await waitFor(() => expect(ports.send).toHaveBeenCalledTimes(3));
+  expect(ports.send.mock.calls[2][0]).toEqual(initial);
+});
+
+it("uses exact cancellation state and exposes a race without repeating the mutation", async () => {
+  const item = fixture();
+  item.preparationState = "pending";
+  item.record.delivery.state = "preparing";
+  const busy = {
+    ...item,
+    preparationState: "effect-possible",
+    record: {
+      ...item.record,
+      delivery: { ...item.record.delivery, state: "uncertain" },
+    },
+  };
+  ports.list
+    .mockResolvedValueOnce({ items: [item], nextBeforeSequence: null })
+    .mockResolvedValue({ items: [busy], nextBeforeSequence: null });
+  ports.cancel.mockRejectedValue(
+    new Error("An effect may already be in progress"),
+  );
+  mount();
+  await expand();
+  fireEvent.click(await screen.findByText("Cancel future content"));
+  expect(await screen.findByRole("alert")).toBeTruthy();
+  await waitFor(() =>
+    expect(screen.queryByText("Cancel future content")).toBeNull(),
+  );
+  expect(ports.cancel).toHaveBeenCalledExactlyOnceWith({
+    threadId: "receiver",
+    journalId: "journal",
+    expectedState: "pending",
+  });
+  expect(
+    await screen.findByText(/Earlier effects may have happened/),
+  ).toBeTruthy();
+});
+
+it("loads earlier bounded pages only when requested", async () => {
+  ports.list
+    .mockResolvedValueOnce({ items: [fixture()], nextBeforeSequence: 9 })
+    .mockResolvedValue({ items: [], nextBeforeSequence: null });
+  mount();
+  await expand();
+  fireEvent.click(await screen.findByText("Load earlier preparations"));
+  await waitFor(() => expect(ports.list).toHaveBeenCalledTimes(2));
+  expect(ports.list.mock.calls[1][0].beforeSequence).toBe(9);
+});
diff --git a/apps/app/src/components/thread/ThreadAdmissionPreparations.tsx b/apps/app/src/components/thread/ThreadAdmissionPreparations.tsx
