+  });
+});
diff --git a/apps/server/test/services/threads/message-originals.p6r.test.ts b/apps/server/test/services/threads/message-originals.p6r.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eba3ecbb055d878a75de4120512fb340ccc7403c
--- /dev/null
+++ b/apps/server/test/services/threads/message-originals.p6r.test.ts
@@ -0,0 +1,142 @@
+import { describe, expect, it } from "vitest";
+import type { MessageOriginal, P6rMessageAuthor } from "@bb/domain";
+import {
+  normalizeMessageOriginals,
+  queuedMessageOriginalManifest,
+  messageOriginalSourceSummary,
+} from "../../../src/services/threads/message-originals.js";
+
+function original(
+  id: string,
+  initiator: "user" | "agent",
+  senderThreadId: string | null,
+): MessageOriginal {
+  const author: P6rMessageAuthor = {
+    evidence: "machine",
+    identity: { kind: "machine", key: id, instanceId: id, hostId: null },
+    presentation: { displayName: id, handle: null, avatarUrl: null },
+  };
+  return {
+    originalId: id,
+    revisionId: `rev-${id}`,
+    operationId: `op-${id}`,
+    rawInput: [
+      { type: "text", text: `raw-${id}`, mentions: [] },
+      { type: "localFile", path: `/tmp/${id}.txt` },
+    ],
+    source: {
+      source: "tell",
+      initiator,
+      senderThreadId,
+      origin: null,
+      originPluginId: null,
+      requestedBy: null,
+      rendering: "host",
+    },
+    author,
+    editor: null,
+    acceptedAt: 1,
+    requestedIntent: { mode: "queue-batched", sendAt: null },
+    effectiveIntent: { mode: "queue-batched", sendAt: null },
+  };
+}
+describe("message originals normalizer", () => {
+  it("renders A/B/A with each own sender and author while retaining each local file", () => {
+    const manifest = [
+      original("A", "agent", "thread-A"),
+      original("B", "agent", "thread-B"),
+      original("C", "agent", "thread-A"),
+    ];
+    const normalized = normalizeMessageOriginals(manifest);
+    const text = normalized.inputGroups.map((group) =>
+      group
+        .flatMap((part) => (part.type === "text" ? [part.text] : []))
+        .join(""),
+    );
+    expect(text[0]).toContain("thread-A");
+    expect(text[0]).toContain("sender=machine:A");
+    expect(text[1]).toContain("thread-B");
+    expect(text[1]).toContain("sender=machine:B");
+    expect(text[1]).not.toContain("thread-A");
+    expect(text[2]).toContain("thread-A");
+    expect(text[2]).toContain("sender=machine:C");
+    expect(
+      normalized.inputGroups.map((group) =>
+        group.filter((part) => part.type === "localFile"),
+      ),
+    ).toEqual(
+      manifest.map((item) =>
+        item.rawInput.filter((part) => part.type === "localFile"),
+      ),
+    );
+    expect(normalized.senderThreadId).toBeNull();
+    expect(normalized.originalManifest).toEqual(manifest);
+  });
+  it("keeps producer-owned rendering untouched without inferring ownership from text", () => {
+    const producer = original("producer", "agent", "thread-A");
+    producer.source.rendering = "producer";
+    producer.rawInput = [
+      {
+        type: "text",
+        text: "[sender=external]already framed[/sender]",
+        mentions: [],
+      },
+    ];
+    const host = original("host", "user", null);
+    const normalized = normalizeMessageOriginals([producer, host]);
+    expect(normalized.inputGroups[0]).toEqual(producer.rawInput);
+    expect(normalized.inputGroups[1]?.[0]).toMatchObject({
+      text: "[sender=machine:host]\n",
+    });
+    expect(normalized.permissionEscalation).toBe("deny");
+  });
+  it("meets escalation independently of lead, retains human activity, and never supplies an agent sender for a human null source", () => {
+    const human = original("human", "user", null),
+      agent = original("agent", "agent", "thread-A");
+    const first = messageOriginalSourceSummary([human, agent]),
+      second = messageOriginalSourceSummary([agent, human]);
+    expect(first).toEqual(second);
+    expect(first).toMatchObject({
+      permissionEscalation: "deny",
+      hasHumanInput: true,
+      senderThreadId: null,
+    });
+    expect(messageOriginalSourceSummary([human])).toMatchObject({
+      permissionEscalation: "ask",
+      initiator: "user",
+    });
+    expect(
+      normalizeMessageOriginals([human, agent]).inputGroups[0]?.some(
+        (part) => part.type === "text" && part.text.includes("thread-A"),
+      ),
+    ).toBe(false);
+  });
+  it("retains a canonical restriction on human escalation independent of lead", () => {
+    const allowed = original("allowed", "user", null),
+      restricted = { ...original("restricted", "user", null), canAsk: false };
+    expect(
+      messageOriginalSourceSummary([allowed, restricted]).permissionEscalation,
+    ).toBe("deny");
+    expect(
+      messageOriginalSourceSummary([restricted, allowed]).permissionEscalation,
+    ).toBe("deny");
+    expect(normalizeMessageOriginals([restricted]).permissionEscalation).toBe(
+      "deny",
+    );
+  });
+  it("discloses legacy absence and refuses partial, duplicate or corrupt known manifests", () => {
+    const known = {
+      originalManifest: JSON.stringify([original("A", "user", null)]),
+    };
+    expect(queuedMessageOriginalManifest([known])).toHaveLength(1);
+    expect(
+      queuedMessageOriginalManifest([known, { originalManifest: null }]),
+    ).toBeUndefined();
+    expect(() => queuedMessageOriginalManifest([known, known])).toThrow(
+      "Duplicate original identity",
+    );
+    expect(() =>
+      queuedMessageOriginalManifest([{ originalManifest: "{}" }]),
+    ).toThrow();
+  });
+});
