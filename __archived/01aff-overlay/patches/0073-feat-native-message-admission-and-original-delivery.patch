+async function nativeEditPolicy(
+  harness: TestAppHarness,
+  thread: ReturnType<typeof seedThread>,
+  evaluator: EvaluatorV1,
+) {
+  const service = getMessageAdmissionService(harness.db);
+  const plugin = service.createPluginHandle("native-edit-policy");
+  plugin.activate();
+  await plugin.protocol.registerEvaluator(
+    { version: 1, evaluatorVersion: "1" },
+    evaluator,
+  );
+  await plugin.protocol.publish({
+    version: 1,
+    operation: { namespace: "edit-publication", operationId: thread.id },
+    providerId: "native-edit-policy",
+    expectedActivePublication: null,
+    snapshotBytes: canonicalJson({}, 100),
+    configurationVersion: "1",
+    evaluatorVersion: "1",
+    enrollment: { mode: "enforce", projectIds: [thread.projectId] },
+  });
+  return { service, plugin };
+}
+afterEach(() => setPluginHookProvider(undefined));
