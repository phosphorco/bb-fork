+describe("native preparation recovery boundaries", () => {
+  it("reconfigures recovery over durable committed maintenance without reissuing it", async () => {
+    await withTestHarness(async (harness) => {
+      const { thread, args } = setup(harness),
+        service = getMessageAdmissionService(harness.db);
+      let runtime = configureNativeMessageAdmissionRuntime(harness.deps);
+      try {
+        args.payload = { ...args.payload, compactFirst: true };
+        const outcome = await attemptDispatch(harness.deps, args);
+        if (outcome.kind !== "preparing") throw Error("Expected preparation");
+        await waitForQueuedCommand(
+          harness,
+          (queued) =>
+            queued.command.type === "turn.submit" &&
+            queued.command.threadId === thread.id,
+        );
+        await runtime.catchUp();
+        const requested = () =>
+          listEvents(harness.db, { threadId: thread.id }).filter(
+            (row) =>
+              row.type === "client/turn/requested" &&
+              JSON.parse(row.data).originalManifest !== undefined,
+          );
+        const requestId = JSON.parse(requested()[0]!.data).requestId;
+        runtime.dispose();
+        runtime = configureNativeMessageAdmissionRuntime(harness.deps);
+        await runtime.catchUp();
+        expect(
+          service.preparationRecord(outcome.operation.operation),
+        ).toMatchObject({
+          state: "pending",
+          details: { stage: "maintenance-request-committed" },
+        });
+        expect(requested()).toHaveLength(1);
+        terminal(harness, thread.id, requestId, "completed");
+        await runtime.recoverOperation(outcome.operation.operation);
+        expect(requested()).toHaveLength(2);
+        expect(
+          service.preparationRecord(outcome.operation.operation)?.state,
+        ).toBe("completed");
+      } finally {
+        runtime.dispose();
+      }
+    });
+  });
+  it("cancels committed-maintenance preparation without releasing its content", async () => {
+    await withTestHarness(async (harness) => {
+      const { thread, args } = setup(harness),
+        service = getMessageAdmissionService(harness.db),
+        runtime = configureNativeMessageAdmissionRuntime(harness.deps);
+      try {
+        args.payload = { ...args.payload, compactFirst: true };
+        const outcome = await attemptDispatch(harness.deps, args);
+        if (outcome.kind !== "preparing") throw Error("Expected preparation");
+        await waitForQueuedCommand(
+          harness,
+          (queued) =>
+            queued.command.type === "turn.submit" &&
+            queued.command.threadId === thread.id,
+        );
+        await runtime.catchUp();
+        const requested = () =>
+          listEvents(harness.db, { threadId: thread.id }).filter(
+            (row) =>
+              row.type === "client/turn/requested" &&
+              JSON.parse(row.data).originalManifest !== undefined,
+          );
+        harness.db.transaction((tx) =>
+          service.updatePreparation(
+            tx,
+            outcome.operation.operation,
+            "pending",
+            "cancelled",
+            { reason: "Explicit owner cancellation" },
+          ),
+        );
+        terminal(
+          harness,
+          thread.id,
+          JSON.parse(requested()[0]!.data).requestId,
+          "completed",
+        );
+        await runtime.recoverOperation(outcome.operation.operation);
+        expect(requested()).toHaveLength(1);
+        expect(
+          service.lookupOperation(outcome.operation.operation)?.delivery.state,
