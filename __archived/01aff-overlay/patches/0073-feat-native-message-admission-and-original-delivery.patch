+  function sink(tx: DbTransaction, accepted: AcceptedOriginalV1) {
+    const row = createQueuedThreadMessageInTransaction(tx, {
+      threadId: accepted.threadId,
+      content: z.array(promptInputSchema).parse(accepted.rawInput),
+      senderThreadId: accepted.source.senderThreadId,
+      model: "model",
+      reasoningLevel: "medium",
+      permissionMode: "auto",
+      serviceTier: "default",
