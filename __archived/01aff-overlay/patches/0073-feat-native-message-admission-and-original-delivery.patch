+  const changed = db.transaction(
+    (tx) => {
+      const rows = getExactClaimedGroup(tx, args.claims, args.threadId);
+      if (!rows) return false;
+      for (const row of rows)
+        if (
+          !transitionQueuedMessage(tx, {
+            now: Date.now(),
+            row,
+            transition: { event: "claim.released" },
+          })
+        ) {
+          throw new Error("Claimed group changed during release");
+        }
+      return true;
+    },
+    { behavior: "immediate" },
+  );
+  if (changed) notifier.notifyThread(args.threadId, ["queue-changed"]);
+  return changed;
+}
+
+export function failClaimedQueuedThreadMessageGroup(
+  db: DbConnection,
+  notifier: DbNotifier,
+  args: {
+    threadId: string;
+    claims: readonly ClaimedQueuedThreadMessageMutationArgs[];
+    failureReason: string;
+    now: number;
+    retryDelaysMs: readonly number[];
+  },
+): boolean {
+  const changed = db.transaction(
+    (tx) => {
+      const rows = getExactClaimedGroup(tx, args.claims, args.threadId);
+      if (!rows) return false;
+      for (const row of rows) {
+        const released = transitionQueuedMessage(tx, {
+          now: args.now,
+          row,
+          transition: { event: "claim.released" },
+        });
+        if (
+          !released ||
+          !transitionQueuedMessage(tx, {
+            now: args.now,
+            row: released,
+            transition: {
+              event: "drain.failed",
+              failureReason: args.failureReason,
+              retryDelaysMs: args.retryDelaysMs,
+            },
+          })
+        ) {
+          throw new Error("Claimed group changed during failure");
+        }
+      }
+      return true;
+    },
+    { behavior: "immediate" },
+  );
+  if (changed) notifier.notifyThread(args.threadId, ["queue-changed"]);
+  return changed;
+}
