+    expect(checks).toBeGreaterThanOrEqual(3);
+    expect(service.preparationRecord(input.operation)?.state).toBe("pending");
+    expect(
+      reopened
+        .select()
+        .from(threads)
+        .where(eq(threads.id, f.destination.id))
+        .get()?.messageAcceptanceSequence,
+    ).toBe(1);
+    expect(reopened.select().from(queuedThreadMessages).all()).toHaveLength(0);
+  });
+
+  it("waiting cannot hide an effect-possible stage without positive request commit proof", async () => {
+    const f = fixture(),
+      input = await f.submission(),
+      ticket = await f.ticket(input, { stage: "before-maintenance" });
+    f.db.transaction((tx) => f.service.commit(tx, ticket, () => ({})));
+    const recovery = f.service.configureRecovery({
+      resumePreparation: async () => {
+        f.db.transaction((tx) =>
+          f.service.updatePreparation(
+            tx,
+            input.operation,
+            "pending",
+            "effect-possible",
+            { requestId: "possible-maintenance" },
+          ),
+        );
+        return { kind: "waiting" };
+      },
+      submitFeedback: async () => {
+        throw new Error("unused");
+      },
+    });
+    cleanups.push(recovery.dispose);
+    await recovery.catchUp();
+    expect(f.service.preparationRecord(input.operation)?.state).toBe(
+      "uncertain",
+    );
+    expect(f.service.lookupOperation(input.operation)?.delivery.state).toBe(
+      "uncertain",
+    );
+    expect(f.db.select().from(queuedThreadMessages).all()).toHaveLength(0);
+  });
+
+  it.each(["pending", "claimed"] as const)(
+    "parent cancellation atomically suppresses only %s uninitiated feedback",
+    async (stage) => {
+      const f = fixture();
+      await register(f);
+      const input = await f.submission(),
+        parent = f.commit(await f.ticket(input));
+      const assessment = reduceObservations({
+        assessmentId: `cancel-${stage}`,
+        observations: [reject()],
+        complete: true,
+      });
+      f.db.transaction((tx) =>
+        f.service.commitFinalDisposition(tx, {
+          operation: input.operation,
+          expectedDispositionId: null,
+          dispositionId: "failed",
+          disposition: { reason: "operational-failure" },
+          delivery: {
+            ...parent.operation.delivery,
+            state: "preparation-failed",
+          },
+          feedback: { providerId: "rules", assessment },
+        }),
+      );
+      const obligation = f.db.select().from(messageAdmissionFeedback).get()!;
+      if (stage === "claimed") f.service.claimFeedback(obligation.id);
+      const cancel = (tx: DbTransaction) => {
+        tx.delete(queuedThreadMessages)
+          .where(eq(queuedThreadMessages.id, parent.value.queueId))
+          .run();
+        f.service.commitFinalDisposition(tx, {
+          operation: input.operation,
+          expectedDispositionId: "failed",
+          dispositionId: "cancelled",
+          disposition: { reason: "superseded-by-edit", newRevision: 2 },
+          delivery: { ...parent.operation.delivery, state: "cancelled" },
+        });
+      };
+      expect(() =>
+        f.db.transaction((tx) => {
+          cancel(tx);
+          throw new Error("before cancellation commit");
+        }),
+      ).toThrow("before cancellation commit");
+      expect(f.db.select().from(queuedThreadMessages).all()).toHaveLength(1);
+      expect(f.service.feedbackRecord(obligation.id)?.row.state).toBe(stage);
+      f.db.transaction(cancel);
+      expect(f.service.feedbackRecord(obligation.id)?.row.state).toBe(
+        stage === "pending" ? "superseded" : "claimed",
+      );
+      const reopened = createConnection(f.db.$client.serialize());
+      databases.push(reopened);
+      const service = getMessageAdmissionService(reopened);
+      let sends = 0;
+      const recovery = service.configureRecovery({
+        resumePreparation: async () => {},
+        submitFeedback: async ({ feedback }) => {
+          sends++;
+          return {
+            ...feedback,
+            status: "uncertain",
+            reasons: [{ code: "unexpected", message: "Must not invoke" }],
+          };
+        },
+      });
+      cleanups.push(recovery.dispose);
+      await recovery.catchUp();
+      expect(sends).toBe(0);
+      expect(service.feedbackRecord(obligation.id)?.feedback.status).toBe(
+        stage === "pending" ? "superseded-without-send" : "uncertain",
+      );
+      expect(service.feedbackRecord(obligation.id)?.feedback.advice).toEqual(
+        assessment.advice,
+      );
+      expect(service.lookupOperation(input.operation)?.delivery.state).toBe(
+        "cancelled",
+      );
+      expect(service.lookupOperation(input.operation)?.feedback?.status).toBe(
+        stage === "pending" ? "superseded-without-send" : "uncertain",
+      );
+    },
+  );
+
+  it("enforces exact snapshot capacity without changing the active publication on overflow", async () => {
+    const f = fixture();
+    const boundary = "x".repeat(MESSAGE_ADMISSION_LIMITS.snapshotBytes - 2);
+    const initial = await f.publish(boundary);
