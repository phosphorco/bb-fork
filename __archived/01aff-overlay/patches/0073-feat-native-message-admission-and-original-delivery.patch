@@ -0,0 +1,1099 @@
+import { createHash } from "node:crypto";
+import { and, asc, eq, gt, inArray, sql } from "drizzle-orm";
+import type {
+  DbConnection,
+  DbQueryConnection,
+  DbTransaction,
+} from "../connection.js";
+import {
+  messageAdmissionFeedback as feedback,
+  messageAdmissionThreadCreates as threadCreates,
+  messageAdmissionOperations as operations,
+  messageAdmissionPublications as publications,
+  messageAdmissionSlots as slots,
+  messageAdmissionProviders as providers,
+  messageAdmissionRequestOriginals as requestOriginals,
+  messageAdmissionRechecks as rechecks,
+  threads,
+} from "../schema.js";
+
+export type AdmissionOperation = typeof operations.$inferSelect;
+export type AdmissionPublication = typeof publications.$inferSelect;
+export type AdmissionSlot = typeof slots.$inferSelect;
+export type AdmissionFeedback = typeof feedback.$inferSelect;
+
+export function admissionDigest(value: string): string {
+  return createHash("sha256").update(value).digest("hex");
+}
+
+export function admissionOperationKey(
+  namespace: string,
+  operationId: string,
+): string {
+  return admissionDigest(JSON.stringify([namespace, operationId]));
+}
+
+export class AdmissionConflict extends Error {
+  constructor(
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+export function getAdmissionOperation(
+  db: DbQueryConnection,
+  namespace: string,
+  operationId: string,
+): AdmissionOperation | null {
+  return (
+    db
+      .select()
+      .from(operations)
+      .where(
+        and(
+          eq(operations.namespace, namespace),
+          eq(operations.operationId, operationId),
+        ),
+      )
+      .get() ?? null
+  );
+}
+
+export function reserveAdmissionOperation(
+  db: DbConnection,
+  input: Omit<
+    typeof operations.$inferInsert,
+    "state" | "attempt" | "createdAt" | "updatedAt"
+  >,
+  now = Date.now(),
+): { operation: AdmissionOperation; created: boolean } {
+  return db.transaction(
+    (tx) => {
+      const existing = getAdmissionOperation(
+        tx,
+        input.namespace,
+        input.operationId,
+      );
+      if (existing) {
+        if (existing.fingerprint !== input.fingerprint)
+          throw new AdmissionConflict(
+            "operation-fingerprint-conflict",
+            "Operation ID already identifies different input",
+          );
+        return { operation: existing, created: false };
+      }
+      const operation = tx
+        .insert(operations)
+        .values({
+          ...input,
+          state: "evaluating",
+          createdAt: now,
+          updatedAt: now,
+        })
+        .returning()
+        .get();
+      return { operation, created: true };
+    },
+    { behavior: "immediate" },
+  );
+}
+
+export function completeAdmissionAssessment(
+  db: DbQueryConnection,
+  id: string,
+  attempt: number,
+  state: "rejected" | "unresolved",
+  result: string,
+  now = Date.now(),
+): AdmissionOperation {
+  const row = db
+    .update(operations)
+    .set({ state, result, updatedAt: now })
+    .where(
+      and(
+        eq(operations.id, id),
+        eq(operations.attempt, attempt),
+        eq(operations.state, "evaluating"),
+      ),
+    )
+    .returning()
+    .get();
+  if (!row)
+    throw new AdmissionConflict(
+      "operation-state-conflict",
+      "Assessment ownership changed",
+    );
+  return row;
+}
+
+export function completeAdmissionRejectionInTransaction(
+  tx: DbTransaction,
+  input: {
+    operationId: string;
+    attempt: number;
+    result: string;
+    feedback: Omit<
+      typeof feedback.$inferInsert,
+      "parentOperationId" | "state" | "createdAt" | "updatedAt"
+    > | null;
+  },
+  now = Date.now(),
+): AdmissionOperation {
+  const row = completeAdmissionAssessment(
+    tx,
+    input.operationId,
+    input.attempt,
+    "rejected",
+    input.result,
+    now,
+  );
+  if (input.feedback)
+    tx.insert(feedback)
+      .values({
+        ...input.feedback,
+        parentOperationId: row.id,
+        state: "pending",
+        createdAt: now,
+        updatedAt: now,
+      })
+      .run();
+  return row;
+}
+
+export function recheckAdmissionOperation(
+  db: DbConnection,
+  namespace: string,
+  operationId: string,
+  expectedAttempt: number,
+  now = Date.now(),
+): AdmissionOperation {
+  return db.transaction(
+    (tx) => {
+      const row = getAdmissionOperation(tx, namespace, operationId);
+      if (!row || row.state !== "unresolved" || row.attempt !== expectedAttempt)
+        throw new AdmissionConflict(
+          "operation-state-conflict",
+          "Only a known unresolved assessment can be rechecked",
+        );
+      return tx
+        .update(operations)
+        .set({
+          state: "evaluating",
+          attempt: row.attempt + 1,
+          result: null,
+          updatedAt: now,
+        })
+        .where(eq(operations.id, row.id))
+        .returning()
+        .get();
+    },
+    { behavior: "immediate" },
+  );
+}
+
+export function activeAdmissionSlots(
+  db: DbQueryConnection,
+  projectId: string,
+): AdmissionSlot[] {
+  return db
+    .select()
+    .from(slots)
+    .where(and(eq(slots.projectId, projectId), eq(slots.enabled, true)))
+    .orderBy(asc(slots.providerId))
+    .all();
+}
+
+export function getAdmissionPublication(
+  db: DbQueryConnection,
+  id: string,
+): AdmissionPublication | null {
+  return (
+    db.select().from(publications).where(eq(publications.id, id)).get() ?? null
+  );
+}
+
+export function getActiveAdmissionPublication(
+  db: DbQueryConnection,
+  providerId: string,
+): AdmissionPublication | null {
+  const pointer = db
+    .select()
+    .from(providers)
+    .where(eq(providers.providerId, providerId))
+    .get();
+  return pointer ? getAdmissionPublication(db, pointer.publicationId) : null;
+}
+
+export function publishAdmissionPolicy(
+  db: DbConnection,
+  input: {
+    pluginId: string;
+    providerId: string;
+    operationNamespace: string;
+    operationId: string;
+    fingerprint: string;
+    publicationFingerprint: string;
+    snapshot: string;
+    evaluatorVersion: string;
+    configurationVersion: string;
+    enrollment: string;
+    projectIds: string[];
+    expectedPublicationId: string | null;
+    expectedPublicationFingerprint?: string | null;
+  },
+  now = Date.now(),
+): AdmissionPublication {
+  return db.transaction(
+    (tx) => {
+      const existing = tx
+        .select()
+        .from(publications)
+        .where(
+          and(
+            eq(publications.pluginId, input.pluginId),
+            eq(publications.operationNamespace, input.operationNamespace),
+            eq(publications.operationId, input.operationId),
+          ),
+        )
+        .get();
+      if (existing) {
+        if (existing.fingerprint !== input.fingerprint)
+          throw new AdmissionConflict(
+            "publication-fingerprint-conflict",
+            "Publication operation already identifies different bytes or enrollment",
+          );
+        return existing;
+      }
+      const current = getActiveAdmissionPublication(tx, input.providerId);
+      if (current && current.pluginId !== input.pluginId)
+        throw new AdmissionConflict(
+          "publication-provider-conflict",
+          "Provider belongs to another plugin",
+        );
+      if (
+        input.expectedPublicationFingerprint !== undefined &&
+        (current?.publicationFingerprint ?? null) !==
+          input.expectedPublicationFingerprint
+      )
+        throw new AdmissionConflict(
+          "publication-pointer-conflict",
+          "Expected publication fingerprint differs from active native pointer",
+        );
+      if ((current?.id ?? null) !== input.expectedPublicationId)
+        throw new AdmissionConflict(
+          "publication-pointer-conflict",
+          "Active publication changed",
+        );
+      const publication = tx
+        .insert(publications)
+        .values({
+          id: admissionOperationKey(
+            input.pluginId,
+            JSON.stringify([input.operationNamespace, input.operationId]),
+          ),
+          operationNamespace: input.operationNamespace,
+          pluginId: input.pluginId,
+          providerId: input.providerId,
+          operationId: input.operationId,
+          fingerprint: input.fingerprint,
+          publicationFingerprint: input.publicationFingerprint,
+          snapshot: input.snapshot,
+          enrollment: input.enrollment,
+          evaluatorVersion: input.evaluatorVersion,
+          configurationVersion: input.configurationVersion,
+          createdAt: now,
+        })
+        .returning()
+        .get();
+      tx.insert(providers)
+        .values({
+          providerId: input.providerId,
+          pluginId: input.pluginId,
+          publicationId: publication.id,
+        })
+        .onConflictDoUpdate({
+          target: providers.providerId,
+          set: { publicationId: publication.id },
+        })
+        .run();
+      tx.delete(slots).where(eq(slots.providerId, input.providerId)).run();
+      for (const projectId of input.projectIds) {
+        tx.insert(slots)
+          .values({
+            pluginId: input.pluginId,
+            providerId: input.providerId,
+            projectId,
+            publicationId: publication.id,
+            enabled: true,
+            revision: 1,
+            updatedAt: now,
+          })
+          .run();
+      }
+      return publication;
+    },
+    { behavior: "immediate" },
+  );
+}
+
+export function acceptAdmissionOperation(
+  tx: DbTransaction,
+  input: {
+    id: string;
+    attempt: number;
+    basis: string;
+    result: string;
+    visibleHuman: boolean;
+    preparation: string | null;
+  },
+  now = Date.now(),
+): AdmissionOperation {
+  const operation = tx
+    .select()
+    .from(operations)
+    .where(eq(operations.id, input.id))
+    .get();
+  if (
+    !operation ||
+    operation.state !== "evaluating" ||
+    operation.attempt !== input.attempt
+  )
+    throw new AdmissionConflict(
+      "operation-state-conflict",
+      "Admission has already completed or changed",
+    );
+  const thread = tx
+    .update(threads)
+    .set({
+      messageAcceptanceSequence: sql`${threads.messageAcceptanceSequence} + 1`,
+      ...(input.visibleHuman
+        ? {
+            lastVisibleHumanAcceptedAt: now,
+            lastVisibleHumanOriginalId: operation.originalId,
+            lastVisibleHumanRevision: operation.revision,
+          }
+        : {}),
+    })
+    .where(
+      and(
+        eq(threads.id, operation.threadId),
+        eq(threads.projectId, operation.projectId),
+      ),
+    )
+    .returning({ sequence: threads.messageAcceptanceSequence })
+    .get();
+  if (!thread)
+    throw new AdmissionConflict(
+      "thread-missing",
+      "Acceptance destination does not exist in its captured project",
+    );
+  return tx
+    .update(operations)
+    .set({
+      state: "accepted",
+      basis: input.basis,
+      result: input.result,
+      visibleHuman: input.visibleHuman,
+      acceptedAt: now,
+      acceptanceSequence: thread.sequence,
+      preparation: input.preparation,
+      preparationState: input.preparation === null ? null : "pending",
+      updatedAt: now,
+    })
+    .where(eq(operations.id, operation.id))
+    .returning()
+    .get();
+}
+
+export function readAdmissionActivity(db: DbQueryConnection, threadId: string) {
+  return (
+    db
+      .select({
+        acceptanceSequence: threads.messageAcceptanceSequence,
+        lastVisibleHumanAcceptedAt: threads.lastVisibleHumanAcceptedAt,
+        lastVisibleHumanOriginalId: threads.lastVisibleHumanOriginalId,
+        lastVisibleHumanRevision: threads.lastVisibleHumanRevision,
+      })
+      .from(threads)
+      .where(eq(threads.id, threadId))
+      .get() ?? null
+  );
+}
+
+export function listAdmissionActivity(
+  db: DbQueryConnection,
+  threadId: string,
+  afterSequence: number,
+  limit: number,
+): AdmissionOperation[] {
+  if (
+    !Number.isSafeInteger(afterSequence) ||
+    afterSequence < 0 ||
+    !Number.isSafeInteger(limit) ||
+    limit < 1 ||
+    limit > 256
+  )
+    throw new AdmissionConflict(
+      "invalid-activity-page",
+      "Activity cursor must be nonnegative; limit must be 1..256",
+    );
+  return db
+    .select()
+    .from(operations)
+    .where(
+      and(
+        eq(operations.threadId, threadId),
+        gt(operations.acceptanceSequence, afterSequence),
+      ),
+    )
+    .orderBy(asc(operations.acceptanceSequence))
+    .limit(limit)
+    .all();
+}
+
+export function transitionAdmissionPreparation(
+  tx: DbTransaction,
+  id: string,
+  expected: NonNullable<AdmissionOperation["preparationState"]>,
+  state: NonNullable<AdmissionOperation["preparationState"]>,
+  preparation: string,
+  now = Date.now(),
+): AdmissionOperation {
+  const row = tx
+    .update(operations)
+    .set({ preparationState: state, preparation, updatedAt: now })
+    .where(
+      and(
+        eq(operations.id, id),
+        eq(operations.state, "accepted"),
+        eq(operations.preparationState, expected),
+      ),
+    )
+    .returning()
+    .get();
+  if (!row)
+    throw new AdmissionConflict(
+      "preparation-state-conflict",
+      "Accepted preparation state changed",
+    );
+  return row;
+}
+
+export function commitAdmissionDisposition(
+  tx: DbTransaction,
+  input: {
+    operationId: string;
+    expectedDispositionId: string | null;
+    dispositionId: string;
+    disposition: string;
+    feedback:
+      | (Omit<
+          typeof feedback.$inferInsert,
+          "id" | "parentOperationId" | "state" | "createdAt" | "updatedAt"
+        > & { id?: string })
+      | null;
+  },
+  now = Date.now(),
+): AdmissionOperation {
+  const operation = tx
+    .select()
+    .from(operations)
+    .where(eq(operations.id, input.operationId))
+    .get();
+  if (
+    !operation ||
+    operation.state !== "accepted" ||
+    operation.dispositionId !== input.expectedDispositionId
+  )
+    throw new AdmissionConflict(
+      "disposition-state-conflict",
+      "Disposition changed or original was not accepted",
+    );
+  const updated = tx
+    .update(operations)
+    .set({
+      dispositionId: input.dispositionId,
+      disposition: input.disposition,
+      updatedAt: now,
+    })
+    .where(eq(operations.id, operation.id))
+    .returning()
+    .get();
+  if (input.feedback)
+    tx.insert(feedback)
+      .values({
+        ...input.feedback,
+        id:
+          input.feedback.id ??
+          admissionOperationKey(
+            operation.id,
+            JSON.stringify([
+              input.feedback.pluginId,
+              input.feedback.assessmentId,
+              input.feedback.recipientThreadId,
+            ]),
+          ),
+        parentOperationId: operation.id,
+        state: "pending",
+        createdAt: now,
+        updatedAt: now,
+      })
+      .run();
+  return updated;
+}
+
+export function pendingAdmissionRecovery(
+  db: DbQueryConnection,
+  limit = 100,
+  afterId = "",
+) {
+  if (!Number.isSafeInteger(limit) || limit < 1 || limit > 256)
+    throw new AdmissionConflict(
+      "invalid-recovery-page",
+      "Recovery limit must be 1..256",
+    );
+  return {
+    preparations: db
+      .select()
+      .from(operations)
+      .where(
+        and(
+          eq(operations.state, "accepted"),
+          inArray(operations.preparationState, ["pending", "effect-possible"]),
+          gt(operations.id, afterId),
+        ),
+      )
+      .orderBy(asc(operations.id))
+      .limit(limit)
+      .all(),
+    feedback: db
+      .select()
+      .from(feedback)
+      .where(
+        and(
+          inArray(feedback.state, ["pending", "claimed"]),
+          gt(feedback.id, afterId),
+        ),
+      )
+      .orderBy(asc(feedback.id))
+      .limit(limit)
+      .all(),
+  };
+}
+
+export function getAdmissionFeedback(
+  db: DbQueryConnection,
+  id: string,
+): AdmissionFeedback | null {
+  return db.select().from(feedback).where(eq(feedback.id, id)).get() ?? null;
+}
+
+export function transitionAdmissionFeedback(
+  tx: DbTransaction,
+  id: string,
+  expected: AdmissionFeedback["state"],
+  state: AdmissionFeedback["state"],
+  result: string | null,
+  now = Date.now(),
+): AdmissionFeedback {
+  const row = tx
+    .update(feedback)
+    .set({ state, result, updatedAt: now })
+    .where(and(eq(feedback.id, id), eq(feedback.state, expected)))
+    .returning()
+    .get();
+  if (!row)
+    throw new AdmissionConflict(
+      "feedback-state-conflict",
+      "Feedback obligation state changed",
+    );
+  return row;
+}
+
+export function findAdmissionPublicationOperation(
+  db: DbQueryConnection,
+  pluginId: string,
+  namespace: string,
+  operationId: string,
+): AdmissionPublication | null {
+  return (
+    db
+      .select()
+      .from(publications)
+      .where(
+        and(
+          eq(publications.pluginId, pluginId),
+          eq(publications.operationNamespace, namespace),
+          eq(publications.operationId, operationId),
+        ),
+      )
+      .get() ?? null
+  );
+}
+
+export function saveAcceptedAdmissionResult(
+  tx: DbTransaction,
+  id: string,
+  result: string,
+  now = Date.now(),
+): void {
+  const changed = tx
+    .update(operations)
+    .set({ result, updatedAt: now })
+    .where(and(eq(operations.id, id), eq(operations.state, "accepted")))
+    .run();
+  if (changed.changes !== 1)
+    throw new AdmissionConflict(
+      "operation-state-conflict",
+      "Accepted operation is missing",
+    );
+}
+
+export function bindAdmissionRequestOriginals(
+  tx: DbTransaction,
+  input: { requestId: string; threadId: string; operationIds: string[] },
+): void {
+  if (
+    input.operationIds.length < 1 ||
+    input.operationIds.length > 256 ||
+    new Set(input.operationIds).size !== input.operationIds.length
+  )
+    throw new AdmissionConflict(
+      "manifest-capacity",
+      "Request requires 1..256 unique accepted original operations",
+    );
+  const current = tx
+    .select()
+    .from(requestOriginals)
+    .where(eq(requestOriginals.requestId, input.requestId))
+    .orderBy(asc(requestOriginals.groupIndex))
+    .all();
+  if (current.length) {
+    if (
+      JSON.stringify(current.map((row) => [row.threadId, row.operationId])) !==
+      JSON.stringify(input.operationIds.map((id) => [input.threadId, id]))
+    )
+      throw new AdmissionConflict(
+        "manifest-conflict",
+        "Request already binds a different frozen original manifest",
+      );
+    return;
+  }
+  for (const [groupIndex, operationId] of input.operationIds.entries()) {
+    const operation = tx
+      .select()
+      .from(operations)
+      .where(eq(operations.id, operationId))
+      .get();
+    if (
+      !operation ||
+      operation.threadId !== input.threadId ||
+      operation.state !== "accepted"
+    )
+      throw new AdmissionConflict(
+        "manifest-original-conflict",
+        "Request original is not accepted for the exact destination",
+      );
+    tx.insert(requestOriginals)
+      .values({
+        requestId: input.requestId,
+        threadId: input.threadId,
+        groupIndex,
+        operationId,
+      })
+      .run();
+  }
+}
+
+export function listAdmissionRequestOriginals(
+  db: DbQueryConnection,
+  threadId: string,
+  requestId: string,
+): AdmissionOperation[] {
+  return db
+    .select({ operation: operations })
+    .from(requestOriginals)
+    .innerJoin(operations, eq(operations.id, requestOriginals.operationId))
+    .where(
+      and(
+        eq(requestOriginals.threadId, threadId),
+        eq(requestOriginals.requestId, requestId),
+      ),
+    )
+    .orderBy(asc(requestOriginals.groupIndex))
+    .all()
+    .map((row) => row.operation);
+}
+
+export function getAdmissionOperationById(
+  db: DbQueryConnection,
+  id: string,
+): AdmissionOperation | null {
+  return (
+    db.select().from(operations).where(eq(operations.id, id)).get() ?? null
+  );
+}
+
+export function markAdmissionEvaluationEffect(
+  db: DbQueryConnection,
+  id: string,
+  attempt: number,
+  effect: AdmissionOperation["evaluationEffect"],
+): void {
+  const updated = db
+    .update(operations)
+    .set({ evaluationEffect: effect, updatedAt: Date.now() })
+    .where(
+      and(
+        eq(operations.id, id),
+        eq(operations.attempt, attempt),
+        eq(operations.state, "evaluating"),
+      ),
+    )
+    .run();
+  if (updated.changes !== 1)
+    throw new AdmissionConflict(
+      "operation-state-conflict",
+      "Evaluation ownership changed before its effect checkpoint",
+    );
+}
+
+export function beginAdmissionRecheck(
+  db: DbConnection,
+  input: {
+    namespace: string;
+    operationId: string;
+    recheckId: string;
+    fingerprint: string;
+  },
+): { operation: AdmissionOperation; started: boolean } | null {
+  return db.transaction(
+    (tx) => {
+      const operation = getAdmissionOperation(
+        tx,
+        input.namespace,
+        input.operationId,
+      );
+      if (!operation) return null;
+      const existing = tx
+        .select()
+        .from(rechecks)
+        .where(
+          and(
+            eq(rechecks.operationId, operation.id),
+            eq(rechecks.recheckId, input.recheckId),
+          ),
+        )
+        .get();
+      if (existing) {
+        if (existing.fingerprint !== input.fingerprint)
+          throw new AdmissionConflict(
+            "recheck-fingerprint-conflict",
+            "Recheck ID already binds different immutable input",
+          );
+        return { operation, started: false };
+      }
+      tx.insert(rechecks)
+        .values({
+          operationId: operation.id,
+          recheckId: input.recheckId,
+          fingerprint: input.fingerprint,
+          createdAt: Date.now(),
+        })
+        .run();
+      if (
+        operation.state !== "unresolved" ||
+        operation.evaluationEffect === "possible"
+      )
+        return { operation, started: false };
+      const updated = tx
+        .update(operations)
+        .set({
+          state: "evaluating",
+          attempt: operation.attempt + 1,
+          result: null,
+          evaluationEffect: "not-invoked",
+          updatedAt: Date.now(),
+        })
+        .where(
+          and(
+            eq(operations.id, operation.id),
+            eq(operations.state, "unresolved"),
+            eq(operations.attempt, operation.attempt),
+          ),
+        )
+        .returning()
+        .get();
+      if (!updated)
+        throw new AdmissionConflict(
+          "operation-state-conflict",
+          "Recheck ownership changed",
+        );
+      return { operation: updated, started: true };
+    },
+    { behavior: "immediate" },
+  );
+}
+
+export function listEvaluatingAdmissionOperations(
+  db: DbQueryConnection,
+  limit = 100,
+): AdmissionOperation[] {
+  return db
+    .select()
+    .from(operations)
+    .where(eq(operations.state, "evaluating"))
+    .orderBy(asc(operations.id))
+    .limit(limit)
+    .all();
+}
+
+export function findAdmissionFeedback(
+  db: DbQueryConnection,
+  input: {
+    pluginId: string;
+    assessmentId: string;
+    originalId: string;
+    revision: number;
+  },
+): AdmissionFeedback | null {
+  const rows = db
+    .select({ feedback })
+    .from(feedback)
+    .innerJoin(operations, eq(operations.id, feedback.parentOperationId))
+    .where(
+      and(
+        eq(feedback.pluginId, input.pluginId),
+        eq(feedback.assessmentId, input.assessmentId),
+        eq(operations.originalId, input.originalId),
+        eq(operations.revision, input.revision),
+      ),
+    )
+    .limit(2)
+    .all();
+  if (rows.length > 1)
+    throw new AdmissionConflict(
+      "feedback-binding-conflict",
+      "Assessment does not identify one exact original disposition",
+    );
+  return rows[0]?.feedback ?? null;
+}
+
+export function setAdmissionAcceptanceReceipt(
+  tx: DbTransaction,
+  id: string,
+  receipt: string,
+): void {
+  const operation = getAdmissionOperationById(tx, id);
+  if (!operation || operation.state !== "accepted")
+    throw new AdmissionConflict(
+      "operation-not-accepted",
+      "Acceptance receipt requires its accepted native operation",
+    );
+  if (operation.acceptanceReceipt !== null) {
+    if (operation.acceptanceReceipt !== receipt)
+      throw new AdmissionConflict(
+        "acceptance-receipt-conflict",
+        "Original acceptance receipt is immutable",
+      );
+    return;
+  }
+  tx.update(operations)
+    .set({ acceptanceReceipt: receipt })
+    .where(and(eq(operations.id, id), eq(operations.state, "accepted")))
+    .run();
+}
+
+export function supersedePendingAdmissionFeedback(
+  tx: DbTransaction,
+  parentOperationId: string,
+  now = Date.now(),
+): number {
+  const reason = JSON.stringify({
+    code: "parent-cancelled-or-superseded",
+    message:
+      "Original was cancelled or superseded before native feedback initiation",
+  });
+  const base = sql`COALESCE(${feedback.result}, json_extract(${feedback.payload}, '$.feedback'))`;
+  return tx
+    .update(feedback)
+    .set({
+      state: "superseded",
+      result: sql`json_insert(json_set(${base}, '$.status', 'superseded-without-send'), '$.reasons[#]', json(${reason}))`,
+      updatedAt: now,
+    })
+    .where(
+      and(
+        eq(feedback.parentOperationId, parentOperationId),
+        eq(feedback.state, "pending"),
+      ),
+    )
+    .run().changes;
+}
+
+export type AdmissionThreadCreate = typeof threadCreates.$inferSelect;
+
+export function getAdmissionThreadCreate(
+  db: DbQueryConnection,
+  namespace: string,
+  operationId: string,
+): AdmissionThreadCreate | null {
+  return (
+    db
+      .select()
+      .from(threadCreates)
+      .where(
+        and(
+          eq(threadCreates.namespace, namespace),
+          eq(threadCreates.operationId, operationId),
+        ),
+      )
+      .get() ?? null
+  );
+}
+
+export function reserveAdmissionThreadCreate(
+  db: DbConnection,
+  input: {
+    namespace: string;
+    operationId: string;
+    fingerprint: string;
+    input: string;
+    threadId: string;
+    nativeOperation: { namespace: string; operationId: string };
+    ownerToken: string;
+  },
+  now = Date.now(),
+): { operation: AdmissionThreadCreate; created: boolean } {
+  return db.transaction(
+    (tx) => {
+      const existing = getAdmissionThreadCreate(
+        tx,
+        input.namespace,
+        input.operationId,
+      );
+      if (existing) {
+        if (existing.fingerprint !== input.fingerprint)
+          throw new AdmissionConflict(
+            "thread-create-fingerprint-conflict",
+            "Create operation already identifies different immutable authored input",
+          );
+        return { operation: existing, created: false };
+      }
+      const operation = tx
+        .insert(threadCreates)
+        .values({
+          namespace: input.namespace,
+          operationId: input.operationId,
+          fingerprint: input.fingerprint,
+          input: input.input,
+          threadId: input.threadId,
+          nativeNamespace: input.nativeOperation.namespace,
+          nativeOperationId: input.nativeOperation.operationId,
+          ownerToken: input.ownerToken,
+          state: "reserved",
+          createdAt: now,
+          updatedAt: now,
+        })
+        .returning()
+        .get();
+      return { operation, created: true };
+    },
+    { behavior: "immediate" },
+  );
+}
+
+export function transitionAdmissionThreadCreate(
+  tx: DbTransaction,
+  input: {
+    namespace: string;
+    operationId: string;
+    ownerToken: string;
+    expectedState: AdmissionThreadCreate["state"];
+    nextState: AdmissionThreadCreate["state"];
+    response?: string | null;
+    error?: string | null;
+  },
+  now = Date.now(),
+): AdmissionThreadCreate {
+  const current = getAdmissionThreadCreate(
+    tx,
+    input.namespace,
+    input.operationId,
+  );
+  if (
+    !current ||
+    current.ownerToken !== input.ownerToken ||
+    current.state !== input.expectedState
+  )
+    throw new AdmissionConflict(
+      "thread-create-state-conflict",
+      "Create operation ownership or state changed",
+    );
+  const allowed: Record<
+    AdmissionThreadCreate["state"],
+    readonly AdmissionThreadCreate["state"][]
+  > = {
+    reserved: ["running", "unresolved", "failed"],
+    running: ["acknowledged", "unresolved", "failed"],
+    unresolved: ["acknowledged", "failed"],
+    acknowledged: ["acknowledged"],
+    failed: ["failed"],
+  };
+  if (!allowed[current.state].includes(input.nextState))
+    throw new AdmissionConflict(
+      "thread-create-transition-invalid",
+      "Create operation cannot replay an owned or uncertain attempt",
+    );
+  if (
+    current.response !== null &&
+    input.response !== undefined &&
+    current.response !== input.response
+  )
+    throw new AdmissionConflict(
+      "thread-create-response-conflict",
+      "Initial create acknowledgement is immutable",
+    );
+  if (
+    (current.state === "failed" || current.state === "acknowledged") &&
+    input.error !== undefined &&
+    current.error !== input.error
+  )
+    throw new AdmissionConflict(
+      "thread-create-error-conflict",
+      "Final create failure is immutable",
+    );
+  if (
+    input.nextState === "acknowledged" &&
+    (input.response ?? current.response) === null
+  )
+    throw new AdmissionConflict(
+      "thread-create-response-missing",
+      "Acknowledged create requires its immutable response",
+    );
+  if (input.response != null && input.nextState !== "acknowledged")
+    throw new AdmissionConflict(
+      "thread-create-response-invalid",
+      "Only acknowledged create can store its initial response",
+    );
+  return tx
+    .update(threadCreates)
+    .set({
+      state: input.nextState,
+      ...(input.response === undefined ? {} : { response: input.response }),
+      ...(input.error === undefined ? {} : { error: input.error }),
+      updatedAt: now,
+    })
+    .where(
+      and(
+        eq(threadCreates.namespace, input.namespace),
+        eq(threadCreates.operationId, input.operationId),
+        eq(threadCreates.ownerToken, input.ownerToken),
+        eq(threadCreates.state, input.expectedState),
+      ),
+    )
+    .returning()
+    .get()!;
+}
