+  let preparation: NativePreparation = {
+    version: 1,
+    kind: "compact-first",
+    placement,
+    stage: "before-maintenance",
+    threadId: args.thread.id,
+    maintenance: {
+      operation: {
+        namespace: `native-maintenance:${args.thread.id}`,
+        operationId: `compact:${admissionOperationKey(submission.operation.namespace, submission.operation.operationId)}`,
+      },
+      requestId: createClientTurnRequestId(),
+    },
+    continuation: {
+      payload,
+      authoredPayload: args.authoredPayload!,
+      ...(args.nativeProvenance === undefined
+        ? {}
+        : { nativeProvenance: args.nativeProvenance }),
+      ...(args.visibleHumanActivity === undefined
+        ? {}
+        : { visibleHumanActivity: args.visibleHumanActivity }),
+      origin: args.origin,
+      originPluginId: args.originPluginId,
+      startedOnBehalfOf: args.startedOnBehalfOf,
+      ...(args.p6rAuthors === undefined ? {} : { p6rAuthors: args.p6rAuthors }),
+      ...(args.p6rEditors === undefined ? {} : { p6rEditors: args.p6rEditors }),
+    },
+  };
+  const runtime = runtimes.get(deps.db);
+  if (!runtime)
+    throw new ApiError(
+      503,
+      "message_admission_recovery_not_ready",
+      "Native admission recovery is waiting for plugin startup; this message has not been accepted",
+    );
+  const service = getMessageAdmissionService(deps.db);
+  const prepared = await service.prepare({
+    submission,
+    preparation: jsonNativeAdmissionValue(preparation),
+  });
+  if (prepared.kind === "known") {
+    const { replayNativeDispatchReceipt } =
+      await import("./message-admission-dispatch.js");
+    return {
+      kind: "known",
+      outcome: replayNativeDispatchReceipt(prepared.operation),
+    };
+  }
+  let committed: OperationRecordV1 | undefined;
+  const commit = async () => {
+    if (runtimes.get(deps.db) !== runtime)
+      throw new AdmissionConflict(
+        "preparation-paused",
+        "Native preparation owner is shutting down",
+      );
+    committed = deps.db.transaction(
+      (tx) => {
+        const result = service.commit(tx, prepared.ticket, () => ({
+          details: jsonNativeAdmissionValue(preparation),
+          acceptanceReceipt: jsonNativeAdmissionValue({
+            kind: "dispatch",
+            delivery: "preparing",
+          }),
+        }));
+        return preparation.guardWait
+          ? service.updatePreparation(
+              tx,
+              submission.operation,
+              "pending",
+              "pending",
+              jsonNativeAdmissionValue(preparation),
+            )
+          : result.operation;
+      },
+      { behavior: "immediate" },
+    );
+  };
+  const { buildNativeDispatchGuardRequest, runNativePreparedGuardCheckpoint } =
+    await import("./dispatch-attempt.js");
+  const execution = resolvedThreadExecutionOptionsSchema.parse(
+    prepared.ticket.effectiveIntent.execution.configuration,
+  );
+  const guards = await runNativePreparedGuardCheckpoint(
+    deps,
+    buildNativeDispatchGuardRequest(
+      deps,
+      args,
+      execution,
+      { phase: "prepared", submissions: [prepared.ticket.submission] },
+      commit,
+    ),
+    prepared.ticket,
+  );
