+}
+
+export function configureNativeMessageAdmissionRuntime(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+): NativeMessageAdmissionRuntime {
+  const existing = runtimes.get(deps.db);
+  if (existing) return existing;
+  const service = getMessageAdmissionService(deps.db);
+  let active = true;
+  const recovery = service.configureRecovery({
+    resumePreparation: async (operation, details) => {
+      try {
+        if (
+          z.object({ kind: z.literal("message-edit") }).safeParse(details)
+            .success
+        ) {
+          const { resumeNativeMessageEdit } =
+            await import("./thread-edit-message.js");
+          return await resumeNativeMessageEdit(
+            deps,
+            operation,
+            details,
+            () => active,
+          );
+        }
+        return await resumePreparation(
+          deps,
+          operation,
+          preparationSchema.parse(details),
+          () => active,
+        );
+      } catch (error) {
+        if (
+          error instanceof AdmissionConflict &&
+          error.code === "preparation-paused" &&
+          service.preparationRecord(operation.operation)?.state === "pending"
+        )
+          return { kind: "waiting" };
+        throw error;
+      }
+    },
+    submitFeedback: async ({ feedback, parent, text }) => {
+      const thread =
+        feedback.recipientThreadId === null
+          ? null
+          : getThread(deps.db, feedback.recipientThreadId);
+      if (!thread || thread.deletedAt !== null || thread.archivedAt !== null)
+        return {
+          ...feedback,
+          status: "undeliverable",
+          reasons: [
+            {
+              code: !thread
+                ? "recipient-missing"
+                : thread.deletedAt !== null
+                  ? "recipient-deleted"
+                  : "recipient-archived",
+              message:
+                "Native feedback recipient is missing, deleted or archived; no automatic advice was submitted",
+            },
+          ],
+        };
+      if (!deps.providerRegistry.get(thread.providerId))
+        return {
+          ...feedback,
+          status: "undeliverable",
+          reasons: [
+            {
+              code: "recipient-provider-unavailable",
+              message: `Native feedback recipient provider ${thread.providerId} is not registered; no automatic advice was submitted`,
+            },
+          ],
+        };
+      const { attemptDispatch } = await import("./dispatch-attempt.js");
+      try {
+        await attemptDispatch(deps, {
+          thread,
+          payload: {
+            input: [{ type: "text", text, mentions: [] }],
+            mode: "queue-if-active",
+            senderThreadId: parent.threadId,
+            operationId: feedback.operation.operationId,
+          },
+          admissionIsActive: () => active,
+          nativeOperation: feedback.operation,
+          feedbackBinding: service.feedbackBindingFor(feedback.obligationId),
+          source: { kind: "inline" },
+          queuePayload: { kind: "inline" },
+          origin: null,
+          originPluginId: null,
+          startedOnBehalfOf: null,
+          trigger: "auto-dispatch",
+        });
+      } catch (error) {
+        const known = service.lookupOperation(feedback.operation);
+        if (
+          known?.status === "rejected" ||
+          known?.status === "unresolved" ||
+          known?.status === "conflict"
+        )
+          return {
+            ...feedback,
+            status: "blocked-by-policy",
+            reasons: [
+              ...known.reasons,
+              ...known.assessments.flatMap((assessment) =>
+                assessment.causes.map((cause) => ({
+                  code: cause.code,
+                  message: cause.message,
+                })),
+              ),
+            ],
+          };
+        throw error;
+      }
+      const known = service.lookupOperation(feedback.operation);
+      if (known?.status !== "accepted")
+        return {
+          ...feedback,
+          status: "uncertain",
+          reasons: [
+            {
+              code: "feedback-acceptance-unknown",
+              message:
+                "Normal native feedback submission did not expose a committed acceptance",
+            },
+          ],
+        };
+      return {
+        ...feedback,
+        status: "native-accepted",
+        nativeRequestId: known.delivery.requestId,
+        reasons: [],
+      } satisfies FeedbackV1;
+    },
+  });
+  const unsubscribe = deps.hub.onChangedMessage(() => recovery.wake());
+  const runtime: NativeMessageAdmissionRuntime = {
+    ...recovery,
+    dispose: () => {
+      if (!active) return;
+      active = false;
+      unsubscribe();
+      recovery.dispose();
+      runtimes.delete(deps.db);
+    },
+  };
+  runtimes.set(deps.db, runtime);
+  return runtime;
+}
+
+async function resumePreparation(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+  operation: OperationRecordV1,
+  preparation: NativePreparation,
+  isActive: () => boolean,
+): Promise<void | { kind: "waiting" }> {
+  const service = getMessageAdmissionService(deps.db);
+  if (!isActive()) return { kind: "waiting" };
+  if (operation.acceptedOriginal?.threadId !== preparation.threadId)
+    throw new Error(
+      "Preparation destination differs from its accepted original",
+    );
+  const thread = getThread(deps.db, preparation.threadId);
+  if (!thread || thread.deletedAt !== null || thread.archivedAt !== null) {
+    deps.db.transaction((tx) =>
+      service.updatePreparation(
+        tx,
+        operation.operation,
+        "pending",
+        "failed",
+        jsonNativeAdmissionValue({
+          previous: preparation,
+          reason: "Destination is no longer writable",
+        }),
+      ),
+    );
+    return;
+  }
+  if (preparation.stage === "before-maintenance") {
+    const waits = preparation.guardWait
+      ? [
+          preparation.guardWait.waiter,
+          ...preparation.guardWait.additionalWaiters,
+        ]
+      : [];
+    if (waits.some((wait) => wait.sendAt !== null && wait.sendAt > Date.now()))
+      return { kind: "waiting" };
+    const submission = service.readNativeSubmission(
+      admissionOperationKey(
+        operation.operation.namespace,
+        operation.operation.operationId,
+      ),
+    );
+    if (!submission)
+      throw new Error("Preparation lost its canonical native submission");
+    const {
+      buildNativeDispatchGuardRequest,
+      runNativePreparedGuardCheckpoint,
+      compactThreadContext,
+    } = await import("./dispatch-attempt.js");
+    const execution = resolvedThreadExecutionOptionsSchema.parse(
+      operation.acceptedOriginal!.effectiveIntent.execution.configuration,
+    );
+    const guardArgs: DispatchAttemptArgs = {
+      ...preparation.continuation,
+      thread,
+      source: { kind: "inline" },
+      queuePayload: { kind: "inline" },
+      trigger: "auto-dispatch",
+    };
+    const guards = await runNativePreparedGuardCheckpoint(
+      deps,
+      buildNativeDispatchGuardRequest(
+        deps,
+        guardArgs,
+        execution,
+        { phase: "accepted", submissions: [submission] },
+        async () => {
+          if (!isActive())
+            throw new AdmissionConflict(
+              "preparation-paused",
+              "Native preparation owner is shutting down",
+            );
+          const { guardWait: _guardWait, ...withoutWait } = preparation;
+          preparation = withoutWait;
+          deps.db.transaction(
+            (tx) =>
+              service.updatePreparation(
+                tx,
+                operation.operation,
+                "pending",
+                "effect-possible",
+                jsonNativeAdmissionValue(preparation),
+              ),
+            { behavior: "immediate" },
+          );
+          await compactThreadContext(
+            deps,
+            thread,
+            preparation.continuation.p6rAuthors,
+            {
+              operation: preparation.maintenance.operation,
+              requestId: preparation.maintenance.requestId,
+              isActive,
+            },
+          );
+          const maintenance = service.lookupOperation(
+            preparation.maintenance.operation,
+          );
+          if (
+            maintenance?.status !== "accepted" ||
+            maintenance.delivery.requestId !== preparation.maintenance.requestId
+          )
+            throw new Error(
+              "Maintenance did not commit its exact native request identity",
+            );
+          preparation = {
+            ...preparation,
+            stage: "maintenance-request-committed",
+          };
+          deps.db.transaction(
+            (tx) =>
+              service.updatePreparation(
+                tx,
+                operation.operation,
+                "effect-possible",
+                "pending",
+                jsonNativeAdmissionValue(preparation),
+              ),
+            { behavior: "immediate" },
+          );
+        },
+      ),
+    );
+    if (guards.kind === "wait") {
+      preparation = {
+        ...preparation,
+        guardWait: guardWaitSchema.parse(guards),
+      };
+      deps.db.transaction(
+        (tx) =>
+          service.updatePreparation(
+            tx,
+            operation.operation,
+            "pending",
+            "pending",
+            jsonNativeAdmissionValue(preparation),
+          ),
+        { behavior: "immediate" },
+      );
+      return { kind: "waiting" };
+    }
+  }
+  const requestId = preparation.maintenance.requestId;
+  const requested = deps.db
+    .select({ sequence: events.sequence })
+    .from(events)
+    .where(
+      and(
+        eq(events.threadId, thread.id),
+        eq(events.type, "client/turn/requested"),
+        sql`json_extract(${events.data}, '$.requestId') = ${requestId}`,
+      ),
+    )
+    .limit(1)
+    .get();
+  if (!requested)
+    throw new Error(
+      "Committed maintenance request is missing; reconcile the retained effect identity",
+    );
+  const rejected = listStoredTurnRejectedRowsByClientRequestIds(deps.db, {
+    threadId: thread.id,
+    afterSequence: requested.sequence,
+    clientRequestIds: [requestId],
+  });
+  const accepted = listStoredTurnInputAcceptedRowsByClientRequestIds(deps.db, {
+    threadId: thread.id,
+    afterSequence: requested.sequence,
+    clientRequestIds: [requestId],
+  });
+  const turns = [
+    ...new Set(
+      accepted.flatMap((row) => (row.turnId === null ? [] : [row.turnId])),
+    ),
+  ];
+  const completed = listStoredTurnCompletedRowsByTurnIds(deps.db, {
+    threadId: thread.id,
+    turnIds: turns,
+  });
+  const statuses = completed.map(
+    (row) =>
+      z
+        .object({ status: z.enum(["completed", "failed", "interrupted"]) })
+        .parse(JSON.parse(row.data)).status,
+  );
+  if (
+    rejected.length > 0 ||
+    statuses.some((status) => status !== "completed")
+  ) {
+    deps.db.transaction((tx) =>
+      service.updatePreparation(
+        tx,
+        operation.operation,
+        "pending",
+        "failed",
+        jsonNativeAdmissionValue({
+          previous: preparation,
+          reason:
+            "Exact maintenance request was rejected or its turn did not complete",
+          requestId,
+        }),
+      ),
+    );
+    return;
+  }
+  if (
+    turns.length === 0 ||
+    !turns.every((turnId) => completed.some((row) => row.turnId === turnId))
+  )
+    return { kind: "waiting" };
+  const current = getThread(deps.db, thread.id);
+  if (!current) throw new Error("Destination vanished after maintenance");
+  const { attemptDispatch } = await import("./dispatch-attempt.js");
+  const original = service.lookupOperation(
+    operation.operation,
+  )?.acceptedOriginal;
+  if (!original) throw new Error("Accepted continuation original is missing");
+  if (!isActive()) return { kind: "waiting" };
+  try {
+    await attemptDispatch(deps, {
+      admissionIsActive: isActive,
+      ...preparation.continuation,
+      thread: current,
+      payload: {
+        ...preparation.continuation.payload,
+        input: z.array(promptInputSchema).parse(original.rawInput),
+      },
+      preparationOperation: operation.operation,
+      preparationPlacement: preparation.placement,
+      source: { kind: "inline" },
+      queuePayload: { kind: "inline" },
+      trigger: "auto-dispatch",
+    });
+  } catch (error) {
+    if (
+      error instanceof AdmissionConflict &&
+      error.code === "preparation-paused"
+    )
+      return { kind: "waiting" };
+    if (
+      error instanceof ApiError &&
+      error.body.code === "message_admission_conflict" &&
+      z
+        .object({ reason: z.literal("preparation-paused") })
+        .safeParse(error.body.details).success
+    )
+      return { kind: "waiting" };
+    throw error;
+  }
+}
