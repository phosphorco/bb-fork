new file mode 100644
index 0000000000000000000000000000000000000000..dc12b1ce69be91c8585b46f220c5d5390c0a4d45
--- /dev/null
+++ b/apps/server/src/services/threads/message-admission-recovery.ts
@@ -0,0 +1,312 @@
+import { pendingAdmissionRecovery } from "@bb/db";
+import type {
+  SubmissionV1,
+  FeedbackV1,
+  JsonValue,
+  OperationKey,
+  OperationRecordV1,
+} from "@phosphorco/bb-message-admission/protocol";
+import type { MessageAdmissionService } from "./message-admission.js";
+
+export interface NativeAdmissionRecoveryPorts {
+  resumePreparation(
+    operation: OperationRecordV1,
+    preparation: JsonValue,
+  ): Promise<void | { kind: "waiting" }>;
+  submitFeedback(input: {
+    feedback: FeedbackV1;
+    parent: Pick<SubmissionV1, "threadId" | "source" | "original">;
+    text: string;
+  }): Promise<FeedbackV1>;
+}
+
+export class MessageAdmissionRecovery {
+  private disposed = false;
+  private scheduled = false;
+  private sweeping: Promise<void> | null = null;
+  private readonly preparations = new Map<string, Promise<void>>();
+  private readonly feedback = new Map<string, Promise<void>>();
+  private readonly attemptedFeedback = new Set<string>();
+  private readonly timer: ReturnType<typeof setInterval>;
+  constructor(
+    private readonly service: MessageAdmissionService,
+    private readonly ports: NativeAdmissionRecoveryPorts,
+  ) {
+    this.timer = setInterval(() => this.wake(), 30_000);
+    this.timer.unref();
+    this.wake();
+  }
+
+  wake(): void {
+    if (this.disposed || this.scheduled) return;
+    this.scheduled = true;
+    queueMicrotask(() => {
+      this.scheduled = false;
+      if (this.disposed) return;
+      void this.catchUp().catch((error: unknown) =>
+        this.service.recordRecoveryError("catch-up", error),
+      );
+    });
+  }
+
+  async catchUp(): Promise<void> {
+    if (this.disposed) return;
+    if (this.sweeping) return this.sweeping;
+    const work = this.scan();
+    this.sweeping = work;
+    try {
+      await work;
+    } finally {
+      if (this.sweeping === work) this.sweeping = null;
+    }
+  }
+
+  private async scan(): Promise<void> {
+    for (const kind of ["preparations", "feedback"] as const) {
+      let afterId = "";
+      while (!this.disposed) {
+        const page = pendingAdmissionRecovery(this.service.db, 100, afterId)[
+          kind
+        ];
+        if (page.length === 0) break;
+        for (const row of page) {
+          if (this.disposed) break;
+          if (kind === "preparations") {
+            const operation = this.service.lookupOperationById(row.id);
+            if (operation) await this.recoverOperation(operation.operation);
+          } else await this.recoverFeedback(row.id);
+        }
+        afterId = page.at(-1)!.id;
+      }
+    }
+  }
+
+  async recoverOperation(operation: OperationKey): Promise<void> {
+    if (this.disposed) return;
+    const row = this.service.preparationRecord(operation);
+    if (!row) return;
+    const current = this.preparations.get(row.id);
+    if (current) return current;
+    const work = Promise.resolve().then(async () => {
+      const original = this.service.preparationRecord(operation);
+      if (!original) return;
+      if (original.state === "effect-possible") {
+        this.service.db.transaction((tx) =>
+          this.service.updatePreparation(
+            tx,
+            operation,
+            "effect-possible",
+            "uncertain",
+            {
+              previous: original.details,
+              reason:
+                "Native process ended after an effect became possible; reconcile the stored native effect identity before continuing",
+            },
+          ),
+        );
+        return;
+      }
+      if (original.state !== "pending") return;
+      const record = this.service.lookupOperation(operation);
+      if (!record) return;
+      try {
+        const outcome = await this.ports.resumePreparation(
+          record,
+          original.details,
+        );
+        const remaining = this.service.preparationRecord(operation);
+        if (
+          outcome &&
+          outcome.kind === "waiting" &&
+          remaining?.state === "pending"
+        )
+          return;
+        if (
+          remaining?.state === "pending" ||
+          remaining?.state === "effect-possible"
+        )
+          this.service.db.transaction((tx) =>
+            this.service.updatePreparation(
+              tx,
+              operation,
+              remaining.state === "pending" ? "pending" : "effect-possible",
+              remaining.state === "pending" ? "failed" : "uncertain",
+              {
+                previous: remaining.details,
+                reason:
+                  "Native preparation handler returned without a committed sink or an explicit disposition",
+              },
+            ),
+          );
+      } catch (error) {
+        const remaining = this.service.preparationRecord(operation);
+        if (
+          remaining?.state === "pending" ||
+          remaining?.state === "effect-possible"
+        )
+          this.service.db.transaction((tx) =>
+            this.service.updatePreparation(
+              tx,
+              operation,
+              remaining.state === "pending" ? "pending" : "effect-possible",
+              remaining.state === "pending" ? "failed" : "uncertain",
+              {
+                previous: remaining.details,
+                error: error instanceof Error ? error.message : String(error),
+              },
+            ),
+          );
+        this.service.recordRecoveryError(original.id, error);
+      }
+    });
+    this.preparations.set(row.id, work);
+    try {
+      await work;
+    } finally {
+      if (this.preparations.get(row.id) === work)
+        this.preparations.delete(row.id);
+    }
+  }
+
+  async recoverFeedback(id: string): Promise<void> {
+    if (this.disposed) return;
+    const current = this.feedback.get(id);
+    if (current) return current;
+    const work = Promise.resolve().then(async () => {
+      const pending = this.service.feedbackRecord(id);
+      if (!pending) return;
+      const known = this.service.lookupOperation(pending.feedback.operation);
+      if (pending.row.state !== "accepted" && known?.status === "accepted") {
+        this.service.setFeedbackDisposition(id, pending.row.state, {
+          ...pending.feedback,
+          status: "native-accepted",
+          nativeRequestId: known.delivery.requestId,
+          reasons: [],
+        });
+        return;
+      }
+      if (pending.row.state === "claimed") {
+        this.service.setFeedbackDisposition(id, "claimed", {
+          ...pending.feedback,
+          status: "uncertain",
+          reasons: [
+            {
+              code: "feedback-effect-unknown",
+              message:
+                "A previous native submission may have happened; reconcile its stable operation before retry",
+            },
+          ],
+        });
+        return;
+      }
+      if (pending.row.state !== "pending" || this.attemptedFeedback.has(id))
+        return;
+      this.attemptedFeedback.add(id);
+      const parent = this.service.lookupOperationById(
+        pending.row.parentOperationId,
+      );
+      if (!parent) return;
+      const parentBasis =
+        parent.acceptedOriginal ??
+        (parent.status === "rejected"
+          ? this.service.readNativeSubmission(pending.row.parentOperationId)
+          : null);
+      if (!parentBasis) return;
+      if (parent.delivery.state === "cancelled") {
+        this.service.setFeedbackDisposition(id, "pending", {
+          ...pending.feedback,
+          status: "superseded-without-send",
+          reasons: [
+            {
+              code: "parent-cancelled",
+              message: "Original was cancelled before feedback submission",
+            },
+          ],
+        });
+        return;
+      }
+      if (pending.feedback.recipientThreadId === null) {
+        this.service.setFeedbackDisposition(id, "pending", {
+          ...pending.feedback,
+          status: "undeliverable",
+          reasons: [
+            {
+              code: "recipient-unknown",
+              message: "Original has no known sending thread",
+            },
+          ],
+        });
+        return;
+      }
+      if (pending.feedback.recipientThreadId === parentBasis.threadId) {
+        this.service.setFeedbackDisposition(id, "pending", {
+          ...pending.feedback,
+          status: "undeliverable",
+          reasons: [
+            {
+              code: "recipient-is-destination",
+              message:
+                "Rejected original cannot send automatic advice to its own destination",
+            },
+          ],
+        });
+        return;
+      }
+      try {
+        this.service.claimFeedback(id);
+        const result = await this.ports.submitFeedback({
+          feedback: pending.feedback,
+          parent: parentBasis,
+          text: pending.text,
+        });
+        this.service.setFeedbackDisposition(id, "claimed", result);
+      } catch (error) {
+        const latest = this.service.feedbackRecord(id);
+        if (latest?.row.state === "claimed") {
+          const known = this.service.lookupOperation(
+            pending.feedback.operation,
+          );
+          this.service.setFeedbackDisposition(
+            id,
+            "claimed",
+            known?.status === "accepted"
+              ? {
+                  ...pending.feedback,
+                  status: "native-accepted",
+                  nativeRequestId: known.delivery.requestId,
+                  reasons: [],
+                }
+              : {
+                  ...pending.feedback,
+                  status: "uncertain",
+                  reasons: [
+                    {
+                      code: "feedback-effect-unknown",
+                      message:
+                        error instanceof Error ? error.message : String(error),
+                    },
+                  ],
+                },
+          );
+        }
+        this.service.recordRecoveryError(id, error);
+      }
+    });
+    this.feedback.set(id, work);
+    try {
+      await work;
+    } finally {
+      if (this.feedback.get(id) === work) this.feedback.delete(id);
+      if (
+        this.service.db.$client.open &&
+        this.service.feedbackRecord(id)?.row.state !== "pending"
+      )
+        this.attemptedFeedback.delete(id);
+    }
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    clearInterval(this.timer);
+  }
+}
