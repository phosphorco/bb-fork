diff --git a/packages/thread-view/test/message-originals.p6r.test.ts b/packages/thread-view/test/message-originals.p6r.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..24dd4f9a6d5cb4b8b144558b7283e986242d42b5
--- /dev/null
+++ b/packages/thread-view/test/message-originals.p6r.test.ts
@@ -0,0 +1,149 @@
+import { describe, expect, it } from "vitest";
+import type { MessageOriginal, P6rMessageAuthor } from "@bb/domain";
+import {
+  createTimelineEventFactory,
+  decodeThreadEventRow,
+} from "./timeline-test-harness.js";
+import { parseUsersFromClientRequest } from "../src/user-message-parsing.js";
+
+function original(
+  id: string,
+  initiator: "user" | "agent",
+  senderThreadId: string | null,
+): MessageOriginal {
+  const author: P6rMessageAuthor = {
+    evidence: "machine",
+    identity: { kind: "machine", key: id, instanceId: id, hostId: null },
+    presentation: { displayName: id, handle: null, avatarUrl: null },
+  };
+  return {
+    originalId: id,
+    revisionId: `revision-${id}`,
+    operationId: `operation-${id}`,
+    rawInput: [
+      { type: "text", text: `raw-${id}`, mentions: [] },
+      {
+        type: "localFile",
+        path: `/tmp/${id}.txt`,
+        name: `${id}.txt`,
+        sizeBytes: 20,
+      },
+    ],
+    source: {
+      source: "tell",
+      initiator,
+      senderThreadId,
+      origin: null,
+      originPluginId: null,
+      requestedBy: null,
+      rendering: "host",
+    },
+    author,
+    editor: null,
+    acceptedAt: 12,
+    requestedIntent: { mode: "queue", sendAt: null },
+    effectiveIntent: { mode: "queue-batched", sendAt: null },
+  };
+}
+describe("original manifest projection", () => {
+  it("uses each original source, raw files and attribution before scalar lead summaries", () => {
+    const factory = createTimelineEventFactory({ threadId: "thread-1" });
+    const row = factory.clientTurnRequested({
+      text: "flattened compatibility",
+      initiator: "agent",
+      senderThreadId: "lead",
+      inputGroups: [
+        [{ type: "text", text: "formatted A", mentions: [] }],
+        [{ type: "text", text: "formatted B", mentions: [] }],
+      ],
+      target: { kind: "new-turn" },
+    });
+    const manifest = [
+      original("A", "agent", "sender-A"),
+      original("B", "user", null),
+    ];
+    const { event: baseline, meta } = decodeThreadEventRow(row);
+    const oldMessages = parseUsersFromClientRequest({
+      decoded: baseline,
+      meta,
+      options: { threadStatus: "active", threadName: "" },
+    });
+    const { event } = decodeThreadEventRow({
+      ...row,
+      data: { ...row.data, originalManifest: manifest },
+    });
+    const messages = parseUsersFromClientRequest({
+      decoded: event,
+      meta,
+      options: { threadStatus: "active", threadName: "" },
+    });
+    expect(
+      messages.map((message) => [
+        message.originalId,
+        message.initiator,
+        message.senderThreadId,
+        message.text,
+        message.p6rAuthor?.identity.key,
+        message.attachments?.localFilePaths,
+      ]),
+    ).toEqual([
+      ["A", "agent", "sender-A", "raw-A", "A", ["/tmp/A.txt"]],
+      ["B", "user", null, "raw-B", "B", ["/tmp/B.txt"]],
+    ]);
+    expect(messages.map((message) => message.id)).toEqual(
+      oldMessages.map((message) => message.id),
+    );
+  });
+  it("retains historical scalar fallback without manufacturing original identities", () => {
+    const factory = createTimelineEventFactory({ threadId: "thread-1" });
+    const { event, meta } = decodeThreadEventRow(
+      factory.clientTurnRequested({
+        text: "historical",
+        initiator: "agent",
+        senderThreadId: "old",
+      }),
+    );
+    expect(
+      parseUsersFromClientRequest({
+        decoded: event,
+        meta,
+        options: { threadStatus: "active", threadName: "" },
+      })[0],
+    ).toMatchObject({ senderThreadId: "old", text: "historical" });
+    expect(
+      parseUsersFromClientRequest({
+        decoded: event,
+        meta,
+        options: { threadStatus: "active", threadName: "" },
+      })[0]?.originalId,
+    ).toBeUndefined();
+  });
+});
+
+it("keeps an exact retained canonical retry from projecting duplicate authored originals", () => {
+  const factory = createTimelineEventFactory({ threadId: "thread-1" });
+  const row = factory.clientTurnRequested({
+    text: "retained formatted input",
+    initiator: "system",
+    target: { kind: "new-turn" },
+  });
+  const { event, meta } = decodeThreadEventRow({
+    ...row,
+    data: {
+      ...row.data,
+      retryOfRequestId: "creq_2222222222",
+      retryAttempt: 2,
+      originalManifest: [
+        original("A", "agent", "sender-A"),
+        original("B", "user", null),
+      ],
+    },
+  });
+  expect(
+    parseUsersFromClientRequest({
+      decoded: event,
+      meta,
+      options: { threadStatus: "active", threadName: "" },
+    }),
+  ).toEqual([]);
+});
