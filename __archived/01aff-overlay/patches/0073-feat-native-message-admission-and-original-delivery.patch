diff --git a/apps/server/src/services/threads/message-admission-capture.ts b/apps/server/src/services/threads/message-admission-capture.ts
new file mode 100644
index 0000000000000000000000000000000000000000..61d73b492e6c19b4c6082595814d005dd19a9834
--- /dev/null
+++ b/apps/server/src/services/threads/message-admission-capture.ts
@@ -0,0 +1,400 @@
+import {
+  AdmissionConflict,
+  admissionDigest,
+  events,
+  projects,
+  threads,
+  type DbQueryConnection,
+} from "@bb/db";
+import { and, desc, eq, gt, lte, sql } from "drizzle-orm";
+import type {
+  PolicyContextV1,
+  SubmissionV1,
+} from "@phosphorco/bb-message-admission/protocol";
+
+export const NATIVE_ADMISSION_HISTORY_LIMIT = 2000;
+export const NATIVE_ADMISSION_EVIDENCE_BYTES = 1_048_576;
+export type AdmissionMetadataKey =
+  | "projectId"
+  | "environmentId"
+  | "providerId"
+  | "executionRevision"
+  | "parentThreadId"
+  | "visibility"
+  | "title"
+  | "status";
+export interface NativeHistorySelection {
+  threadId: string;
+  limit: number;
+  metadata: readonly AdmissionMetadataKey[];
+  retainedThroughSequence: number | null;
+  sinceClear?: boolean;
+}
+export interface NativeHistoryCapture {
+  selection: NativeHistorySelection;
+  asOfSequence: number;
+  latestClearSequence: number | null;
+  prefixCount: number;
+  events: {
+    id: string;
+    sequence: number;
+    type: string;
+    data: string;
+    createdAt: number;
+    providerThreadId: string | null;
+    scopeKind: string;
+    turnId: string | null;
+  }[];
+  lineage: {
+    id: string;
+    sequence: number;
+    providerThreadId: string | null;
+    data: string;
+  } | null;
+  metadata: Partial<Record<AdmissionMetadataKey, string | number | null>>;
+  coverage: "complete" | "window";
+  missingReason: string | null;
+  digest: string;
+}
+const contextThreadFields = {
+  id: threads.id,
+  projectId: threads.projectId,
+  title: threads.title,
+  deletedAt: threads.deletedAt,
+};
+type ContextThread = {
+  id: string;
+  projectId: string;
+  title: string | null;
+  deletedAt: number | null;
+};
+export interface NativePolicyContextCapture {
+  project: { id: string; name: string; deletedAt: number | null };
+  destination: ContextThread | null;
+  sender: ContextThread | null;
+  senderThreadId: string | null;
+  destinationThreadId: string;
+  policyContext: PolicyContextV1;
+}
+
+export function captureNativePolicyContext(
+  db: DbQueryConnection,
+  submission: SubmissionV1,
+): NativePolicyContextCapture {
+  if (submission.projectId === null)
+    throw new AdmissionConflict(
+      "project-required",
+      "Native admission requires the destination project",
+    );
+  const project = db
+    .select({
+      id: projects.id,
+      name: projects.name,
+      deletedAt: projects.deletedAt,
+    })
+    .from(projects)
+    .where(eq(projects.id, submission.projectId))
+    .get();
+  if (!project || project.deletedAt !== null)
+    throw new AdmissionConflict(
+      "project-unavailable",
+      "Admission project is missing or deleted",
+    );
+  const destination =
+    db
+      .select(contextThreadFields)
+      .from(threads)
+      .where(eq(threads.id, submission.threadId))
+      .get() ?? null;
+  const sender =
+    submission.source.senderThreadId === null
+      ? null
+      : (db
+          .select(contextThreadFields)
+          .from(threads)
+          .where(eq(threads.id, submission.source.senderThreadId))
+          .get() ?? null);
+  const policyContext: PolicyContextV1 = {
+    messageText: submission.policyContext.messageText,
+    projectTitle: project.name,
+    destinationTitle:
+      destination === null
+        ? submission.policyContext.destinationTitle
+        : destination.title,
+    senderTitle: sender?.title ?? null,
+  };
+  if (
+    destination &&
+    (destination.deletedAt !== null || destination.projectId !== project.id)
+  )
+    throw new AdmissionConflict(
+      "destination-context-conflict",
+      "Admission destination changed project or was deleted",
+    );
+  if (
+    policyContext.projectTitle !== submission.policyContext.projectTitle ||
+    policyContext.senderTitle !== submission.policyContext.senderTitle ||
+    policyContext.destinationTitle !== submission.policyContext.destinationTitle
+  )
+    throw new AdmissionConflict(
+      "policy-context-stale",
+      "Native project, sender or destination title changed before evaluation",
+    );
+  return {
+    project,
+    destination,
+    sender,
+    senderThreadId: submission.source.senderThreadId,
+    destinationThreadId: submission.threadId,
+    policyContext,
+  };
+}
+
+export function validateNativePolicyContext(
+  db: DbQueryConnection,
+  captured: NativePolicyContextCapture,
+  allowMissingDestination = false,
+): void {
+  const project = db
+    .select({
+      id: projects.id,
+      name: projects.name,
+      deletedAt: projects.deletedAt,
+    })
+    .from(projects)
+    .where(eq(projects.id, captured.project.id))
+    .get();
+  const destination =
+    db
+      .select(contextThreadFields)
+      .from(threads)
+      .where(eq(threads.id, captured.destinationThreadId))
+      .get() ?? null;
+  const sender =
+    captured.senderThreadId === null
+      ? null
+      : (db
+          .select(contextThreadFields)
+          .from(threads)
+          .where(eq(threads.id, captured.senderThreadId))
+          .get() ?? null);
+  const expectedDestination =
+    captured.destination === null &&
+    destination === null &&
+    allowMissingDestination
+      ? null
+      : (captured.destination ?? {
+          id: captured.destinationThreadId,
+          projectId: captured.project.id,
+          title: captured.policyContext.destinationTitle,
+          deletedAt: null,
+        });
+  if (
+    JSON.stringify(project) !== JSON.stringify(captured.project) ||
+    JSON.stringify(destination) !== JSON.stringify(expectedDestination) ||
+    JSON.stringify(sender) !== JSON.stringify(captured.sender)
+  )
+    throw new AdmissionConflict(
+      "policy-context-stale",
+      "Selected routing metadata or its negative facts changed before acceptance",
+    );
+}
+
+function latestClear(db: DbQueryConnection, threadId: string): number | null {
+  return (
+    db
+      .select({ sequence: events.sequence })
+      .from(events)
+      .where(
+        and(
+          eq(events.threadId, threadId),
+          eq(events.type, "system/operation"),
+          sql`CASE WHEN json_valid(${events.data}) THEN json_extract(${events.data}, '$.operation') = 'context_clear' AND json_extract(${events.data}, '$.status') = 'completed' ELSE 0 END`,
+        ),
+      )
+      .orderBy(desc(events.sequence))
+      .limit(1)
+      .get()?.sequence ?? null
+  );
+}
+
+function captureAt(
+  db: DbQueryConnection,
+  selection: NativeHistorySelection,
+  asOfSequence: number,
+): NativeHistoryCapture {
+  const thread = db
+    .select()
+    .from(threads)
+    .where(eq(threads.id, selection.threadId))
+    .get();
+  if (!thread || thread.deletedAt !== null)
+    throw new AdmissionConflict(
+      "evidence-thread-unavailable",
+      "Evidence thread is missing or deleted",
+    );
+  const latestClearSequence = latestClear(db, selection.threadId);
+  const boundary = Math.min(
+    asOfSequence,
+    selection.retainedThroughSequence ?? asOfSequence,
+  );
+  if (
+    selection.retainedThroughSequence !== null &&
+    latestClearSequence !== null &&
+    latestClearSequence > boundary
+  )
+    throw new AdmissionConflict(
+      "candidate-prefix-cleared",
+      "Candidate prefix predates a native context clear",
+    );
+  const where = and(
+    eq(events.threadId, selection.threadId),
+    lte(events.sequence, boundary),
+    selection.sinceClear && latestClearSequence !== null
+      ? gt(events.sequence, latestClearSequence)
+      : undefined,
+  );
+  const prefixCount =
+    db
+      .select({ count: sql<number>`count(*)` })
+      .from(events)
+      .where(where)
+      .get()?.count ?? 0;
+  const rows = db
+    .select({
+      id: events.id,
+      sequence: events.sequence,
+      type: events.type,
+      data: events.data,
+      createdAt: events.createdAt,
+      providerThreadId: events.providerThreadId,
+      scopeKind: events.scopeKind,
+      turnId: events.turnId,
+    })
+    .from(events)
+    .where(where)
+    .orderBy(desc(events.sequence))
+    .limit(selection.limit)
+    .all()
+    .reverse();
+  const metadata: NativeHistoryCapture["metadata"] = {};
+  for (const key of selection.metadata) metadata[key] = thread[key];
+  const lineage =
+    db
+      .select({
+        id: events.id,
+        sequence: events.sequence,
+        providerThreadId: events.providerThreadId,
+        data: events.data,
+      })
+      .from(events)
+      .where(
+        and(
+          eq(events.threadId, selection.threadId),
+          eq(events.type, "thread/identity"),
+        ),
+      )
+      .orderBy(desc(events.sequence))
+      .limit(1)
+      .get() ?? null;
+  const firstExpected =
+    selection.sinceClear && latestClearSequence !== null
+      ? latestClearSequence + 1
+      : 1;
+  const contiguous = rows.every(
+    (row, index) =>
+      index === 0 || row.sequence === rows[index - 1]!.sequence + 1,
+  );
+  const selectedWindowComplete =
+    rows.length === selection.limit
+      ? contiguous && rows.at(-1)?.sequence === boundary
+      : prefixCount === Math.max(0, boundary - firstExpected + 1) && contiguous;
+  const truncated = rows.some((row) => {
+    const data: unknown = JSON.parse(row.data);
+    if (
+      typeof data !== "object" ||
+      data === null ||
+      !("item" in data) ||
+      typeof data.item !== "object" ||
+      data.item === null ||
+      !("truncation" in data.item)
+    )
+      return false;
+    return (
+      typeof data.item.truncation === "object" &&
+      data.item.truncation !== null &&
+      Object.keys(data.item.truncation).length > 0
+    );
+  });
+  const missingReason = truncated
+    ? "Native persisted output is truncated; retained external output was not hydrated"
+    : !selectedWindowComplete
+      ? "Requested native history window has missing sequence facts"
+      : null;
+  const value = {
+    selection,
+    asOfSequence,
+    latestClearSequence,
+    lineage,
+    prefixCount,
+    events: rows,
+    metadata,
+    coverage:
+      missingReason === null ? ("complete" as const) : ("window" as const),
+    missingReason,
+  };
+  const bytes = JSON.stringify(value);
+  if (Buffer.byteLength(bytes, "utf8") > NATIVE_ADMISSION_EVIDENCE_BYTES)
+    throw new AdmissionConflict(
+      "evidence-capacity",
+      "Selected evidence exceeds 1048576 UTF-8 bytes; no partial evidence was returned",
+    );
+  return { ...value, digest: admissionDigest(bytes) };
+}
+
+export function captureNativeAdmissionHistory(
+  db: DbQueryConnection,
+  selection: NativeHistorySelection,
+): NativeHistoryCapture {
+  if (
+    !Number.isSafeInteger(selection.limit) ||
+    selection.limit < 1 ||
+    selection.limit > NATIVE_ADMISSION_HISTORY_LIMIT
+  )
+    throw new AdmissionConflict(
+      "evidence-capacity",
+      "History limit must be 1..2000",
+    );
+  if (
+    selection.retainedThroughSequence !== null &&
+    (!Number.isSafeInteger(selection.retainedThroughSequence) ||
+      selection.retainedThroughSequence < 0)
+  )
+    throw new AdmissionConflict(
+      "invalid-evidence-prefix",
+      "Retained history sequence must be nonnegative",
+    );
+  const asOfSequence =
+    db
+      .select({ sequence: events.sequence })
+      .from(events)
+      .where(eq(events.threadId, selection.threadId))
+      .orderBy(desc(events.sequence))
+      .limit(1)
+      .get()?.sequence ?? 0;
+  return captureAt(db, selection, asOfSequence);
+}
+
+export function validateNativeAdmissionHistory(
+  db: DbQueryConnection,
+  capture: NativeHistoryCapture,
+): void {
+  if (
+    captureAt(db, capture.selection, capture.asOfSequence).digest !==
+    capture.digest
+  )
+    throw new AdmissionConflict(
+      "evidence-stale",
+      "Selected history, metadata, reset lineage, or negative query facts changed before acceptance",
+    );
+}
