@@ -0,0 +1,579 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { and, eq } from "drizzle-orm";
+import {
+  admissionDigest,
+  getThread,
+  listEvents,
+  listQueuedThreadMessages,
+  messageAdmissionOperations,
+  setThreadExecutionOverride,
+  setThreadStartupContext,
+} from "@bb/db";
+import {
+  canonicalJson,
+  reduceObservations,
+  type EvaluatorV1,
+  type RuleObservationV1,
+} from "@phosphorco/bb-message-admission/protocol";
+import { applyLoggedThreadLifecycleEvent } from "../../../src/services/threads/lifecycle-outcome.js";
+import { clearQueuedMessageWait } from "../../../src/services/threads/queue-waits.js";
+import { sendNextQueuedMessageIfPresent } from "../../../src/services/threads/queued-messages.js";
+import { createP6rNativeAcceptance } from "../../../src/services/p6r/native-acceptance.js";
+import type { P6rNativeAcceptance } from "../../../src/services/p6r/identity-protocol.js";
+import {
+  lookupP6rOperationReceipt,
+  listP6rAttempts,
+  listP6rContributions,
+} from "../../../src/services/p6r/sidecar-store.js";
+import { p6rOperationReceipts } from "../../../src/services/p6r/sidecar-schema.js";
+import { getMessageAdmissionService } from "../../../src/services/threads/message-admission.js";
+import {
+  invokePluginInline,
+  pluginHookProvider,
+  setPluginHookProvider,
+  type PluginHookRegistration,
+} from "../../../src/services/plugins/plugin-hook-registry.js";
+import type { PluginHookName } from "@get-bb/plugin-sdk";
+import {
+  seedEnvironment,
+  seedHostSession,
+  seedProjectWithSource,
+  seedThread,
+  seedThreadRuntimeState,
+  seedTurnStarted,
+} from "../../helpers/seed.js";
+import {
+  withTestHarness,
+  type TestAppHarness,
+} from "../../helpers/test-app.js";
+
+const cleanups: (() => void)[] = [];
+afterEach(() => {
+  for (const cleanup of cleanups.splice(0)) cleanup();
+});
+const paths = ["idle", "steer", "pending", "busy-queue"] as const;
+type Path = (typeof paths)[number];
+function fixture(harness: TestAppHarness, path: Path) {
+  const { host } = seedHostSession(harness.deps, {
+    id: `p6r-admission-${path}`,
+  });
+  const { project } = seedProjectWithSource(harness.deps, {
+    hostId: host.id,
+    path: `/tmp/p6r-admission-${path}`,
+  });
+  const environment = seedEnvironment(harness.deps, {
+    hostId: host.id,
+    projectId: project.id,
+    path: `/tmp/p6r-admission-${path}`,
+    status: "ready",
+  });
+  const thread = seedThread(harness.deps, {
+    environmentId: environment.id,
+    projectId: project.id,
+    status:
+      path === "pending" ? "pending" : path === "idle" ? "idle" : "active",
+  });
+  setThreadExecutionOverride(harness.db, {
+    threadId: thread.id,
+    modelOverride: "gpt-5",
+  });
+  if (path === "pending")
+    setThreadStartupContext(harness.db, {
+      threadId: thread.id,
+      startupContext: JSON.stringify({
+        kind: "pending",
+        environmentIntent: { environmentId: environment.id, type: "reuse" },
+        fork: null,
+        startedOnBehalfOf: null,
+        titleProvided: false,
+      }),
+    });
+  else {
+    seedThreadRuntimeState(harness.deps, {
+      environmentId: environment.id,
+      providerThreadId: `provider-${path}`,
+      threadId: thread.id,
+    });
+    if (path !== "idle")
+      seedTurnStarted(harness.deps, {
+        environmentId: environment.id,
+        providerThreadId: `provider-${path}`,
+        threadId: thread.id,
+        turnId: `turn-${path}`,
+      });
+  }
+  const operation: P6rNativeAcceptance = {
+    input: {
+      threadId: thread.id,
+      operationId: `operation-${path}`,
+      mode:
+        path === "steer"
+          ? "steer-if-active"
+          : path === "busy-queue"
+            ? "queue-if-active"
+            : "start",
+      input: [{ type: "text", text: "Exact P6r authored input", mentions: [] }],
+    },
+    authorEvidence: {
+      evidence: "integration-asserted",
+      identity: {
+        kind: "external",
+        key: "external:producer/subject",
+        pluginId: "producer",
+        subject: "subject",
+      },
+      presentation: {
+        displayName: "External source",
+        avatarUrl: null,
+        handle: null,
+      },
+    },
+    operationNamespace: "instance:producer",
+    payloadHash: `payload-${path}`,
+    source: "external",
+    validate: () => ({ ok: true }),
+  };
+  const accept = createP6rNativeAcceptance({
+    deps: harness.deps,
+    now: () => 100,
+    retentionMs: 1000,
+  });
+  return { project, thread, operation, accept };
+}
+async function policy(
+  harness: TestAppHarness,
+  projectId: string,
+  evaluator: EvaluatorV1,
+) {
+  const service = getMessageAdmissionService(harness.db),
+    handle = service.createPluginHandle("message-rules");
+  handle.activate();
+  cleanups.push(handle.retire);
+  await handle.protocol.registerEvaluator(
+    { version: 1, evaluatorVersion: "p6r-native-test" },
+    evaluator,
+  );
+  const result = await handle.protocol.publish({
+    version: 1,
+    providerId: "message-rules",
+    operation: { namespace: "p6r-test-publication", operationId: "publish" },
+    expectedActivePublication: null,
+    evaluatorVersion: "p6r-native-test",
+    configurationVersion: "1",
+    snapshotBytes: canonicalJson({ scope: "explicit-test-project" }, 4096),
+    enrollment: { mode: "enforce", projectIds: [projectId] },
+  });
+  expect(result.status).toBe("published");
+  return service;
+}
+function hooks(handler: PluginHookRegistration<"message.dispatch">["handler"]) {
+  const previous = pluginHookProvider();
+  cleanups.push(() => setPluginHookProvider(previous));
+  const registry: { [K in PluginHookName]: PluginHookRegistration<K>[] } = {
+    "message.dispatch": [{ pluginId: "actual-legacy-guard", handler }],
+  };
+  setPluginHookProvider({
+    listHooks: (name) => registry[name],
+    invokeHook: (_pluginId, _label, run) => invokePluginInline(run),
+    decisionTimeoutMs: 1000,
+  });
+}
+function requests(harness: TestAppHarness, threadId: string) {
+  return listEvents(harness.db, { threadId }).filter(
+    (event) => event.type === "client/turn/requested",
+  );
+}
+
+describe("production P6r ingress through native admission and common dispatcher", () => {
+  it.each(paths)(
+    "routes %s through MR then native guards and preserves exact P6r receipts/provenance on replay",
+    async (path) => {
+      await withTestHarness(async (harness) => {
+        const f = fixture(harness, path);
+        let evaluations = 0,
+          guardCalls = 0;
+        const service = await policy(harness, f.project.id, (request) => {
+          evaluations++;
+          expect(request.submission.operation).toEqual({
+            namespace: f.operation.operationNamespace,
+            operationId: f.operation.input.operationId,
+          });
+          expect(request.submission.rawInput).toEqual(f.operation.input.input);
+          expect(request.submission.source.visibleHumanActivity).toBe(false);
+          expect(request.submission.source.origin).toMatchObject({
+            nativeProvenance: {
+              kind: "p6r",
+              source: "external",
+              operationNamespace: f.operation.operationNamespace,
+              operationId: f.operation.input.operationId,
+              payloadHash: f.operation.payloadHash,
+              authorEvidence: f.operation.authorEvidence,
+            },
+          });
+          return reduceObservations({
+            assessmentId: request.assessmentId,
+            observations: [],
+            complete: true,
+          });
+        });
+        hooks((context) => {
+          guardCalls++;
+          expect(evaluations).toBe(1);
+          expect(context.experimental_admission?.phase).toBe(
+            guardCalls === 1 ? "prepared" : "accepted",
+          );
+          expect(context.attempt).toBe(
+            path === "steer" ? "join-turn" : "start-turn",
+          );
+          return { action: "proceed" };
+        });
+        const before = requests(harness, f.thread.id).length;
+        const first = await f.accept(f.operation);
+        expect(first.status).toBe(
+          path === "busy-queue" ? "indeterminate" : "submitted",
+        );
+        const key = {
+          namespace: f.operation.operationNamespace,
+          operationId: f.operation.input.operationId,
+        };
+        const native = service.lookupOperation(key)!;
+        expect(native.status).toBe("accepted");
+        expect(native.acceptedOriginal?.source.visibleHumanActivity).toBe(
+          false,
+        );
+        const receipt = lookupP6rOperationReceipt(
+          harness.db,
+          key.namespace,
+          key.operationId,
+        )!;
+        expect(receipt).toMatchObject({
+          operationNamespace: key.namespace,
+          operationId: key.operationId,
+          payloadHash: f.operation.payloadHash,
+          threadId: f.thread.id,
+          status: path === "busy-queue" ? "pending" : "accepted",
+        });
+        expect(requests(harness, f.thread.id)).toHaveLength(
+          before + (path === "busy-queue" ? 0 : 1),
+        );
+        expect(listQueuedThreadMessages(harness.db, f.thread.id)).toHaveLength(
+          path === "busy-queue" ? 1 : 0,
+        );
+        const replay = await f.accept({
+          ...f.operation,
+          validate: () => ({ ok: false, code: "retired" }),
+        });
+        expect(replay).toEqual(first);
+        expect(evaluations).toBe(1);
+        expect(guardCalls).toBe(1);
+        expect(
+          await f.accept({
+            ...f.operation,
+            payloadHash: "changed-payload",
+            input: {
+              ...f.operation.input,
+              input: [{ type: "text", text: "Changed", mentions: [] }],
+            },
+          }),
+        ).toMatchObject({
+          status: "rejected",
+          error: { code: "invalid-operation", retry: "never" },
+        });
+        expect(evaluations).toBe(1);
+        expect(guardCalls).toBe(1);
+        expect(
+          getThread(harness.db, f.thread.id)?.messageAcceptanceSequence,
+        ).toBe(1);
+        expect(
+          getThread(harness.db, f.thread.id)?.lastVisibleHumanAcceptedAt,
+        ).toBeNull();
+        if (path === "busy-queue") {
+          const [queued] = listQueuedThreadMessages(harness.db, f.thread.id);
+          if (!queued) throw new Error("Expected reserved P6r queue");
+          applyLoggedThreadLifecycleEvent(harness.deps, {
+            threadId: f.thread.id,
+            event: { type: "run.succeeded" },
