+async function fixture(
+  harness: TestAppHarness,
+  evaluator: EvaluatorV1,
+  existingThread?: ReturnType<typeof seedThread>,
+) {
+  const thread =
+    existingThread ??
+    (() => {
+      const host = seedHost(harness.deps);
+      const { project } = seedProjectWithSource(harness.deps, {
+        hostId: host.id,
+      });
+      return seedThread(harness.deps, {
+        projectId: project.id,
+        status: "idle",
+      });
+    })();
+  const service = getMessageAdmissionService(harness.db);
+  const handle = service.createPluginHandle("queue-policy");
+  handle.activate();
+  await handle.protocol.registerEvaluator(
+    { version: 1, evaluatorVersion: "1" },
+    evaluator,
+  );
+  const publish = () =>
+    handle.protocol.publish({
+      version: 1,
+      operation: { namespace: "queue-publication", operationId: randomUUID() },
+      providerId: "queue-policy",
+      expectedActivePublication: null,
+      snapshotBytes: canonicalJson({}, 100),
+      configurationVersion: "1",
+      evaluatorVersion: "1",
+      enrollment: { mode: "enforce", projectIds: [thread.projectId] },
+    });
+  await publish();
+  return { thread, service, handle };
+}
