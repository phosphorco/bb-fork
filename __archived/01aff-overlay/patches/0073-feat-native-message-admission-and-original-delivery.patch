+        store.prepare("thread", { input: `message-${index}` }).operationId,
+      );
+    expect(() => store.prepare("thread", { input: "overflow" })).toThrow(
+      "Too many unresolved",
+    );
+    expect(store.prepare("thread", { input: "message-0" }).operationId).toBe(
+      "pending-1",
+    );
+    store.settled("thread", "pending-1");
+    expect(
+      ids.has(store.prepare("thread", { input: "replacement" }).operationId),
+    ).toBe(false);
+  });
+});
