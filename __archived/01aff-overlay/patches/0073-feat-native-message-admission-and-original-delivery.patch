+
+export const nativeThreadCreateBindingSchema = z.object({
+  namespace: z.literal("native-thread-create"),
+  operationId: z.string().min(1).max(200),
+  fingerprint: z.string().min(1).max(128),
+});
+
+export const nativeEmptyCreateControlSchema = z.object({
+  queueId: z.string().min(1).optional(),
+  binding: nativeThreadCreateBindingSchema,
+  nativeOperation: z.object({
+    namespace: z.string().min(1),
+    operationId: z.string().min(1).max(200),
+  }),
+});
