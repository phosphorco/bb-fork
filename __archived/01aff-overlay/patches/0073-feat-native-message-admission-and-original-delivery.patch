+import { listQueuedThreadCommands } from "../helpers/commands.js";
+import { runQueuedMessageDispatch } from "../../src/services/threads/queued-message-dispatch.js";
+function creation(harness: TestAppHarness) {
+  const { host } = seedHostSession(harness.deps, {
+    id: "host-create-idempotency",
+  });
+  const { project } = seedProjectWithSource(harness.deps, {
+    hostId: host.id,
+    path: "/tmp/create-idempotency",
+  });
+  const environment = seedEnvironment(harness.deps, {
+    hostId: host.id,
+    projectId: project.id,
+    path: "/tmp/create-idempotency",
+  });
+  const request = {
+    operationId: "stable-create",
+    projectId: project.id,
+    environment: { type: "reuse" as const, environmentId: environment.id },
+    input: textInput("First original"),
+    origin: "app" as const,
+    providerId: "codex",
+    startedOnBehalfOf: null,
+    sendAt: Date.now() + 60000,
+    title: "Chosen title",
+    visibility: "hidden" as const,
+    parentNotifications: "stuck" as const,
+  };
+  return { project, environment, request };
+}
+async function policy(
+  harness: TestAppHarness,
+  projectId: string,
+  evaluator: EvaluatorV1,
+) {
+  const handle = getMessageAdmissionService(harness.db).createPluginHandle(
+    "create-rules",
+  );
+  handle.activate();
+  await handle.protocol.registerEvaluator(
+    { version: 1, evaluatorVersion: "create-test" },
+    evaluator,
+  );
+  await handle.protocol.publish({
+    version: 1,
+    operation: { namespace: "create-policies", operationId: "create-policy" },
+    providerId: "create-rules",
+    expectedActivePublication: null,
+    snapshotBytes: "{}",
+    configurationVersion: "1",
+    evaluatorVersion: "create-test",
+    enrollment: { mode: "enforce", projectIds: [projectId] },
+  });
+  return handle;
+}
+describe("first-message create operation ownership", () => {
+  it("legacy empty waited creates retain exact readable control work until native drain", async () => {
+    await withTestHarness(async (harness) => {
+      const { project, environment, request: generated } = creation(harness);
+      const { operationId: _operationId, ...legacy } = generated;
+      const source = seedThread(harness.deps, {
+        projectId: project.id,
+        environmentId: environment.id,
+      });
+      seedThreadIdentity(harness.deps, {
+        threadId: source.id,
+        providerThreadId: "legacy-empty-source",
+      });
+      seedTurnStarted(harness.deps, {
+        threadId: source.id,
+        turnId: "legacy-empty-turn",
+        providerThreadId: "legacy-empty-source",
+      });
+      const first = await createThreadFromRequest(harness.deps, {
+        ...legacy,
+        input: [],
+        originKind: "fork",
+        sourceThreadId: source.id,
+      });
+      expect(first.status).toBe("pending");
+      const queued = harness.db
+        .select()
+        .from(queuedThreadMessages)
+        .where(eq(queuedThreadMessages.threadId, first.id))
+        .all();
+      expect(queued).toHaveLength(1);
+      expect(queued[0]?.content).toBe("[]");
+      const reservation = harness.db
+        .select()
+        .from(messageAdmissionThreadCreates)
+        .where(eq(messageAdmissionThreadCreates.threadId, first.id))
+        .get();
+      expect(reservation?.state).toBe("running");
+      await runQueuedMessageDispatch(harness.deps, {
+        kind: "time-reached",
+        now: generated.sendAt + 1,
+      });
+      expect(
+        harness.db
+          .select()
+          .from(queuedThreadMessages)
+          .where(eq(queuedThreadMessages.threadId, first.id))
+          .all(),
+      ).toEqual([]);
+      expect(
+        listEvents(harness.db, { threadId: first.id }).filter(
+          (event) => event.type === "client/turn/requested",
+        ),
+      ).toHaveLength(1);
+      expect(
+        harness.db
+          .select()
+          .from(messageAdmissionOperations)
+          .where(eq(messageAdmissionOperations.threadId, first.id))
+          .all(),
+      ).toEqual([]);
+      expect(
+        getAdmissionThreadCreate(
+          harness.db,
+          reservation!.namespace,
+          reservation!.operationId,
+        )?.state,
+      ).toBe("acknowledged");
+    });
+  });
+  it("lost-response replay returns one immutable thread acknowledgement and one native original", async () => {
+    await withTestHarness(async (harness) => {
+      const { project, request } = creation(harness);
+      const first = await createThreadFromRequest(harness.deps, request);
+      const replay = await createThreadFromRequest(harness.deps, request);
+      expect(replay).toEqual(first);
+      expect(
+        harness.db
+          .select()
+          .from(threads)
+          .where(eq(threads.projectId, project.id))
+          .all(),
+      ).toHaveLength(1);
+      expect(
+        harness.db
+          .select()
+          .from(queuedThreadMessages)
+          .where(eq(queuedThreadMessages.threadId, first.id))
+          .all(),
+      ).toHaveLength(1);
+      const operations = harness.db
+        .select()
+        .from(messageAdmissionOperations)
+        .where(eq(messageAdmissionOperations.threadId, first.id))
+        .all();
+      expect(operations).toHaveLength(1);
+      expect(operations[0]!.operationId).toBe(request.operationId);
+      expect(first.visibility).toBe("hidden");
+      expect(first.parentNotifications).toBe("stuck");
+    });
+  });
+  it("rejected first input preserves its chosen thread/original and never reevaluates on replay", async () => {
+    await withTestHarness(async (harness) => {
+      const { project, request: scheduled } = creation(harness),
+        { sendAt: _sendAt, ...request } = scheduled;
+      let calls = 0;
+      const handle = await policy(harness, project.id, (input) => {
+        calls++;
+        return reduceObservations({
+          assessmentId: input.assessmentId,
+          complete: true,
+          observations: [
+            {
+              groupId: "policy",
+              ruleId: "reject",
+              revision: "1",
+              status: "reject",
+              causes: [{ code: "fix-first", message: "Rejected first input" }],
+              advice: ["Correct the first input."],
+              routing: "preserve",
+              membership: "preserve",
+            },
+          ],
+        });
+      });
+      try {
+        await expect(
+          createThreadFromRequest(harness.deps, request),
+        ).rejects.toMatchObject({
+          status: 409,
+          body: { code: "message_admission_rejected" },
+        });
+        await expect(
+          createThreadFromRequest(harness.deps, request),
+        ).rejects.toMatchObject({
+          status: 409,
+          body: { code: "message_admission_rejected" },
+        });
+        expect(calls).toBe(1);
+        const retained = harness.db
+          .select()
+          .from(threads)
+          .where(eq(threads.projectId, project.id))
+          .all();
+        expect(retained).toHaveLength(1);
+        expect(retained[0]!.deletedAt).toBeNull();
+        expect(retained[0]!.status).toBe("pending");
+        expect(
+          listEvents(harness.db, { threadId: retained[0]!.id }).filter(
+            (event) => event.type === "client/turn/requested",
+          ),
+        ).toEqual([]);
+        expect(
+          listQueuedThreadCommands(harness, "thread.start", retained[0]!.id),
+        ).toEqual([]);
+        expect(
+          harness.db
+            .select()
+            .from(queuedThreadMessages)
+            .where(eq(queuedThreadMessages.threadId, retained[0]!.id))
+            .all(),
+        ).toHaveLength(0);
+        expect(
+          harness.db
+            .select()
+            .from(messageAdmissionOperations)
+            .where(eq(messageAdmissionOperations.threadId, retained[0]!.id))
+            .all(),
