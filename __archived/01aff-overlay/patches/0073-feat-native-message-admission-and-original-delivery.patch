+function installGuard(
+  handler: (
+    context: MessageDispatchHookContext,
+  ) => MessageDispatchHookDecision | Promise<MessageDispatchHookDecision>,
+) {
+  setPluginHookProvider({
+    listHooks: () => [{ pluginId: "feature-guard", handler }],
+    invokeHook: (_id, _label, run) => invokePluginInline(run),
+    decisionTimeoutMs: 10000,
+  });
+}
+afterEach(() => setPluginHookProvider(undefined));
