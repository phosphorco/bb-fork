diff --git a/packages/domain/test/message-originals.p6r.test.ts b/packages/domain/test/message-originals.p6r.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7b0373e12017f40a05cbe42eb9c85d21a6b497e7
--- /dev/null
+++ b/packages/domain/test/message-originals.p6r.test.ts
@@ -0,0 +1,200 @@
+import { describe, expect, it } from "vitest";
+import {
+  messageOriginalManifestSchema,
+  selectAutomaticQueueGroup,
+  selectQueueBatchPlacement,
+  type MessageOriginal,
+  type QueuePlacementMember,
+} from "../src/message-originals.js";
+
+function member(
+  id: string,
+  patch: Partial<QueuePlacementMember> = {},
+): QueuePlacementMember {
+  return {
+    id,
+    createdAt: 1,
+    groupWithNext: false,
+    joinState: "open",
+    scheduledFor: null,
+    sendAt: null,
+    state: "queued",
+    payloadKind: "inline",
+    systemNotice: null,
+    model: "m",
+    reasoningLevel: "high",
+    permissionMode: "full",
+    serviceTier: "default",
+    ...patch,
+  };
+}
+const candidate = member("candidate");
+function original(id: string): MessageOriginal {
+  return {
+    originalId: id,
+    revisionId: `rev-${id}`,
+    operationId: `op-${id}`,
+    rawInput: [{ type: "text", text: id, mentions: [] }],
+    source: {
+      source: "tell",
+      initiator: "agent",
+      senderThreadId: `sender-${id}`,
+      origin: null,
+      originPluginId: null,
+      requestedBy: null,
+      rendering: "host",
+    },
+    author: null,
+    editor: null,
+    acceptedAt: 1,
+    requestedIntent: { mode: "queue-batched", sendAt: null },
+    effectiveIntent: { mode: "queue-batched", sendAt: null },
+  };
+}
+describe("original manifest and shared queue selector", () => {
+  it("selects first ordinary group across a scheduled original without tail/compatible search", () => {
+    const rows = [
+      member("A", { groupWithNext: true }),
+      member("B"),
+      member("S", { scheduledFor: 10, sendAt: 10 }),
+      member("tail"),
+    ];
+    expect(selectQueueBatchPlacement(rows, candidate)).toEqual({
+      kind: "join",
+      targetIds: ["A", "B"],
+    });
+    rows[0]!.model = "other";
+    rows[1]!.model = "other";
+    expect(selectQueueBatchPlacement(rows, candidate)).toEqual({
+      kind: "conflict",
+      reason: "incompatible",
+    });
+  });
+  it.each([null, "frozen"] as const)(
+    "treats unknown or frozen intent as closed (%s)",
+    (joinState) => {
+      expect(
+        selectQueueBatchPlacement(
+          [member("A", { joinState }), member("later")],
+          candidate,
+        ),
+      ).toEqual({ kind: "singleton", reason: "closed-target" });
+    },
+  );
+  it("keeps legacy-unknown timing explicit and refuses automatic attachment even to an open row", () => {
+    expect(
+      messageOriginalManifestSchema.parse([
+        {
+          ...original("unknown"),
+          effectiveIntent: {
+            mode: "queue",
+            sendAt: null,
+            timingBasis: "legacy-unknown",
+          },
+        },
+      ])[0]?.effectiveIntent.timingBasis,
+    ).toBe("legacy-unknown");
+    expect(
+      selectQueueBatchPlacement(
+        [member("unknown", { timingBasis: "legacy-unknown" })],
+        candidate,
+      ),
+    ).toEqual({ kind: "singleton", reason: "closed-target" });
+    expect(
+      selectQueueBatchPlacement(
+        [
+          member("unknown", {
+            effectiveIntent: JSON.stringify({
+              mode: "queue",
+              sendAt: null,
+              timingBasis: "legacy-unknown",
+            }),
+          }),
+        ],
+        candidate,
+      ),
+    ).toEqual({ kind: "singleton", reason: "closed-target" });
+  });
+  it("treats an intervening explicit divider as a barrier while allowing a scheduled item", () => {
+    expect(
+      selectQueueBatchPlacement(
+        [
+          member("A"),
+          member("S", { scheduledFor: 10 }),
+          member("D", { joinState: "divider" }),
+        ],
+        candidate,
+      ),
+    ).toEqual({ kind: "conflict", reason: "divider" });
+    expect(
+      selectQueueBatchPlacement(
+        [member("A"), member("S", { scheduledFor: 10 })],
+        candidate,
+      ),
+    ).toEqual({ kind: "join", targetIds: ["A"] });
+  });
+  it("does not cojoin retries, notices, schedule or corrupted chains", () => {
+    expect(
+      selectQueueBatchPlacement(
+        [member("retry", { payloadKind: "retry" })],
+        candidate,
+      ),
+    ).toEqual({ kind: "singleton", reason: "no-target" });
+    expect(
+      selectQueueBatchPlacement(
+        [member("notice", { systemNotice: "notice" })],
+        candidate,
+      ),
+    ).toEqual({ kind: "singleton", reason: "no-target" });
+    expect(
+      selectQueueBatchPlacement(
+        [
+          member("A", { groupWithNext: true }),
+          member("retry", { payloadKind: "retry" }),
+        ],
+        candidate,
+      ),
+    ).toEqual({ kind: "conflict", reason: "corrupt-group" });
+    expect(
+      selectQueueBatchPlacement(
+        [member("A", { groupWithNext: true })],
+        candidate,
+      ),
+    ).toEqual({ kind: "conflict", reason: "corrupt-group" });
+  });
+  it("caps admission before insertion at the supported 256 original boundary", () => {
+    const rows = Array.from({ length: 256 }, (_, i) =>
+      member(String(i), { groupWithNext: i < 255 }),
+    );
+    expect(selectQueueBatchPlacement(rows, candidate)).toEqual({
+      kind: "conflict",
+      reason: "capacity",
+    });
+    rows[254]!.groupWithNext = false;
+    rows.pop();
+    expect(selectQueueBatchPlacement(rows, candidate)).toMatchObject({
+      kind: "join",
+    });
+    expect(
+      messageOriginalManifestSchema.parse(
+        Array.from({ length: 256 }, (_, i) => original(String(i))),
+      ),
+    ).toHaveLength(256);
+    expect(() =>
+      messageOriginalManifestSchema.parse(
+        Array.from({ length: 257 }, (_, i) => original(String(i))),
+      ),
+    ).toThrow();
+    expect(() =>
+      messageOriginalManifestSchema.parse([original("A"), original("A")]),
+    ).toThrow("Duplicate original identity");
+  });
+  it("lets due scheduled work overtake blocked Q and post-due arrivals, while ready pending Q wins", () => {
+    const q = [member("Q", { createdAt: 1 })];
+    const s = [member("S", { scheduledFor: 10, sendAt: null })];
+    expect(selectAutomaticQueueGroup([q, s], () => true)).toEqual(q);
+    expect(selectAutomaticQueueGroup([q, s], (rows) => rows !== q)).toEqual(s);
+    const arrivals = [member("new", { createdAt: 11 })];
+    expect(selectAutomaticQueueGroup([arrivals, s], () => true)).toEqual(s);
+  });
+});
