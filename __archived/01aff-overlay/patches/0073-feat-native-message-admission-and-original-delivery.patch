@@ -0,0 +1,315 @@
+import { z } from "zod";
+
+const operationIdSchema = z.string().min(1).max(200);
+const recordSchema = z.object({
+  operationId: operationIdSchema,
+  request: z.string(),
+  basis: z.string().optional(),
+});
+const journalSchema = z.union([
+  recordSchema.transform((record) => [record]),
+  z
+    .object({ version: z.literal(2), records: z.array(recordSchema).max(128) })
+    .transform((journal) => journal.records),
+]);
+
+function serializeRequest(request: object): string {
+  return JSON.stringify(request, (_key, value: unknown) =>
+    value !== null && typeof value === "object" && !Array.isArray(value)
+      ? Object.fromEntries(
+          Object.entries(value).sort(([a], [b]) =>
+            a < b ? -1 : a > b ? 1 : 0,
+          ),
+        )
+      : value,
+  );
+}
+
+const preferenceFields = [
+  "providerId",
+  "model",
+  "reasoningLevel",
+  "serviceTier",
+  "permissionMode",
+] as const;
+function hasClientPreference(request: object): boolean {
+  const sources = (request as Record<string, unknown>).executionInputSources;
+  return (
+    sources !== null &&
+    typeof sources === "object" &&
+    preferenceFields.some(
+      (field) =>
+        (sources as Record<string, unknown>)[field] === "client-preference",
+    )
+  );
+}
+function serializeAuthoredBasis(
+  request: object,
+  current: object = request,
+): string {
+  const sources = (current as Record<string, unknown>).executionInputSources;
+  const derived =
+    sources !== null && typeof sources === "object"
+      ? (sources as Record<string, unknown>)
+      : {};
+  // Provenance selects derivable fields, but a provenance tag alone is not a
+  // new authored message. The retained request itself always stays exact.
+  return serializeRequest(
+    Object.fromEntries(
+      Object.entries(request).filter(
+        ([field]) =>
+          field !== "executionInputSources" &&
+          !preferenceFields.some(
+            (key) => key === field && derived[key] === "client-preference",
+          ),
+      ),
+    ),
+  );
+}
+function retainedRecoveryBasis(
+  record: z.infer<typeof recordSchema>,
+  current: object,
+): string {
+  const raw = JSON.parse(record.request) as Record<string, unknown>;
+  const prior = JSON.parse(record.basis ?? record.request) as Record<
+    string,
+    unknown
+  >;
+  for (const field of preferenceFields)
+    if (!Object.hasOwn(prior, field) && Object.hasOwn(raw, field))
+      prior[field] = raw[field];
+  if (
+    record.basis === undefined &&
+    (prior.mode === "queue-if-active" || prior.mode === "auto") &&
+    (current as Record<string, unknown>).mode === undefined
+  )
+    delete prior.mode;
+  return serializeAuthoredBasis(prior, current);
+}
+
+export function createSubmissionIdentityStore(
+  storage:
+    | (Pick<Storage, "getItem" | "setItem" | "removeItem"> &
+        Partial<Pick<Storage, "key" | "length">>)
+    | null,
+  nextId: () => string = () => crypto.randomUUID(),
+) {
+  const retained = new Map<string, z.infer<typeof recordSchema>[]>();
+  const key = (scope: string) => `bb:message-submission:v1:${scope}`;
+  const prefix = (scope: string) =>
+    `bb:message-submission:v3:${encodeURIComponent(scope)}:`;
+  const operationKey = (scope: string, operationId: string) =>
+    `${prefix(scope)}${encodeURIComponent(operationId)}`;
+  const enumerable =
+    storage !== null &&
+    typeof storage.key === "function" &&
+    typeof storage.length === "number";
+  const read = (scope: string) => {
+    const memory = retained.get(scope);
+    if (storage === null) return memory ?? [];
+    let raw: string | null | undefined;
+    try {
+      raw = storage.getItem(key(scope));
+    } catch {
+      throw new Error(
+        "Cannot read retained submission identities. Reconcile outstanding messages before sending again.",
+      );
+    }
+    if (!raw && !enumerable) {
+      retained.set(scope, []);
+      return [];
+    }
+    try {
+      const legacy = raw ? journalSchema.parse(JSON.parse(raw)) : [];
+      const parsed = [...legacy];
+      if (enumerable && storage.key) {
+        const keys = () => {
+          const selected: string[] = [];
+          for (let index = 0; index < (storage.length ?? 0); index++) {
+            const name = storage.key?.(index);
+            if (name?.startsWith(prefix(scope))) selected.push(name);
+          }
+          return selected.sort();
+        };
+        let snapshot: { name: string; raw: string | null }[] | undefined;
+        for (let attempt = 0; attempt < 3; attempt++) {
+          const before = keys();
+          const values = before.map((name) => ({
+            name,
+            raw: storage.getItem(name),
+          }));
+          if (
+            JSON.stringify(before) === JSON.stringify(keys()) &&
+            values.every(
+              (item) =>
+                item.raw !== null && storage.getItem(item.name) === item.raw,
+            )
+          ) {
+            snapshot = values;
+            break;
+          }
+        }
+        if (!snapshot)
+          throw new Error("Submission identities changed while reading");
+        for (const item of snapshot) {
+          const record = recordSchema.parse(JSON.parse(item.raw!));
+          if (item.name !== operationKey(scope, record.operationId))
+            throw new Error("Retained operation key mismatch");
+          const prior = parsed.find(
+            (entry) => entry.operationId === record.operationId,
+          );
+          if (prior && prior.request !== record.request)
+            throw new Error("Conflicting retained operation");
+          if (!prior) parsed.push(record);
+        }
+      }
+      const ids = new Set<string>();
+      const records = parsed.map((record) => {
+        if (ids.has(record.operationId))
+          throw new Error("Duplicate operation identity");
+        ids.add(record.operationId);
+        const request: unknown = JSON.parse(record.request);
+        if (request === null || typeof request !== "object")
+          throw new Error("Invalid retained request");
+        const basis: unknown =
+          record.basis === undefined ? undefined : JSON.parse(record.basis);
+        if (
+          basis !== undefined &&
+          (basis === null || typeof basis !== "object")
+        )
+          throw new Error("Invalid retained authored basis");
+        return {
+          operationId: record.operationId,
+          request: serializeRequest(request),
+          ...(basis === undefined ? {} : { basis: serializeRequest(basis) }),
+        };
+      });
+      retained.set(scope, records);
+      // Each new browser operation has its own key. An acknowledgement in
+      // another tab cannot erase a different operation through a shared array.
+      if (enumerable && legacy.length) {
+        for (const record of records)
+          storage.setItem(
+            operationKey(scope, record.operationId),
+            JSON.stringify(record),
+          );
+        storage.removeItem(key(scope));
+      }
+      return records;
+    } catch {
+      throw new Error(
+        "Stored submission identities are invalid. Reconcile outstanding messages before sending another revision.",
+      );
+    }
+  };
+  const write = (
+    scope: string,
+    records: z.infer<typeof recordSchema>[],
+    operation?: z.infer<typeof recordSchema>,
+    settledId?: string,
+  ) => {
+    retained.set(scope, records);
+    try {
+      if (enumerable) {
+        if (operation)
+          storage?.setItem(
+            operationKey(scope, operation.operationId),
+            JSON.stringify(operation),
+          );
+        if (settledId !== undefined)
+          storage?.removeItem(operationKey(scope, settledId));
+      } else if (records.length)
+        storage?.setItem(key(scope), JSON.stringify({ version: 2, records }));
+      else storage?.removeItem(key(scope));
+    } catch {
+      throw new Error(
+        "Cannot retain this submission's operation identity. Reconcile outstanding messages and restore browser storage before sending again.",
+      );
+    }
+  };
+  return {
+    prepare<T extends object>(
+      scope: string,
+      request: T,
+      suppliedOperationId?: string,
+      authoredBasis?: object,
+      recoveryScopes: readonly string[] = [],
+    ): T & { operationId: string } {
+      const serialized = serializeRequest(request);
+      const authored =
+        authoredBasis ?? (hasClientPreference(request) ? request : undefined);
+      const basis =
+        authored === undefined ? undefined : serializeRequest(authored);
+      const records = [...read(scope)];
+      for (const alias of new Set(recoveryScopes)) {
+        if (alias === scope) continue;
+        for (const record of read(alias)) {
+          const existing = records.find(
+            (item) => item.operationId === record.operationId,
+          );
+          if (existing && existing.request !== record.request)
+            throw new Error(
+              `Operation ${record.operationId} conflicts across composer recovery scopes.`,
+            );
+          if (!existing) records.push(record);
+        }
+      }
+      if (records.length > 128)
+        throw new Error(
+          "Too many unresolved submissions across composer surfaces. Reconcile them before sending again.",
+        );
+      const explicit =
+        suppliedOperationId === undefined
+          ? undefined
+          : operationIdSchema.parse(suppliedOperationId);
+      let previous: z.infer<typeof recordSchema> | undefined;
+      if (explicit === undefined) {
+        const matching = records.filter(
+          (record) =>
+            record.request === serialized ||
+            (basis !== undefined &&
+              retainedRecoveryBasis(record, authored!) ===
+                serializeAuthoredBasis(authored!)),
+        );
+        if (matching.length > 1)
+          throw new Error(
+            `Several pending operations match this input (${matching.map((record) => record.operationId).join(", ")}). Reconcile the chosen operation before sending again.`,
+          );
+        previous = matching[0];
+      } else
+        previous = records.find((record) => record.operationId === explicit);
+      if (previous && previous.request !== serialized)
+        throw new Error(
+          `Operation ${previous.operationId} already identifies different pending input or transport. Reconcile it before choosing another revision.`,
+        );
+      const record = previous ?? {
+        operationId: explicit ?? nextId(),
+        request: serialized,
+        ...(basis === undefined ? {} : { basis }),
+      };
+      if (!previous && records.length >= 128)
+        throw new Error(
+          "Too many unresolved submissions. Reconcile them before sending another message.",
+        );
+      write(scope, previous ? records : [...records, record], record);
+      return { ...request, operationId: record.operationId };
+    },
+    settled(
+      scope: string,
+      operationId: string,
+      recoveryScopes: readonly string[] = [],
+    ) {
+      for (const target of new Set([scope, ...recoveryScopes])) {
+        const records = read(target);
+        if (!records.some((record) => record.operationId === operationId))
+          continue;
+        write(
+          target,
+          records.filter((record) => record.operationId !== operationId),
+          undefined,
+          operationId,
+        );
+      }
+    },
+  };
+}
