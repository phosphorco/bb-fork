+++ b/apps/app/src/components/thread/ThreadAdmissionPreparations.tsx
@@ -0,0 +1,292 @@
+import { useMemo, useState } from "react";
+import { useInfiniteQuery, useMutation } from "@tanstack/react-query";
+import { Button } from "@bb/shared-ui/button";
+import { createSubmissionIdentityStore } from "@bb/client-core";
+import type { ThreadAdmissionOperationResponse } from "@bb/server-contract";
+import { sdk } from "@/lib/sdk";
+import { getMutationErrorMessage } from "@/lib/mutation-errors";
+import { threadAdmissionPreparationsQueryKey } from "@/hooks/queries/query-keys";
+import type { SendMessageMutationLike } from "@/views/thread-detail/threadDetailMutationTypes";
+import { PromptStackCard } from "@/components/promptbox/banner/PromptStackCard";
+import {
+  preparationInputPreview,
+  separateCorrectionRequest,
+} from "./thread-admission-correction";
+
+export function ThreadAdmissionPreparations({
+  threadId,
+  sendMessage: send,
+}: {
+  threadId: string;
+  sendMessage: SendMessageMutationLike;
+}) {
+  const [selected, setSelected] =
+    useState<ThreadAdmissionOperationResponse | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const identities = useMemo(
+    () =>
+      createSubmissionIdentityStore(
+        typeof localStorage === "undefined" ? null : localStorage,
+      ),
+    [],
+  );
+  const query = useInfiniteQuery({
+    queryKey: threadAdmissionPreparationsQueryKey(threadId),
+    initialPageParam: 0,
+    queryFn: ({ pageParam, signal }) =>
+      sdk.threads.experimental_listAdmissionPreparations({
+        threadId,
+        includeSettled: true,
+        ...(pageParam === 0 ? {} : { beforeSequence: pageParam }),
+        signal,
+      }),
+    getNextPageParam: (page) => page.nextBeforeSequence ?? undefined,
+    staleTime: Infinity,
+  });
+  const cancel = useMutation({
+    mutationFn: async (item: ThreadAdmissionOperationResponse) => {
+      const state = item.preparationState;
+      if (state !== "pending" && state !== "failed" && state !== "uncertain")
+        throw new Error(
+          "Refresh this preparation before cancelling future content.",
+        );
+      return sdk.threads.experimental_cancelAdmissionPreparation({
+        threadId,
+        journalId: item.journalId,
+        expectedState: state,
+      });
+    },
+    onSuccess: () => {
+      setError(null);
+      void query.refetch();
+    },
+    onError: (error) => {
+      setError(
+        getMutationErrorMessage({
+          error,
+          fallbackMessage:
+            "Could not cancel future content. Refresh its current state.",
+        }),
+      );
+      void query.refetch();
+    },
+  });
+  const items = useMemo(
+    () => query.data?.pages.flatMap((page) => page.items) ?? [],
+    [query.data],
+  );
+  const rows = useMemo(
+    () =>
+      items.map((item) => ({
+        item,
+        correction: separateCorrectionRequest(item),
+        preview: preparationInputPreview(item),
+      })),
+    [items],
+  );
+  const correction = useMemo(
+    () => (selected ? separateCorrectionRequest(selected) : null),
+    [selected],
+  );
+  if (query.isPending || (items.length === 0 && !query.isError)) return null;
+  const pending = cancel.isPending || send.isPending;
+  const confirmCorrection = async () => {
+    if (!selected || !correction || pending) return;
+    const scope = `historical-correction:${threadId}:${selected.journalId}`;
+    try {
+      const request = identities.prepare(scope, {
+        id: threadId,
+        ...correction,
+      });
+      await send.mutateAsync(request);
+      setSelected(null);
+      setError(null);
+      void query.refetch();
+    } catch (error) {
+      setError(
+        getMutationErrorMessage({
+          error,
+          fallbackMessage:
+            "Correction outcome is unknown. The same operation is retained; refresh before sending again.",
+        }),
+      );
+    }
+  };
+  return (
+    <PromptStackCard ariaLabel="Accepted message preparations">
+      <details className="px-3 py-2 text-xs">
+        <summary className="cursor-pointer">
+          Accepted work{items.length ? ` (${items.length})` : ""}
+        </summary>
+        <div className="mt-2 flex flex-col gap-3">
+          <div className="flex items-center justify-between gap-2">
+            <span className="text-muted-foreground">
+              Native state at last refresh; provider completion is shown
+              separately.
+            </span>
+            <Button
+              size="sm"
+              variant="ghost"
+              disabled={query.isFetching}
+              onClick={() => void query.refetch()}
+            >
+              Refresh
+            </Button>
+          </div>
+          {query.isError ? (
+            <p role="alert">
+              Could not read accepted preparations. Refresh to reconcile.
+            </p>
+          ) : null}
+          {rows.map(({ item, correction, preview }) => (
+            <article
+              key={item.journalId}
+              className="flex flex-col gap-1 border-t pt-2"
+            >
+              <p>
+                Preparation {item.preparationState ?? "none"} · Delivery{" "}
+                {item.record.delivery.state.replaceAll("-", " ")}
+              </p>
+              <p className="truncate" title={preview}>
+                {preview}
+              </p>
+              <p className="text-muted-foreground break-all">
+                Operation {item.record.operation.operationId}
+              </p>
+              {item.record.reasons.map((reason, index) => (
+                <p key={`${reason.code}:${index}`}>{reason.message}</p>
+              ))}
+              <details>
+                <summary className="cursor-pointer">Reasons and advice</summary>
+                {item.record.assessments.map((assessment) => (
+                  <div key={assessment.assessmentId}>
+                    {assessment.causes.map((cause, index) => (
+                      <p key={`${cause.code}:${index}`}>
+                        {cause.groupId}/{cause.ruleId}: {cause.message}
+                      </p>
+                    ))}
+                    {assessment.advice.map((advice, index) => (
+                      <p key={index}>{advice}</p>
+                    ))}
+                  </div>
+                ))}
+                <details>
+                  <summary className="cursor-pointer">
+                    Native delivery details
+                  </summary>
+                  <pre className="max-h-48 overflow-auto whitespace-pre-wrap break-words">
+                    {JSON.stringify(item.record.delivery.details, null, 2)}
+                  </pre>
+                </details>
+              </details>
+              <div className="flex flex-wrap gap-2">
+                {item.preparationState === "pending" ||
+                item.preparationState === "failed" ||
+                item.preparationState === "uncertain" ? (
+                  <Button
+                    size="sm"
+                    variant="outline"
+                    disabled={pending}
+                    onClick={() => cancel.mutate(item)}
+                  >
+                    Cancel future content
+                  </Button>
+                ) : null}
+                {correction ? (
+                  <Button
+                    size="sm"
+                    variant="outline"
+                    disabled={pending}
+                    onClick={() => {
+                      setSelected(item);
+                      setError(null);
+                    }}
+                  >
+                    Send as separate correction
+                  </Button>
+                ) : null}
+              </div>
+              {item.preparationState === "effect-possible" ||
+              item.preparationState === "uncertain" ? (
+                <p>
+                  Earlier effects may have happened. Cancellation does not undo
+                  them; the original operation will not be replayed.
+                </p>
+              ) : null}
+            </article>
+          ))}
+          {selected && correction ? (
+            <section
+              aria-label="Confirm separate correction"
+              className="flex flex-col gap-2 border-t pt-2"
+            >
+              <p>
+                This sends the retained content as a new message with its
+                retained execution choices. Current rules apply. The historical
+                edit and its operation remain unchanged. Repeated confirmation
+                reconciles this same correction operation.
+              </p>
+              <dl
+                aria-label="Retained execution choices"
+                className="grid grid-cols-2 gap-x-3 gap-y-1"
+              >
+                <dt>Model</dt>
+                <dd>{correction.model ?? "Current default"}</dd>
+                <dt>Reasoning</dt>
+                <dd>{correction.reasoningLevel ?? "Current default"}</dd>
+                <dt>Permissions</dt>
+                <dd>{correction.permissionMode ?? "Current default"}</dd>
+                <dt>Service tier</dt>
+                <dd>{correction.serviceTier ?? "Current default"}</dd>
+              </dl>
+              <pre className="max-h-40 overflow-auto whitespace-pre-wrap break-words">
+                {correction.input
+                  .filter((item) => item.type === "text")
+                  .map((item) => item.text)
+                  .join("\n")}
+              </pre>
+              {correction.input.some((item) => item.type !== "text") ? (
+                <p>
+                  All{" "}
+                  {
+                    correction.input.filter((item) => item.type !== "text")
+                      .length
+                  }{" "}
+                  retained attachment/reference items are included.
+                </p>
+              ) : null}
+              <div className="flex gap-2">
+                <Button
+                  size="sm"
+                  disabled={pending}
+                  onClick={() => void confirmCorrection()}
+                >
+                  Confirm new correction
+                </Button>
+                <Button
+                  size="sm"
+                  variant="ghost"
+                  disabled={pending}
+                  onClick={() => setSelected(null)}
+                >
+                  Back
+                </Button>
+              </div>
+            </section>
+          ) : null}
+          {error ? <p role="alert">{error}</p> : null}
+          {query.hasNextPage ? (
+            <Button
+              size="sm"
+              variant="ghost"
+              disabled={query.isFetchingNextPage}
+              onClick={() => void query.fetchNextPage()}
+            >
+              Load earlier preparations
+            </Button>
+          ) : null}
+        </div>
+      </details>
+    </PromptStackCard>
+  );
+}
