+        threadId: source.id,
+        providerThreadId: "cancelled-control-source",
+      });
+      seedTurnStarted(harness.deps, {
+        threadId: source.id,
+        turnId: "cancelled-control-turn",
+        providerThreadId: "cancelled-control-source",
+      });
+      const control = {
+        ...request,
