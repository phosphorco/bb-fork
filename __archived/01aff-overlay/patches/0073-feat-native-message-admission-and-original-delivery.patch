+import { seedThreadFixture } from "../helpers/seed.js";
+import { textInput } from "../helpers/prompt-input.js";
+import { withTestHarness } from "../helpers/test-app.js";
+
+const hidden = (text: string): PromptInput => ({
+  type: "text",
+  text,
+  mentions: [],
+  visibility: "agent-only",
+});
+const deferredCases: { input: PromptInput[] }[] = [
+  { input: [] },
+  { input: [hidden("actual carried context")] },
+];
+describe("structured deferred first-turn context", () => {
+  it.each(deferredCases)(
+    "prefers explicit carried vector including empty over provider author frames",
+    async ({ input }) => {
+      await withTestHarness(async (harness) => {
+        const { thread, environment } = seedThreadFixture(harness, {
+          thread: { status: "error" },
+        });
+        const request = appendClientTurnEvent(harness.deps, {
+          threadId: thread.id,
+          environmentId: environment.id,
+          type: "client/turn/requested",
+          input: [hidden("native author opening"), ...textInput("visible")],
+          deferredFirstTurnContext: input,
+          source: "tell",
+          initiator: "user",
+          senderThreadId: null,
+          requestMethod: "turn/start",
+          target: { kind: "new-turn" },
+          execution: {
+            model: "gpt-5",
+            reasoningLevel: "medium",
+            permissionMode: "accept-edits",
+            serviceTier: "default",
+            source: "client/turn/requested",
+          },
+        });
+        expect(resolveDeferredFirstTurnContext(harness.db, thread.id)).toEqual(
+          input.length === 0
+            ? null
+            : { input, requestSequence: request.sequence },
+        );
+        expect(
+          readDeferredFirstTurnInputForRequest(
+            harness.db,
+            thread.id,
+            request.requestId,
+          ),
+        ).toEqual(input);
+      });
+    },
+  );
+  it("retains bounded visibility-based fallback only for legacy requests without structured field", async () => {
+    await withTestHarness(async (harness) => {
+      const { thread, environment } = seedThreadFixture(harness, {
+        thread: { status: "error" },
+      });
+      const input = [hidden("legacy authored context")];
+      const request = appendClientTurnEvent(harness.deps, {
+        threadId: thread.id,
+        environmentId: environment.id,
+        type: "client/turn/requested",
+        input: [...input, ...textInput("visible"), hidden("later not prefix")],
+        source: "tell",
+        initiator: "user",
+        senderThreadId: null,
+        requestMethod: "turn/start",
+        target: { kind: "new-turn" },
+        execution: {
+          model: "gpt-5",
+          reasoningLevel: "medium",
+          permissionMode: "accept-edits",
+          serviceTier: "default",
+          source: "client/turn/requested",
+        },
+      });
+      expect(resolveDeferredFirstTurnContext(harness.db, thread.id)).toEqual({
+        input,
+        requestSequence: request.sequence,
+      });
+      expect(
+        readDeferredFirstTurnInputForRequest(
+          harness.db,
+          thread.id,
+          request.requestId,
+        ),
+      ).toEqual(input);
+      const row = listEvents(harness.db, { threadId: thread.id }).find(
+        (item) => item.type === "client/turn/requested",
+      )!;
+      const data = JSON.parse(row.data);
+      data.request.params.deferredFirstTurnContext = false;
+      harness.db
+        .update(events)
+        .set({ data: JSON.stringify(data) })
+        .where(eq(events.id, row.id))
+        .run();
+      expect(() =>
+        resolveDeferredFirstTurnContext(harness.db, thread.id),
+      ).toThrow();
+    });
+  });
+});
