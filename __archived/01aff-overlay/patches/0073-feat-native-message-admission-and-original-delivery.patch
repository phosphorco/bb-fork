+        "last_visible_human_original_id",
+        "last_visible_human_revision",
+      ],
+    ],
+    [
+      "queued_thread_messages",
+      [
+        "join_state",
+        "requested_intent",
+        "effective_intent",
+        "admission_ref",
+        "original_manifest",
+        "scheduled_for",
+      ],
+    ],
+  ] as const) {
+    const columns = new Set(
+      db.$client
+        .prepare<[], { name: string }>(`PRAGMA table_info(${table})`)
+        .all()
+        .map((column) => column.name),
+    );
+    for (const name of names)
+      if (columns.has(name))
+        db.$client.exec(`ALTER TABLE ${table} DROP COLUMN ${name}`);
+  }
+  db.$client
