@@ -0,0 +1,409 @@
+import {
+  AdmissionConflict,
+  admissionDigest,
+  getAdmissionOperation,
+  getQueuedThreadMessage,
+  getThread,
+  updateQueuedThreadMessageInTransaction,
+} from "@bb/db";
+import {
+  p6rMessageAuthorSchema,
+  promptInputSchema,
+  resolvedThreadExecutionOptionsSchema,
+  threadQueuedMessageSchema,
+  type Thread,
+} from "@bb/domain";
+import type { UpdateQueuedMessageRequest } from "@bb/server-contract";
+import { z } from "zod";
+import {
+  JsonSchema,
+  type OperationRecordV1,
+} from "@phosphorco/bb-message-admission/protocol";
+import type { P6rNativeAuthorship } from "../p6r/native-request.js";
+import { p6rQueuedOperationReservation } from "../p6r/sidecar-store.js";
+import { resolvePromptAttachmentReferences } from "../projects/attachments.js";
+import type { LoggedPendingInteractionWorkSessionDeps } from "../../types.js";
+import { ApiError } from "../../errors.js";
+import { buildExecutionOptions } from "./thread-commands.js";
+import {
+  threadTargetHostId,
+  buildNativeDispatchGuardRequest,
+  runNativePreparedGuardCheckpoint,
+} from "./dispatch-attempt.js";
+import {
+  dispatchWaitReasonForPass,
+  type MessageDispatchHookPassOutcome,
+} from "./dispatch-hooks.js";
+import { getMessageAdmissionService } from "./message-admission.js";
+import {
+  admissionOriginalManifest,
+  jsonNativeAdmissionValue,
+  nativeAdmissionSubmission,
+  throwNativeAdmissionConflict,
+  throwNativeAdmissionDisposition,
+} from "./message-admission-input.js";
+import {
+  toThreadQueuedMessage,
+  readThreadQueuedMessage,
+  storedQueuedThreadMessageRequestedBy,
+} from "./thread-queued-messages.js";
+import { ensureThreadQueueIsWritable } from "./thread-send.js";
+
+function queueEditReceipt(record: OperationRecordV1) {
+  if (record.status !== "accepted" || !record.acceptedOriginal)
+    return throwNativeAdmissionDisposition(record);
+  const receipt = z
+    .object({
+      acceptanceReceipt: z
+        .object({
+          kind: z.literal("queued-edit"),
+          queue: z.record(z.string(), z.unknown()),
+        })
+        .optional(),
+    })
+    .parse(record).acceptanceReceipt;
+  if (!receipt)
+    throw new ApiError(
+      409,
+      "message_admission_receipt_unavailable",
+      "This edited revision was accepted. Reconcile its operation before submitting another edit.",
+      { details: { admission: record }, retryable: false },
+    );
+  return {
+    queuedMessage: threadQueuedMessageSchema.parse({
+      ...receipt.queue,
+      content: record.acceptedOriginal.rawInput,
+    }),
+    releasedEditHold: false,
+  };
+}
+
+export async function updateQueuedMessageWithAdmission(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+  args: {
+    thread: Thread;
+    queuedMessageId: string;
+    payload: UpdateQueuedMessageRequest;
+    authorship?: P6rNativeAuthorship;
+  },
+) {
+  const { thread, payload } = args;
+  ensureThreadQueueIsWritable(thread);
+  const service = getMessageAdmissionService(deps.db);
+  const operationId =
+    payload.operationId ??
+    `queue-edit:${args.queuedMessageId}:${payload.expectedUpdatedAt}:${admissionDigest(JSON.stringify(payload.input))}`;
+  const known = service.lookupOperation({
+    namespace: `native:${thread.id}`,
+    operationId,
+  });
+  if (known?.status === "accepted" && known.acceptedOriginal) {
+    try {
+      const retained = admissionOriginalManifest(known.acceptedOriginal);
+      const submission = await nativeAdmissionSubmission(deps.db, {
+        thread,
+        input: retained.rawInput,
+        authoredRequest: jsonNativeAdmissionValue({
+          queuedMessageId: args.queuedMessageId,
+          expectedUpdatedAt: payload.expectedUpdatedAt,
+          input: payload.input,
+        }),
+        execution: resolvedThreadExecutionOptionsSchema.parse(
+          known.acceptedOriginal.requestedIntent.execution.configuration,
+        ),
+        mode: "queue",
+        operationId,
+        originalId: known.acceptedOriginal.original.originalId,
+        revision: known.acceptedOriginal.original.revision,
+        senderThreadId: retained.source.senderThreadId,
+        initiator: retained.source.initiator,
+        author: retained.author,
+        editor: args.authorship?.author,
+        origin: retained.source.origin,
+        originPluginId: retained.source.originPluginId,
+        source: retained.source.source,
+        rendering: retained.source.rendering,
+        requestedBy: retained.source.requestedBy,
+        kind: "edit",
+        pluginSubmission: z
+          .object({ nativePluginSubmission: JsonSchema.optional() })
+          .parse(known.acceptedOriginal.source.origin).nativePluginSubmission,
+        canAsk: known.acceptedOriginal.requestedIntent.execution.canAsk,
+        schedule: known.acceptedOriginal.requestedIntent.schedule,
+      });
+      const replay = await service.prepare({ submission });
+      if (replay.kind !== "known")
+        throw new AdmissionConflict(
+          "edit-replay-state",
+          "Accepted edit unexpectedly acquired new evaluation ownership",
+        );
+      return queueEditReceipt(replay.operation);
+    } catch (error) {
+      return throwNativeAdmissionConflict(error);
+    }
+  }
+  const row = getQueuedThreadMessage(deps.db, args.queuedMessageId);
+  if (!row || row.threadId !== thread.id)
+    throw new ApiError(404, "invalid_request", "Queued message not found");
+  if (row.updatedAt !== payload.expectedUpdatedAt)
+    throw new ApiError(
+      409,
+      "message_admission_conflict",
+      "Queued message changed since editing began. Preserve the draft and reload its current revision.",
+    );
+  if (row.state === "claimed")
+    throw new ApiError(
+      409,
+      "invalid_request",
+      "Queued message is already being sent",
+    );
+  if (
+    row.payloadKind !== "inline" ||
+    p6rQueuedOperationReservation(deps.db, row.id)
+  )
+    throw new ApiError(
+      409,
+      "invalid_request",
+      "This retained operation cannot be edited; cancel and create a new operation instead",
+    );
+  const previous = row.admissionRef
+    ? (service.lookupOperationById(row.admissionRef)?.acceptedOriginal ?? null)
+    : null;
+  if (row.admissionRef && !previous)
+    throw new ApiError(
+      409,
+      "message_admission_conflict",
+      "The retained original acceptance is unavailable. Preserve this draft and reconcile its operation.",
+    );
+  if (previous && service.preparationRecord(previous.operation))
+    throw new ApiError(
+      409,
+      "historical_queue_edit_requires_correction",
+      "This queued message belongs to a retained historical edit with a frozen target. Keep this draft and use the historical message editor for a newly evaluated edit, or cancel the retained preparation and explicitly send a correlated separate correction when available. Inline queue replacement cannot transfer its historical target or approval.",
+    );
+  const retainedRow = readThreadQueuedMessage(deps.db, row);
+  const retainedSource = previous
+    ? admissionOriginalManifest(previous).source
+    : {
+        source: row.origin === null ? ("tell" as const) : ("spawn" as const),
+        rendering: "host" as const,
+        requestedBy: storedQueuedThreadMessageRequestedBy(row),
+        origin: row.origin,
+        originPluginId: row.originPluginId,
+      };
+  if (!retainedRow.editable)
+    throw new ApiError(
+      409,
+      "invalid_request",
+      "This queued control cannot be rewritten as a message. Cancel it and submit a separate message instead.",
+    );
+  const legacyAuthor =
+    retainedRow.payload.kind === "inline"
+      ? (retainedRow.payload.p6rAuthors?.[0] ?? null)
+      : null;
+  const input = await resolvePromptAttachmentReferences({
+    db: deps.db,
+    dataDir: deps.config.dataDir,
+    input: payload.input,
+    projectId: thread.projectId,
+    hostId: threadTargetHostId(deps, thread),
+  });
+  const execution = previous
+    ? resolvedThreadExecutionOptionsSchema.parse(
+        previous.effectiveIntent.execution.configuration,
+      )
+    : await buildExecutionOptions(
+        deps,
+        {
+          model: row.model,
+          reasoningLevel: row.reasoningLevel,
+          serviceTier: row.serviceTier,
+          permissionMode: row.permissionMode,
+        },
+        { threadId: thread.id },
+      );
+  try {
+    const submission = await nativeAdmissionSubmission(deps.db, {
+      thread,
+      input,
+      authoredRequest: jsonNativeAdmissionValue({
+        queuedMessageId: row.id,
+        expectedUpdatedAt: payload.expectedUpdatedAt,
+        input: payload.input,
+      }),
+      execution,
+      mode: "queue",
+      operationId,
+      originalId: previous?.original.originalId ?? `legacy-edited:${row.id}`,
+      revision: (previous?.original.revision ?? 0) + 1,
+      senderThreadId: previous?.source.senderThreadId ?? row.senderThreadId,
+      initiator: previous?.source.initiator ?? retainedRow.initiator,
+      author: previous
+        ? p6rMessageAuthorSchema.nullable().parse(previous.source.author)
+        : legacyAuthor,
+      editor: args.authorship?.author,
+      origin: retainedSource.origin,
+      originPluginId: retainedSource.originPluginId,
+      source: retainedSource.source,
+      rendering: retainedSource.rendering,
+      requestedBy: retainedSource.requestedBy,
+      kind: "edit",
+      schedule:
+        previous?.requestedIntent.schedule ??
+        (row.scheduledFor === null
+          ? { kind: "legacy-unknown" }
+          : {
+              kind: "scheduled",
+              notBefore: new Date(row.scheduledFor).toISOString(),
+            }),
+      canAsk:
+        previous?.effectiveIntent.execution.canAsk ??
+        retainedRow.initiator === "user",
+    });
+    const prepared = await service.prepare({ submission });
+    if (prepared.kind === "known") return queueEditReceipt(prepared.operation);
+    const selected = prepared.ticket.effectiveIntent;
+    if (selected.mode !== "queue" || selected.membership !== "preserve") {
+      const changes = selected.changes
+        .map(
+          (change) =>
+            `${change.field}: ${change.explanation}; rules ${change.causeRuleIds.join(", ")}`,
+        )
+        .join("\n");
+      const record = service.invalidatePrepared(prepared.ticket, {
+        code: "edit-placement-conflict",
+        message: `Policy selected delivery ${selected.mode}, membership ${selected.membership}. ${changes} Keep this edited draft; the saved message is unchanged. Submit it as a separate message with the selected delivery, or change the applicable policy before a revised edit.`,
+      });
+      return throwNativeAdmissionDisposition(record);
+    }
+    const originalRevision = z
+      .array(promptInputSchema)
+      .parse(submission.rawInput);
+    const commitEdit = (
+      guardWait?: Extract<MessageDispatchHookPassOutcome, { kind: "wait" }>,
+    ) =>
+      deps.db.transaction(
+        (tx) =>
+          service.commit(tx, prepared.ticket, (accepted) => {
+            const currentThread = getThread(tx, thread.id);
+            if (!currentThread)
+              throw new ApiError(404, "thread_not_found", "Thread not found");
+            ensureThreadQueueIsWritable(currentThread);
+            const original = admissionOriginalManifest(accepted);
+            const updated = updateQueuedThreadMessageInTransaction(tx, {
+              threadId: thread.id,
+              id: row.id,
+              expectedUpdatedAt: payload.expectedUpdatedAt,
+              content: originalRevision,
+              originalManifest: [original],
+              admissionRef: original.admissionRef,
+              requestedIntent: original.requestedIntent,
+              effectiveIntent: original.effectiveIntent,
+              p6rEditors: [args.authorship?.author ?? null],
+              ...(guardWait
+                ? {
+                    wait: {
+                      waitingOn: {
+                        kind: "plugin" as const,
+                        pluginId: guardWait.waiter.pluginId,
+                        reason: dispatchWaitReasonForPass(guardWait),
+                      },
+                      sendAt: guardWait.waiter.sendAt,
+                    },
+                  }
+                : {}),
+            });
+            if (updated.kind !== "updated")
+              throw new AdmissionConflict(
+                `edit-${updated.kind}`,
+                "Queued message changed or was claimed while the edited revision was evaluated. The draft has not replaced it.",
+              );
+            const queuedMessage = toThreadQueuedMessage(updated.queuedMessage);
+            if (previous) {
+              const retained = getAdmissionOperation(
+                tx,
+                previous.operation.namespace,
+                previous.operation.operationId,
+              );
+              if (!retained)
+                throw new AdmissionConflict(
+                  "original-acceptance-missing",
+                  "The prior accepted revision disappeared during replacement",
+                );
+              service.commitFinalDisposition(tx, {
+                operation: previous.operation,
+                expectedDispositionId: retained.dispositionId,
+                dispositionId: `superseded:${accepted.operation.namespace}:${accepted.operation.operationId}`,
+                disposition: jsonNativeAdmissionValue({
+                  kind: "superseded-by-edit",
+                  original: accepted.original,
+                  operation: accepted.operation,
+                }),
+                delivery: {
+                  state: "cancelled",
+                  queueId: null,
+                  requestId: null,
+                  groupIndex: null,
+                  details: jsonNativeAdmissionValue({
+                    reason: "superseded-by-edit",
+                    replacement: accepted.operation,
+                  }),
+                },
+              });
+            }
+            const { content: _content, ...queue } = queuedMessage;
+            return {
+              queueId: queuedMessage.id,
+              queuedMessage,
+              releasedEditHold: updated.releasedEditHold,
+              acceptanceReceipt: jsonNativeAdmissionValue({
+                kind: "queued-edit",
+                queue,
+              }),
+            };
+          }),
+        { behavior: "immediate" },
+      );
+    let committed: ReturnType<typeof commitEdit> | undefined;
+    const acceptedExecution = resolvedThreadExecutionOptionsSchema.parse(
+      prepared.ticket.effectiveIntent.execution.configuration,
+    );
+    const request = buildNativeDispatchGuardRequest(
+      deps,
+      {
+        thread,
+        payload: {
+          input: originalRevision,
+          mode: "auto",
+          senderThreadId: submission.source.senderThreadId ?? undefined,
+        },
+        source: { kind: "inline" },
+        queuePayload: { kind: "inline" },
+        origin: retainedSource.origin,
+        originPluginId: retainedSource.originPluginId,
+        startedOnBehalfOf: retainedSource.requestedBy,
+        trigger: "user",
+      },
+      acceptedExecution,
+      { phase: "prepared", submissions: [prepared.ticket.submission] },
+      async () => {
+        committed = commitEdit();
+      },
+    );
+    request.initiator = submission.source.initiator;
+    request.senderThreadId = submission.source.senderThreadId;
+    request.queuedMessages = [retainedRow];
+    const guard = await runNativePreparedGuardCheckpoint(
+      deps,
+      request,
+      prepared.ticket,
+    );
+    if (guard.kind === "wait") committed = commitEdit(guard);
+    if (!committed)
+      throw new Error("The native edit checkpoint did not commit its sink");
+    deps.hub.notifyThread(thread.id, ["queue-changed"]);
+    return committed.value;
+  } catch (error) {
+    return throwNativeAdmissionConflict(error);
+  }
+}
