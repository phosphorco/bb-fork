+function observation(
+  ruleId: string,
+  status: "reject" | "unresolved",
+): RuleObservationV1 {
+  return {
+    groupId: "checks",
+    ruleId,
+    revision: "1",
+    status,
+    causes: [{ code: ruleId, message: `Cause ${ruleId}` }],
+    advice: [`Fix ${ruleId}`],
+    routing: "preserve",
+    membership: "preserve",
+  };
+}
