diff --git a/packages/domain/src/message-originals.ts b/packages/domain/src/message-originals.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a536e5a0a04e4adea5b9998af51d006ceac984b3
--- /dev/null
+++ b/packages/domain/src/message-originals.ts
@@ -0,0 +1,240 @@
+import { z } from "zod";
+import { p6rMessageAuthorSchema } from "./p6r-message-author.js";
+import { promptInputSchema } from "./shared-types.js";
+import { startedOnBehalfOfSchema } from "./started-on-behalf-of.js";
+import { threadCreateOriginSchema } from "./thread-create-origin.js";
+
+export const messageDeliveryIntentSchema = z.object({
+  mode: z.enum(["send", "steer", "queue", "queue-batched", "schedule"]),
+  sendAt: z.number().int().nullable(),
+  timingBasis: z.enum(["ordinary", "scheduled", "legacy-unknown"]).optional(),
+});
+export type MessageDeliveryIntent = z.infer<typeof messageDeliveryIntentSchema>;
+export const messageOriginalSchema = z.object({
+  originalId: z.string().min(1),
+  admissionRef: z.string().min(1).optional(),
+  canAsk: z.boolean().optional(),
+  revisionId: z.string().min(1),
+  operationId: z.string().min(1),
+  rawInput: z.array(promptInputSchema).min(1),
+  source: z.object({
+    source: z.enum(["spawn", "tell"]),
+    initiator: z.enum(["user", "agent", "system"]),
+    senderThreadId: z.string().nullable(),
+    origin: threadCreateOriginSchema.nullable(),
+    originPluginId: z.string().nullable(),
+    requestedBy: startedOnBehalfOfSchema.nullable(),
+    rendering: z.enum(["host", "producer"]),
+  }),
+  author: p6rMessageAuthorSchema.nullable(),
+  editor: p6rMessageAuthorSchema.nullable(),
+  acceptedAt: z.number().int(),
+  requestedIntent: messageDeliveryIntentSchema,
+  effectiveIntent: messageDeliveryIntentSchema,
+});
+export type MessageOriginal = z.infer<typeof messageOriginalSchema>;
+export const messageOriginalManifestSchema = z
+  .array(messageOriginalSchema)
+  .min(1)
+  .max(256)
+  .superRefine((originals, ctx) => {
+    const ids = new Set<string>();
+    for (const original of originals) {
+      if (ids.has(original.originalId))
+        ctx.addIssue({
+          code: "custom",
+          message: "Duplicate original identity",
+        });
+      ids.add(original.originalId);
+    }
+  });
+export type MessageOriginalManifest = z.infer<
+  typeof messageOriginalManifestSchema
+>;
+
+export interface QueuePlacementMember {
+  id: string;
+  createdAt?: number;
+  requestedIntent?: string | null;
+  effectiveIntent?: string | null;
+  timingBasis?: "ordinary" | "scheduled" | "legacy-unknown";
+  originalManifest?: string | null;
+  groupWithNext: boolean;
+  joinState: "open" | "divider" | "frozen" | null;
+  scheduledFor: number | null;
+  sendAt: number | null;
+  state: string;
+  payloadKind: string;
+  systemNotice: string | null;
+  model: string;
+  reasoningLevel: string;
+  permissionMode: string;
+  serviceTier: string;
+}
+export type QueuePlacementCandidate = Pick<
+  QueuePlacementMember,
+  | "model"
+  | "reasoningLevel"
+  | "permissionMode"
+  | "serviceTier"
+  | "payloadKind"
+  | "systemNotice"
+  | "scheduledFor"
+>;
+
+export function queueExecutionMatches(
+  a: QueuePlacementCandidate,
+  b: QueuePlacementCandidate,
+): boolean {
+  return (
+    a.model === b.model &&
+    a.reasoningLevel === b.reasoningLevel &&
+    a.permissionMode === b.permissionMode &&
+    a.serviceTier === b.serviceTier
+  );
+}
+export function queueMemberTimingBasis(
+  row: QueuePlacementMember,
+): "ordinary" | "scheduled" | "legacy-unknown" {
+  if (row.timingBasis !== undefined) return row.timingBasis;
+  if (row.effectiveIntent) {
+    try {
+      const parsed = messageDeliveryIntentSchema.safeParse(
+        JSON.parse(row.effectiveIntent),
+      );
+      if (!parsed.success) return "legacy-unknown";
+      return (
+        parsed.data.timingBasis ??
+        (parsed.data.sendAt !== null ? "scheduled" : "ordinary")
+      );
+    } catch {
+      return "legacy-unknown";
+    }
+  }
+  return row.scheduledFor !== null ||
+    (row.joinState === null && row.sendAt !== null)
+    ? "scheduled"
+    : "ordinary";
+}
+export function isScheduledQueueMember(row: QueuePlacementMember): boolean {
+  return (
+    row.scheduledFor !== null ||
+    queueMemberTimingBasis(row) === "scheduled" ||
+    (row.joinState === null && row.sendAt !== null)
+  );
+}
+export function partitionQueuePlacementMembers<T extends QueuePlacementMember>(
+  rows: readonly T[],
+): T[][] {
+  const groups: T[][] = [];
+  let group: T[] = [];
+  for (const row of rows) {
+    group.push(row);
+    if (!row.groupWithNext) {
+      groups.push(group);
+      group = [];
+    }
+  }
+  if (group.length) groups.push(group);
+  return groups;
+}
+export function isValidQueuePlacementGroup(
+  rows: readonly QueuePlacementMember[],
+): boolean {
+  const lead = rows[0];
+  if (!lead || rows.at(-1)?.groupWithNext) return false;
+  if (rows.length === 1) return true;
+  const legacy = rows.every(
+    (row) =>
+      row.requestedIntent === null &&
+      row.originalManifest === null &&
+      row.joinState !== "open",
+  );
+  return rows.every(
+    (row) =>
+      row.payloadKind === "inline" &&
+      row.systemNotice === null &&
+      (legacy || !isScheduledQueueMember(row)) &&
+      queueExecutionMatches(lead, row),
+  );
+}
+export type QueuePlacementSelection =
+  | { kind: "join"; targetIds: string[] }
+  | {
+      kind: "singleton";
+      reason: "no-target" | "closed-target" | "scheduled" | "nonordinary";
+    }
+  | {
+      kind: "conflict";
+      reason: "divider" | "incompatible" | "corrupt-group" | "capacity";
+    };
+export function selectQueueBatchPlacement(
+  rows: readonly QueuePlacementMember[],
+  candidate: QueuePlacementCandidate,
+): QueuePlacementSelection {
+  if (candidate.scheduledFor !== null)
+    return { kind: "singleton", reason: "scheduled" };
+  if (candidate.payloadKind !== "inline" || candidate.systemNotice !== null)
+    return { kind: "singleton", reason: "nonordinary" };
+  const target = partitionQueuePlacementMembers(rows).find((group) =>
+    group.some(
+      (row) =>
+        row.payloadKind === "inline" &&
+        row.systemNotice === null &&
+        !isScheduledQueueMember(row),
+    ),
+  );
+  if (!target) return { kind: "singleton", reason: "no-target" };
+  if (!isValidQueuePlacementGroup(target))
+    return { kind: "conflict", reason: "corrupt-group" };
+  if (target.some((row) => row.joinState === "divider"))
+    return { kind: "conflict", reason: "divider" };
+  if (
+    target.some(
+      (row) =>
+        row.joinState !== "open" ||
+        row.state === "claimed" ||
+        queueMemberTimingBasis(row) === "legacy-unknown",
+    )
+  )
+    return { kind: "singleton", reason: "closed-target" };
+  const tail = target.at(-1)!;
+  if (
+    rows
+      .slice(rows.indexOf(tail) + 1)
+      .some((row) => row.joinState === "divider")
+  )
+    return { kind: "conflict", reason: "divider" };
+  if (target.some((row) => !queueExecutionMatches(row, candidate)))
+    return { kind: "conflict", reason: "incompatible" };
+  if (target.length >= 256) return { kind: "conflict", reason: "capacity" };
+  return { kind: "join", targetIds: target.map((row) => row.id) };
+}
+
+export function selectAutomaticQueueGroup<T extends QueuePlacementMember>(
+  groups: readonly (readonly T[])[],
+  isEligible: (rows: readonly T[]) => boolean,
+): readonly T[] | null {
+  const eligible = groups.filter(
+    (group) => isValidQueuePlacementGroup(group) && isEligible(group),
+  );
+  const dueAtFor = (group: readonly T[]) =>
+    Math.max(
+      ...group
+        .filter(isScheduledQueueMember)
+        .map((row) => row.scheduledFor ?? row.sendAt ?? Infinity),
+    );
+  const scheduled = eligible
+    .filter((group) => group.some(isScheduledQueueMember))
+    .sort((a, b) => dueAtFor(a) - dueAtFor(b))[0];
+  const ordinary = eligible.find(
+    (group) => !group.some(isScheduledQueueMember),
+  );
+  if (!scheduled) return ordinary ?? null;
+  if (!ordinary) return scheduled;
+  const dueAt = dueAtFor(scheduled);
+  const ordinaryCreatedAt = ordinary[0]?.createdAt;
+  return ordinaryCreatedAt !== undefined && ordinaryCreatedAt > dueAt
+    ? scheduled
+    : ordinary;
+}
