+  });
+});
+
+describe("durable create recovery boundaries", () => {
+  it("cancels a queued empty create atomically and never relaunches the same operation", async () => {
+    await withTestHarness(async (harness) => {
+      const { project, environment, request } = creation(harness);
+      const source = seedThread(harness.deps, {
