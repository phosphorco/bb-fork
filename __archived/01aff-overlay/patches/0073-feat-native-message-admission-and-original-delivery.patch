@@ -0,0 +1,931 @@
+import type { SendThreadMessageTransactionCommit } from "./thread-send.js";
+import type { MessageDispatchHookContext } from "@get-bb/plugin-sdk";
+import {
+  AdmissionConflict,
+  admissionDigest,
+  admissionOperationKey,
+  captureQueuedThreadMessagePlacement,
+  createQueuedThreadMessageInTransaction,
+  createQueuedThreadMessageWithPlacementInTransaction,
+  getAdmissionOperation,
+  getAdmissionThreadCreate,
+  transitionAdmissionThreadCreate,
+  getThread,
+  setThreadStartupContext,
+  type CreateQueuedThreadMessageInput,
+  type DbTransaction,
+  type QueuedThreadMessageRow,
+} from "@bb/db";
+import {
+  isStandaloneBuiltinCompactCommand,
+  resolvedThreadExecutionOptionsSchema,
+  threadQueuedMessageSchema,
+  type MessageOriginalManifest,
+  type PromptInput,
+  type ResolvedThreadExecutionOptions,
+  type Thread,
+  type ThreadTurnInitiator,
+} from "@bb/domain";
+import {
+  JsonSchema,
+  SubmissionV1Schema,
+  type AcceptedOriginalV1,
+  type EffectiveIntent,
+  type JsonValue,
+  type OperationRecordV1,
+  type SubmissionV1,
+} from "@phosphorco/bb-message-admission/protocol";
+import { z } from "zod";
+import type { LoggedPendingInteractionWorkSessionDeps } from "../../types.js";
+import type {
+  DispatchAttemptArgs,
+  DispatchAttemptOutcome,
+} from "./dispatch-attempt.js";
+import { readPendingThreadStartContext } from "./dispatch-attempt.js";
+import {
+  getMessageAdmissionService,
+  type PreparedAdmissionTicket,
+} from "./message-admission.js";
+import {
+  admissionOriginalManifest,
+  nativeAcceptedQueueJoinState,
+  jsonNativeAdmissionValue,
+  nativeAdmissionSubmission,
+  throwNativeAdmissionDisposition,
+} from "./message-admission-input.js";
+import type { NativeTurnAdmissionAppend } from "./thread-events.js";
+import {
+  messageOriginalSourceSummary,
+  acceptedContinuationOriginalManifest,
+  assertNativeAcceptedContinuationInput,
+  queuedMessageOriginalManifest,
+  readMessageOriginalManifestForRequest,
+} from "./message-originals.js";
+import { toThreadQueuedMessage } from "./thread-queued-messages.js";
+import { resolveDispatchAuthor } from "./dispatch-author.js";
+import { beginNativeCompactFirst } from "./message-admission-runtime.js";
+
+export type NativeAdmissionDispatchContext = NonNullable<
+  MessageDispatchHookContext["experimental_admission"]
+>;
+
+import {
+  nativeThreadCreateBindingSchema,
+  nativeEmptyCreateControlSchema,
+} from "./message-admission-create-binding.js";
+export {
+  nativeThreadCreateBindingSchema,
+  nativeEmptyCreateControlSchema,
+} from "./message-admission-create-binding.js";
+
+function nativeCreateBinding(value: JsonValue | undefined) {
+  const fields = z.record(z.string(), z.unknown()).safeParse(value);
+  return fields.success &&
+    Object.prototype.hasOwnProperty.call(fields.data, "threadCreate")
+    ? nativeThreadCreateBindingSchema.parse(fields.data.threadCreate)
+    : undefined;
+}
+
+function nativeCreateAcknowledgement(
+  tx: DbTransaction,
+  args: DispatchAttemptArgs,
+) {
+  const binding = nativeCreateBinding(args.nativeProvenance);
+  if (!binding) return {};
+  const reservation = getAdmissionThreadCreate(
+    tx,
+    binding.namespace,
+    binding.operationId,
+  );
+  const nativeOperation = args.nativeOperation ?? {
+    namespace: `native:${args.thread.id}`,
+    operationId: args.payload.operationId,
+  };
+  if (
+    reservation &&
+    (reservation.threadId !== args.thread.id ||
+      reservation.fingerprint !== binding.fingerprint ||
+      reservation.nativeNamespace !== nativeOperation.namespace ||
+      reservation.nativeOperationId !== nativeOperation.operationId ||
+      reservation.state !== "running")
+  )
+    throw new AdmissionConflict(
+      "thread-create-binding-conflict",
+      "Native acceptance does not match its running create reservation",
+    );
+  const thread = getThread(tx, args.thread.id);
+  if (!thread)
+    throw new AdmissionConflict(
+      "thread-create-thread-missing",
+      "Create acknowledgement requires its actual native thread row",
+    );
+  return { threadCreateAcknowledgement: { version: 1, binding, thread } };
+}
+
+function emptyNativeCreateControl(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+  args: DispatchAttemptArgs,
+): NativeDispatchAdmission | undefined {
+  if (
+    args.payload.input.length !== 0 ||
+    (args.payload.mode !== "start" &&
+      !(args.source.kind === "drain" && args.payload.mode === "auto")) ||
+    args.thread.status !== "pending" ||
+    args.originalManifest ||
+    args.retryOf ||
+    args.payload.compactFirst
+  )
+    return undefined;
+  const startContext =
+    args.startContext ?? readPendingThreadStartContext(deps, args.thread.id);
+  if (!startContext || (startContext.providerInput?.length ?? 0) > 0)
+    return undefined;
+  const binding = nativeCreateBinding(args.nativeProvenance);
+  const control = binding
+    ? nativeEmptyCreateControlSchema.parse({
+        binding,
+        nativeOperation: args.nativeOperation ?? {
+          namespace: `native:${args.thread.id}`,
+          operationId: args.payload.operationId,
+        },
+      })
+    : startContext.nativeEmptyCreateControl;
+  if (!control) return undefined;
+  if (
+    args.source.kind === "drain" &&
+    (args.source.claimed.length !== 1 ||
+      control.queueId !== args.source.claimed[0]?.id)
+  )
+    throw new AdmissionConflict(
+      "thread-create-control-queue-conflict",
+      "Empty create control lost its exact reserved queue work item; preserve it for reconciliation",
+    );
+  const boundArgs: DispatchAttemptArgs = {
+    ...args,
+    payload: {
+      ...args.payload,
+      operationId: control.nativeOperation.operationId,
+    },
+    nativeOperation: control.nativeOperation,
+    nativeProvenance: { threadCreate: control.binding },
+  };
+  return {
+    emptyStartControl: true,
+    initiator: "system",
+    permissionEscalation: "deny",
+    dispatchContext: { phase: "accepted", submissions: [] },
+    admissionCreate: ({ tx, input }) => {
+      nativeCreateAcknowledgement(tx, boundArgs);
+      const row = createQueuedThreadMessageInTransaction(tx, {
+        ...input,
+        joinState: "frozen",
+        originalManifest: undefined,
+        admissionRef: undefined,
+      });
+      setThreadStartupContext(tx, {
+        threadId: args.thread.id,
+        startupContext: JSON.stringify({
+          kind: "pending",
+          ...startContext,
+          nativeEmptyCreateControl: { ...control, queueId: row.id },
+        }),
+      });
+      return row;
+    },
+    afterAppendInTransaction: ({ tx }) => {
+      const acknowledgement = nativeCreateAcknowledgement(
+        tx,
+        boundArgs,
+      ).threadCreateAcknowledgement;
+      const reservation = getAdmissionThreadCreate(
+        tx,
+        control.binding.namespace,
+        control.binding.operationId,
+      );
+      if (reservation)
+        transitionAdmissionThreadCreate(tx, {
+          namespace: reservation.namespace,
+          operationId: reservation.operationId,
+          ownerToken: reservation.ownerToken,
+          expectedState: "running",
+          nextState: "acknowledged",
+          response: JSON.stringify({
+            version: 1,
+            thread: acknowledgement!.thread,
+          }),
+        });
+    },
+  };
+}
+
+export interface NativeDispatchAdmission {
+  emptyStartControl?: boolean;
+  afterAppendInTransaction?: SendThreadMessageTransactionCommit;
+  dispatchContext?: NativeAdmissionDispatchContext;
+  initiator?: ThreadTurnInitiator;
+  permissionEscalation?: "ask" | "deny";
+  originalManifest?: MessageOriginalManifest;
+  admissionAppend?: NativeTurnAdmissionAppend;
+  admissionCreate?: (args: {
+    tx: DbTransaction;
+    input: CreateQueuedThreadMessageInput;
+  }) => QueuedThreadMessageRow;
+  execution?: ResolvedThreadExecutionOptions;
+  mode?: "queue-if-active" | "steer-if-active";
+  sendAt?: number;
+  ticket?: PreparedAdmissionTicket;
+}
+
+export function replayNativeDispatchReceipt(
+  record: OperationRecordV1,
+): DispatchAttemptOutcome {
+  if (record.status !== "accepted")
+    return throwNativeAdmissionDisposition(record);
+  const receipt = z
+    .object({
+      acceptanceReceipt: z
+        .object({
+          kind: z.literal("dispatch"),
+          delivery: z.enum(["queued", "sent", "preparing"]),
+          queue: z.record(z.string(), z.unknown()).optional(),
+        })
+        .optional(),
+    })
+    .parse(record).acceptanceReceipt;
+  if (receipt?.delivery === "sent") return { kind: "dispatched" };
+  if (receipt?.delivery === "preparing")
+    return { kind: "preparing", operation: record };
+  if (
+    receipt?.delivery === "queued" &&
+    receipt.queue &&
+    record.acceptedOriginal
+  )
+    return {
+      kind: "queued",
+      entry: threadQueuedMessageSchema.parse({
+        ...receipt.queue,
+        content: record.acceptedOriginal.rawInput,
+      }),
+    };
+  return throwNativeAdmissionDisposition(record);
+}
+
+function submissionSource(args: DispatchAttemptArgs): "spawn" | "tell" {
+  return args.origin === null ? "tell" : "spawn";
+}
+function submissionKind(args: DispatchAttemptArgs): SubmissionV1["kind"] {
+  return args.exemption
+    ? "maintenance"
+    : args.payload.compactFirst
+      ? "compact-first"
+      : isStandaloneBuiltinCompactCommand(args.payload.input)
+        ? "maintenance"
+        : "message";
+}
+
+export async function replayNativeDispatchAdmission(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+  args: DispatchAttemptArgs,
+): Promise<DispatchAttemptOutcome | null> {
+  if (
+    args.source.kind !== "inline" ||
+    args.nativeAdmission ||
+    args.originalManifest ||
+    args.retryOf ||
+    args.preparationOperation ||
+    !args.payload.operationId
+  )
+    return null;
+  const operation = args.nativeOperation ?? {
+    namespace: `native:${args.thread.id}`,
+    operationId: args.payload.operationId,
+  };
+  const row = getAdmissionOperation(
+    deps.db,
+    operation.namespace,
+    operation.operationId,
+  );
+  if (!row) return null;
+  const retained = z
+    .object({ submission: SubmissionV1Schema })
+    .parse(JSON.parse(row.input)).submission;
+  const senderThreadId =
+    args.payload.senderThreadId &&
+    args.payload.senderThreadId !== args.thread.id
+      ? args.payload.senderThreadId
+      : null;
+  const author = resolveDispatchAuthor({
+    retrying: false,
+    senderThreadId,
+    startedOnBehalfOf: args.startedOnBehalfOf,
+  });
+  await nativeAdmissionSubmission(deps.db, {
+    thread: args.thread,
+    input: args.payload.input,
+    authoredRequest: args.authoredPayload!,
+    execution: resolvedThreadExecutionOptionsSchema.parse(
+      retained.requestedIntent.execution.configuration,
+    ),
+    mode: args.payload.mode,
+    sendAt: args.payload.sendAt,
+    operationId: args.payload.operationId,
+    externalOperation: args.nativeOperation,
+    senderThreadId,
+    initiator: author.initiator,
+    author: args.p6rAuthors?.[0],
+    editor: args.p6rEditors?.[0],
+    origin: args.origin,
+    originPluginId: args.originPluginId,
+    requestedBy: args.startedOnBehalfOf,
+    source: submissionSource(args),
+    kind: submissionKind(args),
+    nativeProvenance: args.nativeProvenance,
+    correctionOf: args.payload.correctionOf,
+    visibleHumanActivity: args.visibleHumanActivity,
+    feedbackBinding: args.feedbackBinding,
+    ...(args.pluginSubmission === undefined
+      ? {}
+      : { pluginSubmission: jsonNativeAdmissionValue(args.pluginSubmission) }),
+  });
+  return replayNativeDispatchReceipt(
+    getMessageAdmissionService(deps.db).lookupOperationById(row.id)!,
+  );
+}
+
+function frozenExecution(
+  intent: EffectiveIntent,
+  thread: Thread,
+): ResolvedThreadExecutionOptions {
+  const choices = intent.execution;
+  const execution = resolvedThreadExecutionOptionsSchema.parse(
+    choices.configuration,
+  );
+  if (
+    choices.provider !== thread.providerId ||
+    choices.model !== execution.model ||
+    choices.reasoning !== execution.reasoningLevel ||
+    choices.serviceTier !== execution.serviceTier ||
+    choices.permissionMode !== execution.permissionMode
+  )
+    throw new AdmissionConflict(
+      "execution-basis-conflict",
+      "Accepted execution choices do not match their native resolved tuple",
+    );
+  return execution;
+}
+
+function canonicalOriginals(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+  args: DispatchAttemptArgs,
+): AcceptedOriginalV1[] | null {
+  const service = getMessageAdmissionService(deps.db);
+  if (args.preparationOperation) {
+    const record = service.lookupOperation(args.preparationOperation);
+    if (record?.status !== "accepted" || !record.acceptedOriginal)
+      throw new AdmissionConflict(
+        "preparation-original-missing",
+        "Native preparation lost its accepted original",
+      );
+    return [record.acceptedOriginal];
+  }
+  let manifest: MessageOriginalManifest | undefined;
+  try {
+    const queuedManifest =
+      args.source.kind === "drain"
+        ? queuedMessageOriginalManifest(args.source.claimed)
+        : undefined;
+    if (
+      args.source.kind === "drain" &&
+      args.source.claimed.some(
+        (row) => row.admissionRef !== null || row.originalManifest !== null,
+      ) &&
+      (!queuedManifest ||
+        queuedManifest.some((original) => original.admissionRef === undefined))
+    )
+      throw new AdmissionConflict(
+        "mixed-original-history",
+        "Claimed delivery has incomplete original history; preserve every row and separate or reconcile the legacy submission",
+      );
+    if (
+      queuedManifest &&
+      args.originalManifest &&
+      JSON.stringify(
+        queuedManifest.map((original) => [
+          original.admissionRef,
+          original.originalId,
+          original.revisionId,
+        ]),
+      ) !==
+        JSON.stringify(
+          args.originalManifest.map((original) => [
+            original.admissionRef,
+            original.originalId,
+            original.revisionId,
+          ]),
+        )
+    )
+      throw new AdmissionConflict(
+        "original-vector-conflict",
+        "Supplied render projection cannot replace any claimed original; preserve the complete ordered vector",
+      );
+    manifest =
+      args.originalManifest ??
+      queuedManifest ??
+      (args.retryOf
+        ? readMessageOriginalManifestForRequest(
+            deps.db,
+            args.thread.id,
+            args.retryOf.requestId,
+          )
+        : undefined);
+  } catch (error) {
+    throw new AdmissionConflict(
+      "original-history-invalid",
+      `Stored original history is incomplete or corrupt. Preserve every row; separate the group or explicitly recreate the legacy submission before sending. ${error instanceof Error ? error.message : String(error)}`,
+    );
+  }
+  if (args.acceptedContinuation) {
+    if (
+      !args.retryOf ||
+      (args.source.kind === "drain" &&
+        (args.source.claimed.length !== 1 ||
+          args.source.claimed[0]?.payloadKind !== "retry"))
+    )
+      throw new AdmissionConflict(
+        "continuation-group-conflict",
+        "Accepted continuation requires one exact retry work item and its complete causal original vector",
+      );
+    assertNativeAcceptedContinuationInput(
+      args.payload.input,
+      args.payload.inputGroups,
+    );
+    const actual = acceptedContinuationOriginalManifest(deps.db, {
+      threadId: args.thread.id,
+      continuation: args.acceptedContinuation,
+      retryOf: args.retryOf,
+    });
+    const refs = (values: MessageOriginalManifest) =>
+      values.map((original) => [
+        original.admissionRef,
+        original.originalId,
+        original.revisionId,
+      ]);
+    if (
+      (manifest &&
+        JSON.stringify(refs(manifest)) !== JSON.stringify(refs(actual))) ||
+      (!manifest &&
+        args.source.kind === "drain" &&
+        args.source.claimed.some(
+          (row) => row.admissionRef !== null || row.originalManifest !== null,
+        ))
+    )
+      throw new AdmissionConflict(
+        "continuation-original-conflict",
+        "Continuation work item does not retain its complete exact canonical original vector; preserve every row",
+      );
+    manifest = actual;
+  }
+  const anyKnown =
+    manifest !== undefined ||
+    (args.source.kind === "drain" &&
+      args.source.claimed.some(
+        (row) => row.admissionRef !== null || row.originalManifest !== null,
+      ));
+  if (
+    !manifest ||
+    manifest.some((original) => original.admissionRef === undefined)
+  ) {
+    if (anyKnown)
+      throw new AdmissionConflict(
+        "mixed-original-history",
+        "This delivery mixes known original metadata with missing native history. Preserve every row; separate the group or explicitly recreate the legacy submission before sending.",
+      );
+    return null;
+  }
+  return manifest.map((original) => {
+    const record = service.lookupOperationById(original.admissionRef!);
+    if (
+      record?.status !== "accepted" ||
+      !record.acceptedOriginal ||
+      record.acceptedOriginal.threadId !== args.thread.id ||
+      record.acceptedOriginal.original.originalId !== original.originalId ||
+      String(record.acceptedOriginal.original.revision) !== original.revisionId
+    )
+      throw new AdmissionConflict(
+        "original-acceptance-missing",
+        "A prepared original has no matching native accepted revision",
+      );
+    return record.acceptedOriginal;
+  });
+}
+
+export function frozenNativeDispatchAdmission(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+  args: DispatchAttemptArgs,
+): NativeDispatchAdmission | undefined {
+  const originals = canonicalOriginals(deps, args);
+  if (!originals) return undefined;
+  const service = getMessageAdmissionService(deps.db),
+    manifest = originals.map(admissionOriginalManifest);
+  const execution = frozenExecution(originals[0]!.effectiveIntent, args.thread);
+  for (const original of originals.slice(1)) {
+    const other = frozenExecution(original.effectiveIntent, args.thread);
+    if (
+      other.model !== execution.model ||
+      other.reasoningLevel !== execution.reasoningLevel ||
+      other.permissionMode !== execution.permissionMode ||
+      other.serviceTier !== execution.serviceTier
+    )
+      throw new AdmissionConflict(
+        "batch-execution-conflict",
+        "Accepted batch originals require incompatible execution choices",
+      );
+  }
+  const operationIds = originals.map((original) =>
+    admissionOperationKey(
+      original.operation.namespace,
+      original.operation.operationId,
+    ),
+  );
+  const context: NativeDispatchAdmission = {
+    dispatchContext: {
+      phase: "accepted",
+      submissions: operationIds.map((id) => {
+        const submission = service.readNativeSubmission(id);
+        if (!submission)
+          throw new AdmissionConflict(
+            "native-submission-missing",
+            "Accepted original lost its canonical native input",
+          );
+        return submission;
+      }),
+    },
+    originalManifest: manifest,
+    initiator: messageOriginalSourceSummary(manifest).initiator,
+    permissionEscalation:
+      messageOriginalSourceSummary(manifest).permissionEscalation,
+    execution,
+    ...(originals.some((original) => original.effectiveIntent.mode === "queue")
+      ? { mode: "queue-if-active" as const }
+      : args.preparationOperation
+        ? { mode: "steer-if-active" as const }
+        : {}),
+    ...(args.preparationOperation
+      ? {
+          ...(originals[0]!.effectiveIntent.schedule.kind === "scheduled"
+            ? {
+                sendAt: Date.parse(
+                  originals[0]!.effectiveIntent.schedule.notBefore,
+                ),
+              }
+            : {}),
+        }
+      : {}),
+    admissionAppend: ({ tx, append }) => {
+      if (args.preparationOperation) {
+        if (args.admissionIsActive?.() === false)
+          throw new AdmissionConflict(
+            "preparation-paused",
+            "Native preparation owner is shutting down",
+          );
+        const consumed = service.consumePreparation(
+          tx,
+          args.preparationOperation,
+          () => append(manifest),
+        );
+        if (consumed.kind === "known")
+          throw new AdmissionConflict(
+            "preparation-already-consumed",
+            "Preparation was already committed; reconcile its immutable receipt",
+          );
+        return consumed.value;
+      }
+      const request = append(manifest);
+      service.recordRequestOriginals(tx, {
+        requestId: request.requestId,
+        threadId: args.thread.id,
+        operationIds,
+      });
+      return request;
+    },
+  };
+  if (!args.preparationOperation)
+    context.admissionCreate = ({ tx, input }) => {
+      const row = createQueuedThreadMessageInTransaction(tx, {
+        ...input,
+        originalManifest: manifest,
+        admissionRef: operationIds[0],
+        requestedIntent: manifest[0]!.requestedIntent,
+        effectiveIntent: manifest[0]!.effectiveIntent,
+        joinState: "frozen",
+        scheduledFor: manifest[0]!.effectiveIntent.sendAt,
+      });
+      service.recordQueuedOriginals(tx, {
+        threadId: args.thread.id,
+        queueId: row.id,
+        operationIds,
+        details: args.acceptedContinuation
+          ? jsonNativeAdmissionValue(args.acceptedContinuation)
+          : undefined,
+      });
+      return row;
+    };
+  if (args.acceptedContinuation) {
+    context.originalManifest = undefined;
+    context.admissionAppend = undefined;
+    context.initiator = "system";
+    context.permissionEscalation = "deny";
+    context.afterAppendInTransaction = ({ tx, request }) =>
+      service.recordRequestOriginals(tx, {
+        threadId: args.thread.id,
+        requestId: request.requestId,
+        operationIds,
+      });
+  }
+  if (args.preparationOperation)
+    context.admissionCreate = ({ tx, input }) => {
+      if (args.admissionIsActive?.() === false)
+        throw new AdmissionConflict(
+          "preparation-paused",
+          "Native preparation owner is shutting down",
+        );
+      const consumed = service.consumePreparation(
+        tx,
+        args.preparationOperation!,
+        (accepted) => {
+          const rowInput = acceptedQueueInput(input, accepted);
+          if (accepted.effectiveIntent.membership === "join-next-ordinary") {
+            const witness = args.preparationPlacement;
+            if (!witness)
+              throw new AdmissionConflict(
+                "placement-witness-missing",
+                "Accepted batch preparation lost its original membership witness",
+              );
+            const inserted =
+              createQueuedThreadMessageWithPlacementInTransaction(
+                tx,
+                rowInput,
+                {
+                  witness,
+                  ...(witness.selection.kind === "join"
+                    ? { expectedTargetIds: witness.selection.targetIds }
+                    : {}),
+                },
+              );
+            if (inserted.kind === "conflict")
+              throw new AdmissionConflict(
+                "placement-conflict",
+                `Accepted preparation attachment conflicted: ${inserted.reason}`,
+              );
+            return {
+              queueId: inserted.queuedMessage.id,
+              row: inserted.queuedMessage,
+            };
+          }
+          const row = createQueuedThreadMessageInTransaction(tx, rowInput);
+          return { queueId: row.id, row };
+        },
+      );
+      if (consumed.kind === "known")
+        throw new AdmissionConflict(
+          "preparation-already-consumed",
+          "Preparation was already committed",
+        );
+      return consumed.value.row;
+    };
+  return context;
+}
+
+function acceptedQueueInput(
+  base: CreateQueuedThreadMessageInput,
+  accepted: AcceptedOriginalV1,
+): CreateQueuedThreadMessageInput {
+  const original = admissionOriginalManifest(accepted);
+  return {
+    ...base,
+    content: original.rawInput,
+    joinState: nativeAcceptedQueueJoinState(accepted),
+    scheduledFor: original.effectiveIntent.sendAt,
+    requestedIntent: original.requestedIntent,
+    effectiveIntent: original.effectiveIntent,
+    admissionRef: original.admissionRef,
+    originalManifest: [original],
+  };
+}
+
+export function assertNativeExplicitExecutionPreserved(
+  payload: Pick<
+    DispatchAttemptArgs["payload"],
+    | "model"
+    | "reasoningLevel"
+    | "permissionMode"
+    | "serviceTier"
+    | "executionInputSources"
+  >,
+  execution: ResolvedThreadExecutionOptions,
+): void {
+  for (const field of [
+    "model",
+    "reasoningLevel",
+    "permissionMode",
+    "serviceTier",
+  ] as const) {
+    const requested = payload[field];
+    if (
+      requested !== undefined &&
+      (payload.executionInputSources?.[field] ?? "explicit") === "explicit" &&
+      requested !== execution[field]
+    )
+      throw new AdmissionConflict(
+        "execution-choice-conflict",
+        `Explicit ${field}=${requested} cannot execute as ${execution[field]}; choose a supported setting instead of silently replacing it`,
+      );
+  }
+}
+
+export async function prepareNativeDispatchAdmission(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+  args: DispatchAttemptArgs,
+  input: {
+    thread: Thread;
+    rawInput: PromptInput[];
+    authoredPayload: JsonValue;
+    senderThreadId: string | null;
+    execution: ResolvedThreadExecutionOptions;
+  },
+): Promise<
+  | { kind: "known"; outcome: DispatchAttemptOutcome }
+  | { kind: "ready"; context: NativeDispatchAdmission }
+> {
+  const emptyControl = emptyNativeCreateControl(deps, args);
+  if (emptyControl) return { kind: "ready", context: emptyControl };
+  const service = getMessageAdmissionService(deps.db),
+    frozen = frozenNativeDispatchAdmission(deps, args);
+  if (frozen) return { kind: "ready", context: frozen };
+  const legacyManifest =
+    args.originalManifest ??
+    (args.source.kind === "drain"
+      ? queuedMessageOriginalManifest(args.source.claimed)
+      : undefined);
+  if (args.source.kind === "drain" || args.retryOf)
+    return {
+      kind: "ready",
+      context: {
+        originalManifest: legacyManifest,
+        dispatchContext: { phase: "accepted", submissions: [] },
+      },
+    };
+  assertNativeExplicitExecutionPreserved(args.payload, input.execution);
+  const placement = captureQueuedThreadMessagePlacement(
+    deps.db,
+    input.thread.id,
+    {
+      model: input.execution.model,
+      reasoningLevel: input.execution.reasoningLevel,
+      permissionMode: input.execution.permissionMode,
+      serviceTier: input.execution.serviceTier,
+      scheduledFor: args.payload.sendAt ?? null,
+      payloadKind: args.queuePayload.kind,
+      systemNotice: null,
+    },
+  );
+  const author = resolveDispatchAuthor({
+    retrying: false,
+    senderThreadId: input.senderThreadId,
+    startedOnBehalfOf: args.startedOnBehalfOf,
+  });
+  const submission = await nativeAdmissionSubmission(deps.db, {
+    thread: input.thread,
+    input: input.rawInput,
+    authoredRequest: input.authoredPayload,
+    execution: input.execution,
+    mode: args.payload.mode,
+    sendAt: args.payload.sendAt,
+    operationId: args.payload.operationId,
+    externalOperation: args.nativeOperation,
+    senderThreadId: input.senderThreadId,
+    initiator: author.initiator,
+    author: args.p6rAuthors?.[0],
+    editor: args.p6rEditors?.[0],
+    origin: args.origin,
+    originPluginId: args.originPluginId,
+    requestedBy: args.startedOnBehalfOf,
+    source: submissionSource(args),
+    kind: submissionKind(args),
+    nativeProvenance: args.nativeProvenance,
+    correctionOf: args.payload.correctionOf,
+    visibleHumanActivity: args.visibleHumanActivity,
+    feedbackBinding: args.feedbackBinding,
+    ...(args.pluginSubmission === undefined
+      ? {}
+      : { pluginSubmission: jsonNativeAdmissionValue(args.pluginSubmission) }),
+    expectedPlacementWitness: admissionDigest(placement.orderedRows),
+  });
+  const exemption =
+    args.exemption ??
+    (isStandaloneBuiltinCompactCommand(input.rawInput)
+      ? {
+          kind: "standalone-compact" as const,
+          nativeOperation: submission.operation,
+          original: submission.original,
+        }
+      : undefined);
+  if (args.payload.compactFirst)
+    return beginNativeCompactFirst(deps, args, submission, placement);
+  const prepared = await service.prepare({ submission, exemption });
+  if (prepared.kind === "known")
+    return {
+      kind: "known",
+      outcome: replayNativeDispatchReceipt(prepared.operation),
+    };
+  const ticket = prepared.ticket,
+    execution = frozenExecution(ticket.effectiveIntent, input.thread);
+  return {
+    kind: "ready",
+    context: {
+      ticket,
+      dispatchContext: { phase: "prepared", submissions: [ticket.submission] },
+      initiator: ticket.submission.source.initiator,
+      permissionEscalation:
+        ticket.submission.source.initiator === "user" &&
+        ticket.effectiveIntent.execution.canAsk
+          ? "ask"
+          : "deny",
+      execution,
+      admissionCreate: ({ tx, input: base }) =>
+        service.commit(tx, ticket, (accepted) => {
+          if (args.admissionIsActive?.() === false)
+            throw new AdmissionConflict(
+              "preparation-paused",
+              "Native admission owner is shutting down",
+            );
+          const rowInput = acceptedQueueInput(base, accepted);
+          const inserted =
+            accepted.effectiveIntent.membership === "join-next-ordinary"
+              ? createQueuedThreadMessageWithPlacementInTransaction(
+                  tx,
+                  rowInput,
+                  {
+                    witness: placement,
+                    ...(placement.selection.kind === "join"
+                      ? { expectedTargetIds: placement.selection.targetIds }
+                      : {}),
+                  },
+                )
+              : {
+                  kind: "inserted" as const,
+                  queuedMessage: createQueuedThreadMessageInTransaction(
+                    tx,
+                    rowInput,
+                  ),
+                };
+          if (inserted.kind === "conflict")
+            throw new AdmissionConflict(
+              "placement-conflict",
+              `Batch attachment conflicted: ${inserted.reason}. The draft was not queued.`,
+            );
+          const { content: _content, ...queue } = toThreadQueuedMessage(
+            inserted.queuedMessage,
+          );
+          return {
+            queueId: inserted.queuedMessage.id,
+            row: inserted.queuedMessage,
+            acceptanceReceipt: jsonNativeAdmissionValue({
+              kind: "dispatch",
+              delivery: "queued",
+              queue,
+              ...nativeCreateAcknowledgement(tx, args),
+            }),
+          };
+        }).value.row,
+      admissionAppend: ({ tx, append }) =>
+        service.commit(tx, ticket, (accepted) => {
+          if (args.admissionIsActive?.() === false)
+            throw new AdmissionConflict(
+              "preparation-paused",
+              "Native admission owner is shutting down",
+            );
+          const appended = append([admissionOriginalManifest(accepted)]);
+          return {
+            ...appended,
+            acceptanceReceipt: JsonSchema.parse({
+              kind: "dispatch",
+              delivery: "sent",
+              ...nativeCreateAcknowledgement(tx, args),
+            }),
+          };
+        }).value,
+      ...(ticket.effectiveIntent.mode !== submission.requestedIntent.mode
+        ? {
+            mode:
+              ticket.effectiveIntent.mode === "queue"
+                ? ("queue-if-active" as const)
+                : ("steer-if-active" as const),
+          }
+        : {}),
+      ...(ticket.effectiveIntent.schedule.kind === "scheduled"
+        ? { sendAt: Date.parse(ticket.effectiveIntent.schedule.notBefore) }
+        : {}),
+    },
+  };
+}
diff --git a/apps/server/src/services/threads/message-admission-input.ts b/apps/server/src/services/threads/message-admission-input.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fd131d9200a4945800d17d715cd5c09127a1f98f
--- /dev/null
+++ b/apps/server/src/services/threads/message-admission-input.ts
@@ -0,0 +1,470 @@
+import { createHash, randomUUID } from "node:crypto";
+import {
+  AdmissionConflict,
+  admissionDigest,
+  admissionOperationKey,
+  getAdmissionOperation,
+  getProject,
+  getThread,
+  type DbConnection,
+} from "@bb/db";
+import {
+  p6rMessageAuthorSchema,
+  promptInputSchema,
+  startedOnBehalfOfSchema,
+  threadCreateOriginSchema,
+  type MessageDeliveryIntent,
+  type MessageOriginal,
+  type P6rMessageAuthor,
+  type PromptInput,
+  type ResolvedThreadExecutionOptions,
+  type StartedOnBehalfOf,
+  type Thread,
+  type ThreadCreateOrigin,
+  type ThreadTurnInitiator,
+} from "@bb/domain";
+import {
+  JsonSchema,
+  SubmissionV1Schema,
+  canonicalJson,
+  submissionFingerprint,
+  type AcceptedOriginalV1,
+  type JsonValue,
+  type OperationRecordV1,
+  type SubmissionV1,
+} from "@phosphorco/bb-message-admission/protocol";
+import { z } from "zod";
+import {
+  messageCorrectionOfSchema,
+  type SendMessageRequest,
+} from "@bb/server-contract";
+import { ApiError } from "../../errors.js";
+import {
+  getMessageAdmissionService,
+  MESSAGE_ADMISSION_LIMITS,
+} from "./message-admission.js";
+
+const originSchema = z.object({
+  source: z.enum(["spawn", "tell"]),
+  origin: threadCreateOriginSchema.nullable(),
+  originPluginId: z.string().nullable(),
+  requestedBy: startedOnBehalfOfSchema.nullable(),
+  rendering: z.enum(["host", "producer"]),
+  nativeMode: z.string(),
+});
+
+function validateNativeMessageCorrection(
+  db: DbConnection,
+  args: {
+    threadId: string;
+    correctionOf: z.infer<typeof messageCorrectionOfSchema>;
+    newOperationId?: string;
+  },
+): z.infer<typeof messageCorrectionOfSchema> {
+  const correlation = messageCorrectionOfSchema.parse(args.correctionOf);
+  const previous = getAdmissionOperation(
+    db,
+    correlation.operation.namespace,
+    correlation.operation.operationId,
+  );
+  const service = getMessageAdmissionService(db);
+  const record =
+    previous === null ? null : service.lookupOperationById(previous.id);
+  const accepted = record?.acceptedOriginal;
+  if (
+    args.newOperationId === correlation.operation.operationId ||
+    previous?.namespace !== `native:${args.threadId}` ||
+    previous.threadId !== args.threadId ||
+    record?.status !== "accepted" ||
+    accepted?.threadId !== args.threadId ||
+    accepted.original.originalId !== correlation.original.originalId ||
+    accepted.original.revision !== correlation.original.revision ||
+    service.readNativeSubmission(previous.id)?.kind !== "edit"
+  )
+    throw new AdmissionConflict(
+      "correction-original-conflict",
+      "A separate correction requires a new operation and the exact accepted historical edit original at this destination",
+    );
+  const beforeEffects = z.object({
+    version: z.literal(1),
+    kind: z.literal("message-edit"),
+    stage: z.literal("before-effects"),
+    threadId: z.literal(args.threadId),
+  });
+  const failedBeforeEffectsConflict = beforeEffects.extend({
+    conflict: z.object({
+      code: z.enum([
+        "historical-edit-target-changed",
+        "historical-edit-send-now-changed",
+      ]),
+    }),
+  });
+  const details =
+    previous.preparation === null ? null : JSON.parse(previous.preparation);
+  const cancelled = z
+    .union([
+      z.object({
+        previousState: z.literal("pending"),
+        previous: beforeEffects,
+      }),
+      z.object({
+        previousState: z.literal("failed"),
+        previous: failedBeforeEffectsConflict,
+      }),
+    ])
+    .safeParse(details);
+  const safe =
+    previous.preparationState === "failed"
+      ? failedBeforeEffectsConflict.safeParse(details).success
+      : previous.preparationState === "cancelled" &&
+        (beforeEffects
+          .extend({
+            reason: z.literal("Queued edit was removed before history effects"),
+          })
+          .safeParse(details).success ||
+          cancelled.success);
+  if (!safe)
+    throw new AdmissionConflict(
+      "correction-delivery-unresolved",
+      "The historical edit is not positively failed or cancelled before effects. Reconcile possible effects before submitting a separate correction.",
+    );
+  return correlation;
+}
+
+export function readNativeMessageCorrection(
+  db: DbConnection,
+  args: { threadId: string; journalId: string },
+): z.infer<typeof messageCorrectionOfSchema> | undefined {
+  const record = getMessageAdmissionService(db).lookupOperationById(
+    args.journalId,
+  );
+  if (!record?.acceptedOriginal) return undefined;
+  try {
+    return validateNativeMessageCorrection(db, {
+      threadId: args.threadId,
+      correctionOf: {
+        operation: record.operation,
+        original: record.acceptedOriginal.original,
+      },
+    });
+  } catch (error) {
+    if (error instanceof AdmissionConflict) return undefined;
+    throw error;
+  }
+}
+
+export async function nativeAdmissionSubmission(
+  db: DbConnection,
+  args: {
+    thread: Thread;
+    input: PromptInput[];
+    authoredRequest: JsonValue;
+    execution: ResolvedThreadExecutionOptions;
+    mode: string;
+    sendAt?: number;
+    operationId?: string;
+    originalId?: string;
+    revision?: number;
+    senderThreadId: string | null;
+    initiator: ThreadTurnInitiator;
+    author?: P6rMessageAuthor | null;
+    editor?: P6rMessageAuthor | null;
+    origin: ThreadCreateOrigin | null;
+    originPluginId: string | null;
+    requestedBy: StartedOnBehalfOf | null;
+    source?: "spawn" | "tell";
+    rendering?: "host" | "producer";
+    kind?: SubmissionV1["kind"];
+    override?: SubmissionV1["override"];
+    externalOperation?: SubmissionV1["operation"];
+    feedbackBinding?: SubmissionV1["feedbackBinding"];
+    expectedPlacementWitness?: string | null;
+    canAsk?: boolean;
+    visibleHumanActivity?: boolean;
+    schedule?: SubmissionV1["requestedIntent"]["schedule"];
+    pluginSubmission?: JsonValue;
+    nativeProvenance?: JsonValue;
+    correctionOf?: SendMessageRequest["correctionOf"];
+  },
+): Promise<SubmissionV1> {
+  const operation = args.externalOperation ?? {
+    namespace: `native:${args.thread.id}`,
+    operationId: args.operationId ?? randomUUID(),
+  };
+  const originalId =
+    args.originalId ??
+    `original_${createHash("sha256").update(JSON.stringify(operation)).digest("hex").slice(0, 40)}`;
+  const requestBinding = admissionDigest(
+    canonicalJson(
+      {
+        authoredRequest: args.authoredRequest,
+        originalId,
+        revision: args.revision ?? 1,
+        source: args.source ?? "tell",
+        kind: args.kind ?? "message",
+        mode: args.mode,
+        senderThreadId: args.senderThreadId,
+        initiator: args.initiator,
+        authorIdentity: args.author?.identity ?? null,
+        editorIdentity: args.editor?.identity ?? null,
+        rendering: args.rendering ?? "host",
+        originPluginId: args.originPluginId,
+        origin: JsonSchema.parse(args.origin),
+        requestedBy: JsonSchema.parse(args.requestedBy),
+        feedbackBinding: args.feedbackBinding ?? null,
+        nativePluginSubmission: args.pluginSubmission ?? null,
+        nativeProvenance: args.nativeProvenance ?? null,
+        ...(args.correctionOf === undefined
+          ? {}
+          : {
+              correctionOf: messageCorrectionOfSchema.parse(args.correctionOf),
+            }),
+        override: args.override ?? "none",
+        canAsk: args.canAsk ?? args.initiator === "user",
+        visibleHumanActivity: args.visibleHumanActivity ?? null,
+        schedule:
+          args.schedule ??
+          (args.sendAt === undefined
+            ? { kind: "ordinary" }
+            : {
+                kind: "scheduled",
+                notBefore: new Date(args.sendAt).toISOString(),
+              }),
+      },
+      MESSAGE_ADMISSION_LIMITS.requestBytes,
+    ),
+  );
+  const prior = getAdmissionOperation(
+    db,
+    operation.namespace,
+    operation.operationId,
+  );
+  if (prior !== null) {
+    const retained = z
+      .object({ submission: SubmissionV1Schema })
+      .parse(JSON.parse(prior.input)).submission;
+    const retainedOrigin = z
+      .object({ requestBinding: z.string() })
+      .parse(retained.source.origin);
+    if (retainedOrigin.requestBinding !== requestBinding) {
+      throw new AdmissionConflict(
+        "operation-fingerprint-conflict",
+        "Operation ID already identifies different authored input or source",
+      );
+    }
+    return retained;
+  }
+  if (args.correctionOf !== undefined)
+    validateNativeMessageCorrection(db, {
+      threadId: args.thread.id,
+      correctionOf: args.correctionOf,
+      newOperationId: operation.operationId,
+    });
+  const project = getProject(db, args.thread.projectId);
+  const sender =
+    args.senderThreadId === null ? null : getThread(db, args.senderThreadId);
+  const rawInput = JsonSchema.parse(args.input);
+  const origin = JsonSchema.parse({
+    source: args.source ?? "tell",
+    origin: args.origin,
+    originPluginId: args.originPluginId,
+    requestedBy: args.requestedBy,
+    rendering: args.rendering ?? "host",
+    nativeMode: args.mode,
+    requestBinding,
+    nativePluginSubmission: args.pluginSubmission ?? null,
+    nativeProvenance: args.nativeProvenance ?? null,
+    ...(args.correctionOf === undefined
+      ? {}
+      : { correctionOf: args.correctionOf }),
+  });
+  const activityActor = args.editor ?? args.author;
+  const humanActivity =
+    args.visibleHumanActivity ??
+    (activityActor === undefined || activityActor === null
+      ? args.initiator === "user"
+      : activityActor.identity.kind === "person" &&
+        activityActor.evidence === "provider-verified");
+  const input: Omit<SubmissionV1, "operation" | "requestFingerprint"> = {
+    version: 1,
+    original: { originalId, revision: args.revision ?? 1 },
+    threadId: args.thread.id,
+    projectId: args.thread.projectId,
+    rawInput,
+    policyContext: {
+      messageText: args.input
+        .filter((block) => block.type === "text")
+        .map((block) => block.text)
+        .join("\n\n"),
+      projectTitle: project?.name ?? null,
+      senderTitle: sender?.title ?? null,
+      destinationTitle: args.thread.title,
+    },
+    requestedIntent: {
+      mode: ["queue", "queue-if-active", "queue-batched"].includes(args.mode)
+        ? "queue"
+        : args.mode === "steer" || args.mode === "steer-if-active"
+          ? "steer"
+          : "proceed",
+      schedule:
+        args.schedule ??
+        (args.sendAt === undefined
+          ? { kind: "ordinary" }
+          : {
+              kind: "scheduled",
+              notBefore: new Date(args.sendAt).toISOString(),
+            }),
+      membership:
+        args.mode === "queue-batched" ? "join-next-ordinary" : "preserve",
+      execution: {
+        provider: args.thread.providerId,
+        model: args.execution.model,
+        reasoning: args.execution.reasoningLevel,
+        serviceTier: args.execution.serviceTier,
+        permissionMode: args.execution.permissionMode,
+        canAsk: args.canAsk ?? args.initiator === "user",
+        configuration: JsonSchema.parse(args.execution),
+      },
+    },
+    source: {
+      senderThreadId: args.senderThreadId,
+      initiator: args.initiator,
+      author: JsonSchema.parse(args.author ?? null),
+      editor: JsonSchema.parse(args.editor ?? null),
+      origin,
+      externalOperation: args.externalOperation ?? null,
+      visibleHumanActivity:
+        humanActivity &&
+        args.input.some((block) => block.visibility !== "agent-only"),
+    },
+    kind: args.kind ?? "message",
+    override: args.override ?? "none",
+    expectedPlacementWitness: args.expectedPlacementWitness ?? null,
+    ...(args.feedbackBinding === undefined
+      ? {}
+      : { feedbackBinding: args.feedbackBinding }),
+  };
+  return {
+    ...input,
+    operation,
+    requestFingerprint: await submissionFingerprint(
+      input,
+      MESSAGE_ADMISSION_LIMITS.requestBytes,
+    ),
+  };
+}
+
+function nativeIntent(
+  intent:
+    | AcceptedOriginalV1["effectiveIntent"]
+    | AcceptedOriginalV1["requestedIntent"],
+): MessageDeliveryIntent {
+  const sendAt =
+    intent.schedule.kind === "scheduled"
+      ? Date.parse(intent.schedule.notBefore)
+      : null;
+  return {
+    mode:
+      intent.membership === "join-next-ordinary"
+        ? "queue-batched"
+        : sendAt !== null
+          ? "schedule"
+          : intent.mode === "queue"
+            ? "queue"
+            : intent.mode === "steer"
+              ? "steer"
+              : "send",
+    sendAt,
+    timingBasis: intent.schedule.kind,
+  };
+}
+
+export function admissionOriginalManifest(
+  original: AcceptedOriginalV1,
+): MessageOriginal {
+  const origin = originSchema.parse(original.source.origin);
+  return {
+    originalId: original.original.originalId,
+    admissionRef: admissionOperationKey(
+      original.operation.namespace,
+      original.operation.operationId,
+    ),
+    revisionId: String(original.original.revision),
+    operationId: original.operation.operationId,
+    rawInput: z.array(promptInputSchema).parse(original.rawInput),
+    source: {
+      source: origin.source,
+      senderThreadId: original.source.senderThreadId,
+      initiator: original.source.initiator,
+      origin: origin.origin,
+      originPluginId: origin.originPluginId,
+      requestedBy: origin.requestedBy,
+      rendering: origin.rendering,
+    },
+    author: p6rMessageAuthorSchema.nullable().parse(original.source.author),
+    editor: p6rMessageAuthorSchema.nullable().parse(original.source.editor),
+    acceptedAt: Date.parse(original.acceptedAt),
+    canAsk: original.effectiveIntent.execution.canAsk,
+    requestedIntent: nativeIntent(original.requestedIntent),
+    effectiveIntent: nativeIntent(original.effectiveIntent),
+  };
+}
+
+export function jsonNativeAdmissionValue(value: unknown): JsonValue {
+  return JsonSchema.parse(value);
+}
+
+export function nativeAcceptedQueueJoinState(
+  original: AcceptedOriginalV1,
+): "open" | "frozen" | "divider" {
+  if (original.effectiveIntent.schedule.kind !== "ordinary") return "frozen";
+  return original.effectiveIntent.membership === "separate"
+    ? "divider"
+    : "open";
+}
+
+export function throwNativeAdmissionDisposition(
+  operation: OperationRecordV1,
+): never {
+  const advice = [
+    ...new Set(
+      operation.assessments.flatMap((assessment) => assessment.advice),
+    ),
+  ];
+  const label =
+    operation.status === "accepted"
+      ? "This message revision was already accepted. Its preparation or delivery requires reconciliation; do not submit a replacement operation blindly."
+      : operation.status === "rejected"
+        ? "Message rejected. Correct all identified issues before submitting a new revision."
+        : operation.status === "conflict"
+          ? "Message admission conflicted. Preserve the draft and reconcile its operation."
+          : "Message admission is unresolved. The message has not been accepted; preserve the draft and reconcile its operation.";
+  const diagnosis = [
+    ...new Set([
+      ...operation.reasons.map((reason) => reason.message),
+      ...operation.assessments.flatMap((assessment) =>
+        assessment.causes.map((cause) => cause.message),
+      ),
+      ...advice,
+    ]),
+  ];
+  throw new ApiError(
+    409,
+    `message_admission_${operation.status}`,
+    [label, ...diagnosis].join("\n\n"),
+    {
+      details: { version: 1, admission: operation },
+      retryable: false,
+    },
+  );
+}
+
+export function throwNativeAdmissionConflict(error: unknown): never {
+  if (error instanceof AdmissionConflict) {
+    throw new ApiError(409, "message_admission_conflict", error.message, {
+      details: { version: 1, reason: error.code },
+      retryable: false,
+    });
+  }
+  throw error;
+}
diff --git a/apps/server/src/services/threads/message-admission-placement.ts b/apps/server/src/services/threads/message-admission-placement.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6fe2a2fb2ccf09bd215aea5d48f06a607c906407
--- /dev/null
+++ b/apps/server/src/services/threads/message-admission-placement.ts
@@ -0,0 +1,173 @@
+import {
+  selectQueueBatchPlacement,
+  type QueuePlacementCandidate,
+  type QueuePlacementMember,
+} from "@bb/domain";
+import {
+  PreviewPlacementInputV1Schema,
+  decodeBounded,
+  type AcceptedOriginalV1,
+  type PreviewPlacementResultV1,
+  type RequestedIntent,
+} from "@phosphorco/bb-message-admission/protocol";
+
+function execution(intent: RequestedIntent): QueuePlacementCandidate | null {
+  const choices = intent.execution;
+  if (
+    choices.provider === null ||
+    choices.model === null ||
+    choices.reasoning === null ||
+    choices.permissionMode === null ||
+    choices.serviceTier === null
+  )
+    return null;
+  return {
+    model: choices.model,
+    reasoningLevel: choices.reasoning,
+    permissionMode: choices.permissionMode,
+    serviceTier: choices.serviceTier,
+    payloadKind: "inline",
+    systemNotice: null,
+    scheduledFor:
+      intent.schedule.kind === "scheduled"
+        ? Date.parse(intent.schedule.notBefore)
+        : null,
+  };
+}
+
+export function previewNativeMessagePlacement(
+  raw: unknown,
+  maxBytes: number,
+): PreviewPlacementResultV1 {
+  const input = decodeBounded(PreviewPlacementInputV1Schema, raw, maxBytes);
+  const conflict = (
+    code: string,
+    message: string,
+  ): PreviewPlacementResultV1 => ({
+    version: 1,
+    simulation: true,
+    status: "conflict",
+    targetGroupId: null,
+    orderedOriginalIds: [],
+    reasons: [{ code, message }],
+  });
+  const candidate = input.candidate;
+  if (candidate.requestedIntent.membership !== "join-next-ordinary")
+    return {
+      version: 1,
+      simulation: true,
+      status: "separate",
+      targetGroupId: null,
+      orderedOriginalIds: [candidate.original.originalId],
+      reasons: [
+        {
+          code: "membership-separate",
+          message:
+            "Candidate does not request joining the next ordinary delivery",
+        },
+      ],
+    };
+  if (candidate.requestedIntent.schedule.kind === "legacy-unknown")
+    return conflict(
+      "legacy-intent-unknown",
+      "Unknown historical timing cannot create a new automatic attachment",
+    );
+  const candidateExecution = execution(candidate.requestedIntent);
+  if (!candidateExecution)
+    return conflict(
+      "execution-unresolved",
+      "Placement simulation requires native resolved provider, model, reasoning, permission and service tier choices",
+    );
+  const groups = [...input.queue].sort((a, b) =>
+    a.orderKey < b.orderKey ? -1 : a.orderKey > b.orderKey ? 1 : 0,
+  );
+  const byOriginal = new Map<
+    string,
+    { groupId: string; witness: string; original: AcceptedOriginalV1 }
+  >();
+  const rows: QueuePlacementMember[] = [];
+  for (const group of groups) {
+    for (const [index, original] of group.originals.entries()) {
+      if (
+        byOriginal.has(original.original.originalId) ||
+        original.original.originalId === candidate.original.originalId
+      )
+        return conflict(
+          "duplicate-original",
+          "A fixture original may appear only once in the queue and candidate",
+        );
+      if (original.threadId !== candidate.threadId)
+        return conflict(
+          "destination-conflict",
+          "Fixture originals must belong to the candidate destination",
+        );
+      const tuple = execution(original.effectiveIntent);
+      if (!tuple)
+        return conflict(
+          "execution-unresolved",
+          "Fixture original does not retain resolved execution choices",
+        );
+      if (
+        original.effectiveIntent.execution.provider !==
+        candidate.requestedIntent.execution.provider
+      )
+        return conflict(
+          "provider-conflict",
+          "Fixture provider differs from the destination provider",
+        );
+      byOriginal.set(original.original.originalId, {
+        groupId: group.groupId,
+        witness: group.witness,
+        original,
+      });
+      rows.push({
+        ...tuple,
+        id: original.original.originalId,
+        joinState: group.joinState,
+        timingBasis: original.effectiveIntent.schedule.kind,
+        groupWithNext: index < group.originals.length - 1,
+        sendAt: tuple.scheduledFor,
+        state: group.claimed ? "claimed" : "queued",
+      });
+    }
+  }
+  const selection = selectQueueBatchPlacement(rows, candidateExecution);
+  const lead =
+    selection.kind === "join" ? byOriginal.get(selection.targetIds[0]!) : null;
+  if (
+    candidate.expectedPlacementWitness !== null &&
+    (selection.kind !== "join" ||
+      lead?.witness !== candidate.expectedPlacementWitness)
+  )
+    return conflict(
+      "target-changed",
+      "Previously evaluated placement target changed or closed; no retargeting occurred",
+    );
+  if (selection.kind === "conflict")
+    return conflict(
+      selection.reason,
+      `Native placement cannot join the first ordinary target: ${selection.reason}`,
+    );
+  if (selection.kind === "singleton")
+    return {
+      version: 1,
+      simulation: true,
+      status: "singleton",
+      targetGroupId: null,
+      orderedOriginalIds: [candidate.original.originalId],
+      reasons: [
+        {
+          code: selection.reason,
+          message: `Native placement creates a singleton: ${selection.reason}`,
+        },
+      ],
+    };
+  return {
+    version: 1,
+    simulation: true,
+    status: "join",
+    targetGroupId: lead!.groupId,
+    orderedOriginalIds: [...selection.targetIds, candidate.original.originalId],
+    reasons: [],
+  };
+}
diff --git a/apps/server/src/services/threads/message-admission-queue-edit.ts b/apps/server/src/services/threads/message-admission-queue-edit.ts
