diff --git a/apps/app/src/components/thread/thread-admission-correction.ts b/apps/app/src/components/thread/thread-admission-correction.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e37d3a2f667d1b561f93a9809e54d31df5092eed
--- /dev/null
+++ b/apps/app/src/components/thread/thread-admission-correction.ts
@@ -0,0 +1,67 @@
+import {
+  promptInputSchema,
+  resolvedThreadExecutionOptionsSchema,
+} from "@bb/domain";
+import {
+  messageCorrectionOfSchema,
+  type SendMessageRequest,
+  type ThreadAdmissionOperationResponse,
+} from "@bb/server-contract";
+import { z } from "zod";
+
+export function preparationInputPreview(
+  item: ThreadAdmissionOperationResponse,
+): string {
+  const input = z
+    .array(promptInputSchema)
+    .safeParse(item.record.acceptedOriginal?.rawInput);
+  if (!input.success) return "Retained accepted content";
+  const text = input.data.find((chunk) => chunk.type === "text");
+  return text?.type === "text"
+    ? text.text.slice(0, 160)
+    : `${input.data.length} retained input items`;
+}
+
+export function separateCorrectionRequest(
+  item: ThreadAdmissionOperationResponse,
+): SendMessageRequest | null {
+  const accepted = item.record.acceptedOriginal;
+  const action = messageCorrectionOfSchema.safeParse(item.correctionOf);
+  if (
+    !accepted ||
+    item.record.status !== "accepted" ||
+    (item.preparationState !== "failed" &&
+      item.preparationState !== "cancelled") ||
+    item.record.delivery.state !==
+      (item.preparationState === "cancelled"
+        ? "cancelled"
+        : "preparation-failed") ||
+    !action.success
+  )
+    return null;
+  const correction = action.data;
+  if (
+    correction.operation.namespace !== item.record.operation.namespace ||
+    correction.operation.operationId !== item.record.operation.operationId ||
+    correction.original.originalId !== accepted.original.originalId ||
+    correction.original.revision !== accepted.original.revision
+  )
+    return null;
+  const execution = resolvedThreadExecutionOptionsSchema.safeParse(
+    accepted.effectiveIntent.execution.configuration,
+  );
+  const input = z.array(promptInputSchema).safeParse(accepted.rawInput);
+  if (!execution.success || !input.success) return null;
+  return {
+    mode: "queue-if-active",
+    input: input.data,
+    model: execution.data.model,
+    reasoningLevel: execution.data.reasoningLevel,
+    permissionMode: execution.data.permissionMode,
+    serviceTier: execution.data.serviceTier,
+    correctionOf: {
+      operation: correction.operation,
+      original: correction.original,
+    },
+  };
+}
