+  const preparation = nativeMessageEditPreparationSchema.parse(details);
+  if (!isActive()) return { kind: "waiting" };
+  if (
+    !operation.acceptedOriginal ||
+    operation.acceptedOriginal.threadId !== preparation.threadId
+  )
+    throw new Error("Edit preparation has no matching canonical acceptance");
+  const service = getMessageAdmissionService(deps.db);
+  const thread = getThread(deps.db, preparation.threadId);
+  const environment = getEnvironment(deps.db, preparation.environmentId);
+  if (!thread || !environment)
+    throw new Error("Accepted edit target environment no longer exists");
+  if (preparation.stage !== "before-effects")
+    throw new Error("Edit continuation has no completed effect proof");
+  const waits = preparation.guardWait
+    ? [preparation.guardWait.waiter, ...preparation.guardWait.additionalWaiters]
+    : [];
+  if (preparation.queueId)
+    return resumeQueuedMessageEdit(
+      deps,
+      operation,
+      preparation,
+      thread,
+      environment,
+      isActive,
+    );
+  if (waits.some((wait) => wait.sendAt !== null && wait.sendAt > Date.now()))
+    return { kind: "waiting" };
+  assertHistoricalEditTarget(deps, operation, preparation, thread, true);
+  const submission = service.readNativeSubmission(
+    admissionOperationKey(
+      operation.operation.namespace,
+      operation.operation.operationId,
+    ),
+  );
+  if (!submission)
+    throw new Error("Accepted edit canonical submission is missing");
+  const execution = resolvedThreadExecutionOptionsSchema.parse(
+    operation.acceptedOriginal.effectiveIntent.execution.configuration,
+  );
+  let effectReserved = false;
+  const guards = await runNativePreparedGuardCheckpoint(
+    deps,
+    buildNativeDispatchGuardRequest(
+      deps,
+      {
+        thread,
+        payload: {
+          ...preparation.payload,
+          input: z.array(promptInputSchema).parse(submission.rawInput),
+          mode: "start",
+        },
+        source: { kind: "inline" },
+        queuePayload: { kind: "inline" },
+        origin: null,
+        originPluginId: null,
+        startedOnBehalfOf: null,
+        trigger: "auto-dispatch",
+      },
+      execution,
+      { phase: "accepted", submissions: [submission] },
+      async () => {
+        if (!isActive()) return;
+        assertHistoricalEditTarget(
+          deps,
+          operation,
+          preparation,
+          getThread(deps.db, thread.id)!,
+          true,
+        );
+        effectReserved = deps.db.transaction(
+          (tx) => {
+            const competing = tx
+              .select({ id: messageAdmissionOperations.id })
+              .from(messageAdmissionOperations)
+              .where(
+                and(
+                  eq(messageAdmissionOperations.threadId, preparation.threadId),
+                  ne(
+                    messageAdmissionOperations.id,
+                    admissionOperationKey(
+                      operation.operation.namespace,
+                      operation.operation.operationId,
+                    ),
+                  ),
+                  inArray(messageAdmissionOperations.preparationState, [
+                    "effect-possible",
+                    "uncertain",
+                  ]),
+                ),
+              )
+              .limit(1)
+              .get();
+            if (competing) return false;
+            service.updatePreparation(
+              tx,
+              operation.operation,
+              "pending",
+              "effect-possible",
+              jsonNativeAdmissionValue(preparation),
+            );
+            return true;
+          },
+          { behavior: "immediate" },
+        );
+      },
+    ),
+  );
+  if (guards.kind === "wait") {
+    deps.db.transaction(
+      (tx) =>
+        service.updatePreparation(
+          tx,
+          operation.operation,
+          "pending",
+          "pending",
+          jsonNativeAdmissionValue({ ...preparation, guardWait: guards }),
+        ),
+      { behavior: "immediate" },
+    );
+    return { kind: "waiting" };
+  }
+  if (
+    !effectReserved ||
+    (!isActive() &&
+      service.preparationRecord(operation.operation)?.state === "pending")
+  )
+    return { kind: "waiting" };
+  if (!isActive())
+    throw new Error("Edit owner retired after effect reservation");
+  await performAcceptedMessageEdit(deps, {
+    thread,
+    environment: requireReadyThreadEnvironment(environment),
+    payload: preparation.payload,
+    p6rAuthorship: preparation.p6rAuthorship,
+    accepted: operation,
+    preparation,
+    isActive,
+  });
+}
+
+export function requestNativeMessageEditDelivery(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+  operation: OperationRecordV1,
+  sendNow: boolean,
+  claimed: readonly ClaimedQueuedThreadMessageRow[],
+): void {
+  const service = getMessageAdmissionService(deps.db);
+  if (sendNow) {
+    const retained = service.preparationRecord(operation.operation);
+    if (!retained || retained.state !== "pending")
+      throw new ApiError(
+        409,
+        "message_edit_reconciliation_required",
+        "Historical edit effects require reconciliation before another send; the retained originals have not been replayed",
+        { details: { admission: operation } },
+      );
+    const preparation = nativeMessageEditPreparationSchema.parse(
+      retained.details,
+    );
+    const originals = sendNowOriginalIdentity(claimed);
+    if (
+      preparation.sendNow &&
+      JSON.stringify(preparation.sendNowOriginals) !== JSON.stringify(originals)
+    )
+      historicalEditConflict(
+        deps,
+        operation,
+        preparation,
+        "historical-edit-send-now-changed",
+        "The accepted originals selected for Send-now changed. Retain every revision and explicitly confirm a new delivery.",
+      );
+    deps.db.transaction((tx) =>
+      service.updatePreparation(
+        tx,
+        operation.operation,
+        "pending",
+        "pending",
+        jsonNativeAdmissionValue({
+          ...preparation,
+          sendNow: true,
+          sendNowGroup: claimed.map((member) => member.id),
+          sendNowOriginals: originals,
+        }),
+      ),
+    );
+  }
+  nativeMessageAdmissionRuntimeFor(deps.db)?.wake();
+}
+
+async function resumeQueuedMessageEdit(
+  deps: LoggedPendingInteractionWorkSessionDeps,
+  operation: OperationRecordV1,
+  preparation: NativeMessageEditPreparation,
+  thread: Thread,
+  environment: NonNullable<ReturnType<typeof getEnvironment>>,
+  isActive: () => boolean,
+): Promise<void | { kind: "waiting" }> {
+  const service = getMessageAdmissionService(deps.db);
+  const row = getQueuedThreadMessage(deps.db, preparation.queueId!);
+  if (!row) {
+    deps.db.transaction((tx) =>
+      service.updatePreparation(
+        tx,
+        operation.operation,
+        "pending",
+        "cancelled",
+        jsonNativeAdmissionValue({
+          ...preparation,
+          reason: "Queued edit was removed before history effects",
+        }),
+      ),
+    );
+    return;
+  }
+  if (!isMessageEditThreadQuiescent(thread)) return { kind: "waiting" };
+  const waits = preparation.guardWait
+    ? [preparation.guardWait.waiter, ...preparation.guardWait.additionalWaiters]
+    : [];
+  if (
+    !preparation.sendNow &&
+    waits.some((wait) => wait.sendAt !== null && wait.sendAt > Date.now())
+  )
+    return { kind: "waiting" };
+  if (
+    row.admissionRef !==
+    admissionOperationKey(
+      operation.operation.namespace,
+      operation.operation.operationId,
+    )
+  )
+    throw new Error(
+      "Historical edit queue original changed before effects; preserve the revised row",
+    );
+  const claimed = claimQueuedThreadMessageGroup(
+    deps.db,
+    deps.hub,
+    preparation.sendNow ? (preparation.sendNowGroup?.[0] ?? row.id) : row.id,
+    preparation.sendNow
+      ? { kind: "explicit-send" }
+      : {
+          kind: "automatic",
+          retryingFailure: false,
+          isGroupEligible: (group) =>
+            createAutomaticQueuedMessageGroupEligibility(deps, {
+              now: Date.now(),
+              retryingFailure: false,
+              thread,
+              recheckingQueuedMessageIds: group.map((member) => member.id),
+            })(group),
+        },
+  );
+  if (!claimed) return { kind: "waiting" };
+  try {
+    return await withActiveQueuedMessageClaims(claimed, async () => {
+      if (
+        preparation.sendNow &&
+        (JSON.stringify(claimed.map((member) => member.id)) !==
+          JSON.stringify(preparation.sendNowGroup) ||
+          JSON.stringify(sendNowOriginalIdentity(claimed)) !==
+            JSON.stringify(preparation.sendNowOriginals))
+      )
+        historicalEditConflict(
+          deps,
+          operation,
+          preparation,
+          "historical-edit-send-now-changed",
+          "The accepted originals selected for Send-now changed. All current content remains retained; explicitly confirm a new delivery instead of inheriting the earlier override.",
+        );
+      const manifest = queuedMessageOriginalManifest(claimed);
+      if (!manifest)
+        throw new Error(
+          "Historical edit queue lost its complete original vector",
+        );
+      const inputGroups = manifest.map((original) => original.rawInput);
+      const { senderThreadId: _caller, ...retainedPayload } =
+        preparation.payload;
+      const dispatch = {
+        thread,
+        payload: {
+          ...retainedPayload,
+          input: flattenPromptInputGroups(inputGroups),
+          inputGroups,
+          mode: "queue-if-active" as const,
+        },
+        source: {
+          kind: "drain" as const,
+          claimed,
+          respectManualStopPause: !preparation.sendNow,
+          sendNow: preparation.sendNow ?? false,
+        },
+        queuePayload: { kind: "inline" as const },
+        originalManifest: manifest,
+        origin: null,
+        originPluginId: null,
+        startedOnBehalfOf: null,
+        trigger: "auto-dispatch" as const,
+      };
+      const nativeAdmission = frozenNativeDispatchAdmission(deps, dispatch);
+      if (!nativeAdmission)
+        throw new Error(
+          "Historical edit queue has no canonical acceptance basis",
+        );
+      const outcome = await attemptDispatch(deps, {
+        ...dispatch,
+        nativeAdmission,
+        dispatchAcceptedMessageEdit: async () => {
+          if (!isActive())
+            throw new Error(
+              "Historical edit coordinator retired before effects",
+            );
+          const current = getThread(deps.db, thread.id);
+          if (!current)
+            throw new Error("Historical edit destination disappeared");
+          assertHistoricalEditTarget(deps, operation, preparation, current);
+          deps.db.transaction(
+            (tx) => {
+              const competing = tx
+                .select({ id: messageAdmissionOperations.id })
+                .from(messageAdmissionOperations)
+                .where(
+                  and(
+                    eq(messageAdmissionOperations.threadId, thread.id),
+                    ne(
+                      messageAdmissionOperations.id,
+                      admissionOperationKey(
+                        operation.operation.namespace,
+                        operation.operation.operationId,
+                      ),
+                    ),
+                    inArray(messageAdmissionOperations.preparationState, [
+                      "effect-possible",
+                      "uncertain",
+                    ]),
+                  ),
+                )
+                .limit(1)
+                .get();
+              if (competing)
+                throw new Error(
+                  "Another accepted preparation requires effect reconciliation before this historical edit",
+                );
+              service.updatePreparation(
+                tx,
+                operation.operation,
+                "pending",
+                "effect-possible",
+                jsonNativeAdmissionValue(preparation),
+              );
+            },
+            { behavior: "immediate" },
+          );
+          await performAcceptedMessageEdit(deps, {
+            thread: current,
+            environment: requireReadyThreadEnvironment(environment),
+            payload: preparation.payload,
+            p6rAuthorship: preparation.p6rAuthorship,
+            accepted: operation,
+            preparation,
+            isActive,
+            claimed,
+          });
+        },
+      });
+      return outcome.kind === "dispatched"
+        ? undefined
+        : { kind: "waiting" as const };
+    });
+  } finally {
+    releaseQueuedMessageGroupClaim(deps.db, deps.hub, {
+      threadId: thread.id,
+      claims: claimed,
+    });
+  }
+}
