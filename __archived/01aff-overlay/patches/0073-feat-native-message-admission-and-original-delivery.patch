+            unknownAssessment(
+              assessmentId,
+              error instanceof AdmissionConflict
+                ? error.code
+                : "evaluator-error",
+              error instanceof Error ? error.message : String(error),
+            ),
+          );
+        } finally {
+          if (timeout !== undefined) clearTimeout(timeout);
+          registration.controller.signal.removeEventListener("abort", abort);
+          removeAbort();
+        }
+      }
+    }
+    markAdmissionEvaluationEffect(
+      this.db,
+      operation.id,
+      operation.attempt,
+      effectUnknown ? "possible" : invoked ? "known" : "not-invoked",
+    );
+    const combined = combineAssessments(assessments);
+    if (combined.verdict !== "accepted") {
+      const record = this.operationRecord(operation);
+      record.status = combined.verdict;
+      record.assessments = assessments;
+      record.reasons = combined.unresolved;
+      if (combined.verdict === "rejected") {
+        const rejecting = assessments.find(
+          (assessment) => assessment.verdict === "rejected",
+        )!;
+        const owner = slotVector.find(
+          (slot) =>
+            admissionOperationKey(
+              operation.id,
+              `${slot.providerId}:${slot.publicationId}`,
+            ) === rejecting.assessmentId,
+        );
+        if (!owner)
+          throw new AdmissionConflict(
+            "feedback-owner-missing",
+            "Rejected assessment has no captured publication owner",
+          );
+        return {
+          kind: "known",
+          operation: this.completeRejectedOperation(
+            operation,
+            submission,
+            record,
+            {
+              pluginId: owner.pluginId,
+              providerId: owner.providerId,
+              rejectionAssessmentId: rejecting.assessmentId,
+            },
+          ),
+        };
+      }
+      const completed = completeAdmissionAssessment(
+        this.db,
+        operation.id,
+        operation.attempt,
+        combined.verdict,
+        canonicalJson(record, MESSAGE_ADMISSION_LIMITS.responseBytes),
+      );
+      return { kind: "known", operation: this.operationRecord(completed) };
+    }
+    const effectiveIntent: EffectiveIntent = {
+      ...submission.requestedIntent,
+      changes: [],
+    };
+    const ruleIds = assessments.flatMap((a) =>
+      a.observations
+        .filter((o) => o.status !== "not-applicable")
+        .map((o) => o.ruleId),
+    );
+    if (combined.routing !== "preserve") {
+      effectiveIntent.mode = combined.routing === "defer" ? "queue" : "steer";
+      effectiveIntent.changes.push({
+        field: "mode",
+        causeRuleIds: ruleIds,
+        explanation: `Published policy selected ${combined.routing}`,
+      });
+    }
+    if (combined.membership !== "preserve") {
+      effectiveIntent.membership = combined.membership;
+      effectiveIntent.changes.push({
+        field: "membership",
+        causeRuleIds: ruleIds,
+        explanation: `Published policy selected ${combined.membership}`,
+      });
+    }
+    const ticket: PreparedAdmissionTicket = freeze({
+      operationId: operation.id,
+      submission,
+      effectiveIntent,
+    });
+    this.tickets.set(ticket, {
+      operation,
+      input,
+      assessments,
+      vector,
+      evidence,
+      evidenceReceipts,
+      effectiveIntent,
+      context,
+    });
+    this.prepared.set(operation.id, ticket);
+    return { kind: "prepared", ticket };
+  }
+
+  private completeRejectedOperation(
+    operation: AdmissionOperation,
+    submission: SubmissionV1,
+    record: OperationRecordV1,
+    owner: {
+      pluginId: string;
+      providerId: string;
+      rejectionAssessmentId: string;
+    },
+  ): OperationRecordV1 {
+    const id = admissionOperationKey(
+      operation.id,
+      `rejection-feedback:${operation.attempt}`,
+    );
+    const text = [
+      `Feedback for rejected original ${submission.original.originalId} revision ${submission.original.revision}.`,
+      ...record.assessments.flatMap((assessment) => [
+        ...assessment.causes.map(
+          (cause) => `${cause.groupId}/${cause.ruleId}: ${cause.message}`,
+        ),
+        ...assessment.advice,
+      ]),
+    ].join("\n\n");
+    const feedback: FeedbackV1 = FeedbackV1Schema.parse({
+      version: 1,
+      obligationId: id,
+      operation: {
+        namespace: `native-feedback:${operation.id}`,
+        operationId: id,
+      },
+      providerId: owner.providerId,
+      original: submission.original,
+      rejectionAssessmentId: owner.rejectionAssessmentId,
+      recipientThreadId: submission.source.senderThreadId,
+      causeIds: record.assessments.flatMap((assessment) =>
+        assessment.causes.map(
+          (cause) =>
+            `${assessment.assessmentId}/${admissionDigest(canonicalJson(cause, MESSAGE_ADMISSION_LIMITS.responseBytes))}`,
+        ),
+      ),
+      advice: [
+        ...new Set(
+          record.assessments.flatMap((assessment) => assessment.advice),
+        ),
+      ],
+      status: "pending",
+      nativeRequestId: null,
+      verification: null,
+      reasons: [],
+    });
+    if (!submission.feedbackBinding) record.feedback = feedback;
+    let completed: AdmissionOperation;
+    try {
+      completed = this.db.transaction(
+        (tx) =>
+          completeAdmissionRejectionInTransaction(tx, {
+            operationId: operation.id,
+            attempt: operation.attempt,
+            result: canonicalJson(
+              record,
+              MESSAGE_ADMISSION_LIMITS.responseBytes,
+            ),
+            feedback: submission.feedbackBinding
+              ? null
+              : {
+                  id,
+                  pluginId: owner.pluginId,
+                  assessmentId: owner.rejectionAssessmentId,
+                  recipientThreadId: submission.source.senderThreadId,
+                  payload: canonicalJson(
+                    { feedback, text },
+                    MESSAGE_ADMISSION_LIMITS.responseBytes,
+                  ),
+                },
+          }),
+        { behavior: "immediate" },
+      );
+    } catch (error) {
+      record.status = "unresolved";
+      record.feedback = null;
+      record.reasons.push({
+        code: "feedback-persistence-failed",
+        message: error instanceof Error ? error.message : String(error),
+      });
+      const unresolved = completeAdmissionAssessment(
+        this.db,
+        operation.id,
+        operation.attempt,
+        "unresolved",
+        canonicalJson(record, MESSAGE_ADMISSION_LIMITS.responseBytes),
+      );
+      return this.operationRecord(unresolved);
+    }
+    this.recovery?.wake();
+    return this.operationRecord(completed);
+  }
+
+  commit<T extends AdmissionSinkResult>(
+    tx: DbTransaction,
+    ticket: PreparedAdmissionTicket,
+    accept: (accepted: AcceptedOriginalV1) => T,
+  ): CommitAdmissionResult<T> {
+    try {
+      return tx.transaction((nested) =>
+        this.commitInTransaction(nested, ticket, accept),
+      );
+    } catch (error) {
+      const state = this.tickets.get(ticket);
+      if (state)
+        queueMicrotask(() => {
+          if (!this.db.$client.open) return;
+          const row = getAdmissionOperationById(this.db, state.operation.id);
+          if (
+            row?.state === "evaluating" &&
+            row.attempt === state.operation.attempt
+          )
+            this.invalidatePrepared(ticket, {
+              code:
+                error instanceof AdmissionConflict
+                  ? error.code
+                  : "acceptance-sink-failed",
+              message: error instanceof Error ? error.message : String(error),
+            });
+        });
+      throw error;
+    }
+  }
+
+  private commitInTransaction<T extends AdmissionSinkResult>(
+    tx: DbTransaction,
+    ticket: PreparedAdmissionTicket,
+    accept: (accepted: AcceptedOriginalV1) => T,
+  ): CommitAdmissionResult<T> {
+    const state = this.tickets.get(ticket);
+    if (!state)
+      throw new AdmissionConflict(
+        "ticket-invalid",
+        "Admission ticket is unavailable or already consumed",
+      );
+    const current = getAdmissionOperation(
+      tx,
+      state.operation.namespace,
+      state.operation.operationId,
+    );
+    if (
+      !current ||
+      current.state !== "evaluating" ||
+      current.attempt !== state.operation.attempt
+    )
+      throw new AdmissionConflict(
+        "operation-state-conflict",
+        "Admission ownership changed",
+      );
+    if (
+      state.input.submission.override !== "full-send-now" &&
+      !state.input.exemption
+    ) {
+      const currentSlots = activeAdmissionSlots(tx, state.operation.projectId);
+      if (
+        canonicalJson(
+          currentSlots.map((slot) => [slot.providerId, slot.publicationId]),
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        ) !==
+        canonicalJson(
+          state.vector.map((item) => [item.providerId, item.publicationId]),
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        )
+      )
+        throw new AdmissionConflict(
+          "publication-stale",
+          "Enforcing publications or enrollment changed before acceptance",
+        );
+      for (const item of state.vector) {
+        if (
+          this.registrations.get(item.pluginId)?.registration.generation !==
+          item.generation
+        )
+          throw new AdmissionConflict(
+            "evaluator-generation-stale",
+            "Evaluator generation changed before acceptance",
+          );
+      }
+      for (const capture of state.evidence)
+        validateNativeAdmissionHistory(tx, capture);
+    }
+    if (ticket.submission.feedbackBinding) {
+      const obligation = getAdmissionFeedback(
+        tx,
+        ticket.submission.feedbackBinding.obligationId,
+      );
+      if (!obligation || obligation.state === "superseded")
+        throw new AdmissionConflict(
+          "feedback-superseded",
+          "Native feedback obligation was superseded before acceptance",
+        );
+    }
+    validateNativePolicyContext(tx, state.context);
+    const now = Date.now();
+    const record = this.operationRecord(state.operation);
+    record.status = "accepted";
+    record.assessments = state.assessments;
+    if (ticket.submission.feedbackBinding)
+      record.feedback = this.feedbackRecord(
+        ticket.submission.feedbackBinding.obligationId,
+        tx,
+      )!.feedback;
+    const accepted = acceptAdmissionOperation(
+      tx,
+      {
+        id: state.operation.id,
+        attempt: state.operation.attempt,
+        basis: canonicalJson(
+          {
+            vector: state.vector,
+            context: state.context,
+            captures: state.evidence,
+            evidence: state.evidenceReceipts,
+          },
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        ),
+        result: "{}",
+        visibleHuman:
+          ticket.submission.source.visibleHumanActivity &&
+          ["message", "edit", "compact-first", "maintenance"].includes(
+            ticket.submission.kind,
+          ),
+        preparation:
+          state.input.preparation === null
+            ? null
+            : canonicalJson(
+                state.input.preparation,
+                MESSAGE_ADMISSION_LIMITS.requestBytes,
+              ),
+      },
+      now,
+    );
+    const acceptedOriginal: AcceptedOriginalV1 = freeze(
+      decodeBounded(
+        AcceptedOriginalV1Schema,
+        {
+          version: 1,
+          original: ticket.submission.original,
+          operation: ticket.submission.operation,
+          requestFingerprint: ticket.submission.requestFingerprint,
+          threadId: ticket.submission.threadId,
+          rawInput: ticket.submission.rawInput,
+          source: ticket.submission.source,
+          requestedIntent: ticket.submission.requestedIntent,
+          effectiveIntent: state.effectiveIntent,
+          acceptedAt: new Date(now).toISOString(),
+          acceptanceSequence: accepted.acceptanceSequence,
+          admission:
+            ticket.submission.override === "full-send-now"
+              ? {
+                  kind: "full-send-now",
+                  reason:
+                    "Explicit full Send-now override; operational invariants remain required",
+                }
+              : state.input.exemption
+                ? {
+                    kind: "operational-exemption",
+                    reason: `Native ${state.input.exemption.kind} bound to ${state.input.exemption.nativeOperation.namespace}/${state.input.exemption.nativeOperation.operationId}`,
+                  }
+                : {
+                    kind: "evaluated",
+                    publications: state.vector.map(
+                      (item) =>
+                        publicationDto(
+                          getAdmissionPublication(tx, item.publicationId)!,
+                        ).publication,
+                    ),
+                    assessments: state.assessments,
+                  },
+        },
+        MESSAGE_ADMISSION_LIMITS.manifestBytes,
+      ),
+    );
+    const value = accept(acceptedOriginal);
+    if (value !== null && typeof value === "object" && "then" in value)
+      throw new AdmissionConflict(
+        "async-acceptance-sink",
+        "Admission sink must be synchronous within its native DB transaction",
+      );
+    setAdmissionAcceptanceReceipt(
+      tx,
+      accepted.id,
+      canonicalJson(
+        value.acceptanceReceipt ?? null,
+        MESSAGE_ADMISSION_LIMITS.responseBytes,
+      ),
+    );
+    if (supportsAcceptanceReceipt)
+      Object.assign(record, {
+        acceptanceReceipt: value.acceptanceReceipt ?? null,
+      });
+    record.acceptedOriginal = acceptedOriginal;
+    record.delivery = {
+      state:
+        state.input.preparation === null
+          ? value.requestId
+            ? "request-committed"
+            : "queued"
+          : "preparing",
+      queueId: value.queueId ?? null,
+      requestId: value.requestId ?? null,
+      groupIndex: value.groupIndex ?? null,
+      details: value.details ?? null,
+    };
+    saveAcceptedAdmissionResult(
+      tx,
+      accepted.id,
+      canonicalJson(record, MESSAGE_ADMISSION_LIMITS.responseBytes),
+      now,
+    );
+    if (value.requestId)
+      this.recordRequestOriginals(tx, {
+        requestId: value.requestId,
+        threadId: ticket.submission.threadId,
+        operationIds: value.operationIds ?? [accepted.id],
+      });
+    queueMicrotask(() => {
+      if (!this.db.$client.open) return;
+      if (
+        getAdmissionOperationById(this.db, accepted.id)?.state === "accepted"
+      ) {
+        this.prepared.delete(accepted.id);
+        this.tickets.delete(ticket);
+      }
+    });
+    return { operation: freeze(record), acceptedOriginal, value };
+  }
+
+  private operationRecord(
+    operation: AdmissionOperation,
+    db: DbQueryConnection = this.db,
+  ): OperationRecordV1 {
+    const record = parsedRecord(operation);
+    if (record.feedback !== null) {
+      const current = this.feedbackRecord(record.feedback.obligationId, db);
+      if (current !== null) record.feedback = current.feedback;
+    }
+    return record;
+  }
+
+  lookupOperation(operation: OperationKey): OperationRecordV1 | null {
+    const row = getAdmissionOperation(
+      this.db,
+      operation.namespace,
+      operation.operationId,
+    );
+    return row === null ? null : this.operationRecord(row);
+  }
+
+  lookupOperationById(id: string): OperationRecordV1 | null {
+    const row = getAdmissionOperationById(this.db, id);
+    return row === null ? null : this.operationRecord(row);
+  }
+
+  readNativeSubmission(nativeJournalId: string): SubmissionV1 | null {
+    const row = getAdmissionOperationById(this.db, nativeJournalId);
+    return row === null ? null : storedInput(row).submission;
+  }
+
+  invalidatePrepared(
+    ticket: PreparedAdmissionTicket,
+    reason: { code: string; message: string; pluginId?: string },
+    outcome: "unresolved" | "rejected" = "unresolved",
+  ): OperationRecordV1 {
+    const state = this.tickets.get(ticket);
+    if (!state)
+      throw new AdmissionConflict(
+        "ticket-invalid",
+        "Admission ticket does not belong to this native service",
+      );
+    const current = getAdmissionOperationById(this.db, state.operation.id);
+    if (!current)
+      throw new AdmissionConflict(
+        "operation-missing",
+        "Native operation is missing",
+      );
+    if (current.state !== "evaluating") return this.operationRecord(current);
+    if (current.attempt !== state.operation.attempt)
+      throw new AdmissionConflict(
+        "operation-state-conflict",
+        "Prepared assessment ownership changed before final classification",
+      );
+    const record = this.operationRecord(current);
+    const isObservedGuardRefusal =
+      outcome === "rejected" &&
+      reason.code === "dispatch_rejected" &&
+      typeof reason.pluginId === "string" &&
+      reason.pluginId.trim().length > 0 &&
+      reason.pluginId.length <= 200 &&
+      state.assessments.every(
+        (assessment) =>
+          assessment.complete && assessment.verdict === "accepted",
+      );
+    record.status = isObservedGuardRefusal ? "rejected" : "unresolved";
+    record.assessments = [...state.assessments];
+    if (isObservedGuardRefusal)
+      record.assessments.push(
+        reduceObservations({
+          assessmentId: admissionOperationKey(
+            current.id,
+            canonicalJson(
+              {
+                kind: "native-delivery-guard",
+                pluginId: reason.pluginId,
+                contract: "unversioned:message.dispatch",
+                code: reason.code,
+                message: reason.message,
+              },
+              MESSAGE_ADMISSION_LIMITS.responseBytes,
+            ),
+          ),
+          observations: [
+            {
+              groupId: "native-delivery-guard",
+              ruleId: reason.pluginId!,
+              revision: "unversioned:message.dispatch",
+              status: "reject",
+              causes: [{ code: reason.code, message: reason.message }],
+              advice: [reason.message],
+              routing: "preserve",
+              membership: "preserve",
+            },
+          ],
+          complete: true,
+        }),
+      );
+    record.reasons = [reason];
+    if (outcome === "rejected" && !isObservedGuardRefusal)
+      record.reasons.push({
+        code: "native-guard-unattributed",
+        message:
+          "Final rejection requires an observed native dispatch refusal with the rejecting plugin identity; incomplete attribution remains unresolved",
+      });
+    const classified = decodeBounded(
+      OperationRecordV1Schema,
+      record,
+      MESSAGE_ADMISSION_LIMITS.responseBytes,
+    );
+    this.prepared.delete(current.id);
+    if (classified.status === "rejected")
+      return this.completeRejectedOperation(
+        current,
+        ticket.submission,
+        classified,
+        {
+          pluginId: reason.pluginId!,
+          providerId: "native-delivery-guard",
+          rejectionAssessmentId: classified.assessments.at(-1)!.assessmentId,
+        },
+      );
+    return this.operationRecord(
+      completeAdmissionAssessment(
+        this.db,
+        current.id,
+        current.attempt,
+        "unresolved",
+        canonicalJson(classified, MESSAGE_ADMISSION_LIMITS.responseBytes),
+      ),
+    );
+  }
+
+  updatePreparation(
+    tx: DbTransaction,
+    operation: OperationKey,
+    expected: "pending" | "effect-possible" | "failed" | "uncertain",
+    next: "pending" | "effect-possible" | "failed" | "uncertain" | "cancelled",
+    details: JsonValue,
+  ): OperationRecordV1 {
+    const transitions = {
+      pending: ["pending", "effect-possible", "failed", "cancelled"],
+      "effect-possible": ["pending", "failed", "uncertain"],
+      failed: ["pending", "cancelled"],
+      uncertain: ["pending", "failed", "cancelled"],
+    };
+    if (!transitions[expected].includes(next))
+      throw new AdmissionConflict(
+        "preparation-transition-invalid",
+        "Preparation transition requires explicit effect reconciliation",
+      );
+    const row = getAdmissionOperation(
+      tx,
+      operation.namespace,
+      operation.operationId,
+    );
+    if (!row || row.state !== "accepted")
+      throw new AdmissionConflict(
+        "operation-not-accepted",
+        "Preparation requires an accepted immutable original",
+      );
+    const updated = transitionAdmissionPreparation(
+      tx,
+      row.id,
+      expected,
+      next,
+      canonicalJson(details, MESSAGE_ADMISSION_LIMITS.requestBytes),
+    );
+    const record = this.operationRecord(updated);
+    record.delivery = {
+      ...record.delivery,
+      state:
+        next === "failed"
+          ? "preparation-failed"
+          : next === "uncertain"
+            ? "uncertain"
+            : next === "cancelled"
+              ? "cancelled"
+              : "preparing",
+      details,
+    };
+    saveAcceptedAdmissionResult(
+      tx,
+      row.id,
+      canonicalJson(record, MESSAGE_ADMISSION_LIMITS.responseBytes),
+    );
+    return freeze(record);
+  }
+
+  consumePreparation<T extends AdmissionSinkResult>(
+    tx: DbTransaction,
+    operation: OperationKey,
+    accept: (accepted: AcceptedOriginalV1) => T,
+  ):
+    | ({ kind: "committed" } & CommitAdmissionResult<T>)
+    | { kind: "known"; operation: OperationRecordV1 } {
+    return tx.transaction((nested) =>
+      this.consumePreparationInTransaction(nested, operation, accept),
+    );
+  }
+
+  private consumePreparationInTransaction<T extends AdmissionSinkResult>(
+    tx: DbTransaction,
+    operation: OperationKey,
+    accept: (accepted: AcceptedOriginalV1) => T,
+  ):
+    | ({ kind: "committed" } & CommitAdmissionResult<T>)
+    | { kind: "known"; operation: OperationRecordV1 } {
+    const row = getAdmissionOperation(
+      tx,
+      operation.namespace,
+      operation.operationId,
+    );
+    if (!row || row.state !== "accepted")
+      throw new AdmissionConflict(
+        "operation-not-accepted",
+        "Preparation requires its original native acceptance",
+      );
+    const record = this.operationRecord(row);
+    if (row.preparationState === "completed")
+      return { kind: "known", operation: record };
+    if (
+      row.preparationState !== "pending" &&
+      row.preparationState !== "effect-possible"
+    )
+      throw new AdmissionConflict(
+        "preparation-state-conflict",
+        "Preparation requires pending work or an explicitly reconciled effect",
+      );
+    const acceptedOriginal = record.acceptedOriginal;
+    if (!acceptedOriginal)
+      throw new AdmissionConflict(
+        "accepted-original-missing",
+        "Accepted preparation lost its immutable original",
+      );
+    const value = accept(freeze(acceptedOriginal));
+    if (value !== null && typeof value === "object" && "then" in value)
+      throw new AdmissionConflict(
+        "async-acceptance-sink",
+        "Preparation sink must remain inside its synchronous native transaction",
+      );
+    transitionAdmissionPreparation(
+      tx,
+      row.id,
+      row.preparationState,
+      "completed",
+      canonicalJson(
+        value.details ?? null,
+        MESSAGE_ADMISSION_LIMITS.requestBytes,
+      ),
+    );
+    record.delivery = {
+      state: value.requestId ? "request-committed" : "queued",
+      queueId: value.queueId ?? null,
+      requestId: value.requestId ?? null,
+      groupIndex: value.groupIndex ?? null,
+      details: value.details ?? null,
+    };
+    saveAcceptedAdmissionResult(
+      tx,
+      row.id,
+      canonicalJson(record, MESSAGE_ADMISSION_LIMITS.responseBytes),
+    );
+    if (value.requestId)
+      this.recordRequestOriginals(tx, {
+        requestId: value.requestId,
+        threadId: row.threadId,
+        operationIds: value.operationIds ?? [row.id],
+      });
+    return {
+      kind: "committed",
+      operation: freeze(record),
+      acceptedOriginal,
+      value,
+    };
+  }
+
+  recordQueuedOriginals(
+    tx: DbTransaction,
+    input: {
+      threadId: string;
+      queueId: string;
+      operationIds: string[];
+      details?: JsonValue;
+    },
+  ): void {
+    tx.transaction((nested) => {
+      if (
+        input.operationIds.length < 1 ||
+        input.operationIds.length > 256 ||
+        new Set(input.operationIds).size !== input.operationIds.length
+      )
+        throw new AdmissionConflict(
+          "manifest-capacity",
+          "Queue progress requires 1..256 unique accepted original operations",
+        );
+      const queue = getQueuedThreadMessage(nested, input.queueId);
+      if (!queue || queue.threadId !== input.threadId)
+        throw new AdmissionConflict(
+          "queued-original-destination",
+          "Queued progress requires its exact native destination row",
+        );
+      const originals = input.operationIds.map((id) => {
+        const row = getAdmissionOperationById(nested, id);
+        if (!row || row.state !== "accepted" || row.threadId !== input.threadId)
+          throw new AdmissionConflict(
+            "queued-original-conflict",
+            "Queued progress original is not accepted for the exact destination",
+          );
+        const record = this.operationRecord(row, nested);
+        if (!record.acceptedOriginal || record.delivery.state === "cancelled")
+          throw new AdmissionConflict(
+            "queued-original-conflict",
+            "Queued progress cannot invent an original or resurrect a cancelled revision",
+          );
+        return { id, record };
+      });
+      for (const { id, record } of originals) {
+        if (
+          record.delivery.state === "queued" &&
+          record.delivery.queueId === input.queueId
+        )
+          continue;
+        record.delivery = {
+          state: "queued",
+          queueId: input.queueId,
+          requestId: null,
+          groupIndex: null,
+          details:
+            input.details === undefined
+              ? record.delivery.details
+              : { previous: record.delivery.details, queued: input.details },
+        };
+        saveAcceptedAdmissionResult(
+          nested,
+          id,
+          canonicalJson(record, MESSAGE_ADMISSION_LIMITS.responseBytes),
+        );
+      }
+    });
+  }
+
+  recordRequestOriginals(
+    tx: DbTransaction,
+    input: { requestId: string; threadId: string; operationIds: string[] },
+  ): void {
+    tx.transaction((nested) =>
+      this.recordRequestOriginalsInTransaction(nested, input),
+    );
+  }
+
+  private recordRequestOriginalsInTransaction(
+    tx: DbTransaction,
+    input: { requestId: string; threadId: string; operationIds: string[] },
+  ): void {
+    const originals = input.operationIds.map((id) => {
+      const row = getAdmissionOperationById(tx, id);
+      if (!row)
+        throw new AdmissionConflict(
+          "manifest-original-missing",
+          "Native original operation does not exist",
+        );
+      const accepted = this.operationRecord(row).acceptedOriginal;
+      if (!accepted)
+        throw new AdmissionConflict(
+          "manifest-original-missing",
+          "Request requires accepted immutable originals",
+        );
+      return accepted;
+    });
+    canonicalJson(originals, MESSAGE_ADMISSION_LIMITS.manifestBytes);
+    bindAdmissionRequestOriginals(tx, input);
+    for (const [groupIndex, id] of input.operationIds.entries()) {
+      const row = getAdmissionOperationById(tx, id)!;
+      const record = this.operationRecord(row, tx);
+      record.delivery = {
+        ...record.delivery,
+        state: "request-committed",
+        requestId: input.requestId,
+        groupIndex,
+        queueId: null,
+        details:
+          record.delivery.queueId === null
+            ? record.delivery.details
+            : {
+                previous: record.delivery.details,
+                acceptedQueueId: record.delivery.queueId,
+              },
+      };
+      saveAcceptedAdmissionResult(
+        tx,
+        id,
+        canonicalJson(record, MESSAGE_ADMISSION_LIMITS.responseBytes),
+      );
+      const feedback = this.feedbackRecord(row.operationId, tx);
+      if (
+        feedback &&
+        feedback.row.state !== "claimed" &&
+        feedback.feedback.operation.namespace === row.namespace &&
+        feedback.feedback.operation.operationId === row.operationId &&
+        feedback.feedback.status !== "provider-input-accepted" &&
+        feedback.feedback.status !== "consumed-verified"
+      ) {
+        transitionAdmissionFeedback(
+          tx,
+          feedback.row.id,
+          feedback.row.state,
+          "accepted",
+          canonicalJson(
+            {
+              ...feedback.feedback,
+              status: "native-accepted",
+              nativeRequestId: input.requestId,
+            },
+            MESSAGE_ADMISSION_LIMITS.responseBytes,
+          ),
+        );
+      }
+    }
+  }
+
+  readOriginalManifest(
+    threadId: string,
+    requestId: string,
+  ): OriginalManifestV1 {
+    return this.db.transaction((tx) => {
+      const rows = listAdmissionRequestOriginals(tx, threadId, requestId);
+      if (rows.length) {
+        const originals = rows.map((row) => {
+          const accepted = this.operationRecord(row).acceptedOriginal;
+          if (!accepted)
+            throw new AdmissionConflict(
+              "manifest-original-missing",
+              "Frozen native mapping references no immutable accepted original",
+            );
+          return accepted;
+        });
+        canonicalJson(originals, MESSAGE_ADMISSION_LIMITS.manifestBytes);
+        return {
+          version: 1,
+          threadId,
+          requestId,
+          status: "available",
+          originals,
+          complete: true,
+        };
+      }
+      const legacy = tx
+        .select({ id: events.id })
+        .from(events)
+        .where(
+          and(
+            eq(events.threadId, threadId),
+            eq(events.type, "client/turn/requested"),
+            sql`CASE WHEN json_valid(${events.data}) THEN json_extract(${events.data}, '$.requestId') = ${requestId} ELSE 0 END`,
+          ),
+        )
+        .limit(1)
+        .get();
+      return {
+        version: 1,
+        threadId,
+        requestId,
+        status: legacy ? "legacy-unverified" : "missing",
+        originals: [],
+        complete: false,
+      };
+    });
+  }
+
+  preparationRecord(operation: OperationKey): {
+    id: string;
+    state: AdmissionOperation["preparationState"];
+    details: JsonValue;
+  } | null {
+    const row = getAdmissionOperation(
+      this.db,
+      operation.namespace,
+      operation.operationId,
+    );
+    if (!row || row.state !== "accepted" || row.preparationState === null)
+      return null;
+    return {
+      id: row.id,
+      state: row.preparationState,
+      details:
+        row.preparation === null
+          ? null
+          : decodeBounded(
+              JsonSchema,
+              JSON.parse(row.preparation),
+              MESSAGE_ADMISSION_LIMITS.requestBytes,
+            ),
+    };
+  }
+
+  configureRecovery(ports: NativeAdmissionRecoveryPorts) {
+    if (this.recovery)
+      throw new AdmissionConflict(
+        "recovery-already-configured",
+        "One native admission recovery coordinator owns this database connection",
+      );
+    const coordinator = new MessageAdmissionRecovery(this, ports);
+    this.recovery = coordinator;
+    return {
+      wake: () => coordinator.wake(),
+      catchUp: () => coordinator.catchUp(),
+      recoverOperation: (operation: OperationKey) =>
+        coordinator.recoverOperation(operation),
+      dispose: () => {
+        coordinator.dispose();
+        if (this.recovery === coordinator) this.recovery = null;
+      },
+    };
+  }
+
+  recordRecoveryError(operationId: string, error: unknown): void {
+    this.recoveryErrors.push({
+      operationId,
+      message:
+        error instanceof Error ? (error.stack ?? error.message) : String(error),
+      at: new Date().toISOString(),
+    });
+    if (this.recoveryErrors.length > 20) this.recoveryErrors.shift();
+  }
+
+  recoveryDiagnostics() {
+    return this.recoveryErrors.map((error) => ({ ...error }));
+  }
+
+  commitFinalDisposition(
+    tx: DbTransaction,
+    input: {
+      operation: OperationKey;
+      expectedDispositionId: string | null;
+      dispositionId: string;
+      disposition: JsonValue;
+      delivery: OperationRecordV1["delivery"];
+      feedback?: { providerId: string; assessment: EvaluationResultV1 };
+    },
+  ): OperationRecordV1 {
+    return tx.transaction((nested) =>
+      this.commitFinalDispositionInTransaction(nested, input),
+    );
+  }
+
+  private commitFinalDispositionInTransaction(
+    tx: DbTransaction,
+    input: {
+      operation: OperationKey;
+      expectedDispositionId: string | null;
+      dispositionId: string;
+      disposition: JsonValue;
+      delivery: OperationRecordV1["delivery"];
+      feedback?: { providerId: string; assessment: EvaluationResultV1 };
+    },
+  ): OperationRecordV1 {
+    const row = getAdmissionOperation(
+      tx,
+      input.operation.namespace,
+      input.operation.operationId,
+    );
+    if (!row || row.state !== "accepted")
+      throw new AdmissionConflict(
+        "operation-not-accepted",
+        "Final disposition requires an accepted original",
+      );
+    const parent = this.operationRecord(row).acceptedOriginal;
+    if (!parent)
+      throw new AdmissionConflict(
+        "accepted-original-missing",
+        "Final disposition requires its immutable original",
+      );
+    let obligation: Parameters<
+      typeof commitAdmissionDisposition
+    >[1]["feedback"] = null;
+    if (input.feedback) {
+      const assessment = decodeBounded(
+        EvaluationResultV1Schema,
+        input.feedback.assessment,
+        MESSAGE_ADMISSION_LIMITS.responseBytes,
+      );
+      if (assessment.verdict === "accepted")
+        throw new AdmissionConflict(
+          "feedback-assessment-invalid",
+          "Feedback requires a genuine actionable nonaccepted disposition assessment",
+        );
+      const publication = getActiveAdmissionPublication(
+        tx,
+        input.feedback.providerId,
+      );
+      if (!publication)
+        throw new AdmissionConflict(
+          "feedback-provider-missing",
+          "Feedback provider has no native publication owner",
+        );
+      const recipientThreadId = parent.source.senderThreadId;
+      const id = admissionOperationKey(
+        row.id,
+        JSON.stringify([
+          input.feedback.providerId,
+          assessment.assessmentId,
+          recipientThreadId,
+        ]),
+      );
+      const feedback: FeedbackV1 = {
+        version: 1,
+        obligationId: id,
+        operation: { namespace: `native-feedback:${row.id}`, operationId: id },
+        providerId: input.feedback.providerId,
+        original: parent.original,
+        rejectionAssessmentId: assessment.assessmentId,
+        recipientThreadId,
+        causeIds: assessment.causes.map(
+          (cause) => `${cause.groupId}/${cause.ruleId}/${cause.code}`,
+        ),
+        advice: assessment.advice,
+        status: "pending",
+        nativeRequestId: null,
+        verification: null,
+        reasons: [],
+      };
+      const text = [
+        `Feedback for original ${parent.original.originalId} revision ${parent.original.revision}.`,
+        ...assessment.causes.map(
+          (cause) => `${cause.groupId}/${cause.ruleId}: ${cause.message}`,
+        ),
+        ...assessment.advice,
+      ].join("\n\n");
+      obligation = {
+        id,
+        pluginId: publication.pluginId,
+        assessmentId: assessment.assessmentId,
+        recipientThreadId,
+        payload: canonicalJson(
+          { feedback, text },
+          MESSAGE_ADMISSION_LIMITS.responseBytes,
+        ),
+      };
+    }
+    const updated = commitAdmissionDisposition(tx, {
+      operationId: row.id,
+      expectedDispositionId: input.expectedDispositionId,
+      dispositionId: input.dispositionId,
+      disposition: canonicalJson(
+        input.disposition,
+        MESSAGE_ADMISSION_LIMITS.responseBytes,
+      ),
+      feedback: obligation,
+    });
+    const record = this.operationRecord(updated);
+    record.delivery = input.delivery;
+    if (input.delivery.state === "cancelled")
+      supersedePendingAdmissionFeedback(tx, row.id);
+    const feedbackId = obligation?.id ?? record.feedback?.obligationId;
+    if (feedbackId)
+      record.feedback = this.feedbackRecord(feedbackId, tx)!.feedback;
+    saveAcceptedAdmissionResult(
+      tx,
+      row.id,
+      canonicalJson(record, MESSAGE_ADMISSION_LIMITS.responseBytes),
+    );
+    queueMicrotask(() => this.recovery?.wake());
+    return record;
+  }
+
+  feedbackRecord(
+    id: string,
+    db: DbQueryConnection = this.db,
+  ): { row: AdmissionFeedback; feedback: FeedbackV1; text: string } | null {
+    const row = getAdmissionFeedback(db, id);
+    if (!row) return null;
+    const payload: unknown = JSON.parse(row.payload);
+    if (
+      typeof payload !== "object" ||
+      payload === null ||
+      !("feedback" in payload) ||
+      !("text" in payload) ||
+      typeof payload.text !== "string"
+    )
+      throw new AdmissionConflict(
+        "feedback-payload-invalid",
+        "Native obligation payload is invalid",
+      );
+    const feedback = decodeBounded(
+      FeedbackV1Schema,
+      row.result === null ? payload.feedback : JSON.parse(row.result),
+      MESSAGE_ADMISSION_LIMITS.responseBytes,
+    );
+    return { row, feedback, text: payload.text };
+  }
+
+  feedbackBindingFor(id: string): NonNullable<SubmissionV1["feedbackBinding"]> {
+    const record = this.feedbackRecord(id);
+    if (!record || record.feedback.recipientThreadId === null)
+      throw new AdmissionConflict(
+        "feedback-unavailable",
+        "Feedback obligation has no known recipient",
+      );
+    const feedback = record.feedback;
+    return {
+      providerId: feedback.providerId,
+      obligationId: id,
+      original: feedback.original,
+      rejectionAssessmentId: feedback.rejectionAssessmentId,
+      recipientThreadId: record.feedback.recipientThreadId,
+      adviceFingerprint: `sha256:${admissionDigest(canonicalJson({ causeIds: feedback.causeIds, advice: feedback.advice, text: record.text }, MESSAGE_ADMISSION_LIMITS.responseBytes))}`,
+    };
+  }
+
+  private validateFeedbackSubmission(submission: SubmissionV1): void {
+    const binding = submission.feedbackBinding;
+    if (!binding) return;
+    const record = this.feedbackRecord(binding.obligationId);
+    if (record?.row.state === "superseded")
+      throw new AdmissionConflict(
+        "feedback-superseded",
+        "Native feedback obligation was superseded before initiation",
+      );
+    if (
+      !record ||
+      canonicalJson(binding, MESSAGE_ADMISSION_LIMITS.requestBytes) !==
+        canonicalJson(
+          this.feedbackBindingFor(binding.obligationId),
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        ) ||
+      canonicalJson(
+        record.feedback.operation,
+        MESSAGE_ADMISSION_LIMITS.requestBytes,
+      ) !==
+        canonicalJson(
+          submission.operation,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        ) ||
+      submission.threadId !== record.feedback.recipientThreadId ||
+      submission.policyContext.messageText !== record.text ||
+      submission.source.visibleHumanActivity
+    )
+      throw new AdmissionConflict(
+        "feedback-binding-conflict",
+        "Feedback must match its native original, recipient, stable operation and complete immutable advice",
+      );
+  }
+
+  claimFeedback(id: string): void {
+    this.db.transaction((tx) =>
+      transitionAdmissionFeedback(tx, id, "pending", "claimed", null),
+    );
+  }
+
+  setFeedbackDisposition(
+    id: string,
+    expected: AdmissionFeedback["state"],
+    raw: FeedbackV1,
+  ): FeedbackV1 {
+    const record = this.feedbackRecord(id);
+    if (!record)
+      throw new AdmissionConflict(
+        "feedback-missing",
+        "Native feedback obligation does not exist",
+      );
+    const result = decodeBounded(
+      FeedbackV1Schema,
+      raw,
+      MESSAGE_ADMISSION_LIMITS.responseBytes,
+    );
+    const immutable = (feedback: FeedbackV1) => ({
+      version: feedback.version,
+      obligationId: feedback.obligationId,
+      operation: feedback.operation,
+      providerId: feedback.providerId,
+      original: feedback.original,
+      rejectionAssessmentId: feedback.rejectionAssessmentId,
+      recipientThreadId: feedback.recipientThreadId,
+      causeIds: feedback.causeIds,
+      advice: feedback.advice,
+    });
+    if (
+      canonicalJson(
+        immutable(result),
+        MESSAGE_ADMISSION_LIMITS.responseBytes,
+      ) !==
+      canonicalJson(
+        immutable(record.feedback),
+        MESSAGE_ADMISSION_LIMITS.responseBytes,
+      )
+    )
+      throw new AdmissionConflict(
+        "feedback-binding-conflict",
+        "Feedback result changed its native advice or original binding",
+      );
+    const state: AdmissionFeedback["state"] =
+      result.status === "pending"
+        ? "pending"
+        : result.status === "blocked-by-policy" ||
+            result.status === "undeliverable"
+          ? "blocked"
+          : result.status === "superseded-without-send"
+            ? "superseded"
+            : result.status === "uncertain"
+              ? "uncertain"
+              : "accepted";
+    this.db.transaction((tx) =>
+      transitionAdmissionFeedback(
+        tx,
+        id,
+        expected,
+        state,
+        canonicalJson(result, MESSAGE_ADMISSION_LIMITS.responseBytes),
+      ),
+    );
+    return result;
+  }
+
+  createPluginHandle(pluginId: string) {
+    let active = false;
+    let retired = false;
+    let staged: Registration | null = null;
+    const assertLive = () => {
+      if (retired)
+        throw new AdmissionConflict(
+          "plugin-retired",
+          "Admission plugin generation retired",
+        );
+    };
+    const retireRegistration = (registration: Registration) => {
+      registration.controller.abort();
+      if (this.registrations.get(pluginId) === registration)
+        this.registrations.delete(pluginId);
+    };
+    const protocol: NativeAdmissionProtocolV1 = {
+      describe: (input) => {
+        if (input !== null)
+          throw new AdmissionConflict(
+            "invalid-describe-input",
+            "describe expects null",
+          );
+        return {
+          protocol: "bb-message-admission",
+          versions: [1],
+          capabilities: {
+            admission: true,
+            publication: true,
+            operations: true,
+            placement: true,
+            originalManifest: true,
+            activity: true,
+            feedback: this.recovery !== null,
+            limits: MESSAGE_ADMISSION_LIMITS,
+          },
+        };
+      },
+      registerEvaluator: (raw, evaluator) => {
+        assertLive();
+        const input = decodeBounded(
+          RegisterEvaluatorInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        if (typeof evaluator !== "function")
+          throw new AdmissionConflict(
+            "invalid-evaluator",
+            "Evaluator must be a callback",
+          );
+        if (staged) retireRegistration(staged);
+        const registration: RegistrationV1 = freeze({
+          version: 1,
+          registrationId: randomUUID(),
+          generation: randomUUID(),
+          evaluatorVersion: input.evaluatorVersion,
+        });
+        staged = {
+          pluginId,
+          registration,
+          evaluator,
+          controller: new AbortController(),
+          boundPublications: new Map(),
+        };
+        if (active) {
+          const old = this.registrations.get(pluginId);
+          if (old) retireRegistration(old);
+          this.registrations.set(pluginId, staged);
+        }
+        return registration;
+      },
+      unregisterEvaluator: (raw) => {
+        assertLive();
+        const input = decodeBounded(
+          UnregisterEvaluatorInputV1Schema,
+          raw,
+          MESSAGE_ADMISSION_LIMITS.requestBytes,
+        );
+        if (
+          !staged ||
+          staged.registration.registrationId !== input.registrationId ||
+          staged.registration.generation !== input.generation
+        )
+          return { version: 1, removed: false };
