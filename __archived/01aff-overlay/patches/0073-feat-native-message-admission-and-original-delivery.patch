+function fixture(existing?: DbConnection) {
+  const db = existing ?? createMigratedConnection();
+  databases.push(db);
+  const host = upsertHost(db, noopNotifier, { name: "admission-kernel" });
+  const { project } = createProject(db, noopNotifier, {
+    name: "kernel-test",
+    source: { type: "local_path", hostId: host.id, path: "/tmp/kernel-test" },
+  });
+  const destination = createThread(db, noopNotifier, {
+    projectId: project.id,
+    providerId: "codex",
+    title: "Receiver",
+  });
+  const sender = createThread(db, noopNotifier, {
+    projectId: project.id,
+    providerId: "codex",
+    title: "Sender",
+  });
+  const service = getMessageAdmissionService(db);
+  const plugin = service.createPluginHandle("rules");
+  plugin.activate();
+  cleanups.push(plugin.retire);
+  let publicationNumber = 0;
+  async function submission(
+    id: string = randomUUID(),
+    overrides: Partial<SubmissionV1> = {},
+  ): Promise<SubmissionV1> {
+    const {
+      operation = { namespace: "kernel-test", operationId: id },
+      requestFingerprint: _ignored,
+      ...body
+    } = {
+      version: 1 as const,
+      operation: { namespace: "kernel-test", operationId: id },
+      original: { originalId: `original-${id}`, revision: 1 },
+      threadId: destination.id,
+      projectId: project.id,
+      rawInput: [{ type: "text", text: "original text", mentions: [] }],
+      policyContext: {
+        messageText: "original text",
+        projectTitle: project.name,
+        senderTitle: sender.title,
+        destinationTitle: destination.title,
+      },
+      requestedIntent: {
+        mode: "queue" as const,
+        schedule: { kind: "ordinary" as const },
+        membership: "preserve" as const,
+        execution: {
+          provider: "codex",
+          model: "model",
+          reasoning: "medium",
+          serviceTier: "default",
+          permissionMode: "auto",
+          canAsk: true,
+          configuration: null,
+        },
+      },
+      source: {
+        senderThreadId: sender.id,
+        initiator: "user" as const,
+        author: null,
+        editor: null,
+        origin: null,
+        externalOperation: null,
+        visibleHumanActivity: true,
+      },
+      kind: "message" as const,
+      override: "none" as const,
+      expectedPlacementWitness: null,
+      ...overrides,
+    };
+    return {
+      ...body,
+      operation,
+      requestFingerprint: await submissionFingerprint(
+        body,
+        MESSAGE_ADMISSION_LIMITS.requestBytes,
+      ),
+    };
+  }
+  async function publish(
+    snapshot: JsonValue = {},
+    handle = plugin,
+    providerId = "rules",
+    expected?: PublicationV1 | null,
+  ) {
+    const active =
+      expected === undefined
+        ? await handle.protocol.readActivePublication({
+            version: 1,
+            providerId,
+          })
+        : expected;
+    const input: PublishInputV1 = {
+      version: 1,
+      operation: {
+        namespace: `publication:${providerId}`,
+        operationId: `publication-${++publicationNumber}`,
