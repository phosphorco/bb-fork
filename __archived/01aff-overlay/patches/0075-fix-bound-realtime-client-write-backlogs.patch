+const REALTIME_SOCKET_MAX_BUFFERED_MESSAGES = 1024;
 const TERMINAL_SOCKET_HIGH_WATER_BYTES = 1024 * 1024;
 const TERMINAL_SOCKET_MAX_QUEUE_BYTES = 32 * 1024 * 1024;
 const TERMINAL_SOCKET_DRAIN_POLL_MS = 10;
@@ -43,7 +45,7 @@ const LIST_RELEVANT_THREAD_EVENT_TYPES: ReadonlySet<ThreadEventType> =
 
 interface HubSocket {
   close(code?: number, reason?: string): void;
-  raw?: { bufferedAmount: number };
+  raw?: { bufferedAmount: number; terminate?(): void };
